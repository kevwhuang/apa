---
import { Image } from 'astro:assets';

import { SPONSORS, SPONSOR_LOGO_WIDTH } from '@lib/constants';
---

<section
    class="sponsors-stage stage stage--tight border-b-2 border-ink"
    aria-labelledby="sponsors-title"
>
    <div>
        <h2
            id="sponsors-title"
            class="sr-only"
        >
            Sponsors
        </h2>
        <p
            class="label mb-8 text-center text-ink-muted"
            data-motion="stamp"
        >
            Backed by
        </p>
        <ul
            class="grid grid-cols-2 gap-px mb-8 border-2 border-ink list-none bg-ink"
            data-motion-stagger="stamp"
        >
            {SPONSORS.map(sponsor => (
                <li class="flex items-center justify-center h-24 p-5 bg-surface md:h-32 md:p-8">
                    <Image
                        class="object-contain max-h-full max-w-full"
                        alt={sponsor.name}
                        densities={[1, 2]}
                        src={sponsor.logo}
                        width={SPONSOR_LOGO_WIDTH}
                    />
                </li>
            ))}
        </ul>
        <p
            class="font-mono text-xs text-center uppercase text-ink-muted"
            data-motion="rise"
        >
            Become a sponsor &mdash;&#32;
            <a
                class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] underline underline-offset-4 transition-colors"
                href="/sponsor"
            >
                view tiers &rarr;
            </a>
        </p>
    </div>
</section>

<style>
    .sponsors-stage.stage {
        --stage-pad-top: calc(var(--section-pad-sm) + var(--drift-unit));
    }
</style>
