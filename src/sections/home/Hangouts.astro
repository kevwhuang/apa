---
import { getCollection } from 'astro:content';

import ProgramFlyer from '@components/program/Flyer.astro';
import { toCalendarEvent } from '@lib/utils';

const STRIP_LIMIT = 1;

const events = await getCollection('events');

const hangouts = events
    .filter(event => event.data.type === 'hangout' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date)
    .slice(0, STRIP_LIMIT)
    .map(toCalendarEvent);
---

<ProgramFlyer
    class="border-b-2 border-ink"
    ctaHref="/events"
    ctaLabel="All events"
    events={hangouts}
    headingId="landing-hangout-title"
    straight
/>
