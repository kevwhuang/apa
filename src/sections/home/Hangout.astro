---
import { getCollection } from 'astro:content';

import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatCalendarDay, formatCalendarMonth, formatTimeRange, formatVenue, getProgram, isUpcoming } from '@lib/shared/utils';

const events = await getCollection('events');

const program = getProgram('hangout');

const upcoming = events
    .filter(event => event.data.type === 'hangout' && isUpcoming(event.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--hangout border-b-2 border-border-strong"
    aria-labelledby="landing-hangout-title"
    data-event-group="home-hangout"
    data-event-role="some"
    hidden={upcoming.length === 0}
>
    <div>
        <SectionHead
            class="text-5xl max-md:text-4xl"
            headingId="landing-hangout-title"
        >
            Next {program.name}
        </SectionHead>
        <p
            class="max-w-2xl mb-(--space-2xl) text-lg text-text-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
        {upcoming.map((event, index) => (
            <div
                class="relative"
                data-event-end={event.data.end.toISOString()}
                data-event-group="home-hangout"
                data-event-role="next"
                hidden={index > 0}
            >
                <div
                    class="halftone--accent hangout-flyer__field absolute pointer-events-none"
                    aria-hidden="true"
                />
                <article
                    id={index === 0 ? event.id : undefined}
                    class="hangout-flyer__card slab slab--bare slab--card slab--still"
                    data-event-id={event.id}
                    data-motion="tilt"
                >
                    <p
                        class="hangout-flyer__stamp"
                        data-placeholder
                    >
                        <time
                            class="contents"
                            datetime={event.data.date.toISOString()}
                        >
                            <span class="hangout-flyer__day">{formatCalendarDay(event.data.date)}</span>
                            <span class="hangout-flyer__month block font-mono text-lg whitespace-nowrap">{formatCalendarMonth(event.data.date)}</span>
                        </time>
                    </p>
                    <div class="content-start p-(--space-lg)">
                        <h3 class="mb-6 font-display text-3xl text-balance max-lg:text-2xl">{event.data.title}</h3>
                        <p class="max-w-2xl mb-8 text-lg text-text-secondary">{event.data.excerpt}</p>
                        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 mb-8 max-lg:grid-cols-1">
                            <div>
                                <dt class="label mb-2 text-text-secondary">Time</dt>
                                <dd
                                    class="font-bold font-sans text-balance text-xl"
                                    data-placeholder
                                >
                                    {formatTimeRange(event.data.date, event.data.end)}
                                </dd>
                            </div>
                            <div>
                                <dt class="label mb-2 text-text-secondary">Where</dt>
                                <dd class="font-bold font-sans text-xl">
                                    <address class="not-italic">{formatVenue(event.data.location)}</address>
                                </dd>
                            </div>
                            <div>
                                <dt class="label mb-2 text-text-secondary">RSVP</dt>
                                <dd class="font-bold font-sans text-xl">
                                    <a
                                        class="active:translate-y-px hover:text-link inline-block underline underline-offset-4 transition-[color,translate]"
                                        href={event.data.rsvp ?? LINKS.meetup}
                                        rel="noopener noreferrer"
                                        target="_blank"
                                    >
                                        meetup.com
                                        <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                    </a>
                                </dd>
                            </div>
                        </dl>
                        <div class="flex flex-wrap gap-3">
                            <a
                                class="btn"
                                href="/hangouts"
                            >
                                All Hangouts
                            </a>
                        </div>
                    </div>
                    <p
                        class="hangout-flyer__rail label"
                        aria-hidden="true"
                    >
                        {program.shortName} &middot; {program.cadence}
                    </p>
                </article>
            </div>
        ))}
    </div>
</section>

<Schedule />

<style>
    .hangout-flyer__card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        overflow: clip;
    }

    .hangout-flyer__day {
        display: block;
        font-family: var(--font-display);
        font-size: var(--text-9xl);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
    }

    .hangout-flyer__field {
        inset: calc(-1 * var(--space-lg)) calc(-1 * var(--space-2xl));
    }

    .hangout-flyer__rail {
        align-items: center;
        background: var(--color-bg-inverse);
        border-left: 2px solid var(--color-border-strong);
        color: var(--color-text-inverse);
        display: flex;
        justify-content: center;
        padding-block: var(--space-md);
        padding-inline: var(--space-xs);
        writing-mode: vertical-rl;
    }

    .hangout-flyer__stamp {
        align-content: center;
        background: var(--color-event-hangout);
        border-right: 2px solid var(--color-border-strong);
        color: var(--color-event-hangout-text);
        display: grid;
        gap: var(--space-2xs);
        justify-items: start;
        padding: var(--space-lg);
    }

    @media (max-width: 768px) {
        .hangout-flyer__card {
            grid-template-columns: minmax(0, 1fr);
        }

        .hangout-flyer__day {
            align-self: center;
            font-size: var(--text-6xl);
        }

        .hangout-flyer__field {
            inset: calc(-1 * var(--space-md)) calc(-1 * var(--space-lg));
        }

        .hangout-flyer__month {
            align-self: center;
            justify-self: end;
        }

        .hangout-flyer__rail {
            display: none;
        }

        .hangout-flyer__stamp {
            align-content: start;
            border-bottom: 2px solid var(--color-border-strong);
            border-right: 0;
            column-gap: var(--space-sm);
            grid-template-columns: auto minmax(0, 1fr);
            padding: var(--space-md);
        }
    }
</style>
