---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatCalendarDay, formatCalendarMonth, formatTimeRange, formatWeekday, getProgram } from '@lib/shared/utils';

const events = await getCollection('events');

const [next] = events
    .filter(event => event.data.type === 'hangout' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);

const program = getProgram('hangout');
---

<section
    class="stage stage--hangout border-b-2 border-border-strong"
    aria-labelledby="landing-hangout-title"
>
    <div>
        <SectionHead
            class="text-4xl sm:text-5xl"
            eyebrow={`${program.shortName}, coming soon`}
            headingId="landing-hangout-title"
        >
            {program.name}.
            <a
                class="action-text hover:text-link hidden items-center gap-2 min-h-(--control-size) whitespace-nowrap transition-colors md:inline-flex"
                href="/events"
                slot="cta"
            >
                All events <IconArrow />
            </a>
        </SectionHead>
        <p
            class="max-w-2xl mb-(--space-2xl) leading-relaxed text-base text-text-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
        {next
            ? (
                    <div class="relative">
                        <div
                            class="halftone--accent hangout-flyer__field absolute pointer-events-none"
                            aria-hidden="true"
                        />
                        <div class="hangout-flyer__frame mark tilt">
                            <article
                                id={next.id}
                                class="hangout-flyer__card slab slab--bare slab--card"
                                data-motion="tilt"
                            >
                                <p
                                    class="hangout-flyer__stamp"
                                    data-placeholder
                                >
                                    <span class="hangout-flyer__tag label px-2 py-1 bg-bg-inverse text-text-inverse">
                                        Next {program.shortName}
                                    </span>
                                    <time
                                        class="contents"
                                        datetime={next.data.date.toISOString()}
                                    >
                                        <span class="hangout-flyer__day">{formatCalendarDay(next.data.date)}</span>
                                        <span class="hangout-flyer__month block font-mono leading-normal text-sm tracking-[0.08em] whitespace-nowrap">{formatCalendarMonth(next.data.date)}</span>
                                    </time>
                                    <span class="hangout-flyer__weekday font-mono text-xs tracking-[0.06em] text-event-hangout-text">{formatWeekday(next.data.date)}</span>
                                </p>
                                <div class="content-start p-(--space-md) md:p-(--space-lg)">
                                    <h3 class="mb-5 font-display text-3xl">{next.data.title}</h3>
                                    <p
                                        class="mb-1 font-mono text-xs text-text-secondary"
                                        data-placeholder
                                    >
                                        {formatTimeRange(next.data.date, next.data.end)}
                                    </p>
                                    <address class="mb-5 font-mono not-italic text-xs text-text-secondary">
                                        {next.data.location}
                                    </address>
                                    <p class="max-w-2xl mb-8 leading-relaxed text-lg text-text-secondary">{next.data.excerpt}</p>
                                    <div class="flex flex-wrap gap-3">
                                        <a
                                            class="btn btn--accent"
                                            href={LINKS.meetup}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            RSVP on Meetup
                                            <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                        </a>
                                        <a
                                            class="btn"
                                            href="/events"
                                        >
                                            All events
                                        </a>
                                    </div>
                                </div>
                                <p
                                    class="hangout-flyer__rail"
                                    aria-hidden="true"
                                >
                                    {program.shortName} &middot; {program.cadence}
                                </p>
                            </article>
                        </div>
                    </div>
                )
            : (
                    <div
                        class="max-w-(--measure-form)"
                        data-motion="rise"
                    >
                        <p class="mb-8 text-text-secondary">
                            The {program.name} has not launched yet &mdash; it is planned as a {program.cadence} program, and the first date goes up as soon as the room is booked.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            <a
                                class="btn btn--accent"
                                href={LINKS.meetup}
                                rel="noopener noreferrer"
                                target="_blank"
                            >
                                Follow along on Meetup
                                <span class="sr-only">&nbsp;(opens in a new tab)</span>
                            </a>
                            <a
                                class="btn"
                                href="/events"
                            >
                                All events
                            </a>
                        </div>
                    </div>
                )}
    </div>
</section>

<style>
    .hangout-flyer__card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        overflow: clip;
    }

    .hangout-flyer__day {
        display: block;
        font-family: var(--font-display);
        font-size: var(--text-9xl);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 0.78;
    }

    .hangout-flyer__field {
        inset: calc(-1 * var(--space-lg)) calc(-1 * var(--space-2xl));
    }

    .hangout-flyer__rail {
        align-items: center;
        background: var(--color-bg-inverse);
        border-left: 2px solid var(--color-border-strong);
        color: var(--color-text-inverse);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        justify-content: center;
        letter-spacing: 0.32em;
        padding-block: var(--space-md);
        padding-inline: var(--space-xs);
        text-transform: uppercase;
        writing-mode: vertical-rl;
    }

    .hangout-flyer__stamp {
        align-content: center;
        background: var(--color-event-hangout);
        border-right: 2px solid var(--color-border-strong);
        color: var(--color-event-hangout-text);
        display: grid;
        gap: var(--space-2xs);
        justify-items: start;
        padding: var(--space-lg);
    }

    @media (max-width: 768px) {
        .hangout-flyer__card {
            grid-template-columns: minmax(0, 1fr);
        }

        .hangout-flyer__day {
            align-self: center;
            font-size: var(--text-8xl);
            grid-row: span 2;
        }

        .hangout-flyer__field {
            inset: calc(-1 * var(--space-md)) calc(-1 * var(--space-lg));
        }

        .hangout-flyer__month {
            align-self: center;
            justify-self: end;
        }

        .hangout-flyer__rail {
            display: none;
        }

        .hangout-flyer__stamp {
            align-content: start;
            border-bottom: 2px solid var(--color-border-strong);
            border-right: 0;
            column-gap: var(--space-sm);
            grid-template-columns: auto minmax(0, 1fr);
            padding: var(--space-md);
        }

        .hangout-flyer__tag {
            grid-column: 1 / -1;
        }

        .hangout-flyer__weekday {
            align-self: center;
            justify-self: end;
        }
    }
</style>
