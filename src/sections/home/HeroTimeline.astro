---
import WaveformBars from '@components/shared/WaveformBars.astro';
import { STEP_COUNT, stepEnergy } from '@lib/motion/pattern';
import { getProgram } from '@lib/shared/utils';

const BAR_CONTRAST = 1.6;
const BAR_MAX = 92;
const BAR_MIN = 8;

const assembly = getProgram('assembly');
const barPeak = Math.max(...Array.from({ length: STEP_COUNT }, (_, step) => stepEnergy(step)));
const bash = getProgram('bash');
const camp = getProgram('camp');
const hangout = getProgram('hangout');

const bars = Array.from({ length: STEP_COUNT }, (_, step) => BAR_MIN + (BAR_MAX - BAR_MIN) * (stepEnergy(step) / barPeak) ** BAR_CONTRAST);
---

<section
    class="hero stage content-center overflow-hidden relative min-h-svh border-b-2 border-border-strong text-center bg-bg-page"
    aria-labelledby="hero-title"
>
    <div
        class="halftone hero__drift stage__item--full -inset-y-[8%] absolute inset-x-0 pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div
        class="hero__field stage__item--full absolute inset-0 pointer-events-none"
        aria-hidden="true"
    >
        <canvas class="hero__canvas" hidden />
    </div>
    <h1
        id="hero-title"
        class="hero__title relative text-[clamp(48px,min(calc(19.333px_+_8.9584vw),24svh),134px)]"
        data-motion-stagger="strike"
    >
        <span class="block">Step in</span>
        <span class="block text-signal">the mix</span>
    </h1>
    <div
        class="hero__timeline grid grid-rows-subgrid relative"
        data-motion="unfold"
    >
        <div class="slab slab--bare slab--card overflow-hidden relative">
            <div class="halftone--accent hero__halftone absolute inset-0" aria-hidden="true" />
            <WaveformBars
                class="block h-16 w-full px-3 py-2 text-signal"
                bars={bars}
            />
            <div class="hero__playhead" aria-hidden="true" />
        </div>
        <div class="hero__foot grid grid-cols-2 max-w-3xl w-full gap-x-8 mx-auto max-md:grid-cols-1 max-md:grid-rows-subgrid">
            <p
                class="text-lg"
                data-motion="blur"
            >
                A working community for music producers in Austin, Texas. At {assembly.name},
                the {bash.cadence} {bash.name}, {camp.name}, and the {hangout.cadence} {hangout.name}, producers
                of every genre and experience level find their people.
            </p>
            <div class="hero__actions flex flex-col items-center self-center gap-3">
                <a
                    class="btn btn--primary max-w-[240px] w-full"
                    href="/resources"
                >
                    Browse resources
                </a>
                <a
                    class="btn max-w-[240px] w-full bg-bg-page"
                    href="/store"
                >
                    Browse store
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        --hero-gap: minmax(var(--space-md), min(var(--space-2xl), 100%));
        --stage-pad-bottom: 0px;
        --stage-pad-top: var(--header-height);
        grid-template-rows: var(--hero-gap) repeat(3, max-content var(--hero-gap));
        row-gap: 0;
    }

    .hero__canvas {
        height: 100%;
        inset: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity var(--duration-cinematic) var(--motion-ease-entrance);
        width: 100%;
    }

    .hero__foot {
        grid-row: 3;
    }

    .hero__halftone {
        --color-halftone-accent: var(--color-signal);
    }

    .hero__playhead {
        --playhead-width: 2px;
        inset: 0 auto 0 0;
        pointer-events: none;
        position: absolute;
        width: calc(100% - var(--playhead-width));
    }

    .hero__playhead::after,
    .hero__playhead::before {
        background: var(--color-signal);
        content: '';
        position: absolute;
    }

    .hero__playhead::after {
        height: 12px;
        left: -5px;
        rotate: 45deg;
        top: -6px;
        width: 12px;
    }

    .hero__playhead::before {
        bottom: 0;
        left: 0;
        top: 0;
        width: var(--playhead-width);
    }

    .hero__timeline {
        grid-row: 4 / span 3;
    }

    .hero__title {
        grid-row: 2;
    }

    @media (max-width: 768px) {
        .hero {
            grid-template-rows: var(--hero-gap) repeat(4, max-content var(--hero-gap));
        }

        .hero__actions {
            grid-row: 3;
        }

        .hero__foot {
            grid-row: 3 / span 3;
        }

        .hero__timeline {
            grid-row: 4 / span 5;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__canvas,
        .hero__playhead {
            transform: none !important;
        }
    }
</style>
