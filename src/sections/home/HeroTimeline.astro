---
import WaveformBars from '@components/shared/WaveformBars.astro';
import { STEP_COUNT, stepEnergy } from '@lib/motion/pattern';
import { getProgram } from '@lib/shared/utils';

const BAR_CONTRAST = 1.6;
const BAR_MAX = 92;
const BAR_MIN = 8;

const assembly = getProgram('assembly');
const barPeak = Math.max(...Array.from({ length: STEP_COUNT }, (_, step) => stepEnergy(step)));

const bars = Array.from({ length: STEP_COUNT }, (_, step) => BAR_MIN + (BAR_MAX - BAR_MIN) * (stepEnergy(step) / barPeak) ** BAR_CONTRAST);
const bash = getProgram('bash');
const hangout = getProgram('hangout');
---

<section
    class="hero stage stage--hero content-center overflow-hidden relative min-h-svh border-b-2 border-border-strong text-center bg-bg-page"
    aria-labelledby="hero-title"
>
    <div
        class="halftone hero__drift stage__item--full -inset-y-[8%] absolute inset-x-0 pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div class="hero__field stage__item--full absolute inset-0 pointer-events-none" aria-hidden="true" />
    <div class="relative">
        <div
            class="hero__meta label flex flex-wrap items-center justify-center gap-3 mb-6 text-text-secondary"
            data-motion="stamp"
        >
            <span class="inline-block h-2.5 w-2.5 bg-bg-signal animate-pulse" aria-hidden="true" />
            <span>Austin, TX</span>
            <span class="hidden md:inline">/ Est <time datetime="2022-05">2022</time> / More than 800 welcomed</span>
        </div>
        <h1
            id="hero-title"
            class="hero__title mb-10 leading-[0.95] text-[clamp(48px,min(calc(16px_+_11.25vw),24svh),148px)]"
            data-motion-stagger="strike"
        >
            <span class="block">Step in</span>
            <span class="block text-text-brand">the mix.</span>
        </h1>
        <div
            class="hero__timeline relative"
            data-motion="unfold"
        >
            <div class="mark slab slab--bare slab--card overflow-hidden relative mb-8">
                <div class="halftone--accent absolute inset-0" aria-hidden="true" />
                <WaveformBars
                    class="block h-16 w-full px-3 py-2 text-text-brand"
                    bars={bars}
                />
                <div class="hero__playhead" aria-hidden="true" />
            </div>
            <div class="hero__foot grid grid-cols-1 max-w-3xl gap-8 mx-auto md:grid-cols-2">
                <p
                    class="leading-relaxed text-lg"
                    data-motion="blur"
                >
                    A working community for music producers in Austin, Texas. At {assembly.name},
                    the {bash.cadence} {bash.name}, and the {hangout.name}, producers of every genre
                    and experience level find their people.
                </p>
                <div class="hero__actions flex flex-col items-center self-center gap-3">
                    <a
                        class="btn btn--primary max-w-[240px] w-full"
                        href="/events"
                    >
                        Browse events
                    </a>
                    <a
                        class="btn max-w-[240px] w-full"
                        href="/store"
                    >
                        Shop the store
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    .hero__canvas {
        --hero-dim: color-mix(in srgb, currentColor 38%, transparent);
        height: 100%;
        inset: 0;
        mask-image: linear-gradient(to right, currentColor, var(--hero-dim) 32%, var(--hero-dim) 68%, currentColor);
        pointer-events: none;
        position: absolute;
        transition: opacity var(--duration-cinematic) var(--motion-ease-entrance);
        width: 100%;
    }

    .hero__playhead {
        --playhead-width: 2px;
        inset: 0 auto 0 0;
        pointer-events: none;
        position: absolute;
        width: calc(100% - var(--playhead-width));
    }

    .hero__playhead::after,
    .hero__playhead::before {
        background: var(--color-bg-signal);
        content: '';
        position: absolute;
    }

    .hero__playhead::after {
        height: 12px;
        left: -5px;
        rotate: 45deg;
        top: -6px;
        width: 12px;
    }

    .hero__playhead::before {
        bottom: 0;
        left: 0;
        top: 0;
        width: var(--playhead-width);
    }
</style>
