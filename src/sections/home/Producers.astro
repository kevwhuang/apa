---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import ProducerLinks from '@components/producer/Links.astro';
import ProducerPortrait from '@components/producer/Portrait.astro';
import ProducerTrack from '@components/producer/Track.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { PALETTE } from '@lib/shared/constants';
import { formatCalendarMonth, formatRole, toIsoDate, toRoster } from '@lib/shared/utils';

const GENRE_LIMIT = 2;
const STRIP_LIMIT = 4;

const producers = toRoster(await getCollection('producers'));

const featured = producers.find(producer => producer.data.featured);

const roster = producers.filter(producer => producer.data.producerId !== featured?.data.producerId);
const track = featured?.data.tracks[0];
---

{featured && (
    <section
        class="slab--well stage overflow-clip border-b-2 border-border-strong"
        aria-labelledby="featured-producer-title"
    >
        <div
            class="halftone--accent stage__full absolute bottom-0 inset-x-0 h-(--space-lg) pointer-events-none"
            aria-hidden="true"
            data-scrub="drift"
        />
        <div class="relative">
            <SectionHead
                class="text-3xl-8xl"
                headingId="featured-producer-title"
            >
                {featured.data.name}
            </SectionHead>
            <div class="producer-feature__rank rank items-start">
                <div>
                    <div
                        class="mb-6 pb-(--lift) pe-(--lift)"
                        data-motion="wipe"
                    >
                        <ProducerPortrait
                            class="slab slab--bare slab--card aspect-square"
                            color={PALETTE[0].background}
                            labelClass="text-8xl"
                            labelColor={PALETTE[0].text}
                            name={featured.data.name}
                            producerId={featured.data.producerId}
                        />
                    </div>
                    <p
                        class:list={[featured.data.links.length > 0 && 'mb-4', 'font-mono text-base text-text-inverse-secondary']}
                        data-placeholder
                    >
                        Since <time datetime={toIsoDate(featured.data.joined)}>{formatCalendarMonth(featured.data.joined)}</time>
                    </p>
                    <ProducerLinks
                        linkClass="hover:text-link-on-inverse"
                        links={featured.data.links}
                    />
                </div>
                <div data-motion-stagger="rise">
                    <p
                        class="mb-6 font-mono text-base text-text-inverse-secondary"
                        data-placeholder
                    >
                        {featured.data.roles.length > 0
                            ? <Fragment>{featured.data.roles.map(formatRole).join(' \u00b7 ')} &middot; {featured.data.location}</Fragment>
                            : featured.data.location}
                    </p>
                    <p
                        class="max-w-xl mb-6 text-lg text-text-inverse-secondary"
                        data-placeholder
                    >
                        {featured.data.bio}
                    </p>
                    <ul class:list={['flex flex-wrap gap-2', track && 'mb-8', 'list-none']}>
                        {featured.data.genres.map(genre => (
                            <li class="label inline-flex items-center h-6 px-2 border-2 border-current">{genre}</li>
                        ))}
                    </ul>
                    {track && (
                        <div class="producer-feature__track slab slab--card slab--still text-text">
                            <p class="label mb-3 text-link">Spotlight</p>
                            <ProducerTrack
                                producerId={featured.data.producerId}
                                track={track}
                            />
                        </div>
                    )}
                </div>
            </div>
        </div>
    </section>
)}

<section
    class="slab--sunk stage border-b-2 border-border-strong"
    aria-labelledby="producers-title"
>
    <div>
        <SectionHead
            class="text-3xl-5xl text-balance"
            headingId="producers-title"
        >
            Producers of every genre
            <a
                class="action-text inline-flex items-center min-h-(--control-size) gap-2 whitespace-nowrap max-md:hidden"
                href="/directory"
                slot="cta"
            >
                All producers <IconArrow />
            </a>
        </SectionHead>
        <ul
            class="producer-strip grid grid-cols-4 gap-x-(--space-lg) gap-y-(--space-2xl) list-none max-lg:grid-cols-2 max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] max-md:mb-10"
            data-motion-stagger="flip"
            data-producer-strip
        >
            {roster.map((producer, index) => (
                <li class:list={[index >= STRIP_LIMIT && 'hidden']}>
                    <a
                        class="slab slab--bare slab--card slab--still"
                        href={`/directory#${producer.data.producerId}`}
                    >
                        <ProducerPortrait
                            class="aspect-square border-b-2 border-border-strong"
                            color={PALETTE[(index + 1) % PALETTE.length].background}
                            labelClass="text-5xl"
                            labelColor={PALETTE[(index + 1) % PALETTE.length].text}
                            name={producer.data.name}
                            producerId={producer.data.producerId}
                        />
                        <h3
                            class="mb-1 pt-(--space-md) px-(--space-md) text-balance text-lg"
                            data-placeholder
                        >
                            {producer.data.name}
                        </h3>
                        <p class="label pb-(--space-md) px-(--space-md) text-text-secondary">{producer.data.genres.slice(0, GENRE_LIMIT).join(' / ')}</p>
                    </a>
                </li>
            ))}
        </ul>
        <div
            class="hidden max-md:block"
            data-motion="rise"
        >
            <a
                class="btn"
                href="/directory"
            >
                All producers
            </a>
        </div>
    </div>
</section>

<style>
    .producer-feature__rank {
        --rank-cols: minmax(0, 0.38fr) minmax(0, 1fr);
    }

    .producer-feature__track {
        --producer-track-bar-width: 6px;
    }

    .producer-strip > li:not(.hidden),
    .producer-strip > li > a {
        align-content: start;
        display: grid;
        grid-row: span 3;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        row-gap: 0;
    }

    @media (max-width: 768px) {
        .producer-feature__rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>

<script>
    import gsap from 'gsap';

    import { REDUCED_MOTION_QUERY } from '@lib/shared/constants';
    import { getMotionTokens } from '@lib/motion/tokens';
    import { initTracks } from '@lib/audio/tracks';
    import { registerPageScript } from '@lib/shared/utils';

    const HIDDEN_CLASS = 'hidden';
    const ROTATE_INTERVAL_MILLISECONDS = 10_000;
    const ROTATE_TRAVEL_FACTOR = 3;
    const STRIP_LIMIT = 4;

    let isRotating = false;
    let isVisible = true;
    let rotateTimer: Timer | undefined;

    function enterCards(leaving: HTMLElement[], entering: HTMLElement[], tokens: MotionTokens) {
        swapCards(leaving, entering);

        gsap.fromTo(entering, { opacity: 0, x: tokens.travel * ROTATE_TRAVEL_FACTOR, y: 0 }, {
            duration: tokens.duration.slower,
            ease: tokens.ease.entrance,
            onComplete: () => finishRotation(entering),
            opacity: 1,
            overwrite: 'auto',
            stagger: tokens.stagger.base,
            x: 0,
        });
    }

    function finishRotation(entering: HTMLElement[]) {
        isRotating = false;
        gsap.set(entering, { clearProps: 'transform' });
    }

    function initRosterRotation(signal: AbortSignal) {
        const strip = document.querySelector<HTMLElement>('[data-producer-strip]');

        if (!strip) return;

        const cards = Array.from(strip.querySelectorAll<HTMLElement>(':scope > li'));

        if (cards.length <= STRIP_LIMIT) return;

        isRotating = false;
        isVisible = true;

        const observer = new IntersectionObserver((entries) => {
            isVisible = entries[0]?.isIntersecting ?? false;
        });

        clearInterval(rotateTimer);
        observer.observe(strip);
        rotateTimer = setInterval(() => rotateStrip(strip, cards), ROTATE_INTERVAL_MILLISECONDS);
        signal.addEventListener('abort', () => stopRotation(cards, observer), { once: true });
    }

    function rotateStrip(strip: HTMLElement, cards: HTMLElement[]) {
        if (!isVisible || document.hidden || isRotating) return;
        if (strip.contains(document.activeElement) || strip.matches(':hover')) return;

        const entering = sampleCards(cards);
        const leaving = cards.filter(card => !card.classList.contains(HIDDEN_CLASS));

        if (window.matchMedia(REDUCED_MOTION_QUERY).matches) {
            swapCards(leaving, entering);

            return;
        }

        const tokens = getMotionTokens();

        isRotating = true;

        gsap.to(leaving, {
            duration: tokens.duration.slower,
            ease: tokens.ease.mechanical,
            onComplete: () => enterCards(leaving, entering, tokens),
            opacity: 0,
            overwrite: 'auto',
            stagger: tokens.stagger.base,
            y: tokens.travel * ROTATE_TRAVEL_FACTOR,
        });
    }

    function sampleCards(cards: HTMLElement[]) {
        const pool = [...cards];

        for (let index = pool.length - 1; index > 0; index -= 1) {
            const swap = Math.floor(Math.random() * (index + 1));

            [pool[index], pool[swap]] = [pool[swap], pool[index]];
        }

        const draw = pool.slice(0, STRIP_LIMIT);

        if (draw.every(card => !card.classList.contains(HIDDEN_CLASS))) {
            const fresh = pool.slice(STRIP_LIMIT).find(card => card.classList.contains(HIDDEN_CLASS));

            if (fresh) draw[draw.length - 1] = fresh;
        }

        return draw.toSorted((a, b) => cards.indexOf(a) - cards.indexOf(b));
    }

    function stopRotation(cards: HTMLElement[], observer: IntersectionObserver) {
        clearInterval(rotateTimer);
        gsap.killTweensOf(cards);
        observer.disconnect();
        rotateTimer = undefined;
    }

    function swapCards(leaving: HTMLElement[], entering: HTMLElement[]) {
        leaving.forEach(card => card.classList.add(HIDDEN_CLASS));
        gsap.set(leaving, { clearProps: 'transform' });
        entering.forEach(card => card.classList.remove(HIDDEN_CLASS));
        gsap.set(entering, { opacity: 1 });
    }

    initTracks();
    registerPageScript(initRosterRotation);
</script>
