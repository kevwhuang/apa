---
import IconArrow from '@components/icons/Arrow.astro';
import ProducerLinks from '@components/producer/Links.astro';
import ProducerPortrait from '@components/producer/Portrait.astro';
import ProducerTrack from '@components/producer/Track.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { BROWSER_CACHE_CONTROL, PALETTE, SHARED_CACHE_CONTROL, STATUS_SERVER_ERROR } from '@lib/shared/constants';
import { formatCalendarMonth, formatRole } from '@lib/shared/utils';
import { loadRoster } from '@lib/server/roster';

const GENRE_LIMIT = 2;
const STRIP_LIMIT = 4;

const loaded = await loadRoster();

const members = loaded ?? [];

const featured = members.find(member => member.featured);
const roster = members.toSorted((a, b) => a.name.localeCompare(b.name));

const track = featured?.tracks[0];

if (!Astro.isPrerendered && loaded) {
    Astro.response.headers.set('Cache-Control', BROWSER_CACHE_CONTROL);
    Astro.response.headers.set('Netlify-CDN-Cache-Control', SHARED_CACHE_CONTROL);
}

if (!Astro.isPrerendered && !loaded) Astro.response.status = STATUS_SERVER_ERROR;
---

{featured && (
    <section
        class="slab--well stage overflow-clip border-b-2 border-border-strong"
        aria-labelledby="featured-producer-title"
    >
        <div
            class="halftone--accent stage__full absolute bottom-0 inset-x-0 h-(--space-lg) pointer-events-none"
            aria-hidden="true"
            data-scrub="drift"
        />
        <div class="relative">
            <SectionHead
                class="text-3xl-8xl"
                headingId="featured-producer-title"
            >
                {featured.name}
            </SectionHead>
            <div class="producer-feature__rank rank items-start">
                <div>
                    <div
                        class="mb-6"
                        data-motion="wipe"
                    >
                        <ProducerPortrait
                            class="slab slab--bare slab--card aspect-square"
                            color={PALETTE[0].background}
                            labelClass="text-8xl"
                            labelColor={PALETTE[0].text}
                            name={featured.name}
                            portrait={featured.portrait}
                        />
                    </div>
                    <p
                        class:list={[featured.links.length > 0 && 'mb-4', 'font-mono text-base text-text-inverse-secondary']}
                        data-placeholder
                    >
                        Since <time datetime={featured.joined}>{formatCalendarMonth(new Date(featured.joined))}</time>
                    </p>
                    <ProducerLinks
                        linkClass="hover:text-link-on-inverse"
                        links={featured.links}
                    />
                </div>
                <div data-motion-stagger="rise">
                    <p
                        class="mb-6 font-mono text-base text-text-inverse-secondary"
                        data-placeholder
                    >
                        {featured.roles.length > 0
                            ? <Fragment>{featured.roles.map(formatRole).join(' \u00b7 ')} &middot; {featured.location}</Fragment>
                            : featured.location}
                    </p>
                    <p
                        class="max-w-xl mb-6 text-lg text-text-inverse-secondary"
                        data-placeholder
                    >
                        {featured.bio}
                    </p>
                    <ul class:list={['flex flex-wrap gap-2', track && 'mb-8', 'list-none']}>
                        {featured.genres.map(genre => (
                            <li class="label inline-flex items-center h-6 px-2 border-2 border-current">{genre}</li>
                        ))}
                    </ul>
                    {track && (
                        <div class="producer-feature__track slab slab--card text-text">
                            <p class="label mb-3 text-link">Spotlight</p>
                            <ProducerTrack
                                artist={featured.name}
                                producerId={featured.id}
                                track={track}
                            />
                        </div>
                    )}
                </div>
            </div>
        </div>
    </section>
)}

<section
    class="slab--sunk stage border-b-2 border-border-strong"
    aria-labelledby="producers-title"
>
    <div>
        <SectionHead
            class="text-3xl-5xl text-balance"
            headingId="producers-title"
        >
            Producers of every genre
            <a
                class="action-text inline-flex items-center min-h-(--control-size) gap-2 whitespace-nowrap max-md:hidden"
                href="/directory"
                slot="cta"
            >
                All producers <IconArrow />
            </a>
        </SectionHead>
        <ul
            class="producer-strip grid grid-cols-4 [overflow-anchor:none] gap-x-(--space-lg) gap-y-(--space-2xl) list-none max-lg:grid-cols-2 max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] max-md:mb-10"
            data-motion-stagger="flip"
            data-producer-strip
        >
            {roster.map((member, index) => (
                <li class:list={[index >= STRIP_LIMIT && 'hidden']}>
                    <a
                        class="slab slab--bare slab--card slab--still"
                        href={`/directory#${member.id}`}
                    >
                        <ProducerPortrait
                            class="aspect-square border-b-2 border-border-strong"
                            color={PALETTE[(index + 1) % PALETTE.length].background}
                            labelClass="text-5xl"
                            labelColor={PALETTE[(index + 1) % PALETTE.length].text}
                            name={member.name}
                            portrait={member.portrait}
                        />
                        <h3
                            class="mb-1 pt-(--space-md) px-(--space-md) text-balance text-lg"
                            data-placeholder
                        >
                            {member.name}
                        </h3>
                        <p class="label pb-(--space-md) px-(--space-md) text-text-secondary">{member.genres.slice(0, GENRE_LIMIT).join(' / ')}</p>
                    </a>
                </li>
            ))}
        </ul>
        <div
            class="hidden max-md:block"
            data-motion="rise"
        >
            <a
                class="btn"
                href="/directory"
            >
                All producers
            </a>
        </div>
    </div>
</section>

<style>
    .producer-feature__rank {
        --rank-cols: minmax(0, 0.38fr) minmax(0, 1fr);
    }

    .producer-strip > li:not(.hidden),
    .producer-strip > li > a {
        align-content: start;
        display: grid;
        grid-row: span 3;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        row-gap: 0;
    }

    @media (max-width: 768px) {
        .producer-feature__rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>

<script>
    import gsap from 'gsap';

    import { REDUCED_MOTION_QUERY } from '@lib/shared/constants';
    import { getMotionTokens } from '@lib/motion/tokens';
    import { initTracks } from '@lib/audio/tracks';
    import { registerPageScript } from '@lib/shared/utils';
    import { revealTarget } from '@lib/motion/entrances';

    const RECENT_ROTATIONS = 5;
    const ROTATE_INTERVAL_MILLISECONDS = 10_000;
    const ROTATE_TRAVEL_FACTOR = 3;
    const STRIP_LIMIT = 4;

    let carriedRotations: string[][] = [];
    let isRotating = false;
    let isVisible = true;
    let rotateTimer: Timer | undefined;
    let shownRotations: string[][] = [];

    function drawRotation(cards: HTMLElement[], rotations: string[][]) {
        const pool = cards.map(readHref);

        for (let index = pool.length - 1; index > 0; index--) {
            const swap = Math.floor(Math.random() * (index + 1));

            [pool[index], pool[swap]] = [pool[swap], pool[index]];
        }

        const drawn = pool
            .map(href => ({ href, lastShown: rotations.findLastIndex(rotation => rotation.includes(href)) }))
            .toSorted((a, b) => a.lastShown - b.lastShown)
            .slice(0, STRIP_LIMIT)
            .map(({ href }) => href);

        return pool.filter(href => drawn.includes(href));
    }

    function enterCards(cards: HTMLElement[], entering: string[], tokens: MotionTokens) {
        const slots = cards.slice(0, STRIP_LIMIT);

        slots.forEach(slot => revealTarget(slot));
        swapCards(cards, entering);

        gsap.fromTo(slots, { opacity: 0, x: tokens.travel * ROTATE_TRAVEL_FACTOR, y: 0 }, {
            duration: tokens.duration.slower,
            ease: tokens.ease.entrance,
            onComplete: () => finishRotation(slots),
            opacity: 1,
            overwrite: 'auto',
            stagger: tokens.stagger.base,
            x: 0,
        });
    }

    function finishRotation(slots: HTMLElement[]) {
        isRotating = false;
        gsap.set(slots, { clearProps: 'transform' });
    }

    function initRosterRotation(signal: AbortSignal) {
        const carried = carriedRotations;
        const strip = document.querySelector<HTMLElement>('[data-producer-strip]');

        carriedRotations = [];

        if (!strip) return;

        const cards = Array.from(strip.querySelectorAll<HTMLElement>(':scope > li'));

        if (cards.length <= STRIP_LIMIT) return;

        const { bottom, top } = strip.getBoundingClientRect();

        const isUnseen = bottom <= 0 || cards.every(card => getComputedStyle(card).opacity === '0') || top >= window.innerHeight;

        if (carried.length > 0) placeCards(cards, carried[carried.length - 1]);
        else if (isUnseen) placeCards(cards, drawRotation(cards, []));

        isRotating = false;
        isVisible = true;
        shownRotations = [...carried.slice(0, -1), cards.slice(0, STRIP_LIMIT).map(readHref)];

        const observer = new IntersectionObserver((entries) => {
            isVisible = entries[0]?.isIntersecting ?? false;
        });

        clearInterval(rotateTimer);
        observer.observe(strip);
        rotateTimer = setInterval(() => rotateStrip(strip, cards), ROTATE_INTERVAL_MILLISECONDS);
        signal.addEventListener('abort', () => stopRotation(cards, observer), { once: true });
    }

    function placeCards(cards: HTMLElement[], hrefs: string[]) {
        hrefs.forEach((href, index) => {
            const slot = cards[index];
            const source = cards.find(card => readHref(card) === href);

            if (!source || source === slot) return;

            const held = Array.from(slot.children);

            slot.replaceChildren(...source.children);
            source.replaceChildren(...held);
        });
    }

    function readHref(card: HTMLElement) {
        return card.querySelector('a')?.getAttribute('href') ?? '';
    }

    function rotateStrip(strip: HTMLElement, cards: HTMLElement[]) {
        if (!isVisible || document.hidden || isRotating) return;
        if (strip.contains(document.activeElement) || strip.matches(':hover')) return;

        const entering = drawRotation(cards, shownRotations);

        if (window.matchMedia(REDUCED_MOTION_QUERY).matches) {
            swapCards(cards, entering);

            return;
        }

        const slots = cards.slice(0, STRIP_LIMIT);
        const tokens = getMotionTokens();

        isRotating = true;

        gsap.to(slots, {
            duration: tokens.duration.slower,
            ease: tokens.ease.mechanical,
            onComplete: () => enterCards(cards, entering, tokens),
            onInterrupt: () => {
                isRotating = false;
            },
            opacity: 0,
            overwrite: 'auto',
            stagger: tokens.stagger.base,
            y: tokens.travel * ROTATE_TRAVEL_FACTOR,
        });
    }

    function stopRotation(cards: HTMLElement[], observer: IntersectionObserver) {
        if (!cards[0].isConnected) carriedRotations = shownRotations;

        clearInterval(rotateTimer);
        gsap.getTweensOf(cards).forEach(tween => tween.kill());
        observer.disconnect();
        rotateTimer = undefined;
    }

    function swapCards(cards: HTMLElement[], entering: string[]) {
        shownRotations = [...shownRotations, entering].slice(-RECENT_ROTATIONS);
        placeCards(cards, entering);
    }

    initTracks();
    registerPageScript(initRosterRotation, true);
</script>
