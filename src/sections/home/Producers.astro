---
import { getCollection } from 'astro:content';

import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import ProducerTracks from '@components/producer/Tracks.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { PALETTE, PRODUCER_AVAILABILITY_LABELS } from '@lib/constants';
import { formatMonthOnly, getInitials, toIsoDate } from '@lib/utils';

const STRIP_LIMIT = 4;

const producers = await getCollection('producers');

const featured = producers.find(producer => producer.data.featured);
const roster = producers.filter(producer => producer.id !== featured?.id).slice(0, STRIP_LIMIT);
const track = featured?.data.tracks[0];
---

{featured && (
    <section
        class="slab--well stage border-b-2 border-ink"
        aria-labelledby="featured-producer-title"
    >
        <div
            class="halftone--accent stage__item--full absolute inset-0 pointer-events-none"
            aria-hidden="true"
        />
        <div class="relative">
            <SectionHead
                class="font-extrabold font-sans leading-[0.9] text-display tracking-[-0.04em]"
                eyebrow={`Featured producer / ${featured.data.handle}`}
                eyebrowClass="mb-5"
                headingId="featured-producer-title"
                tone="dark"
            >
                {featured.data.name}.
            </SectionHead>
            <div class="rank rank--split items-start">
                <div>
                    <div
                        class="producer-feature__portrait mb-6"
                        data-motion="unfold"
                    >
                        <PlaceholderTile
                            class="slab slab--bare slab--card aspect-square"
                            color={PALETTE[0]}
                            label={getInitials(featured.data.name)}
                            labelClass="leading-none text-[clamp(64px,10vw,120px)] text-surface-raised/80 [text-shadow:3px_3px_0_var(--color-ink-20)]"
                        />
                    </div>
                    <p
                        class="label text-ink-inverse-muted"
                        data-placeholder
                    >
                        On the roster since <time datetime={toIsoDate(featured.data.joined)}>{formatMonthOnly(featured.data.joined)}</time>
                    </p>
                </div>
                <div data-motion-stagger="rise">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 mb-6">
                        <p class="label inline-flex items-center h-8 px-3 bg-accent text-ink">
                            {PRODUCER_AVAILABILITY_LABELS[featured.data.availability]}
                        </p>
                        <p
                            class="font-mono text-xs uppercase text-ink-inverse-muted"
                            data-placeholder
                        >
                            {featured.data.roles.join(' \u00b7 ')} &mdash; {featured.data.location}
                        </p>
                    </div>
                    <p
                        class="max-w-xl mb-6 leading-relaxed text-md text-ink-inverse-muted"
                        data-placeholder
                    >
                        {featured.data.bio}
                    </p>
                    <ul class="flex flex-wrap gap-2 mb-8 list-none">
                        {featured.data.genres.map(genre => (
                            <li class="label inline-flex items-center h-8 px-3 border-2 border-ink-inverse">{genre}</li>
                        ))}
                    </ul>
                    {track && (
                        <div class="slab slab--bare slab--card max-w-xl text-ink">
                            <p class="label pb-2 pt-3 px-3 text-accent-deep">Latest track</p>
                            <ProducerTracks
                                producerId={featured.id}
                                track={track}
                            />
                        </div>
                    )}
                    <div class="flex flex-wrap items-center gap-6 mt-10">
                        <a
                            class="btn btn--accent"
                            href={`/producers#${featured.id}`}
                        >
                            Full profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
)}

<section
    class="slab--sunk stage border-b-2 border-ink"
    aria-labelledby="producers-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow="Producers / Roster"
            headingId="producers-title"
        >
            Every genre. One scene.
            <a
                class="action-text hover:text-accent-deep hidden items-center min-h-[50px] transition-colors md:inline-flex"
                href="/producers"
                slot="cta"
            >
                Full roster &rarr;
            </a>
        </SectionHead>
        <ul
            class="producer-strip grid grid-cols-1 gap-6 list-none lg:gap-8 lg:grid-cols-4 sm:grid-cols-2"
            data-motion-stagger="rise"
        >
            {roster.map((producer, index) => (
                <li>
                    <a
                        class="slab slab--bare slab--card slab--hover"
                        href={`/producers#${producer.id}`}
                    >
                        <PlaceholderTile
                            class="aspect-square border-b-2 border-ink"
                            color={PALETTE[(index + 1) % PALETTE.length]}
                            label={getInitials(producer.data.name)}
                            labelClass="leading-none text-[56px] text-surface-raised/80 [text-shadow:2px_2px_0_var(--color-ink-20)] md:text-[64px]"
                        >
                            <div
                                class="label absolute bottom-0 inset-x-0 p-3 bg-linear-to-t from-ink-70 text-ink-inverse to-transparent"
                                data-placeholder
                            >
                                {producer.data.handle}
                            </div>
                        </PlaceholderTile>
                        <h3
                            class="mb-1 pt-4 px-4 font-extrabold font-sans text-lg tracking-tight"
                            data-placeholder
                        >
                            {producer.data.name}
                        </h3>
                        <p class="label pb-4 px-4 text-ink-muted">{producer.data.genres.slice(0, 2).join(' / ')}</p>
                    </a>
                </li>
            ))}
        </ul>
        <a
            class="btn mt-10 md:hidden"
            href="/producers"
        >
            Full roster
        </a>
    </div>
</section>

<script>
    import { initTracks } from '@lib/tracks';

    initTracks();
</script>

<style>
    .producer-feature__portrait {
        rotate: calc(var(--tilt-unit) * -2 * var(--drift-gate));
    }

    .producer-strip {
        grid-auto-rows: auto;
    }

    .producer-strip > li,
    .producer-strip > li > a {
        align-content: start;
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: 0;
    }
</style>
