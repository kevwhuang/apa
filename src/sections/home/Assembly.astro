---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate, formatTimeRange, getProgram } from '@lib/utils';

const program = getProgram('assembly');

const events = await getCollection('events');

const [next] = events
    .filter(event => event.data.type === 'assembly' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--assembly border-b-2 border-ink"
    aria-labelledby="landing-assembly-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="landing-assembly-title"
        >
            Next {program.name}.
            <a
                class="action-text hover:text-accent-deep hidden items-center min-h-[50px] transition-colors md:inline-flex"
                href="/events"
                slot="cta"
            >
                All events &rarr;
            </a>
        </SectionHead>
        <p class="max-w-2xl mb-10 leading-relaxed text-base text-ink-muted">
            {program.summary}
        </p>
        {next
            ? (
                    <article
                        class="slab slab--cut slab--lift mark grid grid-cols-12 items-start gap-x-2 gap-y-6 md:gap-x-8"
                        data-motion="unfold"
                    >
                        <div class="col-span-12 md:col-span-4">
                            <p class="label mb-2 text-accent-deep">{program.shortName}</p>
                            <p
                                class="font-extrabold font-sans text-3xl"
                                data-placeholder
                            >
                                <time datetime={next.data.date.toISOString()}>{formatDate(next.data.date)}</time>
                            </p>
                            <p
                                class="mt-1 font-mono text-xs uppercase text-ink-muted"
                                data-placeholder
                            >
                                {formatTimeRange(next.data.date, next.data.end)}
                            </p>
                        </div>
                        <div class="col-span-12 md:col-span-8">
                            <h3 class="font-extrabold font-sans text-2xl tracking-tight">{next.data.title}</h3>
                            <address class="mt-2 font-mono not-italic text-xs uppercase text-ink-muted">
                                {next.data.location}
                            </address>
                            <p class="max-w-2xl mt-4 leading-relaxed text-ink-muted">{next.data.excerpt}</p>
                            <div class="flex flex-wrap gap-3 mt-8">
                                <a
                                    class="btn btn--primary"
                                    href="/assembly"
                                >
                                    {program.shortName} details
                                </a>
                                <a
                                    class="btn"
                                    href="/events"
                                >
                                    All events
                                </a>
                            </div>
                        </div>
                    </article>
                )
            : (
                    <div data-motion="rise">
                        <p class="text-ink-muted">
                            No {program.name} on the calendar right now &mdash; the next date goes up as soon as the room is booked.
                        </p>
                        <div class="flex flex-wrap gap-3 mt-8">
                            <a
                                class="btn btn--primary"
                                href="/assembly"
                            >
                                {program.shortName} details
                            </a>
                            <a
                                class="btn"
                                href="/events"
                            >
                                All events
                            </a>
                        </div>
                    </div>
                )}
    </div>
</section>
