---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { formatCalendarDay, formatCalendarMonth, formatTimeRange, formatWeekday, getProgram, isUpcoming } from '@lib/shared/utils';

const events = await getCollection('events');

const program = getProgram('assembly');

const upcoming = events
    .filter(event => event.data.type === 'assembly' && isUpcoming(event.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--assembly border-b-2 border-border-strong"
    aria-labelledby="landing-assembly-title"
>
    <div>
        <SectionHead
            class="text-4xl sm:text-5xl md:text-7xl"
            eyebrow={`${program.shortName}, ${program.cadence}`}
            headingId="landing-assembly-title"
        >
            Next {program.name}.
            <a
                class="action-text hover:text-link hidden items-center gap-2 min-h-(--control-size) whitespace-nowrap transition-colors md:inline-flex"
                href="/events"
                slot="cta"
            >
                All events <IconArrow />
            </a>
        </SectionHead>
        <p
            class="max-w-2xl leading-relaxed text-lg text-text-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
    </div>
    {upcoming.map((event, index) => (
        <article
            class="assembly-sheet mark slab slab--bare slab--lift stage__item--runoff"
            data-event-end={event.data.end.toISOString()}
            data-event-group="home-assembly"
            data-event-role="next"
            hidden={index > 0}
        >
            <p
                class="assembly-sheet__plate"
                data-motion="wipe"
            >
                <span
                    class="assembly-sheet__tag label px-2 py-1 bg-bg-signal text-text-on-signal"
                    data-motion="stamp"
                >
                    Next {program.shortName}
                </span>
                <time
                    class="contents"
                    datetime={event.data.date.toISOString()}
                >
                    <span class="assembly-sheet__day">{formatCalendarDay(event.data.date)}</span>
                    <span class="assembly-sheet__month">{formatCalendarMonth(event.data.date)}</span>
                </time>
                <span class="font-mono text-xs tracking-[0.06em] text-event-assembly-text">{formatWeekday(event.data.date)}</span>
                <span
                    class="halftone--accent absolute bottom-0 inset-x-0 h-[calc(var(--drift-unit)*2)]"
                    aria-hidden="true"
                />
            </p>
            <div
                class="assembly-sheet__body"
                data-motion="rise"
            >
                <h3 class="mb-4 font-display text-3xl">{event.data.title}</h3>
                <p class="mb-1 font-mono text-xs text-text-secondary">
                    {formatTimeRange(event.data.date, event.data.end)}
                </p>
                <address class="mb-5 font-mono not-italic text-xs text-text-secondary">
                    {event.data.location}
                </address>
                <p class="max-w-2xl mb-8 leading-relaxed text-lg text-text-secondary">{event.data.excerpt}</p>
                <div class="flex flex-wrap gap-3">
                    <a
                        class="btn btn--primary"
                        href="/assembly"
                    >
                        {program.shortName} details
                    </a>
                    <a
                        class="btn"
                        href="/events"
                    >
                        All events
                    </a>
                </div>
            </div>
        </article>
    ))}
    <div
        class="max-w-(--measure-form)"
        data-event-group="home-assembly"
        data-event-role="none"
        data-motion="rise"
        hidden={upcoming.length > 0}
    >
        <p class="mb-8 text-text-secondary">
            No {program.name} on the calendar right now &mdash; the next date goes up as soon as the room is booked.
        </p>
        <div class="flex flex-wrap gap-3">
            <a
                class="btn btn--primary"
                href="/assembly"
            >
                {program.shortName} details
            </a>
            <a
                class="btn"
                href="/events"
            >
                All events
            </a>
        </div>
    </div>
</section>

<Schedule />

<style>
    .assembly-sheet {
        --assembly-bleed: max(var(--shell-pad), calc(100% - var(--shell-inner)));
        --assembly-gutter: max(var(--shell-pad), calc((100vw - var(--shell-inner)) / 2));
        --assembly-plate: 34%;
        display: grid;
        grid-template-columns: minmax(min-content, calc(var(--assembly-bleed) + var(--assembly-plate))) minmax(0, 1fr);
    }

    .assembly-sheet__body {
        padding-block: calc(var(--space-2xl) * 1.75);
        padding-inline: var(--space-2xl);
    }

    .assembly-sheet__day {
        font-family: var(--font-display);
        font-size: var(--text-10xl);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 0.78;
    }

    .assembly-sheet__month {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        letter-spacing: 0.1em;
        white-space: nowrap;
    }

    .assembly-sheet__plate {
        align-content: center;
        background: var(--color-event-assembly);
        color: var(--color-event-assembly-text);
        display: grid;
        gap: var(--space-xs);
        justify-items: start;
        overflow: clip;
        padding-block: calc(var(--space-2xl) * 2.25);
        padding-inline: var(--assembly-gutter) var(--space-2xl);
        position: relative;
    }

    @media (max-width: 1024px) {
        .assembly-sheet__body {
            padding-inline: var(--space-lg);
        }

        .assembly-sheet__plate {
            padding-block: calc(var(--space-2xl) * 2);
            padding-inline: var(--assembly-gutter) var(--space-lg);
        }
    }

    @media (max-width: 768px) {
        .assembly-sheet {
            grid-template-columns: minmax(0, 1fr);
        }

        .assembly-sheet__body {
            padding-block: var(--space-lg);
            padding-inline: var(--shell-pad) var(--space-md);
        }

        .assembly-sheet__day {
            font-size: var(--text-9xl);
            grid-row: span 2;
        }

        .assembly-sheet__month {
            font-size: var(--text-sm);
        }

        .assembly-sheet__plate {
            align-content: start;
            align-items: center;
            column-gap: var(--space-sm);
            grid-template-columns: auto minmax(0, 1fr);
            padding-block: var(--space-lg);
            padding-inline: var(--assembly-gutter) var(--space-md);
        }

        .assembly-sheet__tag {
            grid-column: 1 / -1;
        }
    }
</style>
