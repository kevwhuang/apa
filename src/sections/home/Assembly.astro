---
import { getCollection } from 'astro:content';

import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatCalendarDay, formatCalendarMonth, formatCredit, formatTimeRange, formatVenue, getProgram, isUpcoming } from '@lib/shared/utils';

const events = await getCollection('events');

const program = getProgram('assembly');

const sessions = events
    .filter(event => event.data.type === 'assembly' && isUpcoming(event.data.end))
    .sort((a, b) => +a.data.date - +b.data.date)
    .map(event => ({
        credit: formatCredit(event.data.title),
        date: event.data.date.toISOString(),
        day: formatCalendarDay(event.data.date),
        end: event.data.end.toISOString(),
        excerpt: event.data.excerpt,
        month: formatCalendarMonth(event.data.date),
        room: event.data.room,
        rsvp: event.data.rsvp ?? LINKS.meetup,
        time: formatTimeRange(event.data.date, event.data.end),
        venue: formatVenue(event.data.location),
        workshop: event.data.workshop,
    }));
---

<section
    class="stage @container border-b-2 border-border-strong"
    aria-labelledby="landing-assembly-title"
    data-event-group="home-assembly"
    data-event-role="some"
    hidden={sessions.length === 0}
>
    <div>
        <SectionHead
            class="text-3xl-7xl"
            headingId="landing-assembly-title"
        >
            Next {program.name}
        </SectionHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
    </div>
    {sessions.map((session, index) => (
        <article
            class="assembly-sheet slab slab--bare slab--lift slab--still"
            data-event-end={session.end}
            data-event-group="home-assembly"
            data-event-role="next"
            hidden={index > 0}
        >
            <p
                class="assembly-sheet__plate"
                data-motion="wipe"
            >
                <time
                    class="contents"
                    datetime={session.date}
                >
                    <span class="font-bold font-display text-7xl-10xl tracking-[-0.02em]">{session.day}</span>
                    <span class="font-bold font-display leading-none text-2xl-3xl tracking-[-0.02em] whitespace-nowrap">{session.month}</span>
                </time>
                <span
                    class="halftone--accent absolute bottom-0 inset-x-0 h-[calc(var(--drift-unit)*2)]"
                    aria-hidden="true"
                />
            </p>
            <div
                class="assembly-sheet__body"
                data-motion="rise"
            >
                {session.workshop && (
                    <hgroup class="flex flex-col gap-3 mb-6">
                        {session.credit && (
                            <p class="font-bold text-lg tracking-tight">
                                {session.credit}
                            </p>
                        )}
                        <h3 class="font-display text-2xl-3xl text-balance">
                            {session.workshop}
                        </h3>
                    </hgroup>
                )}
                <p class="max-w-2xl mb-8 text-lg text-text-secondary">{session.excerpt}</p>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-5 mb-8 max-lg:grid-cols-1">
                    <div>
                        <dt class="label mb-2 text-text-secondary">Time</dt>
                        <dd class="font-bold text-balance text-xl">{session.time}</dd>
                    </div>
                    <div>
                        <dt class="label mb-2 text-text-secondary">Where</dt>
                        <dd class="font-bold text-xl">
                            <address class="mb-1 not-italic">{session.venue}</address>
                            {session.room && (
                                <p>{session.room}</p>
                            )}
                        </dd>
                    </div>
                    <div>
                        <dt class="label mb-2 text-text-secondary">RSVP</dt>
                        <dd class="font-bold text-xl">
                            <a
                                class="hit active:translate-y-px hover:text-link inline-block underline underline-offset-4 transition-[color,translate]"
                                href={session.rsvp}
                                rel="noopener noreferrer"
                                target="_blank"
                            >
                                meetup.com
                                <span class="sr-only">&nbsp;(opens in a new tab)</span>
                            </a>
                        </dd>
                    </div>
                </dl>
                <div class="flex flex-wrap gap-3">
                    <a
                        class="btn btn--primary"
                        href="/assemblies"
                    >
                        All Assemblies
                    </a>
                </div>
            </div>
        </article>
    ))}
</section>

<Schedule />

<style>
    .assembly-sheet {
        --assembly-bleed: max(var(--shell-pad), calc(100% - var(--shell-inner)));
        --assembly-gutter: calc(max(var(--shell-pad), (100cqw - var(--shell-inner)) / 2) - var(--slab-rule));
        --assembly-plate: calc((100% - var(--assembly-bleed)) / 3);
        display: grid;
        grid-column: full-start / main-end;
        grid-template-columns: minmax(min-content, calc(var(--assembly-bleed) + var(--assembly-plate))) minmax(0, 1fr);
    }

    .assembly-sheet__body {
        padding-block: round(var(--space-2xl) * 1.75, 4px);
        padding-inline: var(--space-2xl);
    }

    .assembly-sheet__plate {
        align-content: center;
        background: var(--color-event-assembly);
        color: var(--color-event-assembly-text);
        display: grid;
        gap: 12px;
        justify-items: start;
        overflow: clip;
        padding-block: round(var(--space-2xl) * 2.25, 4px);
        padding-inline: var(--assembly-gutter) var(--space-2xl);
        position: relative;
    }

    @media (max-width: 1024px) {
        .assembly-sheet {
            --assembly-plate: 34%;
        }

        .assembly-sheet__body {
            padding-inline: var(--space-lg);
        }

        .assembly-sheet__plate {
            padding-block: calc(var(--space-2xl) * 2);
            padding-inline: var(--assembly-gutter) var(--space-lg);
        }
    }

    @media (max-width: 768px) {
        .assembly-sheet {
            grid-template-columns: minmax(0, 1fr);
        }

        .assembly-sheet__body {
            padding-block: var(--space-lg);
            padding-inline: var(--shell-pad) var(--space-md);
        }

        .assembly-sheet__plate {
            align-content: start;
            padding-block: var(--space-lg) calc(var(--drift-unit) * 2 + 12px);
            padding-inline: var(--assembly-gutter) var(--space-md);
        }
    }
</style>
