---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate, formatTimeRange, getProgram, isUpcoming } from '@lib/shared/utils';

const editions = await getCollection('bash');

const program = getProgram('bash');

const upcoming = editions
    .filter(edition => isUpcoming(edition.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--bash border-b-2 border-border-strong"
    aria-labelledby="bash-title"
>
    <div
        class="bash-well fold slab slab--well stage__item--runoff"
        data-motion="wipe"
    >
        <div
            class="absolute inset-0 overflow-clip pointer-events-none"
            aria-hidden="true"
        >
            <div
                class="halftone--accent absolute -inset-y-[8%] inset-x-0"
                data-scrub="drift"
            />
        </div>
        <div class="relative">
            <SectionHead
                class="text-3xl md:text-7xl lg:text-8xl"
                eyebrow={`${program.shortName}, ${program.cadence}`}
                headingId="bash-title"
                tone="dark"
            >
                Next {program.name}.
            </SectionHead>
            <p
                class="max-w-xl mb-10 leading-relaxed text-lg text-text-inverse-secondary"
                data-motion="rise"
            >
                {program.summary}
            </p>
            <div
                class="flex flex-wrap items-center gap-6"
                data-motion="rise"
            >
                <a
                    class="btn btn--accent"
                    href="/bash"
                >
                    {program.shortName} details
                </a>
                <a
                    class="action-text hover:text-link-on-inverse inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 text-text-inverse transition-colors"
                    href="/partners"
                >
                    Partner on it <IconArrow />
                </a>
            </div>
        </div>
    </div>
    {[...upcoming, undefined].map((edition, index) => (
        <dl
            class="slab slab--cut slab--lift grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-2"
            data-event-end={edition?.data.end.toISOString()}
            data-event-group="home-bash"
            data-event-role={edition ? 'next' : 'none'}
            data-motion-stagger="rise"
            hidden={index > 0}
        >
            <div>
                <dt class="label mb-2 text-text-secondary">Cadence</dt>
                <dd class="capitalize font-bold font-display text-3xl tracking-[-0.02em]">{program.cadence}</dd>
            </div>
            <div>
                <dt class="label mb-2 text-text-secondary">Next</dt>
                <dd>
                    {edition
                        ? (
                                <>
                                    <span class="block mb-1 font-bold font-sans text-xl">
                                        <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                                    </span>
                                    <span class="block font-mono text-xs text-text-secondary">
                                        {formatTimeRange(edition.data.date, edition.data.end)}
                                    </span>
                                </>
                            )
                        : <span class="font-bold font-sans text-xl">To be announced</span>}
                </dd>
            </div>
            <div>
                <dt class="label mb-2 text-text-secondary">Where</dt>
                <dd>
                    <address class="font-bold font-sans not-italic text-lg">
                        {edition ? edition.data.location : 'To be announced'}
                    </address>
                </dd>
            </div>
            <div>
                <dt class="label mb-2 text-text-secondary">Prompt</dt>
                <dd class="font-bold font-sans text-lg">
                    {edition ? edition.data.prompt : 'To be announced'}
                </dd>
            </div>
        </dl>
    ))}
</section>

<Schedule />
