---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatDateStamp, formatTimeRange, getProgram, isUpcoming } from '@lib/shared/utils';

const editions = await getCollection('bash');

const program = getProgram('bash');

const upcoming = editions
    .filter(edition => isUpcoming(edition.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage border-b-2 border-border-strong"
    aria-labelledby="landing-bash-title"
    data-event-group="home-bash"
    data-event-role="some"
    hidden={upcoming.length === 0}
>
    <div
        class="bash-well slab slab--well"
        data-motion="wipe"
    >
        <div
            class="absolute inset-0 overflow-clip pointer-events-none"
            aria-hidden="true"
        >
            <div
                class="halftone--accent -inset-y-[8%] absolute inset-x-0"
                data-scrub="drift"
            />
        </div>
        <div class="relative">
            <SectionHead
                class="text-3xl-8xl"
                headingId="landing-bash-title"
            >
                Next {program.name}
            </SectionHead>
            <p
                class="max-w-xl mb-10 text-lg text-text-inverse-secondary"
                data-motion="blur"
            >
                {program.summary}
            </p>
            <div
                class="flex flex-wrap items-center gap-6"
                data-motion="rise"
            >
                <a
                    class="btn btn--accent"
                    href="/bashes"
                >
                    All Bashes
                </a>
                <a
                    class="action-text inline-flex items-center min-h-(--control-size) gap-2 underline underline-offset-4 text-text-inverse"
                    href="/partners"
                >
                    Partner on it <IconArrow />
                </a>
            </div>
        </div>
    </div>
    {upcoming.map((edition, index) => (
        <dl
            class="slab slab--cut slab--lift slab--still grid grid-cols-3 gap-x-6 gap-y-5 max-lg:grid-cols-2 max-md:grid-cols-1"
            data-event-end={edition.data.end.toISOString()}
            data-event-group="home-bash"
            data-event-role="next"
            data-motion-stagger="rise"
            hidden={index > 0}
        >
            <div>
                <dt class="label mb-2 text-text-secondary">When</dt>
                <dd class="font-bold text-xl">
                    <time
                        class="block mb-1 text-marker-cobalt"
                        datetime={edition.data.date.toISOString()}
                    >
                        {formatDateStamp(edition.data.date)}
                    </time>
                    <span class="block text-balance">{formatTimeRange(edition.data.date, edition.data.end)}</span>
                </dd>
            </div>
            <div>
                <dt class="label mb-2 text-text-secondary">Where</dt>
                <dd class="font-bold text-xl">
                    <address class="mb-1 not-italic">{edition.data.location}</address>
                    {edition.data.room && (
                        <p>{edition.data.room}</p>
                    )}
                </dd>
            </div>
            <div>
                <dt class="label mb-2 text-text-secondary">RSVP</dt>
                <dd class="font-bold text-xl">
                    <a
                        class="hit active:translate-y-px hover:text-link inline-block underline underline-offset-4 transition-[color,translate]"
                        href={LINKS.meetup}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        meetup.com
                        <span class="sr-only">&nbsp;(opens in a new tab)</span>
                    </a>
                </dd>
            </div>
        </dl>
    ))}
</section>

<Schedule />

<style>
    .bash-well {
        grid-column: main-start / full-end;
        padding-block: var(--space-2xl);
        padding-inline: var(--shell-pad) max(var(--shell-pad), calc(100% - var(--shell-inner)));
    }

    .bash-well::before {
        background-color: var(--slab-fill);
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        content: '';
        height: calc(var(--drift-unit) * 1.5 + 1px);
        inset: calc(var(--drift-unit) * -1.5) 0 auto;
        pointer-events: none;
        position: absolute;
    }
</style>
