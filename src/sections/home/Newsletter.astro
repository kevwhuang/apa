---
import SectionHead from '@components/shared/SectionHead.astro';
---

<section
    class="stage"
    aria-labelledby="newsletter-title"
>
    <div
        class="mark slab slab--roomy slab--sunk grid grid-cols-1 items-end gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
        data-motion="unfold"
    >
        <div>
            <SectionHead
                class="font-extrabold font-sans leading-[1.05] text-3xl tracking-[-0.035em] md:text-5xl"
                eyebrow="Signal"
                headingId="newsletter-title"
            >
                Get the dispatch.
            </SectionHead>
            <p class="max-w-md text-ink-muted">
                One email a season. What's on the calendar, what the roster has been working on,
                and where to find us next.
            </p>
        </div>
        <form class="newsletter-form flex flex-col gap-3">
            <div class="flex flex-col gap-3 lg:flex-row lg:gap-2 lg:items-end">
                <label class="block flex-1">
                    <span class="label block mb-2 text-ink-muted">
                        Email
                    </span>
                    <input
                        class="input font-mono text-sm"
                        autocomplete="email"
                        name="email"
                        placeholder="you@studio.fm"
                        required
                        type="email"
                    />
                </label>
                <button
                    class="btn btn--accent w-full lg:w-auto"
                    type="submit"
                >
                    Subscribe
                </button>
            </div>
            <p
                class="action-text hidden p-3 bg-accent text-ink"
                data-output
            />
        </form>
    </div>
</section>

<script>
    import { EMAIL_PATTERN, STORAGE } from '@lib/constants';
    import { createStore } from '@lib/state';
    import { isValidationBypassed } from '@lib/ui/forms';
    import { toast } from '@lib/ui/toasts';
    import { registerPageScript } from '@lib/utils';

    interface NewsletterElements {
        button: HTMLButtonElement;
        input: HTMLInputElement;
        output: HTMLElement;
    }

    const INVALID_MESSAGE = 'Enter a valid email address.';

    const subscription = createStore<string | null>({
        fallback: null,
        key: STORAGE.newsletter.key,
        normalize: normalizeEmail,
        scope: STORAGE.newsletter.scope,
        topic: STORAGE.newsletter.topic,
    });

    function confirmationMessage(email: string, returning: boolean) {
        return returning
            ? `You are already on the list \u2014 the next dispatch goes to ${email}.`
            : 'You are on the list. The next dispatch lands in your inbox.';
    }

    function handleNewsletterSubmit(event: SubmitEvent, elements: NewsletterElements) {
        event.preventDefault();

        const subscribed = subscription.get();

        if (subscribed !== null) {
            showConfirmation(elements, subscribed, true);
            toast('You are already on the list.', 'info');

            return;
        }

        const email = readEmail(elements.input);

        if (email === null) {
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        subscription.set(email);
        showConfirmation(elements, email, false);
        toast('You are on the list \u2014 the next dispatch lands in your inbox.', 'success');
    }

    function initNewsletter(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.newsletter-form');
        const button = form?.querySelector<HTMLButtonElement>('button');
        const input = form?.querySelector<HTMLInputElement>('input');
        const output = form?.querySelector<HTMLElement>('[data-output]');

        if (!form || !button || !input || !output) return;

        const elements = { button, input, output };
        const subscribed = subscription.get();

        form.noValidate = true;
        form.addEventListener('submit', event => handleNewsletterSubmit(event, elements), { signal });

        if (subscribed !== null) showConfirmation(elements, subscribed, true);
    }

    function normalizeEmail(value: string | null) {
        const email = typeof value === 'string' ? value.trim().toLowerCase() : '';

        return EMAIL_PATTERN.test(email) ? email : null;
    }

    function readEmail(input: HTMLInputElement) {
        const email = normalizeEmail(input.value);

        if (email !== null || !isValidationBypassed()) return email;

        return input.value.trim().toLowerCase() || input.placeholder;
    }

    function showConfirmation(elements: NewsletterElements, email: string, returning: boolean) {
        const { button, input, output } = elements;

        button.disabled = true;
        input.disabled = true;
        input.value = email;
        output.textContent = confirmationMessage(email, returning);
        output.classList.remove('hidden');

        if (returning) return;

        output.tabIndex = -1;
        output.focus();
    }

    registerPageScript(initNewsletter);
</script>
