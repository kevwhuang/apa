---
import SectionHead from '@components/shared/SectionHead.astro';
import { EMAIL_MAX_LENGTH } from '@lib/shared/constants';
---

<section
    class="stage"
    aria-labelledby="newsletter-title"
>
    <div
        class="slab slab--roomy slab--sunk grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-end gap-10 max-md:grid-cols-1"
        data-motion="unfold"
    >
        <div>
            <SectionHead
                class="text-2xl-5xl"
                headingId="newsletter-title"
            >
                Get the dispatch
            </SectionHead>
            <p class="max-w-md text-lg text-text-secondary">
                We send one email a season with what is on the calendar, what the roster has been
                working on, and where to find us next.
            </p>
        </div>
        <form class="newsletter-form flex flex-col gap-3">
            <div class="flex items-end gap-2 max-lg:flex-col max-lg:gap-3 max-lg:items-stretch">
                <label class="block flex-1">
                    <span class="label block mb-2 text-text-secondary">
                        Email
                    </span>
                    <input
                        id="newsletter-email"
                        class="input font-mono"
                        aria-invalid="false"
                        autocomplete="email"
                        maxlength={EMAIL_MAX_LENGTH}
                        name="email"
                        placeholder="you@studio.fm"
                        required
                        type="email"
                    />
                </label>
                <button
                    class="btn btn--accent w-auto max-lg:w-full"
                    type="submit"
                >
                    Subscribe
                </button>
            </div>
            <p
                class="hidden p-3 bg-signal text-text-on-signal"
                data-output
            />
        </form>
        <div
            class="flex flex-col gap-3"
            data-newsletter-leave
            hidden
        >
            <p class="p-3 bg-signal text-text-on-signal">
                Leaving the dispatch? Press the button and the emails stop.
            </p>
            <button
                class="btn btn--accent self-start max-lg:self-stretch"
                type="button"
            >
                Unsubscribe
            </button>
        </div>
    </div>
</section>

<script>
    import { EMAIL_MAX_LENGTH, EMAIL_MESSAGE, EMAIL_PATTERN, UNSUBSCRIBE_PARAMETER } from '@lib/shared/constants';
    import { applyInstantly, registerPageScript, setHidden, setPending } from '@lib/shared/utils';
    import { clearFieldErrors, reportFieldErrors, validateFields, watchFieldErrors } from '@lib/ui/forms';
    import { getAccessToken, supabase } from '@lib/shared/supabase';
    import { getSession, onSessionChange } from '@lib/account/session';
    import { sendRequest } from '@lib/shared/request';
    import { toast } from '@lib/ui/toasts';

    interface NewsletterElements {
        button: HTMLButtonElement;
        form: HTMLFormElement;
        input: HTMLInputElement;
        leave: HTMLElement;
        leaveButton: HTMLButtonElement;
        output: HTMLElement;
    }

    interface SubscriberRow {
        status: string;
    }

    const CONFIRMED_MESSAGE = 'You are on the list. The next dispatch lands in your inbox.';

    const RULES: Record<string, FieldRule> = {
        email: { max: EMAIL_MAX_LENGTH, message: EMAIL_MESSAGE, pattern: EMAIL_PATTERN, required: true },
    };

    const SUBSCRIBED_MESSAGE = 'Your account is already on the list.';

    const submitting = new WeakSet<HTMLFormElement>();

    let stopSessionWatch: (() => void) | undefined;

    async function handleLeaveConfirm(elements: NewsletterElements, token: string, signal: AbortSignal) {
        const { form, leave, leaveButton } = elements;

        setPending(leaveButton, true);

        const result = await sendRequest(`/api/unsubscribe?token=${encodeURIComponent(token)}`, { method: 'POST' });

        setPending(leaveButton, false);
        toast(result.ok ? 'You are off the list.' : result.message, result.ok ? 'success' : 'error');

        if (signal.aborted || (!result.ok && result.code !== 'rejected')) return;

        setHidden(form, false);
        setHidden(leave, true);
        history.replaceState(history.state, '', window.location.pathname);
    }

    async function handleNewsletterSubmit(event: SubmitEvent, elements: NewsletterElements) {
        event.preventDefault();

        if (submitting.has(elements.form)) return;

        const { button, form, input } = elements;

        const errors = validateFields(form, RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const email = input.value.trim().toLowerCase();

        submitting.add(form);
        setPending(button, true);

        const result = await sendRequest('/api/newsletter', { body: { email }, method: 'POST', token: await getAccessToken() });

        submitting.delete(form);
        setPending(button, false);

        if (!result.ok) {
            if (result.code === 'rejected') reportFieldErrors(form, { email: result.message });
            else toast(result.message, 'error');

            return;
        }

        showConfirmation(elements, email, false);
        toast(CONFIRMED_MESSAGE, 'success');
    }

    function initNewsletter(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.newsletter-form');
        const leave = document.querySelector<HTMLElement>('[data-newsletter-leave]');

        const button = form?.querySelector<HTMLButtonElement>('button');
        const input = form?.querySelector<HTMLInputElement>('input');
        const leaveButton = leave?.querySelector<HTMLButtonElement>('button');
        const output = form?.querySelector<HTMLElement>('[data-output]');

        if (!button || !form || !input || !leave || !leaveButton || !output) return;

        const elements = { button, form, input, leave, leaveButton, output };
        const token = new URLSearchParams(window.location.search).get(UNSUBSCRIBE_PARAMETER);

        form.noValidate = true;
        form.addEventListener('submit', event => void handleNewsletterSubmit(event, elements), { signal });
        watchFieldErrors(form, signal);

        if (token) {
            setHidden(form, true);
            setHidden(leave, false);
            leaveButton.addEventListener('click', () => void handleLeaveConfirm(elements, token, signal), { signal });
            leaveButton.focus();

            return;
        }

        void restoreSubscription(elements, signal);
        stopSessionWatch?.();
        stopSessionWatch = onSessionChange(() => void restoreSubscription(elements, signal));
        signal.addEventListener('abort', () => stopSessionWatch?.(), { once: true });
    }

    function releaseConfirmation(elements: NewsletterElements) {
        const { button, input, output } = elements;

        applyInstantly(button, () => {
            button.disabled = false;
        });

        input.disabled = false;
        input.value = '';
        output.textContent = '';
        output.classList.add('hidden');
        delete output.dataset.newsletterState;
    }

    async function restoreSubscription(elements: NewsletterElements, signal: AbortSignal) {
        const { button, form, output } = elements;
        const session = getSession();

        if (!session) {
            if (output.dataset.newsletterState === 'account') releaseConfirmation(elements);

            return;
        }

        const { data, error } = await supabase.from('newsletter_subscribers').select('status').eq('email', session.email).maybeSingle();

        const isAccountLock = output.dataset.newsletterState === 'account';

        const row: SubscriberRow | null = data;

        if (signal.aborted || error || getSession()?.email !== session.email || submitting.has(form)) return;

        if (row?.status === 'subscribed') {
            if (!button.disabled || isAccountLock) showConfirmation(elements, session.email, true);

            return;
        }

        if (isAccountLock) releaseConfirmation(elements);
    }

    function showConfirmation(elements: NewsletterElements, email: string, isReturning: boolean) {
        const { button, input, output } = elements;

        applyInstantly(button, () => {
            button.disabled = true;
        });

        input.disabled = true;
        input.value = email;
        output.dataset.newsletterState = isReturning ? 'account' : 'sent';
        output.textContent = isReturning ? SUBSCRIBED_MESSAGE : CONFIRMED_MESSAGE;
        output.classList.remove('hidden');

        if (isReturning) return;

        output.tabIndex = -1;
        output.focus();
    }

    registerPageScript(initNewsletter);
</script>
