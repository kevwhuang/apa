---
import SectionHead from '@components/shared/SectionHead.astro';
---

<section
    class="stage"
    aria-labelledby="newsletter-title"
>
    <div
        class="slab slab--roomy slab--sunk grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-end gap-10 max-md:grid-cols-1"
        data-motion="unfold"
    >
        <div>
            <SectionHead
                class="text-[clamp(32px,calc(20px_+_3.75vw),68px)]"
                headingId="newsletter-title"
            >
                Get the dispatch
            </SectionHead>
            <p class="max-w-md text-lg text-text-secondary">
                We send one email a season with what is on the calendar, what the roster has been
                working on, and where to find us next.
            </p>
        </div>
        <form class="newsletter-form flex flex-col gap-3">
            <div class="flex items-end gap-2 max-lg:flex-col max-lg:gap-3 max-lg:items-stretch">
                <label class="block flex-1">
                    <span class="label block mb-2 text-text-secondary">
                        Email
                    </span>
                    <input
                        id="newsletter-email"
                        class="input font-mono"
                        aria-describedby="newsletter-email-error"
                        aria-invalid="false"
                        autocomplete="email"
                        name="email"
                        placeholder="you@studio.fm"
                        required
                        type="email"
                    />
                </label>
                <button
                    class="btn btn--accent w-auto max-lg:w-full"
                    type="submit"
                >
                    Subscribe
                </button>
            </div>
            <p
                id="newsletter-email-error"
                class="text-error-text"
                data-field-error
                hidden
            />
            <p
                class="hidden p-3 bg-signal text-text-on-signal"
                data-output
            />
        </form>
    </div>
</section>

<script>
    import { EMAIL_PATTERN, STORAGE } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, isValidationBypassed, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { createStore } from '@lib/shared/state';
    import { getSession } from '@lib/account/session';
    import { registerPageScript } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    interface NewsletterElements {
        button: HTMLButtonElement;
        form: HTMLFormElement;
        input: HTMLInputElement;
        output: HTMLElement;
    }

    const INVALID_MESSAGE = 'Enter a valid email address.';
    const STORAGE_MESSAGE = 'You are not on the list because your browser storage is full. Clear some space and try again.';
    const SUBSCRIBED_MESSAGE = 'Your account is already on the list.';

    const RULES: Record<string, FieldRule> = {
        email: { message: INVALID_MESSAGE, pattern: EMAIL_PATTERN, required: true },
    };

    const subscription = createStore<null | string>({
        fallback: null,
        key: STORAGE.newsletter.key,
        normalize: normalizeEmail,
        scope: STORAGE.newsletter.scope,
        topic: STORAGE.newsletter.topic,
    });

    function getSubscribedEmail() {
        const email = subscription.get();
        const session = getSession();

        return session !== null && email === session.email ? email : null;
    }

    function handleNewsletterSubmit(event: SubmitEvent, elements: NewsletterElements) {
        event.preventDefault();

        const subscribed = getSubscribedEmail();

        if (subscribed !== null) {
            showConfirmation(elements, subscribed, true);
            toast(SUBSCRIBED_MESSAGE, 'info');

            return;
        }

        const errors = validateFields(elements.form, RULES);

        clearFieldErrors(elements.form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(elements.form, errors);
            focusFirstError(elements.form, errors);

            return;
        }

        const email = readEmailInput(elements.input);

        if (email === null) return;

        subscription.set(email);

        if (!subscription.persisted()) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        showConfirmation(elements, email, false);
        toast('You are on the list. The next dispatch lands in your inbox.', 'success');
    }

    function initNewsletter(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.newsletter-form');

        const button = form?.querySelector<HTMLButtonElement>('button');
        const input = form?.querySelector<HTMLInputElement>('input');
        const output = form?.querySelector<HTMLElement>('[data-output]');

        if (!button || !form || !input || !output) return;

        const elements = { button, form, input, output };
        const subscribed = getSubscribedEmail();

        form.noValidate = true;
        form.addEventListener('submit', event => handleNewsletterSubmit(event, elements), { signal });

        if (subscribed !== null) showConfirmation(elements, subscribed, true);
    }

    function normalizeEmail(value: null | string) {
        const email = typeof value === 'string' ? value.trim().toLowerCase() : '';

        return EMAIL_PATTERN.test(email) ? email : null;
    }

    function readEmailInput(input: HTMLInputElement) {
        const email = normalizeEmail(input.value);

        if (!isValidationBypassed() || email !== null) return email;

        return input.value.trim().toLowerCase() || input.placeholder;
    }

    function showConfirmation(elements: NewsletterElements, email: string, isReturning: boolean) {
        const { button, input, output } = elements;

        button.disabled = true;
        input.disabled = true;
        input.value = email;
        output.textContent = isReturning ? SUBSCRIBED_MESSAGE : 'You are on the list. The next dispatch lands in your inbox.';
        output.classList.remove('hidden');

        if (isReturning) return;

        output.tabIndex = -1;
        output.focus();
    }

    registerPageScript(initNewsletter);
</script>
