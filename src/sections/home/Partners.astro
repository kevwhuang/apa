---
import { Image } from 'astro:assets';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { PARTNERS, PARTNER_LOGO_WIDTH } from '@lib/shared/constants';
---

<section
    class="stage border-b-2 border-border-strong"
    aria-labelledby="partners-title"
>
    <div>
        <SectionHead
            class="text-5xl text-balance max-md:text-3xl"
            headingId="partners-title"
        >
            Backed by our top sponsors
        </SectionHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            Our sponsors provide the rooms that keep the calendar running. Every partnership
            starts with a conversation about what you already have.
        </p>
    </div>
    <ul
        class="backers slab slab--bare slab--lift list-none"
        data-motion="rise"
        style={`--backers-cols: ${PARTNERS.length + 1}`}
    >
        {PARTNERS.map(partner => (
            <li class="partner-tile grid grid-rows-[auto_minmax(0,1fr)] min-h-(--backers-cell) gap-(--space-md) p-(--space-lg) bg-bg-page">
                <p class="label text-text-secondary">{partner.name}</p>
                <div class="backers__logo">
                    <Image
                        class="partner-tile__logo object-contain max-h-full max-w-full"
                        alt={partner.name}
                        densities={[1, 2]}
                        src={partner.logo}
                        width={PARTNER_LOGO_WIDTH}
                    />
                </div>
            </li>
        ))}
        <li class="backers__action grid">
            <a
                class="backers__cta grid grid-rows-[auto_minmax(0,1fr)] min-h-(--backers-cell) gap-(--space-md) p-(--space-lg) text-center"
                href="/partners"
            >
                <span class="label text-link">Become a partner</span>
                <span class="self-center font-bold font-display text-3xl text-balance tracking-[-0.02em]">
                    See the ways in <IconArrow />
                </span>
            </a>
        </li>
    </ul>
</section>

<style>
    .backers {
        --backers-cell: clamp(180px, calc(146.667px + 10.4167vw), 280px);
        --slab-fill: var(--color-border-strong);
        display: grid;
        gap: var(--slab-rule);
        grid-template-columns: repeat(var(--backers-cols), minmax(0, 1fr));
    }

    .backers__cta {
        background-color: var(--color-bg-page);
        color: var(--color-text);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .backers__cta:active {
        transform: translateY(1px);
    }

    .backers__cta:focus-visible {
        outline-offset: -4px;
    }

    .backers__cta:hover {
        background-color: var(--color-bg-hover);
        color: var(--color-link);
    }

    .backers__logo {
        align-items: center;
        align-self: center;
        display: flex;
        height: clamp(62px, calc(50.667px + 3.5417vw), 96px);
        justify-content: center;
    }

    @media (max-width: 1024px) {
        .backers {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .backers__action {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        .backers {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
