---
import { Image } from 'astro:assets';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { PARTNERS, PARTNER_LOGO_WIDTH } from '@lib/shared/constants';
---

<section
    class="stage border-b-2 border-ink"
    aria-labelledby="partners-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow="Partners / Backing"
            headingId="partners-title"
        >
            Backed by our top partners.
        </SectionHead>
        <p
            class="max-w-2xl leading-relaxed text-md text-ink-muted"
            data-motion="blur"
        >
            The rooms, the gear, and the nights that hold the calendar together &mdash; partners
            make all of it possible. Every one starts the same way: a conversation about what you
            already have.
        </p>
    </div>
    <ul
        class="backers mark slab slab--bare slab--lift list-none"
        data-motion="rise"
        style={`--backers-cols: ${PARTNERS.length + 1}`}
    >
        {PARTNERS.map(partner => (
            <li class="partner-tile grid grid-rows-[auto_minmax(0,1fr)] gap-(--space-md) min-h-(--backers-cell) p-(--space-lg) bg-surface">
                <p class="label text-ink-muted">{partner.name}</p>
                <div class="backers__logo">
                    <Image
                        class="partner-tile__logo object-contain max-h-full max-w-full"
                        alt={`${partner.name} logo`}
                        densities={[1, 2]}
                        src={partner.logo}
                        width={PARTNER_LOGO_WIDTH}
                    />
                </div>
            </li>
        ))}
        <li class="backers__action grid">
            <a
                class="backers__cta grid grid-rows-[auto_minmax(0,1fr)] gap-(--space-md) min-h-(--backers-cell) p-(--space-lg)"
                href="/partners"
            >
                <span class="label">Become a partner</span>
                <span class="self-end font-extrabold font-sans leading-[0.95] text-3xl text-balance tracking-[-0.03em]">
                    See the ways in <IconArrow />
                </span>
            </a>
        </li>
    </ul>
</section>

<style>
    .backers {
        --backers-cell: clamp(180px, calc(146.667px + 10.4167vw), 280px);
        --slab-fill: var(--color-ink);
        display: grid;
        gap: var(--slab-rule);
        grid-template-columns: repeat(var(--backers-cols), minmax(0, 1fr));
    }

    .backers__cta {
        background-color: var(--color-accent);
        color: var(--color-ink);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .backers__cta:active {
        transform: translateY(1px);
    }

    .backers__cta:focus-visible {
        outline-offset: -4px;
    }

    .backers__cta:hover {
        background-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    .backers__logo {
        align-items: center;
        align-self: center;
        display: flex;
        height: clamp(62px, calc(50.667px + 3.5417vw), 96px);
        justify-content: center;
    }

    @media (max-width: 1024px) {
        .backers {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .backers__action {
            grid-column: 1 / -1;
        }

        .backers__cta {
            align-content: center;
            gap: var(--space-xs);
            grid-template-rows: auto auto;
            min-height: 0;
            padding-block: var(--space-2xl);
        }
    }

    @media (max-width: 768px) {
        .backers {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
