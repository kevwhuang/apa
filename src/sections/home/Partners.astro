---
import { Image } from 'astro:assets';

import IconArrow from '@components/icons/Arrow.astro';
import { PARTNERS, PARTNER_LOGO_WIDTH } from '@lib/shared/constants';
---

<section
    class="stage border-b-2 border-ink"
    aria-labelledby="partners-title"
>
    <div>
        <h2
            id="partners-title"
            class="sr-only"
        >
            Partners
        </h2>
        <p
            class="label mb-8 text-center text-ink-muted"
            data-motion="stamp"
        >
            Backed by
        </p>
        <ul
            class="grid grid-cols-2 gap-px mb-8 border-2 border-ink list-none bg-ink"
            data-motion-stagger="rise"
        >
            {PARTNERS.map(partner => (
                <li class="partner-tile flex items-center justify-center h-24 p-5 bg-surface md:h-32 md:p-8">
                    <Image
                        class="partner-tile__logo object-contain max-h-full max-w-full"
                        alt={partner.name}
                        densities={[1, 2]}
                        src={partner.logo}
                        width={PARTNER_LOGO_WIDTH}
                    />
                </li>
            ))}
        </ul>
        <p
            class="font-mono text-center text-xs uppercase text-ink-muted"
            data-motion="rise"
        >
            Become a partner &mdash;&#32;
            <a
                class="action-text hover:text-accent-deep inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 transition-colors"
                href="/partners"
            >
                see the ways in <IconArrow />
            </a>
        </p>
    </div>
</section>
