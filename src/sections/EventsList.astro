---
import { getCollection } from 'astro:content';

import PageHead from '@components/PageHead.astro';
import { formatDate, formatTime } from '@lib/utils';

const EVENT_FORMATS = [
    { desc: 'Producers gather to make tracks together. BYO laptop and headphones.', key: 'cookup', name: 'Cookups' },
    { desc: 'Live sets across four genres. Open to the public, all ages.', key: 'showcase', name: 'Showcases' },
    { desc: 'Skill-shares: synth design, mixing, sample clearance, business.', key: 'workshop', name: 'Workshops' },
    { desc: 'Casual nights at member studios \u2014 no laptops, just talk shop.', key: 'mixer', name: 'Mixers' },
    { desc: 'Industry conversations with labels, distributors, and venue bookers.', key: 'panel', name: 'Panels' },
];

const all = await getCollection('events');
const past = all.filter(event => event.data.status === 'past').sort((a, b) => +b.data.date - +a.data.date);
const upcoming = all.filter(event => event.data.status === 'upcoming').sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="pb-14 pt-20 border-b-2 border-ink"
    aria-labelledby="formats-title"
>
    <div class="shell">
        <PageHead
            class="max-w-4xl font-extrabold font-sans leading-[0.9] text-6xl tracking-[-0.04em] md:text-8xl"
            eyebrow="Events"
            headingId="formats-title"
        >
            Five formats. Every month.
        </PageHead>
        <ul class="reveal--stagger grid gap-6 mt-12 pt-8 border-t-2 border-ink list-none md:grid-cols-5">
            {EVENT_FORMATS.map(format => (
                <li>
                    <span class="label inline-block mb-2 px-2 py-0.5 bg-coral text-ink">
                        {format.key}
                    </span>
                    <h2 class="mt-2 font-bold font-sans">
                        {format.name}
                    </h2>
                    <p class="mt-1 text-[13px] text-taupe">
                        {format.desc}
                    </p>
                </li>
            ))}
        </ul>
    </div>
</section>

<section
    class="py-20 border-b-2 border-ink"
    aria-labelledby="upcoming-title"
>
    <div class="shell">
        <h2
            id="upcoming-title"
            class="reveal mb-10 font-extrabold font-sans text-4xl tracking-tight"
        >
            Upcoming
        </h2>
        {upcoming.length > 0
            ? (
                    <ul class="crop-marks reveal border-2 border-ink divide-y-2 divide-ink list-none">
                        {upcoming.map(event => (
                            <li>
                                <article
                                    id={event.id}
                                    class="grid grid-cols-12 items-start gap-6 px-5 py-8"
                                >
                                    <div class="col-span-12 md:col-span-2">
                                        <p class="font-extrabold font-sans text-[28px]">
                                            <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                                        </p>
                                        <p class="font-mono text-[11px] uppercase text-taupe">
                                            <time datetime={event.data.date.toISOString()}>{formatTime(event.data.date)}</time>
                                        </p>
                                    </div>
                                    <div class="col-span-12 md:col-span-7">
                                        <span class="label inline-block mb-2 px-2 py-0.5 bg-coral text-ink">
                                            {event.data.type}
                                        </span>
                                        <h3 class="font-extrabold font-sans text-3xl tracking-tight">
                                            {event.data.title}
                                        </h3>
                                        <address class="mt-2 font-mono not-italic text-[12px] uppercase text-taupe">
                                            {event.data.location}
                                        </address>
                                        <p class="max-w-2xl mt-3 text-taupe">
                                            {event.data.excerpt}
                                        </p>
                                    </div>
                                    <div class="col-span-12 flex justify-end md:col-span-3">
                                        {event.data.rsvp && (
                                            <a
                                                class="btn btn--primary h-11"
                                                href={event.data.rsvp}
                                                rel="noopener noreferrer"
                                                target="_blank"
                                            >
                                                RSVP &rarr;
                                            </a>
                                        )}
                                    </div>
                                </article>
                            </li>
                        ))}
                    </ul>
                )
            : (
                    <p class="reveal text-taupe">
                        No upcoming events scheduled &mdash; subscribe to the dispatch for new dates.
                    </p>
                )}
    </div>
</section>

<section
    class="py-20"
    aria-labelledby="past-title"
>
    <div class="shell">
        <h2
            id="past-title"
            class="reveal mb-10 font-extrabold font-sans text-4xl tracking-tight text-taupe"
        >
            Past
        </h2>
        <ul class="reveal--stagger grid gap-x-8 gap-y-6 list-none md:grid-cols-3">
            {past.map(event => (
                <li>
                    <article
                        id={event.id}
                        class="pt-4 border-t-2 border-ink"
                    >
                        <p class="label mb-1 text-taupe">
                            <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time> / {event.data.type}
                        </p>
                        <h3 class="font-bold font-sans tracking-tight">
                            {event.data.title}
                        </h3>
                        <address class="mt-1 font-mono not-italic text-[13px] text-taupe">
                            {event.data.location}
                        </address>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .crop-marks {
        transition-delay: 0.1s;
    }
</style>
