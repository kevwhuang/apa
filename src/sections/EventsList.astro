---
import { getCollection } from 'astro:content';
import { formatDate, formatTime } from '@lib/utils';

const all = await getCollection('events');
const past = all.filter(e => e.data.status === 'past').sort((a, b) => +b.data.date - +a.data.date);
const types = [
    { desc: 'Producers gather to make tracks together. BYO laptop and headphones.', key: 'cookup', name: 'Cookups' },
    { desc: 'Live sets across four genres. Open to the public, all ages.', key: 'showcase', name: 'Showcases' },
    { desc: 'Skill-shares: synth design, mixing, sample clearance, business.', key: 'workshop', name: 'Workshops' },
    { desc: 'Casual nights at member studios — no laptops, just talk shop.', key: 'mixer', name: 'Mixers' },
    { desc: 'Industry conversations with labels, distributors, and venue bookers.', key: 'panel', name: 'Panels' },
];
const upcoming = all.filter(e => e.data.status === 'upcoming').sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="pt-20 pb-14 border-b-2 border-ink"
    aria-label="Event formats"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <p class="label mb-4 text-coral reveal">EVENTS</p>
        <h1 class="font-sans font-extrabold tracking-[-0.04em] text-6xl md:text-8xl leading-[0.9] max-w-4xl reveal" style="transition-delay: 0.08s;">
            Five formats. Every month.
        </h1>
        <div class="mt-12 grid md:grid-cols-5 gap-6 border-t-2 border-ink pt-8 reveal--stagger">
            {types.map(t => (
                <div>
                    <span class="label inline-block px-2 py-0.5 bg-coral text-coral-ink mb-2">{t.key}</span>
                    <h2 class="font-sans font-bold mt-2">{t.name}</h2>
                    <p class="text-[13px] mt-1 text-ink-soft">{t.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<section
    class="py-20 border-b-2 border-ink"
    aria-label="Upcoming events"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <h2 class="font-sans text-4xl font-extrabold tracking-tight mb-10 reveal">Upcoming</h2>
        <div class="border-2 border-ink crop-marks reveal" style="transition-delay: 0.1s;">
            {upcoming.map((e, i) => (
                <article id={e.id} class={`grid grid-cols-12 items-start gap-6 py-8 px-5 ${i > 0 ? 'border-t-2 border-ink' : ''}`}>
                    <div class="col-span-12 md:col-span-2">
                        <p class="text-[28px] font-sans font-extrabold">{formatDate(e.data.date)}</p>
                        <p class="font-mono text-[11px] text-ink-soft uppercase">{formatTime(e.data.date)}</p>
                    </div>
                    <div class="col-span-12 md:col-span-7">
                        <span class="label inline-block px-2 py-0.5 bg-coral text-coral-ink mb-2">{e.data.type}</span>
                        <h2 class="font-sans text-3xl font-extrabold tracking-tight">{e.data.title}</h2>
                        <p class="mt-2 font-mono text-[12px] text-ink-soft uppercase">{e.data.location}</p>
                        <p class="mt-3 max-w-2xl text-ink-soft">{e.data.excerpt}</p>
                    </div>
                    <div class="col-span-12 md:col-span-3 flex justify-end">
                        {e.data.rsvp && (
                            <a class="inline-flex items-center gap-2 px-6 h-11 btn-text bg-ink text-sand border-2 border-ink hover:bg-coral hover:border-coral transition-colors" href={e.data.rsvp} rel="noopener noreferrer" target="_blank">
                                RSVP &rarr;
                            </a>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<section
    class="py-20"
    aria-label="Past events"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <h2 class="font-sans text-4xl font-extrabold tracking-tight mb-10 text-ink-soft">Past</h2>
        <div class="grid md:grid-cols-3 gap-x-8 gap-y-6">
            {past.map(e => (
                <article class="border-t-2 border-ink pt-4">
                    <p class="label mb-1 text-ink-soft">{formatDate(e.data.date)} / {e.data.type}</p>
                    <h2 class="font-sans font-bold tracking-tight">{e.data.title}</h2>
                    <p class="text-[13px] mt-1 text-ink-soft font-mono">{e.data.location}</p>
                </article>
            ))}
        </div>
    </div>
</section>
