---
import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { CONTACT_LIMITS, CONTACT_TOPICS, LINKS, PLATFORMS } from '@lib/shared/constants';
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="contact-title"
>
    <h1
        id="contact-title"
        class="sr-only"
    >
        Contact
    </h1>
    <div data-motion="unfold">
        <form
            class="contact-form slab slab--card flex flex-col max-w-(--measure-form) gap-(--space-lg) mx-auto"
            data-contact-form
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2 class="font-display text-3xl">
                    Contact us
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Write to us about accounts, bug reports, events, partnerships, store orders, or anything else.
                </p>
            </hgroup>
            <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">Name</span>
                        <input
                            id="contact-name"
                            class="input font-sans"
                            aria-describedby="contact-name-error"
                            aria-invalid="false"
                            autocomplete="name"
                            maxlength={CONTACT_LIMITS.name}
                            name="name"
                            required
                        />
                    </label>
                    <p
                        id="contact-name-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">Email</span>
                        <input
                            id="contact-email"
                            class="input font-mono"
                            aria-describedby="contact-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            maxlength={CONTACT_LIMITS.email}
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="contact-email-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">Topic</span>
                    <span class="select">
                        <select
                            id="contact-topic"
                            class="input font-sans"
                            aria-describedby="contact-topic-error"
                            aria-invalid="false"
                            name="topic"
                            required
                        >
                            <option value="">Choose a topic&hellip;</option>
                            {CONTACT_TOPICS.map(topic => (
                                <option value={topic}>{topic}</option>
                            ))}
                        </select>
                    </span>
                </label>
                <p
                    id="contact-topic-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">Message</span>
                    <textarea
                        id="contact-message"
                        class="contact-form__message input input--area font-sans"
                        aria-describedby="contact-message-error"
                        aria-invalid="false"
                        maxlength={CONTACT_LIMITS.message}
                        name="message"
                        required
                        rows="5"
                    />
                </label>
                <p
                    id="contact-message-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
            </div>
            <button
                class="btn btn--primary contact-form__submit w-full"
                type="submit"
            >
                Send
                <span
                    class="contact-form__arrow transition-[translate]"
                    aria-hidden="true"
                >
                    <IconArrow />
                </span>
            </button>
        </form>
        <div
            class="contact__done slab slab--card flex flex-col max-w-(--measure-form) gap-(--space-lg) mx-auto"
            data-contact-done
            hidden
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2
                    class="font-display text-3xl"
                    data-contact-heading
                    tabindex="-1"
                >
                    Your message
                </h2>
                <p class="text-text-secondary">
                    The button below opens this message in your email app.
                </p>
            </hgroup>
            <dl class="flex flex-col">
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-(--space-xs) py-(--space-3xs) border-b border-border-subtle">
                    <dt class="label text-text-secondary">From</dt>
                    <dd
                        class="font-mono text-base wrap-break-word"
                        data-contact-from
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-(--space-xs) py-(--space-3xs) border-b border-border-subtle">
                    <dt class="label text-text-secondary">To</dt>
                    <dd
                        class="font-mono text-base wrap-break-word"
                        data-contact-to
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-(--space-xs) py-(--space-3xs) border-b border-border-subtle">
                    <dt class="label text-text-secondary">Subject</dt>
                    <dd
                        class="font-mono text-base wrap-break-word"
                        data-contact-subject
                    />
                </div>
                <div class="contact__receipt-row--message grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-(--space-xs) py-(--space-3xs) border-b border-border-subtle">
                    <dt class="label text-text-secondary">Message</dt>
                    <dd
                        class="contact__receipt-body slab slab--sunk whitespace-pre-line wrap-break-word"
                        data-contact-message
                    />
                </div>
            </dl>
            <div class="flex flex-wrap gap-3 pt-(--space-md) border-border-strong border-t-2">
                <a
                    class="btn btn--accent"
                    data-contact-send
                    href={`mailto:${LINKS.email}`}
                >
                    Send it yourself
                </a>
                <button
                    class="btn"
                    data-contact-again
                    type="button"
                >
                    Write another
                </button>
            </div>
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="direct-lines-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="direct-lines-title"
        >
            Reach us directly
        </SectionHead>
        <ul
            class="grid grid-cols-2 gap-x-[calc(var(--space-md)+var(--lift))] gap-y-(--space-md) list-none max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            <li class="grid">
                <a
                    class="contact-line contact-line--accent slab slab--card slab--still mb-(--lift)"
                    href={`mailto:${LINKS.email}`}
                >
                    <span class="flex items-center justify-between gap-(--space-sm)">
                        <span class="font-bold font-mono text-lg tracking-wide uppercase">Email</span>
                        <span
                            class="contact-line__arrow shrink-0 font-mono leading-none text-xl text-link transition-[translate]"
                            aria-hidden="true"
                        >
                            <IconArrow />
                        </span>
                    </span>
                    <span class="contact-line__blurb font-mono text-base wrap-anywhere text-text-secondary">{LINKS.email}</span>
                </a>
            </li>
            {PLATFORMS.map(platform => (
                <li class="grid">
                    <a
                        class="contact-line slab slab--card slab--still mb-(--lift)"
                        href={platform.href}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        <span class="flex items-center justify-between gap-(--space-sm)">
                            <span class="font-bold font-mono text-lg tracking-wide uppercase">{platform.label}</span>
                            <span
                                class="contact-line__arrow shrink-0 font-mono leading-none text-xl text-link transition-[translate]"
                                aria-hidden="true"
                            >
                                <IconArrow />
                            </span>
                        </span>
                        <span class="contact-line__blurb text-base wrap-anywhere text-text-secondary">{platform.blurb}</span>
                        <span class="sr-only">&nbsp;(opens in a new tab)</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .contact-form,
    .contact__done {
        padding: var(--space-lg);
    }

    .contact-form__message {
        field-sizing: content;
        max-height: calc(10lh + 2 * var(--space-2xs) + 4px);
        min-height: calc(5lh + 2 * var(--space-2xs) + 4px);
        resize: vertical;
    }

    .contact-form__submit:hover .contact-form__arrow {
        translate: 4px 0;
    }

    .contact-line {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-height: 148px;
        padding: var(--space-md);
        transition:
            box-shadow var(--duration-base) var(--motion-ease-entrance),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .contact-line:active {
        transform: translateY(1px);
    }

    .contact-line:hover {
        --slab-fill: var(--color-bg-inverse);
        color: var(--color-text-inverse);
    }

    .contact-line:hover .contact-line__arrow {
        color: var(--color-link-on-inverse);
        translate: 4px 0;
    }

    .contact-line:hover .contact-line__blurb {
        color: var(--color-text-inverse-secondary);
    }

    .contact-line--accent .contact-line__arrow,
    .contact-line--accent .contact-line__blurb {
        color: var(--color-btn-primary-text);
    }

    .contact-line--accent.slab {
        --slab-fill: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .contact-line--accent.slab:hover {
        --slab-fill: var(--color-btn-primary-bg-hover);
        color: var(--color-btn-primary-text);
    }

    .contact-line--accent.slab:hover .contact-line__arrow,
    .contact-line--accent.slab:hover .contact-line__blurb {
        color: var(--color-btn-primary-text);
    }

    .contact__receipt-body {
        padding: var(--space-sm);
    }

    .contact__receipt-row--message {
        border-bottom: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        padding-top: var(--space-xs);
    }
</style>

<script>
    import { CONTACT_LIMITS, EMAIL_PATTERN } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { composeContactEmail } from '@lib/shared/email';
    import { registerPageScript, setText } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const RULES: Record<string, FieldRule> = {
        email: { max: CONTACT_LIMITS.email, message: 'Enter a valid email address.', pattern: EMAIL_PATTERN, required: true },
        message: { max: CONTACT_LIMITS.message, message: 'Write at least a sentence.', min: CONTACT_LIMITS.messageMin, required: true },
        name: { max: CONTACT_LIMITS.name, message: 'Enter your name.', required: true },
        topic: { message: 'Choose a topic.', required: true },
    };

    function applyTopicFromQuery(form: HTMLFormElement) {
        const requested = new URLSearchParams(window.location.search).get('topic')?.trim();
        const select = form.querySelector<HTMLSelectElement>('[name="topic"]');

        if (!requested || !select) return;

        const match = Array.from(select.options).find(option => option.value !== '' && option.value.toLowerCase() === requested.toLowerCase());

        if (!match) return;

        select.value = match.value;
        select.focus();
    }

    function handleContactAgain(form: HTMLFormElement, done: HTMLElement) {
        done.setAttribute('hidden', '');
        form.removeAttribute('hidden');
        form.reset();
        form.querySelector<HTMLInputElement>('[name="name"]')?.focus();
    }

    function handleContactSubmit(event: SubmitEvent, form: HTMLFormElement, done: HTMLElement) {
        event.preventDefault();

        const errors = validateFields(form, RULES, true);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        renderReceipt(form, done);
    }

    function initContactForm(signal: AbortSignal) {
        const again = document.querySelector<HTMLButtonElement>('[data-contact-again]');
        const done = document.querySelector<HTMLElement>('[data-contact-done]');
        const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

        if (!done || !form) return;

        form.noValidate = true;
        again?.addEventListener('click', () => handleContactAgain(form, done), { signal });
        form.addEventListener('submit', event => handleContactSubmit(event, form, done), { signal });
        applyTopicFromQuery(form);
    }

    function renderReceipt(form: HTMLFormElement, done: HTMLElement) {
        const send = document.querySelector<HTMLAnchorElement>('[data-contact-send]');
        const values = new FormData(form);

        const composed = composeContactEmail({
            email: String(values.get('email') ?? '').trim(),
            message: String(values.get('message') ?? '').trim(),
            name: String(values.get('name') ?? '').trim(),
            topic: String(values.get('topic') ?? '').trim(),
        });

        done.removeAttribute('hidden');
        form.setAttribute('hidden', '');

        if (send) send.href = composed.actionHref;

        setText(document.querySelector('[data-contact-from]'), composed.from);
        setText(document.querySelector('[data-contact-message]'), composed.body.join('\n\n'));
        setText(document.querySelector('[data-contact-subject]'), composed.subject);
        setText(document.querySelector('[data-contact-to]'), composed.to);
        document.querySelector<HTMLElement>('[data-contact-heading]')?.focus();
        toast('Message ready. Send it from your inbox.', 'info');
    }

    registerPageScript(initContactForm);
</script>
