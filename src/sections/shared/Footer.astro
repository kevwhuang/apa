---
import BrandLockup from '@components/brand/Lockup.astro';
import IconDiscord from '@components/icons/Discord.astro';
import IconInstagram from '@components/icons/Instagram.astro';
import IconMeetup from '@components/icons/Meetup.astro';
import IconMoon from '@components/icons/Moon.astro';
import IconSun from '@components/icons/Sun.astro';
import { BRAND } from '@lib/brand';
import { LINKS, NAV_GROUPS, SITE_UPDATED } from '@lib/constants';
import { formatDateOnly } from '@lib/utils';

const SITE_LINKS = [
    { href: '/privacy', label: 'Privacy' },
    { href: '/terms', label: 'Terms' },
    { href: '/admin', label: 'Admin' },
] as const;

const SOCIALS = [
    { Icon: IconMeetup, href: LINKS.meetup, label: 'Meetup' },
    { Icon: IconInstagram, href: LINKS.instagram, label: 'Instagram' },
    { Icon: IconDiscord, href: LINKS.discord, label: 'Discord' },
];

const columns = [
    ...NAV_GROUPS.flatMap(group => ('items' in group ? [{ head: group.label, items: [...group.items] }] : [])),
    {
        head: 'Browse',
        items: NAV_GROUPS.flatMap(group => ('href' in group ? [{ href: group.href, label: group.label }] : [])),
    },
    {
        head: 'Site',
        items: [...SITE_LINKS],
    },
];

const updated = new Date(SITE_UPDATED);
const year = new Date().getFullYear();
---

<footer
    class="border-t-2 border-ink bg-surface-sunken"
    aria-label="Site footer"
>
    <div class="stage stage--tight">
        <div
            class="footer__grid"
            style={`--footer-cols: ${columns.length}`}
        >
            <div>
                <BrandLockup
                    class="footer__lockup"
                    label={BRAND.name}
                />
                <p class="footer__lede">
                    A collective of music producers in Austin, Texas, open to anyone in the creative
                    industry who wants to collaborate alongside them.
                </p>
                <p class="footer__updated">
                    Last updated <time datetime={SITE_UPDATED}>{formatDateOnly(updated)}</time>
                </p>
                <button
                    class="theme-toggle"
                    aria-label="Dark theme"
                    aria-pressed="false"
                    type="button"
                >
                    <span class="theme-toggle__moon">
                        <IconMoon />
                    </span>
                    <span class="theme-toggle__sun">
                        <IconSun />
                    </span>
                </button>
            </div>
            {columns.map(column => (
                <div>
                    <h2 class="footer__head label">{column.head}</h2>
                    <ul class="footer__links list-none">
                        {column.items.map(item => (
                            <li>
                                <a
                                    class="footer__link"
                                    href={item.href}
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
    <div class="stage stage--flush border-t-2 border-ink">
        <div class="footer__bar">
            <div class="footer__credit">
                <p>&copy; {year} {BRAND.name}. All rights reserved.</p>
                <p>
                    Made by <a class="footer__credit-link" href={LINKS.aephonics} rel="noopener noreferrer" target="_blank">Aephonics<span class="sr-only"> (opens in a new tab)</span></a>.
                </p>
            </div>
            <ul class="footer__socials list-none">
                {SOCIALS.map(({ Icon, href, label }) => (
                    <li>
                        <a
                            class="footer__social"
                            href={href}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            <Icon />
                            <span class="sr-only">{label} (opens in a new tab)</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</footer>

<style>
    .footer__bar {
        align-items: center;
        color: var(--color-ink-muted);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        gap: var(--space-sm);
        justify-content: space-between;
        padding-block: var(--space-2xs);
    }

    .footer__credit {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
    }

    .footer__credit-link {
        color: var(--color-accent-deep);
        display: inline-block;
        text-decoration-color: transparent;
        text-decoration-line: underline;
        text-underline-offset: 3px;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            text-decoration-color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .footer__credit-link:active {
        transform: translateY(1px);
    }

    .footer__credit-link:hover {
        color: var(--color-accent);
        text-decoration-color: currentcolor;
    }

    .footer__grid {
        display: grid;
        gap: var(--space-2xl);
        grid-template-columns: minmax(0, 1.4fr) repeat(var(--footer-cols), minmax(0, 1fr));
    }

    .footer__head {
        color: var(--color-ink-muted);
        margin-bottom: var(--space-2xs);
    }

    .footer__lede {
        color: var(--color-ink-muted);
        font-size: var(--text-sm);
        line-height: 1.7;
        margin-bottom: var(--space-md);
        max-width: 34ch;
    }

    .footer__link {
        align-items: center;
        display: inline-flex;
        font-size: var(--text-sm);
        min-height: 36px;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .footer__link:active {
        transform: translateY(1px);
    }

    .footer__link:hover {
        color: var(--color-accent-deep);
    }

    :global(.footer__lockup) {
        color: var(--color-ink);
        display: block;
        margin-bottom: var(--space-md);
    }

    .footer__social {
        align-items: center;
        display: inline-flex;
        height: 50px;
        justify-content: center;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: 50px;
    }

    .footer__social:active {
        transform: translateY(1px);
    }

    .footer__social:hover {
        color: var(--color-accent-deep);
    }

    .footer__socials {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
    }

    .footer__updated {
        color: var(--color-ink-subtle);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .theme-toggle {
        align-items: center;
        border: 1px solid var(--color-ink-20);
        border-radius: 4px;
        color: var(--color-ink-subtle);
        display: inline-flex;
        justify-content: center;
        margin-top: var(--space-xs);
        min-height: 36px;
        min-width: 36px;
        transition:
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .theme-toggle:active {
        transform: translateY(1px);
    }

    .theme-toggle:hover {
        border-color: var(--color-accent-deep);
        color: var(--color-accent-deep);
    }

    .theme-toggle__moon {
        display: flex;
    }

    .theme-toggle__sun {
        display: none;
    }

    :global(html[data-theme='dark']) .theme-toggle__moon {
        display: none;
    }

    :global(html[data-theme='dark']) .theme-toggle__sun {
        display: flex;
    }

    @media (max-width: 1024px) {
        .footer__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer__grid > :first-child {
            grid-column: 1 / -1;
        }
    }
</style>

<script>
    import { STORAGE } from '@lib/constants';
    import { getTheme, toggleTheme } from '@lib/ui/theme';
    import { registerPageScript } from '@lib/utils';

    function initFooter(signal: AbortSignal) {
        const toggle = document.querySelector<HTMLElement>('.theme-toggle');

        if (!toggle) return;

        updateThemeToggle(toggle);

        toggle.addEventListener('click', () => toggleTheme(), { signal });
        window.addEventListener(STORAGE.theme.topic, () => updateThemeToggle(toggle), { signal });
    }

    function updateThemeToggle(button: HTMLElement) {
        button.setAttribute('aria-pressed', String(getTheme() === 'dark'));
    }

    registerPageScript(initFooter);
</script>
