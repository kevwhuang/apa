---
import IconDiscord from '@components/icons/Discord.astro';
import IconInstagram from '@components/icons/Instagram.astro';
import IconMeetup from '@components/icons/Meetup.astro';
import { BRAND } from '@lib/shared/brand';
import { LINKS, NAV_GROUPS, SITE_UPDATED } from '@lib/shared/constants';
import { formatDateStamp } from '@lib/shared/utils';

const ACCOUNT_LINKS = [
    { href: '/here', label: 'Here' },
    { href: '/store/cart', label: 'Cart' },
    { href: '/store/orders', label: 'Orders' },
    { href: '/settings', label: 'Settings' },
    { href: '/admin', label: 'Admin' },
] as const;

const SOCIALS = [
    { Icon: IconMeetup, href: LINKS.meetup, label: 'Meetup' },
    { Icon: IconDiscord, href: LINKS.discord, label: 'Discord' },
    { Icon: IconInstagram, href: LINKS.instagram, label: 'Instagram' },
];

const columns = [
    ...NAV_GROUPS.flatMap(group => ('items' in group ? [{ head: group.label, items: [...group.items] }] : [])),
    {
        head: 'Browse',
        items: [
            ...NAV_GROUPS.flatMap(group => ('href' in group ? [{ href: group.href, label: group.label }] : [])),
            { href: '/privacy', label: 'Privacy' },
            { href: '/terms', label: 'Terms' },
            { href: '/api', label: 'API' },
        ],
    },
    {
        head: 'Account',
        items: [...ACCOUNT_LINKS],
    },
];

const updated = new Date(SITE_UPDATED);
const year = new Date().getFullYear();
---

<footer
    class="border-t-2 border-ink bg-surface-sunken"
    aria-label="Site footer"
>
    <div class="stage stage--tight">
        <div
            class="footer__grid"
            style={`--footer-cols: ${columns.length}`}
        >
            {columns.map(column => (
                <div>
                    <h2 class="footer__head label mb-(--space-2xs) text-ink-muted">{column.head}</h2>
                    <ul class="list-none">
                        {column.items.map(item => (
                            <li>
                                <a
                                    class="footer__link active:translate-y-px hover:text-accent-deep inline-flex items-center min-h-9 leading-normal text-sm transition-[color,transform]"
                                    href={item.href}
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
    <div class="stage stage--flush border-t-2 border-ink">
        <div class="footer__row footer__sign">
            <ul class="footer__socials [grid-area:socials] flex gap-(--space-2xs) list-none">
                {SOCIALS.map(({ Icon, href, label }) => (
                    <li>
                        <a
                            class="footer__social"
                            href={href}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            <Icon />
                            <span class="sr-only">{label} (opens in a new tab)</span>
                        </a>
                    </li>
                ))}
            </ul>
            <div class="footer__meta">
                <p class="footer__copy text-balance">&copy; {year} <span class="footer__owner whitespace-nowrap"><a class="footer__home" href="/">{BRAND.name}</a>.</span> All rights reserved.</p>
                <p class="footer__stamp">
                    <span class="footer__credit whitespace-nowrap">Made by <a class="footer__credit-link" href={LINKS.aephonics} rel="noopener noreferrer" target="_blank">Aephonics<span class="sr-only">&nbsp;(opens in a new tab)</span></a>.</span>
                    <span class="footer__updated whitespace-nowrap">Updated <time datetime={SITE_UPDATED}>{formatDateStamp(updated)}</time>.</span>
                </p>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer__credit-link,
    .footer__home {
        color: var(--color-accent-deep);
        display: inline-block;
        text-decoration-color: transparent;
        text-decoration-line: underline;
        text-underline-offset: 3px;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            text-decoration-color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .footer__credit-link:active,
    .footer__home:active {
        transform: translateY(1px);
    }

    .footer__credit-link:hover,
    .footer__home:hover {
        color: var(--color-accent);
        text-decoration-color: currentcolor;
    }

    .footer__grid {
        column-gap: var(--space-lg);
        display: grid;
        grid-template-columns: repeat(var(--footer-cols), max-content);
        justify-content: space-between;
        padding-inline-end: var(--space-2xl);
        row-gap: var(--space-2xl);
    }

    .footer__meta {
        align-items: flex-end;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        grid-area: meta;
        text-align: right;
    }

    .footer__row {
        align-items: center;
        color: var(--color-ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        gap: var(--space-sm);
        letter-spacing: 0.04em;
        min-height: calc(var(--control-size) + 2 * var(--space-2xs));
        padding-block: var(--space-2xs);
    }

    .footer__sign {
        --footer-social: 56px;
        display: grid;
        grid-template-areas: 'socials meta';
        grid-template-columns: auto auto;
        justify-content: space-between;
    }

    .footer__social {
        align-items: center;
        display: inline-flex;
        height: var(--footer-social);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--footer-social);
    }

    .footer__social :global(svg) {
        height: 32px;
        width: 32px;
    }

    .footer__social:active {
        transform: translateY(1px);
    }

    .footer__social:hover {
        color: var(--color-accent-deep);
    }

    .footer__stamp {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        justify-content: flex-end;
    }

    @media (max-width: 768px) {
        .footer__grid {
            grid-template-columns: repeat(2, max-content);
        }

        .footer__meta {
            align-items: center;
            text-align: center;
        }

        .footer__sign {
            grid-template-areas:
                'socials'
                'meta';
            grid-template-columns: minmax(0, 1fr);
            justify-items: center;
        }

        .footer__stamp {
            justify-content: center;
        }
    }
</style>
