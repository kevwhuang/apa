---
import IconDiscord from '@components/icons/Discord.astro';
import IconInstagram from '@components/icons/Instagram.astro';
import IconLinktree from '@components/icons/Linktree.astro';
import IconMeetup from '@components/icons/Meetup.astro';
import IconSoundCloud from '@components/icons/SoundCloud.astro';
import IconSpotify from '@components/icons/Spotify.astro';
import { BRAND } from '@lib/shared/brand';
import { LINKS, NAV_GROUPS, ONBOARDING_ROUTE, SITE_UPDATED } from '@lib/shared/constants';
import { formatDateStamp } from '@lib/shared/utils';

const ACCOUNT_LINKS = [
    { href: ONBOARDING_ROUTE, label: 'Onboarding' },
    { href: '/here', label: 'Here' },
    { href: '/store/cart', label: 'Cart' },
    { href: '/store/orders', label: 'Orders' },
    { href: '/settings', label: 'Settings' },
    { href: '/admin', label: 'Admin' },
] as const;

const SOCIALS = [
    { Icon: IconInstagram, href: LINKS.instagram, label: 'Instagram' },
    { Icon: IconMeetup, href: LINKS.meetup, label: 'Meetup' },
    { Icon: IconDiscord, href: LINKS.discord, label: 'Discord' },
    { Icon: IconSpotify, href: LINKS.spotify, label: 'Spotify' },
    { Icon: IconSoundCloud, href: LINKS.soundcloud, label: 'SoundCloud' },
    { Icon: IconLinktree, href: LINKS.linktree, label: 'Linktree' },
];

const SOCIAL_ICON_SIZE = 32;

const columns = [
    ...NAV_GROUPS.flatMap(group => ('items' in group ? [{ head: group.label, items: [...group.items] }] : [])),
    {
        head: 'Browse',
        items: [
            ...NAV_GROUPS.flatMap(group => ('href' in group ? [{ href: group.href, label: group.label }] : [])),
            { href: '/privacy', label: 'Privacy' },
            { href: '/terms', label: 'Terms' },
            { href: '/api', label: 'API' },
        ],
    },
    {
        head: 'Account',
        items: [...ACCOUNT_LINKS],
    },
];

const updated = new Date(SITE_UPDATED);
const year = new Date().getFullYear();
---

<footer
    class="slab--well border-border-strong border-t-2"
    aria-label="Site footer"
>
    <div class="stage stage--tight">
        <div
            class="footer__grid"
            style={`--footer-cols: ${columns.length}`}
        >
            {columns.map(column => (
                <div>
                    <h2 class="footer__head label mb-(--space-sm) text-text-inverse-secondary">{column.head}</h2>
                    <ul class="flex flex-col gap-(--space-2xs) list-none">
                        {column.items.map(item => (
                            <li>
                                <a
                                    class="footer__link active:translate-y-px hover:text-link-on-inverse inline-flex items-center min-h-9 text-base transition-[color,translate]"
                                    data-footer-onboarding={item.href === ONBOARDING_ROUTE ? '' : undefined}
                                    href={item.href}
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
    <div class="stage stage--flush border-border-inverse-strong border-t-2">
        <div class="footer__row footer__sign">
            <div class="footer__meta">
                <p class="footer__copy text-balance">
                    &copy; {year}&#32;
                    <span class="footer__owner">
                        <a
                            class="footer__home"
                            href="/"
                        >
                            {BRAND.name}
                        </a>
                    </span>
                </p>
                <p class="footer__stamp">
                    <span class="footer__credit whitespace-nowrap">
                        Made by&#32;
                        <a
                            class="footer__credit-link"
                            href={LINKS.aephonics}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            Aephonics
                            <span class="sr-only">&nbsp;(opens in a new tab)</span>
                        </a>
                    </span>
                    <span
                        class="max-lg:hidden"
                        aria-hidden="true"
                    >
                        &middot;
                    </span>
                    <span class="footer__updated whitespace-nowrap">Updated <time datetime={SITE_UPDATED}>{formatDateStamp(updated)}</time></span>
                </p>
            </div>
            <ul class="footer__socials flex gap-(--space-2xs) list-none">
                {SOCIALS.map(({ Icon, href, label }) => (
                    <li>
                        <a
                            class="footer__social"
                            href={href}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            <Icon size={SOCIAL_ICON_SIZE} />
                            <span class="sr-only">{label} (opens in a new tab)</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</footer>

<style>
    .footer__credit-link,
    .footer__home {
        color: var(--color-link-on-inverse);
        display: inline-block;
        text-decoration-color: transparent;
        text-decoration-line: underline;
        text-underline-offset: 4px;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            text-decoration-color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .footer__credit-link:active,
    .footer__home:active {
        transform: translateY(1px);
    }

    .footer__credit-link:hover,
    .footer__home:hover {
        text-decoration-color: currentcolor;
    }

    .footer__grid {
        column-gap: var(--space-lg);
        display: grid;
        grid-template-columns: repeat(var(--footer-cols), max-content);
        justify-content: space-between;
        padding-inline-end: max(0px, var(--launcher-size) + var(--space-2xs) - var(--shell-pad));
        row-gap: var(--space-2xl);
    }

    .footer__head {
        font-size: var(--text-lg);
    }

    .footer__meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .footer__row {
        align-items: center;
        color: var(--color-text-inverse-secondary);
        font-family: var(--font-mono);
        font-size: var(--text-base);
        gap: var(--space-sm);
        letter-spacing: 0.04em;
        line-height: var(--text-base--line-height);
        min-height: calc(var(--control-size) + 2 * var(--space-lg));
        padding-block: var(--space-lg);
    }

    .footer__sign {
        --footer-social: 56px;
        display: grid;
        grid-template-columns: auto auto;
        justify-content: space-between;
        padding-inline-end: max(0px, var(--launcher-size) + var(--space-2xs) - var(--shell-pad));
    }

    .footer__social {
        align-items: center;
        color: var(--color-text-inverse);
        display: inline-flex;
        height: var(--footer-social);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--footer-social);
    }

    .footer__social:active {
        transform: translateY(1px);
    }

    .footer__social:hover {
        color: var(--color-link-on-inverse);
    }

    .footer__stamp {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
    }

    @media (max-width: 1024px) {
        .footer__stamp {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .footer__grid {
            grid-template-columns: repeat(2, max-content);
        }

        .footer__sign {
            grid-template-columns: minmax(0, 1fr);
        }

        .footer__socials {
            flex-wrap: wrap;
        }
    }
</style>

<script>
    import { ONBOARDING_ROUTE } from '@lib/shared/constants';
    import { getOnboardingHref } from '@lib/account/onboarding';
    import { getSession, onSessionChange } from '@lib/account/session';
    import { registerPageScript } from '@lib/shared/utils';

    let unsubscribe: (() => void) | undefined;

    function initFooter(signal: AbortSignal) {
        renderOnboarding();
        unsubscribe?.();
        unsubscribe = onSessionChange(renderOnboarding);
        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });
    }

    function renderOnboarding() {
        const link = document.querySelector<HTMLAnchorElement>('[data-footer-onboarding]');
        const session = getSession();

        if (!link) return;

        link.href = session ? getOnboardingHref(session.email) : ONBOARDING_ROUTE;
    }

    registerPageScript(initFooter);
</script>
