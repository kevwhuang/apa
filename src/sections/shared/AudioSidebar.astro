---
import IconClose from '@components/icons/Close.astro';
import IconPause from '@components/icons/Pause.astro';
import IconPlay from '@components/icons/Play.astro';
import IconVolume from '@components/icons/Volume.astro';
import IconWaveform from '@components/icons/Waveform.astro';
---

<aside
    class="dock"
    aria-label="Track player"
    transition:persist
>
    <button
        class="dock__launcher"
        aria-controls="dock-panel"
        aria-expanded="false"
        data-dock-launcher
        type="button"
    >
        <IconWaveform />
        <span class="sr-only">Open the track player</span>
    </button>
    <div
        id="dock-panel"
        class="dock__panel"
        hidden
    >
        <div class="dock__head">
            <p class="dock__eyebrow label">Now playing</p>
            <button
                class="dock__close"
                data-dock-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close the track player</span>
            </button>
        </div>
        <p
            class="dock__title"
            data-dock-title
        >
            Nothing playing
        </p>
        <p
            class="dock__artist"
            data-dock-artist
        >
            Play a track to load it here
        </p>
        <div class="dock__transport">
            <button
                class="dock__control dock__control--play"
                data-dock-toggle
                disabled
                type="button"
            >
                <span class="dock__icon dock__icon--play">
                    <IconPlay />
                </span>
                <span
                    class="dock__icon dock__icon--pause"
                    hidden
                >
                    <IconPause />
                </span>
                <span
                    class="sr-only"
                    data-dock-toggle-label
                >
                    Play
                </span>
            </button>
            <button
                class="dock__control"
                aria-pressed="false"
                data-dock-mute
                type="button"
            >
                <span class="dock__icon dock__icon--sound">
                    <IconVolume />
                </span>
                <span
                    class="dock__icon dock__icon--muted"
                    hidden
                >
                    <IconVolume muted />
                </span>
                <span class="sr-only">Mute</span>
            </button>
        </div>
        <div class="dock__seek-row">
            <input
                class="dock__seek"
                aria-label="Seek within the track"
                data-dock-seek
                disabled
                max="0"
                min="0"
                step="1"
                type="range"
                value="0"
            />
        </div>
        <p class="dock__clock">
            <span data-dock-position>0:00</span>
            <span data-dock-duration>0:00</span>
        </p>
        <a
            class="action-text dock__link"
            href="/producers"
        >
            Find a track on the roster &rarr;
        </a>
        <p class="dock__note">Tracks are synthesized in your browser.</p>
        <div
            class="dock__rack"
            data-dock-rack
            hidden
        >
            <div class="dock__rack-head">
                <p class="dock__rack-label label">Sandbox rack</p>
                <p
                    class="dock__rack-file"
                    data-dock-rack-file
                />
            </div>
            <ul
                class="dock__plugins list-none"
                aria-label="Active plugins"
                data-dock-plugins
            />
            <p
                class="dock__straight"
                data-dock-straight
            >
                Straight through
            </p>
            <div class="dock__rack-deck">
                <button
                    class="dock__control dock__rack-toggle"
                    aria-pressed="false"
                    data-dock-rack-toggle
                    disabled
                    type="button"
                >
                    <span data-dock-rack-play>
                        <IconPlay />
                    </span>
                    <span
                        data-dock-rack-pause
                        hidden
                    >
                        <IconPause />
                    </span>
                    <span
                        class="sr-only"
                        data-dock-rack-label
                    >
                        Play the sandbox rack
                    </span>
                </button>
                <p
                    class="dock__rack-time"
                    data-dock-rack-duration
                >
                    0:00
                </p>
            </div>
            <a
                class="action-text dock__link"
                href="/sandbox"
            >
                Open the sandbox &rarr;
            </a>
            <template data-dock-plugin>
                <li class="dock__plugin" />
            </template>
        </div>
    </div>
    <p
        class="sr-only"
        aria-live="polite"
        data-dock-status
    />
</aside>

<style>
    .dock {
        display: none;
    }

    .dock.is-ready {
        display: block;
    }

    .dock__artist {
        color: var(--color-ink-inverse-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__clock {
        color: var(--color-ink-inverse-muted);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        justify-content: space-between;
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__close {
        align-items: center;
        display: inline-flex;
        height: 50px;
        justify-content: center;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: 50px;
    }

    .dock__close:active {
        transform: translateY(1px);
    }

    .dock__close:focus-visible {
        outline-offset: -2px;
    }

    .dock__close:hover {
        color: var(--color-accent-light);
    }

    .dock__control {
        align-items: center;
        border: 2px solid var(--color-ink-inverse);
        display: inline-flex;
        flex: 0 0 auto;
        height: 50px;
        justify-content: center;
        transition: background var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: 50px;
    }

    .dock__control:active:not(:disabled) {
        transform: translateY(1px);
    }

    .dock__control:disabled {
        cursor: not-allowed;
        opacity: 0.55;
    }

    .dock__control:hover:not(:disabled) {
        background: var(--color-ink-inverse);
        color: var(--color-ink);
    }

    .dock__control--play {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--color-ink);
    }

    .dock__control--play:hover:not(:disabled) {
        background: var(--color-accent-light);
        border-color: var(--color-accent-light);
        color: var(--color-ink);
    }

    .dock__eyebrow {
        color: var(--color-accent-light);
        padding: var(--space-sm) var(--space-md) var(--space-2xs);
    }

    .dock__head {
        align-items: center;
        display: flex;
        justify-content: space-between;
        padding-right: var(--space-2xs);
    }

    .dock__launcher {
        --focus-ring: var(--color-accent-light);
        align-items: center;
        background: var(--color-surface-inverse);
        border: 2px solid var(--color-ink);
        border-right: 0;
        color: var(--color-ink-inverse);
        display: inline-flex;
        height: var(--launcher-size);
        inset: auto 0 calc(var(--space-md) + var(--launcher-size) + var(--space-2xs)) auto;
        justify-content: center;
        position: fixed;
        transition: background var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--launcher-size);
        z-index: var(--z-drawer);
    }

    .dock__launcher:active {
        transform: translateY(1px);
    }

    .dock__launcher:focus-visible {
        outline-offset: -2px;
    }

    .dock__launcher:hover {
        --focus-ring: var(--color-ink);
        background: var(--color-accent);
        color: var(--color-ink);
    }

    .dock__link {
        align-items: center;
        border-top: 1px solid var(--color-ink-inverse-10);
        color: var(--color-ink-inverse);
        display: flex;
        min-height: 50px;
        padding: 0 var(--space-md);
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .dock__link:active {
        transform: translateY(1px);
    }

    .dock__link:focus-visible {
        outline-offset: -2px;
    }

    .dock__link:hover {
        color: var(--color-accent-light);
    }

    .dock__note {
        border-top: 1px solid var(--color-ink-inverse-10);
        color: var(--color-ink-inverse-muted);
        font-size: var(--text-2xs);
        padding: var(--space-2xs) var(--space-md);
    }

    .dock__panel {
        --focus-ring: var(--color-accent-light);
        background: var(--color-surface-inverse);
        border-left: 2px solid var(--color-ink);
        color: var(--color-ink-inverse);
        inset: var(--header-height) var(--launcher-size) 0 auto;
        overflow-y: auto;
        overscroll-behavior: contain;
        position: fixed;
        width: min(340px, calc(100vw - var(--launcher-size)));
        z-index: var(--z-drawer);
    }

    .dock__plugin {
        border: 1px solid var(--color-ink-inverse-10);
        color: var(--color-ink-inverse-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        padding: 2px var(--space-2xs);
        transition: border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui);
    }

    .dock__plugins {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__plugins:empty {
        display: none;
    }

    .dock__rack {
        border-top: 1px solid var(--color-ink-inverse-10);
        padding-top: var(--space-2xs);
    }

    .dock__rack.is-playing .dock__plugin {
        border-color: var(--color-accent-light);
        color: var(--color-accent-light);
    }

    .dock__rack-deck {
        align-items: center;
        display: flex;
        gap: var(--space-2xs);
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__rack-file {
        color: var(--color-ink-inverse-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dock__rack-head {
        align-items: baseline;
        display: flex;
        gap: var(--space-2xs);
        justify-content: space-between;
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__rack-label {
        color: var(--color-accent-light);
        flex: 0 0 auto;
    }

    .dock__rack-time {
        color: var(--color-ink-inverse-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
    }

    .dock__rack-toggle {
        transition: background var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .dock__rack-toggle:active:not(:disabled) {
        transform: translateY(1px);
    }

    .dock__rack-toggle[aria-pressed='true'] {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--color-ink);
    }

    .dock__rack-toggle[aria-pressed='true']:hover {
        background: var(--color-accent-light);
        border-color: var(--color-accent-light);
        color: var(--color-ink);
    }

    .dock__seek {
        accent-color: var(--color-accent);
        flex: 1 1 auto;
        height: 50px;
        min-width: 0;
        transition: accent-color var(--duration-fast) var(--motion-ease-ui);
    }

    .dock__seek:active:not(:disabled),
    .dock__seek:hover:not(:disabled) {
        accent-color: var(--color-accent-light);
    }

    .dock__seek:disabled {
        opacity: 0.55;
    }

    .dock__seek-row {
        display: flex;
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__straight {
        color: var(--color-ink-inverse-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        padding: 0 var(--space-md) var(--space-2xs);
    }

    .dock__title {
        font-size: var(--text-md);
        font-weight: 800;
        padding: 0 var(--space-md);
    }

    .dock__transport {
        align-items: center;
        display: flex;
        gap: var(--space-2xs);
        padding: 0 var(--space-md) var(--space-3xs);
    }
</style>

<script>
    import { MODULE_NAMES, getRackState, onRackChange, toggleRack } from '@lib/audio/sandbox/rack';
    import { TRACK_PLAY_TOPIC } from '@lib/constants';
    import {
        announceTrackState,
        closePlayer,
        getPlayerState,
        getPosition,
        getTrack,
        isMuted,
        onPlayerChange,
        openPlayer,
        playTrack,
        seekTo,
        setMuted,
        togglePlayback,
    } from '@lib/audio';
    import { formatDuration, registerPageScript, setHidden, setText } from '@lib/utils';

    let frame = 0;
    let unsubscribe: (() => void) | undefined;
    let unsubscribeRack: (() => void) | undefined;

    function handleCloseClick() {
        closePlayer();
        document.querySelector<HTMLElement>('[data-dock-launcher]')?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape' || !getPlayerState().open) return;

        event.preventDefault();
        closePlayer();
        document.querySelector<HTMLElement>('[data-dock-launcher]')?.focus();
    }

    function handleLaunch() {
        if (getPlayerState().open) {
            closePlayer();

            return;
        }

        openPlayer();
        document.querySelector<HTMLElement>('[data-dock-close]')?.focus();
    }

    function handleSeek(input: HTMLInputElement) {
        seekTo(Number(input.value));
    }

    function handleTrackPlay(event: WindowEventMap['apa:track-play']) {
        const track = event.detail?.track;

        if (!track) return;

        playTrack(track);
        setText(document.querySelector('[data-dock-status]'), `Playing ${track.title} by ${track.artist}`);
    }

    function initDock(signal: AbortSignal) {
        const dock = document.querySelector<HTMLElement>('.dock');
        const launcher = document.querySelector<HTMLElement>('[data-dock-launcher]');
        const seek = document.querySelector<HTMLInputElement>('[data-dock-seek]');

        if (!dock || !launcher || !seek) return;

        dock.classList.add('is-ready');
        announceTrackState();
        unsubscribe?.();
        unsubscribeRack?.();
        unsubscribe = onPlayerChange(render);
        unsubscribeRack = onRackChange(renderRack);
        signal.addEventListener('abort', teardown, { once: true });

        document.querySelector<HTMLElement>('[data-dock-close]')?.addEventListener('click', handleCloseClick, { signal });
        document.querySelector<HTMLElement>('[data-dock-mute]')?.addEventListener('click', toggleMute, { signal });
        document.querySelector<HTMLElement>('[data-dock-rack-toggle]')?.addEventListener('click', toggleRack, { signal });
        document.querySelector<HTMLElement>('[data-dock-toggle]')?.addEventListener('click', togglePlayback, { signal });
        dock.addEventListener('keydown', handleKeydown, { signal });
        launcher.addEventListener('click', handleLaunch, { signal });
        seek.addEventListener('input', () => handleSeek(seek), { signal });
        window.addEventListener(TRACK_PLAY_TOPIC, handleTrackPlay, { signal });
        render();
        renderRack();
    }

    function render() {
        const state = getPlayerState();
        const track = getTrack();
        const launcher = document.querySelector<HTMLElement>('[data-dock-launcher]');
        const panel = document.querySelector<HTMLElement>('#dock-panel');
        const seek = document.querySelector<HTMLInputElement>('[data-dock-seek]');
        const toggle = document.querySelector<HTMLElement>('[data-dock-toggle]');

        if (!launcher || !panel || !seek || !toggle) return;

        panel.hidden = !state.open;
        launcher.setAttribute('aria-expanded', String(state.open));
        seek.toggleAttribute('disabled', !track);
        toggle.toggleAttribute('disabled', !track);
        setText(document.querySelector('[data-dock-toggle-label]'), state.playing ? 'Pause' : 'Play');
        setHidden(document.querySelector<HTMLElement>('.dock__icon--pause'), !state.playing);
        setHidden(document.querySelector<HTMLElement>('.dock__icon--play'), state.playing);

        if (track) {
            seek.max = String(track.durationSeconds);
            setText(document.querySelector('[data-dock-title]'), track.title);
            setText(document.querySelector('[data-dock-artist]'), track.artist);
            setText(document.querySelector('[data-dock-duration]'), formatDuration(track.durationSeconds));
        }

        cancelAnimationFrame(frame);

        if (state.open) tickProgress();
    }

    function renderRack() {
        const state = getRackState();
        const file = document.querySelector<HTMLElement>('[data-dock-rack-file]');
        const list = document.querySelector<HTMLElement>('[data-dock-plugins]');
        const rack = document.querySelector<HTMLElement>('[data-dock-rack]');
        const template = document.querySelector<HTMLTemplateElement>('[data-dock-plugin]');
        const toggle = document.querySelector<HTMLElement>('[data-dock-rack-toggle]');

        if (!file || !list || !rack || !template || !toggle) return;

        const loaded = state.fileName !== null;

        rack.hidden = !loaded && state.activeKinds.length === 0;
        rack.classList.toggle('is-playing', state.playing);
        file.textContent = state.fileName ?? 'No file loaded';
        file.title = state.fileName ?? '';
        toggle.setAttribute('aria-pressed', String(state.playing));
        toggle.toggleAttribute('disabled', !loaded);
        setHidden(document.querySelector<HTMLElement>('[data-dock-rack-pause]'), !state.playing);
        setHidden(document.querySelector<HTMLElement>('[data-dock-rack-play]'), state.playing);
        setHidden(document.querySelector<HTMLElement>('[data-dock-straight]'), !loaded || state.activeKinds.length > 0);
        setText(document.querySelector('[data-dock-rack-duration]'), formatDuration(state.durationSeconds));
        setText(document.querySelector('[data-dock-rack-label]'), state.playing ? 'Pause the sandbox rack' : 'Play the sandbox rack');
        list.replaceChildren();

        for (const kind of state.activeKinds) {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const chip = fragment.querySelector<HTMLElement>('.dock__plugin');

            if (!chip) continue;

            chip.textContent = MODULE_NAMES[kind];
            list.append(fragment);
        }
    }

    function teardown() {
        cancelAnimationFrame(frame);
        unsubscribe?.();
        unsubscribeRack?.();
        unsubscribe = undefined;
        unsubscribeRack = undefined;
    }

    function tickProgress() {
        const position = getPosition();
        const seek = document.querySelector<HTMLInputElement>('[data-dock-seek]');

        if (seek && document.activeElement !== seek) seek.value = String(Math.floor(position));

        setText(document.querySelector('[data-dock-position]'), formatDuration(position));

        if (getPlayerState().playing) frame = requestAnimationFrame(tickProgress);
    }

    function toggleMute() {
        const next = !isMuted();
        const button = document.querySelector<HTMLElement>('[data-dock-mute]');

        setMuted(next);
        button?.setAttribute('aria-pressed', String(next));
        setHidden(document.querySelector<HTMLElement>('.dock__icon--muted'), !next);
        setHidden(document.querySelector<HTMLElement>('.dock__icon--sound'), next);
    }

    registerPageScript(initDock);
</script>
