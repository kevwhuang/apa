---
import IconArrow from '@components/icons/Arrow.astro';
import IconClose from '@components/icons/Close.astro';
import IconPause from '@components/icons/Pause.astro';
import IconPlay from '@components/icons/Play.astro';
import IconVolume from '@components/icons/Volume.astro';
import IconWaveform from '@components/icons/Waveform.astro';
---

<aside
    class="player"
    aria-label="Track player"
    transition:persist
>
    <button
        class="player__launcher z-(--z-drawer)"
        aria-controls="player-panel"
        aria-expanded="false"
        data-player-launcher
        type="button"
    >
        <IconWaveform />
        <span class="sr-only">Open track player</span>
    </button>
    <div
        id="player-panel"
        class="player__panel z-(--z-drawer)"
        hidden
    >
        <div
            class="grip z-1"
            data-player-grip
        />
        <div class="player__head flex flex-none items-center justify-between min-h-(--control-size) pl-4">
            <p class="label player__eyebrow text-link">Now playing</p>
            <button
                class="player__close"
                data-player-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close track player</span>
            </button>
        </div>
        <div
            class="player__rack scroll-slot flex flex-auto flex-col min-h-0 gap-2 px-4 py-4 border-border-subtle border-t"
            data-player-rack
            hidden
        >
            <div class="player__rack-head flex items-baseline justify-between gap-2">
                <p class="label player__rack-label flex-none text-link">Rack</p>
                <p
                    class="player__rack-file min-w-0 text-base truncate text-text-secondary"
                    data-player-rack-file
                />
            </div>
            <ul
                class="player__plugins empty:hidden flex flex-col gap-2 list-none"
                aria-label="Active plugins"
                data-player-plugins
            />
            <p
                class="player__straight font-mono text-base text-text-secondary"
                data-player-straight
            >
                Straight through
            </p>
            <template data-player-plugin>
                <li class="player__plugin" />
            </template>
        </div>
        <a
            class="action-text player__link"
            href="/rack"
        >
            Go to rack <IconArrow />
        </a>
        <div class="player__controls flex flex-col flex-none gap-2 py-4 border-border-subtle border-t">
            <div class="player__meta flex flex-col gap-1 px-4">
                <p
                    class="player__title min-w-0 font-bold leading-(--text-xl) text-lg truncate"
                    data-player-title
                >
                    Nothing playing
                </p>
                <p
                    class="player__artist min-w-0 text-base truncate text-text-secondary"
                    data-player-artist
                >
                    Play a track to load it here.
                </p>
            </div>
            <div class="player__row flex items-center gap-2 px-4">
                <button
                    class="player__control player__control--play"
                    aria-pressed="false"
                    data-player-toggle
                    disabled
                    type="button"
                >
                    <span class="player__icon player__icon--play">
                        <IconPlay />
                    </span>
                    <span
                        class="player__icon player__icon--pause"
                        hidden
                    >
                        <IconPause />
                    </span>
                    <span
                        class="sr-only"
                        data-player-toggle-label
                    >
                        Play
                    </span>
                </button>
                <div class="player__row-slider flex flex-auto flex-col min-w-0 gap-1">
                    <input
                        class="range h-6"
                        aria-label="Seek within the track"
                        data-player-seek
                        disabled
                        max="0"
                        min="0"
                        step="1"
                        type="range"
                        value="0"
                    />
                    <p class="player__ends flex justify-between w-full font-mono text-sm text-text-secondary select-none">
                        <span data-player-position>0:00</span>
                        <span data-player-duration>0:00</span>
                    </p>
                </div>
            </div>
            <div class="player__row flex items-center gap-2 px-4">
                <button
                    class="player__control"
                    aria-pressed="false"
                    data-player-mute
                    type="button"
                >
                    <span class="player__icon player__icon--sound">
                        <IconVolume />
                    </span>
                    <span
                        class="player__icon player__icon--muted"
                        hidden
                    >
                        <IconVolume muted />
                    </span>
                    <span class="sr-only">Mute</span>
                </button>
                <div class="player__row-slider flex flex-auto flex-col min-w-0 gap-1">
                    <input
                        class="range h-6"
                        aria-label="Volume"
                        data-player-volume
                        max="100"
                        min="0"
                        step="1"
                        type="range"
                        value="100"
                    />
                    <p
                        class="player__ends flex justify-between w-full font-mono text-sm text-text-secondary select-none"
                        aria-hidden="true"
                    >
                        <span>0</span>
                        <span>100</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <p
        class="sr-only"
        aria-live="polite"
        data-player-status
    />
</aside>

<style>
    .player {
        display: none;
    }

    .player.is-ready {
        display: block;
    }

    .player__close {
        align-items: center;
        display: inline-flex;
        height: var(--control-size);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .player__close:active {
        transform: translateY(1px);
    }

    .player__close:focus-visible {
        outline-offset: -2px;
    }

    .player__close:hover {
        color: var(--color-link);
    }

    .player__control {
        align-items: center;
        border: 2px solid var(--color-border-strong);
        display: inline-flex;
        flex: 0 0 auto;
        height: var(--control-size);
        justify-content: center;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .player__control:active:not(:disabled) {
        transform: translateY(1px);
    }

    .player__control:disabled {
        background: var(--color-btn-disabled-bg);
        border-color: var(--color-btn-disabled-border);
        color: var(--color-btn-disabled-text);
        cursor: not-allowed;
    }

    .player__control:hover:not(:disabled) {
        background: var(--color-bg-inverse);
        color: var(--color-text-inverse);
    }

    .player__control--play {
        background: var(--color-btn-primary-bg);
        border-color: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .player__control--play:hover:not(:disabled) {
        background: var(--color-btn-primary-bg-hover);
        border-color: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .player__launcher {
        --color-focus-ring: var(--color-focus-ring-offset);
        align-items: center;
        background: var(--color-bg-inverse);
        border: 2px solid currentColor;
        border-right: 0;
        color: var(--color-text-inverse);
        display: inline-flex;
        height: var(--control-size);
        inset: auto 0 var(--space-md) auto;
        justify-content: center;
        position: fixed;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .player__launcher:active {
        transform: translateY(1px);
    }

    .player__launcher:focus-visible {
        outline-offset: -4px;
    }

    .player__launcher:hover {
        background: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .player__link {
        align-items: center;
        border-top: 1px solid var(--color-border-subtle);
        color: var(--color-text);
        display: flex;
        flex: 0 0 auto;
        gap: 8px;
        min-height: var(--control-size);
        padding: 0 16px;
    }

    .player__link:focus-visible {
        outline-offset: -2px;
    }

    .player__panel {
        background: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        box-shadow: var(--lift-shadow);
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        height: auto;
        inset: auto calc(var(--control-size) + var(--lift)) var(--space-md) auto;
        max-height: calc(100dvh - var(--header-height) - 2 * var(--space-md));
        max-width: calc(100vw - var(--control-size) - var(--lift) - var(--shell-pad));
        position: fixed;
        width: var(--player-width, min(340px, calc(100vw - var(--control-size) - 2 * var(--space-md))));
    }

    .player__plugin {
        align-items: center;
        border: 1px solid var(--color-border-subtle);
        color: var(--color-text-secondary);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-base);
        line-height: var(--text-base--line-height);
        min-height: 36px;
        padding: 8px 16px;
        transition:
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui);
        width: 100%;
    }

    .player__rack.is-playing .player__plugin {
        border-color: var(--color-border-selected);
        color: var(--color-link);
    }
</style>

<script>
    import { LAUNCHER_SIZE, TRACK_PLAY_TOPIC, WINDOW_MARGINS } from '@lib/shared/constants';
    import { MODULE_NAMES, getRackPosition, getRackState, onRackChange, seekRack, toggleRack } from '@lib/rack/rack';
    import {
        announceTrackState,
        closePlayer,
        getPlayerState,
        getPosition,
        getTrack,
        getVolume,
        isMuted,
        onPlayerChange,
        openPlayer,
        playTrack,
        seekTo,
        setMuted,
        setVolume,
        togglePlayback,
    } from '@lib/audio/player';
    import { claimFloatWindow, formatDuration, initPanelResize, onFloatWindowClaim, registerPageScript, setHidden, setText } from '@lib/shared/utils';

    interface PlayerSource {
        artist: string;
        durationSeconds: number;
        playing: boolean;
        rack: boolean;
        title: string;
    }

    const EMPTY_ARTIST = 'Play a track to load it here.';
    const EMPTY_TITLE = 'Nothing playing';
    const PLAYER_MIN_WIDTH = 340;
    const RACK_ARTIST = 'Rack';
    const RACK_EMPTY = 'No file loaded';
    const RESIZE_LABEL = 'Resize track player';
    const SEEK_LABEL_RACK = 'Seek within the rack';
    const SEEK_LABEL_TRACK = 'Seek within the track';
    const VOLUME_SCALE = 100;

    let frame = 0;
    let isDragging = false;
    let isOpened = false;
    let unsubscribe: (() => void) | undefined;
    let unsubscribeRack: (() => void) | undefined;

    function getSource() {
        const player = getPlayerState();
        const rack = getRackState();
        const track = getTrack();

        if (!player.playing && rack.fileName !== null) {
            return {
                artist: RACK_ARTIST,
                durationSeconds: rack.durationSeconds,
                playing: rack.playing,
                rack: true,
                title: rack.fileName,
            };
        }

        if (!track) return undefined;

        return {
            artist: track.artist,
            durationSeconds: track.durationSeconds,
            playing: player.playing,
            rack: false,
            title: track.title,
        };
    }

    function handleCloseClick() {
        closePlayer();
        document.querySelector<HTMLElement>('[data-player-launcher]')?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (!getPlayerState().open || event.key !== 'Escape') return;

        event.preventDefault();
        closePlayer();
        document.querySelector<HTMLElement>('[data-player-launcher]')?.focus();
    }

    function handleLaunch() {
        if (getPlayerState().open) {
            closePlayer();

            return;
        }

        openPlayer();
        document.querySelector<HTMLElement>('[data-player-close]')?.focus();
    }

    function handleSeek(input: HTMLInputElement) {
        const seconds = Number(input.value);

        if (getSource()?.rack) {
            seekRack(seconds);

            return;
        }

        seekTo(seconds);
    }

    function handleSeekRelease() {
        if (!isDragging) return;

        isDragging = false;
        render();
    }

    function handleToggle() {
        if (getSource()?.rack) {
            toggleRack();

            return;
        }

        togglePlayback();
    }

    function handleTrackPlay(event: WindowEventMap['apa:track-play']) {
        const track = event.detail?.track;

        if (!track) return;

        playTrack(track);
        setText(document.querySelector('[data-player-status]'), `Playing ${track.title} by ${track.artist}.`);
    }

    function initPlayer(signal: AbortSignal) {
        const grip = document.querySelector<HTMLElement>('[data-player-grip]');
        const launcher = document.querySelector<HTMLElement>('[data-player-launcher]');
        const panel = document.querySelector<HTMLElement>('.player__panel');
        const player = document.querySelector<HTMLElement>('.player');
        const seek = document.querySelector<HTMLInputElement>('[data-player-seek]');
        const volume = document.querySelector<HTMLInputElement>('[data-player-volume]');

        if (!grip || !launcher || !panel || !player || !seek || !volume) return;

        announceTrackState();
        player.classList.add('is-ready');
        unsubscribe?.();
        unsubscribeRack?.();
        volume.disabled = isMuted();
        volume.value = String(Math.round(getVolume() * VOLUME_SCALE));
        unsubscribe = onPlayerChange(render);
        unsubscribeRack = onRackChange(render);
        signal.addEventListener('abort', teardown, { once: true });

        initPanelResize({
            handle: grip,
            label: RESIZE_LABEL,
            minWidth: PLAYER_MIN_WIDTH,
            panel,
            property: '--player-width',
            reservedRight: LAUNCHER_SIZE + WINDOW_MARGINS,
            signal,
        });

        document.querySelector<HTMLElement>('[data-player-close]')?.addEventListener('click', handleCloseClick, { signal });
        document.querySelector<HTMLElement>('[data-player-mute]')?.addEventListener('click', toggleMute, { signal });
        document.querySelector<HTMLElement>('[data-player-toggle]')?.addEventListener('click', handleToggle, { signal });
        launcher.addEventListener('click', handleLaunch, { signal });
        onFloatWindowClaim(panel, closePlayer, signal);
        player.addEventListener('keydown', handleKeydown, { signal });
        seek.addEventListener('input', () => handleSeek(seek), { signal });

        seek.addEventListener('pointerdown', () => {
            isDragging = true;
        }, { signal });

        volume.addEventListener('input', () => setVolume(Number(volume.value) / VOLUME_SCALE), { signal });
        window.addEventListener('pointercancel', handleSeekRelease, { signal });
        window.addEventListener('pointerup', handleSeekRelease, { signal });
        window.addEventListener(TRACK_PLAY_TOPIC, handleTrackPlay, { signal });
        render();
    }

    function render() {
        const artist = document.querySelector<HTMLElement>('[data-player-artist]');
        const launcher = document.querySelector<HTMLElement>('[data-player-launcher]');
        const panel = document.querySelector<HTMLElement>('.player__panel');
        const seek = document.querySelector<HTMLInputElement>('[data-player-seek]');
        const source = getSource();
        const state = getPlayerState();
        const title = document.querySelector<HTMLElement>('[data-player-title]');
        const toggle = document.querySelector<HTMLElement>('[data-player-toggle]');

        if (!artist || !launcher || !panel || !seek || !title || !toggle) return;

        const playing = source?.playing ?? false;

        artist.classList.toggle('font-mono', source !== undefined);
        artist.title = source?.artist ?? '';
        panel.hidden = !state.open;
        seek.max = String(Math.max(0, Math.floor(source?.durationSeconds ?? 0)));
        title.title = source?.title ?? '';
        launcher.setAttribute('aria-expanded', String(state.open));
        seek.setAttribute('aria-label', source?.rack ? SEEK_LABEL_RACK : SEEK_LABEL_TRACK);
        seek.toggleAttribute('disabled', !source);
        setHidden(document.querySelector<HTMLElement>('.player__icon--pause'), !playing);
        setHidden(document.querySelector<HTMLElement>('.player__icon--play'), playing);
        setText(artist, source?.artist ?? EMPTY_ARTIST);
        setText(document.querySelector('[data-player-duration]'), formatDuration(source?.durationSeconds ?? 0));
        setText(document.querySelector('[data-player-toggle-label]'), toggleLabel(source));
        setText(title, source?.title ?? EMPTY_TITLE);
        toggle.setAttribute('aria-pressed', String(playing));
        toggle.toggleAttribute('disabled', !source);

        if (!isOpened && state.open) claimFloatWindow(panel);

        isOpened = state.open;
        cancelAnimationFrame(frame);
        renderRack();

        if (state.open) tickProgress();
    }

    function renderRack() {
        const file = document.querySelector<HTMLElement>('[data-player-rack-file]');
        const list = document.querySelector<HTMLElement>('[data-player-plugins]');
        const rack = document.querySelector<HTMLElement>('[data-player-rack]');
        const state = getRackState();
        const template = document.querySelector<HTMLTemplateElement>('[data-player-plugin]');

        if (!file || !list || !rack || !template) return;

        const isLoaded = state.fileName !== null;

        file.classList.toggle('font-mono', isLoaded);
        file.textContent = state.fileName ?? RACK_EMPTY;
        file.title = state.fileName ?? '';
        rack.hidden = !isLoaded && state.activeKinds.length === 0;
        list.replaceChildren();
        rack.classList.toggle('is-playing', state.playing);
        setHidden(document.querySelector<HTMLElement>('[data-player-straight]'), !isLoaded || state.activeKinds.length > 0);

        for (const kind of [...state.activeKinds].reverse()) {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const chip = fragment.querySelector<HTMLElement>('.player__plugin');

            if (!chip) continue;

            chip.textContent = MODULE_NAMES[kind];
            list.append(fragment);
        }
    }

    function teardown() {
        cancelAnimationFrame(frame);
        unsubscribe?.();
        unsubscribeRack?.();
        unsubscribe = undefined;
        unsubscribeRack = undefined;
    }

    function tickProgress() {
        const seek = document.querySelector<HTMLInputElement>('[data-player-seek]');
        const source = getSource();

        const position = source?.rack ? getRackPosition() : getPosition();

        if (!isDragging && seek) seek.value = String(Math.floor(position));

        setText(document.querySelector('[data-player-position]'), formatDuration(position));

        if (source?.playing) frame = requestAnimationFrame(tickProgress);
    }

    function toggleLabel(source: PlayerSource | undefined) {
        if (source?.rack) return source.playing ? 'Pause rack' : 'Play rack';

        return source?.playing ? 'Pause' : 'Play';
    }

    function toggleMute() {
        const button = document.querySelector<HTMLElement>('[data-player-mute]');
        const shouldMute = !isMuted();
        const volume = document.querySelector<HTMLInputElement>('[data-player-volume]');

        if (volume) volume.disabled = shouldMute;

        button?.setAttribute('aria-pressed', String(shouldMute));
        setHidden(document.querySelector<HTMLElement>('.player__icon--muted'), !shouldMute);
        setHidden(document.querySelector<HTMLElement>('.player__icon--sound'), shouldMute);
        setMuted(shouldMute);
    }

    registerPageScript(initPlayer);
</script>
