---
import AccountControl from '@components/shared/AccountControl.astro';
import BrandLockup from '@components/brand/Lockup.astro';
import BrandMark from '@components/brand/Mark.astro';
import IconCart from '@components/icons/Cart.astro';
import IconChevron from '@components/icons/Chevron.astro';
import IconMenu from '@components/icons/Menu.astro';
import { BRAND, BRAND_SIZES } from '@lib/shared/brand';
import { NAV_GROUPS } from '@lib/shared/constants';

interface Props {
    hasHero?: boolean;
}

const HERO_ROUTES = new Set<string>(['/api', '/assemblies', '/bashes', '/directory', '/gallery', '/hangouts', '/partners', '/rack', '/store']);

const { hasHero = false } = Astro.props;

const isOverHero = hasHero || HERO_ROUTES.has(Astro.routePattern);
---

<header
    class:list={['is-instant', 'site-header', hasHero && 'site-header--overlay', 'z-100']}
    data-has-hero={isOverHero ? 'true' : undefined}
    transition:animate="none"
>
    <div class="site-header__bar">
        <a
            class="site-header__brand"
            aria-label={`${BRAND.name}, home`}
            href="/"
        >
            <span class="site-header__mark">
                <BrandMark />
            </span>
            <span class="site-header__lockup">
                <BrandLockup height={BRAND_SIZES.lockupNav} />
            </span>
        </a>
        <nav
            id="site-nav"
            class="site-nav"
            aria-label="Primary"
        >
            <ul class="site-nav__list flex list-none">
                {NAV_GROUPS.map(group => (
                    <li class="site-nav__group relative">
                        {'items' in group && (
                            <Fragment>
                                <button
                                    id={`nav-${group.id}`}
                                    class="site-nav__trigger"
                                    aria-controls={`nav-${group.id}-menu`}
                                    aria-expanded="false"
                                    data-nav-trigger
                                    type="button"
                                >
                                    <span>{group.label}</span>
                                    <span class="site-nav__chevron">
                                        <IconChevron />
                                    </span>
                                </button>
                                <ul
                                    id={`nav-${group.id}-menu`}
                                    class="site-nav__menu z-1 list-none"
                                    aria-labelledby={`nav-${group.id}`}
                                    data-nav-menu
                                    hidden
                                >
                                    {group.items.map(item => (
                                        <li>
                                            <a
                                                class="site-nav__item"
                                                href={item.href}
                                            >
                                                {item.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </Fragment>
                        )}
                        {'href' in group && (
                            <a
                                class="site-nav__link"
                                href={group.href}
                            >
                                {group.label}
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        </nav>
        <div class="site-header__controls flex items-center gap-(--space-3xs) ml-auto">
            <AccountControl />
            <a
                class="cart-link"
                href="/store/cart"
            >
                <IconCart />
                <span
                    class="cart-count"
                    aria-hidden="true"
                    hidden
                >
                    0
                </span>
                <span
                    class="cart-label sr-only"
                    aria-live="polite"
                >
                    Cart
                </span>
            </a>
            <button
                class="nav-toggle"
                aria-controls="site-nav"
                aria-expanded="false"
                aria-label="Toggle menu"
                type="button"
            >
                <IconMenu />
            </button>
        </div>
    </div>
</header>

<style>
    .cart-count {
        align-items: center;
        background: var(--color-badge-count-bg);
        box-shadow: 0 0 0 2px var(--color-bg-page);
        color: var(--color-badge-count-text);
        display: inline-flex;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 700;
        height: 16px;
        justify-content: center;
        line-height: 1;
        min-width: 16px;
        padding: 0 4px;
        position: absolute;
        right: calc(4px + var(--control-box) - var(--control-hit));
        top: 4px;
        user-select: none;
    }

    .cart-link {
        --control-box: calc(var(--control-lead) + var(--control-ink));
        align-items: center;
        display: inline-flex;
        height: var(--control-size);
        justify-content: flex-start;
        padding-inline-start: var(--control-lead);
        position: relative;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-box);
    }

    .cart-link:active {
        transform: translateY(1px);
    }

    .cart-link:hover {
        color: var(--color-link);
    }

    .cart-link::after {
        content: '';
        inset: 0 calc(var(--control-box) - var(--control-hit)) 0 0;
        position: absolute;
    }

    .nav-toggle {
        --control-box: var(--control-hit);
        align-items: center;
        display: none;
        height: var(--control-size);
        justify-content: flex-start;
        padding-inline-start: var(--control-lead);
        position: relative;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-box);
    }

    .nav-toggle:active {
        transform: translateY(1px);
    }

    .nav-toggle:hover {
        color: var(--color-link);
    }

    .nav-toggle::after {
        content: '';
        inset: 0 calc(var(--control-box) - var(--control-hit)) 0 0;
        position: absolute;
    }

    .site-header {
        --control-compact: 40px;
        --control-hit: var(--control-size);
        --control-ink: 22px;
        --control-lead: round((var(--control-hit) - var(--control-ink)) / 2, 4px);
        --header-gutter: calc(var(--shell-pad) + max(0px, (100% - var(--shell-max)) / 2));
        --nav-gap: round(clamp(12px, calc(9.333px + 0.8333vw), 20px), 4px);
        --nav-pad: round(clamp(8px, calc(6.667px + 0.4167vw), 12px), 4px);
        background: var(--color-bg-page);
        border-bottom: 2px solid var(--color-border-strong);
        height: var(--header-height);
        position: sticky;
        top: 0;
        transition:
            background var(--duration-slow) var(--motion-ease-ui),
            border-color var(--duration-slow) var(--motion-ease-ui),
            transform var(--duration-slow) var(--motion-ease-ui);
    }

    .site-header--overlay {
        margin-bottom: calc(-1 * var(--header-height));
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .site-header.is-instant {
        transition: none;
    }

    .site-header[data-has-hero]:not(.is-scrolled) {
        background: transparent;
        border-bottom-color: transparent;
    }

    .site-header__bar {
        align-items: center;
        display: grid;
        gap: var(--nav-gap);
        grid-template-columns: 1fr auto 1fr;
        height: 100%;
        padding-inline: var(--header-gutter);
    }

    .site-header__brand {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        gap: var(--space-2xs);
        height: var(--control-size);
        justify-self: start;
        position: relative;
        user-select: none;
    }

    .site-header__brand:focus-visible {
        outline: none;
    }

    .site-header__brand:focus-visible::after {
        content: '';
        inset: calc(-1 * var(--space-3xs)) calc(-1 * var(--space-xs));
        outline: 2px solid var(--color-focus-ring);
        position: absolute;
    }

    .site-header__mark {
        display: none;
    }

    .site-nav__chevron {
        display: flex;
        transition: rotate var(--duration-fast) var(--motion-ease-ui);
    }

    .site-nav__item {
        --nav-item-hover-bg: var(--color-nav-bg-hover);
        --nav-item-hover-ink: var(--color-link);
        align-items: center;
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: var(--control-size);
        padding-inline: var(--space-sm);
        text-transform: uppercase;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        white-space: nowrap;
        width: 100%;
    }

    .site-nav__item:active {
        transform: translateY(1px);
    }

    .site-nav__item:focus-visible,
    .site-nav__item:hover {
        background: var(--nav-item-hover-bg);
        color: var(--nav-item-hover-ink);
    }

    .site-nav__item[aria-current] {
        box-shadow: inset 4px 0 0 0 var(--color-nav-indicator);
        color: var(--color-link);
    }

    .site-nav__item[aria-current]:focus-visible,
    .site-nav__item[aria-current]:hover {
        color: var(--color-link);
    }

    .site-nav__link {
        align-items: center;
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: var(--control-size);
        padding-inline: var(--nav-pad);
        text-transform: uppercase;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .site-nav__link:active {
        transform: translateY(1px);
    }

    .site-nav__link:hover {
        color: var(--color-link);
    }

    .site-nav__link[aria-current] {
        color: var(--color-link);
    }

    .site-nav__menu {
        background: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-border-strong);
        display: flex;
        flex-direction: column;
        gap: 2px;
        inset: calc(100% + var(--space-2xs)) auto auto 0;
        min-width: 240px;
        padding: var(--space-2xs);
        position: absolute;
    }

    .site-nav__menu::before {
        background: var(--color-nav-indicator);
        content: '';
        height: 2px;
        margin-bottom: var(--space-3xs);
    }

    .site-nav__trigger {
        align-items: center;
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        gap: var(--space-3xs);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: var(--control-size);
        padding-inline: var(--nav-pad);
        text-transform: uppercase;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .site-nav__trigger:active {
        transform: translateY(1px);
    }

    .site-nav__trigger:hover {
        color: var(--color-link);
    }

    .site-nav__trigger[aria-expanded='true'] {
        color: var(--color-link);
    }

    .site-nav__trigger[aria-expanded='true'] .site-nav__chevron {
        rotate: 180deg;
    }

    @media (max-width: 1279px) {
        .site-header__lockup {
            display: none;
        }

        .site-header__mark {
            display: flex;
        }
    }

    @media (max-width: 1024px) {
        .cart-link {
            --control-box: var(--control-hit);
        }

        .nav-toggle {
            --control-box: calc(var(--control-lead) + var(--control-ink));
            display: inline-flex;
        }

        .site-header__bar {
            display: flex;
        }

        .site-nav {
            background: var(--color-bg-page);
            border-bottom: 2px solid var(--color-border-strong);
            display: none;
            inset: 100% 0 auto;
            position: absolute;
        }

        .site-nav.is-open {
            display: block;
        }

        .site-nav__item {
            --nav-item-hover-bg: none;
            --nav-item-hover-ink: var(--color-link);
        }

        .site-nav__item:focus-visible,
        .site-nav__link:focus-visible,
        .site-nav__trigger:focus-visible {
            outline-offset: -2px;
        }

        .site-nav__list {
            flex-direction: column;
            padding-block: var(--space-2xs);
            padding-inline: calc(var(--shell-pad) - var(--nav-pad));
        }

        .site-nav__menu {
            background: none;
            border: 0;
            box-shadow: none;
            gap: 0;
            inset: auto;
            min-width: 0;
            padding: 0 0 0 var(--space-md);
            position: static;
        }

        .site-nav__menu::before {
            display: none;
        }

        .site-nav__trigger {
            width: 100%;
        }
    }

    @media (max-width: 768px) {
        .site-header {
            --control-hit: var(--control-compact);
            --nav-gap: var(--space-3xs);
        }
    }
</style>

<script>
    import { count, onCartChange, seedCart } from '@lib/commerce/cart';
    import { registerPageScript } from '@lib/shared/utils';

    const CART_BADGE_MAX = 99;
    const DESKTOP_QUERY = '(min-width: 1025px)';
    const FOCUSABLE_SELECTOR = 'a[href], button:not([disabled])';
    const HEADER_INSTANT_CLASS = 'is-instant';
    const HEADER_STATE_CLASSES = ['is-hidden'] as const;
    const HOVER_CLICK_GRACE = 500;
    const HOVER_CLOSE_DELAY = 200;
    const SCROLL_DELTA = 6;
    const SCROLL_TOP_THRESHOLD = 80;

    const HOVER_QUERY = `(hover: hover) and ${DESKTOP_QUERY}`;

    let hoverCloseTimer: number | undefined;
    let isHashNavigation = false;
    let isHeaderHovered = false;
    let isHeaderRequested = false;
    let isPointerActive = false;
    let isScrollTicking = false;
    let lastScrollY = 0;
    let unsubscribeCart: (() => void) | undefined;

    function canHover() {
        return window.matchMedia(HOVER_QUERY).matches;
    }

    function clearHoverTimer() {
        clearTimeout(hoverCloseTimer);
        hoverCloseTimer = undefined;
    }

    function closeAll(except?: HTMLElement) {
        document.querySelectorAll<HTMLElement>('[data-nav-trigger]').forEach((trigger) => {
            if (trigger === except) return;
            if (findMenu(trigger)?.contains(document.activeElement)) return;

            setExpanded(trigger, false);
        });
    }

    function closeMenu(menu: HTMLElement, toggle: HTMLElement) {
        closeAll();
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        updateHeader();
    }

    function findMenu(trigger: HTMLElement) {
        const id = trigger.getAttribute('aria-controls');

        return id ? document.getElementById(id) : null;
    }

    function focusItem(menu: HTMLElement, index: number) {
        const items = listItems(menu);

        if (!items.length) return;

        items[(index + items.length) % items.length].focus();
    }

    function handleAfterSwap() {
        const header = document.querySelector<HTMLElement>('.site-header');

        if (!header) return;

        isHeaderRequested = true;
        isScrollTicking = false;
        lastScrollY = window.scrollY;
        updateHeader();
        settleHeader(header);
    }

    function handleBeforeSwap(event: DocumentEventMap['astro:before-swap']) {
        const current = document.querySelector<HTMLElement>('.site-header');
        const next = event.newDocument.querySelector<HTMLElement>('.site-header');

        if (!current || !next) return;

        HEADER_STATE_CLASSES.forEach(name => next.classList.toggle(name, current.classList.contains(name)));
        next.classList.add(HEADER_INSTANT_CLASS);
    }

    function handleDocumentClick(event: MouseEvent, menu: HTMLElement, toggle: HTMLElement) {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest('[data-nav-trigger], [data-nav-menu]')) return;

        closeAll();

        if (!menu.classList.contains('is-open')) return;
        if (event.target.closest('.site-nav, .nav-toggle')) return;

        closeMenu(menu, toggle);
    }

    function handleDocumentKeydown(event: KeyboardEvent, menu: HTMLElement, toggle: HTMLElement) {
        if (event.key !== 'Escape') return;

        const expanded = document.querySelector<HTMLElement>('[data-nav-trigger][aria-expanded="true"]');

        if (expanded) {
            setExpanded(expanded, false);
            expanded.focus();

            return;
        }

        if (menu.classList.contains('is-open')) {
            closeMenu(menu, toggle);
            toggle.focus();
        }
    }

    function handleFocusOut(event: FocusEvent) {
        const group = event.target instanceof Element ? event.target.closest('.site-nav__group, .account__in') : null;
        const next = event.relatedTarget instanceof Element ? event.relatedTarget : null;

        if (!group || isPointerActive) return;
        if (next && group.contains(next)) return;

        const trigger = group.querySelector<HTMLElement>('[data-nav-trigger]');

        if (trigger) setExpanded(trigger, false);
    }

    function handleHashChange() {
        if (!window.location.hash) return;

        isHashNavigation = true;

        if (!history.state) document.querySelector(':target')?.scrollIntoView();

        handleScroll();
    }

    function handleHashClick(event: MouseEvent) {
        const link = event.target instanceof Element ? event.target.closest('a') : null;

        if (!link?.hash || link.pathname !== window.location.pathname) return;

        isHashNavigation = true;
        handleScroll();
    }

    function handleHoverLeave(trigger: HTMLElement) {
        if (!canHover()) return;
        if (trigger.getAttribute('aria-expanded') !== 'true') return;

        scheduleHoverClose(trigger);
    }

    function handleHoverOpen(trigger: HTMLElement) {
        if (!canHover()) return;

        clearHoverTimer();

        if (trigger.getAttribute('aria-expanded') === 'true') return;

        closeAll(trigger);
        setExpanded(trigger, true);
        trigger.dataset.hoverOpened = String(Date.now());
    }

    function handleMenuKeydown(event: KeyboardEvent, menu: HTMLElement) {
        const index = listItems(menu).indexOf(document.activeElement as HTMLElement);

        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            focusItem(menu, index + (event.key === 'ArrowDown' ? 1 : -1));
        } else if (event.key === 'End' || event.key === 'Home') {
            event.preventDefault();
            focusItem(menu, event.key === 'Home' ? 0 : -1);
        }
    }

    function handleMenuTab(event: KeyboardEvent, header: HTMLElement, menu: HTMLElement) {
        if (!menu.classList.contains('is-open') || event.key !== 'Tab') return;

        const items = Array.from(header.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)).filter(item => item.checkVisibility());

        if (!items.length) return;

        const index = items.findIndex(item => item === document.activeElement);
        const offset = event.shiftKey ? -1 : 1;
        const outside = event.shiftKey ? items.length : -1;

        const anchor = index < 0 ? outside : index;

        event.preventDefault();
        items[(anchor + offset + items.length) % items.length].focus();
    }

    function handlePointerDown() {
        isPointerActive = true;
    }

    function handlePointerMove(event: PointerEvent) {
        const header = document.querySelector<HTMLElement>('.site-header');

        if (!header || event.pointerType !== 'mouse') return;

        setHeaderHovered((event.target instanceof Node && header.contains(event.target)) || event.clientY < header.offsetHeight);
    }

    function handlePointerOut(event: PointerEvent) {
        if (event.pointerType !== 'mouse' || event.relatedTarget) return;

        setHeaderHovered(false);
    }

    function handlePointerSettle() {
        isPointerActive = false;
    }

    function handleScroll() {
        if (isScrollTicking) return;

        isScrollTicking = true;
        requestAnimationFrame(trackScroll);
    }

    function handleTriggerClick(trigger: HTMLElement) {
        const hoverOpenedAt = Number(trigger.dataset.hoverOpened ?? '0');
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        clearHoverTimer();
        closeAll(trigger);
        delete trigger.dataset.hoverOpened;

        if (isExpanded && hoverOpenedAt && Date.now() - hoverOpenedAt < HOVER_CLICK_GRACE) return;

        setExpanded(trigger, !isExpanded);
    }

    function handleTriggerKeydown(event: KeyboardEvent, trigger: HTMLElement) {
        const menu = findMenu(trigger);

        if (!menu) return;
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;

        event.preventDefault();
        closeAll(trigger);
        setExpanded(trigger, true);
        focusItem(menu, event.key === 'ArrowDown' ? 0 : -1);
    }

    function initNavbar(signal: AbortSignal) {
        unsubscribeCart?.();
        unsubscribeCart = onCartChange(updateCart);
        signal.addEventListener('abort', () => unsubscribeCart?.(), { once: true });
        signal.addEventListener('abort', clearHoverTimer, { once: true });

        const header = document.querySelector<HTMLElement>('.site-header');
        const menu = document.querySelector<HTMLElement>('.site-nav');
        const toggle = document.querySelector<HTMLElement>('.nav-toggle');

        if (!header || !menu || !toggle) return;

        isHashNavigation = Boolean(window.location.hash);
        isHeaderRequested = true;
        isScrollTicking = false;
        lastScrollY = window.scrollY;
        seedCart();
        updateActiveLink();
        updateCart();
        updateHeader();
        settleHeader(header);
        document.addEventListener('click', event => handleDocumentClick(event, menu, toggle), { signal });
        document.addEventListener('click', handleHashClick, { signal });
        document.addEventListener('click', handlePointerSettle, { signal });
        document.addEventListener('focusout', handleFocusOut, { signal });
        document.addEventListener('keydown', event => handleDocumentKeydown(event, menu, toggle), { signal });
        document.addEventListener('keydown', event => handleMenuTab(event, header, menu), { signal });
        document.addEventListener('keydown', handlePointerSettle, { capture: true, signal });
        document.addEventListener('pointercancel', handlePointerSettle, { signal });
        document.addEventListener('pointerdown', handlePointerDown, { capture: true, signal });
        header.addEventListener('focusin', updateHeader, { signal });
        header.addEventListener('focusout', updateHeader, { signal });

        menu.addEventListener('click', (event) => {
            if (event.target instanceof Element && event.target.closest('a')) closeMenu(menu, toggle);
        }, { signal });

        toggle.addEventListener('click', () => toggleMenu(menu, toggle), { signal });
        window.addEventListener('scroll', handleScroll, { passive: true, signal });
        window.matchMedia(DESKTOP_QUERY).addEventListener('change', () => closeMenu(menu, toggle), { signal });

        document.querySelectorAll<HTMLElement>('[data-nav-trigger]').forEach((trigger) => {
            const panel = findMenu(trigger);
            const zone = trigger.parentElement;

            if (!panel) return;

            panel.addEventListener('keydown', event => handleMenuKeydown(event, panel), { signal });
            trigger.addEventListener('click', () => handleTriggerClick(trigger), { signal });
            trigger.addEventListener('keydown', event => handleTriggerKeydown(event, trigger), { signal });
            zone?.addEventListener('pointerenter', () => handleHoverOpen(trigger), { signal });
            zone?.addEventListener('pointerleave', () => handleHoverLeave(trigger), { signal });
        });
    }

    function listItems(menu: HTMLElement) {
        return Array.from(menu.querySelectorAll<HTMLElement>('li:not([hidden]) a, li:not([hidden]) button'));
    }

    function scheduleHoverClose(trigger: HTMLElement) {
        clearHoverTimer();

        hoverCloseTimer = window.setTimeout(() => {
            const menu = findMenu(trigger);

            if (menu?.contains(document.activeElement)) return;

            setExpanded(trigger, false);
        }, HOVER_CLOSE_DELAY);
    }

    function setExpanded(trigger: HTMLElement, isExpanded: boolean) {
        const menu = findMenu(trigger);

        if (!menu) return;

        if (!isExpanded) delete trigger.dataset.hoverOpened;

        menu.hidden = !isExpanded;
        trigger.setAttribute('aria-expanded', String(isExpanded));
        updateHeader();
    }

    function setHeaderHovered(isHovered: boolean) {
        if (!isHovered && isHeaderHovered) isHeaderRequested = false;

        isHeaderHovered = isHovered;
        updateHeader();
    }

    function settleHeader(header: HTMLElement) {
        header.getBoundingClientRect();
        header.classList.remove(HEADER_INSTANT_CLASS);
    }

    function toggleMenu(menu: HTMLElement, toggle: HTMLElement) {
        if (menu.classList.contains('is-open')) {
            closeMenu(menu, toggle);

            return;
        }

        menu.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        menu.querySelector<HTMLElement>('a, button')?.focus();
    }

    function trackScroll() {
        const currentScrollY = window.scrollY;

        if (currentScrollY < lastScrollY - SCROLL_DELTA || isHashNavigation) {
            isHeaderRequested = true;
        } else if (currentScrollY > lastScrollY + SCROLL_DELTA) {
            isHeaderRequested = false;
        }

        isHashNavigation = false;
        isScrollTicking = false;
        lastScrollY = currentScrollY;
        updateHeader();
    }

    function updateActiveLink() {
        const currentHash = window.location.hash;
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((link) => {
            const target = link.getAttribute('href') ?? '';

            const [path] = target.split('#');

            const hash = target.slice(path.length);
            const href = path.replace(/\/$/, '') || '/';

            if ((hash === '' || hash === currentHash) && href === currentPath) {
                link.setAttribute('aria-current', 'page');
            } else if (currentPath.startsWith(`${href}/`) && href !== '/') {
                link.setAttribute('aria-current', 'true');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    }

    function updateCart() {
        const badge = document.querySelector<HTMLElement>('.cart-count');
        const label = document.querySelector<HTMLElement>('.cart-label');

        if (!badge || !label) return;

        const total = count();

        badge.textContent = total > CART_BADGE_MAX ? `${CART_BADGE_MAX}+` : String(total);
        badge.hidden = total === 0;
        label.textContent = `Cart, ${total} ${total === 1 ? 'item' : 'items'}`;
    }

    function updateHeader() {
        const header = document.querySelector<HTMLElement>('.site-header');

        if (!header) return;

        const isHeld = header.contains(document.activeElement) || header.querySelector('[aria-expanded="true"]') !== null;
        const isNearTop = window.scrollY < SCROLL_TOP_THRESHOLD;
        const isScrolled = window.scrollY > SCROLL_DELTA;

        header.classList.toggle('is-hidden', !(isHeaderHovered || isHeaderRequested || isHeld || isNearTop));
        header.classList.toggle('is-scrolled', isScrolled);
    }

    document.addEventListener('astro:after-swap', handleAfterSwap);
    document.addEventListener('astro:before-swap', handleBeforeSwap);
    document.addEventListener('pointermove', handlePointerMove);
    document.addEventListener('pointerout', handlePointerOut);
    registerPageScript(initNavbar);
    window.addEventListener('hashchange', handleHashChange);
</script>
