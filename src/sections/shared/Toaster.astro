<aside
    class="toaster"
    aria-label="Notifications"
    popover="manual"
    transition:persist
>
    <ol
        class="toaster__list list-none"
        aria-live="polite"
        data-toast-list
    />
    <template data-toast-item>
        <li class="toast">
            <span
                class="toast__badge"
                aria-hidden="true"
            />
            <span class="toast__body">
                <span
                    class="toast__label"
                    data-toast-label
                />
                <span
                    class="toast__message"
                    data-toast-message
                />
            </span>
            <button
                class="toast__close"
                data-toast-close
                type="button"
            >
                <span aria-hidden="true">&times;</span>
                <span class="sr-only">Dismiss</span>
            </button>
        </li>
    </template>
</aside>

<style>
    .toast {
        --focus-ring: var(--color-accent-light);
        --toast-glyph: '\0069';
        --toast-tone: var(--color-ink-inverse);
        align-items: stretch;
        animation: var(--duration-slow) var(--motion-ease-entrance) both toast__rise;
        background: var(--color-surface-inverse);
        border: 2px solid var(--color-ink);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-ink-20);
        color: var(--color-ink-inverse);
        display: flex;
        min-height: 64px;
        pointer-events: auto;
        width: min(92vw, 520px);
    }

    .toast--error {
        --toast-glyph: '\0021';
        --toast-tone: var(--color-accent);
    }

    .toast--info {
        --toast-glyph: '\0069';
        --toast-tone: var(--color-ink-inverse);
    }

    .toast--success {
        --toast-glyph: '\2713';
        --toast-tone: var(--color-pulse);
    }

    .toast__badge {
        align-items: center;
        background: var(--toast-tone);
        color: var(--color-ink);
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 700;
        justify-content: center;
        line-height: 1;
        width: 56px;
    }

    .toast__badge::before {
        content: var(--toast-glyph);
    }

    .toast__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-3xs);
        justify-content: center;
        min-width: 0;
        padding-block: var(--space-sm);
        padding-inline: var(--space-md) var(--space-xs);
    }

    .toast__close {
        align-items: center;
        align-self: center;
        color: inherit;
        display: inline-flex;
        flex-shrink: 0;
        font-size: var(--text-xl);
        height: 48px;
        justify-content: center;
        line-height: 1;
        margin-inline-end: var(--space-2xs);
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .toast__close:active {
        transform: translateY(1px);
    }

    .toast__close:hover {
        color: var(--color-accent-light);
    }

    .toast__label {
        color: var(--toast-tone);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.2;
        overflow-wrap: anywhere;
        text-transform: uppercase;
    }

    .toast__message {
        font-family: var(--font-sans);
        font-size: var(--text-smd);
        line-height: 1.45;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .toaster {
        align-items: center;
        background: transparent;
        border: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        height: auto;
        inset-block: auto var(--space-md);
        inset-inline: 0;
        margin: 0;
        overflow: visible;
        padding: 0;
        pointer-events: none;
        position: fixed;
        width: auto;
        z-index: var(--z-toast);
    }

    .toaster__list {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    @keyframes toast__rise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }
</style>

<script>
    import { TOAST_TOPIC } from '@lib/ui/toasts';
    import { setText } from '@lib/shared/utils';

    const TOAST_DISMISS_MS = 5_000;

    const TOAST_LABELS: Record<ToastTone, string> = {
        error: 'Error',
        info: 'Notice',
        success: 'Success',
    };

    const TOAST_LIMIT = 3;

    const timers = new WeakMap<HTMLElement, number>();

    function dismissToast(item: HTMLElement) {
        const timer = timers.get(item);

        if (timer !== undefined) window.clearTimeout(timer);

        item.remove();
        timers.delete(item);
    }

    function handleToast(event: WindowEventMap['apa:toast']) {
        const { message, tone } = event.detail;
        const aside = document.querySelector<HTMLElement>('.toaster');
        const list = document.querySelector<HTMLElement>('[data-toast-list]');
        const template = document.querySelector<HTMLTemplateElement>('[data-toast-item]');

        if (!aside || !list || !template) return;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const item = fragment.querySelector<HTMLElement>('.toast');

        if (!item) return;

        item.classList.add(`toast--${tone}`);
        setText(fragment.querySelector('[data-toast-label]'), TOAST_LABELS[tone]);
        setText(fragment.querySelector('[data-toast-message]'), message);
        fragment.querySelector('[data-toast-close]')?.addEventListener('click', () => dismissToast(item));
        list.append(fragment);
        raiseToaster(aside);
        timers.set(item, window.setTimeout(() => dismissToast(item), TOAST_DISMISS_MS));
        trimToasts(list);
    }

    function raiseToaster(aside: HTMLElement) {
        if (!('showPopover' in aside)) return;

        if (aside.matches(':popover-open')) aside.hidePopover();

        aside.showPopover();
    }

    function trimToasts(list: HTMLElement) {
        while (list.children.length > TOAST_LIMIT) {
            const oldest = list.firstElementChild;

            if (!(oldest instanceof HTMLElement)) return;

            dismissToast(oldest);
        }
    }

    window.addEventListener(TOAST_TOPIC, handleToast);
</script>
