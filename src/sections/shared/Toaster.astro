---
const CLASS_TOAST = 'toast flex items-stretch max-w-xl min-h-(--control-size) w-full pe-2 border-2 border-border-strong bg-toast-bg text-toast-text pointer-events-auto';
const CLASS_TOAST_BADGE = 'toast__badge flex items-center justify-center shrink-0 w-(--control-size) font-bold font-mono leading-none text-xl bg-(--toast-tone) text-(--toast-glyph-tone)';
const CLASS_TOAST_CLOSE = 'toast__close active:translate-y-px hover:text-toast-action inline-flex items-center justify-center self-center shrink-0 size-(--control-size) leading-none text-xl text-inherit transition-[color,translate]';
---

<aside
    class="toaster z-300"
    aria-label="Notifications"
    popover="manual"
    transition:persist
>
    <ol
        class="toaster__list flex flex-col items-center w-full gap-2 list-none"
        aria-live="polite"
        data-toast-list
    />
    <template data-toast-item>
        <li class={CLASS_TOAST}>
            <span
                class={CLASS_TOAST_BADGE}
                aria-hidden="true"
            />
            <span class="toast__body flex flex-1 flex-col justify-center min-w-0 gap-1 pe-3 ps-(--space-md) py-4">
                <span
                    class="label toast__label wrap-anywhere"
                    data-toast-label
                />
                <span
                    class="toast__message min-w-0 text-base wrap-anywhere"
                    data-toast-message
                />
            </span>
            <button
                class={CLASS_TOAST_CLOSE}
                data-toast-close
                type="button"
            >
                <span aria-hidden="true">&times;</span>
                <span class="sr-only">Dismiss</span>
            </button>
        </li>
    </template>
</aside>

<style>
    .toast {
        --color-focus-ring: var(--color-focus-ring-offset);
        --toast-glyph: '\0069';
        --toast-glyph-tone: var(--color-text);
        --toast-tone: var(--color-bg-page);
        animation: var(--duration-slow) var(--motion-ease-entrance) both toast__rise;
    }

    .toast--error {
        --toast-glyph: '\0021';
        --toast-glyph-tone: var(--color-on-error);
        --toast-tone: var(--color-error);
    }

    .toast--success {
        --toast-glyph: '\2713';
        --toast-glyph-tone: var(--color-on-success);
        --toast-tone: var(--color-success);
    }

    .toast__badge::before {
        content: var(--toast-glyph);
    }

    .toaster {
        background: transparent;
        display: block;
        height: auto;
        inset-block: auto var(--space-lg);
        inset-inline: var(--shell-pad) calc(var(--control-size) + var(--lift));
        overflow: visible;
        pointer-events: none;
        position: fixed;
        width: auto;
    }

    @keyframes toast__rise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }
</style>

<script>
    import { TOAST_TOPIC } from '@lib/ui/toasts';
    import { setText } from '@lib/shared/utils';

    const TOAST_DISMISS_MILLISECONDS = 5_000;

    const TOAST_LABELS: Record<ToastTone, string> = {
        error: 'Error',
        info: 'Notice',
        success: 'Success',
    };

    const TOAST_LIMIT = 3;

    const timers = new WeakMap<HTMLElement, number>();

    function dismissToast(item: HTMLElement) {
        const timer = timers.get(item);

        if (timer !== undefined) window.clearTimeout(timer);

        item.remove();
        timers.delete(item);
    }

    function handleToast(event: WindowEventMap['apa:toast']) {
        const aside = document.querySelector<HTMLElement>('.toaster');
        const list = document.querySelector<HTMLElement>('[data-toast-list]');
        const { message, tone } = event.detail;
        const template = document.querySelector<HTMLTemplateElement>('[data-toast-item]');

        if (!aside || !list || !template) return;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const item = fragment.querySelector<HTMLElement>('.toast');

        if (!item) return;

        item.classList.add(`toast--${tone}`);
        setText(fragment.querySelector('[data-toast-label]'), TOAST_LABELS[tone]);
        setText(fragment.querySelector('[data-toast-message]'), message);
        fragment.querySelector('[data-toast-close]')?.addEventListener('click', () => dismissToast(item));
        list.append(fragment);
        raiseToaster(aside);
        timers.set(item, window.setTimeout(() => dismissToast(item), TOAST_DISMISS_MILLISECONDS));
        trimToasts(list);
    }

    function raiseToaster(aside: HTMLElement) {
        if (!('showPopover' in aside)) return;

        if (aside.matches(':popover-open')) aside.hidePopover();

        aside.showPopover();
    }

    function trimToasts(list: HTMLElement) {
        while (list.children.length > TOAST_LIMIT) {
            const oldest = list.firstElementChild;

            if (!(oldest instanceof HTMLElement)) return;

            dismissToast(oldest);
        }
    }

    window.addEventListener(TOAST_TOPIC, handleToast);
</script>
