---
import IconArrow from '@components/icons/Arrow.astro';
import IconClose from '@components/icons/Close.astro';
import IconSpark from '@components/icons/Spark.astro';
---

<aside
    class="ai"
    aria-label="AI assistant"
    transition:persist
>
    <button
        class="ai__launcher z-(--z-drawer)"
        aria-controls="ai-window"
        aria-expanded="false"
        data-ai-launcher
        type="button"
    >
        <IconSpark />
        <span class="sr-only">Open AI assistant</span>
    </button>
    <dialog
        id="ai-window"
        class="ai__window z-(--z-drawer)"
        aria-labelledby="ai-title"
        data-ai-window
    >
        <div
            class="grip z-1"
            data-ai-grip
        />
        <div class="ai__head flex items-center justify-between shrink-0 gap-(--space-2xs) pl-(--space-sm) border-b border-border-subtle">
            <h2
                id="ai-title"
                class="ai__eyebrow label text-link"
            >
                Ask the Alliance
            </h2>
            <button
                class="ai__close"
                data-ai-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close AI assistant</span>
            </button>
        </div>
        <ol
            class="ai__log flex flex-1 flex-col overflow-y-auto overscroll-contain [scrollbar-gutter:stable] min-h-0 gap-(--space-2xs) p-(--space-sm) list-none"
            aria-live="polite"
            data-ai-log
        />
        <form
            class="ai__form flex shrink-0 gap-(--space-2xs) p-(--space-sm) border-border-subtle border-t"
            data-ai-form
        >
            <input
                id="ai-question"
                class="input flex-1 min-w-0"
                aria-label="Question"
                autocomplete="off"
                data-ai-field
                name="question"
                placeholder="Ask a question"
                type="text"
            />
            <button
                class="ai__send btn btn--accent relative h-(--control-size)"
                data-ai-send
                type="submit"
            >
                <span class="ai__send-label">Ask</span>
                <span
                    class="spinner"
                    aria-hidden="true"
                />
            </button>
        </form>
        <template data-ai-answer>
            <li class="ai__card flex flex-col self-start max-w-[95%] gap-(--space-2xs) px-(--space-xs) py-(--space-2xs) border-blockquote-border border-l-2 bg-bg-sunken">
                <p
                    class="ai__body text-base wrap-anywhere"
                    data-ai-text
                />
                <a
                    class="action-text ai__source"
                    data-ai-source
                    href="/"
                >
                    <span data-ai-source-label>Source</span> <IconArrow />
                </a>
            </li>
        </template>
        <template data-ai-ask>
            <li class="ai__ask self-end max-w-[85%] px-(--space-xs) py-(--space-2xs) text-base wrap-anywhere bg-bg-inverse text-text-inverse" />
        </template>
        <template data-ai-thinking>
            <li
                class="ai__thinking flex items-center self-start gap-(--space-2xs) py-(--space-2xs) font-mono text-base text-text-secondary"
                data-ai-pending
            >
                <span
                    class="spinner"
                    aria-hidden="true"
                />
                Thinking&hellip;
            </li>
        </template>
    </dialog>
</aside>

<style>
    .ai {
        --ai-offset: calc(var(--space-md) + 2 * (var(--launcher-size) + var(--space-2xs)));
        display: none;
    }

    .ai.is-ready {
        display: block;
    }

    .ai__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .ai__close:active {
        transform: translateY(1px);
    }

    .ai__close:focus-visible {
        outline-offset: -2px;
    }

    .ai__close:hover {
        color: var(--color-link);
    }

    .ai__launcher {
        --color-focus-ring: var(--color-focus-ring-offset);
        align-items: center;
        background: var(--color-bg-inverse);
        border: 2px solid currentColor;
        border-right: 0;
        color: var(--color-text-inverse);
        display: inline-flex;
        height: var(--launcher-size);
        inset: auto 0 var(--ai-offset) auto;
        justify-content: center;
        position: fixed;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--launcher-size);
    }

    .ai__launcher:active {
        transform: translateY(1px);
    }

    .ai__launcher:focus-visible {
        outline-offset: -4px;
    }

    .ai__launcher:hover {
        background: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .ai__log:focus-visible {
        outline-offset: -2px;
    }

    .ai__send .spinner {
        display: none;
        inset: 50% auto auto 50%;
        position: absolute;
        translate: -50% -50%;
    }

    .ai__send[aria-busy='true'] .ai__send-label {
        opacity: 0;
    }

    .ai__send[aria-busy='true'] .spinner {
        display: inline-block;
    }

    .ai__send[aria-busy='true']::after {
        display: none;
    }

    .ai__source {
        align-items: center;
        align-self: flex-start;
        display: inline-flex;
        gap: var(--space-2xs);
        min-height: 24px;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .ai__window {
        background: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-border-strong);
        color: var(--color-text);
        height: min(600px, calc(100dvh - var(--header-height) - var(--space-md) - var(--ai-offset)));
        inset: auto calc(var(--launcher-size) + var(--lift)) var(--ai-offset) auto;
        max-width: calc(100vw - var(--launcher-size) - var(--lift) - var(--shell-pad));
        overflow: hidden;
        padding: 0;
        position: fixed;
        width: var(--ai-width, min(340px, calc(100vw - var(--launcher-size) - 2 * var(--space-md))));
    }

    .ai__window[open] {
        display: flex;
        flex-direction: column;
    }
</style>

<script>
    import { LAUNCHER_SIZE, MOCK_LATENCY_MILLISECONDS, POINTER_COARSE_QUERY, WINDOW_MARGINS } from '@lib/shared/constants';
    import { claimFloatWindow, delay, initPanelResize, onFloatWindowClaim, registerPageScript, setPending, setText } from '@lib/shared/utils';

    interface AiAnswer {
        body: string;
        href: string;
        keywords: string[];
        label: string;
    }

    interface AiMessage {
        answer: AiAnswer | null;
        text: string;
    }

    const AI_MIN_WIDTH = 340;

    const ANSWERS: AiAnswer[] = [
        {
            body: 'Assembly is the monthly centerpiece at STATION Austin, an evening devoted to craft and community, with time for tracks to be heard. The Assemblies page lists the next date and the ones after it.',
            href: '/assemblies',
            keywords: ['assembly', 'calendar', 'date', 'event', 'meeting', 'next', 'schedule', 'when'],
            label: 'All Assemblies',
        },
        {
            body: 'Prods are the credit you earn for taking part. They add up as you show up, and each one is worth $1.00 of credit at checkout. Prods are not money: they have no cash value and cannot be bought, sold, or transferred. The terms spell out the rules.',
            href: '/terms#store-and-prods',
            keywords: ['credit', 'currency', 'earn', 'point', 'prod', 'reward'],
            label: 'Read Prods terms',
        },
        {
            body: 'Membership is open to anyone producing in Austin. Come to an Assembly, check in at the door, and your account and profile start from there.',
            href: '/contact',
            keywords: ['apply', 'become', 'join', 'member', 'membership', 'sign up', 'signup'],
            label: 'Get in touch',
        },
        {
            body: 'The Bash is a quarterly afternoon of producing against the clock at ACC Highland Campus, sparked by a prompt and capped by a final showdown.',
            href: '/bashes',
            keywords: ['bash', 'battle', 'competition', 'prompt', 'showdown'],
            label: 'All Bashes',
        },
        {
            body: 'The store carries Alliance merch, and Prods come off the total at checkout, one Prod to the dollar.',
            href: '/store',
            keywords: ['buy', 'cart', 'checkout', 'merch', 'order', 'price', 'shirt', 'shop', 'store'],
            label: 'Browse store',
        },
        {
            body: 'The rack is a Web Audio chain in the browser. Load a file, switch a few modules on, and the track player plays the result back with those modules in the signal path.',
            href: '/rack',
            keywords: ['audio', 'effect', 'module', 'plugin', 'rack', 'synth'],
            label: 'Go to rack',
        },
    ];

    const FALLBACK_ANSWER: AiAnswer = {
        body: 'I know the site basics best. Try asking about Assembly, the Bash, Prods, or the store.',
        href: '/contact',
        keywords: [],
        label: 'Get in touch',
    };

    const GENERIC_KEYWORDS = new Set(['calendar', 'date', 'event', 'meeting', 'next', 'schedule', 'when']);
    const RESIZE_LABEL = 'Resize AI assistant';
    const THINKING_FACTOR = 2;
    const TOPIC_WEIGHT = 10;

    const WELCOME_ANSWER: AiAnswer = {
        body: 'Hey, I\'m the AI assistant. Ask me about Assembly, the Bash, Prods, or the store.',
        href: '/',
        keywords: [],
        label: 'See what\'s next',
    };

    let isPending = false;
    let messages: AiMessage[] = [];

    async function askQuestion(question: string) {
        const text = question.trim();

        if (!text || isPending) return;

        isPending = true;
        messages = [...messages, { answer: null, text }];
        render();

        await delay(MOCK_LATENCY_MILLISECONDS * THINKING_FACTOR);

        const answer = matchAnswer(text);

        isPending = false;
        messages = [...messages, { answer, text: answer.body }];
        render();
    }

    function buildAnswer(answer: AiAnswer) {
        const item = cloneRow('[data-ai-answer]');

        const source = item?.querySelector<HTMLAnchorElement>('[data-ai-source]');

        if (!item || !source) return null;

        source.href = answer.href;
        setText(item.querySelector('[data-ai-text]'), answer.body);
        setText(source.querySelector('[data-ai-source-label]'), answer.label);

        return item;
    }

    function buildAsk(text: string) {
        const item = cloneRow('[data-ai-ask]');

        setText(item, text);

        return item;
    }

    function cloneRow(selector: string) {
        const template = document.querySelector<HTMLTemplateElement>(selector);

        if (!template) return null;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        return fragment.querySelector<HTMLElement>('li');
    }

    function closeWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-ai-window]');

        if (dialog?.open) {
            dialog.close();

            return;
        }

        handleClose(dialog);
    }

    function handleClose(dialog: HTMLDialogElement | null) {
        const active = document.activeElement;
        const launcher = document.querySelector<HTMLElement>('[data-ai-launcher]');

        const isHeld = (dialog?.contains(active) ?? false) || active === document.body || active === null;

        launcher?.setAttribute('aria-expanded', 'false');

        if (isHeld) launcher?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape') return;

        const dialog = document.querySelector<HTMLDialogElement>('[data-ai-window]');

        if (!dialog?.open) return;

        event.preventDefault();
        closeWindow();
    }

    function handleLaunch() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-ai-window]');

        if (!dialog?.open) {
            openWindow();

            return;
        }

        closeWindow();
    }

    async function handleSubmit(event: SubmitEvent) {
        event.preventDefault();

        const field = document.querySelector<HTMLInputElement>('[data-ai-field]');

        if (!field) return;

        const question = field.value;

        field.value = '';

        await askQuestion(question);
    }

    function initAi(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('.ai');
        const dialog = document.querySelector<HTMLDialogElement>('[data-ai-window]');
        const form = document.querySelector<HTMLFormElement>('[data-ai-form]');
        const grip = document.querySelector<HTMLElement>('[data-ai-grip]');
        const launcher = document.querySelector<HTMLElement>('[data-ai-launcher]');

        if (!aside || !dialog || !form || !grip || !launcher) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        aside.classList.add('is-ready');
        launcher.setAttribute('aria-expanded', String(dialog.open));

        initPanelResize({
            handle: grip,
            label: RESIZE_LABEL,
            minWidth: AI_MIN_WIDTH,
            panel: dialog,
            property: '--ai-width',
            reservedRight: LAUNCHER_SIZE + WINDOW_MARGINS,
            signal,
        });

        aside.addEventListener('keydown', handleKeydown, { signal });
        dialog.addEventListener('close', () => handleClose(dialog), { signal });
        document.querySelector<HTMLElement>('[data-ai-close]')?.addEventListener('click', closeWindow, { signal });
        form.addEventListener('submit', event => void handleSubmit(event), { signal });
        launcher.addEventListener('click', handleLaunch, { signal });
        onFloatWindowClaim(dialog, closeWindow, signal);

        if (!messages.length) messages = [{ answer: WELCOME_ANSWER, text: WELCOME_ANSWER.body }];

        render();
    }

    function matchAnswer(question: string) {
        const text = question.toLowerCase();

        let best = FALLBACK_ANSWER;
        let score = 0;

        for (const answer of ANSWERS) {
            const weight = answer.keywords.reduce((total, keyword) => total + (text.includes(keyword) ? weighKeyword(keyword) : 0), 0);

            if (weight > score) {
                best = answer;
                score = weight;
            }
        }

        return best;
    }

    function openWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-ai-window]');
        const field = document.querySelector<HTMLInputElement>('[data-ai-field]');

        if (!dialog || dialog.open) return;

        dialog.show();
        document.querySelector<HTMLElement>('[data-ai-launcher]')?.setAttribute('aria-expanded', 'true');
        claimFloatWindow(dialog);

        const close = dialog.querySelector<HTMLElement>('[data-ai-close]');

        (window.matchMedia(POINTER_COARSE_QUERY).matches ? close : (field ?? close))?.focus();
    }

    function render() {
        const log = document.querySelector<HTMLElement>('[data-ai-log]');

        if (!log) return;

        log.querySelector('[data-ai-pending]')?.remove();
        setPending(document.querySelector<HTMLButtonElement>('[data-ai-send]'), isPending);

        messages.slice(log.children.length).forEach((message) => {
            const item = message.answer ? buildAnswer(message.answer) : buildAsk(message.text);

            if (item) log.append(item);
        });

        if (isPending) {
            const thinking = cloneRow('[data-ai-thinking]');

            if (thinking) log.append(thinking);
        }

        log.scrollTop = log.scrollHeight;
    }

    function weighKeyword(keyword: string) {
        return GENERIC_KEYWORDS.has(keyword) ? 1 : TOPIC_WEIGHT;
    }

    registerPageScript(initAi);
</script>
