---
import IconChat from '@components/icons/Chat.astro';
import IconClose from '@components/icons/Close.astro';
---

<aside
    class="chat"
    aria-label="Member chat"
    transition:persist
>
    <button
        class="chat__launcher"
        aria-controls="chat-window"
        aria-expanded="false"
        data-chat-launcher
        type="button"
    >
        <IconChat />
        <span class="sr-only">Open member chat</span>
    </button>
    <dialog
        id="chat-window"
        class="chat__window"
        aria-labelledby="chat-title"
        data-chat-window
        data-float-window
    >
        <div
            class="grip"
            data-chat-grip
        />
        <div class="chat__head">
            <div class="chat__title">
                <h2
                    id="chat-title"
                    class="chat__eyebrow label"
                >
                    Global
                </h2>
                <p class="chat__tally">
                    <span data-chat-online>0 online</span>
                </p>
            </div>
            <button
                class="chat__close"
                data-chat-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close member chat</span>
            </button>
        </div>
        <ol
            class="chat__log list-none"
            aria-live="polite"
            data-chat-log
        />
        <form
            class="chat__form"
            data-chat-form
        >
            <input
                id="chat-message"
                class="input flex-1 min-w-0 text-sm"
                aria-label="Message"
                autocomplete="off"
                data-chat-field
                name="message"
                placeholder="Write a message"
                type="text"
            />
            <button
                class="btn btn--accent chat__send"
                type="submit"
            >
                Send
            </button>
        </form>
        <template data-chat-message>
            <li class="chat__message">
                <span
                    class="chat__avatar"
                    aria-hidden="true"
                    data-chat-avatar
                />
                <span class="chat__meta">
                    <span
                        class="chat__author"
                        data-chat-author
                    />
                    <span
                        class="chat__time"
                        data-chat-time
                    />
                </span>
                <span
                    class="chat__body"
                    data-chat-text
                />
            </li>
        </template>
    </dialog>
</aside>

<style>
    .chat {
        --chat-offset: calc(var(--space-md) + var(--launcher-size) + var(--space-2xs));
        display: none;
    }

    .chat.is-ready {
        display: block;
    }

    .chat__author {
        font-size: var(--text-sm);
        font-weight: 700;
        line-height: 1.2;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .chat__avatar {
        align-items: center;
        align-self: start;
        border: 2px solid var(--color-ink);
        border-radius: 9999px;
        color: var(--color-surface-raised);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        font-weight: 700;
        grid-area: avatar;
        height: 30px;
        justify-content: center;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
        width: 30px;
    }

    .chat__body {
        font-size: var(--text-sm);
        grid-area: body;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .chat__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: 50px;
        justify-content: center;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: 50px;
    }

    .chat__close:active {
        transform: translateY(1px);
    }

    .chat__close:focus-visible {
        outline-offset: -2px;
    }

    .chat__close:hover {
        color: var(--color-accent-deep);
    }

    .chat__eyebrow {
        color: var(--color-accent-deep);
    }

    .chat__form {
        border-top: 1px solid var(--color-ink-20);
        display: flex;
        flex-shrink: 0;
        gap: var(--space-2xs);
        padding: var(--space-sm);
    }

    .chat__head {
        align-items: center;
        border-bottom: 1px solid var(--color-ink-20);
        display: flex;
        flex-shrink: 0;
        gap: var(--space-2xs);
        justify-content: space-between;
        padding-left: var(--space-sm);
    }

    .chat__launcher {
        --focus-ring: var(--color-accent-light);
        align-items: center;
        background: var(--color-surface-inverse);
        border: 2px solid var(--color-ink);
        border-right: 0;
        color: var(--color-ink-inverse);
        display: inline-flex;
        height: var(--launcher-size);
        inset: auto 0 var(--chat-offset) auto;
        justify-content: center;
        position: fixed;
        transition: background var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--launcher-size);
        z-index: var(--z-drawer);
    }

    .chat__launcher:active {
        transform: translateY(1px);
    }

    .chat__launcher:focus-visible {
        outline-offset: -2px;
    }

    .chat__launcher:hover {
        --focus-ring: var(--color-ink);
        background: var(--color-accent);
        color: var(--color-ink);
    }

    .chat__log {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-2xs);
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-sm);
    }

    .chat__message {
        column-gap: var(--space-2xs);
        display: grid;
        grid-template-areas:
            'avatar meta'
            'avatar body';
        grid-template-columns: 30px minmax(0, 1fr);
        row-gap: var(--space-3xs);
    }

    .chat__message:has(+ .chat__message:not(.chat__message--grouped)) {
        margin-bottom: calc(var(--space-sm) - var(--space-2xs));
    }

    .chat__message--grouped {
        grid-template-areas: 'avatar body';
    }

    .chat__message--grouped .chat__avatar,
    .chat__message--grouped .chat__meta {
        display: none;
    }

    .chat__meta {
        align-items: baseline;
        column-gap: var(--space-2xs);
        display: flex;
        flex-wrap: wrap;
        grid-area: meta;
        min-width: 0;
    }

    .chat__send {
        height: 50px;
    }

    .chat__tally {
        align-items: center;
        color: var(--color-ink-muted);
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        line-height: 1;
    }

    .chat__time {
        color: var(--color-ink-muted);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
    }

    .chat__title {
        align-items: center;
        display: flex;
        gap: var(--space-sm);
        min-width: 0;
    }

    .chat__window {
        background: var(--color-surface-raised);
        border: 2px solid var(--color-ink);
        box-shadow: calc(-1 * var(--lift)) var(--lift) 0 0 var(--color-ink);
        color: var(--color-ink);
        height: min(600px, calc(100dvh - var(--header-height) - var(--space-md) - var(--chat-offset)));
        inset: auto var(--launcher-size) var(--chat-offset) auto;
        overflow: hidden;
        padding: 0;
        position: fixed;
        width: var(--chat-width, min(340px, calc(100vw - var(--launcher-size) - 2 * var(--space-md))));
        z-index: var(--z-drawer);
    }

    .chat__window[open] {
        display: flex;
        flex-direction: column;
    }
</style>

<script>
    import { PALETTE } from '@lib/constants';
    import { ROOM_MEMBERS, closeChat, getChatState, getMessages, getOnlineCount, onChatChange, openChat, seedRoom, sendChatMessage } from '@lib/chat';
    import { formatTime, getInitials, initPanelResize, isTopFloatWindow, raiseWindow, registerPageScript, setText } from '@lib/utils';

    const CHAT_MIN_WIDTH = 340;
    const GROUP_WINDOW_MS = 300_000;
    const LAUNCHER_SIZE = 50;
    const LIVE_RESET_DELAY = 200;
    const MEMBER_COLORS = new Map<string, string>(ROOM_MEMBERS.map((member, index) => [member.name, PALETTE[(index + 1) % PALETTE.length]]));
    const RESIZE_LABEL = 'Resize member chat';
    const SELF_COLOR = PALETTE[PALETTE.length - 1];
    const TALLY_INTERVAL_MS = 60_000;
    const WINDOW_MARGINS = 48;

    let liveTimer: number | undefined;
    let tallyTimer: number | undefined;
    let unsubscribeChat: (() => void) | undefined;

    function buildMessage(message: ChatMessage, previous: ChatMessage | undefined) {
        const template = document.querySelector<HTMLTemplateElement>('[data-chat-message]');

        if (!template) return null;

        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const avatar = fragment.querySelector<HTMLElement>('[data-chat-avatar]');
        const item = fragment.querySelector<HTMLElement>('.chat__message');

        if (!avatar || !item) return null;

        const grouped = previous !== undefined && previous.name === message.name && message.sentAt - previous.sentAt < GROUP_WINDOW_MS;

        item.classList.toggle('chat__message--grouped', grouped);
        avatar.style.background = message.self ? SELF_COLOR : (MEMBER_COLORS.get(message.name) ?? SELF_COLOR);
        setText(avatar, getInitials(message.name));
        setText(fragment.querySelector('[data-chat-author]'), message.name);
        setText(fragment.querySelector('[data-chat-time]'), formatTime(new Date(message.sentAt)));
        setText(fragment.querySelector('[data-chat-text]'), message.body);

        return item;
    }

    function closeWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (dialog?.open) {
            dialog.close();

            return;
        }

        handleClose(dialog);
    }

    function handleClose(dialog: HTMLDialogElement | null) {
        const active = document.activeElement;
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');
        const held = active === null || active === document.body || (dialog?.contains(active) ?? false);

        closeChat();
        launcher?.setAttribute('aria-expanded', 'false');

        if (held) launcher?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape') return;

        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (!dialog?.open) return;

        event.preventDefault();
        closeWindow();
    }

    function handleLaunch() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (!getChatState().open) {
            openChat();
            openWindow(true);

            return;
        }

        if (dialog?.open && !isTopFloatWindow(dialog)) {
            raiseWindow(dialog);

            return;
        }

        closeWindow();
    }

    async function handleSubmit(event: SubmitEvent) {
        event.preventDefault();

        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');

        if (!field) return;

        const body = field.value;

        field.value = '';
        await sendChatMessage(body);
    }

    function initChat(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('.chat');
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
        const grip = document.querySelector<HTMLElement>('[data-chat-grip]');
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');

        if (!aside || !dialog || !form || !grip || !launcher) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        aside.classList.add('is-ready');
        unsubscribeChat?.();
        unsubscribeChat = onChatChange(render);
        signal.addEventListener('abort', teardown, { once: true });
        initPanelResize({
            handle: grip,
            label: RESIZE_LABEL,
            minWidth: CHAT_MIN_WIDTH,
            panel: dialog,
            property: '--chat-width',
            reservedRight: LAUNCHER_SIZE + WINDOW_MARGINS,
            signal,
        });

        aside.addEventListener('keydown', handleKeydown, { signal });
        dialog.addEventListener('close', () => handleClose(dialog), { signal });
        document.querySelector<HTMLElement>('[data-chat-close]')?.addEventListener('click', closeWindow, { signal });
        form.addEventListener('submit', event => void handleSubmit(event), { signal });
        launcher.addEventListener('click', handleLaunch, { signal });

        seedRoom();

        window.clearInterval(tallyTimer);
        tallyTimer = window.setInterval(renderTally, TALLY_INTERVAL_MS);

        if (getChatState().open) openWindow(false);

        render();
    }

    function openWindow(moveFocus: boolean) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');
        const previous = document.activeElement;

        if (!dialog || dialog.open) return;

        dialog.show();
        raiseWindow(dialog);
        document.querySelector<HTMLElement>('[data-chat-launcher]')?.setAttribute('aria-expanded', 'true');

        if (moveFocus) {
            (field ?? dialog.querySelector<HTMLElement>('[data-chat-close]'))?.focus();

            return;
        }

        if (previous instanceof HTMLElement && previous !== document.body) {
            previous.focus();
        } else if (document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
        }
    }

    function render() {
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        renderTally();

        if (log) renderLog(log, getMessages());
    }

    function renderLog(log: HTMLElement, messages: ChatMessage[]) {
        const stale = !log.children.length || log.children.length > messages.length;

        if (stale) {
            log.setAttribute('aria-live', 'off');
            log.replaceChildren();
            window.clearTimeout(liveTimer);
            liveTimer = window.setTimeout(() => log.setAttribute('aria-live', 'polite'), LIVE_RESET_DELAY);
        }

        const start = log.children.length;

        messages.slice(start).forEach((message, offset) => {
            const item = buildMessage(message, messages[start + offset - 1]);

            if (item) log.append(item);
        });
        log.scrollTop = log.scrollHeight;
    }

    function renderTally() {
        setText(document.querySelector('[data-chat-online]'), `${getOnlineCount(Date.now())} online`);
    }

    function teardown() {
        window.clearInterval(tallyTimer);
        window.clearTimeout(liveTimer);
        unsubscribeChat?.();
        liveTimer = undefined;
        tallyTimer = undefined;
        unsubscribeChat = undefined;
    }

    registerPageScript(initChat);
</script>
