---
import IconChat from '@components/icons/Chat.astro';
import IconClose from '@components/icons/Close.astro';
import { CHAT_MESSAGE_MAX_LENGTH } from '@lib/shared/constants';
---

<aside
    class="chat"
    aria-label="Member chat"
    transition:persist
>
    <button
        class="chat__launcher z-(--z-drawer)"
        aria-controls="chat-window"
        aria-expanded="false"
        data-chat-launcher
        type="button"
    >
        <IconChat />
        <span class="sr-only">Open member chat</span>
    </button>
    <dialog
        id="chat-window"
        class="chat__window overflow-y-clip z-(--z-drawer)"
        aria-labelledby="chat-title"
        data-chat-window
    >
        <div
            class="grip z-1"
            data-chat-grip
        />
        <div class="chat__head flex items-center justify-between shrink-0 gap-2 pl-4 border-b border-border-subtle">
            <div class="chat__title flex items-center min-w-0 gap-4">
                <h2
                    id="chat-title"
                    class="chat__eyebrow label text-link"
                >
                    Global
                </h2>
                <p class="chat__tally label flex items-center shrink-0 text-text-secondary select-none">
                    <span data-chat-online>0 online</span>
                </p>
            </div>
            <button
                class="chat__close"
                data-chat-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close member chat</span>
            </button>
        </div>
        <ol
            class="chat__log scroll-slot flex flex-1 flex-col min-h-0 gap-2 p-4 list-none"
            aria-live="polite"
            data-chat-log
        />
        <form
            class="chat__form flex flex-wrap justify-end shrink-0 gap-2 p-4 border-border-subtle border-t"
            data-chat-form
        >
            <label class="flex flex-1 min-w-42">
                <span class="sr-only">Message</span>
                <input
                    class="input"
                    autocomplete="off"
                    data-chat-field
                    maxlength={CHAT_MESSAGE_MAX_LENGTH}
                    name="message"
                    placeholder="Write a message"
                    type="text"
                />
            </label>
            <button
                class="btn btn--accent chat__send h-(--control-size)"
                type="submit"
            >
                Send
            </button>
        </form>
        <template data-chat-message>
            <li class="chat__message">
                <span
                    class="chat__avatar"
                    aria-hidden="true"
                    data-chat-avatar
                />
                <span class="chat__meta [grid-area:meta] flex flex-wrap items-baseline min-w-0 gap-x-2">
                    <span
                        class="chat__author min-w-0 font-bold leading-(--text-lg) text-base wrap-anywhere"
                        data-chat-author
                    />
                    <time
                        class="chat__time font-mono text-sm text-text-secondary"
                        data-chat-time
                    />
                </span>
                <span
                    class="chat__body [grid-area:body] text-base wrap-anywhere"
                    data-chat-text
                />
            </li>
        </template>
    </dialog>
    <div
        class="sr-only"
        aria-hidden="true"
    >
        <input
            data-chat-haptic
            {...{ switch: '' }}
            tabindex="-1"
            type="checkbox"
        />
    </div>
</aside>

<style>
    .chat {
        --chat-bottom: max(var(--space-md), min(var(--chat-offset), calc(100dvh - var(--header-height) - var(--space-md) - 320px)));
        --chat-offset: calc(var(--space-md) + var(--control-size) + 8px);
        display: none;
    }

    .chat.is-ready {
        display: block;
    }

    .chat__avatar {
        align-items: center;
        align-self: start;
        border: 2px solid var(--color-border-strong);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 700;
        grid-area: avatar;
        height: 32px;
        justify-content: center;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
        width: 32px;
    }

    .chat__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .chat__close:active {
        transform: translateY(1px);
    }

    .chat__close:focus-visible {
        outline-offset: -4px;
    }

    .chat__close:hover {
        color: var(--color-link);
    }

    .chat__launcher {
        --color-focus-ring: var(--color-focus-ring-offset);
        align-items: center;
        background: var(--color-bg-inverse);
        border: 2px solid currentColor;
        border-right: 0;
        color: var(--color-text-inverse);
        display: inline-flex;
        height: var(--control-size);
        inset: auto 0 var(--chat-offset) auto;
        justify-content: center;
        position: fixed;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .chat__launcher:active {
        transform: translateY(1px);
    }

    .chat__launcher:focus-visible {
        outline-offset: -6px;
    }

    .chat__launcher:hover {
        background: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .chat__log:focus-visible {
        outline-offset: -2px;
    }

    .chat__message {
        column-gap: 8px;
        display: grid;
        grid-template-areas:
            'avatar meta'
            'avatar body';
        grid-template-columns: 32px minmax(0, 1fr);
        row-gap: 4px;
    }

    .chat__message:has(+ .chat__message:not(.chat__message--grouped)) {
        margin-bottom: 8px;
    }

    .chat__message--grouped {
        grid-template-areas: 'avatar body';
    }

    .chat__message--grouped .chat__avatar,
    .chat__message--grouped .chat__meta {
        display: none;
    }

    .chat__window {
        background: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        color: var(--color-text);
        height: min(600px, calc(100dvh - var(--header-height) - var(--space-md) - var(--chat-bottom)));
        inset: auto calc(var(--control-size) + var(--lift)) var(--chat-bottom) auto;
        max-width: calc(100vw - var(--control-size) - var(--lift) - var(--shell-pad));
        position: fixed;
        width: var(--chat-width, min(340px, calc(100vw - var(--control-size) - 2 * var(--space-md))));
    }

    .chat__window[open] {
        display: flex;
        flex-direction: column;
    }
</style>

<script>
    import { LAUNCHER_SIZE, PALETTE, POINTER_COARSE_QUERY, WINDOW_MARGINS } from '@lib/shared/constants';
    import {
        claimFloatWindow,
        formatTime,
        getInitials,
        initPanelResize,
        onFloatWindowClaim,
        pickTileColor,
        registerPageScript,
        setText,
        toAustinIso,
    } from '@lib/shared/utils';
    import {
        closeChat,
        connectChat,
        getChatState,
        getMessages,
        hasEarlierMessages,
        loadEarlierMessages,
        onChatChange,
        openChat,
        sendChatMessage,
    } from '@lib/chat/chat';
    import { getSession, onSessionChange } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const CHAT_MIN_WIDTH = 340;
    const GROUP_WINDOW_MILLISECONDS = 300_000;
    const LIVE_RESET_MILLISECONDS = 200;
    const PIN_THRESHOLD_PIXELS = 48;
    const RECEIVE_HAPTICS_MILLISECONDS = [60, 90, 110];
    const RESIZE_LABEL = 'Resize member chat';

    const selfColor = PALETTE[PALETTE.length - 1];

    let fieldUserId = '';
    let liveTimer: Timer | undefined;
    let swapDistance = 0;
    let unsubscribeChat: (() => void) | undefined;
    let unsubscribeSession: (() => void) | undefined;

    function buildMessage(message: ChatMessage, previous: ChatMessage | undefined) {
        const template = document.querySelector<HTMLTemplateElement>('[data-chat-message]');

        if (!template) return null;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const avatar = fragment.querySelector<HTMLElement>('[data-chat-avatar]');
        const item = fragment.querySelector<HTMLElement>('.chat__message');

        if (!avatar || !item) return null;

        const isGrouped = previous !== undefined
            && previous.userId === message.userId
            && message.sentAt - previous.sentAt < GROUP_WINDOW_MILLISECONDS;

        const tileColor = message.self ? selfColor : pickTileColor(message.userId);

        item.classList.toggle('chat__message--grouped', isGrouped);
        item.dataset.chatId = message.id;
        setText(avatar, getInitials(message.name));
        setText(fragment.querySelector('[data-chat-author]'), message.name);
        setText(fragment.querySelector('[data-chat-text]'), message.body);
        setText(fragment.querySelector('[data-chat-time]'), formatTime(new Date(message.sentAt)));
        fragment.querySelector('[data-chat-time]')?.setAttribute('datetime', toAustinIso(new Date(message.sentAt)));
        avatar.style.background = tileColor.background;
        avatar.style.color = tileColor.text;

        return item;
    }

    function closeWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (dialog?.open) {
            dialog.close();

            return;
        }

        handleClose(dialog);
    }

    function handleAfterSwap() {
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        if (log) log.scrollTop = log.scrollHeight - log.clientHeight - swapDistance;
    }

    function handleBeforeSwap() {
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        if (log) swapDistance = log.scrollHeight - log.scrollTop - log.clientHeight;
    }

    function handleClose(dialog: HTMLDialogElement | null) {
        const active = document.activeElement;
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');

        const isHeld = (dialog?.contains(active) ?? false) || active === document.body || active === null;

        closeChat();
        launcher?.setAttribute('aria-expanded', 'false');

        if (isHeld) launcher?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape') return;

        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (!dialog?.open) return;

        event.preventDefault();
        closeWindow();
    }

    function handleLaunch() {
        if (!getChatState().open) {
            openChat();
            openWindow();

            return;
        }

        closeWindow();
    }

    async function handleSubmit(event: SubmitEvent) {
        if (!(event.target instanceof HTMLFormElement) || !event.target.matches('[data-chat-form]')) return;

        event.preventDefault();

        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');

        if (!field) return;

        const body = field.value.trim();

        field.value = '';

        if (!body) return;

        const result = await sendChatMessage(body);

        if (result.ok) return;

        if (!field.value) field.value = body;

        toast(result.message, 'error');
    }

    function initChat(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('.chat');
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const grip = document.querySelector<HTMLElement>('[data-chat-grip]');
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        if (!aside || !dialog || !grip || !launcher || !log) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        aside.classList.add('is-ready');
        launcher.setAttribute('aria-expanded', String(dialog.open));
        unsubscribeChat?.();
        unsubscribeSession?.();
        unsubscribeChat = onChatChange(render);
        unsubscribeSession = onSessionChange(syncChat);
        signal.addEventListener('abort', teardown, { once: true });

        initPanelResize({
            handle: grip,
            label: RESIZE_LABEL,
            minWidth: CHAT_MIN_WIDTH,
            panel: dialog,
            property: '--chat-width',
            reservedRight: LAUNCHER_SIZE + WINDOW_MARGINS,
            signal,
        });

        aside.addEventListener('keydown', handleKeydown, { signal });
        dialog.addEventListener('close', () => handleClose(dialog), { signal });
        document.querySelector<HTMLElement>('[data-chat-close]')?.addEventListener('click', closeWindow, { signal });
        launcher.addEventListener('click', handleLaunch, { signal });

        log.addEventListener('scroll', () => {
            if (log.scrollTop <= 0 && hasEarlierMessages()) void loadEarlierMessages();
        }, { passive: true, signal });

        onFloatWindowClaim(dialog, closeWindow, signal);
        syncChat();
        render();
    }

    function isRendered(item: HTMLElement, message: ChatMessage) {
        return item.dataset.chatId === message.id
            && item.querySelector('[data-chat-author]')?.textContent === message.name
            && item.querySelector('[data-chat-time]')?.textContent === formatTime(new Date(message.sentAt));
    }

    function openWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        if (!dialog || dialog.open) return;

        dialog.show();

        if (log) log.scrollTop = log.scrollHeight;

        document.querySelector<HTMLElement>('[data-chat-launcher]')?.setAttribute('aria-expanded', 'true');
        claimFloatWindow(dialog);

        const close = dialog.querySelector<HTMLElement>('[data-chat-close]');

        (window.matchMedia(POINTER_COARSE_QUERY).matches ? close : (field ?? close))?.focus();
    }

    function pulseReceive() {
        const canVibrate = typeof navigator.vibrate === 'function';
        const fallbackSwitch = document.querySelector<HTMLInputElement>('[data-chat-haptic]');

        if (!canVibrate && !fallbackSwitch) return;
        if (!window.matchMedia(POINTER_COARSE_QUERY).matches) return;
        if (document.visibilityState !== 'visible') return;
        if (navigator.userActivation?.hasBeenActive === false) return;

        if (canVibrate) {
            navigator.vibrate(RECEIVE_HAPTICS_MILLISECONDS);

            return;
        }

        fallbackSwitch?.click();
    }

    function render() {
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        setText(document.querySelector('[data-chat-online]'), `${getChatState().online} online`);

        if (log) renderLog(log, getMessages());
    }

    function renderLog(log: HTMLElement, messages: ChatMessage[]) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const distance = log.scrollHeight - log.scrollTop - log.clientHeight;
        const rendered = Array.from(log.querySelectorAll<HTMLElement>('[data-chat-id]'));

        const head = Math.max(rendered.findIndex(item => item.dataset.chatId === messages.at(0)?.id), 0);

        const kept = rendered.slice(head);

        const anchor = kept.at(-1);
        const isAppend = kept.length > 0 && kept.length <= messages.length && kept.every((item, index) => isRendered(item, messages[index]));

        const anchorTop = (anchor?.offsetTop ?? 0) - log.scrollTop;
        const start = isAppend ? kept.length : 0;

        const fresh = messages.slice(start);

        if (isAppend) {
            rendered.slice(0, head).forEach(item => item.remove());
            kept[0].classList.remove('chat__message--grouped');
        } else {
            log.setAttribute('aria-live', 'off');
            log.replaceChildren();
            clearTimeout(liveTimer);
            liveTimer = setTimeout(() => log.setAttribute('aria-live', 'polite'), LIVE_RESET_MILLISECONDS);
        }

        fresh.forEach((message, offset) => {
            const item = buildMessage(message, messages[start + offset - 1]);

            if (item) log.append(item);
        });

        if (isAppend && dialog?.open && fresh.some(message => !message.self)) pulseReceive();

        if (distance < PIN_THRESHOLD_PIXELS || (isAppend && fresh.some(message => message.self))) log.scrollTop = log.scrollHeight;
        else if (!isAppend) log.scrollTop = log.scrollHeight - log.clientHeight - distance;
        else if (anchor) log.scrollTop = anchor.offsetTop - anchorTop;
    }

    function syncChat() {
        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');
        const userId = getSession()?.id ?? '';

        if (field && fieldUserId && userId !== fieldUserId) field.value = '';

        fieldUserId = userId;
        connectChat();
    }

    function teardown() {
        clearTimeout(liveTimer);
        document.querySelector('[data-chat-log]')?.setAttribute('aria-live', 'polite');
        unsubscribeChat?.();
        unsubscribeSession?.();
        liveTimer = undefined;
        unsubscribeChat = undefined;
        unsubscribeSession = undefined;
    }

    document.addEventListener('astro:after-swap', handleAfterSwap);
    document.addEventListener('astro:before-swap', handleBeforeSwap);
    document.addEventListener('submit', event => void handleSubmit(event), { capture: true });
    registerPageScript(initChat);
</script>
