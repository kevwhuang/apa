---
import IconChat from '@components/icons/Chat.astro';
import IconClose from '@components/icons/Close.astro';
---

<aside
    class="chat"
    aria-label="Member chat"
    transition:persist
>
    <button
        class="chat__launcher z-(--z-drawer)"
        aria-controls="chat-window"
        aria-expanded="false"
        data-chat-launcher
        type="button"
    >
        <IconChat />
        <span class="sr-only">Open member chat</span>
    </button>
    <dialog
        id="chat-window"
        class="chat__window overflow-y-clip z-(--z-drawer)"
        aria-labelledby="chat-title"
        data-chat-window
    >
        <div
            class="grip z-1"
            data-chat-grip
        />
        <div class="chat__head flex items-center justify-between shrink-0 gap-2 pl-4 border-b border-border-subtle">
            <div class="chat__title flex items-center min-w-0 gap-4">
                <h2
                    id="chat-title"
                    class="chat__eyebrow label text-link"
                >
                    Global
                </h2>
                <p class="chat__tally label flex items-center shrink-0 text-text-secondary select-none">
                    <span data-chat-online>0 online</span>
                </p>
            </div>
            <button
                class="chat__close"
                data-chat-close
                type="button"
            >
                <IconClose />
                <span class="sr-only">Close member chat</span>
            </button>
        </div>
        <ol
            class="chat__log scroll-slot flex flex-1 flex-col min-h-0 gap-2 p-4 list-none"
            aria-live="polite"
            data-chat-log
        />
        <form
            class="chat__form flex flex-wrap justify-end shrink-0 gap-2 p-4 border-border-subtle border-t"
            data-chat-form
        >
            <input
                id="chat-message"
                class="input flex-1 min-w-42"
                aria-label="Message"
                autocomplete="off"
                data-chat-field
                name="message"
                placeholder="Write a message"
                type="text"
            />
            <button
                class="btn btn--accent chat__send h-(--control-size)"
                type="submit"
            >
                Send
            </button>
        </form>
        <template data-chat-message>
            <li class="chat__message">
                <span
                    class="chat__avatar"
                    aria-hidden="true"
                    data-chat-avatar
                />
                <span class="chat__meta [grid-area:meta] flex flex-wrap items-baseline min-w-0 gap-x-2">
                    <span
                        class="chat__author min-w-0 font-bold leading-(--text-lg) text-base wrap-anywhere"
                        data-chat-author
                    />
                    <span
                        class="chat__time font-mono text-sm text-text-secondary"
                        data-chat-time
                    />
                </span>
                <span
                    class="chat__body [grid-area:body] text-base wrap-anywhere"
                    data-chat-text
                />
            </li>
        </template>
    </dialog>
    <div
        class="sr-only"
        aria-hidden="true"
    >
        <input
            data-chat-haptic
            {...{ switch: '' }}
            tabindex="-1"
            type="checkbox"
        />
    </div>
</aside>

<style>
    .chat {
        --chat-offset: calc(var(--space-md) + var(--control-size) + 8px);
        display: none;
    }

    .chat.is-ready {
        display: block;
    }

    .chat__avatar {
        align-items: center;
        align-self: start;
        border: 2px solid var(--color-border-strong);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 700;
        grid-area: avatar;
        height: 32px;
        justify-content: center;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
        width: 32px;
    }

    .chat__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .chat__close:active {
        transform: translateY(1px);
    }

    .chat__close:focus-visible {
        outline-offset: -2px;
    }

    .chat__close:hover {
        color: var(--color-link);
    }

    .chat__launcher {
        --color-focus-ring: var(--color-focus-ring-offset);
        align-items: center;
        background: var(--color-bg-inverse);
        border: 2px solid currentColor;
        border-right: 0;
        color: var(--color-text-inverse);
        display: inline-flex;
        height: var(--control-size);
        inset: auto 0 var(--chat-offset) auto;
        justify-content: center;
        position: fixed;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .chat__launcher:active {
        transform: translateY(1px);
    }

    .chat__launcher:focus-visible {
        outline-offset: -4px;
    }

    .chat__launcher:hover {
        background: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .chat__log:focus-visible {
        outline-offset: -2px;
    }

    .chat__message {
        column-gap: 8px;
        display: grid;
        grid-template-areas:
            'avatar meta'
            'avatar body';
        grid-template-columns: 32px minmax(0, 1fr);
        row-gap: 4px;
    }

    .chat__message:has(+ .chat__message:not(.chat__message--grouped)) {
        margin-bottom: 8px;
    }

    .chat__message--grouped {
        grid-template-areas: 'avatar body';
    }

    .chat__message--grouped .chat__avatar,
    .chat__message--grouped .chat__meta {
        display: none;
    }

    .chat__window {
        background: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        box-shadow: var(--lift-shadow);
        color: var(--color-text);
        height: min(600px, calc(100dvh - var(--header-height) - var(--space-md) - var(--chat-offset)));
        inset: auto calc(var(--control-size) + var(--lift)) var(--chat-offset) auto;
        max-width: calc(100vw - var(--control-size) - var(--lift) - var(--shell-pad));
        position: fixed;
        width: var(--chat-width, min(340px, calc(100vw - var(--control-size) - 2 * var(--space-md))));
    }

    .chat__window[open] {
        display: flex;
        flex-direction: column;
    }
</style>

<script>
    import { LAUNCHER_SIZE, PALETTE, POINTER_COARSE_QUERY, WINDOW_MARGINS } from '@lib/shared/constants';
    import { ROOM_MEMBERS, closeChat, getChatState, getMessages, getOnlineCount, onChatChange, openChat, seedRoom, sendChatMessage } from '@lib/chat/chat';
    import { claimFloatWindow, formatTime, getInitials, initPanelResize, onFloatWindowClaim, registerPageScript, setText } from '@lib/shared/utils';

    const CHAT_MIN_WIDTH = 340;
    const GROUP_WINDOW_MILLISECONDS = 300_000;
    const LIVE_RESET_DELAY = 200;
    const MEMBER_COLORS = new Map<string, TileColor>(ROOM_MEMBERS.map((member, index) => [member.name, PALETTE[(index + 1) % PALETTE.length]]));
    const RECEIVE_HAPTICS_MILLISECONDS = [60, 90, 110];
    const RESIZE_LABEL = 'Resize member chat';
    const SELF_COLOR = PALETTE[PALETTE.length - 1];
    const TALLY_INTERVAL_MILLISECONDS = 60_000;

    let liveTimer: number | undefined;
    let tallyTimer: number | undefined;
    let unsubscribeChat: (() => void) | undefined;

    function buildMessage(message: ChatMessage, previous: ChatMessage | undefined) {
        const template = document.querySelector<HTMLTemplateElement>('[data-chat-message]');

        if (!template) return null;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const avatar = fragment.querySelector<HTMLElement>('[data-chat-avatar]');
        const item = fragment.querySelector<HTMLElement>('.chat__message');

        if (!avatar || !item) return null;

        const isGrouped = previous !== undefined && previous.name === message.name && message.sentAt - previous.sentAt < GROUP_WINDOW_MILLISECONDS;
        const tone = message.self ? SELF_COLOR : (MEMBER_COLORS.get(message.name) ?? SELF_COLOR);

        item.classList.toggle('chat__message--grouped', isGrouped);
        setText(avatar, getInitials(message.name));
        setText(fragment.querySelector('[data-chat-author]'), message.name);
        setText(fragment.querySelector('[data-chat-text]'), message.body);
        setText(fragment.querySelector('[data-chat-time]'), formatTime(new Date(message.sentAt)));
        avatar.style.background = tone.background;
        avatar.style.color = tone.text;

        return item;
    }

    function closeWindow() {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (dialog?.open) {
            dialog.close();

            return;
        }

        handleClose(dialog);
    }

    function handleClose(dialog: HTMLDialogElement | null) {
        const active = document.activeElement;
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');

        const isHeld = (dialog?.contains(active) ?? false) || active === document.body || active === null;

        closeChat();
        launcher?.setAttribute('aria-expanded', 'false');

        if (isHeld) launcher?.focus();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape') return;

        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');

        if (!dialog?.open) return;

        event.preventDefault();
        closeWindow();
    }

    function handleLaunch() {
        if (!getChatState().open) {
            openChat();
            openWindow(true);

            return;
        }

        closeWindow();
    }

    async function handleSubmit(event: SubmitEvent) {
        event.preventDefault();

        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');

        if (!field) return;

        const body = field.value;

        field.value = '';

        await sendChatMessage(body);
    }

    function initChat(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('.chat');
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
        const grip = document.querySelector<HTMLElement>('[data-chat-grip]');
        const launcher = document.querySelector<HTMLElement>('[data-chat-launcher]');

        if (!aside || !dialog || !form || !grip || !launcher) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        aside.classList.add('is-ready');
        unsubscribeChat?.();
        unsubscribeChat = onChatChange(render);
        signal.addEventListener('abort', teardown, { once: true });

        initPanelResize({
            handle: grip,
            label: RESIZE_LABEL,
            minWidth: CHAT_MIN_WIDTH,
            panel: dialog,
            property: '--chat-width',
            reservedRight: LAUNCHER_SIZE + WINDOW_MARGINS,
            signal,
        });

        aside.addEventListener('keydown', handleKeydown, { signal });
        dialog.addEventListener('close', () => handleClose(dialog), { signal });
        document.querySelector<HTMLElement>('[data-chat-close]')?.addEventListener('click', closeWindow, { signal });
        form.addEventListener('submit', event => void handleSubmit(event), { signal });
        launcher.addEventListener('click', handleLaunch, { signal });
        onFloatWindowClaim(dialog, closeWindow, signal);
        seedRoom();
        window.clearInterval(tallyTimer);
        tallyTimer = window.setInterval(renderTally, TALLY_INTERVAL_MILLISECONDS);

        if (!dialog.open && getChatState().open) closeChat();

        render();
    }

    function openWindow(shouldMoveFocus: boolean) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-chat-window]');
        const field = document.querySelector<HTMLInputElement>('[data-chat-field]');
        const previous = document.activeElement;

        if (!dialog || dialog.open) return;

        dialog.show();
        document.querySelector<HTMLElement>('[data-chat-launcher]')?.setAttribute('aria-expanded', 'true');
        claimFloatWindow(dialog);

        if (shouldMoveFocus) {
            const close = dialog.querySelector<HTMLElement>('[data-chat-close]');

            (window.matchMedia(POINTER_COARSE_QUERY).matches ? close : (field ?? close))?.focus();

            return;
        }

        if (previous !== document.body && previous instanceof HTMLElement) {
            previous.focus();
        } else if (document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
        }
    }

    function pulseReceive() {
        const canVibrate = typeof navigator.vibrate === 'function';
        const fallbackSwitch = document.querySelector<HTMLInputElement>('[data-chat-haptic]');

        if (!canVibrate && !fallbackSwitch) return;
        if (!window.matchMedia(POINTER_COARSE_QUERY).matches) return;
        if (document.visibilityState !== 'visible') return;
        if (navigator.userActivation?.hasBeenActive === false) return;

        if (canVibrate) {
            navigator.vibrate(RECEIVE_HAPTICS_MILLISECONDS);

            return;
        }

        fallbackSwitch?.click();
    }

    function render() {
        const log = document.querySelector<HTMLElement>('[data-chat-log]');

        renderTally();

        if (log) renderLog(log, getMessages());
    }

    function renderLog(log: HTMLElement, messages: ChatMessage[]) {
        const isStale = !log.children.length || log.children.length > messages.length;

        if (isStale) {
            log.setAttribute('aria-live', 'off');
            log.replaceChildren();
            window.clearTimeout(liveTimer);
            liveTimer = window.setTimeout(() => log.setAttribute('aria-live', 'polite'), LIVE_RESET_DELAY);
        }

        const start = log.children.length;

        const fresh = messages.slice(start);

        fresh.forEach((message, offset) => {
            const item = buildMessage(message, messages[start + offset - 1]);

            if (item) log.append(item);
        });

        if (!isStale && fresh.some(message => !message.self) && start > 0) pulseReceive();

        log.scrollTop = log.scrollHeight;
    }

    function renderTally() {
        setText(document.querySelector('[data-chat-online]'), `${getOnlineCount(Date.now())} online`);
    }

    function teardown() {
        window.clearInterval(tallyTimer);
        window.clearTimeout(liveTimer);
        unsubscribeChat?.();
        liveTimer = undefined;
        tallyTimer = undefined;
        unsubscribeChat = undefined;
    }

    registerPageScript(initChat);
</script>
