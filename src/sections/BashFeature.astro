---
import { getCollection } from 'astro:content';

import PageHead from '@components/PageHead.astro';
import { formatDate } from '@lib/utils';

const editions = (await getCollection('bash')).sort((a, b) => +b.data.date - +a.data.date);

const current = editions[0];
const past = editions.slice(1);

const assets = current?.data.assets ?? [];
---

<section
    class="ink-block overflow-hidden relative pb-24 pt-20 border-b-2 border-ink"
    aria-labelledby="bash-title"
>
    <div class="halftone--coral absolute inset-0 pointer-events-none" aria-hidden="true" />
    <div class="shell relative">
        <PageHead
            class="font-extrabold font-sans leading-[0.85] text-[clamp(60px,13.28vw,170px)] tracking-[-0.05em]"
            eyebrow={`The Producer Bash / Edition ${current?.data.edition ?? 'VII'}`}
            eyebrowClass="mb-6"
            headingId="bash-title"
            tone="dark"
        >
            Two days.<br />
            <span class="text-coral">One room.</span><br />
            Every member.
        </PageHead>
        {current && (
            <p class="reveal max-w-2xl mt-10 leading-relaxed text-[18px] text-taupe-3">
                {current.data.recap}
            </p>
        )}
        <dl class="reveal--stagger grid gap-px mt-12 border-2 border-ink-2 bg-ink-2 md:grid-cols-4">
            <div class="p-6 bg-ink">
                <dt class="label mb-2 text-taupe-3">
                    Date
                </dt>
                <dd class="font-extrabold font-sans text-2xl">
                    {current ? <time datetime={current.data.date.toISOString().slice(0, 10)}>{formatDate(current.data.date)}</time> : 'TBA'}
                </dd>
            </div>
            <div class="p-6 bg-ink">
                <dt class="label mb-2 text-taupe-3">
                    Venue
                </dt>
                <dd class="font-extrabold font-sans text-2xl">
                    The Mothership
                    <address class="mt-1 font-mono font-normal not-italic text-[12px] text-taupe-3">
                        2400 E 6th St
                    </address>
                </dd>
            </div>
            <div class="p-6 bg-ink">
                <dt class="label mb-2 text-taupe-3">
                    Producers
                </dt>
                <dd class="font-extrabold font-sans text-2xl">
                    96 on bill
                </dd>
            </div>
            <div class="p-6 bg-ink">
                <dt class="label mb-2 text-taupe-3">
                    Next edition
                </dt>
                <dd class="font-extrabold font-sans text-2xl">
                    TBA
                </dd>
            </div>
        </dl>
    </div>
</section>

{assets.length > 0 && (
    <section
        class="py-20 border-b-2 border-ink"
        aria-labelledby="press-title"
    >
        <div class="shell">
            <h2
                id="press-title"
                class="reveal mb-10 font-extrabold font-sans text-4xl tracking-tight"
            >
                Press &amp; assets
            </h2>
            <table class="reveal w-full border-2 border-ink">
                <thead>
                    <tr class="border-b-2 border-ink font-bold font-mono text-[11px] tracking-wide uppercase text-taupe">
                        <th
                            class="px-4 py-3 text-left"
                            scope="col"
                        >
                            Asset
                        </th>
                        <th
                            class="px-4 py-3 text-left"
                            scope="col"
                        >
                            Kind
                        </th>
                        <th
                            class="px-4 py-3 text-left"
                            scope="col"
                        >
                            Size
                        </th>
                        <th
                            class="px-4 py-3"
                            scope="col"
                        >
                            <span class="sr-only">Download</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink">
                    {assets.map(asset => (
                        <tr>
                            <td class="px-4 py-4 font-bold font-sans">
                                {asset.label}
                            </td>
                            <td class="px-4 py-4 font-mono text-[12px] uppercase">
                                {asset.kind}
                            </td>
                            <td class="px-4 py-4 font-mono text-[12px] text-taupe">
                                {asset.size}
                            </td>
                            <td class="px-4 py-4 text-right">
                                <a
                                    class="action-text hover:text-coral-dark transition-colors"
                                    href={asset.href}
                                >
                                    Download &rarr;
                                </a>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>
)}

<section
    class="py-20"
    aria-labelledby="editions-title"
>
    <div class="shell">
        <h2
            id="editions-title"
            class="reveal mb-10 font-extrabold font-sans text-4xl tracking-tight text-taupe"
        >
            Past editions
        </h2>
        <ul class="reveal--stagger grid gap-5 list-none lg:grid-cols-3 md:grid-cols-2">
            {past.map(edition => (
                <li>
                    <article class="card card-hover p-6">
                        <p class="label mb-2 text-coral-dark">
                            Edition {edition.data.edition} / <time datetime={edition.data.date.toISOString().slice(0, 10)}>{formatDate(edition.data.date)}</time>
                        </p>
                        <h3 class="font-extrabold font-sans text-2xl tracking-tight">
                            {edition.data.title}
                        </h3>
                        <p class="mt-3 text-[14px] text-taupe">
                            {edition.data.recap}
                        </p>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>
