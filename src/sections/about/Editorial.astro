---
import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { CANONICAL, JOIN_ROUTE, LINKS, PALETTE } from '@lib/constants';

type RoadmapStatus = 'done' | 'later' | 'next';

const ACTIONS = [
    {
        heading: 'Executive',
        headingId: 'executive-actions-title',
        items: [
            'Conduct organizer onboarding',
            'Fill all role openings',
            'Collaborate with music tech companies',
        ],
    },
    {
        heading: 'Technical',
        headingId: 'technical-actions-title',
        items: [
            'Launch the hub',
            'Build an attendee check-in system',
            'Implement the prods virtual currency',
            'Expand merchandise',
        ],
    },
];

const COMMITMENTS = [
    { description: 'advance the Alliance\'s vision through every decision', name: 'Alignment' },
    { description: 'be present and engaged at every event', name: 'Attendance' },
    { description: 'split costs equally across events, merchandise, and investments', name: 'Expenses' },
    { description: 'grow the community and forge relationships across the Austin music scene', name: 'Outreach' },
    { description: 'communicate openly and act with honesty, dedication, and respect', name: 'Professionalism' },
    { description: 'publicize APA programming and initiatives through personal and Alliance channels', name: 'Promotion' },
];

const OPENINGS = [
    { hours: 20, name: 'Lead', responsibilities: 'Joins as a full organizer with equal standing. Drives events from concept to execution and upholds every commitment.' },
    { hours: 10, name: 'Deputy', responsibilities: 'Supports the leads with events and operations. Runs auxiliary programming.' },
    { hours: 10, name: 'Media Manager', responsibilities: 'Directs APA\'s marketing across social media strategy, content creation, and distribution.' },
];

const ROADMAP: { detail: string; name: string; status: RoadmapStatus; when: string }[] = [
    {
        detail: 'Assemblies, hangouts, and bashes now run on a recurring calendar. Five more programs are written down and queued behind them.',
        name: 'Launch the flagship programs',
        status: 'done',
        when: 'Summer 2026',
    },
    {
        detail: 'Paperwork is on the desk. Nonprofit status unlocks tax-deductible sponsorship and city arts funding.',
        name: 'Register as a 501(c)(3) nonprofit',
        status: 'next',
        when: 'Summer 2026',
    },
    {
        detail: 'First applications target the Nexus and Elevate programs once the nonprofit filing clears.',
        name: 'Secure a grant',
        status: 'later',
        when: 'Fall 2026',
    },
    {
        detail: 'The long-range marker: an official APA showcase on the SXSW calendar.',
        name: 'Host an official SXSW event',
        status: 'later',
        when: 'Spring 2027',
    },
];

const ROADMAP_STATUS: Record<RoadmapStatus, string> = {
    done: 'Done',
    later: 'Later',
    next: 'Up next',
};

const SECTIONS = [
    { href: '#mission', label: 'Mission' },
    { href: '#history', label: 'History' },
    { href: '#commitments', label: 'Commitments' },
    { href: '#openings', label: 'Openings' },
    { href: '#roadmap', label: 'Roadmap' },
    { href: '#join', label: 'Join' },
];

const openingColors = PALETTE.slice(0, 3);
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="about-title"
>
    <div>
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="About / Est 2022"
            headingId="about-title"
        >
            Austin's producers, in one room.
        </PageHead>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="About details"
>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(180px,0.28fr)_minmax(0,780px)] md:justify-between">
        <aside
            class="self-start md:sticky md:top-28"
            aria-label="On this page"
        >
            <p class="label mb-3 text-ink-muted">Sections</p>
            <nav aria-label="Sections">
                <ul class="about__toc list-none text-sm">
                    {SECTIONS.map(section => (
                        <li>
                            <a
                                class="about__link hover:text-accent-deep"
                                href={section.href}
                            >
                                {section.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <div class="space-y-8 leading-[1.65] text-lmd">
            <section
                id="mission"
                aria-labelledby="mission-title"
            >
                <h2
                    id="mission-title"
                    class="mb-8 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    Mission
                </h2>
                <figure
                    class="mb-8 py-10 border-y-2 border-ink"
                    data-motion="unfold"
                >
                    <blockquote class="mb-6 font-extrabold font-sans leading-[1.15] text-2xl tracking-[-0.02em] md:text-3xl">
                        <span class="text-accent">&ldquo;</span>{CANONICAL.mission}<span class="text-accent">&rdquo;</span>
                    </blockquote>
                    <figcaption class="label text-ink-muted">Austin Producer Alliance</figcaption>
                </figure>
            </section>
            <section
                id="history"
                aria-labelledby="history-title"
            >
                <h2
                    id="history-title"
                    class="mb-3 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    History
                </h2>
                <p>{CANONICAL.history}</p>
            </section>
            <section
                id="commitments"
                aria-labelledby="commitments-title"
            >
                <h2
                    id="commitments-title"
                    class="mb-3 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    Commitments
                </h2>
                <p class="mb-5 text-ink-muted">
                    Everyone who organizes for the Alliance holds to the same six.
                </p>
                <ul
                    class="space-y-3 list-none"
                    data-motion-stagger="rise"
                >
                    {COMMITMENTS.map((commitment, index) => (
                        <li class="flex gap-4">
                            <span class="label pt-1 text-accent-deep">{String(index + 1).padStart(2, '0')}</span>
                            <span>
                                <strong class="font-bold font-sans">{commitment.name}</strong>: {commitment.description}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
            <section
                id="openings"
                aria-labelledby="openings-title"
            >
                <h2
                    id="openings-title"
                    class="mb-3 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    Openings
                </h2>
                <p class="mb-6 text-ink-muted">
                    The Alliance is run by its organizers. These are the seats we are looking to fill.
                </p>
                <ul
                    class="grid grid-cols-1 gap-5 mb-6 list-none md:grid-cols-3"
                    data-motion-stagger="flip"
                >
                    {OPENINGS.map((opening, index) => (
                        <li class="slab slab--bare slab--card slab--hover">
                            <PlaceholderTile
                                class="aspect-[4/3]"
                                color={openingColors[index]}
                                label={`${opening.hours}h`}
                                labelClass="text-[56px] text-surface-raised/80"
                            />
                            <div class="p-4">
                                <h3 class="font-extrabold font-sans tracking-tight">{opening.name}</h3>
                                <p class="mb-2 font-mono text-xs text-ink-muted">
                                    {opening.hours} hours per month
                                </p>
                                <p class="leading-relaxed text-sm">{opening.responsibilities}</p>
                            </div>
                        </li>
                    ))}
                </ul>
                <p>
                    <a
                        class="about__apply action-text hover:text-accent-deep underline underline-offset-4 transition-colors"
                        href={JOIN_ROUTE}
                    >
                        Ask about an opening &rarr;
                    </a>
                </p>
            </section>
            <section
                id="roadmap"
                aria-labelledby="roadmap-title"
            >
                <h2
                    id="roadmap-title"
                    class="mb-3 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    Roadmap
                </h2>
                <p class="mb-6 text-ink-muted">
                    The order of operations. Each milestone sets up the one after it.
                </p>
                <ol
                    class="roadmap mb-10 list-none"
                    data-motion-stagger="rise"
                >
                    {ROADMAP.map((milestone, index) => (
                        <li
                            class="roadmap__step"
                            data-status={milestone.status}
                        >
                            <div
                                class="roadmap__rail"
                                aria-hidden="true"
                            >
                                <span class="roadmap__node">{String(index + 1).padStart(2, '0')}</span>
                            </div>
                            <div class:list={[milestone.status === 'next' ? ['mark', 'slab', 'slab--well'] : ['slab', 'slab--card']]}>
                                <div class="roadmap__meta">
                                    <span class="label roadmap__when">{milestone.when}</span>
                                    <span class="label roadmap__status">{ROADMAP_STATUS[milestone.status]}</span>
                                </div>
                                <h3 class="mb-2 font-extrabold font-sans text-xl tracking-tight">{milestone.name}</h3>
                                <p class="roadmap__detail leading-relaxed text-smd">{milestone.detail}</p>
                            </div>
                        </li>
                    ))}
                </ol>
                <p class="label mb-4 text-ink-muted">Active workstreams</p>
                <div
                    class="grid grid-cols-1 gap-5 md:grid-cols-2"
                    data-motion-stagger="flip"
                >
                    {ACTIONS.map(action => (
                        <section
                            class="slab slab--card"
                            aria-labelledby={action.headingId}
                        >
                            <h3
                                id={action.headingId}
                                class="mb-3 font-extrabold font-sans text-xl tracking-tight"
                            >
                                {action.heading}
                            </h3>
                            <ul class="space-y-2 list-none text-smd text-ink-muted">
                                {action.items.map(item => (
                                    <li class="flex gap-2">
                                        <span
                                            class="font-bold text-accent-deep"
                                            aria-hidden="true"
                                        >
                                            &middot;
                                        </span>
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            </section>
            <section
                id="join"
                aria-labelledby="join-title"
            >
                <h2
                    id="join-title"
                    class="mb-3 font-extrabold font-sans text-4xl tracking-tight"
                    data-motion="strike"
                >
                    Join
                </h2>
                <p class="mb-6 text-ink-muted">
                    Organizing is one way in. Showing up is the other. The contact form carries a
                    Membership topic, and the Discord is the room where the day-to-day conversation
                    happens.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a
                        class="btn btn--primary"
                        href={JOIN_ROUTE}
                    >
                        Ask about membership
                    </a>
                    <a
                        class="btn"
                        href={LINKS.discord}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        Open the Discord
                    </a>
                </div>
            </section>
        </div>
    </div>
</section>

<style>
    .about__apply {
        align-items: center;
        display: inline-flex;
        min-height: 50px;
    }

    .about__link {
        align-items: center;
        display: inline-flex;
        min-height: 50px;
        min-width: 50px;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .about__link:active {
        transform: translateY(1px);
    }

    .roadmap {
        --roadmap-gap: var(--space-lg);
        --roadmap-node: 50px;
        display: grid;
        row-gap: var(--roadmap-gap);
    }

    .roadmap__detail {
        color: var(--color-ink-muted);
    }

    .roadmap__meta {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-sm);
        justify-content: space-between;
        margin-bottom: var(--space-sm);
    }

    .roadmap__node {
        align-items: center;
        background-color: var(--color-surface-raised);
        border: 2px solid var(--color-ink);
        color: var(--color-accent-deep);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-smd);
        font-weight: 700;
        height: var(--roadmap-node);
        justify-content: center;
        letter-spacing: 0.04em;
        line-height: 1;
        position: relative;
        width: var(--roadmap-node);
    }

    .roadmap__node::after {
        background-color: var(--color-ink);
        content: '';
        height: 2px;
        left: 100%;
        position: absolute;
        top: calc(50% - 1px);
        width: var(--space-md);
    }

    .roadmap__rail {
        display: flex;
        justify-content: center;
        position: relative;
    }

    .roadmap__status {
        align-items: center;
        border: 2px solid var(--color-ink);
        color: var(--color-ink-muted);
        display: inline-flex;
        padding: 5px 8px;
    }

    .roadmap__step {
        column-gap: var(--space-md);
        display: grid;
        grid-template-columns: var(--roadmap-node) minmax(0, 1fr);
    }

    .roadmap__step:not(:last-child) .roadmap__rail::after {
        background-color: var(--color-ink);
        bottom: calc(-1 * var(--roadmap-gap));
        content: '';
        left: calc(50% - 1px);
        position: absolute;
        top: var(--roadmap-node);
        width: 2px;
    }

    .roadmap__step[data-status='done'] .roadmap__node {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .roadmap__step[data-status='done'] .roadmap__status {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .roadmap__step[data-status='next'] .roadmap__detail {
        color: var(--color-ink-inverse-muted);
    }

    .roadmap__step[data-status='next'] .roadmap__node {
        background-color: var(--color-accent);
        color: var(--color-ink);
    }

    .roadmap__step[data-status='next'] .roadmap__status {
        background-color: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    .roadmap__step[data-status='next'] .roadmap__when {
        color: var(--color-accent);
    }

    .roadmap__step[data-status='next'] .slab--well {
        --slab-level: var(--z-card);
        --slab-line: var(--color-ink);
        --slab-rule: 2px;
    }

    .roadmap__when {
        color: var(--color-ink-muted);
    }

    @media (max-width: 768px) {
        .about__link {
            min-width: auto;
            padding-inline: var(--space-xs);
        }

        .about__link:focus-visible {
            outline-offset: -2px;
        }

        .about__toc {
            display: flex;
            gap: var(--space-sm);
            overflow-x: auto;
        }
    }
</style>
