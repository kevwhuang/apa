---
import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { CANONICAL, JOIN_ROUTE, LINKS, PALETTE } from '@lib/shared/constants';

type RoadmapStatus = 'later' | 'next';

const ACTIONS = [
    {
        heading: 'Executive',
        headingId: 'executive-actions-title',
        items: [
            'Conduct organizer onboarding',
            'Fill all role openings',
            'Collaborate with music tech companies',
        ],
    },
    {
        heading: 'Technical',
        headingId: 'technical-actions-title',
        items: [
            'Launch the hub',
            'Build an attendee check-in system',
            'Implement the Prods virtual currency',
            'Expand merchandise',
        ],
    },
];

const COMMITMENTS = [
    { description: 'advance the Alliance\'s vision through every decision', name: 'Alignment' },
    { description: 'be present and engaged at every event', name: 'Attendance' },
    { description: 'split costs equally across events, merchandise, and investments', name: 'Expenses' },
    { description: 'grow the community and forge relationships across the Austin music scene', name: 'Outreach' },
    { description: 'communicate openly and act with honesty, dedication, and respect', name: 'Professionalism' },
    { description: 'publicize APA programming and initiatives through personal and Alliance channels', name: 'Promotion' },
];

const OPENINGS = [
    { hours: 20, name: 'Lead', responsibilities: 'Joins as a full organizer with equal standing. Drives events from concept to execution and upholds every commitment.' },
    { hours: 10, name: 'Deputy', responsibilities: 'Supports the leads with events and operations. Runs auxiliary programming.' },
    { hours: 10, name: 'Media Manager', responsibilities: 'Directs APA\'s marketing across social media strategy, content creation, and distribution.' },
];

const ROADMAP: { detail: string; name: string; status: RoadmapStatus }[] = [
    {
        detail: 'Paperwork is on the desk. Nonprofit status unlocks tax-deductible sponsorship.',
        name: 'Register as a 501(c)\u2060(3) nonprofit',
        status: 'next',
    },
    {
        detail: 'Assembly, Bash, and CAMP run on a recurring calendar. Five more programs are written down and queued behind them.',
        name: 'Launch all planned events',
        status: 'later',
    },
    {
        detail: 'First applications target the Elevate program once the nonprofit filing clears.',
        name: 'Secure a grant',
        status: 'later',
    },
    {
        detail: 'The long-range marker: an official APA showcase on the SXSW calendar.',
        name: 'Host an official SXSW event',
        status: 'later',
    },
];

const ROADMAP_STATUS: Record<RoadmapStatus, string> = {
    later: 'Later',
    next: 'Up next',
};

const SECTIONS = [
    { href: '#mission', label: 'Mission' },
    { href: '#story', label: 'Story' },
    { href: '#commitments', label: 'Commitments' },
    { href: '#openings', label: 'Openings' },
    { href: '#roadmap', label: 'Roadmap' },
    { href: '#join', label: 'Join' },
];

const openingColors = PALETTE.slice(0, 3);
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="about-title"
>
    <div>
        <PageHead
            class="text-4xl md:text-6xl text-balance"
            eyebrow="Austin, TX, since 2022"
            headingId="about-title"
        >
            Austin's producers, in one room.
        </PageHead>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="About details"
>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(180px,0.28fr)_minmax(0,780px)] md:justify-between">
        <aside
            class="self-start md:sticky md:top-28"
            aria-label="On this page"
            data-motion="rise"
        >
            <p class="label mb-3 text-text-secondary">Sections</p>
            <nav aria-label="Sections">
                <ul class="about__toc list-none text-sm">
                    {SECTIONS.map(section => (
                        <li>
                            <a
                                class="about__link hover:text-link"
                                href={section.href}
                            >
                                {section.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <div class="space-y-8 leading-[1.65] text-lg">
            <section
                id="mission"
                aria-labelledby="mission-title"
            >
                <h2
                    id="mission-title"
                    class="mb-8 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Mission
                </h2>
                <figure
                    class="mb-8 py-10 border-y-2 border-border-strong"
                    data-motion="unfold"
                >
                    <blockquote class="mb-6 font-bold font-sans leading-[1.15] text-2xl tracking-[-0.02em] md:text-3xl">
                        <span class="text-text-brand">&ldquo;</span>{CANONICAL.mission}<span class="text-text-brand">&rdquo;</span>
                    </blockquote>
                    <figcaption class="label text-text-secondary">Austin Producer Alliance</figcaption>
                </figure>
            </section>
            <section
                id="story"
                aria-labelledby="story-title"
            >
                <h2
                    id="story-title"
                    class="mb-3 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Story
                </h2>
                <p data-motion="blur">{CANONICAL.story}</p>
            </section>
            <section
                id="commitments"
                aria-labelledby="commitments-title"
            >
                <h2
                    id="commitments-title"
                    class="mb-3 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Commitments
                </h2>
                <p
                    class="mb-5 text-text-secondary"
                    data-motion="blur"
                >
                    Everyone who organizes for the Alliance holds to the same six.
                </p>
                <ul
                    class="space-y-3 list-none"
                    data-motion-stagger="rise"
                >
                    {COMMITMENTS.map((commitment, index) => (
                        <li class="flex gap-4">
                            <span class="label pt-1 text-link">{String(index + 1).padStart(2, '0')}</span>
                            <span>
                                <strong class="font-bold font-sans">{commitment.name}</strong>: {commitment.description}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
            <section
                id="openings"
                aria-labelledby="openings-title"
            >
                <h2
                    id="openings-title"
                    class="mb-3 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Openings
                </h2>
                <p
                    class="mb-6 text-text-secondary"
                    data-motion="blur"
                >
                    The Alliance is run by its organizers. These are the seats we are looking to fill.
                </p>
                <ul
                    class="grid grid-cols-1 gap-5 mb-6 list-none md:grid-cols-3"
                    data-motion-stagger="flip"
                >
                    {OPENINGS.map((opening, index) => (
                        <li class="slab slab--bare slab--card slab--hover">
                            <PlaceholderTile
                                class="aspect-[4/3]"
                                color={openingColors[index].bg}
                                label={`${opening.hours}h`}
                                labelClass="text-4xl"
                                labelColor={openingColors[index].text}
                            />
                            <div class="p-4">
                                <h3>{opening.name}</h3>
                                <p class="mb-2 font-mono text-xs text-text-secondary">
                                    {opening.hours} hours per month
                                </p>
                                <p class="leading-relaxed text-sm">{opening.responsibilities}</p>
                            </div>
                        </li>
                    ))}
                </ul>
                <p data-motion="rise">
                    <a
                        class="action-text hover:text-link inline-flex items-center gap-(--space-2xs) min-h-[50px] underline underline-offset-4 transition-colors"
                        href={JOIN_ROUTE}
                    >
                        Ask about an opening <IconArrow />
                    </a>
                </p>
            </section>
            <section
                id="roadmap"
                aria-labelledby="roadmap-title"
            >
                <h2
                    id="roadmap-title"
                    class="mb-3 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Roadmap
                </h2>
                <p
                    class="mb-6 text-text-secondary"
                    data-motion="blur"
                >
                    The order of operations. Each milestone sets up the one after it.
                </p>
                <ol
                    class="roadmap mb-10 list-none"
                    data-motion-stagger="rise"
                >
                    {ROADMAP.map((milestone, index) => (
                        <li
                            class="roadmap__step grid grid-cols-[var(--roadmap-node)_minmax(0,1fr)] gap-x-(--space-md)"
                            data-status={milestone.status}
                        >
                            <div
                                class="roadmap__rail relative flex justify-center"
                                aria-hidden="true"
                            >
                                <span class="roadmap__node relative flex items-center justify-center h-(--roadmap-node) w-(--roadmap-node) border-2 border-border-strong font-mono font-bold text-sm leading-none tracking-[0.04em] bg-bg-raised text-link">{String(index + 1).padStart(2, '0')}</span>
                            </div>
                            <div class:list={[milestone.status === 'next' ? ['mark', 'slab', 'slab--well'] : ['slab', 'slab--card']]}>
                                <div class="flex mb-(--space-sm)">
                                    <span class="label roadmap__status inline-flex items-center px-(--space-2xs) py-(--space-3xs) border-2 border-border-strong text-text-secondary">{ROADMAP_STATUS[milestone.status]}</span>
                                </div>
                                <h3 class="mb-2 text-xl">{milestone.name}</h3>
                                <p class="roadmap__detail leading-relaxed text-base text-text-secondary">{milestone.detail}</p>
                            </div>
                        </li>
                    ))}
                </ol>
                <p
                    class="label mb-4 text-text-secondary"
                    data-motion="stamp"
                >
                    Active workstreams
                </p>
                <div
                    class="grid grid-cols-1 gap-5 md:grid-cols-2"
                    data-motion-stagger="flip"
                >
                    {ACTIONS.map(action => (
                        <section
                            class="slab slab--card"
                            aria-labelledby={action.headingId}
                        >
                            <h3
                                id={action.headingId}
                                class="mb-3 text-xl"
                            >
                                {action.heading}
                            </h3>
                            <ul class="space-y-2 list-none text-base text-text-secondary">
                                {action.items.map(item => (
                                    <li class="flex gap-2">
                                        <span
                                            class="font-bold text-link"
                                            aria-hidden="true"
                                        >
                                            &middot;
                                        </span>
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            </section>
            <section
                id="join"
                aria-labelledby="join-title"
            >
                <h2
                    id="join-title"
                    class="mb-3 text-2xl sm:text-3xl md:text-4xl"
                    data-motion="strike"
                >
                    Join
                </h2>
                <p
                    class="mb-6 text-text-secondary"
                    data-motion="blur"
                >
                    Organizing is one way in. Showing up is the other. The contact form carries a
                    Membership topic, and the Discord is the room where the day-to-day conversation
                    happens.
                </p>
                <div
                    class="flex flex-wrap gap-3"
                    data-motion="rise"
                >
                    <a
                        class="btn btn--primary"
                        href={JOIN_ROUTE}
                    >
                        Ask about membership
                    </a>
                    <a
                        class="btn"
                        href={LINKS.discord}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        Open the Discord
                    </a>
                </div>
            </section>
        </div>
    </div>
</section>

<style>
    .about__link {
        align-items: center;
        display: inline-flex;
        min-height: 50px;
        min-width: 50px;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .about__link:active {
        transform: translateY(1px);
    }

    .roadmap {
        --roadmap-gap: var(--space-lg);
        --roadmap-node: 50px;
        display: grid;
        row-gap: var(--roadmap-gap);
    }

    .roadmap__node::after {
        background-color: var(--color-border-strong);
        content: '';
        height: 2px;
        left: 100%;
        position: absolute;
        top: calc(50% - 1px);
        width: var(--space-md);
    }

    .roadmap__step:not(:last-child) .roadmap__rail::after {
        background-color: var(--color-border-strong);
        bottom: calc(-1 * var(--roadmap-gap));
        content: '';
        left: calc(50% - 1px);
        position: absolute;
        top: var(--roadmap-node);
        width: 2px;
    }

    .roadmap__step[data-status='next'] .roadmap__detail {
        color: var(--color-text-inverse-secondary);
    }

    .roadmap__step[data-status='next'] .roadmap__node {
        background-color: var(--color-bg-signal);
        color: var(--color-text-on-signal);
    }

    .roadmap__step[data-status='next'] .roadmap__status {
        background-color: var(--color-bg-signal);
        border-color: var(--color-border-selected);
        color: var(--color-text-on-signal);
    }

    .roadmap__step[data-status='next'] .slab--well {
        --slab-level: var(--z-card);
        --slab-line: var(--color-border-strong);
        --slab-rule: 2px;
    }

    @media (max-width: 768px) {
        .about__link {
            min-width: auto;
            padding-inline: var(--space-xs);
        }

        .about__link:focus-visible {
            outline-offset: -2px;
        }

        .about__toc {
            display: flex;
            gap: var(--space-sm);
            overflow-x: auto;
        }
    }
</style>
