---
import IconArrow from '@components/icons/Arrow.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { CANONICAL, EVENT_PROGRAMS, JOIN_ROUTE, PALETTE } from '@lib/shared/constants';

const programs = Object.values(EVENT_PROGRAMS);

const activeNames = programs.filter(program => program.state === 'active').map(program => program.name);
const plannedCount = programs.filter(program => program.state === 'planned').length;

const activePrograms = new Intl.ListFormat('en', { type: 'conjunction' }).format(activeNames);

const CLASS_ROADMAP_NODE = 'roadmap__node flex items-center justify-center relative h-(--roadmap-node) w-(--roadmap-node) border-2 border-border-strong font-bold font-mono leading-none text-sm bg-bg-raised text-link';

const COMMITMENTS = [
    { description: 'advance the Alliance\'s vision through every decision', name: 'Alignment' },
    { description: 'be present and engaged at every event', name: 'Attendance' },
    { description: 'split costs equally across events, merchandise, and investments', name: 'Expenses' },
    { description: 'grow the community and forge relationships across the Austin music scene', name: 'Outreach' },
    { description: 'communicate openly and act with honesty, dedication, and respect', name: 'Professionalism' },
    { description: 'publicize APA programming and initiatives through personal and Alliance channels', name: 'Promotion' },
];

const OPENINGS = [
    { hours: 20, name: 'Lead', responsibilities: 'Joins as a full organizer with equal standing. Drives events from concept to execution and upholds every commitment.' },
    { hours: 10, name: 'Deputy', responsibilities: 'Supports the leads with events and operations. Runs auxiliary programming.' },
    { hours: 10, name: 'Media manager', responsibilities: 'Directs APA\'s marketing across social media strategy, content creation, and distribution.' },
];

const ROADMAP: { detail: string; name: string; status: 'later' | 'next' }[] = [
    {
        detail: 'Nonprofit status will make donations to the Alliance tax-deductible.',
        name: 'Register as a 501(c)\u2060(3) nonprofit',
        status: 'next',
    },
    {
        detail: `${activePrograms} run on a recurring calendar, and ${plannedCount} more programs round out the lineup.`,
        name: 'Launch all planned events',
        status: 'later',
    },
    {
        detail: 'Grant funding helps the Alliance grow its programs.',
        name: 'Secure a grant',
        status: 'later',
    },
    {
        detail: 'The long-term goal is an official APA showcase on the SXSW calendar.',
        name: 'Host an official SXSW event',
        status: 'later',
    },
];

const SECTIONS = [
    { label: 'Mission', target: 'mission-title' },
    { label: 'Story', target: 'story-title' },
    { label: 'Commitments', target: 'commitments-title' },
    { label: 'Openings', target: 'openings-title' },
    { label: 'Roadmap', target: 'roadmap-title' },
];

const openingColors = PALETTE.slice(0, OPENINGS.length);
---

<section
    class="stage stage--tight"
    aria-labelledby="about-title"
>
    <h1
        id="about-title"
        class="sr-only"
    >
        About
    </h1>
    <div class="grid grid-cols-[160px_minmax(0,1fr)] gap-12 max-md:grid-cols-1">
        <aside
            class="self-start sticky top-[calc(var(--header-height)+var(--space-md))] max-md:static"
            aria-label="On this page"
            data-motion="rise"
        >
            <nav aria-label="Sections">
                <ul class="max-md:flex max-md:gap-4 max-md:overflow-x-auto">
                    {SECTIONS.map(section => (
                        <li>
                            <button
                                class="about__link label hover:text-link"
                                data-jump={section.target}
                                type="button"
                            >
                                {section.label}
                            </button>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <div class="flex flex-col gap-(--space-2xl) text-lg">
            <section
                class="scroll-mt-[calc(var(--header-height)+var(--space-md))]"
                aria-labelledby="mission-title"
            >
                <SectionHead
                    class="text-2xl-4xl"
                    headingId="mission-title"
                >
                    Mission
                </SectionHead>
                <figure
                    class="py-10 border-border-strong border-y-2"
                    data-motion="unfold"
                >
                    <blockquote class="mb-6 font-bold leading-(--text-3xl-4xl) text-2xl-3xl text-pretty tracking-tight">
                        <span class="text-text-brand">&ldquo;</span>{CANONICAL.mission}<span class="text-text-brand">&rdquo;</span>
                    </blockquote>
                    <figcaption class="font-mono text-base text-right text-text-secondary">
                        <span class="inline-block h-0.5 w-6 align-middle bg-current" aria-hidden="true" /> Austin Producer Alliance
                    </figcaption>
                </figure>
            </section>
            <section
                class="scroll-mt-[calc(var(--header-height)+var(--space-md))]"
                aria-labelledby="story-title"
            >
                <SectionHead
                    class="text-2xl-4xl"
                    headingId="story-title"
                >
                    Story
                </SectionHead>
                <p data-motion="blur">{CANONICAL.story}</p>
            </section>
            <section
                class="scroll-mt-[calc(var(--header-height)+var(--space-md))]"
                aria-labelledby="commitments-title"
            >
                <SectionHead
                    class="text-xl-4xl"
                    headingId="commitments-title"
                >
                    Commitments
                </SectionHead>
                <p
                    class="mb-10 text-text-secondary"
                    data-motion="blur"
                >
                    Everyone who organizes for the Alliance holds to the same six.
                </p>
                <ul
                    class="space-y-4 list-none text-pretty"
                    data-motion-stagger="rise"
                >
                    {COMMITMENTS.map(commitment => (
                        <li>
                            <strong class="font-bold">{commitment.name}</strong>: {commitment.description}
                        </li>
                    ))}
                </ul>
            </section>
            <section
                class="scroll-mt-[calc(var(--header-height)+var(--space-md))]"
                aria-labelledby="openings-title"
            >
                <SectionHead
                    class="text-2xl-4xl"
                    headingId="openings-title"
                >
                    Openings
                </SectionHead>
                <p
                    class="mb-10 text-text-secondary"
                    data-motion="blur"
                >
                    The Alliance is run by its organizers. These are the seats we are looking to fill.
                </p>
                <ul
                    class="grid grid-cols-3 gap-x-(--space-lg) gap-y-(--space-2xl) mb-8 list-none max-lg:grid-cols-2 max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))]"
                    data-motion-stagger="flip"
                >
                    {OPENINGS.map((opening, index) => (
                        <li class="slab slab--bare slab--card">
                            <PlaceholderTile
                                class="aspect-4/3"
                                color={openingColors[index].background}
                            />
                            <div class="p-(--space-md)">
                                <h3 class="mb-1 text-base">{opening.name}</h3>
                                <p class="mb-2 font-mono text-base text-text-secondary">
                                    {opening.hours} hours per month
                                </p>
                                <p class="text-base">{opening.responsibilities}</p>
                            </div>
                        </li>
                    ))}
                </ul>
                <p data-motion="rise">
                    <a
                        class="action-text inline-flex items-center min-h-(--control-size) gap-2 underline underline-offset-4"
                        href={JOIN_ROUTE}
                    >
                        Ask about an opening <IconArrow />
                    </a>
                </p>
            </section>
            <section
                class="scroll-mt-[calc(var(--header-height)+var(--space-md))]"
                aria-labelledby="roadmap-title"
            >
                <SectionHead
                    class="text-2xl-4xl"
                    headingId="roadmap-title"
                >
                    Roadmap
                </SectionHead>
                <p
                    class="mb-10 text-text-secondary"
                    data-motion="blur"
                >
                    These milestones are in order, and each one sets up the next.
                </p>
                <ol
                    class="roadmap grid gap-y-(--roadmap-gap) list-none"
                    data-motion-stagger="rise"
                >
                    {ROADMAP.map((milestone, index) => (
                        <li
                            class="roadmap__step grid grid-cols-[var(--roadmap-node)_minmax(0,1fr)] gap-x-(--space-md)"
                            data-status={milestone.status}
                        >
                            <div
                                class="roadmap__rail flex justify-center relative"
                                aria-hidden="true"
                            >
                                <span class={CLASS_ROADMAP_NODE}>{index + 1}</span>
                            </div>
                            <div class:list={milestone.status === 'next' ? ['mark', 'slab', 'slab--well'] : ['slab', 'slab--card']}>
                                <h3 class="mb-2 text-xl">{milestone.name}</h3>
                                <p class="roadmap__detail text-base text-text-secondary">{milestone.detail}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </section>
        </div>
    </div>
</section>

<style>
    .about__link {
        align-items: center;
        display: inline-flex;
        min-height: var(--control-size);
        min-width: var(--control-size);
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .about__link:active {
        transform: translateY(1px);
    }

    .roadmap {
        --roadmap-gap: var(--space-2xl);
        --roadmap-node: 48px;
    }

    .roadmap__node::after {
        background-color: var(--color-border-strong);
        content: '';
        height: 2px;
        left: 100%;
        position: absolute;
        top: calc(50% - 1px);
        width: var(--space-md);
    }

    .roadmap__step:not(:last-child) .roadmap__rail::after {
        background-color: var(--color-border-strong);
        bottom: calc(-1 * var(--roadmap-gap));
        content: '';
        left: calc(50% - 1px);
        position: absolute;
        top: var(--roadmap-node);
        width: 2px;
    }

    .roadmap__step[data-status='next'] .roadmap__detail {
        color: var(--color-text-inverse-secondary);
    }

    .roadmap__step[data-status='next'] .roadmap__node {
        background-color: var(--color-signal);
        color: var(--color-text-on-signal);
    }

    .roadmap__step[data-status='next'] .slab--well {
        --slab-level: var(--z-card);
        --slab-line: var(--color-border-strong);
        --slab-rule: 2px;
    }

    @media (max-width: 768px) {
        .about__link {
            min-width: auto;
            padding-inline: 12px;
        }

        .about__link:focus-visible {
            outline-offset: -2px;
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/shared/utils';

    function handleJump(button: HTMLButtonElement) {
        const heading = document.getElementById(button.dataset.jump ?? '');

        heading?.closest('section')?.scrollIntoView({ behavior: 'instant', block: 'start' });
    }

    function initAbout(signal: AbortSignal) {
        document.querySelectorAll<HTMLButtonElement>('[data-jump]').forEach((button) => {
            button.addEventListener('click', () => handleJump(button), { signal });
        });
    }

    registerPageScript(initAbout);
</script>
