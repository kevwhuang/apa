---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import ProgramFlyer from '@components/program/Flyer.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { EVENT_PROGRAMS, LINKS, SECOND_ENTRY } from '@lib/shared/constants';
import {
    formatCalendarDay,
    formatCalendarMonth,
    formatDate,
    formatEntry,
    formatTimeRange,
    formatWeekday,
    getProgram,
    isUpcoming,
    mapWorkshopLines,
    mergeCalendar,
} from '@lib/shared/utils';

const PAGE_INDEX = [
    { href: '#assembly-title', label: 'Assembly' },
    { href: '#bash-title', label: 'Bash' },
    { href: '#camp-title', label: 'CAMP' },
    { href: '#hangout-title', label: 'Hangout' },
    { href: '#past-title', label: 'Archive' },
    { href: '#planned-title', label: 'Planned' },
] as const;

const bashEditions = await getCollection('bash');
const events = await getCollection('events');

const assemblyProgram = getProgram('assembly');
const bashProgram = getProgram('bash');
const campProgram = getProgram('camp');
const programs = Object.values(EVENT_PROGRAMS);

const { past, upcoming } = mergeCalendar(events, bashEditions);
const planned = programs.filter(program => program.state === 'planned');

const upcomingBashes = bashEditions
    .filter(edition => isUpcoming(edition.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);

const workshopById = mapWorkshopLines(events.filter(event => event.data.type === 'assembly'));

const archive = [...past, ...upcoming].sort((a, b) => +b.date - +a.date);
const assemblies = upcoming.filter(event => event.type === 'assembly');
const hangouts = upcoming.filter(event => event.type === 'hangout');

const laterAssemblies = assemblies.slice(1);
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="programs-title"
>
    <div>
        <PageHead
            class="max-w-4xl mb-6 text-6xl md:text-7xl"
            eyebrow="Events"
            headingId="programs-title"
        >
            What we run.
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lg text-text-secondary"
            data-motion="blur"
        >
            Our programs run on a fixed cadence, each with its own shape and its own room.
            Below is the working calendar: every upcoming date with its hours, the programs
            still on paper, and the archive of every date already run.
        </p>
        <nav
            class="flex flex-wrap gap-3"
            aria-label="On this page"
            data-motion="rise"
        >
            {PAGE_INDEX.map(item => (
                <a
                    class="chip active:bg-bg-inverse active:text-text-inverse hover:bg-bg-inverse hover:text-text-inverse"
                    href={item.href}
                >
                    {item.label}
                </a>
            ))}
        </nav>
    </div>
</section>

<section
    class="stage stage--assembly stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-title"
>
    <div>
        <SectionHead
            class="text-4xl md:text-5xl"
            eyebrow={`${assemblyProgram.shortName}, ${assemblyProgram.cadence}`}
            headingId="assembly-title"
        >
            {assemblyProgram.name}.
        </SectionHead>
        <p
            class="max-w-2xl mb-10 leading-relaxed text-lg text-text-secondary"
            data-motion="rise"
        >
            {assemblyProgram.summary}
        </p>
        <div
            class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-(--space-2xl)"
            data-motion="rise"
        >
            <a
                class="btn"
                href="/assembly"
            >
                About the {assemblyProgram.name}
            </a>
            <a
                class="action-text hover:text-link inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 transition-colors"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                target="_blank"
            >
                RSVP for {assemblyProgram.shortName} on Meetup <IconArrow />
                <span class="sr-only">&nbsp;(opens in a new tab)</span>
            </a>
        </div>
        {assemblies.map((event, index) => (
            <div
                class:list={['mark', index < laterAssemblies.length && 'mb-(--space-2xl)']}
                data-event-end={event.end.toISOString()}
                data-event-group="events-assembly"
                data-event-role="next"
                hidden={index > 0}
            >
                <article
                    id={index === 0 ? event.id : undefined}
                    class="sheet slab slab--bare slab--card"
                    data-event-id={event.id}
                >
                    <p
                        class="sheet__plate"
                        data-motion="stamp"
                    >
                        <span class="label sheet__tag px-2 py-1 bg-bg-signal text-text-on-signal">
                            Next {assemblyProgram.shortName}
                        </span>
                        <time
                            class="contents"
                            datetime={event.date.toISOString()}
                        >
                            <span class="sheet__day font-bold font-display leading-[0.8] text-8xl tracking-[-0.02em]">{formatCalendarDay(event.date)}</span>
                            <span class="font-mono leading-normal text-sm tracking-[0.06em] whitespace-nowrap">{formatCalendarMonth(event.date)}</span>
                        </time>
                        <span class="font-mono text-xs tracking-[0.06em] text-event-assembly-text">{formatWeekday(event.date)}</span>
                    </p>
                    <div
                        class="p-(--space-lg)"
                        data-motion="rise"
                    >
                        <p class="label mb-4 text-text-secondary">
                            Entry {formatEntry(1)} of <span data-event-total>{formatEntry(assemblies.length)}</span>
                        </p>
                        <hgroup class="flex flex-col gap-1 mb-3">
                            <h3 class="text-2xl">{event.title}</h3>
                            {workshopById.has(event.id) && (
                                <p class="font-bold font-sans text-base">{workshopById.get(event.id)}</p>
                            )}
                        </hgroup>
                        <p class="mb-1 font-mono text-xs text-text-secondary">
                            {formatTimeRange(event.date, event.end)}
                        </p>
                        <address class="mb-4 font-mono not-italic text-xs text-text-secondary">
                            {event.location}
                        </address>
                        <p class="max-w-2xl leading-relaxed text-text-secondary">{event.excerpt}</p>
                    </div>
                </article>
            </div>
        ))}
        {laterAssemblies.length > 0 && (
            <div
                class="docket"
                data-event-group="events-assembly"
                data-event-role="many"
            >
                <div
                    class="docket__heads"
                    aria-hidden="true"
                    data-motion-stagger="stamp"
                >
                    <p class="label pb-(--space-2xs) text-text-secondary">No.</p>
                    <p class="label pb-(--space-2xs) text-text-secondary">Date</p>
                    <p class="docket__head--session label pb-(--space-2xs) text-text-secondary">Session</p>
                    <p class="docket__head--room label pb-(--space-2xs) text-text-secondary">Room</p>
                </div>
                <hr
                    class="col-span-full h-0.5 border-0 bg-border-strong"
                    data-motion="rule"
                />
                <ul
                    class="docket__rows gap-y-0 list-none"
                    aria-label={`Later ${assemblyProgram.name} dates`}
                    data-motion-stagger="rise"
                >
                    {laterAssemblies.map((event, index) => (
                        <li
                            id={event.id}
                            class="docket__row"
                            data-event-end={event.end.toISOString()}
                            data-event-group="events-assembly"
                            data-event-id={event.id}
                            data-event-role="later"
                        >
                            <p
                                class="docket__no font-mono tabular-nums text-base text-text-secondary"
                                data-event-rank
                            >
                                {formatEntry(index + SECOND_ENTRY)}
                            </p>
                            <p class="docket__date flex flex-col gap-1">
                                <time
                                    class="font-bold font-sans text-base"
                                    datetime={event.date.toISOString()}
                                >
                                    {formatDate(event.date)}
                                </time>
                                <span class="font-mono text-xs text-text-secondary">
                                    {formatTimeRange(event.date, event.end)}
                                </span>
                            </p>
                            <hgroup class="docket__session flex flex-col gap-1">
                                <h3 class="text-base">{event.title}</h3>
                                {workshopById.has(event.id) && (
                                    <p class="font-bold font-sans text-sm">{workshopById.get(event.id)}</p>
                                )}
                            </hgroup>
                            <address class="docket__room font-mono not-italic text-xs text-text-secondary">
                                {event.location}
                            </address>
                        </li>
                    ))}
                </ul>
            </div>
        )}
        <p
            class="mark slab slab--card max-w-(--measure-form) w-full mx-auto leading-relaxed text-text-secondary"
            data-event-group="events-assembly"
            data-event-role="none"
            data-motion="rise"
            hidden={assemblies.length > 0}
        >
            No {assemblyProgram.name} on the calendar right now &mdash; the next date goes up here and on Meetup as soon as the room is booked.
        </p>
    </div>
</section>

<section
    class="stage stage--bash stage--tight border-b-2 border-border-strong"
    aria-labelledby="bash-title"
>
    <div
        class="bash-well fold slab slab--well stage__item--runoff"
        data-motion="wipe"
    >
        <div
            class="absolute inset-0 overflow-clip pointer-events-none"
            aria-hidden="true"
        >
            <div
                class="halftone--accent absolute -inset-y-[8%] inset-x-0"
                data-scrub="drift"
            />
        </div>
        <div class="relative">
            <SectionHead
                class="text-4xl md:text-5xl"
                eyebrow={`${bashProgram.shortName}, ${bashProgram.cadence}`}
                headingId="bash-title"
                tone="dark"
            >
                {bashProgram.name}.
            </SectionHead>
            <p
                class="max-w-xl mb-10 leading-relaxed text-lg text-text-inverse-secondary"
                data-motion="rise"
            >
                {bashProgram.summary}
            </p>
            <div
                class="flex flex-wrap items-center gap-6"
                data-motion="rise"
            >
                <a
                    class="btn btn--accent"
                    href="/bash"
                >
                    Everything about the {bashProgram.name} <IconArrow />
                </a>
                <a
                    class="action-text hover:text-link-on-inverse inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 text-text-inverse transition-colors"
                    href={LINKS.meetup}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    RSVP on Meetup <IconArrow />
                </a>
            </div>
        </div>
    </div>
    {upcomingBashes.length > 0 && (
        <ul
            class="slab slab--cut slab--lift list-none"
            data-event-group="events-bash"
            data-event-role="some"
            data-motion-stagger="rise"
        >
            {upcomingBashes.map(edition => (
                <li
                    id={edition.id}
                    class="rank last:border-b-0 items-baseline py-4 border-b-2 border-border-strong"
                    data-event-end={edition.data.end.toISOString()}
                    data-event-group="events-bash"
                    data-event-id={edition.id}
                    data-event-role="upcoming"
                >
                    <p class="flex flex-col gap-1 font-bold font-sans text-xl">
                        <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                        <span class="font-mono text-xs text-text-secondary">
                            {formatTimeRange(edition.data.date, edition.data.end)}
                        </span>
                    </p>
                    <div>
                        <h3 class="mb-2 text-2xl">{edition.data.title}</h3>
                        <address class="mb-3 font-mono not-italic text-xs text-text-secondary">
                            {edition.data.location}
                        </address>
                        <p class="max-w-2xl leading-relaxed text-text-secondary">{edition.data.recap}</p>
                    </div>
                </li>
            ))}
        </ul>
    )}
    <p
        class="slab slab--cut slab--lift max-w-(--measure-form) w-full mx-auto leading-relaxed text-text-secondary"
        data-event-group="events-bash"
        data-event-role="none"
        data-motion="rise"
        hidden={upcomingBashes.length > 0}
    >
        No edition on the calendar right now &mdash; the next date goes up here and on Meetup as soon as the room is booked.
    </p>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="camp-title"
>
    <div>
        <SectionHead
            class="text-4xl md:text-5xl"
            eyebrow={`${campProgram.shortName}, ${campProgram.cadence}`}
            headingId="camp-title"
        >
            {campProgram.name}.
        </SectionHead>
        <p
            class="max-w-2xl leading-relaxed text-lg text-text-secondary"
            data-motion="rise"
        >
            {campProgram.summary}
        </p>
    </div>
    <p
        class="slab slab--cut slab--lift max-w-(--measure-form) w-full mx-auto leading-relaxed text-text-secondary"
        data-motion="rise"
    >
        No {campProgram.name} on the calendar right now &mdash; the next date goes up here and on Meetup as soon as it is booked.
    </p>
</section>

<ProgramFlyer
    class="border-b-2 border-border-strong"
    detailed
    events={hangouts}
    headingId="hangout-title"
    tight
/>

<section
    class="slab--sunk stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="past-title"
>
    <div>
        <SectionHead
            class="text-4xl text-balance"
            eyebrow={`Archive, ${past.length} events`}
            headingId="past-title"
        >
            Already run, still on file.
        </SectionHead>
        <ul
            class="archive-grid list-none"
            data-event-tally="past-title"
            data-motion-stagger="rise"
        >
            {archive.map(event => (
                <li
                    class="tilt"
                    data-event-end={event.end.toISOString()}
                    data-event-role="past"
                    hidden={isUpcoming(event.end)}
                >
                    <article
                        id={isUpcoming(event.end) ? undefined : event.id}
                        class="archive-card slab slab--bare slab--card"
                        data-event-id={event.id}
                        data-program={event.type}
                    >
                        <p class="archive-card__stamp">
                            <time
                                class="contents"
                                datetime={event.date.toISOString()}
                            >
                                <span class="font-bold font-display leading-none text-3xl tracking-[-0.02em]">{formatCalendarDay(event.date)}</span>
                                <span class="font-mono text-xs tracking-[0.06em] whitespace-nowrap">{formatCalendarMonth(event.date)}</span>
                            </time>
                        </p>
                        <div class="archive-card__body">
                            <p class="label mb-2 text-text-secondary">
                                {getProgram(event.type).shortName}, {formatTimeRange(event.date, event.end)}
                            </p>
                            <hgroup class="flex flex-col gap-1 mb-2">
                                <h3 class="text-lg">{event.title}</h3>
                                {workshopById.has(event.id) && (
                                    <p class="font-bold font-sans text-sm">{workshopById.get(event.id)}</p>
                                )}
                            </hgroup>
                            <address class="mb-3 font-mono not-italic text-xs text-text-secondary">
                                {event.location}
                            </address>
                            <p class="leading-relaxed text-sm text-text-secondary">{event.excerpt}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="planned-title"
>
    <div>
        <SectionHead
            class="text-4xl text-balance"
            eyebrow="Planned"
            headingId="planned-title"
        >
            Written down, not yet dated.
        </SectionHead>
        <ul
            class="grid grid-cols-1 gap-6 list-none lg:grid-cols-3 md:grid-cols-2"
            data-motion-stagger="flip"
        >
            {planned.map(program => (
                <li class="p-5 border-2 border-dashed border-border">
                    <p class="label mb-3 text-text-secondary">{program.cadence}</p>
                    <h3 class="mb-2 text-lg">{program.name}</h3>
                    <p class="text-sm text-text-secondary">{program.summary}</p>
                </li>
            ))}
        </ul>
    </div>
</section>

<Schedule />

<style>
    .archive-card {
        display: grid;
        grid-row: span 4;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .archive-card:target {
        outline: 2px solid var(--color-border-selected);
        outline-offset: 2px;
    }

    .archive-card[data-program='assembly'] .archive-card__stamp {
        background: var(--color-event-assembly);
        color: var(--color-event-assembly-text);
    }

    .archive-card[data-program='bash'] .archive-card__stamp {
        background: var(--color-event-bash);
        color: var(--color-event-bash-text);
    }

    .archive-card__body {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding: var(--space-sm) var(--space-md) var(--space-md);
    }

    .archive-card__stamp {
        align-items: center;
        border-right: 2px solid var(--color-border-strong);
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        grid-row: span 4;
        justify-content: center;
        min-width: calc(var(--text-3xl) * 2.5);
        padding: var(--space-sm) var(--space-xs);
        text-align: center;
    }

    .archive-grid {
        --drift-step: 2;
        column-gap: var(--space-md);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-md));
        row-gap: 0;
    }

    .archive-grid > li {
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding-bottom: var(--space-md);
    }

    .archive-grid > li:nth-child(even of :not([hidden])) {
        --drift-x: -1;
    }

    .archive-grid > li:nth-child(odd of :not([hidden])) {
        --drift-x: 1;
    }

    .docket {
        --docket-no: 48px;
        column-gap: var(--space-md);
        display: grid;
        grid-template-columns: var(--docket-no) minmax(0, 0.95fr) minmax(0, 1.3fr) minmax(0, 1fr);
        position: relative;
        row-gap: 0;
    }

    .docket::before {
        background: var(--color-border-strong);
        content: '';
        inset-block: 0;
        inset-inline-start: calc(var(--docket-no) + var(--space-md) / 2 - 1px);
        position: absolute;
        width: 2px;
    }

    .docket__heads,
    .docket__row,
    .docket__rows {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
    }

    .docket__row {
        align-items: baseline;
        padding-block: var(--space-sm);
    }

    .docket__row:not([hidden]) ~ .docket__row {
        border-top: 1px solid var(--color-border-subtle);
    }

    .docket__row:target {
        outline: 2px solid var(--color-border-selected);
        outline-offset: 2px;
    }

    .sheet {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        overflow: clip;
    }

    .sheet:target {
        outline: 2px solid var(--color-border-selected);
        outline-offset: 2px;
    }

    .sheet__plate {
        align-content: center;
        background: var(--color-event-assembly);
        color: var(--color-event-assembly-text);
        display: grid;
        gap: var(--space-2xs);
        justify-items: start;
        padding: var(--space-lg);
    }

    @media (max-width: 1024px) {
        .archive-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .docket {
            grid-template-columns: var(--docket-no) minmax(0, 1fr) minmax(0, 1.25fr);
        }

        .docket__date {
            grid-column: 2;
            grid-row: span 2;
        }

        .docket__head--room {
            display: none;
        }

        .docket__no {
            grid-column: 1;
            grid-row: span 2;
        }

        .docket__room {
            grid-column: 3;
            grid-row: 2;
            padding-top: var(--space-3xs);
        }

        .docket__row {
            align-items: start;
        }

        .docket__session {
            grid-column: 3;
            grid-row: 1;
        }
    }

    @media (max-width: 768px) {
        .archive-card {
            grid-template-columns: minmax(0, 1fr);
        }

        .archive-card,
        .archive-grid > li {
            grid-row: span 5;
        }

        .archive-card__stamp {
            border-bottom: 2px solid var(--color-border-strong);
            border-right: 0;
            flex-direction: row;
            gap: var(--space-xs);
            grid-row: span 1;
            justify-content: flex-start;
            min-width: 0;
            padding: var(--space-2xs) var(--space-sm);
        }

        .archive-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .docket {
            --docket-no: 34px;
            column-gap: var(--space-sm);
            grid-template-columns: var(--docket-no) minmax(0, 1fr);
        }

        .docket::before {
            inset-inline-start: calc(var(--docket-no) + var(--space-sm) / 2 - 1px);
        }

        .docket__date {
            grid-column: 2;
            grid-row: 1;
        }

        .docket__head--session {
            display: none;
        }

        .docket__no {
            grid-row: span 3;
        }

        .docket__room {
            grid-column: 2;
            grid-row: 3;
        }

        .docket__session {
            grid-column: 2;
            grid-row: 2;
            padding-top: var(--space-3xs);
        }

        .sheet {
            grid-template-columns: minmax(0, 1fr);
        }

        .sheet__day {
            grid-row: span 2;
        }

        .sheet__plate {
            align-content: start;
            column-gap: var(--space-sm);
            grid-template-columns: auto minmax(0, 1fr);
            padding: var(--space-md);
        }

        .sheet__tag {
            grid-column: 1 / -1;
        }
    }
</style>
