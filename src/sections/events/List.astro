---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import ProgramFlyer from '@components/program/Flyer.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { EVENT_PROGRAMS, LINKS } from '@lib/shared/constants';
import { formatCalendarDay, formatCalendarMonth, formatDate, formatTimeRange, formatWeekday, getProgram, mergeCalendar } from '@lib/shared/utils';

type CalendarItem = ReturnType<typeof mergeCalendar>['upcoming'][number];

const PAGE_INDEX = [
    { href: '#assembly-title', label: 'Assembly' },
    { href: '#bash-title', label: 'Bash' },
    { href: '#hangout-title', label: 'Hangout' },
    { href: '#past-title', label: 'Archive' },
    { href: '#planned-title', label: 'Planned' },
] as const;

const assemblyProgram = getProgram('assembly');

const bashEditions = await getCollection('bash');

const bashProgram = getProgram('bash');

const events = await getCollection('events');

const endById = new Map<string, Date>(
    [...events, ...bashEditions].map(entry => [entry.id, entry.data.end] as const),
);

const { past, upcoming } = mergeCalendar(events, bashEditions);

const pastEvents = withEnd(past);

const programs = Object.values(EVENT_PROGRAMS);

const planned = programs.filter(program => program.state === 'planned');

const upcomingBashes = bashEditions
    .filter(edition => edition.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);

const upcomingEvents = withEnd(upcoming);

const assemblies = upcomingEvents.filter(event => event.type === 'assembly');
const hangouts = upcomingEvents.filter(event => event.type === 'hangout');

const [nextAssembly, ...laterAssemblies] = assemblies;

function entryNumber(value: number) {
    return String(value).padStart(2, '0');
}

function withEnd(list: CalendarItem[]) {
    return list.map(event => ({ ...event, end: endById.get(event.id) ?? event.date }));
}
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="programs-title"
>
    <div>
        <PageHead
            class="max-w-4xl mb-6 font-extrabold font-sans leading-[0.9] text-6xl tracking-[-0.04em] md:text-8xl"
            eyebrow="Events"
            headingId="programs-title"
        >
            What we run.
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lmd text-ink-muted"
            data-motion="blur"
        >
            Three programs run on a fixed cadence, each with its own shape and its own room.
            Below is the working calendar: every upcoming date with its hours, the programs
            still on paper, and the archive of every date already run.
        </p>
        <nav
            class="flex flex-wrap gap-3"
            aria-label="On this page"
            data-motion="rise"
        >
            {PAGE_INDEX.map(item => (
                <a
                    class="chip active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                    href={item.href}
                >
                    {item.label}
                </a>
            ))}
        </nav>
    </div>
</section>

<section
    class="stage stage--assembly stage--tight border-b-2 border-ink"
    aria-labelledby="assembly-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow={`${assemblyProgram.shortName} / ${assemblyProgram.cadence}`}
            headingId="assembly-title"
        >
            {assemblyProgram.name}.
        </SectionHead>
        <p
            class="max-w-2xl mb-10 leading-relaxed text-md text-ink-muted"
            data-motion="rise"
        >
            {assemblyProgram.summary}
        </p>
        <div
            class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-(--space-2xl)"
            data-motion="rise"
        >
            <a
                class="btn"
                href="/assembly"
            >
                About the {assemblyProgram.name}
            </a>
            <a
                class="action-text hover:text-accent-deep inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 transition-colors"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                target="_blank"
            >
                RSVP for {assemblyProgram.shortName} on Meetup <IconArrow />
                <span class="sr-only">&nbsp;(opens in a new tab)</span>
            </a>
        </div>
        {nextAssembly
            ? (
                    <Fragment>
                        <div class:list={['mark', laterAssemblies.length > 0 && 'mb-(--space-2xl)']}>
                            <article
                                id={nextAssembly.id}
                                class="sheet slab slab--bare slab--card"
                            >
                                <p
                                    class="sheet__plate"
                                    data-motion="stamp"
                                    data-placeholder
                                >
                                    <span class="label sheet__tag px-2 py-1 bg-accent text-ink">
                                        Next {assemblyProgram.shortName}
                                    </span>
                                    <time
                                        class="contents"
                                        datetime={nextAssembly.date.toISOString()}
                                    >
                                        <span class="sheet__day">{formatCalendarDay(nextAssembly.date)}</span>
                                        <span class="font-mono leading-normal text-sm tracking-[0.08em] uppercase whitespace-nowrap">{formatCalendarMonth(nextAssembly.date)}</span>
                                    </time>
                                    <span class="font-mono text-2xs tracking-[0.06em] uppercase text-ink-inverse-muted">{formatWeekday(nextAssembly.date)}</span>
                                </p>
                                <div
                                    class="p-(--space-lg)"
                                    data-motion="rise"
                                >
                                    <p class="label mb-4 text-ink-subtle">
                                        Entry {entryNumber(1)} / {entryNumber(assemblies.length)}
                                    </p>
                                    <h3 class="mb-3 font-extrabold font-sans text-2xl tracking-tight">{nextAssembly.title}</h3>
                                    <p
                                        class="mb-1 font-mono text-xs uppercase text-ink-muted"
                                        data-placeholder
                                    >
                                        {formatTimeRange(nextAssembly.date, nextAssembly.end)}
                                    </p>
                                    <address class="mb-4 font-mono not-italic text-xs uppercase text-ink-muted">
                                        {nextAssembly.location}
                                    </address>
                                    <p class="max-w-2xl leading-relaxed text-ink-muted">{nextAssembly.excerpt}</p>
                                </div>
                            </article>
                        </div>
                        {laterAssemblies.length > 0 && (
                            <div class="docket">
                                <div
                                    class="docket__heads"
                                    aria-hidden="true"
                                    data-motion-stagger="stamp"
                                >
                                    <p class="label pb-(--space-2xs) text-ink-subtle">No.</p>
                                    <p class="label pb-(--space-2xs) text-ink-subtle">Date</p>
                                    <p class="docket__head--session label pb-(--space-2xs) text-ink-subtle">Session</p>
                                    <p class="docket__head--room label pb-(--space-2xs) text-ink-subtle">Room</p>
                                </div>
                                <hr
                                    class="col-span-full h-0.5 border-0 bg-ink"
                                    data-motion="rule"
                                />
                                <ul
                                    class="docket__rows gap-y-0 list-none"
                                    aria-label={`Later ${assemblyProgram.name} dates`}
                                    data-motion-stagger="rise"
                                >
                                    {laterAssemblies.map((event, index) => (
                                        <li
                                            id={event.id}
                                            class="docket__row"
                                        >
                                            <p class="docket__no font-mono tabular-nums text-base text-ink-subtle">{entryNumber(index + 2)}</p>
                                            <p
                                                class="docket__date flex flex-col gap-1"
                                                data-placeholder
                                            >
                                                <time
                                                    class="font-bold font-sans text-base"
                                                    datetime={event.date.toISOString()}
                                                >
                                                    {formatDate(event.date)}
                                                </time>
                                                <span class="font-mono text-xs uppercase text-ink-muted">
                                                    {formatTimeRange(event.date, event.end)}
                                                </span>
                                            </p>
                                            <h3 class="docket__session font-bold font-sans text-base tracking-tight">{event.title}</h3>
                                            <address class="docket__room font-mono not-italic text-xs uppercase text-ink-muted">
                                                {event.location}
                                            </address>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </Fragment>
                )
            : (
                    <p
                        class="mark slab slab--card max-w-(--measure-form) w-full mx-auto leading-relaxed text-ink-muted"
                        data-motion="rise"
                    >
                        No {assemblyProgram.name} on the calendar right now &mdash; the next date goes up here and on Meetup as soon as the room is booked.
                    </p>
                )}
    </div>
</section>

<section
    class="stage stage--bash stage--tight border-b-2 border-ink"
    aria-labelledby="bash-title"
>
    <div
        class="bash-well fold slab slab--well stage__item--runoff"
        data-motion="wipe"
    >
        <div
            class="absolute inset-0 overflow-clip pointer-events-none"
            aria-hidden="true"
        >
            <div
                class="halftone--accent absolute -inset-y-[8%] inset-x-0"
                data-scrub="drift"
            />
        </div>
        <div class="relative">
            <SectionHead
                class="font-extrabold font-sans text-5xl tracking-tight"
                eyebrow={`${bashProgram.shortName} / ${bashProgram.cadence}`}
                headingId="bash-title"
                tone="dark"
            >
                {bashProgram.name}.
            </SectionHead>
            <p
                class="max-w-xl mb-10 leading-relaxed text-md text-ink-inverse-muted"
                data-motion="rise"
            >
                {bashProgram.summary}
            </p>
            <div
                class="flex flex-wrap items-center gap-6"
                data-motion="rise"
            >
                <a
                    class="btn btn--accent"
                    href="/bash"
                >
                    Everything about the {bashProgram.name} <IconArrow />
                </a>
                <a
                    class="action-text hover:text-accent inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 text-ink-inverse transition-colors"
                    href={LINKS.meetup}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    RSVP on Meetup <IconArrow />
                </a>
            </div>
        </div>
    </div>
    {upcomingBashes.length > 0
        ? (
                <ul
                    class="slab slab--cut slab--lift list-none"
                    data-motion-stagger="rise"
                >
                    {upcomingBashes.map(edition => (
                        <li
                            id={edition.id}
                            class="rank last:border-b-0 items-baseline py-4 border-b-2 border-ink"
                        >
                            <p
                                class="flex flex-col gap-1 font-extrabold font-sans text-xl"
                                data-placeholder
                            >
                                <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                                <span class="font-mono text-xs uppercase text-ink-muted">
                                    {formatTimeRange(edition.data.date, edition.data.end)}
                                </span>
                            </p>
                            <div>
                                <h3 class="mb-2 font-extrabold font-sans text-2xl tracking-tight">{edition.data.title}</h3>
                                <address class="mb-3 font-mono not-italic text-xs uppercase text-ink-muted">
                                    {edition.data.location}
                                </address>
                                <p class="max-w-2xl leading-relaxed text-ink-muted">{edition.data.recap}</p>
                            </div>
                        </li>
                    ))}
                </ul>
            )
        : (
                <p
                    class="slab slab--cut slab--lift max-w-(--measure-form) w-full mx-auto leading-relaxed text-ink-muted"
                    data-motion="rise"
                >
                    No edition on the calendar right now &mdash; the next date goes up here and on Meetup as soon as the room is booked.
                </p>
            )}
</section>

<ProgramFlyer
    class="border-b-2 border-ink"
    detailed
    events={hangouts}
    headingId="hangout-title"
    tight
/>

<section
    class="slab--sunk stage stage--tight border-b-2 border-ink"
    aria-labelledby="past-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`Archive / ${pastEvents.length} on file`}
            headingId="past-title"
        >
            Already run, still on file.
        </SectionHead>
        <ul
            class="archive-grid list-none"
            data-motion-stagger="rise"
        >
            {pastEvents.map(event => (
                <li class="tilt">
                    <article
                        id={event.id}
                        class="archive-card slab slab--bare slab--card"
                        data-program={event.type}
                    >
                        <p
                            class="archive-card__stamp"
                            data-placeholder
                        >
                            <time
                                class="contents"
                                datetime={event.date.toISOString()}
                            >
                                <span class="font-extrabold font-sans leading-none text-3xl tracking-[-0.02em]">{formatCalendarDay(event.date)}</span>
                                <span class="font-mono text-2xs tracking-[0.06em] uppercase whitespace-nowrap">{formatCalendarMonth(event.date)}</span>
                            </time>
                        </p>
                        <div class="archive-card__body">
                            <p
                                class="label mb-2 text-ink-muted"
                                data-placeholder
                            >
                                {getProgram(event.type).shortName} / {formatTimeRange(event.date, event.end)}
                            </p>
                            <h3 class="mb-2 font-extrabold font-sans text-lg tracking-tight">{event.title}</h3>
                            <address class="mb-3 font-mono not-italic text-xs uppercase text-ink-muted">
                                {event.location}
                            </address>
                            <p class="leading-relaxed text-sm text-ink-muted">{event.excerpt}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="planned-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow="Planned"
            headingId="planned-title"
        >
            Written down, not yet dated.
        </SectionHead>
        <ul
            class="grid grid-cols-1 gap-6 list-none lg:grid-cols-3 md:grid-cols-2"
            data-motion-stagger="flip"
        >
            {planned.map(program => (
                <li class="p-5 border-2 border-dashed border-ink-subtle">
                    <p class="label mb-3 text-ink-muted">{program.cadence}</p>
                    <h3 class="mb-2 font-bold font-sans text-lg tracking-tight">{program.name}</h3>
                    <p class="text-sm text-ink-muted">{program.summary}</p>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .archive-card {
        display: grid;
        grid-row: span 4;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .archive-card:target {
        outline: 2px solid var(--color-accent-deep);
        outline-offset: 3px;
    }

    .archive-card[data-program='assembly'] .archive-card__stamp {
        background: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .archive-card[data-program='bash'] .archive-card__stamp {
        background: var(--color-accent);
    }

    .archive-card[data-program='hangout'] .archive-card__stamp {
        background: var(--color-surface-sunken);
    }

    .archive-card__body {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding: var(--space-sm) var(--space-md) var(--space-md);
    }

    .archive-card__stamp {
        align-items: center;
        border-right: 2px solid var(--color-ink);
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        grid-row: span 4;
        justify-content: center;
        min-width: 92px;
        padding: var(--space-sm) var(--space-xs);
        text-align: center;
    }

    .archive-grid {
        --drift-step: 2;
        column-gap: var(--space-md);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-md));
        row-gap: 0;
    }

    .archive-grid > li {
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding-bottom: var(--space-md);
    }

    .bash-well {
        padding-block: var(--space-2xl);
        padding-inline: max(var(--shell-pad), calc(100% - var(--shell-inner))) 0;
    }

    .docket {
        --docket-no: 48px;
        column-gap: var(--space-md);
        display: grid;
        grid-template-columns: var(--docket-no) minmax(0, 0.95fr) minmax(0, 1.3fr) minmax(0, 1fr);
        position: relative;
        row-gap: 0;
    }

    .docket::before {
        background: var(--color-ink);
        content: '';
        inset-block: 0;
        inset-inline-start: calc(var(--docket-no) + var(--space-md) / 2 - 1px);
        position: absolute;
        width: 2px;
    }

    .docket__heads,
    .docket__row,
    .docket__rows {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
    }

    .docket__row {
        align-items: baseline;
        padding-block: var(--space-sm);
    }

    .docket__row + .docket__row {
        border-top: 1px solid var(--color-ink-20);
    }

    .docket__row:target {
        outline: 2px solid var(--color-accent-deep);
        outline-offset: 3px;
    }

    .sheet {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        overflow: clip;
    }

    .sheet:target {
        outline: 2px solid var(--color-accent-deep);
        outline-offset: 3px;
    }

    .sheet__day {
        font-family: var(--font-sans);
        font-size: clamp(56px, calc(34.667px + 6.6667vw), 120px);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 0.8;
    }

    .sheet__plate {
        align-content: center;
        background: var(--color-ink);
        color: var(--color-ink-inverse);
        display: grid;
        gap: var(--space-2xs);
        justify-items: start;
        padding: var(--space-lg);
    }

    @media (max-width: 1024px) {
        .archive-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .docket {
            grid-template-columns: var(--docket-no) minmax(0, 1fr) minmax(0, 1.25fr);
        }

        .docket__date {
            grid-column: 2;
            grid-row: span 2;
        }

        .docket__head--room {
            display: none;
        }

        .docket__no {
            grid-column: 1;
            grid-row: span 2;
        }

        .docket__room {
            grid-column: 3;
            grid-row: 2;
            padding-top: var(--space-3xs);
        }

        .docket__row {
            align-items: start;
        }

        .docket__session {
            grid-column: 3;
            grid-row: 1;
        }
    }

    @media (max-width: 768px) {
        .archive-card {
            grid-template-columns: minmax(0, 1fr);
        }

        .archive-card,
        .archive-grid > li {
            grid-row: span 5;
        }

        .archive-card__stamp {
            border-bottom: 2px solid var(--color-ink);
            border-right: 0;
            flex-direction: row;
            gap: var(--space-xs);
            grid-row: span 1;
            justify-content: flex-start;
            min-width: 0;
            padding: var(--space-2xs) var(--space-sm);
        }

        .archive-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .docket {
            --docket-no: 34px;
            column-gap: var(--space-sm);
            grid-template-columns: var(--docket-no) minmax(0, 1fr);
        }

        .docket::before {
            inset-inline-start: calc(var(--docket-no) + var(--space-sm) / 2 - 1px);
        }

        .docket__date {
            grid-column: 2;
            grid-row: 1;
        }

        .docket__head--session {
            display: none;
        }

        .docket__no {
            grid-row: span 3;
        }

        .docket__room {
            grid-column: 2;
            grid-row: 3;
        }

        .docket__session {
            grid-column: 2;
            grid-row: 2;
            padding-top: var(--space-3xs);
        }

        .sheet {
            grid-template-columns: minmax(0, 1fr);
        }

        .sheet__day {
            grid-row: span 2;
        }

        .sheet__plate {
            align-content: start;
            column-gap: var(--space-sm);
            grid-template-columns: auto minmax(0, 1fr);
            padding: var(--space-md);
        }

        .sheet__tag {
            grid-column: 1 / -1;
        }
    }
</style>
