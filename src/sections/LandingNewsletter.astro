---
import SectionHead from '@components/SectionHead.astro';
---

<section
    class="py-24"
    aria-labelledby="newsletter-title"
>
    <div class="shell">
        <div class="crop-marks reveal grid items-end overflow-hidden relative gap-10 p-12 border-2 border-ink bg-cream md:grid-cols-[1.2fr_1fr] md:p-16">
            <div
                class="halftone absolute inset-0 pointer-events-none"
                aria-hidden="true"
            />
            <div class="relative">
                <SectionHead
                    class="font-extrabold font-sans leading-[1.05] text-4xl tracking-[-0.03em] md:text-5xl"
                    eyebrow="Signal"
                    eyebrowClass="mb-4"
                    headingId="newsletter-title"
                >
                    Get the dispatch.
                </SectionHead>
                <p class="max-w-md text-taupe">
                    One email a month. Upcoming cookups, free sample packs from members, drop dates.
                </p>
            </div>
            <form class="newsletter-form flex flex-col relative gap-3">
                <div class="flex items-end gap-2">
                    <label class="block flex-1">
                        <span class="label block mb-2 text-taupe">
                            Email
                        </span>
                        <input
                            class="disabled:cursor-not-allowed disabled:opacity-55 placeholder:text-taupe h-12 w-full px-4 border-2 border-ink font-mono text-[13px] bg-sand"
                            autocomplete="email"
                            name="email"
                            placeholder="you@studio.fm"
                            required
                            type="email"
                        />
                    </label>
                    <button
                        class="btn btn--coral h-12"
                        type="submit"
                    >
                        Subscribe
                    </button>
                </div>
                <p
                    class="action-text hidden p-3 bg-coral text-ink"
                    data-output
                    role="status"
                >
                    Demo only &mdash; no address was stored.
                </p>
            </form>
        </div>
    </div>
</section>

<script>
    let newsletterController: AbortController | undefined;

    function handleNewsletterSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const button = form.querySelector<HTMLButtonElement>('button');
        const input = form.querySelector<HTMLInputElement>('input');
        const output = form.querySelector<HTMLElement>('[data-output]');

        if (!button || !input || !output) return;

        button.disabled = true;
        input.disabled = true;
        output.classList.remove('hidden');
    }

    function initNewsletter() {
        newsletterController?.abort();
        newsletterController = new AbortController();

        const { signal } = newsletterController;

        const form = document.querySelector<HTMLFormElement>('.newsletter-form');

        if (!form) return;

        form.addEventListener('submit', event => handleNewsletterSubmit(event, form), { signal });
    }

    document.addEventListener('astro:page-load', initNewsletter);
</script>
