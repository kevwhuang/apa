---
import PageHead from '@components/PageHead.astro';
import { LINKS } from '@lib/utils';

const ASSETS = [
    { kind: 'svg', label: 'APA wordmark, light', size: '14 KB' },
    { kind: 'svg', label: 'APA wordmark, dark', size: '14 KB' },
    { kind: 'svg', label: 'APA monogram', size: '6 KB' },
    { kind: 'pdf', label: 'Brand guidelines', size: '2.4 MB' },
    { kind: 'zip', label: 'Founder photos', size: '38 MB' },
    { kind: 'zip', label: 'Producer Bash photo pack', size: '184 MB' },
];

const QUOTES = [
    { quote: 'The most important music room in Austin most people have never heard of.', source: 'The Eastside Ledger' },
    { quote: 'A working studio that doubles as a city-wide producer co-op.', source: 'Lone Star Frequency' },
    { quote: 'They aren\'t a label, but they\'ve quietly built the strongest beat scene in the South.', source: 'Station Austin' },
];
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="media-title"
>
    <div class="shell">
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Press &amp; media"
            headingId="media-title"
        >
            Press kit.
        </PageHead>
        <p class="reveal max-w-2xl mt-6 text-[18px] text-taupe">
            Wordmarks, photography, founder bios, and recent coverage. Email
            <a
                class="hover:text-coral-dark decoration-2 decoration-coral underline underline-offset-4 wrap-anywhere transition-colors"
                href={`mailto:${LINKS.pressEmail}`}
            >
                {LINKS.pressEmail}
            </a>
            for interviews and embargoed materials.
        </p>
    </div>
</section>

<section
    class="py-16 border-b-2 border-ink"
    aria-labelledby="assets-title"
>
    <div class="shell">
        <h2
            id="assets-title"
            class="reveal mb-8 font-extrabold font-sans text-3xl tracking-tight"
        >
            Brand assets
        </h2>
        <table class="reveal table-fixed w-full border-2 border-ink">
            <thead>
                <tr class="border-b-2 border-ink font-bold font-mono text-[11px] tracking-wide uppercase text-taupe">
                    <th
                        class="px-4 py-3 text-left"
                        scope="col"
                    >
                        Asset
                    </th>
                    <th
                        class="px-4 py-3 text-left"
                        scope="col"
                    >
                        Format
                    </th>
                    <th
                        class="px-4 py-3 text-left"
                        scope="col"
                    >
                        Size
                    </th>
                    <th
                        class="px-4 py-3 text-right"
                        scope="col"
                    >
                        Download
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-ink">
                {ASSETS.map(asset => (
                    <tr>
                        <td class="px-4 py-4 font-bold font-sans">{asset.label}</td>
                        <td class="px-4 py-4 font-mono text-[12px] uppercase">{asset.kind}</td>
                        <td class="px-4 py-4 font-mono text-[12px] text-taupe">{asset.size}</td>
                        <td class="px-4 py-4 font-mono text-[12px] text-right text-taupe">pending</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>

<section
    class="py-16"
    aria-labelledby="quotes-title"
>
    <div class="shell">
        <h2
            id="quotes-title"
            class="reveal mb-8 font-extrabold font-sans text-3xl tracking-tight"
        >
            Quoted
        </h2>
        <ul class="reveal--stagger grid gap-5 list-none md:grid-cols-3">
            {QUOTES.map(({ quote, source }) => (
                <li>
                    <figure class="card card-hover h-full p-8">
                        <blockquote class="font-extrabold font-sans leading-snug text-2xl tracking-tight">
                            <span class="text-coral">&ldquo;</span>{quote}<span class="text-coral">&rdquo;</span>
                        </blockquote>
                        <figcaption class="label mt-6 text-taupe">&mdash; {source}</figcaption>
                    </figure>
                </li>
            ))}
        </ul>
    </div>
</section>
