---
import { getCollection } from 'astro:content';
import { formatPrice, PALETTE } from '@lib/utils';

const cardColors = PALETTE.slice(0, 6);
const cats = ['all', 'apparel', 'accessory', 'print'] as const;
const products = await getCollection('products');
---

<section
    class="pt-20 pb-12 border-b-2 border-ink"
    aria-label="Merch catalog"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <p class="label mb-4 text-coral reveal">SHOP / {products.length} ITEMS</p>
        <h1 class="font-sans font-extrabold tracking-[-0.04em] text-5xl md:text-7xl leading-[0.9] reveal" style="transition-delay: 0.08s;">
            Wear the alliance.
        </h1>
        <div id="cat-filter" class="mt-10 flex flex-wrap gap-2" aria-label="Filter by category" role="group">
            {cats.map((c, i) => (
                <button class={`cat-btn px-3 h-8 font-mono text-[11px] font-bold uppercase tracking-wide border-2 border-ink ${i === 0 ? 'filter-on' : 'hover:bg-ink hover:text-sand'} transition-colors`} aria-pressed={i === 0 ? 'true' : 'false'} data-cat={c}>{c}</button>
            ))}
        </div>
    </div>
</section>

<section
    class="py-16"
    aria-label="Product grid"
>
    <div id="product-grid" class="max-w-[1400px] mx-auto px-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-10 reveal--stagger">
        {products.map((p, i) => (
            <a
                class="product-card block group"
                data-cat={p.data.category}
                href={`/merch/${p.data.slug}`}
            >
                <div
                    class="aspect-square border-2 border-ink relative overflow-hidden flex items-center justify-center card-hover"
                    style={`background: ${cardColors[i % cardColors.length]}; box-shadow: var(--shadow-card-sm);`}
                >
                    <div class="absolute inset-0 halftone"></div>
                    <span class="font-sans font-extrabold text-4xl text-white/80 mix-blend-overlay select-none uppercase tracking-tight">{p.data.title.split(' ')[0]}</span>
                </div>
                <div class="mt-4">
                    <p class="label text-ink-soft">{p.data.category}</p>
                    <div class="mt-1 flex items-baseline justify-between gap-3">
                        <h2 class="font-sans font-bold tracking-tight">{p.data.title}</h2>
                        <p class="font-mono text-[13px] font-bold">{formatPrice(p.data.priceCents)}</p>
                    </div>
                </div>
            </a>
        ))}
    </div>
</section>

<script>
    import { applyFilter, rovingFocus } from '@/lib/utils';

    const buttons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');

    let activeCat = 'all';

    function apply() {
        applyFilter(buttons, cards, activeCat, 'cat', (card, category) => category === 'all' || card.dataset.cat === category);
    }

    rovingFocus(buttons);

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            activeCat = btn.dataset.cat ?? 'all';
            apply();
        });
    });
</script>
