---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import Schedule from '@components/program/Schedule.astro';
import { AVATAR, GENRES, ONBOARDING_STEPS, PROFILE_FIELDS, PROFILE_ROLES, TOUR_STOPS, US_STATES } from '@lib/shared/constants';
import { AVATAR_EXTENSIONS_OR_LIST } from '@lib/account/images';
import { formatBytes, formatDateStamp, formatRole, formatVenue, isUpcoming } from '@lib/shared/utils';

const ACCOUNT_BENEFITS = [
    { blurb: 'Prods are the Alliance\'s participation currency. You earn them by showing up and taking part, and each one takes $1 off at checkout.', label: 'Prods' },
    { blurb: 'Your card on the roster shows your portrait, role, city, genres, and links, plus a Spotlight track anyone can play.', label: 'The directory' },
    { blurb: 'Queue a demo for the next Assembly or drop a finished track for the Bash, and each one earns Prods.', label: 'Submissions' },
    { blurb: 'The resource library holds the Alliance sample pack, the brand guide, and the logo and press kits, plus what is coming soon.', label: 'Resources' },
    { blurb: 'The store sells apparel, accessories, audio, and tickets, and every order stays in one list.', label: 'The store' },
    { blurb: 'The track player, member chat, and the AI assistant follow you from page to page.', label: 'The docks' },
    { blurb: 'Settings lists every event you have attended and every Prod you have earned or spent, with a running balance beside each one.', label: 'Histories' },
    { blurb: 'One email a season with what is on the calendar and where to find us next, sent to your account address if you opt in at check-in.', label: 'The dispatch' },
];

const CLASS_GENRE_CHIP = 'label inline-flex items-center h-6 px-2 border-2 border-border-strong';
const DEFAULT_CITY = 'Austin';
const DEFAULT_ROLE = 'fan';
const DEFAULT_STATE = 'TX';

const WELCOME_LINKS = [
    { blurb: 'Apparel, accessories, audio, tickets, and what your Prods buy.', href: '/store', label: 'Store' },
    { blurb: 'How the Alliance works and who keeps it running.', href: '/about', label: 'About' },
];

const events = await getCollection('events');

const assemblies = events
    .filter(event => event.data.type === 'assembly' && isUpcoming(event.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="onboarding-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-4xl text-7xl max-md:text-4xl"
            headingId="onboarding-title"
        >
            Welcome in
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            That link signed you in. Three short steps follow: the basics, what the account is
            for, and a look around. Then your card is on the roster.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Onboarding"
>
    <div
        class="slab slab--card flex flex-col items-start max-w-(--measure-form) w-full gap-4 mx-auto"
        data-onboarding-surface="expired"
        hidden
    >
        <h2 class="font-display text-3xl text-balance">
            This link no longer works
        </h2>
        <p class="max-w-2xl text-lg text-text-secondary">
            Welcome links last 24 hours. Checking in again sends a fresh one.
        </p>
        <a
            class="btn btn--primary"
            href="/here"
        >
            Check in again <IconArrow />
        </a>
    </div>
    <div
        class="grid grid-cols-[160px_minmax(0,1fr)] items-start gap-x-12 gap-y-(--space-lg) max-md:grid-cols-1"
        data-onboarding-surface="flow"
    >
        <div class="onboarding__aside">
            <div>
                <p
                    id="onboarding-progress-label"
                    class="label mb-4 text-text-secondary"
                >
                    Progress
                </p>
                <ol
                    class="onboarding-rail list-none"
                    aria-labelledby="onboarding-progress-label"
                    data-motion="rise"
                >
                    {ONBOARDING_STEPS.map((step, index) => (
                        <li
                            class="onboarding-rail__step grid grid-cols-[var(--rail-node)_minmax(0,1fr)] items-center relative gap-x-(--space-sm) max-md:bg-bg-page max-md:p-(--space-xs)"
                            aria-current={index === 0 ? 'step' : undefined}
                            data-onboarding-step={index}
                        >
                            <span
                                class="onboarding-rail__node"
                                aria-hidden="true"
                            >
                                <span class="onboarding-rail__index">{index + 1}</span>
                                <span class="onboarding-rail__check">&check;</span>
                            </span>
                            <span class="label onboarding-rail__name min-w-0 text-text-secondary">{step.name}</span>
                        </li>
                    ))}
                </ol>
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-onboarding-announce
                />
            </div>
        </div>
        <form
            class="onboarding-form slab slab--card flex flex-col gap-6"
            data-motion="unfold"
            data-onboarding-form
        >
            <fieldset
                class="flex flex-col min-w-0 gap-(--space-lg)"
                data-onboarding-pane="0"
            >
                <legend class="mb-(--space-xs) font-bold font-display leading-none text-2xl tracking-[-0.02em] max-md:text-xl">
                    The basics
                </legend>
                <p class="font-mono text-base wrap-anywhere">
                    <span class="sr-only">Signed in as&#32;</span><span data-onboarding-email />
                </p>
                <article
                    class="slab slab--bare slab--card overflow-clip max-w-xs w-full mx-auto"
                    aria-label="Roster preview"
                >
                    <PlaceholderTile
                        class="onboarding-preview__tile aspect-square"
                        color="var(--color-ink)"
                        data-motion="wipe"
                        label="??"
                        labelClass="onboarding-preview__initials leading-none text-6xl"
                        labelColor="var(--color-text-inverse-secondary)"
                    >
                        <img
                            class="absolute inset-0 object-cover h-full w-full"
                            alt=""
                            data-preview-avatar
                            hidden
                        />
                        <p
                            class="label absolute left-0 top-0 p-(--space-xs) border-b-2 border-border-strong border-r-2 bg-bg-page text-text"
                            data-preview-role
                        >
                            {formatRole(DEFAULT_ROLE)}
                        </p>
                    </PlaceholderTile>
                    <div class="p-(--space-md)">
                        <h2
                            class="data-empty:text-text-secondary mb-3 text-2xl text-balance wrap-break-word"
                            data-empty
                            data-preview-name
                        >
                            Your artist name
                        </h2>
                        <p
                            class="onboarding-preview__location mb-6 font-mono text-base wrap-anywhere text-text-secondary"
                            data-preview-location
                        >
                            Austin, TX
                        </p>
                        <ul
                            class="flex flex-wrap gap-2 list-none"
                            data-preview-genres
                        />
                    </div>
                </article>
                <div class="flex flex-col gap-(--space-2xs)">
                    <p class="label text-text-secondary">{PROFILE_FIELDS.portrait.label}</p>
                    <div class="flex flex-wrap items-center gap-(--space-md)">
                        <label class="halftone onboarding__pick">
                            <span class="label">{PROFILE_FIELDS.portrait.picker}</span>
                            <input
                                id="onboarding-portrait"
                                class="onboarding__file sr-only"
                                accept={AVATAR.acceptAttribute}
                                aria-describedby="onboarding-portrait-error onboarding-portrait-help"
                                aria-invalid="false"
                                data-portrait-input
                                name="portrait"
                                type="file"
                            />
                        </label>
                        <button
                            class="action-text hover:text-link flex items-center min-h-(--control-size) px-1 text-text-secondary transition-[color,transform]"
                            aria-label="Remove portrait"
                            data-portrait-remove
                            hidden
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                    <p
                        id="onboarding-portrait-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                    <p
                        id="onboarding-portrait-help"
                        class="text-base text-text-secondary"
                    >
                        {AVATAR_EXTENSIONS_OR_LIST}. Up to {formatBytes(AVATAR.maxFileBytes)}, at least {AVATAR.minEdgePixels}px on each side.
                    </p>
                </div>
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">{PROFILE_FIELDS.artistName.label}</span>
                        <input
                            id="onboarding-artist-name"
                            class="input font-sans"
                            aria-describedby="onboarding-artist-name-error"
                            aria-invalid="false"
                            autocomplete={PROFILE_FIELDS.artistName.autocomplete}
                            maxlength={PROFILE_FIELDS.artistName.maxLength}
                            name="artistName"
                            type="text"
                        />
                    </label>
                    <p
                        id="onboarding-artist-name-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <fieldset class="flex flex-col gap-(--space-2xs)">
                    <legend class="label mb-(--space-2xs) text-text-secondary">
                        {PROFILE_FIELDS.genres.label}
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {GENRES.map(genre => (
                            <label class="onboarding__chip">
                                <input
                                    class="box"
                                    name="genres"
                                    type="checkbox"
                                    value={genre}
                                />
                                {genre}
                            </label>
                        ))}
                    </div>
                </fieldset>
                <fieldset class="flex flex-col gap-(--space-2xs)">
                    <legend class="label mb-(--space-2xs) text-text-secondary">
                        {PROFILE_FIELDS.role.label} <span class="text-text-secondary">({PROFILE_FIELDS.role.qualifier})</span>
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {PROFILE_ROLES.map(role => (
                            <label class="onboarding__chip">
                                <input
                                    class="box"
                                    checked={role.id === DEFAULT_ROLE}
                                    name="role"
                                    type="radio"
                                    value={role.id}
                                />
                                {role.label}
                            </label>
                        ))}
                    </div>
                </fieldset>
                <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                    <div class="flex flex-col gap-(--space-2xs)">
                        <label class="flex flex-col gap-(--space-2xs)">
                            <span class="label text-text-secondary">{PROFILE_FIELDS.city.label}</span>
                            <input
                                id="onboarding-city"
                                class="input font-sans"
                                aria-describedby="onboarding-city-error"
                                aria-invalid="false"
                                autocomplete={PROFILE_FIELDS.city.autocomplete}
                                name="city"
                                required={PROFILE_FIELDS.city.required}
                                type="text"
                                value={DEFAULT_CITY}
                            />
                        </label>
                        <p
                            id="onboarding-city-error"
                            class="text-error-text"
                            data-field-error
                            hidden
                        />
                    </div>
                    <div class="flex flex-col gap-(--space-2xs)">
                        <label class="flex flex-col gap-(--space-2xs)">
                            <span class="label text-text-secondary">{PROFILE_FIELDS.state.label}</span>
                            <span class="select">
                                <select
                                    id="onboarding-state"
                                    class="input font-sans"
                                    aria-describedby="onboarding-state-error"
                                    aria-invalid="false"
                                    autocomplete={PROFILE_FIELDS.state.autocomplete}
                                    name="state"
                                    required={PROFILE_FIELDS.state.required}
                                >
                                    {US_STATES.map(state => (
                                        <option
                                            selected={state.code === DEFAULT_STATE}
                                            value={state.code}
                                        >
                                            {state.name}
                                        </option>
                                    ))}
                                </select>
                            </span>
                        </label>
                        <p
                            id="onboarding-state-error"
                            class="text-error-text"
                            data-field-error
                            hidden
                        />
                    </div>
                </div>
            </fieldset>
            <fieldset
                class="flex flex-col gap-6"
                data-onboarding-pane="1"
                hidden
            >
                <legend
                    class="mb-6 font-bold font-display leading-none text-2xl tracking-[-0.02em] max-md:text-xl"
                    tabindex="-1"
                >
                    Why an account
                </legend>
                <ul
                    class="onboarding-benefits slab slab--bare slab--card mb-(--lift) list-none"
                    data-onboarding-reveal
                >
                    {ACCOUNT_BENEFITS.map(benefit => (
                        <li class="onboarding-benefits__cell flex flex-col min-w-0 gap-(--space-2xs) p-(--space-md)">
                            <p class="font-bold font-sans leading-(--text-xl) text-lg tracking-tight">{benefit.label}</p>
                            <p class="text-base wrap-anywhere">{benefit.blurb}</p>
                        </li>
                    ))}
                </ul>
            </fieldset>
            <fieldset
                class="flex flex-col gap-6"
                data-onboarding-pane="2"
                hidden
            >
                <legend
                    class="mb-6 font-bold font-display leading-none text-2xl tracking-[-0.02em] max-md:text-xl"
                    tabindex="-1"
                >
                    Take the tour
                </legend>
                <div
                    class="onboarding-tour slab slab--well mb-(--space-md)"
                    data-onboarding-reveal
                >
                    <p class="font-bold font-sans leading-(--text-xl) text-lg tracking-tight">{TOUR_STOPS.length} things you reach for most</p>
                    <ol class="grid border-border-inverse-subtle border-y-2 list-none">
                        {TOUR_STOPS.map((stop, index) => (
                            <li class="onboarding-tour__stop grid grid-cols-[auto_minmax(0,1fr)] gap-x-(--space-sm) py-(--space-xs)">
                                <span
                                    class="label onboarding-tour__index shrink-0 text-link-on-inverse"
                                    aria-hidden="true"
                                >
                                    {index + 1}
                                </span>
                                <span class="flex flex-col min-w-0 gap-(--space-3xs)">
                                    <span class="font-bold font-sans leading-(--text-base) text-base tracking-tight">{stop.name}</span>
                                    <span class="text-base wrap-anywhere text-text-inverse-secondary">{stop.blurb}</span>
                                </span>
                            </li>
                        ))}
                    </ol>
                    <button
                        class="btn btn--accent self-start"
                        data-onboarding-tour
                        type="button"
                    >
                        Start tour <IconArrow />
                    </button>
                </div>
                <p class="font-bold font-sans leading-(--text-xl) text-lg tracking-tight">Or go straight there</p>
                <ul class="grid gap-(--space-md) list-none">
                    {assemblies.map((assembly, index) => (
                        <li
                            class="grid"
                            data-event-end={assembly.data.end.toISOString()}
                            data-event-group="onboarding"
                            data-event-role="next"
                            hidden={index > 0}
                        >
                            <a
                                class="onboarding-next__line slab slab--card slab--still mb-(--lift)"
                                href="/assemblies"
                            >
                                <span class="flex items-center justify-between gap-(--space-sm)">
                                    <span class="font-mono text-base underline underline-offset-4">Next Assembly</span>
                                    <span
                                        class="onboarding-next__arrow"
                                        aria-hidden="true"
                                    >
                                        <IconArrow />
                                    </span>
                                </span>
                                <span class="text-base wrap-anywhere text-text-secondary">
                                    <time datetime={assembly.data.date.toISOString()}>{formatDateStamp(assembly.data.date)}</time> at {formatVenue(assembly.data.location)}. Come say hi.
                                </span>
                            </a>
                        </li>
                    ))}
                    {WELCOME_LINKS.map(link => (
                        <li class="grid">
                            <a
                                class="onboarding-next__line slab slab--card slab--still mb-(--lift)"
                                href={link.href}
                            >
                                <span class="flex items-center justify-between gap-(--space-sm)">
                                    <span class="font-mono text-base underline underline-offset-4">{link.label}</span>
                                    <span
                                        class="onboarding-next__arrow"
                                        aria-hidden="true"
                                    >
                                        <IconArrow />
                                    </span>
                                </span>
                                <span class="text-base wrap-anywhere text-text-secondary">{link.blurb}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </fieldset>
            <div class="flex flex-wrap items-center gap-(--space-sm) pt-(--space-md) border-border-strong border-t-2">
                <button
                    class="btn"
                    data-onboarding-back
                    hidden
                    type="button"
                >
                    <IconArrow left /> Back
                </button>
                <button
                    class="btn btn--primary"
                    data-onboarding-next
                    type="submit"
                >
                    <span data-onboarding-next-label>Continue</span> <IconArrow />
                </button>
            </div>
        </form>
    </div>
    <template data-preview-chip>
        <li
            class={CLASS_GENRE_CHIP}
            data-preview-genre
        />
    </template>
</section>

<Schedule />

<style>
    .onboarding-benefits {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .onboarding-benefits__cell:not(:nth-child(-n + 2)) {
        border-top: 2px solid var(--color-border-strong);
    }

    .onboarding-benefits__cell:nth-child(odd) {
        border-right: 2px solid var(--color-border-strong);
    }

    .onboarding-form {
        margin-inline: auto;
        max-width: var(--measure-form);
        padding: var(--space-lg);
        width: 100%;
    }

    .onboarding-next__arrow {
        color: var(--color-link);
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        line-height: 1;
        transition: translate var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding-next__line {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-base) var(--motion-ease-entrance),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding-next__line:active {
        transform: translateY(1px);
    }

    .onboarding-next__line:hover {
        --slab-fill: var(--color-bg-hover);
    }

    .onboarding-next__line:hover .onboarding-next__arrow {
        translate: 4px 0;
    }

    .onboarding-preview__location:has(+ :empty) {
        margin-bottom: 0;
    }

    .onboarding-rail {
        --rail-node: 34px;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .onboarding-rail__check {
        display: none;
    }

    .onboarding-rail__node {
        align-items: center;
        background-color: var(--color-text-secondary);
        border: 2px solid var(--color-text-secondary);
        color: var(--color-text-inverse);
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 700;
        height: var(--rail-node);
        justify-content: center;
        line-height: 1;
        user-select: none;
        width: var(--rail-node);
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__check {
        display: block;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__index {
        display: none;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__node {
        background-color: var(--color-bg-inverse);
        border-color: var(--color-bg-inverse);
        color: var(--color-text-inverse);
    }

    .onboarding-rail__step:not(:last-child)::after {
        background-color: var(--color-border-subtle);
        bottom: calc(-1 * var(--space-md));
        content: '';
        left: calc(var(--rail-node) / 2 - 1px);
        position: absolute;
        top: var(--rail-node);
        width: 2px;
    }

    .onboarding-rail__step:not(:last-child):has(~ [aria-current='step'])::after {
        background-color: var(--color-border-strong);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__name {
        color: var(--color-text);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__node {
        background-color: var(--color-signal);
        border-color: var(--color-border-selected);
        color: var(--color-text-on-signal);
    }

    .onboarding-tour {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding: var(--space-lg);
    }

    .onboarding-tour__index {
        line-height: var(--text-base);
    }

    .onboarding-tour__stop + .onboarding-tour__stop {
        border-top: 2px solid var(--color-border-inverse-subtle);
    }

    .onboarding__aside {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .onboarding__chip {
        align-items: center;
        border: 2px solid var(--color-border-strong);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        gap: var(--space-2xs);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        text-transform: uppercase;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
    }

    .onboarding__chip:has(.box:checked) {
        background-color: var(--color-bg-sunken);
    }

    .onboarding__file {
        clip-path: inset(50%);
        height: 100%;
        inset: 0;
        margin: 0;
        width: 100%;
    }

    .onboarding__pick {
        align-items: center;
        background-color: var(--color-bg-page);
        border: 2px dashed var(--color-border-strong);
        display: flex;
        flex: 1 1 220px;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        position: relative;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding__pick > span {
        background-color: inherit;
    }

    .onboarding__pick:active {
        background-color: var(--color-bg-active);
        border-color: var(--color-border-selected);
    }

    .onboarding__pick:has(.onboarding__file:focus-visible) {
        border-color: var(--color-border-selected);
        border-style: solid;
    }

    .onboarding__pick:has(.onboarding__file[aria-invalid='true']) {
        border-color: var(--color-border-invalid);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-border-strong);
    }

    .onboarding__pick:hover {
        background-color: var(--color-bg-hover);
        border-color: var(--color-border-selected);
    }

    [data-onboarding-reveal='off'] {
        opacity: 0;
        translate: 0 calc(var(--motion-travel) * 1px);
    }

    [data-onboarding-reveal='on'] {
        transition:
            opacity var(--duration-slower) var(--motion-ease-entrance),
            translate var(--duration-slower) var(--motion-ease-entrance);
    }

    @media (max-width: 768px) {
        .onboarding-benefits {
            grid-template-columns: minmax(0, 1fr);
        }

        .onboarding-benefits__cell:not(:first-child) {
            border-top: 2px solid var(--color-border-strong);
        }

        .onboarding-benefits__cell:nth-child(odd) {
            border-right: 0;
        }

        .onboarding-form,
        .onboarding-tour {
            padding: var(--space-md);
        }

        .onboarding-rail {
            --rail-node: 28px;
            background-color: var(--color-border-strong);
            border: 2px solid var(--color-border-strong);
            gap: 2px;
        }

        .onboarding-rail__step:not(:last-child)::after {
            content: none;
        }

        .onboarding__aside {
            display: contents;
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { MOTION_SELECTOR, revealTarget } from '@lib/motion/entrances';
    import { ONBOARDING_STEPS, ONBOARDING_TOKEN_PARAMETER, PROFILE_FIELDS, REDUCED_MOTION_QUERY } from '@lib/shared/constants';
    import { armTour } from '@lib/tour/tour';
    import { clearFieldErrors, focusFirstError, setFieldErrors, setRole, validateFields } from '@lib/ui/forms';
    import { clearOnboardingDraft, getOnboardingDraft, saveOnboardingDraft, verifyOnboardingToken } from '@lib/account/onboarding';
    import { formatRole, getInitials, pickTileColor, registerPageScript, setAvatarImage, setHidden, setPending, setText } from '@lib/shared/utils';
    import { getSession, startSession, updateSession } from '@lib/account/session';
    import { stageAvatar } from '@lib/account/images';
    import { toast } from '@lib/ui/toasts';

    const BASICS_RULES: Record<string, FieldRule> = {
        artistName: { max: PROFILE_FIELDS.artistName.maxLength, message: PROFILE_FIELDS.artistName.message },
        city: { message: PROFILE_FIELDS.city.message, required: PROFILE_FIELDS.city.required },
    };

    const COMPLETION_ENABLED = false;
    const DEFAULT_LOCATION = 'Austin, TX';
    const DEMO_EMAIL = 'you@austinproduceralliance.com';
    const LAST_STEP = 2;
    const STORAGE_MESSAGE = 'Your progress was not saved because your browser storage is full. Clear some space and try again.';

    const STEP_RULES: Record<string, FieldRule>[] = [BASICS_RULES, {}, {}];

    let accountEmail = '';
    let avatar = '';
    let isStaging = false;
    let signedIn: Promise<SessionResult> | undefined;
    let step = 0;

    function armReveal(form: HTMLFormElement) {
        const block = form.querySelector<HTMLElement>(`[data-onboarding-pane="${step}"] [data-onboarding-reveal]`);

        if (!block || window.matchMedia(REDUCED_MOTION_QUERY).matches) return;

        block.dataset.onboardingReveal = 'off';
        void block.offsetHeight;
        block.dataset.onboardingReveal = 'on';
    }

    function collect(form: HTMLFormElement) {
        const values = new FormData(form);

        return {
            artistName: String(values.get('artistName') ?? '').trim(),
            avatar,
            email: accountEmail,
            genres: values.getAll('genres').map(String),
            location: getLocation(values),
            roles: [getRole(values)],
        };
    }

    async function complete(form: HTMLFormElement) {
        const back = form.querySelector<HTMLButtonElement>('[data-onboarding-back]');
        const button = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');
        const draft = collect(form);

        setPending(button, true);

        await signedIn;

        const session = await updateSession({ artistName: draft.artistName, avatar: draft.avatar, onboarded: true, role: draft.roles[0] });

        if (!session) {
            setPending(button, false);
            toast('That sign-in has lapsed. Check in again for a fresh link.', 'error');
            button?.focus();

            return;
        }

        if (!getSession()?.onboarded) {
            setPending(button, false);
            toast('That could not be saved because your browser storage is full. Try a smaller portrait.', 'error');
            button?.focus();

            return;
        }

        clearOnboardingDraft();
        setHidden(back, true);
        setHidden(button, true);
        setPending(button, false);
        toast('You are all set. Your card is on the roster.', 'success');

        await navigate('/');
    }

    function getLocation(values: FormData) {
        const city = String(values.get('city') ?? '').trim();

        return city ? `${city}, ${String(values.get('state') ?? '')}` : '';
    }

    function getRole(values: FormData) {
        return String(values.get('role') ?? '');
    }

    function handleBack(form: HTMLFormElement) {
        if (step === 0) return;

        step -= 1;
        persistDraft(form);
        showStep(form, true);
    }

    async function handlePortraitChange(form: HTMLFormElement, input: HTMLInputElement) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || isStaging) return;

        isStaging = true;

        try {
            const staged = await stageAvatar(file);

            clearFieldErrors(form);

            if (!staged.ok) {
                setFieldErrors(form, { portrait: staged.message });
                input.focus();

                return;
            }

            avatar = staged.dataUrl;
            renderPreview(form);
            persistDraft(form);
            toast('Portrait staged.', 'success');
        } finally {
            isStaging = false;
        }
    }

    function handlePortraitRemove(form: HTMLFormElement) {
        avatar = '';
        clearFieldErrors(form);
        renderPreview(form);
        persistDraft(form);
        form.querySelector<HTMLInputElement>('[data-portrait-input]')?.focus();
        toast('Portrait removed.', 'info');
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (isStaging) return;

        const errors = validateFields(form, STEP_RULES[step]);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        if (step === LAST_STEP) {
            if (!COMPLETION_ENABLED) {
                toast('Completion is switched off while the flow is under review.', 'info');

                return;
            }

            await complete(form);

            return;
        }

        const draft = collect(form);

        step += 1;

        if (!persistDraft(form).persisted) toast(STORAGE_MESSAGE, 'error');

        showStep(form, true);

        await signedIn;
        await updateSession({ artistName: draft.artistName });
    }

    async function handleTour() {
        armTour();

        await navigate('/');
    }

    function initOnboardingFlow(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('[data-onboarding-form]');
        const gate = verifyOnboardingToken(new URLSearchParams(window.location.search).get(ONBOARDING_TOKEN_PARAMETER));
        const picture = document.querySelector<HTMLInputElement>('[data-portrait-input]');
        const session = getSession();

        if (!form) return;

        if (COMPLETION_ENABLED && session?.onboarded === true) {
            void navigate('/settings', { history: 'replace' });

            return;
        }

        if (gate.state === 'rejected' && gate.reason !== 'missing') {
            showSurface('expired');

            return;
        }

        accountEmail = gate.state === 'granted' ? gate.email : (session?.email ?? DEMO_EMAIL);
        step = 0;
        form.noValidate = true;
        prefill(form, session);
        restore(form);
        renderPreview(form);
        setText(document.querySelector<HTMLElement>('[data-onboarding-email]'), accountEmail);
        showStep(form, false);
        showSurface('flow');
        void signIn();
        form.addEventListener('input', () => renderPreview(form), { signal });
        form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        form.querySelector<HTMLButtonElement>('[data-onboarding-back]')?.addEventListener('click', () => handleBack(form), { signal });
        form.querySelector<HTMLButtonElement>('[data-onboarding-tour]')?.addEventListener('click', () => void handleTour(), { signal });
        form.querySelector<HTMLButtonElement>('[data-portrait-remove]')?.addEventListener('click', () => handlePortraitRemove(form), { signal });
        picture?.addEventListener('change', () => void handlePortraitChange(form, picture), { signal });
    }

    function persistDraft(form: HTMLFormElement) {
        return saveOnboardingDraft({ ...collect(form), step: step + 1 });
    }

    function prefill(form: HTMLFormElement, session: Session | null) {
        if (!session || session.email !== accountEmail) return;

        avatar = session.avatar;
        setRole(form, session.role);
        setValue(form, 'artistName', session.artistName);
    }

    function renderPreview(form: HTMLFormElement) {
        const badge = document.querySelector<HTMLElement>('[data-preview-role]');
        const list = document.querySelector<HTMLElement>('[data-preview-genres]');
        const template = document.querySelector<HTMLTemplateElement>('[data-preview-chip]');
        const tile = document.querySelector<HTMLElement>('.onboarding-preview__tile');
        const values = new FormData(form);

        const artistName = String(values.get('artistName') ?? '').trim();
        const genres = values.getAll('genres').map(String);
        const location = getLocation(values) || DEFAULT_LOCATION;
        const role = getRole(values);

        const tileColor = pickTileColor(artistName);

        if (tile) {
            tile.style.background = tileColor.background;
            tile.style.color = tileColor.text;
        }

        setAvatarImage(document.querySelector<HTMLImageElement>('[data-preview-avatar]'), avatar);
        setHidden(document.querySelector<HTMLElement>('[data-portrait-remove]'), avatar.length === 0);
        setPreviewText(document.querySelector<HTMLElement>('[data-preview-name]'), artistName, 'Your artist name');
        setText(document.querySelector<HTMLElement>('.onboarding-preview__initials'), getInitials(artistName) || '??');
        setHidden(badge, role.length === 0);
        setText(badge, formatRole(role));
        setText(document.querySelector<HTMLElement>('[data-preview-location]'), location);

        if (!list || !template) return;

        list.replaceChildren();

        genres.forEach((genre) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            setText(fragment.querySelector('[data-preview-genre]'), genre);
            list.append(fragment);
        });
    }

    function restore(form: HTMLFormElement) {
        const draft = getOnboardingDraft();

        if (draft.email !== accountEmail) return;

        const [draftCity = '', draftState = ''] = draft.location.split(/,\s*/);

        avatar = draft.avatar || avatar;
        step = Math.min(LAST_STEP, Math.max(0, draft.step - 1));

        form.querySelectorAll<HTMLInputElement>('[name="genres"]').forEach((input) => {
            input.checked = draft.genres.includes(input.value);
        });

        setRole(form, draft.roles[0] ?? '');
        setValue(form, 'artistName', draft.artistName);
        setValue(form, 'city', draftCity);
        setValue(form, 'state', draftState.toUpperCase());
    }

    function setPreviewText(element: HTMLElement | null, value: string, fallback: string) {
        if (!element) return;

        element.toggleAttribute('data-empty', value.length === 0);
        setText(element, value || fallback);
    }

    function setValue(form: HTMLFormElement, name: string, value: string) {
        const control = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);

        if (!control || !value) return;
        if (control instanceof HTMLSelectElement && !Array.from(control.options).some(option => option.value === value)) return;

        control.value = value;
    }

    function showStep(form: HTMLFormElement, isStepChange: boolean) {
        const back = form.querySelector<HTMLButtonElement>('[data-onboarding-back]');
        const next = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');

        form.querySelectorAll<HTMLElement>('[data-onboarding-pane]').forEach((pane, index) => {
            pane.toggleAttribute('hidden', index !== step);
        });

        document.querySelectorAll<HTMLElement>('[data-onboarding-step]').forEach((marker, index) => {
            if (index === step) marker.setAttribute('aria-current', 'step');
            else marker.removeAttribute('aria-current');
        });

        back?.toggleAttribute('hidden', step === 0);
        setText(next?.querySelector<HTMLElement>('[data-onboarding-next-label]') ?? null, step === LAST_STEP ? 'Finish' : 'Continue');

        setText(
            document.querySelector<HTMLElement>('[data-onboarding-announce]'),
            `Step ${step + 1} of ${ONBOARDING_STEPS.length}, ${ONBOARDING_STEPS[step].name}.`,
        );

        if (!isStepChange) return;

        armReveal(form);

        const pane = form.querySelector<HTMLElement>(`[data-onboarding-pane="${step}"]`);

        pane?.querySelectorAll(MOTION_SELECTOR).forEach(target => revealTarget(target));
        (pane?.querySelector<HTMLElement>('input') ?? pane?.querySelector<HTMLElement>('legend'))?.focus();
    }

    function showSurface(name: string) {
        document.querySelectorAll<HTMLElement>('[data-onboarding-surface]').forEach((surface) => {
            setHidden(surface, surface.dataset.onboardingSurface !== name);
        });
    }

    async function signIn() {
        if (getSession()?.email === accountEmail) return;

        signedIn = startSession({ email: accountEmail });

        const result = await signedIn;

        if (result.ok) return;

        toast(result.message, 'error');
    }

    registerPageScript(initOnboardingFlow);
</script>
