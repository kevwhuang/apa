---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { AVATAR, GENRES, ONBOARDING_STEPS, PROFILE_FIELDS, PROFILE_ROLES, TOUR_STOPS, US_STATES } from '@lib/shared/constants';
import { AVATAR_EXTENSIONS_OR_LIST } from '@lib/account/images';
import { formatBytes, formatDate } from '@lib/shared/utils';

const ACCOUNT_BENEFITS = [
    { blurb: 'Prods are the Alliance\'s rewards currency. You earn them at events, on submissions, and in workshops, and spend them at the store register.', label: 'Prods' },
    { blurb: 'Your producer card sits on the member roster with your tracks and your links, so the room can find you and hear what you make.', label: 'The directory' },
    { blurb: 'Drop a track for an Assembly feedback session or for the Bash, and it goes in under your name.', label: 'Submissions' },
    { blurb: 'Member-only drops, unlockable resources, and sample packs land on your account before they go anywhere else.', label: 'Exclusives' },
    { blurb: 'Checkout remembers you, every order stays in one list, and your Prods come off the total at the register.', label: 'The store' },
    { blurb: 'Member chat, the plugin rack, and the floating player follow your session from page to page.', label: 'The docks' },
    { blurb: 'Every event you check into and every order you place is kept together, so a year with the Alliance is one scroll away.', label: 'Histories' },
    { blurb: 'Event announcements and the newsletter go to the address on your account, and nothing else does.', label: 'The dispatch' },
];

const DEFAULT_CITY = 'Austin';
const DEFAULT_ROLE = 'fan';
const DEFAULT_STATE = 'TX';

const WELCOME_LINKS = [
    { blurb: 'How the Alliance works and who keeps it running.', href: '/about', label: 'About' },
    { blurb: 'Merch, music, and what your Prods buy.', href: '/store', label: 'Store' },
];

const events = await getCollection('events');

const [nextAssembly] = events
    .filter(event => event.data.type === 'assembly' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="onboarding-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Account / Onboarding"
            headingId="onboarding-title"
        >
            Welcome in.
        </PageHead>
        <p
            class="max-w-2xl text-lmd text-ink-muted"
            data-motion="blur"
        >
            That link signed you in. Three short steps &mdash; the basics, what the account is for,
            then a look around &mdash; and your card is on the roster.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Onboarding"
>
    <div
        class="slab slab--card flex flex-col items-start max-w-(--measure-form) w-full gap-4 mx-auto"
        data-onboarding-surface="expired"
        hidden
    >
        <p class="label text-accent-deep">Account / Link</p>
        <h2 class="font-extrabold font-sans text-3xl tracking-tight">
            This link no longer works.
        </h2>
        <p class="max-w-2xl text-md text-ink-muted">
            Welcome links last 24 hours. Check in again and we will send a fresh one.
        </p>
        <a
            class="btn btn--primary"
            href="/here"
        >
            Check in again <IconArrow />
        </a>
    </div>
    <div
        class="onboarding__flow"
        data-onboarding-surface="flow"
    >
        <div class="onboarding__aside">
            <div>
                <p
                    id="onboarding-progress-label"
                    class="label mb-4 text-ink-muted"
                >
                    Progress
                </p>
                <ol
                    class="onboarding-rail list-none"
                    aria-labelledby="onboarding-progress-label"
                    data-motion="rise"
                >
                    {ONBOARDING_STEPS.map((step, index) => (
                        <li
                            class="onboarding-rail__step"
                            aria-current={index === 0 ? 'step' : undefined}
                            data-onboarding-step={index}
                        >
                            <span
                                class="onboarding-rail__node"
                                aria-hidden="true"
                            >
                                <span class="onboarding-rail__index">0{index + 1}</span>
                                <span class="onboarding-rail__check">&check;</span>
                            </span>
                            <span class="flex flex-col min-w-0 gap-(--space-3xs)">
                                <span class="label onboarding-rail__name text-ink-muted">{step.name}</span>
                                <span class="onboarding-rail__blurb leading-[1.4] text-sm text-ink-subtle">{step.blurb}</span>
                            </span>
                        </li>
                    ))}
                </ol>
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-onboarding-announce
                />
            </div>
        </div>
        <form
            class="onboarding-form slab slab--card flex flex-col gap-6"
            data-onboarding-form
        >
            <fieldset
                class="flex flex-col gap-6"
                data-onboarding-pane="0"
            >
                <legend class="mb-6 font-extrabold font-sans text-2xl tracking-tight">
                    The basics
                </legend>
                <p class="text-smd text-ink-muted">
                    Only what your roster card needs. Everything else can wait.
                </p>
                <p class="onboarding__account slab slab--sunk flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="label text-ink-subtle">Signed in as</span>
                    <span
                        class="min-w-0 font-mono text-sm wrap-anywhere"
                        data-onboarding-email
                    />
                </p>
                <div class="onboarding-preview flex flex-col self-center max-w-xs w-full gap-3">
                    <p class="label text-ink-muted">Roster preview</p>
                    <article class="slab slab--bare slab--card overflow-clip">
                        <PlaceholderTile
                            class="onboarding-preview__tile aspect-[5/3] border-b-2 border-ink"
                            color="var(--color-ink-subtle)"
                            data-motion="wipe"
                            label="??"
                            labelClass="onboarding-preview__initials leading-none text-[20cqw] text-surface-raised/80 [text-shadow:2px_2px_0_var(--color-ink-20)]"
                        >
                            <img
                                class="absolute inset-0 object-cover h-full w-full"
                                alt=""
                                data-preview-avatar
                                hidden
                            />
                        </PlaceholderTile>
                        <div class="onboarding-preview__body p-4">
                            <h2
                                class="data-empty:text-ink-subtle mb-2 font-extrabold font-sans text-lg tracking-tight wrap-break-word"
                                data-empty
                                data-preview-name
                            >
                                Your artist name
                            </h2>
                            <p
                                class="mb-3 font-mono text-2xs uppercase wrap-break-word text-ink-muted"
                                data-preview-meta
                            >
                                Austin, TX
                            </p>
                            <ul
                                class="flex flex-wrap gap-2 list-none"
                                data-preview-genres
                            />
                            <p
                                class="font-mono text-2xs uppercase text-ink-subtle"
                                data-preview-genres-empty
                            >
                                Genre tags land here
                            </p>
                        </div>
                    </article>
                </div>
                <div class="flex flex-col gap-2">
                    <p class="label mb-1 text-ink-muted">{PROFILE_FIELDS.portrait.label}</p>
                    <div class="flex flex-wrap items-center gap-(--space-sm)">
                        <label class="onboarding__pick">
                            <span class="label">{PROFILE_FIELDS.portrait.picker}</span>
                            <input
                                id="onboarding-portrait"
                                class="onboarding__file sr-only"
                                accept={AVATAR.acceptAttribute}
                                aria-describedby="onboarding-portrait-error onboarding-portrait-help"
                                aria-invalid="false"
                                data-portrait-input
                                name="portrait"
                                type="file"
                            />
                        </label>
                        <button
                            class="action-text hover:text-accent-deep flex items-center min-h-(--control-size) px-1 text-ink-muted transition-colors"
                            data-portrait-remove
                            hidden
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                    <p
                        id="onboarding-portrait-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                    <p
                        id="onboarding-portrait-help"
                        class="text-sm text-ink-subtle"
                    >
                        {AVATAR_EXTENSIONS_OR_LIST}. Up to {formatBytes(AVATAR.maxFileBytes)}, at least {AVATAR.minEdgePixels}px on each side.
                    </p>
                </div>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.artistName.label}</span>
                        <input
                            id="onboarding-artist-name"
                            class="input font-sans"
                            aria-describedby="onboarding-artist-name-error onboarding-artist-name-help"
                            aria-invalid="false"
                            autocomplete={PROFILE_FIELDS.artistName.autocomplete}
                            maxlength={PROFILE_FIELDS.artistName.maxLength}
                            name="artistName"
                            type="text"
                        />
                    </label>
                    <p
                        id="onboarding-artist-name-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                    <p
                        id="onboarding-artist-name-help"
                        class="text-sm text-ink-subtle"
                    >
                        {PROFILE_FIELDS.artistName.help}
                    </p>
                </div>
                <fieldset class="flex flex-col gap-3">
                    <legend class="label mb-1 text-ink-muted">
                        {PROFILE_FIELDS.genres.label} <span class="text-ink-subtle">/ {PROFILE_FIELDS.genres.qualifier}</span>
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {GENRES.map(genre => (
                            <label class="onboarding__chip">
                                <input
                                    class="box"
                                    aria-describedby="onboarding-genres-error"
                                    aria-invalid="false"
                                    name="genres"
                                    type="checkbox"
                                    value={genre}
                                />
                                {genre}
                            </label>
                        ))}
                    </div>
                    <p
                        id="onboarding-genres-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </fieldset>
                <fieldset class="flex flex-col gap-3">
                    <legend class="label mb-1 text-ink-muted">
                        {PROFILE_FIELDS.role.label} <span class="text-ink-subtle">/ {PROFILE_FIELDS.role.qualifier}</span>
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {PROFILE_ROLES.map(role => (
                            <label class="onboarding__chip">
                                <input
                                    class="box"
                                    checked={role.id === DEFAULT_ROLE}
                                    name="role"
                                    type="radio"
                                    value={role.id}
                                />
                                {role.id}
                            </label>
                        ))}
                    </div>
                </fieldset>
                <div class="onboarding__pair">
                    <div class="flex flex-col gap-2">
                        <label class="block">
                            <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.city.label}</span>
                            <input
                                id="onboarding-city"
                                class="input font-sans"
                                aria-describedby="onboarding-city-error"
                                aria-invalid="false"
                                autocomplete={PROFILE_FIELDS.city.autocomplete}
                                name="city"
                                required={PROFILE_FIELDS.city.required}
                                type="text"
                                value={DEFAULT_CITY}
                            />
                        </label>
                        <p
                            id="onboarding-city-error"
                            class="action-text text-accent-deep"
                            data-field-error
                            hidden
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="block">
                            <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.state.label}</span>
                            <span class="select">
                                <select
                                    id="onboarding-state"
                                    class="input font-sans"
                                    aria-describedby="onboarding-state-error"
                                    aria-invalid="false"
                                    autocomplete={PROFILE_FIELDS.state.autocomplete}
                                    name="state"
                                    required={PROFILE_FIELDS.state.required}
                                >
                                    {US_STATES.map(state => (
                                        <option
                                            selected={state.code === DEFAULT_STATE}
                                            value={state.code}
                                        >
                                            {state.name}
                                        </option>
                                    ))}
                                </select>
                            </span>
                        </label>
                        <p
                            id="onboarding-state-error"
                            class="action-text text-accent-deep"
                            data-field-error
                            hidden
                        />
                    </div>
                </div>
            </fieldset>
            <fieldset
                class="flex flex-col gap-6"
                data-onboarding-pane="1"
                hidden
            >
                <legend
                    class="mb-6 font-extrabold font-sans text-2xl tracking-tight"
                    tabindex="-1"
                >
                    Why an account
                </legend>
                <p class="text-smd text-ink-muted">
                    Everything below comes with the account.
                </p>
                <ul
                    class="onboarding-benefits slab slab--bare slab--card list-none"
                    data-onboarding-reveal
                >
                    {ACCOUNT_BENEFITS.map((benefit, index) => (
                        <li
                            class="onboarding-benefits__cell onboarding-reveal flex flex-col min-w-0 gap-(--space-2xs) p-(--space-md)"
                            style={`--row-index: ${index}`}
                        >
                            <p class="font-extrabold font-sans leading-[1.2] text-lmd tracking-[-0.02em]">{benefit.label}</p>
                            <p class="leading-normal text-sm wrap-anywhere text-ink-muted">{benefit.blurb}</p>
                        </li>
                    ))}
                </ul>
            </fieldset>
            <fieldset
                class="flex flex-col gap-6"
                data-onboarding-pane="2"
                hidden
            >
                <legend
                    class="mb-6 font-extrabold font-sans text-2xl tracking-tight"
                    tabindex="-1"
                >
                    Take the tour
                </legend>
                <p class="text-smd text-ink-muted">
                    Setup is done. One guided lap and you will know where everything lives.
                </p>
                <div class="onboarding-tour slab slab--well">
                    <p class="label text-accent">The guided tour / {TOUR_STOPS.length} stops</p>
                    <p class="max-w-[36ch] font-extrabold font-sans leading-[1.2] text-lmd tracking-[-0.02em]">
                        A short walk through the five things you will reach for most.
                    </p>
                    <ol
                        class="grid border-y-2 border-ink-inverse-10 list-none"
                        data-onboarding-reveal
                    >
                        {TOUR_STOPS.map((stop, index) => (
                            <li
                                class="onboarding-tour__stop onboarding-reveal grid grid-cols-[auto_minmax(0,1fr)] gap-x-(--space-sm) py-(--space-xs)"
                                style={`--row-index: ${index}`}
                            >
                                <span
                                    class="shrink-0 font-bold font-mono leading-normal text-xs tracking-[0.06em] text-accent"
                                    aria-hidden="true"
                                >
                                    {String(index + 1).padStart(2, '0')}
                                </span>
                                <span class="flex flex-col min-w-0 gap-(--space-3xs)">
                                    <span class="font-bold font-sans leading-[1.2] text-smd tracking-[-0.01em]">{stop.name}</span>
                                    <span class="leading-[1.4] text-sm wrap-anywhere text-ink-inverse-muted">{stop.blurb}</span>
                                </span>
                            </li>
                        ))}
                    </ol>
                    <button
                        class="btn btn--accent self-start"
                        data-onboarding-tour
                        type="button"
                    >
                        Take the site tour <IconArrow />
                    </button>
                </div>
                <p class="label mt-2 text-ink-muted">Or go straight there</p>
                <ul class="grid gap-(--space-sm) list-none">
                    {nextAssembly && (
                        <li class="grid">
                            <a
                                class="onboarding-next__line slab slab--card slab--hover"
                                href="/assembly"
                            >
                                <span class="flex items-center justify-between gap-(--space-sm)">
                                    <span class="font-bold font-mono text-smd tracking-[0.02em] uppercase">Next Assembly</span>
                                    <span
                                        class="onboarding-next__arrow"
                                        aria-hidden="true"
                                    >
                                        <IconArrow />
                                    </span>
                                </span>
                                <span class="onboarding-next__blurb leading-normal text-sm wrap-anywhere text-ink-muted transition-colors">
                                    <time datetime={nextAssembly.data.date.toISOString()}>{formatDate(nextAssembly.data.date)}</time> at {nextAssembly.data.location}. Come say hi.
                                </span>
                            </a>
                        </li>
                    )}
                    {WELCOME_LINKS.map(link => (
                        <li class="grid">
                            <a
                                class="onboarding-next__line slab slab--card slab--hover"
                                href={link.href}
                            >
                                <span class="flex items-center justify-between gap-(--space-sm)">
                                    <span class="font-bold font-mono text-smd tracking-[0.02em] uppercase">{link.label}</span>
                                    <span
                                        class="onboarding-next__arrow"
                                        aria-hidden="true"
                                    >
                                        <IconArrow />
                                    </span>
                                </span>
                                <span class="onboarding-next__blurb leading-normal text-sm wrap-anywhere text-ink-muted transition-colors">{link.blurb}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </fieldset>
            <div class="flex flex-wrap items-center gap-(--space-sm) pt-(--space-md) border-t-2 border-ink">
                <button
                    class="btn"
                    data-onboarding-back
                    hidden
                    type="button"
                >
                    <IconArrow left /> Back
                </button>
                <button
                    class="btn btn--primary"
                    data-onboarding-next
                    type="submit"
                >
                    <span data-onboarding-next-label>Continue</span> <IconArrow />
                </button>
            </div>
        </form>
    </div>
    <template data-preview-chip>
        <li
            class="inline-flex items-center h-6 px-2 border-2 border-ink font-bold font-mono text-2xs tracking-wide uppercase"
            data-preview-genre
        />
    </template>
</section>

<style>
    .onboarding-benefits {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .onboarding-benefits__cell {
        --benefit-fill: var(--color-surface-raised);
        --benefit-grain: var(--color-surface-sunken);
        background-color: var(--benefit-fill);
        background-image: radial-gradient(circle, var(--benefit-grain) 0.8px, transparent 0.8px);
        background-size: var(--grain-pitch) var(--grain-pitch);
    }

    .onboarding-benefits__cell:not(:nth-child(-n + 2)) {
        border-top: 2px solid var(--color-ink);
    }

    .onboarding-benefits__cell:nth-child(4n + 2),
    .onboarding-benefits__cell:nth-child(4n + 3) {
        --benefit-fill: var(--color-surface-sunken);
        --benefit-grain: var(--color-surface-raised);
    }

    .onboarding-benefits__cell:nth-child(odd) {
        border-right: 2px solid var(--color-ink);
    }

    .onboarding-form {
        padding: var(--space-lg);
    }

    .onboarding-next__arrow {
        color: var(--color-accent-deep);
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        line-height: 1;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            translate var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding-next__line {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        justify-content: center;
        min-height: 64px;
        padding: var(--space-sm) var(--space-md);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-base) var(--motion-ease-entrance),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding-next__line:active {
        transform: translateY(1px);
    }

    .onboarding-next__line:hover {
        --slab-fill: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .onboarding-next__line:hover .onboarding-next__arrow {
        color: var(--color-accent);
        translate: 4px 0;
    }

    .onboarding-next__line:hover .onboarding-next__blurb {
        color: var(--color-ink-inverse-muted);
    }

    .onboarding-rail {
        --rail-node: 34px;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .onboarding-rail__check {
        display: none;
    }

    .onboarding-rail__name {
        line-height: 1.3;
    }

    .onboarding-rail__node {
        align-items: center;
        background-color: var(--color-surface-raised);
        border: 2px solid var(--color-ink);
        color: var(--color-ink-muted);
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 700;
        height: var(--rail-node);
        justify-content: center;
        line-height: 1;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
        width: var(--rail-node);
    }

    .onboarding-rail__step {
        align-items: center;
        column-gap: var(--space-sm);
        display: grid;
        grid-template-columns: var(--rail-node) minmax(0, 1fr);
        position: relative;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__check {
        display: block;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__index {
        display: none;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__node {
        background-color: var(--color-ink);
        border-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .onboarding-rail__step:not(:last-child)::after {
        background-color: var(--color-ink-20);
        bottom: calc(-1 * var(--space-md));
        content: '';
        left: calc(var(--rail-node) / 2 - 1px);
        position: absolute;
        top: var(--rail-node);
        width: 2px;
    }

    .onboarding-rail__step:not(:last-child):has(~ [aria-current='step'])::after {
        background-color: var(--color-ink);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__blurb,
    .onboarding-rail__step[aria-current='step'] .onboarding-rail__name {
        color: var(--color-ink);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__node {
        background-color: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    [data-onboarding-reveal='off'] .onboarding-reveal {
        opacity: 0;
        translate: 0 var(--space-2xs);
    }

    [data-onboarding-reveal='on'] .onboarding-reveal {
        transition:
            opacity var(--duration-slow) var(--motion-ease-entrance),
            translate var(--duration-slow) var(--motion-ease-entrance);
        transition-delay: min(calc(var(--row-index) * var(--stagger-base)), var(--stagger-max-total));
    }

    .onboarding-tour {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding: var(--space-lg);
    }

    .onboarding-tour__stop + .onboarding-tour__stop {
        border-top: 2px solid var(--color-ink-inverse-10);
    }

    .onboarding__account {
        padding: var(--space-xs);
    }

    .onboarding__aside {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .onboarding__chip {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        gap: var(--space-2xs);
        letter-spacing: 0.025em;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        text-transform: uppercase;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
    }

    .onboarding__chip:has(.box:checked) {
        background-color: var(--color-surface-sunken);
    }

    .onboarding__file {
        clip-path: inset(50%);
        height: 100%;
        inset: 0;
        margin: 0;
        width: 100%;
    }

    .onboarding__flow {
        align-items: start;
        column-gap: var(--space-2xl);
        display: grid;
        grid-template-columns: minmax(190px, 0.32fr) minmax(0, var(--measure-form));
        justify-content: space-between;
        row-gap: var(--space-lg);
    }

    .onboarding__pair {
        display: grid;
        gap: var(--space-md);
        grid-template-columns: minmax(0, 1fr) minmax(0, 220px);
    }

    .onboarding__pick {
        align-items: center;
        background-color: var(--color-surface);
        background-image: repeating-linear-gradient(135deg, var(--color-ink-10) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-ink);
        display: flex;
        flex: 1 1 220px;
        justify-content: center;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        position: relative;
        text-align: center;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding__pick:active {
        background-color: var(--color-surface-raised);
        border-color: var(--color-accent-deep);
    }

    .onboarding__pick:has(.onboarding__file:focus) {
        border-color: var(--color-accent-deep);
        border-style: solid;
    }

    .onboarding__pick:has(.onboarding__file[aria-invalid='true']) {
        border-color: var(--color-accent-deep);
        box-shadow: 3px 3px 0 0 var(--color-accent-20);
    }

    .onboarding__pick:hover {
        background-color: var(--color-surface-raised);
        border-color: var(--color-accent-deep);
    }

    @media (max-width: 768px) {
        .onboarding-benefits {
            grid-template-columns: minmax(0, 1fr);
        }

        .onboarding-benefits__cell:not(:first-child) {
            border-top: 2px solid var(--color-ink);
        }

        .onboarding-benefits__cell:nth-child(4n + 3) {
            --benefit-fill: var(--color-surface-raised);
            --benefit-grain: var(--color-surface-sunken);
        }

        .onboarding-benefits__cell:nth-child(4n + 4) {
            --benefit-fill: var(--color-surface-sunken);
            --benefit-grain: var(--color-surface-raised);
        }

        .onboarding-benefits__cell:nth-child(odd) {
            border-right: 0;
        }

        .onboarding-rail {
            --rail-node: 28px;
            background-color: var(--color-ink);
            border: 2px solid var(--color-ink);
            flex-direction: row;
            flex-wrap: wrap;
            gap: 2px;
        }

        .onboarding-rail__blurb {
            display: none;
        }

        .onboarding-rail__step {
            background-color: var(--color-surface);
            flex: 1 1 150px;
            padding: var(--space-xs);
        }

        .onboarding-rail__step:not(:last-child)::after {
            content: none;
        }

        .onboarding__aside {
            display: contents;
        }

        .onboarding__flow,
        .onboarding__pair {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (forced-colors: active) {
        .onboarding-rail__node {
            border-color: CanvasText;
            forced-color-adjust: none;
        }

        .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__node,
        .onboarding-rail__step[aria-current='step'] .onboarding-rail__node {
            background-color: SelectedItem;
            color: SelectedItemText;
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { ONBOARDING_STEPS, ONBOARDING_TOKEN_PARAM, PROFILE_FIELDS } from '@lib/shared/constants';
    import { armTour } from '@lib/tour/tour';
    import { clearFieldErrors, focusFirstError, isValidationBypassed, setFieldErrors, setRole, validateFields } from '@lib/ui/forms';
    import { clearOnboardingDraft, getOnboardingDraft, saveOnboardingDraft, verifyOnboardingToken } from '@lib/account/onboarding';
    import { getInitials, pickTileColor, registerPageScript, setAvatarImage, setHidden, setPending, setText } from '@lib/shared/utils';
    import { getSession, startSession, updateSession } from '@lib/account/session';
    import { stageAvatar } from '@lib/account/images';
    import { toast } from '@lib/ui/toasts';

    const BASICS_RULES: Record<string, FieldRule> = {
        city: { message: PROFILE_FIELDS.city.message, required: PROFILE_FIELDS.city.required },
    };

    const COMPLETION_ENABLED = false;
    const DEFAULT_LOCATION = 'Austin, TX';
    const DEMO_EMAIL = 'you@austinproduceralliance.com';
    const LAST_STEP = 2;
    const STEP_RULES: Record<string, FieldRule>[] = [BASICS_RULES, {}, {}];
    const STORAGE_MESSAGE = 'Your progress was not saved \u2014 your browser storage is full.';

    let accountEmail = '';
    let avatar = '';
    let signedIn: Promise<SessionResult> | undefined;
    let staging = false;
    let step = 0;

    function armReveal(form: HTMLFormElement) {
        const list = form.querySelector<HTMLElement>(`[data-onboarding-pane="${step}"] [data-onboarding-reveal]`);

        if (!list) return;

        list.dataset.onboardingReveal = 'off';
        void list.offsetHeight;
        list.dataset.onboardingReveal = 'on';
    }

    function collect(form: HTMLFormElement) {
        const values = new FormData(form);

        return {
            artistName: String(values.get('artistName') ?? '').trim(),
            avatar,
            email: accountEmail,
            genres: values.getAll('genres').map(String),
            location: getLocation(values),
            roles: [getRole(values)],
        };
    }

    async function complete(form: HTMLFormElement) {
        const back = form.querySelector<HTMLButtonElement>('[data-onboarding-back]');
        const button = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');
        const draft = collect(form);

        setPending(button, true);

        await signedIn;

        const session = await updateSession({ artistName: draft.artistName, avatar: draft.avatar, onboarded: true, role: draft.roles[0] });

        if (!session) {
            setPending(button, false);
            toast('That sign-in has lapsed. Check in again for a fresh link.', 'error');
            button?.focus();

            return;
        }

        if (!getSession()?.onboarded) {
            setPending(button, false);
            toast('That could not be saved \u2014 your browser storage may be full. Try a smaller portrait.', 'error');
            button?.focus();

            return;
        }

        clearOnboardingDraft();
        setHidden(back, true);
        setHidden(button, true);
        setPending(button, false);
        toast('You are all set. Your card is on the roster.', 'success');

        await navigate('/');
    }

    function getLocation(values: FormData) {
        const city = String(values.get('city') ?? '').trim();

        return city ? `${city}, ${String(values.get('state') ?? '')}` : '';
    }

    function getRole(values: FormData) {
        return String(values.get('role') ?? '');
    }

    function handleBack(form: HTMLFormElement) {
        if (step === 0) return;

        step -= 1;
        persistDraft(form);
        showStep(form, true);
    }

    async function handlePortraitChange(form: HTMLFormElement, input: HTMLInputElement) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || staging) return;

        staging = true;

        try {
            const staged = await stageAvatar(file);

            clearFieldErrors(form);

            if (!staged.ok) {
                setFieldErrors(form, { portrait: staged.message });
                input.focus();

                return;
            }

            avatar = staged.dataUrl;
            renderPreview(form);
            persistDraft(form);
            toast('Portrait staged.', 'success');
        } finally {
            staging = false;
        }
    }

    function handlePortraitRemove(form: HTMLFormElement) {
        avatar = '';
        clearFieldErrors(form);
        renderPreview(form);
        persistDraft(form);
        form.querySelector<HTMLInputElement>('[data-portrait-input]')?.focus();
        toast('Portrait removed.', 'info');
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (staging) return;

        const errors = validate(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        if (step === LAST_STEP) {
            if (!COMPLETION_ENABLED) {
                toast('Completion is switched off while the flow is under review.', 'info');

                return;
            }

            await complete(form);

            return;
        }

        const draft = collect(form);

        step += 1;

        if (!persistDraft(form).persisted) toast(STORAGE_MESSAGE, 'error');

        showStep(form, true);

        await signedIn;
        await updateSession({ artistName: draft.artistName });
    }

    async function handleTour() {
        armTour();

        await navigate('/');
    }

    function initOnboardingFlow(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('[data-onboarding-form]');
        const gate = verifyOnboardingToken(new URLSearchParams(window.location.search).get(ONBOARDING_TOKEN_PARAM));
        const picture = document.querySelector<HTMLInputElement>('[data-portrait-input]');
        const session = getSession();

        if (!form) return;

        if (COMPLETION_ENABLED && session?.onboarded === true) {
            void navigate('/settings', { history: 'replace' });

            return;
        }

        if (gate.state === 'rejected' && gate.reason !== 'missing') {
            showSurface('expired');

            return;
        }

        accountEmail = gate.state === 'granted' ? gate.email : (session?.email ?? DEMO_EMAIL);
        step = 0;
        form.noValidate = true;
        prefill(form, session);
        restore(form);
        renderPreview(form);
        setText(document.querySelector<HTMLElement>('[data-onboarding-email]'), accountEmail);
        showStep(form, false);
        showSurface('flow');
        void signIn();
        form.addEventListener('input', () => renderPreview(form), { signal });
        form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        form.querySelector<HTMLButtonElement>('[data-onboarding-back]')?.addEventListener('click', () => handleBack(form), { signal });
        form.querySelector<HTMLButtonElement>('[data-onboarding-tour]')?.addEventListener('click', () => void handleTour(), { signal });
        form.querySelector<HTMLButtonElement>('[data-portrait-remove]')?.addEventListener('click', () => handlePortraitRemove(form), { signal });
        picture?.addEventListener('change', () => void handlePortraitChange(form, picture), { signal });
    }

    function persistDraft(form: HTMLFormElement) {
        return saveOnboardingDraft({ ...collect(form), step: step + 1 });
    }

    function prefill(form: HTMLFormElement, session: Session | null) {
        if (!session || session.email !== accountEmail) return;

        avatar = session.avatar;
        setRole(form, session.role);
        setValue(form, 'artistName', session.artistName);
    }

    function renderPreview(form: HTMLFormElement) {
        const list = document.querySelector<HTMLElement>('[data-preview-genres]');
        const template = document.querySelector<HTMLTemplateElement>('[data-preview-chip]');
        const tile = document.querySelector<HTMLElement>('.onboarding-preview__tile');
        const values = new FormData(form);

        const artistName = String(values.get('artistName') ?? '').trim();
        const genres = values.getAll('genres').map(String);
        const location = getLocation(values) || DEFAULT_LOCATION;
        const role = getRole(values);

        if (tile) tile.style.background = pickTileColor(artistName);

        document.querySelector<HTMLElement>('[data-preview-genres-empty]')?.toggleAttribute('hidden', genres.length > 0);
        setAvatarImage(document.querySelector<HTMLImageElement>('[data-preview-avatar]'), avatar);
        setHidden(document.querySelector<HTMLElement>('[data-portrait-remove]'), avatar.length === 0);
        setPreviewText(document.querySelector<HTMLElement>('[data-preview-name]'), artistName, 'Your artist name');
        setText(document.querySelector<HTMLElement>('.onboarding-preview__initials'), getInitials(artistName) || '??');
        setText(document.querySelector<HTMLElement>('[data-preview-meta]'), role ? `${role} \u2014 ${location}` : location);

        if (!list || !template) return;

        list.replaceChildren();

        genres.forEach((genre) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            setText(fragment.querySelector('[data-preview-genre]'), genre);
            list.append(fragment);
        });
    }

    function restore(form: HTMLFormElement) {
        const draft = getOnboardingDraft();

        if (draft.email !== accountEmail) return;

        const [draftCity = '', draftState = ''] = draft.location.split(/,\s*/);

        avatar = draft.avatar || avatar;
        step = Math.min(LAST_STEP, Math.max(0, draft.step - 1));
        setChecked(form, 'genres', draft.genres);
        setRole(form, draft.roles[0] ?? '');
        setValue(form, 'artistName', draft.artistName);
        setValue(form, 'city', draftCity);
        setValue(form, 'state', draftState.toUpperCase());
    }

    function setChecked(form: HTMLFormElement, name: string, values: string[]) {
        form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((input) => {
            input.checked = values.includes(input.value);
        });
    }

    function setPreviewText(element: HTMLElement | null, value: string, fallback: string) {
        if (!element) return;

        element.toggleAttribute('data-empty', value.length === 0);
        setText(element, value || fallback);
    }

    function setValue(form: HTMLFormElement, name: string, value: string) {
        const control = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);

        if (!control || !value) return;
        if (control instanceof HTMLSelectElement && !Array.from(control.options).some(option => option.value === value)) return;

        control.value = value;
    }

    function showStep(form: HTMLFormElement, moveFocus: boolean) {
        const back = form.querySelector<HTMLButtonElement>('[data-onboarding-back]');
        const next = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');

        form.querySelectorAll<HTMLElement>('[data-onboarding-pane]').forEach((pane, index) => {
            pane.toggleAttribute('hidden', index !== step);
        });

        document.querySelectorAll<HTMLElement>('[data-onboarding-step]').forEach((marker, index) => {
            if (index === step) marker.setAttribute('aria-current', 'step');
            else marker.removeAttribute('aria-current');
        });

        back?.toggleAttribute('hidden', step === 0);

        setText(next?.querySelector<HTMLElement>('[data-onboarding-next-label]') ?? null, step === LAST_STEP ? 'Finish' : 'Continue');

        setText(document.querySelector<HTMLElement>('[data-onboarding-announce]'), `Step ${step + 1} of ${ONBOARDING_STEPS.length}, ${ONBOARDING_STEPS[step].name}.`);

        armReveal(form);

        if (!moveFocus) return;

        const pane = form.querySelector<HTMLElement>(`[data-onboarding-pane="${step}"]`);

        (pane?.querySelector<HTMLElement>('input') ?? pane?.querySelector<HTMLElement>('legend'))?.focus();
    }

    function showSurface(name: string) {
        document.querySelectorAll<HTMLElement>('[data-onboarding-surface]').forEach((surface) => {
            setHidden(surface, surface.dataset.onboardingSurface !== name);
        });
    }

    async function signIn() {
        if (getSession()?.email === accountEmail) return;

        signedIn = startSession({ email: accountEmail });

        const result = await signedIn;

        if (result.ok) return;

        toast(result.message, 'error');
    }

    function validate(form: HTMLFormElement) {
        const errors = validateFields(form, STEP_RULES[step]);

        if (isValidationBypassed()) return errors;

        const values = new FormData(form);

        if (step === 0 && values.getAll('genres').length > PROFILE_FIELDS.genres.max) errors.genres = PROFILE_FIELDS.genres.message;

        return errors;
    }

    registerPageScript(initOnboardingFlow);
</script>
