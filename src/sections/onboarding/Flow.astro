---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { ARTIST_NAME_MAX_LENGTH, PASSWORD_MIN_LENGTH, QUESTIONNAIRE, USERNAME_PATTERN } from '@lib/constants';

const STEPS = [
    { blurb: 'A handle and a password.', name: 'Account' },
    { blurb: 'What the roster shows.', name: 'Profile' },
    { blurb: 'Four quick questions.', name: 'Questionnaire' },
];

const producers = await getCollection('producers');

const genres = Array.from(new Set(producers.flatMap(producer => producer.data.genres))).sort((a, b) => a.localeCompare(b));
const roles = Array.from(new Set(producers.flatMap(producer => producer.data.roles))).sort((a, b) => a.localeCompare(b));
---

<section
    class="stage stage--focus stage--tight border-b-2 border-ink"
    aria-labelledby="onboarding-title"
>
    <div>
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Account / Onboarding"
            headingId="onboarding-title"
        >
            Finish your profile.
        </PageHead>
        <p
            class="max-w-2xl mt-6 text-lmd text-ink-muted"
            data-motion="blur"
        >
            Three short steps: pick a name and a password, say what you make, and answer four
            questions. Your roster card builds itself alongside you, and nothing outlives this
            browser.
        </p>
    </div>
</section>

<section
    class="stage stage--focus stage--tight"
    aria-label="Onboarding"
>
    <div
        class="onboarding-demo slab slab--sunk flex flex-wrap items-center gap-x-4 gap-y-2"
        data-onboarding-demo
        hidden
    >
        <p class="label px-2 py-1.5 border-2 border-ink bg-accent text-ink">Demo run</p>
        <p class="onboarding-demo__copy text-sm text-ink-muted">
            No welcome link on this URL, so this run uses a stand-in address &mdash; the real one
            arrives by email when you <a class="hover:text-accent-deep underline underline-offset-4 transition-colors" href="/here">check in</a>.
        </p>
    </div>
    <div
        class="onboarding__reject slab slab--card flex flex-col items-start gap-4"
        data-onboarding-complete
        hidden
    >
        <p class="label text-accent-deep">Account / Complete</p>
        <h2 class="font-extrabold font-sans text-3xl tracking-tight">
            You are already set up.
        </h2>
        <p class="max-w-2xl text-md text-ink-muted">
            This account has already been through onboarding, so there is nothing left to fill in.
        </p>
        <a
            class="btn btn--primary"
            href="/sign-in"
        >
            Open your account &rarr;
        </a>
    </div>
    <div
        class="onboarding__flow"
        data-onboarding-flow
    >
        <div class="onboarding__aside">
            <div class="onboarding__rail-block">
                <p
                    id="onboarding-progress-label"
                    class="label mb-4 text-ink-muted"
                >
                    Progress
                </p>
                <ol
                    class="onboarding-rail list-none"
                    aria-labelledby="onboarding-progress-label"
                    data-motion="rise"
                >
                    {STEPS.map((step, index) => (
                        <li
                            class="onboarding-rail__step"
                            aria-current={index === 0 ? 'step' : undefined}
                            data-onboarding-step={index}
                        >
                            <span
                                class="onboarding-rail__node"
                                aria-hidden="true"
                            >
                                <span class="onboarding-rail__index">0{index + 1}</span>
                                <span class="onboarding-rail__check">&check;</span>
                            </span>
                            <span class="onboarding-rail__body">
                                <span class="label onboarding-rail__name">{step.name}</span>
                                <span class="onboarding-rail__blurb">{step.blurb}</span>
                            </span>
                        </li>
                    ))}
                </ol>
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-onboarding-announce
                />
            </div>
            <div
                class="onboarding-preview"
                data-onboarding-preview
            >
                <p class="label mb-3 text-ink-muted">Roster preview</p>
                <article class="onboarding-preview__card slab slab--bare slab--card">
                    <PlaceholderTile
                        class="onboarding-preview__tile aspect-[5/3] border-b-2 border-ink"
                        color="var(--color-ink-subtle)"
                        label="??"
                        labelClass="onboarding-preview__initials leading-none text-[20cqw] text-surface-raised/80 [text-shadow:2px_2px_0_var(--color-ink-20)]"
                    />
                    <div class="onboarding-preview__body p-4">
                        <p
                            class="label mb-1 text-accent-deep wrap-break-word"
                            data-empty
                            data-preview-handle
                        >
                            @yourhandle
                        </p>
                        <h3
                            class="mb-2 font-extrabold font-sans text-lg tracking-tight wrap-break-word"
                            data-empty
                            data-preview-name
                        >
                            Your artist name
                        </h3>
                        <p
                            class="mb-3 font-mono text-2xs uppercase text-ink-muted wrap-break-word"
                            data-preview-meta
                        >
                            Austin, TX
                        </p>
                        <ul
                            class="flex flex-wrap gap-1.5 list-none"
                            data-preview-genres
                        />
                        <p
                            class="font-mono text-2xs uppercase text-ink-subtle"
                            data-preview-genres-empty
                        >
                            Genre tags land here
                        </p>
                    </div>
                </article>
                <p class="mt-3 text-sm text-ink-subtle">
                    A live sketch of your card. It joins the roster once you finish.
                </p>
            </div>
        </div>
        <form
            class="onboarding-form slab slab--card flex flex-col gap-6"
            data-onboarding-form
        >
            <p
                class="action-text px-3 py-3 bg-accent text-ink"
                data-form-error
                hidden
                role="alert"
                tabindex="-1"
            />
            <fieldset
                class="onboarding__pane flex flex-col gap-5"
                data-onboarding-pane="0"
            >
                <legend class="font-extrabold font-sans text-2xl tracking-tight">
                    Account
                </legend>
                <p class="text-smd text-ink-muted">
                    Your handle and a password for this browser-only demo.
                </p>
                <p class="onboarding__account slab slab--sunk flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="label text-ink-subtle">Setting up</span>
                    <span
                        class="font-mono text-sm wrap-break-word"
                        data-onboarding-email
                    />
                </p>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Username</span>
                        <input
                            id="onboarding-username"
                            class="onboarding-field__control font-mono text-sm"
                            aria-describedby="onboarding-username-error"
                            aria-invalid="false"
                            autocomplete="username"
                            name="username"
                            pattern={USERNAME_PATTERN}
                            required
                            type="text"
                        />
                    </label>
                    <p
                        id="onboarding-username-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                    <p class="text-sm text-ink-subtle">
                        Three to twenty letters, numbers, or underscores.
                    </p>
                </div>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Password</span>
                        <input
                            id="onboarding-password"
                            class="onboarding-field__control font-sans"
                            aria-describedby="onboarding-password-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            minlength={PASSWORD_MIN_LENGTH}
                            name="password"
                            required
                            type="password"
                        />
                    </label>
                    <div
                        class="strength flex gap-1"
                        aria-hidden="true"
                    >
                        <span class="strength__bar" />
                        <span class="strength__bar" />
                        <span class="strength__bar" />
                        <span class="strength__bar" />
                    </div>
                    <p
                        class="action-text text-ink-subtle"
                        aria-live="polite"
                        data-strength-label
                    >
                        Strength: nothing typed
                    </p>
                    <p
                        id="onboarding-password-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                    <p class="text-sm text-ink-subtle">
                        At least {PASSWORD_MIN_LENGTH} characters with a letter and a digit. It is
                        never written down &mdash; if you step back to this page you will type it
                        again.
                    </p>
                </div>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Confirm password</span>
                        <input
                            id="onboarding-confirm"
                            class="onboarding-field__control font-sans"
                            aria-describedby="onboarding-confirm-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            name="confirm"
                            required
                            type="password"
                        />
                    </label>
                    <p
                        id="onboarding-confirm-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
            </fieldset>
            <fieldset
                class="onboarding__pane flex flex-col gap-5"
                data-onboarding-pane="1"
                hidden
            >
                <legend class="font-extrabold font-sans text-2xl tracking-tight">
                    Profile
                </legend>
                <p class="text-smd text-ink-muted">
                    What the roster shows about you. Watch the preview card fill in as you type.
                </p>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Artist name</span>
                        <input
                            id="onboarding-artist-name"
                            class="onboarding-field__control font-sans"
                            aria-describedby="onboarding-artist-name-error"
                            aria-invalid="false"
                            autocomplete="nickname"
                            maxlength={ARTIST_NAME_MAX_LENGTH}
                            name="artistName"
                            required
                            type="text"
                        />
                    </label>
                    <p
                        id="onboarding-artist-name-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Location</span>
                        <input
                            id="onboarding-location"
                            class="onboarding-field__control font-sans"
                            aria-describedby="onboarding-location-error"
                            aria-invalid="false"
                            autocomplete="address-level2"
                            name="location"
                            type="text"
                            value="Austin, TX"
                        />
                    </label>
                    <p
                        id="onboarding-location-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <fieldset class="onboarding__group flex flex-col gap-3">
                    <legend class="label onboarding__legend mb-1 text-ink-muted">
                        What do you make? <span class="onboarding__hint">{genres.length} tags &middot; pick at least one</span>
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {genres.map(genre => (
                            <label class="onboarding__chip">
                                <input
                                    class="onboarding__box"
                                    aria-describedby="onboarding-genres-error"
                                    aria-invalid="false"
                                    name="genres"
                                    type="checkbox"
                                    value={genre}
                                />
                                {genre}
                            </label>
                        ))}
                    </div>
                    <p
                        id="onboarding-genres-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </fieldset>
                <fieldset class="onboarding__group flex flex-col gap-3">
                    <legend class="label onboarding__legend mb-1 text-ink-muted">
                        What do you do? <span class="onboarding__hint">{roles.length} tags &middot; optional</span>
                    </legend>
                    <div class="flex flex-wrap gap-2">
                        {roles.map(role => (
                            <label class="onboarding__chip">
                                <input
                                    class="onboarding__box"
                                    aria-describedby="onboarding-roles-error"
                                    aria-invalid="false"
                                    name="roles"
                                    type="checkbox"
                                    value={role}
                                />
                                {role}
                            </label>
                        ))}
                    </div>
                    <p
                        id="onboarding-roles-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </fieldset>
            </fieldset>
            <fieldset
                class="onboarding__pane flex flex-col gap-6"
                data-onboarding-pane="2"
                hidden
            >
                <legend class="font-extrabold font-sans text-2xl tracking-tight">
                    Questionnaire
                </legend>
                <p class="text-smd text-ink-muted">
                    Four quick questions to place you in the room.
                </p>
                {QUESTIONNAIRE.map(question => (question.kind === 'select'
                    ? (
                            <div class="flex flex-col gap-2">
                                <label class="block">
                                    <span class="label block mb-2 text-ink-muted">{question.label}</span>
                                    <span class="select">
                                        <select
                                            id={`onboarding-${question.id}`}
                                            class="onboarding-field__control onboarding-field__control--select font-sans"
                                            aria-describedby={`onboarding-${question.id}-error`}
                                            aria-invalid="false"
                                            name={question.id}
                                            required
                                        >
                                            <option
                                                disabled
                                                selected
                                                value=""
                                            >
                                                Choose one&hellip;
                                            </option>
                                            {question.options.map(option => (
                                                <option value={option.value}>{option.label}</option>
                                            ))}
                                        </select>
                                    </span>
                                </label>
                                <p
                                    id={`onboarding-${question.id}-error`}
                                    class="action-text text-accent-deep"
                                    data-field-error
                                    hidden
                                />
                            </div>
                        )
                    : (
                            <fieldset class="onboarding__group flex flex-col gap-3">
                                <legend class="label onboarding__legend mb-1 text-ink-muted">
                                    {question.label} <span class="onboarding__hint">{question.options.length} options &middot; {question.kind === 'radio' ? 'pick one' : 'pick at least one'}</span>
                                </legend>
                                <div class="flex flex-wrap gap-2">
                                    {question.options.map(option => (
                                        <label class="onboarding__chip">
                                            <input
                                                class="onboarding__box"
                                                aria-describedby={`onboarding-${question.id}-error`}
                                                aria-invalid="false"
                                                name={question.id}
                                                type={question.kind}
                                                value={option.value}
                                            />
                                            {option.label}
                                        </label>
                                    ))}
                                </div>
                                <p
                                    id={`onboarding-${question.id}-error`}
                                    class="action-text text-accent-deep"
                                    data-field-error
                                    hidden
                                />
                            </fieldset>
                        )))}
            </fieldset>
            <div class="onboarding-form__foot">
                <button
                    class="btn"
                    data-onboarding-back
                    hidden
                    type="button"
                >
                    &larr; Back
                </button>
                <button
                    class="btn btn--primary"
                    data-onboarding-next
                    type="submit"
                >
                    Continue &rarr;
                </button>
                <p
                    class="action-text text-ink-subtle"
                    aria-live="polite"
                    data-onboarding-status
                />
                <p
                    class="label onboarding-form__count text-ink-subtle"
                    data-onboarding-count
                >
                    Step 01 / 03
                </p>
            </div>
        </form>
    </div>
    <div
        class="onboarding__done slab slab--well flex flex-col items-start gap-5"
        data-onboarding-done
        hidden
    >
        <p class="label text-accent-light">Done</p>
        <h2
            class="font-extrabold font-sans text-4xl tracking-tight"
            data-onboarding-heading
            tabindex="-1"
        >
            You are in.
        </h2>
        <p
            class="onboarding__handle font-mono text-3xl wrap-break-word"
            data-onboarding-handle
        />
        <ul class="onboarding__stats list-none">
            <li class="onboarding__stat">
                <span class="label text-ink-inverse-muted">Prods balance</span>
                <span
                    class="font-bold font-mono text-md"
                    data-onboarding-prods
                >
                    1 Prod
                </span>
            </li>
            <li class="onboarding__stat">
                <span class="label text-ink-inverse-muted">Profile</span>
                <span class="font-bold font-mono text-md">Complete</span>
            </li>
            <li class="onboarding__stat">
                <span class="label text-ink-inverse-muted">Roster card</span>
                <span class="font-bold font-mono text-md">Live</span>
            </li>
        </ul>
        <p class="max-w-2xl text-md text-ink-inverse-muted">
            Your welcome Prod is on your account. Prods spend like cash in the store, and they add
            up every time you show up.
        </p>
        <p class="max-w-2xl text-smd text-ink-inverse-muted">
            Nothing you typed left this browser, and the draft that carried you between steps has
            been deleted.
        </p>
        <div class="flex flex-wrap gap-3">
            <a
                class="btn btn--accent"
                href="/store"
            >
                Spend your Prod &rarr;
            </a>
            <a
                class="btn"
                href="/producers"
            >
                Meet the roster
            </a>
        </div>
    </div>
    <template data-preview-chip>
        <li
            class="inline-flex items-center h-6 px-2 border-2 border-ink font-bold font-mono text-2xs tracking-wide uppercase"
            data-preview-genre
        />
    </template>
</section>

<style>
    .onboarding-demo {
        margin-bottom: var(--space-lg);
        padding: var(--space-xs) var(--space-sm);
    }

    .onboarding-demo__copy {
        max-width: 60ch;
    }

    .onboarding-field__control {
        background-color: var(--color-surface);
        border: 2px solid var(--color-ink);
        color: var(--color-ink);
        min-height: var(--control-size);
        padding: 0 var(--space-sm);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
        width: 100%;
    }

    .onboarding-field__control:focus-visible {
        background-color: var(--color-surface-raised);
        border-color: var(--color-accent-deep);
    }

    .onboarding-field__control:hover {
        background-color: var(--color-surface-raised);
    }

    .onboarding-field__control[aria-invalid='true'] {
        border-color: var(--color-accent-deep);
        box-shadow: 3px 3px 0 0 var(--color-accent-20);
    }

    .onboarding-field__control--select {
        padding-right: var(--select-pad);
    }

    .onboarding-form {
        padding: var(--space-lg);
    }

    .onboarding-form__count {
        margin-inline-start: auto;
    }

    .onboarding-form__foot {
        align-items: center;
        border-top: 2px solid var(--color-ink);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        padding-top: var(--space-md);
    }

    .onboarding-preview {
        margin-top: var(--space-lg);
    }

    .onboarding-preview__body [data-empty] {
        color: var(--color-ink-subtle);
    }

    .onboarding-rail {
        --rail-node: 34px;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .onboarding-rail__blurb {
        color: var(--color-ink-subtle);
        font-size: var(--text-sm);
        line-height: 1.4;
    }

    .onboarding-rail__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        min-width: 0;
    }

    .onboarding-rail__check {
        display: none;
    }

    .onboarding-rail__name {
        color: var(--color-ink-muted);
        line-height: 1.3;
    }

    .onboarding-rail__node {
        align-items: center;
        background-color: var(--color-surface-raised);
        border: 2px solid var(--color-ink);
        color: var(--color-ink-muted);
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 700;
        height: var(--rail-node);
        justify-content: center;
        line-height: 1;
        transition: background-color var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui);
        width: var(--rail-node);
    }

    .onboarding-rail__step {
        align-items: center;
        column-gap: var(--space-sm);
        display: grid;
        grid-template-columns: var(--rail-node) minmax(0, 1fr);
        position: relative;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__check {
        display: block;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__index {
        display: none;
    }

    .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__node {
        background-color: var(--color-ink);
        border-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .onboarding-rail__step:not(:last-child)::after {
        background-color: var(--color-ink-20);
        bottom: calc(-1 * var(--space-md));
        content: '';
        left: calc(var(--rail-node) / 2 - 1px);
        position: absolute;
        top: var(--rail-node);
        width: 2px;
    }

    .onboarding-rail__step:not(:last-child):has(~ [aria-current='step'])::after {
        background-color: var(--color-ink);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__blurb,
    .onboarding-rail__step[aria-current='step'] .onboarding-rail__name {
        color: var(--color-ink);
    }

    .onboarding-rail__step[aria-current='step'] .onboarding-rail__node {
        background-color: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    .onboarding__account {
        padding: var(--space-xs);
    }

    .onboarding__aside {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .onboarding__box {
        appearance: none;
        background-color: transparent;
        border: 2px solid currentcolor;
        flex-shrink: 0;
        height: 24px;
        margin: 0;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
        width: 24px;
    }

    .onboarding__box:checked {
        background-color: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        box-shadow: inset 0 0 0 4px var(--color-surface-raised);
    }

    .onboarding__box:checked:focus-visible {
        box-shadow:
            inset 0 0 0 4px var(--color-surface-raised),
            0 0 0 2px var(--color-surface),
            0 0 0 4px var(--color-accent-deep);
    }

    .onboarding__chip {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        gap: var(--space-2xs);
        letter-spacing: 0.025em;
        min-height: 50px;
        padding: var(--space-2xs) var(--space-sm);
        text-transform: uppercase;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .onboarding__chip:active {
        background-color: var(--color-surface-sunken);
    }

    .onboarding__chip:has(.onboarding__box:checked) {
        background-color: var(--color-surface-sunken);
    }

    .onboarding__chip:hover {
        background-color: var(--color-surface-sunken);
    }

    .onboarding__done .btn:not(.btn--accent):hover {
        background-color: var(--color-ink-inverse);
        border-color: var(--color-ink-inverse);
        color: var(--color-ink);
    }

    .onboarding__flow {
        align-items: start;
        column-gap: var(--space-2xl);
        display: grid;
        grid-template-columns: minmax(190px, 0.28fr) minmax(0, 1fr);
        row-gap: var(--space-lg);
    }

    .onboarding__group {
        border: 0;
        padding: 0;
    }

    .onboarding__handle {
        color: var(--color-pulse);
    }

    .onboarding__hint {
        color: var(--color-ink-subtle);
        text-transform: none;
    }

    .onboarding__legend {
        line-height: 1.5;
    }

    .onboarding__pane {
        border: 0;
        padding: 0;
    }

    .onboarding__stat {
        border: 2px solid var(--color-ink-inverse);
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        justify-content: center;
        min-height: 50px;
        padding: var(--space-2xs) var(--space-sm);
    }

    .onboarding__stats {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
    }

    .strength__bar {
        background-color: var(--color-ink-20);
        flex: 1;
        height: 6px;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .strength__bar[data-strength-on] {
        background-color: var(--color-accent-deep);
    }

    @media (max-width: 768px) {
        .onboarding-form {
            order: 2;
        }

        .onboarding-preview {
            margin-top: 0;
            order: 3;
        }

        .onboarding-rail {
            --rail-node: 28px;
            border: 2px solid var(--color-ink);
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0;
        }

        .onboarding-rail__blurb {
            display: none;
        }

        .onboarding-rail__step {
            flex: 1 1 150px;
            padding: var(--space-xs);
        }

        .onboarding-rail__step + .onboarding-rail__step {
            border-left: 2px solid var(--color-ink);
        }

        .onboarding-rail__step:not(:last-child)::after {
            content: none;
        }

        .onboarding__aside {
            display: contents;
        }

        .onboarding__flow {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (forced-colors: active) {
        .onboarding-rail__node {
            border-color: CanvasText;
            forced-color-adjust: none;
        }

        .onboarding-rail__step:has(~ [aria-current='step']) .onboarding-rail__node,
        .onboarding-rail__step[aria-current='step'] .onboarding-rail__node {
            background-color: SelectedItem;
            color: SelectedItemText;
        }

        .onboarding__box {
            background-color: Canvas;
            border-color: CanvasText;
            forced-color-adjust: none;
        }

        .onboarding__box:checked {
            background-color: SelectedItem;
            border-color: CanvasText;
            box-shadow: inset 0 0 0 4px Canvas;
        }
    }
</style>

<script>
    import { ONBOARDING_TOKEN_PARAM, PALETTE, QUESTIONNAIRE, USERNAME_TAKEN_MESSAGE } from '@lib/constants';
    import { clearFieldErrors, confirmRule, focusFirstError, passwordRule, setFieldErrors, usernameRule, validateFields } from '@lib/ui/forms';
    import { clearOnboardingDraft, getOnboardingDraft, isReservedUsername, saveOnboardingDraft, scorePassword, verifyOnboardingToken } from '@lib/account/onboarding';
    import { formatProds, getInitials, registerPageScript, setMessage, setPending, setText } from '@lib/utils';
    import { getSession, startSession, updateSession } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const ACCOUNT_RULES: Record<string, FieldRule> = {
        confirm: confirmRule(),
        password: passwordRule(),
        username: usernameRule(),
    };

    const DEFAULT_LOCATION = 'Austin, TX';

    const DEMO_EMAIL = 'demo@austinproduceralliance.com';

    const EMPTY_TILE_COLOR = 'var(--color-ink-subtle)';

    const LAST_STEP = 2;

    const PROFILE_RULES: Record<string, FieldRule> = {
        artistName: { message: 'Enter the name the roster should show.', required: true },
        genres: { message: 'Choose at least one.', required: true },
    };

    const QUESTION_RULES: Record<string, FieldRule> = Object.fromEntries(
        QUESTIONNAIRE.map(question => [question.id, { message: 'Pick an answer to continue.', required: true }]),
    );

    const STEP_NAMES = ['Account', 'Profile', 'Questionnaire'];

    const STEP_RULES = [ACCOUNT_RULES, PROFILE_RULES, QUESTION_RULES];

    const STRENGTH_LABELS = ['nothing typed', 'very weak', 'weak', 'fair', 'strong', 'very strong'];

    let accountEmail = '';
    let step = 0;

    function collect(form: HTMLFormElement) {
        const values = new FormData(form);

        return {
            answers: Object.fromEntries(QUESTIONNAIRE.map(question => [question.id, values.getAll(question.id).map(String)])),
            artistName: String(values.get('artistName') ?? ''),
            email: accountEmail,
            genres: values.getAll('genres').map(String),
            location: String(values.get('location') ?? ''),
            username: String(values.get('username') ?? ''),
        };
    }

    async function complete(form: HTMLFormElement) {
        const button = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');
        const status = form.querySelector<HTMLElement>('[data-onboarding-status]');
        const summary = form.querySelector<HTMLElement>('[data-form-error]');
        const values = new FormData(form);

        const artistName = String(values.get('artistName') ?? '');
        const username = String(values.get('username') ?? '').toLowerCase();

        setPending(button, true);
        setText(status, 'Saving your profile\u2026');

        const result = await startSession({ artistName, email: accountEmail, username });

        if (!result.ok) {
            setPending(button, false);
            setText(status, '');
            setMessage(summary, result.message);
            (summary ?? button)?.focus();

            return;
        }

        await updateSession({ onboarded: true });

        setPending(button, false);
        setText(status, '');
        clearOnboardingDraft();

        const done = document.querySelector<HTMLElement>('[data-onboarding-done]');
        const flow = document.querySelector<HTMLElement>('[data-onboarding-flow]');

        setText(document.querySelector<HTMLElement>('[data-onboarding-handle]'), `@${username}`);
        setText(document.querySelector<HTMLElement>('[data-onboarding-prods]'), formatProds(result.session.prods));
        flow?.setAttribute('hidden', '');
        done?.removeAttribute('hidden');
        document.querySelector<HTMLElement>('[data-onboarding-heading]')?.focus();
        toast('Profile complete. Your welcome Prod is on your account.', 'success');
    }

    function handleBack(form: HTMLFormElement) {
        if (step === 0) return;

        step -= 1;
        saveOnboardingDraft({ ...collect(form), step: step + 1 });
        showStep(form, true);
    }

    function handlePasswordInput(input: HTMLInputElement) {
        const bars = document.querySelectorAll<HTMLElement>('.strength__bar');
        const score = scorePassword(input.value);

        bars.forEach((bar, index) => {
            bar.toggleAttribute('data-strength-on', index < score);
        });

        setText(document.querySelector<HTMLElement>('[data-strength-label]'), `Strength: ${STRENGTH_LABELS[score]}`);
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const summary = form.querySelector<HTMLElement>('[data-form-error]');
        const errors = validate(form);

        clearFieldErrors(form);
        setMessage(summary, '');

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            setMessage(summary, `Step ${step + 1} is not complete yet. Fix the fields below.`);

            return;
        }

        if (step === LAST_STEP) {
            await complete(form);

            return;
        }

        step += 1;
        saveOnboardingDraft({ ...collect(form), passwordSet: true, step: step + 1 });
        showStep(form, true);
    }

    function initOnboardingFlow(signal: AbortSignal) {
        const banner = document.querySelector<HTMLElement>('[data-onboarding-demo]');
        const flow = document.querySelector<HTMLElement>('[data-onboarding-flow]');
        const form = document.querySelector<HTMLFormElement>('[data-onboarding-form]');
        const gate = verifyOnboardingToken(new URLSearchParams(window.location.search).get(ONBOARDING_TOKEN_PARAM));

        if (!flow || !form) return;

        if (getSession()?.onboarded === true) {
            showCompleted(true);

            return;
        }

        accountEmail = gate.state === 'granted' ? gate.email : DEMO_EMAIL;
        step = 0;
        form.noValidate = true;

        banner?.toggleAttribute('hidden', gate.state === 'granted');
        showCompleted(false);
        setText(document.querySelector<HTMLElement>('[data-onboarding-email]'), accountEmail);
        restore(form);
        renderPreview(form);
        showStep(form, false);

        form.addEventListener('input', () => renderPreview(form), { signal });
        form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        form.querySelector<HTMLInputElement>('#onboarding-password')?.addEventListener('input', event => handlePasswordInput(event.currentTarget as HTMLInputElement), { signal });
        form.querySelector<HTMLButtonElement>('[data-onboarding-back]')?.addEventListener('click', () => handleBack(form), { signal });
    }

    function pickTileColor(seed: string) {
        if (seed.length === 0) return EMPTY_TILE_COLOR;

        const total = Array.from(seed).reduce((sum, character) => sum + character.charCodeAt(0), 0);

        return PALETTE[total % PALETTE.length];
    }

    function renderPreview(form: HTMLFormElement) {
        const list = document.querySelector<HTMLElement>('[data-preview-genres]');
        const template = document.querySelector<HTMLTemplateElement>('[data-preview-chip]');
        const tile = document.querySelector<HTMLElement>('.onboarding-preview__tile');
        const values = new FormData(form);

        const artistName = String(values.get('artistName') ?? '').trim();
        const genres = values.getAll('genres').map(String);
        const location = String(values.get('location') ?? '').trim() || DEFAULT_LOCATION;
        const roles = values.getAll('roles').map(String);
        const username = String(values.get('username') ?? '').trim();

        if (tile) tile.style.background = pickTileColor(artistName || username);

        setText(document.querySelector<HTMLElement>('.onboarding-preview__initials'), getInitials(artistName) || '??');
        setText(document.querySelector<HTMLElement>('[data-preview-meta]'), roles.length > 0 ? `${roles.join(' \u00b7 ')} \u2014 ${location}` : location);
        setPreviewText(document.querySelector<HTMLElement>('[data-preview-handle]'), username ? `@${username}` : '', '@yourhandle');
        setPreviewText(document.querySelector<HTMLElement>('[data-preview-name]'), artistName, 'Your artist name');
        document.querySelector<HTMLElement>('[data-preview-genres-empty]')?.toggleAttribute('hidden', genres.length > 0);

        if (!list || !template) return;

        list.replaceChildren();

        genres.forEach((genre) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            setText(fragment.querySelector('[data-preview-genre]'), genre);
            list.append(fragment);
        });
    }

    function restore(form: HTMLFormElement) {
        const draft = getOnboardingDraft();

        if (draft.email !== accountEmail) return;

        setValue(form, 'artistName', draft.artistName);
        setValue(form, 'location', draft.location);
        setValue(form, 'username', draft.username);
        setChecked(form, 'genres', draft.genres);

        QUESTIONNAIRE.forEach((question) => {
            const answers = draft.answers[question.id] ?? [];

            if (question.kind === 'select') setValue(form, question.id, answers.at(0) ?? '');
            else setChecked(form, question.id, answers);
        });

        step = Math.min(LAST_STEP, Math.max(0, draft.step - 1));
    }

    function setChecked(form: HTMLFormElement, name: string, values: string[]) {
        form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((input) => {
            input.checked = values.includes(input.value);
        });
    }

    function setPreviewText(element: HTMLElement | null, value: string, fallback: string) {
        if (!element) return;

        element.toggleAttribute('data-empty', value.length === 0);
        setText(element, value || fallback);
    }

    function setValue(form: HTMLFormElement, name: string, value: string) {
        const control = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);

        if (control && value) control.value = value;
    }

    function showCompleted(completed: boolean) {
        document.querySelector<HTMLElement>('[data-onboarding-complete]')?.toggleAttribute('hidden', !completed);
        document.querySelector<HTMLElement>('[data-onboarding-flow]')?.toggleAttribute('hidden', completed);
    }

    function showStep(form: HTMLFormElement, moveFocus: boolean) {
        const back = form.querySelector<HTMLButtonElement>('[data-onboarding-back]');
        const next = form.querySelector<HTMLButtonElement>('[data-onboarding-next]');

        form.querySelectorAll<HTMLElement>('[data-onboarding-pane]').forEach((pane, index) => {
            pane.toggleAttribute('hidden', index !== step);
        });

        document.querySelectorAll<HTMLElement>('[data-onboarding-step]').forEach((marker, index) => {
            if (index === step) marker.setAttribute('aria-current', 'step');
            else marker.removeAttribute('aria-current');
        });

        back?.toggleAttribute('hidden', step === 0);

        if (next) next.textContent = step === LAST_STEP ? 'Finish \u2192' : 'Continue \u2192';

        setText(document.querySelector<HTMLElement>('[data-onboarding-announce]'), `Step ${step + 1} of ${STEP_NAMES.length}, ${STEP_NAMES[step]}`);
        setText(document.querySelector<HTMLElement>('[data-onboarding-count]'), `Step 0${step + 1} / 0${STEP_NAMES.length}`);

        if (moveFocus) form.querySelector<HTMLElement>(`[data-onboarding-pane="${step}"] input, [data-onboarding-pane="${step}"] select`)?.focus();
    }

    function validate(form: HTMLFormElement) {
        const errors = validateFields(form, STEP_RULES[step]);

        if (step !== 0) return errors;

        const values = new FormData(form);
        const password = String(values.get('password') ?? '');
        const username = String(values.get('username') ?? '');

        if (!errors.username && isReservedUsername(username)) errors.username = USERNAME_TAKEN_MESSAGE;
        if (!errors.password && wouldEcho(password, username)) errors.password = 'Your password cannot repeat your username or your email.';

        return errors;
    }

    function wouldEcho(password: string, username: string) {
        const candidate = password.toLowerCase();
        const local = accountEmail.split('@').at(0) ?? '';

        return candidate === username.toLowerCase() || candidate === local.toLowerCase();
    }

    registerPageScript(initOnboardingFlow);
</script>
