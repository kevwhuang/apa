---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PageHead from '@components/shared/PageHead.astro';
import { PASSWORD_MIN_LENGTH } from '@lib/shared/constants';
---

<section
    class="signin-stage stage stage--tight"
    aria-labelledby="signin-title"
>
    <div class="flex flex-col gap-8">
        <PageHead
            class="text-4xl text-center"
            headingId="signin-title"
        >
            Let's get you in
        </PageHead>
        <div
            class="signin slab slab--bare slab--card max-w-xl w-full mx-auto"
            data-motion="unfold"
        >
            <fieldset class="grid grid-cols-2 min-w-0 border-b-2 border-border-strong">
                <legend class="sr-only">What do you want to do?</legend>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signin"
                        class="signin__radio"
                        checked
                        name="mode"
                        type="radio"
                    />
                    Sign in
                </label>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signup"
                        class="signin__radio"
                        name="mode"
                        type="radio"
                    />
                    Create account
                </label>
            </fieldset>
            <form
                class="signin__panel--in flex flex-col gap-6 p-(--space-lg)"
                data-auth-form="signin"
            >
                <h2 class="sr-only">
                    Sign in
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Email</span>
                        <input
                            id="signin-email"
                            class="input font-mono"
                            aria-describedby="signin-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signin-email-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Password</span>
                        <span class="block relative">
                            <input
                                id="signin-password"
                                class="input pr-12 font-sans"
                                aria-describedby="signin-password-error"
                                aria-invalid="false"
                                autocomplete="current-password"
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signin-password"
                                type="button"
                            >
                                <span class="signin__glyph--show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph--hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signin-password-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <button
                    class="btn btn--primary self-start"
                    type="submit"
                >
                    Sign in <IconArrow />
                </button>
            </form>
            <form
                class="signin__panel--up flex flex-col gap-6 p-(--space-lg)"
                data-auth-form="signup"
            >
                <h2 class="sr-only">
                    Create account
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Email</span>
                        <input
                            id="signup-email"
                            class="input font-mono"
                            aria-describedby="signup-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signup-email-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Password</span>
                        <span class="block relative">
                            <input
                                id="signup-password"
                                class="input pr-12 font-sans"
                                aria-describedby="signup-password-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                minlength={PASSWORD_MIN_LENGTH}
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-password"
                                type="button"
                            >
                                <span class="signin__glyph--show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph--hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-password-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Confirm password</span>
                        <span class="block relative">
                            <input
                                id="signup-confirm"
                                class="input pr-12 font-sans"
                                aria-describedby="signup-confirm-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                name="confirm"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-confirm"
                                type="button"
                            >
                                <span class="signin__glyph--show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph--hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-confirm-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <button
                    class="btn btn--primary self-start"
                    type="submit"
                >
                    Create account <IconArrow />
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .signin-stage {
        display: var(--session-out-only, grid);
    }

    .signin:has(#mode-signup:checked) .signin__panel--in {
        display: none;
    }

    .signin:not(:has(#mode-signup:checked)) .signin__panel--up {
        display: none;
    }

    .signin__radio {
        appearance: none;
        height: 0;
        margin: 0;
        opacity: 0;
        position: absolute;
        width: 0;
    }

    .signin__reveal {
        align-items: center;
        bottom: 0;
        color: var(--color-text-secondary);
        cursor: pointer;
        display: flex;
        justify-content: center;
        position: absolute;
        right: 0;
        top: 0;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .signin__reveal:active {
        transform: translateY(1px);
    }

    .signin__reveal:focus-visible {
        outline-offset: -4px;
    }

    .signin__reveal:hover {
        color: var(--color-link);
    }

    .signin__reveal::after {
        content: '';
        height: 48px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
    }

    .signin__reveal[aria-pressed='false'] .signin__glyph--hide,
    .signin__reveal[aria-pressed='true'] .signin__glyph--show {
        display: none;
    }

    .signin__tab {
        align-items: center;
        background-color: var(--color-bg-page);
        color: var(--color-tab-text);
        cursor: pointer;
        display: flex;
        justify-content: center;
        min-height: 52px;
        padding: var(--space-2xs);
        text-align: center;
        user-select: none;
        white-space: nowrap;
    }

    .signin__tab + .signin__tab {
        border-left: 2px solid var(--color-border-strong);
    }

    .signin__tab:active {
        background-color: var(--color-bg-active);
    }

    .signin__tab:has(.signin__radio:checked) {
        --color-focus-ring: var(--color-focus-ring-offset);
        background-color: var(--color-bg-inverse);
        color: var(--color-text-inverse);
    }

    .signin__tab:has(.signin__radio:focus-visible) {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: -4px;
    }

    .signin__tab:hover:not(:has(.signin__radio:checked)) {
        background-color: var(--color-bg-hover);
        color: var(--color-tab-text-hover);
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { clearFieldErrors, focusFirstError, getConfirmRule, getPasswordRule, handleReveal, readEmail, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { getSession, onSessionChange, startSession } from '@lib/account/session';
    import { registerPageScript, setPending } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const ERROR_FIELDS: Record<SessionErrorCode, string> = {
        'already-registered': 'email',
        'invalid-credentials': 'password',
        'invalid-email': 'email',
        'storage-full': 'email',
        'weak-password': 'password',
    };

    const SIGNIN_RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        password: { message: 'Enter your password.', required: true },
    };

    const SIGNUP_RULES: Record<string, FieldRule> = {
        confirm: getConfirmRule(),
        email: { message: 'Enter your email address.', required: true },
        password: getPasswordRule(),
    };

    let isSubmitting = false;
    let unsubscribe: (() => void) | undefined;

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const isSignup = form.dataset.authForm === 'signup';
        const values = new FormData(form);

        const rules = isSignup ? SIGNUP_RULES : SIGNIN_RULES;

        const errors = validateFields(form, rules);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);
        isSubmitting = true;

        const result = await startSession({
            email: readEmail(values),
            password: String(values.get('password') ?? ''),
        });

        isSubmitting = false;
        setPending(button, false);

        if (!result.ok) {
            const failure = { [ERROR_FIELDS[result.code]]: result.message };

            setFieldErrors(form, failure);
            focusFirstError(form, failure);

            return;
        }

        const message = isSignup ? 'Account created. You are signed in.' : `Signed in as ${result.session.artistName || result.session.email}.`;

        form.reset();
        toast(message, 'success');

        await navigate('/settings');
    }

    function initSignInForm(signal: AbortSignal) {
        const forms = document.querySelectorAll<HTMLFormElement>('[data-auth-form]');
        const reveals = document.querySelectorAll<HTMLButtonElement>('[data-reveal]');

        if (forms.length === 0) return;

        if (getSession()) {
            void navigate('/settings', { history: 'replace' });

            return;
        }

        unsubscribe?.();

        unsubscribe = onSessionChange((session) => {
            if (!isSubmitting && session) void navigate('/settings');
        });

        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });

        forms.forEach((form) => {
            form.noValidate = true;
            form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        });

        reveals.forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });
    }

    registerPageScript(initSignInForm);
</script>
