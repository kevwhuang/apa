---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PageHead from '@components/shared/PageHead.astro';
import { PASSWORD_MIN_LENGTH } from '@lib/shared/constants';
---

<section
    class="signin-stage stage stage--tight"
    aria-labelledby="signin-title"
>
    <div class="flex flex-col gap-8">
        <PageHead
            class="text-4xl text-center"
            headingId="signin-title"
        >
            Let's get you in
        </PageHead>
        <div
            class="signin slab slab--bare slab--card max-w-xl w-full mx-auto"
            data-motion="unfold"
        >
            <fieldset class="grid grid-cols-2 min-w-0 border-b-2 border-border-strong">
                <legend class="sr-only">What do you want to do?</legend>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signin"
                        class="signin__radio sr-only"
                        checked
                        data-auth-mode="signin"
                        name="mode"
                        type="radio"
                    />
                    Sign in
                </label>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signup"
                        class="signin__radio sr-only"
                        name="mode"
                        type="radio"
                    />
                    Create account
                </label>
            </fieldset>
            <form
                class="signin__in flex flex-col gap-6 p-(--space-lg)"
                data-auth-form="signin"
                method="post"
            >
                <h2 class="sr-only">
                    Sign in
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Email</span>
                        <input
                            id="signin-email"
                            class="input font-mono"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Password</span>
                        <span class="block relative">
                            <input
                                id="signin-password"
                                class="input input--trailing"
                                aria-invalid="false"
                                autocomplete="current-password"
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signin-password"
                                type="button"
                            >
                                <span class="reveal__show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="reveal__hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <button
                        class="btn btn--primary"
                        type="submit"
                    >
                        Sign in <IconArrow />
                    </button>
                    <button
                        class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                        data-auth-reset
                        type="button"
                    >
                        Forgot password
                    </button>
                </div>
            </form>
            <form
                class="signin__up flex flex-col gap-6 p-(--space-lg)"
                data-auth-form="signup"
                method="post"
            >
                <h2 class="sr-only">
                    Create account
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Email</span>
                        <input
                            id="signup-email"
                            class="input font-mono"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Password</span>
                        <span class="block relative">
                            <input
                                id="signup-password"
                                class="input input--trailing"
                                aria-describedby="signup-password-help"
                                aria-invalid="false"
                                autocomplete="new-password"
                                minlength={PASSWORD_MIN_LENGTH}
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-password"
                                type="button"
                            >
                                <span class="reveal__show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="reveal__hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-password-help"
                        class="text-base text-text-secondary"
                    >
                        At least {PASSWORD_MIN_LENGTH} characters with a letter and a digit.
                    </p>
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-text-secondary">Confirm password</span>
                        <span class="block relative">
                            <input
                                id="signup-confirm"
                                class="input input--trailing"
                                aria-invalid="false"
                                autocomplete="new-password"
                                name="confirm"
                                required
                                type="password"
                            />
                            <button
                                class="reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-confirm"
                                type="button"
                            >
                                <span class="reveal__show flex items-center">
                                    <IconEye />
                                </span>
                                <span class="reveal__hide flex items-center">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                </div>
                <button
                    class="btn btn--primary self-start"
                    type="submit"
                >
                    Create account <IconArrow />
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .signin-stage {
        display: var(--session-out-only, grid);
    }

    .signin:has(#mode-signup:checked) .signin__in {
        display: none;
    }

    .signin:not(:has(#mode-signup:checked)) .signin__up {
        display: none;
    }

    .signin__tab {
        align-items: center;
        background-color: var(--color-bg-page);
        color: var(--color-tab-text);
        display: flex;
        justify-content: center;
        min-height: 52px;
        padding: 8px;
        text-align: center;
        user-select: none;
        white-space: nowrap;
    }

    .signin__tab + .signin__tab {
        border-left: 2px solid var(--color-border-strong);
    }

    .signin__tab:active {
        background-color: var(--color-bg-active);
    }

    .signin__tab:has(.signin__radio:checked) {
        --color-focus-ring: var(--color-focus-ring-offset);
        background-color: var(--color-bg-inverse);
        color: var(--color-text-inverse);
    }

    .signin__tab:has(.signin__radio:focus-visible) {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: -4px;
    }

    .signin__tab:hover:not(:has(.signin__radio:checked)) {
        background-color: var(--color-bg-hover);
        color: var(--color-tab-text-hover);
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { EMAIL_REQUIRED_MESSAGE } from '@lib/shared/constants';
    import { clearAuthLink, createAccount, getAuthLink, getSession, onSessionChange, requestPasswordReset, startSession } from '@lib/account/session';
    import { clearFieldErrors, getConfirmRule, getPasswordRule, handleReveal, reportFieldErrors, validateFields, watchFieldErrors } from '@lib/ui/forms';
    import { getNextPath } from '@lib/account/guard';
    import { registerPageScript, setPending } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const EMAIL_RULE: FieldRule = { message: EMAIL_REQUIRED_MESSAGE, required: true };

    const ERROR_FIELDS: Partial<Record<SessionErrorCode, string>> = {
        'already-registered': 'email',
        'invalid-credentials': 'password',
        'invalid-email': 'email',
        'unconfirmed': 'email',
        'weak-password': 'password',
    };

    const EXPIRED_LINK_MESSAGE = 'That link has expired. Use Forgot password for a new one.';
    const RESET_MESSAGE = 'If that address has an account, a reset link is on its way.';

    const RESET_RULES: Record<string, FieldRule> = {
        email: EMAIL_RULE,
    };

    const SIGNIN_RULES: Record<string, FieldRule> = {
        email: EMAIL_RULE,
        password: { message: 'Enter your password.', required: true },
    };

    const SIGNUP_RULES: Record<string, FieldRule> = {
        confirm: getConfirmRule(),
        email: EMAIL_RULE,
        password: getPasswordRule(),
    };

    let isSubmitting = false;
    let unsubscribe: (() => void) | undefined;

    async function handleReset(button: HTMLButtonElement) {
        const { form } = button;

        if (!form) return;

        const errors = validateFields(form, RESET_RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        setPending(button, true);

        await requestPasswordReset(String(new FormData(form).get('email') ?? '').trim());

        setPending(button, false);
        toast(RESET_MESSAGE, 'info');
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement, signal: AbortSignal) {
        event.preventDefault();

        if (isSubmitting) return;

        const isSignup = form.dataset.authForm === 'signup';
        const values = new FormData(form);

        const rules = isSignup ? SIGNUP_RULES : SIGNIN_RULES;

        const errors = validateFields(form, rules);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const draft = { email: String(values.get('email') ?? '').trim(), password: String(values.get('password') ?? '') };

        isSubmitting = true;
        setPending(button, true);

        const result = isSignup ? await createAccount(draft) : await startSession(draft);

        if (signal.aborted) return;

        setPending(button, false);

        if (!result.ok) {
            const field = ERROR_FIELDS[result.code];

            isSubmitting = false;

            if (field) reportFieldErrors(form, { [field]: result.message });
            else toast(result.message, 'error');

            return;
        }

        form.reset();

        if (result.session) {
            toast(isSignup ? 'Account created. You are signed in.' : `Signed in as ${result.session.artistName || result.session.email}.`, 'success');

            await navigate(getNextPath());
        } else {
            showConfirmation(draft.email);
        }

        isSubmitting = false;
    }

    function initSignInForm(signal: AbortSignal) {
        const forms = document.querySelectorAll<HTMLFormElement>('[data-auth-form]');
        const reset = document.querySelector<HTMLButtonElement>('[data-auth-reset]');
        const reveals = document.querySelectorAll<HTMLButtonElement>('[data-reveal]');

        if (forms.length === 0) return;

        if (getSession()) {
            void navigate(getNextPath(), { history: 'replace' });

            return;
        }

        isSubmitting = false;
        unsubscribe?.();

        unsubscribe = onSessionChange((session) => {
            if (!isSubmitting && session) void navigate(getNextPath());
        });

        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });

        forms.forEach((form) => {
            form.noValidate = true;
            form.addEventListener('submit', event => void handleSubmit(event, form, signal), { signal });
            watchFieldErrors(form, signal);
        });

        reset?.addEventListener('click', () => void handleReset(reset), { signal });

        reveals.forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });

        if (getAuthLink() !== 'expired') return;

        clearAuthLink();
        toast(EXPIRED_LINK_MESSAGE, 'error');
    }

    function showConfirmation(email: string) {
        const mode = document.querySelector<HTMLInputElement>('[data-auth-mode="signin"]');
        const signin = document.querySelector<HTMLFormElement>('[data-auth-form="signin"]');

        const address = signin?.querySelector<HTMLInputElement>('[name="email"]');

        if (address) address.value = email;
        if (mode) mode.checked = true;

        signin?.querySelector<HTMLInputElement>('[name="password"]')?.focus();
        toast(`Check your inbox to confirm ${email}, then sign in.`, 'info');
    }

    registerPageScript(initSignInForm);
</script>
