---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PageHead from '@components/shared/PageHead.astro';
import { PASSWORD_MIN_LENGTH } from '@lib/shared/constants';
---

<section
    class="signin-stage stage stage--tight"
    aria-labelledby="signin-title"
>
    <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-6">
            <PageHead
                class="font-extrabold font-sans text-4xl text-center tracking-tight"
                eyebrow="Account"
                eyebrowClass="mb-4 text-center"
                headingId="signin-title"
            >
                Sign in.
            </PageHead>
            <p
                class="max-w-2xl mx-auto text-center text-lmd text-ink-muted"
                data-motion="rise"
            >
                One address, one password &mdash; the same account at the door, the store, and your settings.
            </p>
        </div>
        <div
            class="signin slab slab--bare slab--card"
            data-motion="unfold"
        >
            <fieldset class="signin__modes">
                <legend class="sr-only">What do you want to do?</legend>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signin"
                        class="signin__radio"
                        checked
                        name="mode"
                        type="radio"
                    />
                    Sign in
                </label>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signup"
                        class="signin__radio"
                        name="mode"
                        type="radio"
                    />
                    Create account
                </label>
            </fieldset>
            <form
                class="signin__panel signin__panel--in flex flex-col gap-6"
                data-auth-form="signin"
            >
                <h2 class="sr-only">
                    Sign in
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Email</span>
                        <input
                            id="signin-email"
                            class="input font-mono text-sm"
                            aria-describedby="signin-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signin-email-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Password</span>
                        <span class="signin__control">
                            <input
                                id="signin-password"
                                class="input pr-12 font-sans"
                                aria-describedby="signin-password-error"
                                aria-invalid="false"
                                autocomplete="current-password"
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signin-password"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signin-password-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <button
                    class="btn btn--primary self-start"
                    type="submit"
                >
                    Come in <IconArrow />
                </button>
            </form>
            <form
                class="signin__panel signin__panel--up flex flex-col gap-6"
                data-auth-form="signup"
            >
                <h2 class="sr-only">
                    Create account
                </h2>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Email</span>
                        <input
                            id="signup-email"
                            class="input font-mono text-sm"
                            aria-describedby="signup-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signup-email-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Password</span>
                        <span class="signin__control">
                            <input
                                id="signup-password"
                                class="input pr-12 font-sans"
                                aria-describedby="signup-password-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                minlength={PASSWORD_MIN_LENGTH}
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-password"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-password-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Confirm password</span>
                        <span class="signin__control">
                            <input
                                id="signup-confirm"
                                class="input pr-12 font-sans"
                                aria-describedby="signup-confirm-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                name="confirm"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-confirm"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-confirm-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <button
                    class="btn btn--primary self-start"
                    type="submit"
                >
                    Open your account <IconArrow />
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .signin {
        margin-inline: auto;
        max-width: var(--measure-form);
        width: 100%;
    }

    .signin:has(#mode-signup:checked) .signin__panel--in {
        display: none;
    }

    .signin:not(:has(#mode-signup:checked)) .signin__panel--up {
        display: none;
    }

    .signin__control {
        display: block;
        position: relative;
    }

    .signin__glyph {
        align-items: center;
        display: flex;
    }

    .signin__modes {
        border: 0;
        border-bottom: 2px solid var(--color-ink);
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin: 0;
        min-inline-size: 0;
        padding: 0;
    }

    .signin__panel {
        padding: var(--space-lg);
    }

    .signin__radio {
        appearance: none;
        height: 0;
        margin: 0;
        opacity: 0;
        position: absolute;
        width: 0;
    }

    .signin__reveal {
        align-items: center;
        bottom: 0;
        color: var(--color-ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: center;
        position: absolute;
        right: 0;
        top: 0;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .signin__reveal::after {
        content: '';
        height: 48px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
    }

    .signin__reveal:active {
        transform: translateY(1px);
    }

    .signin__reveal:focus-visible {
        outline-offset: -4px;
    }

    .signin__reveal:hover {
        color: var(--color-accent-deep);
    }

    .signin__reveal[aria-pressed='false'] .signin__glyph--hide,
    .signin__reveal[aria-pressed='true'] .signin__glyph--show {
        display: none;
    }

    .signin__tab {
        align-items: center;
        background-color: var(--color-surface);
        color: var(--color-ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: center;
        min-height: 52px;
        padding: var(--space-2xs) var(--space-sm);
        text-align: center;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
    }

    .signin__tab + .signin__tab {
        border-left: 2px solid var(--color-ink);
    }

    .signin__tab:active {
        background-color: var(--color-surface-sunken);
    }

    .signin__tab:has(.signin__radio:checked) {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .signin__tab:has(.signin__radio:focus-visible) {
        outline: 2px solid var(--color-accent-deep);
        outline-offset: -4px;
    }

    .signin__tab:hover:not(:has(.signin__radio:checked)) {
        background-color: var(--color-surface-sunken);
        color: var(--color-ink);
    }

    :global([data-session='in']) .signin-stage {
        display: none;
    }

    @media (forced-colors: active) {
        .signin__tab:has(.signin__radio:checked) {
            background-color: SelectedItem;
            color: SelectedItemText;
            forced-color-adjust: none;
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { clearFieldErrors, confirmRule, focusFirstError, isValidationBypassed, passwordRule, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { getSession, onSessionChange, startSession } from '@lib/account/session';
    import { registerPageScript, setPending } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const ERROR_FIELDS: Record<SessionErrorCode, string> = {
        'already-registered': 'email',
        'invalid-credentials': 'password',
        'invalid-email': 'email',
        'weak-password': 'password',
    };

    const PLACEHOLDER_EMAIL = 'you@studio.fm';

    const SIGNIN_RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        password: { message: 'Enter your password.', required: true },
    };

    const SIGNUP_RULES: Record<string, FieldRule> = {
        confirm: confirmRule(),
        email: { message: 'Enter your email address.', required: true },
        password: passwordRule(),
    };

    let unsubscribe: (() => void) | undefined;

    function handleReveal(button: HTMLButtonElement) {
        const input = document.getElementById(button.dataset.reveal ?? '');
        const shown = button.getAttribute('aria-pressed') === 'true';

        if (!(input instanceof HTMLInputElement)) return;

        button.setAttribute('aria-label', shown ? 'Show password' : 'Hide password');
        button.setAttribute('aria-pressed', shown ? 'false' : 'true');
        input.type = shown ? 'password' : 'text';
    }

    function handleSessionChange(session: Session | null) {
        if (session) void navigate('/settings');
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const signup = form.dataset.authForm === 'signup';

        const rules = signup ? SIGNUP_RULES : SIGNIN_RULES;
        const values = new FormData(form);

        const errors = validateFields(form, rules);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        const result = await startSession({
            email: readEmail(values),
            password: String(values.get('password') ?? ''),
        });

        setPending(button, false);

        if (!result.ok) {
            const failure = { [ERROR_FIELDS[result.code]]: result.message };

            setFieldErrors(form, failure);
            focusFirstError(form, failure);

            return;
        }

        const message = signup ? 'Account created. You are signed in.' : `Signed in as ${sessionLabel(result.session)}.`;

        form.reset();
        toast(message, 'success');

        await navigate('/settings');
    }

    function initSignInForm(signal: AbortSignal) {
        const forms = document.querySelectorAll<HTMLFormElement>('[data-auth-form]');
        const reveals = document.querySelectorAll<HTMLButtonElement>('[data-reveal]');

        if (forms.length === 0) return;

        if (getSession()) {
            void navigate('/settings', { history: 'replace' });

            return;
        }

        unsubscribe?.();
        unsubscribe = onSessionChange(handleSessionChange);
        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });

        forms.forEach((form) => {
            form.noValidate = true;
            form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        });

        reveals.forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });
    }

    function readEmail(values: FormData) {
        const email = String(values.get('email') ?? '').trim();

        if (email.length > 0 || !isValidationBypassed()) return email;

        return PLACEHOLDER_EMAIL;
    }

    function sessionLabel(session: Session) {
        return session.artistName || session.email;
    }

    registerPageScript(initSignInForm);
</script>
