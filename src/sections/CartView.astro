---
import PageHead from '@components/PageHead.astro';
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="cart-title"
>
    <div class="shell shell--narrow">
        <PageHead
            class="font-extrabold font-sans text-5xl tracking-[-0.03em]"
            eyebrow="Your cart"
            headingId="cart-title"
        >
            Cart
        </PageHead>
    </div>
</section>

<section
    class="py-16"
    aria-label="Cart contents"
>
    <div class="reveal--stagger shell shell--narrow grid grid-cols-1 gap-12 md:grid-cols-[1.5fr_1fr]">
        <ul class="cart-items space-y-4 list-none" />
        <aside class="self-start p-6 border-2 border-ink bg-cream">
            <h2 class="label mb-4 text-taupe">Summary</h2>
            <dl class="space-y-2 font-mono text-[14px]">
                <div class="flex justify-between">
                    <dt>Subtotal</dt>
                    <dd
                        aria-live="polite"
                        data-subtotal
                    >
                        $0.00
                    </dd>
                </div>
                <div class="flex justify-between">
                    <dt>Shipping</dt>
                    <dd>&mdash;</dd>
                </div>
                <div class="flex justify-between mt-3 pt-3 border-t-2 border-ink font-extrabold font-sans text-lg">
                    <dt>Total</dt>
                    <dd
                        aria-live="polite"
                        data-total
                    >
                        $0.00
                    </dd>
                </div>
            </dl>
            <a
                class="btn btn--primary cart-checkout h-12 w-full mt-6"
                href="/store/checkout"
            >
                Checkout
            </a>
        </aside>
    </div>
</section>

<style>
    .cart-checkout {
        transition: background var(--duration-fast) ease, border-color var(--duration-fast) ease, color var(--duration-fast) ease, opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
    }

    .cart-checkout[aria-disabled='true'] {
        cursor: not-allowed;
        opacity: 0.4;
    }

    .cart-checkout[aria-disabled='true']:active {
        transform: none;
    }

    .cart-checkout[aria-disabled='true']:hover {
        background: var(--color-ink);
        border-color: var(--color-ink);
        color: var(--color-sand);
    }

    :global(.cart-item__step::after) {
        content: '';
        inset: -6px;
        position: absolute;
    }

    :global(.cart-item__tile::before) {
        background-image: radial-gradient(circle, var(--color-ink) 0.8px, transparent 0.8px);
        background-size: 6px 6px;
        content: '';
        inset: 0;
        opacity: 0.06;
        position: absolute;
    }
</style>

<script>
    import { getItems, onChange, remove, setQuantity, subtotalCents } from '@lib/store';
    import { escapeHtml, formatPrice, formatVariant, PALETTE } from '@lib/utils';

    const cardColors = PALETTE.slice(0, 4);

    let cartViewController: AbortController | undefined;
    let cartViewUnsubscribe: (() => void) | undefined;

    function handleCheckoutClick(event: Event, checkout: HTMLElement) {
        if (checkout.getAttribute('aria-disabled') === 'true') event.preventDefault();
    }

    function handleDecreaseClick(button: HTMLElement) {
        const index = Number(button.dataset.decrease);

        setQuantity(index, getItems()[index].quantity - 1);
    }

    function handleIncreaseClick(button: HTMLElement) {
        const index = Number(button.dataset.increase);

        setQuantity(index, getItems()[index].quantity + 1);
    }

    function handleRemoveClick(button: HTMLElement) {
        remove(Number(button.dataset.remove));
    }

    function initCartView() {
        cartViewController?.abort();
        cartViewController = new AbortController();
        cartViewUnsubscribe?.();

        const { signal } = cartViewController;

        const checkout = document.querySelector<HTMLElement>('.cart-checkout');
        const list = document.querySelector<HTMLElement>('.cart-items');

        if (!checkout || !list) return;

        updateCart(checkout, list);
        cartViewUnsubscribe = onChange(() => updateCart(checkout, list));
        checkout.addEventListener('click', event => handleCheckoutClick(event, checkout), { signal });
    }

    function updateCart(checkout: HTMLElement, list: HTMLElement) {
        const items = getItems();

        if (items.length === 0) {
            checkout.setAttribute('aria-disabled', 'true');
            list.innerHTML = `
                <li class='p-12 border-2 border-ink text-center'>
                    <p class='label mb-3 text-taupe'>Empty</p>
                    <p class='mb-6 font-extrabold font-sans text-2xl'>Nothing in the cart yet.</p>
                    <a class='btn btn--primary h-11' href='/store'>Browse the store</a>
                </li>
            `;
        } else {
            checkout.removeAttribute('aria-disabled');
            list.innerHTML = items.map((item, index) => `
                <li class='card flex gap-5 p-5'>
                    <div class='cart-item__tile flex items-center justify-center overflow-hidden relative shrink-0 h-28 w-28' aria-hidden='true' style='background: ${cardColors[index % cardColors.length]};'>
                        <span class='font-extrabold font-sans text-xl uppercase text-white/80 mix-blend-overlay select-none'>${escapeHtml(item.title.split(' ')[0])}</span>
                    </div>
                    <div class='flex-1 min-w-0'>
                        <p class='font-extrabold font-sans'>${escapeHtml(item.title)}</p>
                        <p class='label mt-1 text-taupe'>${escapeHtml(formatVariant(item))}</p>
                        <div class='flex flex-wrap items-center gap-4 mt-4'>
                            <div class='inline-flex items-center border-2 border-ink'>
                                <button class='cart-item__step active:text-coral-dark hover:text-coral-dark relative h-9 w-9 font-bold transition-colors' aria-label='Decrease quantity' data-decrease='${index}' type='button'>\u2212</button>
                                <span class='w-9 font-bold font-mono text-center'>${item.quantity}</span>
                                <button class='cart-item__step active:text-coral-dark hover:text-coral-dark relative h-9 w-9 font-bold transition-colors' aria-label='Increase quantity' data-increase='${index}' type='button'>+</button>
                            </div>
                            <button class='label active:text-coral-dark hover:text-coral-dark text-taupe transition-colors' data-remove='${index}' type='button'>Remove</button>
                            <span class='ml-auto font-bold font-mono'>${formatPrice(item.priceCents * item.quantity)}</span>
                        </div>
                    </div>
                </li>
            `).join('');

            list.querySelectorAll<HTMLElement>('[data-decrease]').forEach((button) => {
                button.addEventListener('click', () => handleDecreaseClick(button));
            });
            list.querySelectorAll<HTMLElement>('[data-increase]').forEach((button) => {
                button.addEventListener('click', () => handleIncreaseClick(button));
            });
            list.querySelectorAll<HTMLElement>('[data-remove]').forEach((button) => {
                button.addEventListener('click', () => handleRemoveClick(button));
            });
        }

        const subtotal = subtotalCents();
        const subtotalOutput = document.querySelector('[data-subtotal]');
        const totalOutput = document.querySelector('[data-total]');

        if (subtotalOutput) subtotalOutput.textContent = formatPrice(subtotal);
        if (totalOutput) totalOutput.textContent = formatPrice(subtotal);
    }

    document.addEventListener('astro:page-load', initCartView);
</script>
