---
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PageHead from '@components/shared/PageHead.astro';
import { PASSWORD_MIN_LENGTH } from '@lib/constants';
---

<section
    class="stage stage--slim stage--tight"
    aria-labelledby="signin-title"
>
    <div class="flex flex-col gap-8">
        <PageHead
            class="font-extrabold font-sans text-4xl text-center tracking-tight"
            eyebrow="Account"
            eyebrowClass="mb-3 text-center"
            headingId="signin-title"
        >
            Sign in.
        </PageHead>
        <div
            class="signin slab slab--bare slab--card"
            data-auth-gate
            data-motion="unfold"
        >
            <fieldset class="signin__modes">
                <legend class="sr-only">What do you want to do?</legend>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signin"
                        class="signin__radio"
                        checked
                        name="mode"
                        type="radio"
                    />
                    Sign in
                </label>
                <label class="action-text signin__tab">
                    <input
                        id="mode-signup"
                        class="signin__radio"
                        name="mode"
                        type="radio"
                    />
                    Create account
                </label>
            </fieldset>
            <form
                class="signin__panel signin__panel--in flex flex-col gap-5"
                data-auth-form="signin"
            >
                <h2 class="sr-only">
                    Sign in
                </h2>
                <p
                    class="action-text signin__alert px-3 py-3 bg-accent text-ink"
                    data-form-error
                    hidden
                    role="alert"
                />
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Email</span>
                        <input
                            id="signin-email"
                            class="aria-invalid:border-accent-deep aria-invalid:shadow-[3px_3px_0_0_var(--color-accent-20)] focus-visible:bg-surface-raised hover:bg-surface-raised h-[50px] w-full px-4 border-2 border-ink font-mono text-sm bg-transparent transition-[background-color,border-color,box-shadow]"
                            aria-describedby="signin-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signin-email-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Password</span>
                        <span class="signin__control">
                            <input
                                id="signin-password"
                                class="aria-invalid:border-accent-deep aria-invalid:shadow-[3px_3px_0_0_var(--color-accent-20)] focus-visible:bg-surface-raised hover:bg-surface-raised h-[50px] w-full pl-4 pr-12 border-2 border-ink font-sans bg-transparent transition-[background-color,border-color,box-shadow]"
                                aria-describedby="signin-password-error"
                                aria-invalid="false"
                                autocomplete="current-password"
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signin-password"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signin-password-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <button
                        class="btn btn--primary"
                        type="submit"
                    >
                        Sign in &rarr;
                    </button>
                    <p
                        class="action-text text-ink-subtle"
                        aria-live="polite"
                        data-auth-status
                    />
                </div>
            </form>
            <form
                class="signin__panel signin__panel--up flex flex-col gap-5"
                data-auth-form="signup"
            >
                <h2 class="sr-only">
                    Create account
                </h2>
                <p
                    class="action-text signin__alert px-3 py-3 bg-accent text-ink"
                    data-form-error
                    hidden
                    role="alert"
                />
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Email</span>
                        <input
                            id="signup-email"
                            class="aria-invalid:border-accent-deep aria-invalid:shadow-[3px_3px_0_0_var(--color-accent-20)] focus-visible:bg-surface-raised hover:bg-surface-raised h-[50px] w-full px-4 border-2 border-ink font-mono text-sm bg-transparent transition-[background-color,border-color,box-shadow]"
                            aria-describedby="signup-email-error"
                            aria-invalid="false"
                            autocomplete="email"
                            name="email"
                            required
                            type="email"
                        />
                    </label>
                    <p
                        id="signup-email-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Password</span>
                        <span class="signin__control">
                            <input
                                id="signup-password"
                                class="aria-invalid:border-accent-deep aria-invalid:shadow-[3px_3px_0_0_var(--color-accent-20)] focus-visible:bg-surface-raised hover:bg-surface-raised h-[50px] w-full pl-4 pr-12 border-2 border-ink font-sans bg-transparent transition-[background-color,border-color,box-shadow]"
                                aria-describedby="signup-password-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                minlength={PASSWORD_MIN_LENGTH}
                                name="password"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-password"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-password-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="signin__field flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">Confirm password</span>
                        <span class="signin__control">
                            <input
                                id="signup-confirm"
                                class="aria-invalid:border-accent-deep aria-invalid:shadow-[3px_3px_0_0_var(--color-accent-20)] focus-visible:bg-surface-raised hover:bg-surface-raised h-[50px] w-full pl-4 pr-12 border-2 border-ink font-sans bg-transparent transition-[background-color,border-color,box-shadow]"
                                aria-describedby="signup-confirm-error"
                                aria-invalid="false"
                                autocomplete="new-password"
                                name="confirm"
                                required
                                type="password"
                            />
                            <button
                                class="signin__reveal"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-reveal="signup-confirm"
                                type="button"
                            >
                                <span class="signin__glyph signin__glyph--show">
                                    <IconEye />
                                </span>
                                <span class="signin__glyph signin__glyph--hide">
                                    <IconEyeOff />
                                </span>
                            </button>
                        </span>
                    </label>
                    <p
                        id="signup-confirm-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <button
                        class="btn btn--primary"
                        type="submit"
                    >
                        Create account &rarr;
                    </button>
                    <p
                        class="action-text text-ink-subtle"
                        aria-live="polite"
                        data-auth-status
                    />
                </div>
            </form>
        </div>
        <div
            class="signin__done slab slab--well flex flex-col gap-5"
            data-auth-done
            data-motion="rise"
            hidden
        >
            <h2
                class="font-extrabold font-sans text-3xl tracking-tight"
                data-auth-heading
                tabindex="-1"
            >
                You are signed in.
            </h2>
            <dl class="signin__summary">
                <div class="signin__summary-row">
                    <dt class="label text-ink-inverse-muted">Account</dt>
                    <dd
                        class="font-mono text-sm wrap-break-word"
                        data-auth-email
                    />
                </div>
                <div class="signin__summary-row">
                    <dt class="label text-ink-inverse-muted">Balance</dt>
                    <dd
                        class="font-mono text-sm"
                        data-auth-prods
                    />
                </div>
                <div class="signin__summary-row">
                    <dt class="label text-ink-inverse-muted">Profile</dt>
                    <dd
                        class="font-mono text-sm"
                        data-auth-profile
                    />
                </div>
            </dl>
            <div class="flex flex-wrap gap-3">
                <a
                    class="btn btn--accent"
                    data-auth-onboarding
                    hidden
                    href="/onboarding"
                >
                    Finish your profile &rarr;
                </a>
                <a
                    class="btn"
                    href="/store"
                >
                    Spend your Prods
                </a>
                <button
                    class="btn"
                    data-auth-signout
                    type="button"
                >
                    Sign out
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    .signin:has(#mode-signup:checked) .signin__panel--in {
        display: none;
    }

    .signin:not(:has(#mode-signup:checked)) .signin__panel--up {
        display: none;
    }

    .signin__control {
        display: block;
        position: relative;
    }

    .signin__done .btn:not(.btn--accent):hover {
        background-color: var(--color-ink-inverse);
        border-color: var(--color-ink-inverse);
        color: var(--color-ink);
    }

    .signin__glyph {
        align-items: center;
        display: flex;
    }

    .signin__modes {
        border: 0;
        border-bottom: 2px solid var(--color-ink);
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin: 0;
        min-inline-size: 0;
        padding: 0;
    }

    .signin__panel {
        padding: var(--space-md);
    }

    .signin__radio {
        appearance: none;
        height: 0;
        margin: 0;
        opacity: 0;
        position: absolute;
        width: 0;
    }

    .signin__reveal {
        align-items: center;
        bottom: 0;
        color: var(--color-ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: center;
        position: absolute;
        right: 0;
        top: 0;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .signin__reveal::after {
        content: '';
        height: 48px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
    }

    .signin__reveal:active {
        transform: translateY(1px);
    }

    .signin__reveal:focus-visible {
        outline-offset: -4px;
    }

    .signin__reveal:hover {
        color: var(--color-accent-deep);
    }

    .signin__reveal[aria-pressed='false'] .signin__glyph--hide,
    .signin__reveal[aria-pressed='true'] .signin__glyph--show {
        display: none;
    }

    .signin__summary {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .signin__summary-row {
        border-bottom: 1px solid var(--color-ink-inverse-10);
        display: flex;
        gap: var(--space-md);
        justify-content: space-between;
        padding-bottom: var(--space-2xs);
    }

    .signin__tab {
        align-items: center;
        background-color: var(--color-surface);
        color: var(--color-ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: center;
        min-height: 52px;
        padding: var(--space-2xs) var(--space-sm);
        text-align: center;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui);
    }

    .signin__tab + .signin__tab {
        border-left: 2px solid var(--color-ink);
    }

    .signin__tab:active {
        background-color: var(--color-surface-sunken);
    }

    .signin__tab:has(.signin__radio:checked) {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .signin__tab:has(.signin__radio:focus-visible) {
        outline: 2px solid var(--color-accent-deep);
        outline-offset: -4px;
    }

    .signin__tab:hover:not(:has(.signin__radio:checked)) {
        background-color: var(--color-surface-sunken);
        color: var(--color-ink);
    }

    @media (forced-colors: active) {
        .signin__tab:has(.signin__radio:checked) {
            background-color: SelectedItem;
            color: SelectedItemText;
            forced-color-adjust: none;
        }
    }
</style>

<script>
    import { clearFieldErrors, confirmRule, focusFirstError, passwordRule, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { endSession, getSession, startSession } from '@lib/account/session';
    import { formatProds, registerPageScript, setMessage, setPending, setText } from '@lib/utils';
    import { getOnboardingHref } from '@lib/account/onboarding';
    import { toast } from '@lib/ui/toasts';

    const ERROR_FIELDS: Record<SessionErrorCode, string> = {
        'already-registered': 'email',
        'invalid-credentials': 'password',
        'invalid-email': 'email',
        'weak-password': 'password',
    };

    const SIGNIN_RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        password: { message: 'Enter your password.', required: true },
    };

    const SIGNUP_RULES: Record<string, FieldRule> = {
        confirm: confirmRule(),
        email: { message: 'Enter your email address.', required: true },
        password: passwordRule(),
    };

    function handleReveal(button: HTMLButtonElement) {
        const input = document.getElementById(button.dataset.reveal ?? '');
        const shown = button.getAttribute('aria-pressed') === 'true';

        if (!(input instanceof HTMLInputElement)) return;

        button.setAttribute('aria-label', shown ? 'Show password' : 'Hide password');
        button.setAttribute('aria-pressed', shown ? 'false' : 'true');
        input.type = shown ? 'password' : 'text';
    }

    async function handleSignOut(button: HTMLButtonElement) {
        setPending(button, true);

        await endSession();

        setPending(button, false);
        renderSession();
        toast('Signed out.', 'info');
        document.querySelector<HTMLInputElement>('#signin-email')?.focus();
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const signup = form.dataset.authForm === 'signup';
        const rules = signup ? SIGNUP_RULES : SIGNIN_RULES;
        const summary = form.querySelector<HTMLElement>('[data-form-error]');
        const values = new FormData(form);
        const errors = validateFields(form, rules);

        clearFieldErrors(form);
        setMessage(summary, '');

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            setMessage(summary, 'Nothing was submitted. Check the fields below.');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>('[data-auth-status]');

        setPending(button, true);
        setText(status, 'Checking\u2026');

        const result = await startSession({
            email: String(values.get('email') ?? ''),
            password: String(values.get('password') ?? ''),
        });

        setPending(button, false);
        setText(status, '');

        if (!result.ok) {
            const failure = { [ERROR_FIELDS[result.code]]: result.message };

            setFieldErrors(form, failure);
            focusFirstError(form, failure);
            setMessage(summary, result.message);

            return;
        }

        const message = signup ? 'Account created. You are signed in.' : `Signed in as ${sessionLabel(result.session)}.`;

        form.reset();
        renderSession();
        toast(message, 'success');
        document.querySelector<HTMLElement>('[data-auth-heading]')?.focus();
    }

    function initSignInForm(signal: AbortSignal) {
        const forms = document.querySelectorAll<HTMLFormElement>('[data-auth-form]');
        const reveals = document.querySelectorAll<HTMLButtonElement>('[data-reveal]');
        const signOut = document.querySelector<HTMLButtonElement>('[data-auth-signout]');

        if (forms.length === 0) return;

        forms.forEach((form) => {
            form.noValidate = true;
            form.addEventListener('submit', event => void handleSubmit(event, form), { signal });
        });

        reveals.forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });

        signOut?.addEventListener('click', () => void handleSignOut(signOut), { signal });
        renderSession();
    }

    function renderSession() {
        const done = document.querySelector<HTMLElement>('[data-auth-done]');
        const gate = document.querySelector<HTMLElement>('[data-auth-gate]');
        const link = document.querySelector<HTMLAnchorElement>('[data-auth-onboarding]');
        const session = getSession();

        gate?.toggleAttribute('hidden', session !== null);
        done?.toggleAttribute('hidden', session === null);

        if (!session) return;

        setText(document.querySelector<HTMLElement>('[data-auth-email]'), session.email);
        setText(document.querySelector<HTMLElement>('[data-auth-prods]'), formatProds(session.prods));
        setText(document.querySelector<HTMLElement>('[data-auth-profile]'), session.onboarded ? 'Complete' : 'Not finished');

        if (!link) return;

        link.href = getOnboardingHref(session.email);
        link.toggleAttribute('hidden', session.onboarded);
    }

    function sessionLabel(session: Session) {
        return session.artistName || session.username || session.email;
    }

    registerPageScript(initSignInForm);
</script>
