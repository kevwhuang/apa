---
import PageHead from '@components/shared/PageHead.astro';
import { DEMO_CREDENTIALS, PASSWORD_MIN_LENGTH } from '@lib/constants';
---

<section
    class="stage stage--narrow stage--tight border-b-2 border-ink"
    aria-labelledby="signin-title"
>
    <div>
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Account"
            headingId="signin-title"
        >
            Your side of the Alliance.
        </PageHead>
        <p class="max-w-2xl mt-6 text-[18px] text-ink-muted">
            An account keeps your profile, your Prods balance, and your Producer Bash entries in
            one place. Nothing here talks to a server, so use it as a demonstration rather than a
            login. Sign in with any address; {DEMO_CREDENTIALS.takenEmail} is already registered,
            and the password {DEMO_CREDENTIALS.wrongPassword} is always rejected.
        </p>
    </div>
</section>

<section
    class="stage stage--narrow stage--tight"
    aria-label="Account access"
>
    <div
        class="signin"
        data-auth-gate
    >
        <fieldset class="signin__modes">
            <legend class="label mb-3 text-ink-muted">What do you want to do?</legend>
            <div class="signin__mode-row flex flex-wrap gap-2">
                <label class="signin__mode action-text">
                    <input
                        id="mode-signin"
                        class="signin__radio"
                        checked
                        name="mode"
                        type="radio"
                    />
                    Sign in
                </label>
                <label class="signin__mode action-text">
                    <input
                        id="mode-signup"
                        class="signin__radio"
                        name="mode"
                        type="radio"
                    />
                    Create account
                </label>
            </div>
        </fieldset>
        <form
            class="signin__panel signin__panel--in slab slab--card flex flex-col gap-5"
            data-auth-form="signin"
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Sign in
            </h2>
            <p
                class="signin__alert action-text px-3 py-3 bg-accent text-ink"
                data-form-error
                hidden
                role="alert"
            />
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Email</span>
                    <input
                        id="signin-email"
                        class="h-12 w-full px-4 border-2 border-ink font-mono text-[13px] bg-transparent"
                        aria-describedby="signin-email-error"
                        aria-invalid="false"
                        autocomplete="email"
                        name="email"
                        required
                        type="email"
                    />
                </label>
                <p
                    id="signin-email-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Password</span>
                    <input
                        id="signin-password"
                        class="h-12 w-full px-4 border-2 border-ink font-sans bg-transparent"
                        aria-describedby="signin-password-error"
                        aria-invalid="false"
                        autocomplete="current-password"
                        name="password"
                        required
                        type="password"
                    />
                </label>
                <p
                    id="signin-password-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <div class="flex flex-wrap items-center gap-4">
                <button
                    class="btn btn--primary"
                    type="submit"
                >
                    Sign in &rarr;
                </button>
                <p
                    class="action-text text-ink-subtle"
                    aria-live="polite"
                    data-auth-status
                />
            </div>
        </form>
        <form
            class="signin__panel signin__panel--up slab slab--card flex flex-col gap-5"
            data-auth-form="signup"
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Create account
            </h2>
            <p
                class="signin__alert action-text px-3 py-3 bg-accent text-ink"
                data-form-error
                hidden
                role="alert"
            />
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Email</span>
                    <input
                        id="signup-email"
                        class="h-12 w-full px-4 border-2 border-ink font-mono text-[13px] bg-transparent"
                        aria-describedby="signup-email-error"
                        aria-invalid="false"
                        autocomplete="email"
                        name="email"
                        required
                        type="email"
                    />
                </label>
                <p
                    id="signup-email-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Display name <span class="signin__optional">optional</span></span>
                    <input
                        id="signup-name"
                        class="h-12 w-full px-4 border-2 border-ink font-sans bg-transparent"
                        aria-describedby="signup-name-error"
                        aria-invalid="false"
                        autocomplete="nickname"
                        maxlength="50"
                        name="displayName"
                        type="text"
                    />
                </label>
                <p
                    id="signup-name-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Password</span>
                    <input
                        id="signup-password"
                        class="h-12 w-full px-4 border-2 border-ink font-sans bg-transparent"
                        aria-describedby="signup-password-error"
                        aria-invalid="false"
                        autocomplete="new-password"
                        minlength={PASSWORD_MIN_LENGTH}
                        name="password"
                        required
                        type="password"
                    />
                </label>
                <p
                    id="signup-password-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
                <p class="text-[13px] text-ink-subtle">
                    At least {PASSWORD_MIN_LENGTH} characters. It is read to check its length and
                    then thrown away &mdash; no password is ever stored by this demo.
                </p>
            </div>
            <div class="signin__field flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Confirm password</span>
                    <input
                        id="signup-confirm"
                        class="h-12 w-full px-4 border-2 border-ink font-sans bg-transparent"
                        aria-describedby="signup-confirm-error"
                        aria-invalid="false"
                        autocomplete="new-password"
                        name="confirm"
                        required
                        type="password"
                    />
                </label>
                <p
                    id="signup-confirm-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <div class="flex flex-wrap items-center gap-4">
                <button
                    class="btn btn--primary"
                    type="submit"
                >
                    Create account &rarr;
                </button>
                <p
                    class="action-text text-ink-subtle"
                    aria-live="polite"
                    data-auth-status
                />
            </div>
        </form>
    </div>
    <div
        class="signin__done slab slab--well flex flex-col gap-5"
        data-auth-done
        hidden
    >
        <h2
            class="font-extrabold font-sans text-3xl tracking-tight"
            data-auth-heading
            tabindex="-1"
        >
            You are signed in.
        </h2>
        <dl class="signin__summary">
            <div class="signin__summary-row">
                <dt class="label text-ink-inverse-muted">Account</dt>
                <dd
                    class="font-mono wrap-break-word text-[14px]"
                    data-auth-email
                />
            </div>
            <div class="signin__summary-row">
                <dt class="label text-ink-inverse-muted">Balance</dt>
                <dd
                    class="font-mono text-[14px]"
                    data-auth-prods
                />
            </div>
            <div class="signin__summary-row">
                <dt class="label text-ink-inverse-muted">Profile</dt>
                <dd
                    class="font-mono text-[14px]"
                    data-auth-profile
                />
            </div>
        </dl>
        <p class="max-w-2xl text-[15px] text-ink-inverse-muted">
            This session lives in this browser and expires on its own. The link below mints a fresh
            24-hour onboarding token, exactly the way the welcome email does &mdash; which is also
            why that token is not a credential.
        </p>
        <div class="flex flex-wrap gap-3">
            <a
                class="btn btn--accent"
                data-auth-onboarding
                hidden
                href="/onboarding"
            >
                Finish your profile &rarr;
            </a>
            <a
                class="btn"
                href="/store"
            >
                Spend your Prods
            </a>
            <button
                class="btn"
                data-auth-signout
                type="button"
            >
                Sign out
            </button>
        </div>
    </div>
</section>

<style>
    .signin {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
    }

    .signin:has(#mode-signup:checked) .signin__panel--in {
        display: none;
    }

    .signin:not(:has(#mode-signup:checked)) .signin__panel--up {
        display: none;
    }

    .signin__done .btn:not(.btn--accent):hover {
        background-color: var(--color-ink-inverse);
        border-color: var(--color-ink-inverse);
        color: var(--color-ink);
    }

    .signin__mode {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: flex;
        gap: var(--space-xs);
        min-height: 50px;
        padding: var(--space-2xs) var(--space-md);
        transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
    }

    .signin__mode:active {
        background-color: var(--color-surface-sunken);
    }

    .signin__mode:has(.signin__radio:checked) {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .signin__mode:hover:not(:has(.signin__radio:checked)) {
        background-color: var(--color-surface-sunken);
    }

    .signin__modes,
    .signin__panel {
        max-width: 544px;
    }

    .signin__modes {
        border: 0;
        padding: 0;
    }

    .signin__optional {
        color: var(--color-ink-subtle);
        text-transform: none;
    }

    .signin__radio {
        appearance: none;
        background-color: transparent;
        border: 2px solid currentcolor;
        flex-shrink: 0;
        height: 20px;
        margin: 0;
        width: 20px;
    }

    .signin__radio:checked {
        background-color: currentcolor;
        box-shadow: inset 0 0 0 3px var(--color-ink);
    }

    .signin__summary {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .signin__summary-row {
        border-bottom: 1px solid var(--color-ink-inverse-10);
        display: flex;
        gap: var(--space-md);
        justify-content: space-between;
        padding-bottom: var(--space-2xs);
    }

    @media (forced-colors: active) {
        .signin__radio {
            background-color: Canvas;
            border-color: CanvasText;
            forced-color-adjust: none;
        }

        .signin__radio:checked {
            background-color: SelectedItem;
            border-color: CanvasText;
            box-shadow: inset 0 0 0 3px Canvas;
        }
    }
</style>

<script>
    import { PASSWORD_MIN_LENGTH } from '@lib/constants';
    import { clearFieldErrors, focusFirstError, setFieldErrors, validateFields } from '@lib/forms';
    import { endSession, getSession, startSession } from '@lib/session';
    import { getOnboardingHref } from '@lib/onboarding';
    import { registerPageScript, setMessage, setPending, setText } from '@lib/utils';

    const ERROR_FIELDS: Record<SessionErrorCode, string> = {
        'already-registered': 'email',
        'invalid-credentials': 'password',
        'invalid-email': 'email',
        'weak-password': 'password',
    };

    const SIGNIN_RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        password: { message: 'Enter your password.', required: true },
    };

    const SIGNUP_RULES: Record<string, FieldRule> = {
        confirm: { message: 'Both passwords must match.', required: true, validate: (value, values) => value === values.get('password') },
        email: { message: 'Enter your email address.', required: true },
        password: { message: `Use at least ${PASSWORD_MIN_LENGTH} characters.`, min: PASSWORD_MIN_LENGTH, required: true },
    };

    async function handleSignOut(button: HTMLButtonElement) {
        setPending(button, true);

        await endSession();

        setPending(button, false);
        renderSession();
        document.querySelector<HTMLInputElement>('#signin-email')?.focus();
    }

    async function handleSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const rules = form.dataset.authForm === 'signup' ? SIGNUP_RULES : SIGNIN_RULES;
        const summary = form.querySelector<HTMLElement>('[data-form-error]');
        const values = new FormData(form);
        const errors = validateFields(form, rules);

        clearFieldErrors(form);
        setMessage(summary, '');

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            setMessage(summary, 'Nothing was submitted. Check the fields below.');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>('[data-auth-status]');

        setPending(button, true);
        setText(status, 'Checking\u2026');

        const result = await startSession({
            displayName: String(values.get('displayName') ?? ''),
            email: String(values.get('email') ?? ''),
            password: String(values.get('password') ?? ''),
        });

        setPending(button, false);
        setText(status, '');

        if (!result.ok) {
            const failure = { [ERROR_FIELDS[result.code]]: result.message };

            setFieldErrors(form, failure);
            focusFirstError(form, failure);
            setMessage(summary, result.message);

            return;
        }

        form.reset();
        renderSession();
        document.querySelector<HTMLElement>('[data-auth-heading]')?.focus();
    }

    function initSignInForm(signal: AbortSignal) {
        const forms = document.querySelectorAll<HTMLFormElement>('[data-auth-form]');
        const signOut = document.querySelector<HTMLButtonElement>('[data-auth-signout]');

        if (forms.length === 0) return;

        forms.forEach((form) => {
            form.noValidate = true;
            form.addEventListener('submit', event => handleSubmit(event, form), { signal });
        });

        signOut?.addEventListener('click', () => handleSignOut(signOut), { signal });
        renderSession();
    }

    function renderSession() {
        const done = document.querySelector<HTMLElement>('[data-auth-done]');
        const gate = document.querySelector<HTMLElement>('[data-auth-gate]');
        const link = document.querySelector<HTMLAnchorElement>('[data-auth-onboarding]');
        const session = getSession();

        gate?.toggleAttribute('hidden', session !== null);
        done?.toggleAttribute('hidden', session === null);

        if (!session) return;

        setText(document.querySelector<HTMLElement>('[data-auth-email]'), session.email);
        setText(document.querySelector<HTMLElement>('[data-auth-prods]'), session.prods === 1 ? '1 Prod' : `${session.prods} Prods`);
        setText(document.querySelector<HTMLElement>('[data-auth-profile]'), session.onboarded ? 'Complete' : 'Not finished');

        if (!link) return;

        link.href = getOnboardingHref(session.email);
        link.toggleAttribute('hidden', session.onboarded);
    }

    registerPageScript(initSignInForm);
</script>
