---
import { getCollection } from 'astro:content';

import Schedule from '@components/program/Schedule.astro';
import { LINKS } from '@lib/shared/constants';
import { formatTimeRange, isUpcoming } from '@lib/shared/utils';

const editions = await getCollection('bash');

const upcoming = editions
    .filter(edition => isUpcoming(edition.data.end))
    .sort((a, b) => +a.data.date - +b.data.date);

const tickets = upcoming.map((edition, index) => ({
    date: edition.data.date.toISOString(),
    end: edition.data.end.toISOString(),
    headingId: index === 0 ? 'bash-next-title' : `bash-next-${index + 1}-title`,
    id: edition.id,
    location: edition.data.location,
    longDate: edition.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', timeZone: 'America/Chicago', year: 'numeric' }),
    prompt: edition.data.prompt,
    room: edition.data.room,
    time: formatTimeRange(edition.data.date, edition.data.end),
}));
---

<section
    class="stage stage--bash stage--tight border-b-2 border-border-strong"
    aria-label="Next Bash"
    data-event-group="bash-upcoming"
    data-event-role="some"
    hidden={tickets.length === 0}
>
    {tickets.map((ticket, index) => (
        <article
            id={index === 0 ? ticket.id : undefined}
            class="bash-ticket slab slab--cut slab--lift slab--still"
            aria-labelledby={ticket.headingId}
            data-event-end={ticket.end}
            data-event-group="bash-upcoming"
            data-event-id={ticket.id}
            data-event-role="next"
            data-motion="unfold"
            hidden={index > 0}
        >
            <div class="grid grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] max-lg:grid-cols-1">
                <div class="flex flex-col justify-between gap-(--space-2xl) pr-(--space-lg) max-lg:gap-(--space-lg) max-lg:pb-(--space-lg) max-lg:pr-0">
                    <div>
                        <p class="inline-block mb-4 px-2.5 py-1.5 border-2 border-marker-cobalt font-mono leading-none text-sm tracking-[0.06em] uppercase">
                            Next Bash
                        </p>
                        <h2
                            id={ticket.headingId}
                            class="font-display text-5xl text-balance text-marker-cobalt max-md:text-2xl"
                        >
                            <time datetime={ticket.date}>{ticket.longDate}</time>
                        </h2>
                    </div>
                    <p
                        class="max-w-2xl text-text-secondary"
                        data-motion="rise"
                    >
                        {ticket.prompt}
                    </p>
                </div>
                <dl
                    class="content-center grid justify-center gap-(--space-lg) pl-(--space-lg) border-dashed border-l-2 border-marker-cobalt max-lg:border-l-0 max-lg:border-t-2 max-lg:grid-cols-[auto_auto] max-lg:pl-0 max-lg:pt-(--space-lg) max-md:grid-cols-none"
                    data-motion-stagger="rise"
                >
                    <div>
                        <dt class="label mb-2 text-text-secondary">Time</dt>
                        <dd class="font-bold font-sans text-balance text-xl">{ticket.time}</dd>
                    </div>
                    <div class="max-lg:row-span-2">
                        <dt class="label mb-2 text-text-secondary">Where</dt>
                        <dd>
                            <address class="mb-1 font-bold font-sans not-italic text-xl wrap-anywhere">
                                {ticket.location}
                            </address>
                            {ticket.room && (
                                <p class="font-bold font-sans text-xl wrap-anywhere">{ticket.room}</p>
                            )}
                        </dd>
                    </div>
                    <div>
                        <dt class="label mb-2 text-text-secondary">RSVP</dt>
                        <dd class="font-bold font-sans text-xl">
                            <a
                                class="active:translate-y-px hover:text-link inline-block underline underline-offset-4 transition-[color,translate]"
                                href={LINKS.meetup}
                                rel="noopener noreferrer"
                                target="_blank"
                            >
                                meetup.com
                                <span class="sr-only">&nbsp;(opens in a new tab)</span>
                            </a>
                        </dd>
                    </div>
                </dl>
            </div>
        </article>
    ))}
</section>

<Schedule />

<style>
    .bash-ticket.slab {
        padding: var(--space-lg);
        padding-inline-start: calc(var(--space-lg) + var(--slab-cut));
    }
</style>
