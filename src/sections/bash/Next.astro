---
import Domain from '@components/shared/Domain.astro';
import Schedule from '@components/program/Schedule.astro';
import { LOCALE, TIME_ZONE } from '@lib/shared/constants';
import { formatTimeRange, isUpcoming, toAustinIso } from '@lib/shared/utils';
import { loadEvents } from '@lib/programs/calendar';

const CLASS_TICKET_DETAILS = 'content-center grid justify-center gap-(--space-lg) pl-(--space-lg) border-border-strong border-dashed border-l-2 max-lg:border-l-0 max-lg:border-t-2 max-lg:grid-cols-[auto_auto] max-lg:justify-start max-lg:pl-0 max-lg:pt-(--space-lg) max-md:grid-cols-none';

const events = await loadEvents();

const tickets = events
    .filter(event => event.program === 'Bash' && isUpcoming(event.ends_at))
    .map((event, index) => ({
        body: event.body,
        endsAt: toAustinIso(event.ends_at),
        externalUrl: event.external_url,
        headingId: index === 0 ? 'bash-next-title' : `bash-next-${index + 1}-title`,
        longDate: event.starts_at.toLocaleDateString(LOCALE, { day: 'numeric', month: 'long', timeZone: TIME_ZONE, year: 'numeric' }),
        room: event.room,
        startsAt: toAustinIso(event.starts_at),
        time: formatTimeRange(event.starts_at, event.ends_at),
        venue: event.venue,
    }));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-label="Next Bash"
    data-event-group="bash-upcoming"
    data-event-role="some"
    hidden={tickets.length === 0}
>
    {tickets.map((ticket, index) => (
        <article
            class="bash-ticket slab slab--cut slab--lift slab--plush slab--still"
            aria-labelledby={ticket.headingId}
            data-event-end={ticket.endsAt}
            data-event-group="bash-upcoming"
            data-event-role="next"
            data-motion="unfold"
            hidden={index > 0}
        >
            <div class="grid grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] max-lg:grid-cols-1">
                <div class="flex flex-col justify-between gap-(--space-2xl) pr-(--space-lg) max-lg:gap-(--space-lg) max-lg:pb-(--space-lg) max-lg:pr-0">
                    <div>
                        <p class="label inline-block mb-4 px-2 py-1 border-2 border-marker-cobalt">
                            Next Bash
                        </p>
                        <h2
                            id={ticket.headingId}
                            class="font-display text-2xl-5xl text-balance text-marker-cobalt"
                        >
                            <time datetime={ticket.startsAt}>{ticket.longDate}</time>
                        </h2>
                    </div>
                    <p
                        class="max-w-3xl text-wrap text-text-secondary"
                        data-motion="rise"
                    >
                        {ticket.body}
                    </p>
                </div>
                <dl
                    class={CLASS_TICKET_DETAILS}
                    data-motion-stagger="rise"
                >
                    <div>
                        <dt class="label mb-2 text-text-secondary">Time</dt>
                        <dd class="font-bold text-balance text-xl">{ticket.time}</dd>
                    </div>
                    <div class="max-lg:row-span-2">
                        <dt class="label mb-2 text-text-secondary">Where</dt>
                        <dd>
                            <address class="mb-1 font-bold not-italic text-xl wrap-anywhere">
                                {ticket.venue}
                            </address>
                            {ticket.room && (
                                <p class="font-bold text-xl wrap-anywhere">{ticket.room}</p>
                            )}
                        </dd>
                    </div>
                    <div>
                        <dt class="label mb-2 text-text-secondary">RSVP</dt>
                        <dd class="font-bold text-xl">
                            {ticket.externalUrl
                                ? (
                                        <a
                                            class="hit active:translate-y-px hover:text-link inline-block underline underline-offset-4 wrap-anywhere transition-[color,translate]"
                                            href={ticket.externalUrl}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            <Domain href={ticket.externalUrl} />
                                            <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                        </a>
                                    )
                                : 'TBD'}
                        </dd>
                    </div>
                </dl>
            </div>
        </article>
    ))}
</section>

<Schedule />
