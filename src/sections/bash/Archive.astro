---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate, formatTimeRange } from '@lib/utils';

const editions = await getCollection('bash');
const past = editions.filter(edition => edition.data.status === 'past').sort((a, b) => +b.data.date - +a.data.date);
---

<section
    class="stage stage--tight"
    aria-labelledby="editions-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`Archive / ${past.length} on file`}
            headingId="editions-title"
        >
            Past editions
        </SectionHead>
        <ul
            class="bash-archive list-none"
            data-motion-from="center"
            data-motion-stagger="flip"
        >
            {past.map(edition => (
                <li>
                    <article
                        id={edition.id}
                        class="bash-archive__card slab slab--card"
                    >
                        <p
                            class="label mb-2 text-accent-deep"
                            data-placeholder
                        >
                            {edition.data.edition} / <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                        </p>
                        <h3 class="mb-2 font-extrabold font-sans text-2xl tracking-tight">
                            {edition.data.title}
                        </h3>
                        <address class="mb-1 font-mono not-italic text-xs uppercase text-ink-muted">
                            {edition.data.location}
                        </address>
                        <p
                            class="mb-3 font-mono text-2xs uppercase text-ink-subtle"
                            data-placeholder
                        >
                            {formatTimeRange(edition.data.date, edition.data.end)}
                        </p>
                        <p class="text-sm text-ink-muted">
                            {edition.data.recap}
                        </p>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .bash-archive {
        column-gap: var(--space-md);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-md));
        row-gap: 0;
    }

    .bash-archive > li {
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding-bottom: var(--space-md);
    }

    .bash-archive__card {
        align-content: start;
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    @media (max-width: 1024px) {
        .bash-archive {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .bash-archive {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
