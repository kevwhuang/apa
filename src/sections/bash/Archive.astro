---
import { getCollection } from 'astro:content';

import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate, formatTimeRange, getProgram, isUpcoming } from '@lib/shared/utils';

const editions = await getCollection('bash');

const program = getProgram('bash');

const archive = editions.toSorted((a, b) => +b.data.date - +a.data.date);

const pastCount = archive.filter(edition => !isUpcoming(edition.data.end)).length;
---

<section
    class="stage stage--tight"
    aria-labelledby="editions-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            eyebrow={`Archive, ${pastCount} editions`}
            headingId="editions-title"
        >
            Past editions
        </SectionHead>
        <ul
            class="bash-archive list-none"
            data-event-tally="editions-title"
            data-motion-from="center"
            data-motion-stagger="flip"
        >
            {archive.map(edition => (
                <li
                    data-event-end={edition.data.end.toISOString()}
                    data-event-role="past"
                    hidden={isUpcoming(edition.data.end)}
                >
                    <article
                        id={isUpcoming(edition.data.end) ? undefined : edition.id}
                        class="bash-archive__card slab slab--card"
                        data-event-id={edition.id}
                    >
                        <p class="label mb-2 text-link">
                            {program.shortName} on <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                        </p>
                        <h3 class="mb-2 text-2xl">
                            {edition.data.title}
                        </h3>
                        <address class="mb-1 font-mono not-italic text-xs text-text-secondary">
                            {edition.data.location}
                        </address>
                        <p class="mb-3 font-mono text-xs text-text-secondary">
                            {formatTimeRange(edition.data.date, edition.data.end)}
                        </p>
                        <p class="text-sm text-text-secondary">
                            {edition.data.recap}
                        </p>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<Schedule />

<style>
    .bash-archive {
        column-gap: var(--space-md);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-md));
        row-gap: 0;
    }

    .bash-archive > li {
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding-bottom: var(--space-md);
    }

    .bash-archive__card {
        align-content: start;
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    @media (max-width: 1024px) {
        .bash-archive {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .bash-archive {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
