---
import IconUpload from '@components/icons/Upload.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { BOARD_PAGE_SIZE } from '@lib/programs/submissions';
import { UPLOAD } from '@lib/shared/constants';
import { formatBytes } from '@lib/shared/utils';
import { uploadExtensionsOrList } from '@lib/audio/uploads';

const fillerRows = Array.from({ length: BOARD_PAGE_SIZE - 1 });
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="submissions-title"
>
    <div>
        <SectionHead
            class="text-4xl text-balance"
            headingId="submissions-title"
        >
            Submit your track
        </SectionHead>
        <div
            class="has-[+[hidden]]:mb-0 flex flex-col gap-(--space-2xl) mb-(--space-2xl)"
            data-motion="unfold"
        >
            <div class="slab slab--card flex flex-col gap-3">
                <p
                    class="font-bold text-base"
                    data-intake-note
                    hidden
                >
                    Submissions are closed.
                </p>
                <label
                    class="dropzone halftone flex flex-col items-center justify-center relative min-h-[220px] gap-3 p-(--space-lg) border-2 border-border-strong border-dashed text-center bg-bg-page"
                    data-dropzone
                    for="submissions-input"
                >
                    <IconUpload />
                    <span class="font-bold font-sans text-2xl tracking-tight">
                        Drop your track
                    </span>
                    <span class="label text-text">or choose a file</span>
                    <input
                        id="submissions-input"
                        class="dropzone__input sr-only"
                        accept={UPLOAD.acceptAttribute}
                        aria-describedby="submissions-help"
                        aria-invalid="false"
                        autocomplete="off"
                        data-dropzone-input
                        data-intake-control
                        disabled
                        multiple
                        name="submissions"
                        type="file"
                    />
                </label>
                <p
                    id="submissions-help"
                    class="text-base text-text-secondary"
                >
                    {uploadExtensionsOrList} files up to {formatBytes(UPLOAD.maxFileBytes)}.
                </p>
            </div>
            <ul
                class="empty:hidden flex flex-col gap-(--space-2xl) list-none"
                aria-label="Selected files"
                data-dropzone-list
            />
            <p
                class="sr-only"
                aria-live="polite"
                data-dropzone-status
            />
        </div>
        <div data-board-root>
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
                <h3
                    class="text-2xl"
                    data-motion="rise"
                >
                    The submission board
                </h3>
                <p
                    class="label flex items-center gap-2 text-text-secondary"
                    data-board-refresh
                    hidden
                >
                    <span class="spinner" aria-hidden="true" />
                    <span
                        class="self-baseline leading-(--text-lg)"
                        data-board-refresh-text
                    />
                </p>
            </div>
            <div
                class="@container overflow-x-auto mb-5"
                data-board-frame
                data-motion="unfold"
            >
                <table class="table-fixed border-2 border-border-strong [--board-index:calc(var(--text-base)*var(--board-digits,2)*0.612+33px)] [--board-time:calc(var(--text-sm)*6.048+33px)] max-md:[--board-index:calc(var(--text-base)*var(--board-digits,2)*0.612+17px)] max-md:[--board-time:calc(var(--text-sm)*6.048+17px)]">
                    <caption class="sr-only">Tracks submitted for the current Bash</caption>
                    <colgroup>
                        <col class="w-(--board-index)" />
                        <col class="w-[clamp(160px,calc((100cqw-var(--board-index)-var(--board-time)-66px)*var(--board-share,0.305)+32px),calc(100cqw-var(--board-index)-var(--board-time)-162px))] max-md:w-[max(128px,calc(100cqw-var(--board-index)-var(--board-time)-2px))]" />
                        <col class="max-md:hidden" />
                        <col class="w-(--board-time)" />
                    </colgroup>
                    <thead>
                        <tr class="label border-b-2 border-border-strong text-text-secondary">
                            <th
                                class="px-4 py-3 text-left max-md:px-2"
                                scope="col"
                            >
                                #
                            </th>
                            <th
                                class="px-4 py-3 text-left max-md:px-2"
                                scope="col"
                            >
                                Producer
                            </th>
                            <th
                                class="px-4 py-3 text-left max-md:hidden"
                                scope="col"
                            >
                                Track
                            </th>
                            <th
                                class="px-4 py-3 text-right whitespace-nowrap max-md:px-2"
                                scope="col"
                            >
                                Submitted
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-board-body
                    >
                        <tr class="h-14 max-md:h-18">
                            <td
                                class="label px-4 text-text-secondary max-md:px-2"
                                colspan="4"
                            >
                                <span class="flex items-center gap-2">
                                    <span class="spinner" aria-hidden="true" />
                                    Pulling up the board&hellip;
                                </span>
                            </td>
                        </tr>
                        {fillerRows.map(() => (
                            <tr
                                class="h-14 max-md:h-18"
                                aria-hidden="true"
                            >
                                <td colspan="4" />
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-x-(--space-md) gap-y-3">
                <nav
                    class="flex flex-wrap gap-2"
                    aria-label="Submission board pages"
                    data-board-pager
                />
                <p
                    class="label text-text-secondary"
                    aria-live="polite"
                    data-board-status
                    data-motion="stamp"
                />
            </div>
        </div>
    </div>
    <template data-dropzone-row>
        <li class="slab slab--card flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <p
                    class="font-bold wrap-anywhere"
                    data-row-name
                />
                <p
                    class="label text-text-secondary"
                    data-row-meta
                />
            </div>
            <canvas
                class="block h-18 max-w-full w-full text-text-brand"
                aria-hidden="true"
                data-row-canvas
                height="72"
                hidden
                width="640"
            />
            <div class="flex flex-wrap items-center justify-between gap-4">
                <progress
                    class="progress flex-[1_1_140px] h-3 min-w-0"
                    data-row-progress
                    max="100"
                    value="0"
                />
                <p
                    class="label min-w-[34px] text-text-secondary"
                    data-row-percent
                />
                <button
                    class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                    data-row-cancel
                    type="button"
                >
                    Remove
                </button>
            </div>
        </li>
    </template>
    <template data-board-row>
        <tr class="h-14 max-md:h-18">
            <td
                class="px-4 font-mono text-base whitespace-nowrap text-text-secondary max-md:px-2"
                data-cell-index
            />
            <td class="px-4 max-md:px-2">
                <span
                    class="block font-bold truncate"
                    data-cell-producer
                />
                <span
                    class="has-[button]:overflow-visible hidden font-mono text-base truncate text-text-secondary max-md:block"
                    data-cell-file
                />
            </td>
            <td
                class="px-4 font-mono text-base truncate max-md:hidden"
                data-cell-file
            />
            <td
                class="px-4 font-mono text-right text-sm whitespace-nowrap text-text-secondary max-md:px-2"
                data-cell-submitted
            />
        </tr>
    </template>
    <template data-board-play>
        <button
            class="hit active:translate-y-px aria-pressed:text-link hover:text-link inline-flex max-w-full align-top text-left transition-[color,translate]"
            aria-pressed="false"
            type="button"
        >
            <span class="sr-only">Play&nbsp;</span>
            <span class="min-w-0 truncate" data-board-play-label />
        </button>
    </template>
    <template data-board-filler>
        <tr
            class="h-14 max-md:h-18"
            aria-hidden="true"
        >
            <td />
            <td />
            <td class="max-md:hidden" />
            <td />
        </tr>
    </template>
    <template data-board-page>
        <button
            class="chip hover:bg-bg-hover min-w-(--control-size)"
            type="button"
        />
    </template>
</section>

<script>
    import { bindIntake } from '@lib/programs/intake';
    import { createBoard } from '@lib/programs/board';
    import { createDropzone } from '@lib/audio/dropzone';
    import { getBoard, onBoardChange, removeSubmission, submitFile, watchBoard } from '@lib/programs/submissions';
    import { registerPageScript } from '@lib/shared/utils';

    function initBashSubmissions(signal: AbortSignal) {
        const syncFiles = createDropzone({
            signal,
            store: {
                remove: removeSubmission,
                send: (file, options) => submitFile('bash', file, options),
            },
        });

        if (!syncFiles) return;

        bindIntake('bash', signal);
        watchBoard('bash');
        syncOwnFiles(syncFiles);
        signal.addEventListener('abort', onBoardChange(() => syncOwnFiles(syncFiles)), { once: true });
    }

    function initSubmissionBoard(signal: AbortSignal) {
        createBoard({ board: 'bash', signal, sourceSelector: '[data-cell-file]' });
    }

    function syncOwnFiles(syncFiles: (entries: BoardEntry[]) => void) {
        syncFiles(getBoard('bash').entries.filter(entry => entry.self));
    }

    registerPageScript(initBashSubmissions);
    registerPageScript(initSubmissionBoard);
</script>
