---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { toAvailability } from '@lib/resources/unlocks';

const KIT_ORDER = ['bash_starter_guide', 'bash_sample_kit'];

const assets = (await getCollection('downloads', asset => asset.data.kind === 'bash'))
    .toSorted((a, b) => getKitRank(a.id) - getKitRank(b.id) || a.data.title.localeCompare(b.data.title))
    .map(asset => ({ ...asset, availability: toAvailability(asset.data) }));

function getKitRank(id: string): number {
    const rank = KIT_ORDER.indexOf(id);

    return rank === -1 ? KIT_ORDER.length : rank;
}
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="bash-assets-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="bash-assets-title"
        >
            The kit
            <a
                class="action-text inline-flex items-center min-h-(--control-size) gap-2 whitespace-nowrap max-md:hidden"
                href="/resources"
                slot="cta"
            >
                Browse resources <IconArrow />
            </a>
        </SectionHead>
        <ul
            class="grid grid-cols-2 gap-x-(--space-lg) gap-y-(--space-2xl) list-none max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] max-md:mb-(--space-md)"
            data-motion-stagger="rise"
        >
            {assets.map(asset => (
                <li class="slab slab--card slab--plush slab--still grid grid-cols-1 grid-rows-subgrid row-span-3 gap-y-4">
                    <h3 class="font-display text-2xl text-balance">
                        {asset.data.title}
                    </h3>
                    <p class="text-text-secondary">
                        {asset.data.description}
                    </p>
                    <div class="flex flex-wrap items-center justify-between gap-x-(--space-md) pt-3 border-border-subtle border-t">
                        <p class="font-mono text-base text-text-secondary">
                            {asset.data.format} &middot; {asset.data.size}
                        </p>
                        {asset.availability === 'open' && (
                            <a
                                class="action-text inline-flex items-center min-h-(--control-size)"
                                aria-label={`Download ${asset.data.title}`}
                                download
                                href={asset.data.href}
                            >
                                Download
                            </a>
                        )}
                        {asset.availability !== 'open' && (
                            <span class="action-text inline-flex items-center min-h-(--control-size) whitespace-nowrap text-text-secondary">Coming soon</span>
                        )}
                    </div>
                </li>
            ))}
        </ul>
        <p
            class="hidden max-md:block"
            data-motion="rise"
        >
            <a
                class="action-text inline-flex items-center min-h-(--control-size) gap-2 underline underline-offset-4"
                href="/resources"
            >
                Browse resources <IconArrow />
            </a>
        </p>
    </div>
</section>
