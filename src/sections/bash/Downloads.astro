---
import { getCollection } from 'astro:content';

import IconDownload from '@components/icons/Download.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { isDownload, toAvailability } from '@lib/resources/unlocks';

const DOWNLOAD_ICON_SIZE = 48;
const KIT_ORDER = ['bash_starter_guide', 'bash_assets'];

const assets = (await getCollection('downloads', asset => asset.data.kind === 'bash'))
    .toSorted((a, b) => getKitRank(a.id) - getKitRank(b.id) || a.data.title.localeCompare(b.data.title))
    .map((asset) => {
        const isOpen = toAvailability(asset.data) === 'open';

        return {
            ...asset,
            href: isOpen && asset.data.href ? asset.data.href : '/resources',
            isDownload: isOpen && isDownload(asset.data),
        };
    });

function getKitRank(id: string): number {
    const rank = KIT_ORDER.indexOf(id);

    return rank === -1 ? KIT_ORDER.length : rank;
}
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="bash-kit-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="bash-kit-title"
        >
            Get the files
        </SectionHead>
        <ul
            class="grid grid-cols-2 gap-x-(--space-lg) gap-y-(--space-2xl) list-none max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))]"
            data-motion-stagger="rise"
        >
            {assets.map(asset => (
                <li class="slab slab--card slab--plush grid grid-cols-1 grid-rows-subgrid row-span-3 gap-y-4">
                    <h3 class="font-display text-2xl text-balance">
                        {asset.data.title}
                    </h3>
                    <p class="text-text-secondary">
                        {asset.data.description}
                    </p>
                    <div class="flex justify-end pt-3 border-border-subtle border-t">
                        <a
                            class="hit active:translate-y-px focus-visible:text-link hover:text-link inline-flex size-12 -me-1 transition-[color,translate]"
                            aria-label={`Download ${asset.data.title}`}
                            download={asset.isDownload ? '' : undefined}
                            href={asset.href}
                        >
                            <IconDownload size={DOWNLOAD_ICON_SIZE} />
                        </a>
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>
