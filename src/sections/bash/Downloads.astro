---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { ASSET_KIND_LABELS } from '@lib/shared/constants';
import { getProgram } from '@lib/shared/utils';

const downloads = await getCollection('downloads');

const program = getProgram('bash');

const assets = downloads.filter(asset => asset.data.title.includes(program.name)).toSorted((a, b) => +b.data.date - +a.data.date);
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="bash-assets-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`${program.shortName} / Resources`}
            headingId="bash-assets-title"
        >
            Take the room home
        </SectionHead>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
            <ul
                class="flex flex-col list-none"
                data-motion-stagger="rise"
            >
                {assets.map(asset => (
                    <li class="first:border-t-0 flex flex-wrap items-baseline justify-between gap-(--space-sm) py-(--space-md) border-t border-ink-20">
                        <div class="flex flex-col gap-1">
                            <a
                                class="active:translate-y-px hover:text-accent-deep inline-block self-start py-(--space-sm) decoration-2 decoration-accent font-bold font-sans underline underline-offset-4 transition-[color,transform]"
                                href={`/resources#${asset.id}`}
                            >
                                {asset.data.title}
                            </a>
                            <p class="text-sm text-ink-muted">{asset.data.description}</p>
                        </div>
                        <p
                            class="label shrink-0 text-ink-subtle"
                            data-placeholder
                        >
                            {ASSET_KIND_LABELS[asset.data.kind]} &middot; {asset.data.format} &middot; {asset.data.size}
                        </p>
                    </li>
                ))}
            </ul>
            <aside
                class="slab slab--sunk flex flex-col self-start gap-4"
                aria-label="About the resource library"
                data-motion="unfold"
            >
                <p class="text-smd text-ink-muted">
                    Every asset the Alliance publishes &mdash; press material, event packs, and the working
                    documents behind how it all runs &mdash; is listed in one place, each with its
                    format, size, and publication state.
                </p>
                <a
                    class="btn btn--primary self-start"
                    href="/resources"
                >
                    Open the resource library <IconArrow />
                </a>
            </aside>
        </div>
    </div>
</section>
