---
import PageHead from '@components/shared/PageHead.astro';

const FORMAT_STEPS = [
    { name: 'Get the files', note: 'Producers download the guide and resources. The prompt is optional but encouraged, and only tracks that use it are eligible for the vote, the mixtape, and the prizes.' },
    { name: 'Beat the clock', note: 'In one shared room, producers have three hours to make a short track and submit it before the deadline. They are encouraged to walk around, watch how others work, mingle, and pair up.' },
    { name: 'Win the room', note: 'Every Bash ends with a vote to pick the winners, and some Bashes add a head-to-head final. Producers stay to hang out afterward, and an optional social follows.' },
] as const;
---

<section
    class="slab--well stage stage--tight overflow-clip border-b-2 border-border-strong"
    aria-labelledby="bash-title"
>
    <div
        class="halftone--accent stage__full absolute bottom-0 inset-x-0 h-(--space-lg) pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div class="flex flex-col relative gap-6">
        <PageHead
            class="text-3xl-7xl"
            headingId="bash-title"
        >
            One prompt,<br />
            <span class="text-text-brand">one afternoon,</span><br />
            one <span class="whitespace-nowrap">room</span>
        </PageHead>
        <div class="flex flex-col gap-(--space-lg) mb-(--space-lg)">
            <div class="flex flex-col gap-5">
                <p
                    class="max-w-2xl text-lg text-text-inverse-secondary"
                    data-motion="blur"
                >
                    An afternoon of producing against the clock, with a prompt to spark ideas and a
                    closing vote from the whole room.
                </p>
                <p
                    class="max-w-2xl text-text-inverse-secondary"
                    data-motion="rise"
                >
                    Bashes run quarterly on a Saturday afternoon and welcome every experience level
                    and genre. Producers bring their own gear, such as a laptop, headphones, and
                    keyboards. The room also has Mac stations fitted with Ableton Live and MIDI
                    controllers. The Starter Guide covers the full details and rules.
                </p>
            </div>
            <aside
                class="slab slab--bare slab--card overflow-clip"
                aria-labelledby="bash-format-title"
                data-motion="unfold"
            >
                <div class="p-(--space-lg) bg-event-bash text-event-bash-text">
                    <h2
                        id="bash-format-title"
                        class="mb-(--space-md) font-display text-2xl"
                    >
                        How a Bash runs
                    </h2>
                    <ol class="grid grid-cols-3 gap-(--space-lg) list-none max-lg:gap-(--space-md) max-lg:grid-cols-[auto_minmax(0,1fr)]">
                        {FORMAT_STEPS.map((step, index) => (
                            <li class="content-start grid grid-cols-[48px_minmax(0,1fr)] gap-x-(--space-md) gap-y-1 pt-4 border-event-bash-text border-t-2 max-lg:col-span-2 max-lg:grid-cols-subgrid">
                                <span
                                    class="row-span-2 font-display text-4xl"
                                    aria-hidden="true"
                                >
                                    {index + 1}
                                </span>
                                <p class="font-bold leading-(--text-lg) text-lg tracking-tight">{step.name}</p>
                                <p class="text-base text-pretty">{step.note}</p>
                            </li>
                        ))}
                    </ol>
                </div>
            </aside>
        </div>
    </div>
</section>
