---
import PageHead from '@components/shared/PageHead.astro';
import { getProgram } from '@lib/utils';

const program = getProgram('bash');
---

<section
    class="slab--well stage stage--tight overflow-clip border-b-2 border-ink"
    aria-labelledby="bash-title"
>
    <div
        class="bash-feature__drift halftone--accent stage__item--full absolute pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div class="relative">
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-6xl tracking-[-0.04em] md:text-8xl"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="bash-title"
            tone="dark"
        >
            One prompt.<br />
            <span class="text-accent">One afternoon.</span><br />
            One showdown.
        </PageHead>
        <p
            class="max-w-2xl mt-6 leading-relaxed text-lmd text-ink-inverse-muted"
            data-motion="blur"
        >
            {program.summary}
        </p>
    </div>
</section>

<style>
    .bash-feature__drift {
        inset: -8% calc(-1 * var(--launcher-rail)) -8% 0;
    }
</style>
