---
import PageHead from '@components/shared/PageHead.astro';
import { getProgram } from '@lib/shared/utils';

const program = getProgram('bash');
---

<section
    class="slab--well stage stage--tight overflow-clip border-b-2 border-border-strong"
    aria-labelledby="bash-title"
>
    <div
        class="halftone--accent stage__item--full absolute -inset-y-[8%] inset-x-0 pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div class="flex flex-col relative gap-6">
        <PageHead
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="bash-title"
            tone="dark"
        >
            One prompt.<br />
            <span class="text-text-brand">One afternoon.</span><br />
            One <span class="whitespace-nowrap">showdown.</span>
        </PageHead>
        <p
            class="max-w-2xl leading-relaxed text-lg text-text-inverse-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
    </div>
</section>
