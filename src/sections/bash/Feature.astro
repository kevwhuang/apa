---
import PageHead from '@components/shared/PageHead.astro';
import { getProgram } from '@lib/shared/utils';

const program = getProgram('bash');
---

<section
    class="slab--well stage stage--tight overflow-clip border-b-2 border-ink"
    aria-labelledby="bash-title"
>
    <div
        class="halftone--accent stage__item--full absolute -inset-y-[8%] inset-x-0 pointer-events-none"
        aria-hidden="true"
        data-scrub="drift"
    />
    <div class="flex flex-col relative gap-6">
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-6xl tracking-[-0.04em] md:text-8xl"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="bash-title"
            tone="dark"
        >
            One prompt.<br />
            <span class="text-accent">One afternoon.</span><br />
            One showdown.
        </PageHead>
        <p
            class="max-w-2xl leading-relaxed text-lmd text-ink-inverse-muted"
            data-motion="blur"
        >
            {program.summary}
        </p>
    </div>
</section>
