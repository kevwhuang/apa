---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/shared/utils';

const editions = await getCollection('bash');

const program = getProgram('bash');

const upcoming = editions.filter(edition => edition.data.status === 'upcoming').sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--bash stage--tight border-b-2 border-ink"
    aria-labelledby="next-editions-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="next-editions-title"
        >
            Next up
        </SectionHead>
        {upcoming.length > 0
            ? (
                    <ul
                        class="rake mb-8 list-none"
                        data-motion-stagger="tilt"
                    >
                        {upcoming.map(edition => (
                            <li class="rake__item rake__item--flush">
                                <article
                                    id={edition.id}
                                    class="slab slab--cut slab--lift grid grid-cols-12 items-start gap-x-2 gap-y-4 md:gap-x-6"
                                >
                                    <div class="col-span-12 md:col-span-3">
                                        <p
                                            class="font-extrabold font-sans text-2xl"
                                            data-placeholder
                                        >
                                            <time datetime={edition.data.date.toISOString()}>{formatDate(edition.data.date)}</time>
                                        </p>
                                        <p
                                            class="font-mono text-2xs uppercase text-ink-muted"
                                            data-placeholder
                                        >
                                            {formatTimeRange(edition.data.date, edition.data.end)}
                                        </p>
                                    </div>
                                    <div class="col-span-12 md:col-span-9">
                                        <span class="label inline-block mb-3 px-2 py-1 bg-accent text-ink">
                                            {program.shortName} / {edition.data.edition}
                                        </span>
                                        <h3 class="mb-2 font-extrabold font-sans text-3xl tracking-tight">
                                            {edition.data.title}
                                        </h3>
                                        <address class="mb-3 font-mono not-italic text-xs uppercase text-ink-muted">
                                            {edition.data.location}
                                        </address>
                                        <p class="max-w-2xl mb-4 text-ink-muted">
                                            {edition.data.prompt}
                                        </p>
                                        <p>
                                            <a
                                                class="action-text bash__rsvp hover:text-accent-deep underline underline-offset-4 transition-colors"
                                                href={LINKS.meetup}
                                                rel="noopener noreferrer"
                                                target="_blank"
                                            >
                                                RSVP for the {edition.data.edition} edition on Meetup <IconArrow />
                                            </a>
                                        </p>
                                    </div>
                                </article>
                            </li>
                        ))}
                    </ul>
                )
            : (
                    <p
                        class="max-w-(--measure-form) mb-8 text-ink-muted"
                        data-motion="rise"
                    >
                        No edition on the calendar right now &mdash; the next one goes up as soon as the room is booked.
                    </p>
                )}
        <p data-motion="rise">
            <a
                class="action-text bash__rsvp hover:text-accent-deep underline underline-offset-4 transition-colors"
                href="/events"
            >
                See the full calendar <IconArrow />
            </a>
        </p>
    </div>
</section>

<style>
    .bash__rsvp {
        align-items: center;
        display: inline-flex;
        gap: var(--space-2xs);
        min-height: var(--control-size);
    }
</style>
