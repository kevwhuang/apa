---

---

<section
    class="pt-20 pb-12 border-b-2 border-ink"
    aria-label="Checkout header"
>
    <div class="max-w-[1100px] mx-auto px-6">
        <p class="label mb-4 text-coral">CHECKOUT</p>
        <h1 class="font-sans font-extrabold tracking-[-0.03em] text-5xl">Checkout</h1>
        <ol id="steps" class="mt-8 flex border-2 border-ink" aria-label="Checkout steps">
            {['01 Shipping', '02 Payment', '03 Review'].map((s, i) => (
                <li class={`step flex-1 p-4 font-mono text-[11px] font-bold uppercase tracking-wide ${i === 0 ? 'ink-block' : 'bg-sand'} ${i > 0 ? 'border-l-2 border-ink' : ''}`} aria-current={i === 0 ? 'step' : undefined} data-step={i}>
                    {s}
                </li>
            ))}
        </ol>
    </div>
</section>

<section
    class="py-16"
    aria-label="Checkout form"
>
    <div class="max-w-[1100px] mx-auto px-6 grid md:grid-cols-[1.5fr_1fr] gap-12">
        <form id="checkout-form" class="space-y-6">
            <fieldset class="step-pane" data-pane="0">
                <legend class="font-sans text-2xl font-extrabold tracking-tight mb-6">Shipping</legend>
                <div class="grid sm:grid-cols-2 gap-4">
                    <input class="h-11 px-4 border-2 border-ink bg-transparent" aria-label="First name" autocomplete="given-name" name="given-name" placeholder="First name" required />
                    <input class="h-11 px-4 border-2 border-ink bg-transparent" aria-label="Last name" autocomplete="family-name" name="family-name" placeholder="Last name" required />
                </div>
                <input class="w-full h-11 px-4 border-2 border-ink bg-transparent font-mono text-[13px] mt-4" aria-label="Email" autocomplete="email" name="email" placeholder="Email" required type="email" />
                <input class="w-full h-11 px-4 border-2 border-ink bg-transparent mt-4" aria-label="Street address" autocomplete="street-address" name="address" placeholder="Street address" required />
                <div class="grid sm:grid-cols-3 gap-4 mt-4">
                    <input class="h-11 px-4 border-2 border-ink bg-transparent" aria-label="City" autocomplete="address-level2" name="city" placeholder="City" required />
                    <input class="h-11 px-4 border-2 border-ink bg-transparent" aria-label="State" autocomplete="address-level1" name="state" placeholder="State" required />
                    <input class="h-11 px-4 border-2 border-ink bg-transparent font-mono" aria-label="ZIP code" autocomplete="postal-code" name="zip" placeholder="ZIP" required />
                </div>
            </fieldset>

            <fieldset class="step-pane hidden" data-pane="1">
                <legend class="font-sans text-2xl font-extrabold tracking-tight mb-6">Payment</legend>
                <input class="w-full h-11 px-4 border-2 border-ink bg-transparent font-mono" aria-label="Card number" autocomplete="cc-number" inputmode="numeric" name="cc-number" placeholder="Card number" required />
                <div class="grid grid-cols-2 gap-4 mt-4">
                    <input class="h-11 px-4 border-2 border-ink bg-transparent font-mono" aria-label="Expiration date" autocomplete="cc-exp" name="cc-exp" placeholder="MM / YY" required />
                    <input class="h-11 px-4 border-2 border-ink bg-transparent font-mono" aria-label="Security code" autocomplete="cc-csc" inputmode="numeric" name="cc-csc" placeholder="CVC" required />
                </div>
                <input class="w-full h-11 px-4 border-2 border-ink bg-transparent mt-4" aria-label="Name on card" autocomplete="cc-name" name="cc-name" placeholder="Name on card" required />
                <p class="label mt-4 text-coral">DEMO ONLY / NO REAL PAYMENT PROCESSED</p>
            </fieldset>

            <fieldset class="step-pane hidden" data-pane="2">
                <legend class="font-sans text-2xl font-extrabold tracking-tight mb-6">Review</legend>
                <div id="review-items" class="border-2 border-ink"></div>
                <p class="mt-6 text-[14px] text-ink-soft">By placing this order you agree to our <a class="underline decoration-coral decoration-2 underline-offset-4 hover:text-coral transition-colors" href="/terms">terms</a>.</p>
            </fieldset>

            <div class="flex justify-between gap-4">
                <button id="prev" class="h-11 px-5 btn-text border-2 border-ink hover:bg-ink hover:text-sand transition-colors" type="button">Back</button>
                <button id="next" class="h-11 px-5 btn-text bg-ink text-sand border-2 border-ink hover:bg-coral hover:border-coral transition-colors" type="button">Continue</button>
            </div>
        </form>

        <aside class="border-2 border-ink p-6 self-start bg-surface">
            <h2 class="label mb-4 text-ink-soft">SUMMARY</h2>
            <div id="summary-items" class="space-y-3 text-[14px]"></div>
            <dl class="mt-4 pt-4 border-t-2 border-ink space-y-1.5 font-mono text-[14px]">
                <div class="flex justify-between"><dt>Subtotal</dt><dd data-subtotal>$0.00</dd></div>
                <div class="flex justify-between"><dt>Shipping</dt><dd>$8.00</dd></div>
                <div class="flex justify-between"><dt>Tax</dt><dd data-tax>$0.00</dd></div>
                <div class="flex justify-between border-t-2 border-ink pt-2 mt-2 font-sans font-extrabold text-lg"><dt>Total</dt><dd data-total>$0.00</dd></div>
            </dl>
        </aside>
    </div>
</section>

<script>
    import { clear, getItems, subtotalCents } from '@/lib/store';
    import { formatPrice, PALETTE } from '@/lib/utils';

    const LAST_STEP = 2;
    const SHIPPING_CENTS = 800;
    const TAX_RATE = 0.0825;

    const next = document.getElementById('next') as HTMLButtonElement;
    const panes = document.querySelectorAll<HTMLElement>('.step-pane');
    const prev = document.getElementById('prev') as HTMLButtonElement;
    const steps = document.querySelectorAll<HTMLElement>('.step');

    let step = 0;

    function paint() {
        steps.forEach((s, i) => {
            if (i <= step) {
                s.classList.add('ink-block');
                s.classList.remove('bg-sand');
            } else {
                s.classList.remove('ink-block');
                s.classList.add('bg-sand');
            }

            if (i === step) s.setAttribute('aria-current', 'step');
            else s.removeAttribute('aria-current');
        });
        panes.forEach((p, i) => p.classList.toggle('hidden', i !== step));
        prev.style.visibility = step === 0 ? 'hidden' : 'visible';
        next.textContent = step === LAST_STEP ? 'Place order' : 'Continue';
    }

    function renderReview() {
        const container = document.getElementById('review-items');

        if (!container) return;

        const cardColors = PALETTE.slice(0, 4);

        container.innerHTML = getItems().map((item, idx) => `
            <div class='p-4 flex gap-4 items-center ${idx > 0 ? 'border-t-2 border-ink' : ''}'>
                <div class='w-14 h-14 shrink-0 relative overflow-hidden flex items-center justify-center' style='background: ${cardColors[idx % cardColors.length]};'>
                    <div class='absolute inset-0 halftone'></div>
                </div>
                <div class='flex-1'>
                    <p class='font-sans font-bold'>${item.title}</p>
                    <p class='label text-ink-soft'>${[item.color, item.size, `\u00d7 ${item.quantity}`].filter(Boolean).join(' / ')}</p>
                </div>
                <p class='font-mono font-bold'>${formatPrice(item.priceCents * item.quantity)}</p>
            </div>
        `).join('');
    }

    function renderSummary() {
        const items = getItems();
        const list = document.getElementById('summary-items');

        if (list) {
            list.innerHTML = items.map(item => `
                <div class='flex justify-between gap-2'>
                    <span>${item.quantity} &times; ${item.title}<br><span class='label text-ink-soft'>${[item.color, item.size].filter(Boolean).join(' / ')}</span></span>
                    <span class='font-mono font-bold'>${formatPrice(item.priceCents * item.quantity)}</span>
                </div>
            `).join('');
        }

        const sub = subtotalCents();
        const tax = Math.round(sub * TAX_RATE);
        const total = sub + tax + SHIPPING_CENTS;
        const subtotalEl = document.querySelector('[data-subtotal]');
        const taxEl = document.querySelector('[data-tax]');
        const totalEl = document.querySelector('[data-total]');

        if (subtotalEl) subtotalEl.textContent = formatPrice(sub);
        if (taxEl) taxEl.textContent = formatPrice(tax);
        if (totalEl) totalEl.textContent = formatPrice(total);
    }

    next.addEventListener('click', () => {
        const pane = panes[step];
        const inputs = pane.querySelectorAll<HTMLInputElement>('input');

        for (const input of inputs) {
            if (!input.checkValidity()) {
                input.reportValidity();
                return;
            }
        }

        if (step < LAST_STEP) {
            step++;
            paint();
            renderReview();
        } else {
            clear();
            window.location.href = '/merch/order';
        }
    });

    prev.addEventListener('click', () => {
        step = Math.max(0, step - 1);
        paint();
    });

    paint();
    renderSummary();
</script>
