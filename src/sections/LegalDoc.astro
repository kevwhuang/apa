---
import { LINKS } from '@lib/utils';

interface Props {
    kind: 'privacy' | 'terms';
}

const SECTIONS: Record<'privacy' | 'terms', { body: string; heading: string }[]> = {
    privacy: [
        {
            body: 'Nothing. The contact, newsletter, and checkout forms on this site are demonstrations \u2014 submitting them does not send, transmit, or store your name, email, or message anywhere.',
            heading: 'What we collect',
        },
        {
            body: 'This site sets no cookies and runs no analytics or ad trackers. Your store cart is saved only in your browser (localStorage) and is never transmitted \u2014 it stays on your device.',
            heading: 'Cookies & storage',
        },
        {
            body: 'The site is hosted on Netlify, which keeps standard server access logs as part of operating its service. All fonts and images are served from our own hosting \u2014 pages load no third-party scripts.',
            heading: 'Hosting',
        },
    ],
    terms: [
        {
            body: 'APA membership is open to producers based in or working in the greater Austin area. Sliding-scale annual dues fund room rent and equipment. Membership is non-transferable.',
            heading: 'Membership',
        },
        {
            body: 'Members agree to leave the studio as they found it, label and clean up their gear, and respect the recording schedule. Repeated violations may result in suspension.',
            heading: 'Studio use',
        },
        {
            body: 'The store is a demonstration \u2014 orders are not processed, charged, or fulfilled, and no payment details are collected.',
            heading: 'Store & orders',
        },
        {
            body: 'Producers retain full ownership of all masters submitted to APA compilations. We license non-exclusive rights to distribute the compilation only.',
            heading: 'Compilations',
        },
    ],
};

const { kind } = Astro.props;

const crossLink = kind === 'privacy'
    ? { href: '/terms', label: 'terms of service' }
    : { href: '/privacy', label: 'privacy policy' };

const title = kind === 'privacy' ? 'Privacy policy' : 'Terms of service';
---

<section
    class="pb-16 pt-20"
    aria-labelledby={`${kind}-title`}
>
    <div class="shell shell--prose wrap-break-word">
        <p class="label reveal mb-4 text-coral-dark">
            Last updated / <time datetime="2026-03">March 2026</time>
        </p>
        <h1
            id={`${kind}-title`}
            class="reveal mb-10 font-extrabold font-sans text-5xl tracking-[-0.04em]"
        >
            {title}
        </h1>
        <div class="reveal space-y-6 leading-[1.7] text-[16px]">
            {SECTIONS[kind].map(section => (
                <>
                    <h2 class="first:pt-0 pt-4 font-extrabold font-sans text-2xl">{section.heading}</h2>
                    <p>{section.body}</p>
                </>
            ))}
            <h2 class="first:pt-0 pt-4 font-extrabold font-sans text-2xl">Contact</h2>
            <p>Email <a class="hover:text-coral-dark decoration-2 decoration-coral underline underline-offset-4 transition-colors" href={`mailto:${LINKS.email}`}>{LINKS.email}</a> with any questions. See also our <a class="hover:text-coral-dark decoration-2 decoration-coral underline underline-offset-4 transition-colors" href={crossLink.href}>{crossLink.label}</a>.</p>
        </div>
    </div>
</section>

<style>
    h1 {
        transition-delay: 0.08s;
    }
</style>
