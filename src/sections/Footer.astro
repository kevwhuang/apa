---
import Logo from '@components/Logo.astro';
import { LINKS, ROUTES } from '@lib/utils';

const COLUMNS = [
    {
        head: 'Explore',
        items: ROUTES,
    },
    {
        head: 'Store',
        items: [
            { href: '/store', label: 'All products' },
            { href: '/store/cart', label: 'Cart' },
            { href: '/store/checkout', label: 'Checkout' },
        ],
    },
    {
        head: 'Connect',
        items: [
            { href: '/contact', label: 'Contact' },
            { href: '/sponsor', label: 'Sponsor' },
            { href: '/media', label: 'Press kit' },
            { href: LINKS.instagram, label: 'Instagram' },
        ],
    },
];

const SYNTH_KEYS = [
    { frequency: 261.6, note: 'C' },
    { frequency: 293.7, note: 'D' },
    { frequency: 329.6, note: 'E' },
    { frequency: 349.2, note: 'F' },
    { frequency: 392, note: 'G' },
    { frequency: 440, note: 'A' },
    { frequency: 493.9, note: 'B' },
];

const year = new Date().getFullYear();
---

<footer
    class="border-t-2 border-ink bg-cream"
    aria-label="Site footer"
>
    <div class="shell grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)]">
        <div>
            <Logo class="mb-5 text-ink" size={32} />
            <p class="max-w-xs mb-8 leading-relaxed text-[14px] text-taupe">
                A community of music producers in Austin, Texas. Founded <time datetime="2019">2019</time>. Above a print shop on 5th.
            </p>
            <h2 class="label mb-3 text-taupe">Synth keys</h2>
            <ul class="inline-flex border-2 border-ink list-none">
                {SYNTH_KEYS.map(key => (
                    <li class="border-r-2 border-ink last:border-r-0">
                        <button
                            class="synth-key hover:bg-coral hover:text-ink flex items-end justify-center relative h-14 w-9 pb-1.5 font-bold font-mono text-[10px] bg-sand select-none transition-colors"
                            aria-label={`Play note ${key.note}`}
                            data-frequency={key.frequency}
                            type="button"
                        >
                            {key.note}
                        </button>
                    </li>
                ))}
            </ul>
        </div>
        {COLUMNS.map(column => (
            <div>
                <h2 class="label mb-4 text-taupe">{column.head}</h2>
                <ul class="space-y-2.5 list-none text-[14px]">
                    {column.items.map(item => (
                        <li>
                            <a
                                class="hover:text-coral-dark transition-colors"
                                href={item.href}
                                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                                target={item.href.startsWith('http') ? '_blank' : undefined}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
    <div class="border-t-2 border-ink">
        <div class="shell flex flex-wrap items-center justify-between gap-4 py-5 font-mono text-[12px] text-taupe">
            <p>&copy; {year} Austin Producer Alliance. Made in Austin.</p>
            <nav
                class="flex gap-5 tracking-wide uppercase"
                aria-label="Legal"
            >
                <a
                    class="hover:text-coral-dark transition-colors"
                    href="/privacy"
                >
                    Privacy
                </a>
                <a
                    class="hover:text-coral-dark transition-colors"
                    href="/terms"
                >
                    Terms
                </a>
            </nav>
        </div>
    </div>
</footer>

<style>
    .synth-key.is-pressed {
        background: var(--color-coral);
        color: var(--color-ink);
    }

    .synth-key::after {
        content: '';
        inset: -6px;
        position: absolute;
    }
</style>

<script>
    const ATTACK_TIME = 0.01;
    const FLASH_DURATION = 150;
    const MIN_GAIN = 0.0001;
    const NOTE_DURATION = 0.45;
    const PEAK_GAIN = 0.15;
    const RELEASE_TIME = 0.4;

    const flashTimers = new WeakMap<HTMLElement, number>();

    let audioContext: AudioContext | undefined;
    let footerController: AbortController | undefined;

    function handleKeyClick(key: HTMLElement) {
        audioContext ??= new AudioContext();

        const frequency = Number(key.dataset.frequency);
        const gainNode = audioContext.createGain();
        const oscillator = audioContext.createOscillator();

        oscillator.type = 'sawtooth';
        oscillator.frequency.value = frequency;
        gainNode.gain.setValueAtTime(MIN_GAIN, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(PEAK_GAIN, audioContext.currentTime + ATTACK_TIME);
        gainNode.gain.exponentialRampToValueAtTime(MIN_GAIN, audioContext.currentTime + RELEASE_TIME);
        oscillator.connect(gainNode).connect(audioContext.destination);
        oscillator.start();
        oscillator.stop(audioContext.currentTime + NOTE_DURATION);

        clearTimeout(flashTimers.get(key));
        key.classList.add('is-pressed');
        flashTimers.set(key, window.setTimeout(() => key.classList.remove('is-pressed'), FLASH_DURATION));
    }

    function initFooter() {
        footerController?.abort();
        footerController = new AbortController();

        const { signal } = footerController;

        const keys = document.querySelectorAll<HTMLElement>('.synth-key');

        keys.forEach((key) => {
            key.addEventListener('click', () => handleKeyClick(key), { signal });
        });
    }

    document.addEventListener('astro:page-load', initFooter);
</script>
