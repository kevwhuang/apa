---
import type { CollectionEntry } from 'astro:content';

import PlaceholderTile from '@components/PlaceholderTile.astro';
import { formatPrice, PALETTE } from '@lib/utils';

interface Props {
    product: CollectionEntry<'products'>['data'];
}

const imageColors = PALETTE.slice(0, 3);
const { product } = Astro.props;
const { slug = '' } = Astro.params;
---

<nav
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-label="Breadcrumb"
>
    <div class="label reveal shell text-taupe">
        <a
            class="hover:text-coral-dark transition-colors"
            href="/store"
        >
            &larr; All products
        </a>
        / {product.category}
    </div>
</nav>

<section
    class="py-16"
    aria-labelledby="product-title"
>
    <div class="shell grid grid-cols-1 gap-12 md:grid-cols-2">
        <ul class="reveal--stagger space-y-4 list-none">
            {product.images.map((_, index) => (
                <li>
                    <PlaceholderTile
                        class="aspect-square border-2 border-ink shadow-card"
                        color={imageColors[index % imageColors.length]}
                        label={product.title.split(' ')[0]}
                        labelClass="text-6xl uppercase text-white/80"
                    />
                </li>
            ))}
        </ul>
        <div class="reveal--stagger self-start space-y-8 md:sticky md:top-28">
            <div>
                <p class="label mb-2 text-coral-dark">{product.category}</p>
                <h1
                    id="product-title"
                    class="font-extrabold font-sans leading-tight text-4xl tracking-[-0.03em] md:text-5xl"
                >
                    {product.title}
                </h1>
                <p class="mt-3 font-bold font-mono text-2xl">{formatPrice(product.priceCents)}</p>
            </div>
            <p class="leading-relaxed text-[16px] text-taupe">{product.description}</p>
            <form
                class="add-form space-y-6"
                data-image={product.images[0]}
                data-price-cents={product.priceCents}
                data-slug={slug}
                data-title={product.title}
            >
                {product.colors.length > 0 && (
                    <div>
                        <p class="label mb-3 text-taupe">
                            Color / <span data-color-output>{product.colors[0].name}</span>
                        </p>
                        <div
                            class="flex gap-2"
                            aria-label="Color options"
                            role="group"
                        >
                            {product.colors.map((color, index) => (
                                <button
                                    class="active:border-ink aria-pressed:border-ink hover:border-ink h-10 w-10 border-2 border-taupe transition-colors"
                                    aria-label={color.name}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-color={color.name}
                                    style={`background: ${color.hex};`}
                                    type="button"
                                />
                            ))}
                        </div>
                    </div>
                )}
                {product.sizes.length > 0 && (
                    <div>
                        <p class="label mb-3 text-taupe">Size</p>
                        <div
                            class="flex flex-wrap gap-2"
                            aria-label="Size options"
                            role="group"
                        >
                            {product.sizes.map((size, index) => (
                                <button
                                    class:list={[
                                        'active:bg-ink active:text-sand hover:bg-ink hover:text-sand h-11 min-w-11 px-3 border-2 border-ink font-bold font-mono text-[12px] uppercase transition-colors',
                                        index === 0 && 'is-active',
                                    ]}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-size={size}
                                    type="button"
                                >
                                    {size}
                                </button>
                            ))}
                        </div>
                    </div>
                )}
                <div>
                    <p class="label mb-3 text-taupe">Quantity</p>
                    <div class="inline-flex items-center border-2 border-ink">
                        <button
                            class="active:bg-bone disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:opacity-55 hover:bg-cream relative h-11 w-11 font-bold text-lg transition"
                            aria-label="Decrease quantity"
                            data-quantity="-1"
                            disabled
                            type="button"
                        >
                            &minus;
                        </button>
                        <span
                            class="w-12 font-bold font-mono text-center"
                            aria-live="polite"
                            data-quantity-output
                        >
                            1
                        </span>
                        <button
                            class="active:bg-bone hover:bg-cream relative h-11 w-11 font-bold text-lg transition-colors"
                            aria-label="Increase quantity"
                            data-quantity="+1"
                            type="button"
                        >
                            +
                        </button>
                    </div>
                </div>
                <button
                    class="btn btn--primary h-14 w-full"
                    disabled={!product.inStock}
                    type="submit"
                >
                    Add to cart
                </button>
                <p
                    class="action-text hidden p-3 text-center bg-coral text-ink"
                    data-added
                    role="status"
                />
            </form>
            {product.details.length > 0 && (
                <details class="pt-4 border-t-2 border-ink">
                    <summary class="label hover:text-coral-dark cursor-pointer select-none transition-colors">
                        Details
                    </summary>
                    <ul class="mt-3 space-y-1 text-[14px] text-taupe">
                        {product.details.map(detail => (
                            <li class="flex gap-2">
                                <span
                                    class="font-bold text-coral-dark"
                                    aria-hidden="true"
                                >
                                    &middot;
                                </span>
                                {detail}
                            </li>
                        ))}
                    </ul>
                </details>
            )}
        </div>
    </div>
</section>

<style>
    [data-color] {
        position: relative;
    }

    [data-color]::after,
    [data-quantity]::after {
        content: '';
        position: absolute;
    }

    [data-color]::after {
        inset: -4px;
    }

    [data-quantity]::after {
        inset: -2px;
    }
</style>

<script>
    import { add } from '@lib/store';

    let productDetailController: AbortController | undefined;
    let quantity = 1;

    function handleAddSubmit(event: SubmitEvent, form: HTMLFormElement, notice: HTMLElement | null) {
        event.preventDefault();

        const color = form.querySelector<HTMLButtonElement>('[data-color][aria-pressed="true"]')?.dataset.color;
        const size = form.querySelector<HTMLButtonElement>('[data-size][aria-pressed="true"]')?.dataset.size;
        const title = form.dataset.title ?? '';

        add({
            color,
            image: form.dataset.image ?? '',
            priceCents: Number(form.dataset.priceCents),
            productSlug: form.dataset.slug ?? '',
            quantity,
            size,
            title,
        });

        if (!notice) return;

        notice.textContent = `Added ${quantity} \u00d7 ${title} to cart`;
        notice.classList.remove('hidden');
    }

    function handleColorClick(button: HTMLButtonElement, swatches: NodeListOf<HTMLButtonElement>, output: HTMLElement | null) {
        swatches.forEach((swatch) => {
            swatch.setAttribute('aria-pressed', String(swatch === button));
        });

        if (output) output.textContent = button.dataset.color ?? '';
    }

    function handleQuantityClick(step: number, decrease: HTMLButtonElement, output: HTMLElement) {
        quantity = Math.max(1, quantity + step);
        updateQuantity(decrease, output);
    }

    function handleSizeClick(button: HTMLButtonElement, sizeButtons: NodeListOf<HTMLButtonElement>) {
        sizeButtons.forEach((sizeButton) => {
            sizeButton.classList.toggle('is-active', sizeButton === button);
            sizeButton.setAttribute('aria-pressed', String(sizeButton === button));
        });
    }

    function initProductDetail() {
        productDetailController?.abort();
        productDetailController = new AbortController();

        const { signal } = productDetailController;

        const form = document.querySelector<HTMLFormElement>('.add-form');

        if (!form) return;

        const colorOutput = form.querySelector<HTMLElement>('[data-color-output]');
        const decrease = form.querySelector<HTMLButtonElement>('[data-quantity="-1"]');
        const increase = form.querySelector<HTMLButtonElement>('[data-quantity="+1"]');
        const notice = form.querySelector<HTMLElement>('[data-added]');
        const quantityOutput = form.querySelector<HTMLElement>('[data-quantity-output]');
        const sizeButtons = form.querySelectorAll<HTMLButtonElement>('[data-size]');
        const swatches = form.querySelectorAll<HTMLButtonElement>('[data-color]');

        quantity = 1;

        if (decrease && increase && quantityOutput) {
            updateQuantity(decrease, quantityOutput);
            decrease.addEventListener('click', () => handleQuantityClick(-1, decrease, quantityOutput), { signal });
            increase.addEventListener('click', () => handleQuantityClick(1, decrease, quantityOutput), { signal });
        }

        form.addEventListener('submit', event => handleAddSubmit(event, form, notice), { signal });

        sizeButtons.forEach((button) => {
            button.addEventListener('click', () => handleSizeClick(button, sizeButtons), { signal });
        });

        swatches.forEach((button) => {
            button.addEventListener('click', () => handleColorClick(button, swatches, colorOutput), { signal });
        });
    }

    function updateQuantity(decrease: HTMLButtonElement, output: HTMLElement) {
        decrease.disabled = quantity <= 1;
        output.textContent = String(quantity);
    }

    document.addEventListener('astro:page-load', initProductDetail);
</script>
