---
const SPONSORS = ['East Side Co-op', 'Heritage Print', 'Hi-Fi Tape', 'Lone Star Mics', 'Mantis Audio', 'Station Austin', 'Studio Ten', 'Wax Mtn Records'];
---

<section
    class="py-20 border-b-2 border-ink"
    aria-labelledby="sponsors-title"
>
    <div class="shell">
        <h2
            id="sponsors-title"
            class="sr-only"
        >
            Sponsors
        </h2>
        <p class="label reveal mb-8 text-center text-taupe">
            Backed by
        </p>
        <ul class="reveal--stagger grid grid-cols-2 gap-px mb-8 border-2 border-ink list-none bg-ink lg:grid-cols-8 md:grid-cols-4">
            {SPONSORS.map(sponsor => (
                <li class="flex items-center justify-center aspect-[2/1] font-bold font-sans text-[13px] tracking-tight bg-sand">
                    {sponsor}
                </li>
            ))}
        </ul>
        <p class="reveal font-mono text-[13px] text-center text-taupe">
            Become a sponsor &mdash;
            <a
                class="hover:text-coral-dark underline underline-offset-4 transition-colors"
                href="/sponsor"
            >
                view tiers &rarr;
            </a>
        </p>
    </div>
</section>
