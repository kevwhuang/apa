---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { AVATAR, GENRES, PASSWORD_MIN_LENGTH, PROFILE_FIELDS, PROFILE_ROLES, SPOTLIGHT, SPOTLIGHT_EXTENSIONS_LABEL, US_STATES } from '@lib/shared/constants';
import { AVATAR_EXTENSIONS_OR_LIST } from '@lib/account/images';
import { formatBytes, formatDateStamp, formatProds, getInitials, getStanding, pickTileColor } from '@lib/shared/utils';

const ATTENDANCE = [
    { date: '2026-07-25T13:30:00-05:00', event: 'Bash \u00b7 July' },
    { date: '2026-07-22T19:00:00-05:00', event: 'Hangout \u00b7 July' },
    { date: '2026-06-11T18:00:00-05:00', event: 'Assembly \u00b7 June' },
    { date: '2026-03-21T13:30:00-05:00', event: 'Bash \u00b7 March' },
    { date: '2025-11-15T13:30:00-06:00', event: 'Bash \u00b7 November' },
    { date: '2024-03-14T18:00:00-05:00', event: 'Assembly \u00b7 March' },
];

const DEMO_PROFILE = {
    artistName: 'Nightshift',
    bio: 'I write patient, low-slung house in a converted garage on the east side and mix it loud enough to rattle the door.',
    city: 'Austin',
    email: 'nightshift@austinproduceralliance.com',
    genres: ['house', 'techno'],
    joined: new Date('2024-03-12T18:00:00Z'),
    links: {
        instagram: 'https://instagram.com/nightshift.wav',
        soundcloud: 'https://soundcloud.com/nightshift',
        spotify: 'https://open.spotify.com/artist/4kZ1nightshift',
        youtube: 'https://youtube.com/@nightshift',
    },
    prods: 8,
    role: 'producer',
    state: 'TX',
    track: { name: 'Untitled Sketch 09.mp3' },
};

const LINK_FIELDS = [
    { label: 'Instagram', name: 'instagram', placeholder: 'https://instagram.com/\u2026', value: DEMO_PROFILE.links.instagram },
    { label: 'Spotify', name: 'spotify', placeholder: 'https://open.spotify.com/artist/\u2026', value: DEMO_PROFILE.links.spotify },
    { label: 'SoundCloud', name: 'soundcloud', placeholder: 'https://soundcloud.com/\u2026', value: DEMO_PROFILE.links.soundcloud },
    { label: 'YouTube', name: 'youtube', placeholder: 'https://youtube.com/@\u2026', value: DEMO_PROFILE.links.youtube },
];

const PRODS_LEDGER = [
    { amount: 1, date: '2024-03-12T13:00:00-05:00', reason: 'Welcome Prod' },
    { amount: 1, date: '2024-03-14T18:00:00-05:00', reason: 'Attended the March Assembly' },
    { amount: 1, date: '2025-11-15T13:30:00-06:00', reason: 'Attended the November Bash' },
    { amount: 1, date: '2026-03-21T13:30:00-05:00', reason: 'Attended the March Bash' },
    { amount: 2, date: '2026-03-28T11:00:00-05:00', reason: 'Finished a Bash track' },
    { amount: -1, date: '2026-04-02T09:00:00-05:00', reason: 'Redeemed \u2014 Store credit' },
    { amount: 1, date: '2026-06-11T18:00:00-05:00', reason: 'Attended the June Assembly' },
    { amount: 1, date: '2026-07-22T19:00:00-05:00', reason: 'Attended the July Hangout' },
    { amount: 1, date: '2026-07-25T13:30:00-05:00', reason: 'Attended the July Bash' },
];

const PRODS_ROWS = PRODS_LEDGER.map((entry, index) => ({
    ...entry,
    balance: PRODS_LEDGER.slice(0, index + 1).reduce((total, item) => total + item.amount, 0),
    change: entry.amount > 0 ? `+${entry.amount}` : `\u2212${Math.abs(entry.amount)}`,
})).toReversed();
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="settings-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Account / Settings"
            headingId="settings-title"
        >
            Your settings.
        </PageHead>
        <p
            class="max-w-2xl text-lmd text-ink-muted"
            data-motion="rise"
        >
            Everything your roster card carries: the name people read, the portrait behind it, a
            short bio, what you make, where you are based, where else you live online, and the
            spotlight track that plays on the card.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Account and profile"
>
    <div
        class="flex flex-col gap-(--space-2xl)"
        data-motion-stagger="rise"
    >
        <div class="flex flex-col gap-5">
            <div class="settings__overview slab slab--bare slab--card grid gap-px">
                <div class="p-(--space-md) bg-surface-raised">
                    <p class="label mb-4 text-ink-muted">Your card</p>
                    <div class="flex flex-wrap gap-5">
                        <PlaceholderTile
                            class="settings__tile self-start shrink-0 aspect-square w-[104px] border-2 border-ink"
                            color={pickTileColor(DEMO_PROFILE.artistName)}
                            label={getInitials(DEMO_PROFILE.artistName)}
                            labelClass="settings__initials leading-none text-[38cqw] text-surface-raised/80 [text-shadow:2px_2px_0_var(--color-ink-20)]"
                        >
                            <img
                                class="absolute inset-0 object-cover h-full w-full"
                                alt=""
                                data-settings-avatar
                                hidden
                            />
                        </PlaceholderTile>
                        <div class="flex-[1_1_200px]">
                            <p
                                class="mb-2 font-extrabold font-sans text-xl tracking-tight wrap-break-word"
                                data-settings-name
                            >
                                {DEMO_PROFILE.artistName}
                            </p>
                            <p class="mb-3">
                                <span
                                    class="chip settings__role"
                                    data-settings-role
                                >
                                    {DEMO_PROFILE.role}
                                </span>
                            </p>
                            <p class="mb-3 font-mono text-2xs uppercase text-ink-muted">
                                <span data-settings-role>{DEMO_PROFILE.role}</span> &mdash; {DEMO_PROFILE.city}, {DEMO_PROFILE.state}
                            </p>
                            <ul class="flex flex-wrap gap-2 list-none">
                                {DEMO_PROFILE.genres.map(genre => (
                                    <li class="inline-flex items-center h-6 px-2 border-2 border-ink font-bold font-mono text-2xs tracking-wide uppercase">{genre}</li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
                <dl
                    class="settings__stats grid gap-px"
                    aria-label="Account standing"
                >
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Prods balance</dt>
                        <dd
                            class="font-extrabold font-sans leading-[0.9] text-4xl tracking-tight"
                            data-settings-prods
                        >
                            {formatProds(DEMO_PROFILE.prods)}
                        </dd>
                    </div>
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Events attended</dt>
                        <dd class="font-extrabold font-sans text-3xl tracking-tight">{ATTENDANCE.length}</dd>
                    </div>
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Standing</dt>
                        <dd
                            class="label"
                            data-settings-standing
                        >
                            {getStanding(DEMO_PROFILE.prods)}
                        </dd>
                    </div>
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Member since</dt>
                        <dd
                            class="font-mono text-sm"
                            data-settings-since
                        >
                            {formatDateStamp(DEMO_PROFILE.joined)}
                        </dd>
                    </div>
                    <div class="col-span-full p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Email</dt>
                        <dd
                            class="font-mono text-sm wrap-break-word"
                            data-settings-email
                        >
                            {DEMO_PROFILE.email}
                        </dd>
                    </div>
                </dl>
            </div>
            <a
                class="action-text hover:text-accent-deep inline-flex items-center self-start min-h-(--control-size) gap-(--space-2xs) px-(--space-3xs) underline transition-colors"
                data-settings-onboarding
                hidden
                href="/onboarding"
            >
                Finish your profile <IconArrow />
            </a>
        </div>
        <form
            class="settings__form slab slab--card"
            data-settings-form
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Profile
            </h2>
            <div class="flex flex-col gap-2">
                <p class="label mb-1 text-ink-muted">{PROFILE_FIELDS.portrait.label}</p>
                <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 flex flex-wrap items-center gap-(--space-md)">
                    <label class="settings__pick">
                        <span class="label">{PROFILE_FIELDS.portrait.picker}</span>
                        <input
                            id="settings-portrait"
                            class="settings__file sr-only"
                            accept={AVATAR.acceptAttribute}
                            aria-describedby="settings-portrait-error settings-portrait-help"
                            aria-invalid="false"
                            data-portrait-input
                            name="portrait"
                            type="file"
                        />
                    </label>
                    <div
                        class="settings__staged settings__staged--portrait slab slab--sunk"
                        data-portrait-staged
                        hidden
                    >
                        <img
                            class="object-cover h-16 w-16 border-2 border-ink"
                            alt="Your staged portrait"
                            data-portrait-preview
                        />
                        <button
                            class="action-text hover:text-accent-deep flex items-center min-h-(--control-size) px-1 text-ink-muted transition-colors"
                            data-portrait-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                </div>
                <p
                    id="settings-portrait-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-portrait-help"
                    class="text-sm text-ink-subtle"
                >
                    {AVATAR_EXTENSIONS_OR_LIST}. Up to {formatBytes(AVATAR.maxFileBytes)}, at least {AVATAR.minEdgePixels}px on each side.
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.artistName.label}</span>
                    <input
                        id="settings-name"
                        class="input font-sans"
                        aria-describedby="settings-name-error settings-name-help"
                        aria-invalid="false"
                        autocomplete={PROFILE_FIELDS.artistName.autocomplete}
                        maxlength={PROFILE_FIELDS.artistName.maxLength}
                        name="artistName"
                        type="text"
                        value={DEMO_PROFILE.artistName}
                    />
                </label>
                <p
                    id="settings-name-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-name-help"
                    class="text-sm text-ink-subtle"
                >
                    {PROFILE_FIELDS.artistName.help}
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.bio.label}</span>
                    <textarea
                        id="settings-bio"
                        class="input input--area font-sans"
                        aria-describedby="settings-bio-error settings-bio-help"
                        aria-invalid="false"
                        maxlength={PROFILE_FIELDS.bio.maxLength}
                        name="bio"
                        rows="4"
                        set:text={DEMO_PROFILE.bio}
                    />
                </label>
                <p
                    id="settings-bio-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-bio-help"
                    class="text-sm text-ink-subtle"
                >
                    <span data-bio-count>{DEMO_PROFILE.bio.length}</span> of {PROFILE_FIELDS.bio.maxLength} characters.
                    {PROFILE_FIELDS.bio.help}
                </p>
            </div>
            <fieldset class="flex flex-col gap-3">
                <legend class="label mb-1 text-ink-muted">
                    {PROFILE_FIELDS.genres.label} <span class="text-ink-subtle">/ {PROFILE_FIELDS.genres.qualifier}</span>
                </legend>
                <div class="flex flex-wrap gap-2">
                    {GENRES.map(genre => (
                        <label class="settings__chip">
                            <input
                                class="box"
                                aria-describedby="settings-genres-error"
                                aria-invalid="false"
                                checked={DEMO_PROFILE.genres.includes(genre)}
                                name="genres"
                                type="checkbox"
                                value={genre}
                            />
                            {genre}
                        </label>
                    ))}
                </div>
                <p
                    id="settings-genres-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </fieldset>
            <fieldset class="flex flex-col gap-3">
                <legend class="label mb-1 text-ink-muted">
                    {PROFILE_FIELDS.role.label} <span class="text-ink-subtle">/ {PROFILE_FIELDS.role.qualifier}</span>
                </legend>
                <div class="flex flex-wrap gap-2">
                    {PROFILE_ROLES.map(role => (
                        <label class="settings__chip">
                            <input
                                class="box"
                                checked={role.id === DEMO_PROFILE.role}
                                name="role"
                                type="radio"
                                value={role.id}
                            />
                            {role.id}
                        </label>
                    ))}
                </div>
            </fieldset>
            <div class="settings__pair">
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.city.label}</span>
                        <input
                            id="settings-city"
                            class="input font-sans"
                            aria-describedby="settings-city-error"
                            aria-invalid="false"
                            autocomplete={PROFILE_FIELDS.city.autocomplete}
                            name="city"
                            required={PROFILE_FIELDS.city.required}
                            type="text"
                            value={DEMO_PROFILE.city}
                        />
                    </label>
                    <p
                        id="settings-city-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">{PROFILE_FIELDS.state.label}</span>
                        <span class="select">
                            <select
                                id="settings-state"
                                class="input font-sans"
                                aria-describedby="settings-state-error"
                                aria-invalid="false"
                                autocomplete={PROFILE_FIELDS.state.autocomplete}
                                name="state"
                                required={PROFILE_FIELDS.state.required}
                            >
                                {US_STATES.map(state => (
                                    <option
                                        selected={state.code === DEMO_PROFILE.state}
                                        value={state.code}
                                    >
                                        {state.name}
                                    </option>
                                ))}
                            </select>
                        </span>
                    </label>
                    <p
                        id="settings-state-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save profile
            </button>
        </form>
        <form
            class="settings__form slab slab--card"
            data-links-form
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Links
            </h2>
            <p class="max-w-2xl text-sm text-ink-subtle">
                Where else you live online. Every field is optional, and whatever you fill in shows
                up on your roster card.
            </p>
            {LINK_FIELDS.map(field => (
                <div class="flex flex-col gap-2">
                    <label class="block">
                        <span class="label block mb-2 text-ink-muted">{field.label}</span>
                        <input
                            id={`settings-${field.name}`}
                            class="input font-mono text-sm"
                            aria-describedby={`settings-${field.name}-error`}
                            aria-invalid="false"
                            inputmode="url"
                            name={field.name}
                            placeholder={field.placeholder}
                            spellcheck="false"
                            type="url"
                            value={field.value}
                        />
                    </label>
                    <p
                        id={`settings-${field.name}-error`}
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
            ))}
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save links
            </button>
        </form>
        <form
            class="settings__form slab slab--card"
            data-password-form
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Password
            </h2>
            <div class="flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">New password</span>
                    <span class="block relative">
                        <input
                            id="settings-password"
                            class="input pr-12 font-sans"
                            aria-describedby="settings-password-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            minlength={PASSWORD_MIN_LENGTH}
                            name="password"
                            required
                            type="password"
                        />
                        <button
                            class="settings__reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-password"
                            type="button"
                        >
                            <span class="settings__glyph--show flex items-center">
                                <IconEye />
                            </span>
                            <span class="settings__glyph--hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-password-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
                <p class="text-sm text-ink-subtle">
                    At least {PASSWORD_MIN_LENGTH} characters with a letter and a digit.
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="block">
                    <span class="label block mb-2 text-ink-muted">Confirm new password</span>
                    <span class="block relative">
                        <input
                            id="settings-confirm"
                            class="input pr-12 font-sans"
                            aria-describedby="settings-confirm-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            name="confirm"
                            required
                            type="password"
                        />
                        <button
                            class="settings__reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-confirm"
                            type="button"
                        >
                            <span class="settings__glyph--show flex items-center">
                                <IconEye />
                            </span>
                            <span class="settings__glyph--hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-confirm-error"
                    class="action-text text-accent-deep"
                    data-field-error
                    hidden
                />
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Update password
            </button>
        </form>
        <form
            class="settings__form settings__form--full slab slab--card"
            data-track-form
        >
            <h2 class="font-extrabold font-sans text-2xl tracking-tight">
                Spotlight
            </h2>
            <p class="max-w-2xl text-sm text-ink-subtle">
                One file, and it is the one that plays on your roster card. Swap it whenever the
                better take arrives.
            </p>
            <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 flex flex-wrap items-center gap-(--space-md)">
                <label class="settings__pick">
                    <span class="label">Choose an audio file</span>
                    <input
                        id="settings-track"
                        class="settings__file sr-only"
                        accept={SPOTLIGHT.acceptAttribute}
                        aria-describedby="settings-track-error settings-track-help"
                        aria-invalid="false"
                        data-track-input
                        name="track"
                        type="file"
                    />
                </label>
                <p
                    class="flex-[1_1_200px] text-sm text-ink-subtle"
                    data-track-empty
                    hidden
                >
                    Nothing staged yet.
                </p>
                <div
                    class="settings__staged slab slab--sunk"
                    data-track-staged
                >
                    <p
                        class="min-w-0 font-bold font-sans wrap-anywhere"
                        data-track-name
                    >
                        {DEMO_PROFILE.track.name}
                    </p>
                    <button
                        class="action-text hover:text-accent-deep flex items-center min-h-(--control-size) px-1 text-ink-muted transition-colors"
                        data-track-remove
                        type="button"
                    >
                        Remove
                    </button>
                </div>
            </div>
            <p
                id="settings-track-error"
                class="action-text text-accent-deep"
                data-field-error
                hidden
            />
            <p
                id="settings-track-help"
                class="text-sm text-ink-subtle"
            >
                {SPOTLIGHT_EXTENSIONS_LABEL} only. Up to {formatBytes(SPOTLIGHT.maxFileBytes)}.
            </p>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save track
            </button>
        </form>
        <section
            class="settings__panel slab slab--card"
            aria-labelledby="settings-attendance-title"
        >
            <h2
                id="settings-attendance-title"
                class="font-extrabold font-sans text-2xl tracking-tight"
            >
                Attendance
            </h2>
            <p class="max-w-2xl text-sm text-ink-subtle">
                Every event you have checked in to since you joined, newest first.
            </p>
            <div class="scroll-slot settings__scroller--attendance overflow-x-auto border-2 border-ink">
                <table class="settings__table">
                    <caption class="sr-only">Events you checked in to, with the date of each check-in</caption>
                    <thead>
                        <tr class="font-bold font-mono text-2xs tracking-wide uppercase text-ink-muted">
                            <th
                                class="px-4 py-3 text-left"
                                scope="col"
                            >
                                Event
                            </th>
                            <th
                                class="px-4 py-3 text-right"
                                scope="col"
                            >
                                Date
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink">
                        {ATTENDANCE.map(entry => (
                            <tr>
                                <th
                                    class="px-4 py-4 font-bold font-sans text-left whitespace-nowrap"
                                    scope="row"
                                >
                                    {entry.event}
                                </th>
                                <td class="px-4 py-4 font-mono text-right text-xs whitespace-nowrap text-ink-muted">
                                    <time datetime={entry.date}>{formatDateStamp(new Date(entry.date))}</time>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
        <section
            class="settings__panel slab slab--card"
            aria-labelledby="settings-ledger-title"
        >
            <h2
                id="settings-ledger-title"
                class="font-extrabold font-sans text-2xl tracking-tight"
            >
                Prods ledger
            </h2>
            <p class="max-w-2xl text-sm text-ink-subtle">
                Every Prod earned or spent since you joined, newest first, with the balance that
                stood after each entry.
            </p>
            <div class="scroll-slot settings__scroller--ledger overflow-x-auto border-2 border-ink">
                <table class="settings__table min-w-[520px]">
                    <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                    <thead>
                        <tr class="font-bold font-mono text-2xs tracking-wide uppercase text-ink-muted">
                            <th
                                class="px-4 py-3 text-left"
                                scope="col"
                            >
                                Date
                            </th>
                            <th
                                class="px-4 py-3 text-left"
                                scope="col"
                            >
                                Reason
                            </th>
                            <th
                                class="px-4 py-3 text-right"
                                scope="col"
                            >
                                Change
                            </th>
                            <th
                                class="px-4 py-3 text-right"
                                scope="col"
                            >
                                Balance
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink">
                        {PRODS_ROWS.map(row => (
                            <tr>
                                <td class="px-4 py-4 font-mono text-xs whitespace-nowrap text-ink-muted">
                                    <time datetime={row.date}>{formatDateStamp(new Date(row.date))}</time>
                                </td>
                                <td class="px-4 py-4 text-sm">{row.reason}</td>
                                <td class:list={['px-4 py-4 font-mono text-right text-xs', row.amount < 0 && 'text-accent-deep']}>
                                    {row.change}
                                </td>
                                <td class="px-4 py-4 font-mono text-right text-xs">{row.balance}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>

<style>
    .settings__chip {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        gap: var(--space-2xs);
        letter-spacing: 0.025em;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        text-transform: uppercase;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
    }

    .settings__chip:has(.box:checked) {
        background-color: var(--color-surface-sunken);
    }

    .settings__file {
        clip-path: inset(50%);
        height: 100%;
        inset: 0;
        margin: 0;
        width: 100%;
    }

    .settings__form {
        margin-inline: auto;
        max-width: var(--measure-form);
        padding: var(--space-lg);
        width: 100%;
    }

    .settings__form--full {
        max-width: none;
    }

    .settings__form,
    .settings__panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .settings__overview {
        --slab-fill: var(--color-ink);
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .settings__pair {
        display: grid;
        gap: var(--space-md);
        grid-template-columns: minmax(0, 1fr) minmax(0, 220px);
    }

    .settings__pick {
        align-items: center;
        background-color: var(--color-surface);
        background-image: repeating-linear-gradient(135deg, var(--color-ink-10) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-ink);
        display: flex;
        flex: 1 1 220px;
        justify-content: center;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        position: relative;
        text-align: center;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .settings__pick:active {
        background-color: var(--color-surface-raised);
        border-color: var(--color-accent-deep);
    }

    .settings__pick:has(.settings__file:focus) {
        border-color: var(--color-accent-deep);
        border-style: solid;
    }

    .settings__pick:has(.settings__file[aria-invalid='true']) {
        border-color: var(--color-accent-deep);
        box-shadow: 3px 3px 0 0 var(--color-accent-20);
    }

    .settings__pick:hover {
        background-color: var(--color-surface-raised);
        border-color: var(--color-accent-deep);
    }

    .settings__reveal {
        align-items: center;
        bottom: 0;
        color: var(--color-ink-muted);
        cursor: pointer;
        display: flex;
        justify-content: center;
        position: absolute;
        right: 0;
        top: 0;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .settings__reveal::after {
        content: '';
        height: 48px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
    }

    .settings__reveal:active {
        transform: translateY(1px);
    }

    .settings__reveal:focus-visible {
        outline-offset: -4px;
    }

    .settings__reveal:hover {
        color: var(--color-accent-deep);
    }

    .settings__reveal[aria-pressed='false'] .settings__glyph--hide,
    .settings__reveal[aria-pressed='true'] .settings__glyph--show {
        display: none;
    }

    .settings__role {
        min-height: var(--space-lg);
        text-transform: capitalize;
    }

    .settings__scroller--attendance {
        --scroll-slot-max: calc(44px + 5 * (33px + 24px));
    }

    .settings__scroller--ledger {
        --scroll-slot-max: calc(44px + 5 * (33px + 10 * var(--text-sm) / 7));
    }

    .settings__staged {
        align-items: center;
        column-gap: var(--space-sm);
        display: flex;
        flex: 1 1 260px;
        flex-wrap: wrap;
        justify-content: space-between;
        padding: 0 var(--space-sm);
        row-gap: var(--space-3xs);
    }

    .settings__staged--portrait {
        padding-block: var(--space-2xs);
    }

    .settings__stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .settings__table {
        display: table;
        overflow-x: visible;
        width: 100%;
    }

    .settings__table thead th {
        background-color: var(--color-surface-raised);
        box-shadow: inset 0 -2px 0 var(--color-ink);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 1024px) {
        .settings__overview {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .settings__pair,
        .settings__stats {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { MOCK_LATENCY_MS, PROFILE_FIELDS, SPOTLIGHT, SPOTLIGHT_EXTENSIONS_LABEL } from '@lib/shared/constants';
    import { clearFieldErrors, confirmRule, focusFirstError, handleReveal, isValidationBypassed, passwordRule, setFieldErrors, setRole, validateFields } from '@lib/ui/forms';
    import { delay, formatDateStamp, formatProds, getInitials, getStanding, pickTileColor, registerPageScript, setAvatarImage, setPending, setText } from '@lib/shared/utils';
    import { getExtension, getSizeError, releaseAudioContext, uploadSubmission } from '@lib/audio/uploads';
    import { getOnboardingHref } from '@lib/account/onboarding';
    import { getSession, onSessionChange, saveSession } from '@lib/account/session';
    import { stageAvatar } from '@lib/account/images';
    import { toast } from '@lib/ui/toasts';

    const INVALID_MESSAGE = 'Check the fields.';
    const LINK_MESSAGE = 'Use a full address that starts with https://.';
    const LINK_NAMES = ['instagram', 'spotify', 'soundcloud', 'youtube'];
    const LINK_PATTERN = /^https?:\/\/\S+\.\S+$/i;

    const LINK_RULES: Record<string, FieldRule> = Object.fromEntries(
        LINK_NAMES.map(name => [name, { message: LINK_MESSAGE, pattern: LINK_PATTERN }]),
    );

    const PASSWORD_RULES: Record<string, FieldRule> = {
        confirm: confirmRule(),
        password: passwordRule(),
    };

    const PROFILE_RULES: Record<string, FieldRule> = {
        city: { message: PROFILE_FIELDS.city.message, required: PROFILE_FIELDS.city.required },
    };

    const SIGNED_OUT_MESSAGE = 'Sign in to save changes.';
    const STORAGE_MESSAGE = 'Nothing was saved \u2014 your browser storage is full. Clear some space and try again.';
    const TRACK_MISSING_MESSAGE = 'Stage an audio file before you save.';

    let demoSummary = { email: '', name: '', prods: '', role: '', since: '', standing: '' };
    let reading = false;
    let stagedAvatar = '';
    let staging = false;
    let unsubscribe: (() => void) | undefined;

    function handleBioInput(field: HTMLTextAreaElement) {
        setText(document.querySelector('[data-bio-count]'), String(field.value.length));
    }

    async function handleLinksSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const errors = validateFields(form, LINK_RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MS);

        setPending(button, false);
        toast('Links saved.', 'success');
    }

    async function handlePasswordSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const errors = validateFields(form, PASSWORD_RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MS);

        setPending(button, false);

        if (!getSession()) {
            toast(SIGNED_OUT_MESSAGE, 'info');

            return;
        }

        form.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"][data-reveal]').forEach(button => handleReveal(button));
        form.reset();
        toast('Password updated.', 'success');
    }

    async function handlePortraitChange(form: HTMLFormElement, input: HTMLInputElement) {
        const file = input.files?.item(0);

        input.value = '';

        if (staging || !file) return;

        staging = true;

        try {
            const staged = await stageAvatar(file);

            clearFieldErrors(form);

            if (!staged.ok) {
                setFieldErrors(form, { portrait: staged.message });
                input.focus();

                return;
            }

            stagedAvatar = staged.dataUrl;
            renderPortrait(form);
            toast('Portrait staged.', 'success');
        } finally {
            staging = false;
        }
    }

    async function handleProfileSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (staging) return;

        const values = new FormData(form);
        const errors = validateFields(form, PROFILE_RULES);

        if (!isValidationBypassed() && values.getAll('genres').length > PROFILE_FIELDS.genres.max) errors.genres = PROFILE_FIELDS.genres.message;

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        const saved = await saveSession({
            artistName: String(values.get('artistName') ?? '').trim(),
            avatar: stagedAvatar,
            role: String(values.get('role') ?? ''),
        });

        setPending(button, false);

        if (!saved.session) {
            toast(SIGNED_OUT_MESSAGE, 'info');

            return;
        }

        if (!saved.persisted) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        if (stagedAvatar && getSession()?.avatar !== stagedAvatar) {
            toast('That portrait could not be stored. Try a smaller image.', 'error');

            return;
        }

        toast('Profile saved.', 'success');
    }

    async function handleTrackChange(form: HTMLFormElement, input: HTMLInputElement, signal: AbortSignal) {
        const file = input.files?.item(0);

        input.value = '';

        if (reading || !file) return;

        const error = validateTrack(file);

        clearFieldErrors(form);

        if (error) {
            setFieldErrors(form, { track: error });
            input.focus();

            return;
        }

        reading = true;
        setBusy(form, true);

        try {
            const result = await uploadSubmission(file, { signal });

            if (signal.aborted) return;

            if (!result.ok) {
                setFieldErrors(form, { track: result.message });
                input.focus();

                return;
            }

            stageTrack(form, file.name);
            toast('Track staged.', 'success');
        } finally {
            reading = false;
            setBusy(form, false);
        }
    }

    async function handleTrackSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();
        clearFieldErrors(form);

        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        if (!isValidationBypassed() && staged?.hasAttribute('hidden') !== false) {
            setFieldErrors(form, { track: TRACK_MISSING_MESSAGE });
            form.querySelector<HTMLInputElement>('[data-track-input]')?.focus();
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MS);

        setPending(button, false);
        toast('Track saved.', 'success');
    }

    function initSettings(signal: AbortSignal) {
        const links = document.querySelector<HTMLFormElement>('[data-links-form]');
        const password = document.querySelector<HTMLFormElement>('[data-password-form]');
        const profile = document.querySelector<HTMLFormElement>('[data-settings-form]');
        const track = document.querySelector<HTMLFormElement>('[data-track-form]');

        if (!links || !password || !profile || !track) return;

        const bio = profile.querySelector<HTMLTextAreaElement>('[name="bio"]');
        const file = track.querySelector<HTMLInputElement>('[data-track-input]');
        const picture = profile.querySelector<HTMLInputElement>('[data-portrait-input]');

        demoSummary = {
            email: readText('[data-settings-email]'),
            name: readText('[data-settings-name]'),
            prods: readText('[data-settings-prods]'),
            role: readText('[data-settings-role]'),
            since: readText('[data-settings-since]'),
            standing: readText('[data-settings-standing]'),
        };

        links.noValidate = true;
        password.noValidate = true;
        profile.noValidate = true;
        track.noValidate = true;
        unsubscribe?.();
        unsubscribe = onSessionChange(renderSession);
        bio?.addEventListener('input', () => handleBioInput(bio), { signal });
        file?.addEventListener('change', () => void handleTrackChange(track, file, signal), { signal });
        links.addEventListener('submit', event => void handleLinksSubmit(event, links), { signal });
        password.addEventListener('submit', event => void handlePasswordSubmit(event, password), { signal });

        password.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });

        picture?.addEventListener('change', () => void handlePortraitChange(profile, picture), { signal });
        profile.addEventListener('submit', event => void handleProfileSubmit(event, profile), { signal });
        profile.querySelector<HTMLButtonElement>('[data-portrait-remove]')?.addEventListener('click', () => removePortrait(profile), { signal });
        signal.addEventListener('abort', releaseAudioContext, { once: true });
        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });
        track.addEventListener('submit', event => void handleTrackSubmit(event, track), { signal });
        track.querySelector<HTMLButtonElement>('[data-track-remove]')?.addEventListener('click', () => removeTrack(track), { signal });
        reading = false;
        stagedAvatar = getSession()?.avatar ?? '';
        prefillProfile(profile);
        renderPortrait(profile);
        renderSession();
    }

    function prefillProfile(form: HTMLFormElement) {
        const name = form.querySelector<HTMLInputElement>('[name="artistName"]');
        const session = getSession();

        if (!session) return;

        if (name) name.value = session.artistName;

        setRole(form, session.role);
    }

    function readText(selector: string) {
        return document.querySelector<HTMLElement>(selector)?.textContent?.trim() ?? '';
    }

    function removePortrait(form: HTMLFormElement) {
        stagedAvatar = '';
        clearFieldErrors(form);
        renderPortrait(form);
        form.querySelector<HTMLInputElement>('[data-portrait-input]')?.focus();
        toast('Portrait removed.', 'info');
    }

    function removeTrack(form: HTMLFormElement) {
        const empty = form.querySelector<HTMLElement>('[data-track-empty]');
        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        clearFieldErrors(form);
        setText(form.querySelector('[data-track-name]'), '');
        empty?.removeAttribute('hidden');
        staged?.setAttribute('hidden', '');
        form.querySelector<HTMLInputElement>('[data-track-input]')?.focus();
        toast('Track removed.', 'info');
    }

    function renderPortrait(form: HTMLFormElement) {
        const staged = form.querySelector<HTMLElement>('[data-portrait-staged]');

        setAvatarImage(form.querySelector<HTMLImageElement>('[data-portrait-preview]'), stagedAvatar);
        staged?.toggleAttribute('hidden', stagedAvatar.length === 0);
    }

    function renderSession() {
        const link = document.querySelector<HTMLAnchorElement>('[data-settings-onboarding]');
        const session = getSession();
        const tile = document.querySelector<HTMLElement>('.settings__tile');

        const name = session ? session.artistName || session.email : demoSummary.name;
        const role = session ? session.role : demoSummary.role;

        if (tile) tile.style.background = pickTileColor(name);

        document.querySelectorAll<HTMLElement>('[data-settings-role]').forEach(element => setText(element, role));
        setAvatarImage(document.querySelector<HTMLImageElement>('[data-settings-avatar]'), session?.avatar ?? '');
        setText(document.querySelector('.settings__initials'), getInitials(name));
        setText(document.querySelector('[data-settings-email]'), session?.email ?? demoSummary.email);
        setText(document.querySelector('[data-settings-name]'), name);
        setText(document.querySelector('[data-settings-prods]'), session ? formatProds(session.prods) : demoSummary.prods);
        setText(document.querySelector('[data-settings-since]'), session?.createdAt ? formatDateStamp(new Date(session.createdAt)) : demoSummary.since);
        setText(document.querySelector('[data-settings-standing]'), session ? getStanding(session.prods) : demoSummary.standing);

        if (!link) return;

        link.toggleAttribute('hidden', !session || session.onboarded);

        if (!session) return;

        link.href = getOnboardingHref(session.email);
    }

    function setBusy(form: HTMLFormElement, busy: boolean) {
        const zone = form.querySelector<HTMLElement>('.settings__track');

        if (busy) zone?.setAttribute('aria-busy', 'true');
        else zone?.removeAttribute('aria-busy');
    }

    function stageTrack(form: HTMLFormElement, name: string) {
        const empty = form.querySelector<HTMLElement>('[data-track-empty]');
        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        setText(form.querySelector('[data-track-name]'), name);
        empty?.setAttribute('hidden', '');
        staged?.removeAttribute('hidden');
    }

    function validateTrack(file: File) {
        const extension = getExtension(file.name);

        if (!SPOTLIGHT.extensions.some(allowed => allowed === extension)) {
            return `That is a .${extension || 'file'} \u2014 the spotlight track takes ${SPOTLIGHT_EXTENSIONS_LABEL} only.`;
        }

        return getSizeError(file, SPOTLIGHT.maxFileBytes);
    }

    registerPageScript(initSettings);
</script>
