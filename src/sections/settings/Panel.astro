---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import {
    AVATAR,
    DEFAULT_ROLE,
    DEFAULT_STATE,
    GENRES,
    LINK_MAX_LENGTH,
    PASSWORD_MIN_LENGTH,
    PROFILE_FIELDS,
    PROFILE_ROLES,
    UPLOAD,
    US_STATES,
} from '@lib/shared/constants';
import { avatarExtensionsOrList } from '@lib/account/images';
import { formatBytes, formatProds, formatRole } from '@lib/shared/utils';
import { uploadExtensionsOrList } from '@lib/audio/uploads';

const LINK_FIELDS = [
    { label: 'Instagram', name: 'instagram', placeholder: 'https://instagram.com/\u2026' },
    { label: 'Spotify', name: 'spotify', placeholder: 'https://open.spotify.com/artist/\u2026' },
    { label: 'SoundCloud', name: 'soundcloud', placeholder: 'https://soundcloud.com/\u2026' },
    { label: 'YouTube', name: 'youtube', placeholder: 'https://youtube.com/@\u2026' },
];
---

<section
    class="settings-stage stage stage--tight"
    aria-labelledby="settings-title"
>
    <h1
        id="settings-title"
        class="sr-only"
    >
        Settings
    </h1>
    <div
        class="flex flex-col gap-(--space-2xl)"
        data-motion-stagger="rise"
    >
        <div class="flex flex-col gap-(--space-md)">
            <div class="settings__overview slab slab--bare slab--card grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-px max-lg:grid-cols-1">
                <section
                    class="bg-bg-raised max-lg:grid max-lg:grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))]"
                    aria-label="Your card"
                >
                    <PlaceholderTile
                        class="settings__tile aspect-square"
                        color="var(--color-ink)"
                        label="??"
                        labelClass="settings__initials leading-none text-6xl"
                        labelColor="var(--color-text-inverse-secondary)"
                    >
                        <img
                            class="absolute inset-0 object-cover h-full w-full"
                            alt=""
                            data-settings-avatar
                            hidden
                        />
                        <p
                            class="label absolute left-0 top-0 p-3 border-b-2 border-border-strong border-r-2 bg-bg-page text-text"
                            data-settings-role
                        >
                            {formatRole(DEFAULT_ROLE)}
                        </p>
                    </PlaceholderTile>
                    <div class="p-(--space-md)">
                        <p
                            class="mb-3 font-bold text-2xl tracking-tight wrap-break-word"
                            data-settings-name
                        />
                        <p
                            class="mb-6 font-mono text-base wrap-anywhere text-text-secondary"
                            data-settings-location
                        />
                        <ul
                            class="flex flex-wrap gap-2"
                            data-settings-genres
                        />
                        <template data-settings-chip>
                            <li class="label inline-flex items-center h-6 px-2 border-2 border-border-strong" />
                        </template>
                    </div>
                </section>
                <dl
                    class="settings__stats grid grid-cols-2 gap-px max-md:grid-cols-1"
                    aria-label="Account summary"
                >
                    <div class="flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Balance</dt>
                        <dd
                            class="font-bold text-xl"
                            data-settings-prods
                        >
                            {formatProds(0)}
                        </dd>
                    </div>
                    <div class="flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Attended</dt>
                        <dd
                            class="font-bold text-xl"
                            data-settings-attended
                        >
                            0
                        </dd>
                    </div>
                    <div class="col-span-full flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Member since</dt>
                        <dd class="font-bold text-xl">
                            <time data-settings-since />
                        </dd>
                    </div>
                    <div class="col-span-full flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Email</dt>
                        <dd
                            class="font-bold text-xl wrap-anywhere"
                            data-settings-email
                        />
                    </div>
                </dl>
            </div>
            <a
                class="action-text inline-flex items-center self-start min-h-(--control-size) gap-2 px-1 underline underline-offset-4"
                data-settings-onboarding
                hidden
                href="/onboarding"
            >
                Finish profile <IconArrow />
            </a>
        </div>
        <form
            class="settings__form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            data-settings-form
        >
            <h2 class="text-2xl">
                Profile
            </h2>
            <div class="flex flex-col gap-2">
                <p class="label text-text-secondary">{PROFILE_FIELDS.portrait.label}</p>
                <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 flex flex-wrap items-center gap-(--space-md)">
                    <label class="dropzone halftone basis-55 flex grow items-center relative min-h-(--control-size) px-4 py-2 border-2 border-border-strong border-dashed bg-bg-page">
                        <span class="label">{PROFILE_FIELDS.portrait.picker}</span>
                        <input
                            id="settings-portrait"
                            class="dropzone__input sr-only"
                            accept={AVATAR.acceptAttribute}
                            aria-describedby="settings-portrait-help"
                            aria-invalid="false"
                            data-portrait-input
                            name="portrait"
                            type="file"
                        />
                    </label>
                    <div
                        class="settings__staged slab slab--sunk basis-65 flex flex-wrap grow items-center justify-between gap-x-4 gap-y-1"
                        data-portrait-staged
                        hidden
                    >
                        <img
                            class="object-cover h-16 w-16 border-2 border-border-strong"
                            alt="Your staged portrait"
                            data-portrait-preview
                        />
                        <button
                            class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                            aria-label="Remove portrait"
                            data-portrait-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                </div>
                <p
                    id="settings-portrait-help"
                    class="text-base text-text-secondary"
                >
                    {avatarExtensionsOrList}. Up to {formatBytes(AVATAR.maxFileBytes)}, at least {AVATAR.minEdgePixels}px on each side.
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex flex-col gap-2">
                    <span class="label text-text-secondary">{PROFILE_FIELDS.artistName.label}</span>
                    <input
                        id="settings-name"
                        class="input"
                        aria-invalid="false"
                        autocomplete={PROFILE_FIELDS.artistName.autocomplete}
                        maxlength={PROFILE_FIELDS.artistName.maxLength}
                        name="artistName"
                        type="text"
                    />
                </label>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex flex-col gap-2">
                    <span class="label text-text-secondary">{PROFILE_FIELDS.bio.label}</span>
                    <textarea
                        id="settings-bio"
                        class="input resize-none"
                        aria-describedby="settings-bio-count"
                        aria-invalid="false"
                        maxlength={PROFILE_FIELDS.bio.maxLength}
                        name="bio"
                        rows="4"
                    />
                </label>
                <p
                    id="settings-bio-count"
                    class="font-mono tabular-nums text-sm text-text-secondary"
                    aria-live="polite"
                >
                    <span data-bio-count>0</span> / {PROFILE_FIELDS.bio.maxLength}<span class="sr-only">&#32;characters</span>
                </p>
            </div>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-text-secondary">
                    {PROFILE_FIELDS.genres.label}
                </legend>
                <div class="flex flex-wrap gap-2">
                    {GENRES.map(genre => (
                        <label class="chip gap-2">
                            <input
                                class="box"
                                name="genres"
                                type="checkbox"
                                value={genre}
                            />
                            {genre}
                        </label>
                    ))}
                </div>
            </fieldset>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-text-secondary">
                    {PROFILE_FIELDS.role.label} <span class="whitespace-nowrap text-text-secondary">({PROFILE_FIELDS.role.qualifier})</span>
                </legend>
                <div class="flex flex-wrap gap-2">
                    {PROFILE_ROLES.map(role => (
                        <label class="chip gap-2">
                            <input
                                class="box"
                                checked={role.id === DEFAULT_ROLE}
                                name="role"
                                type="radio"
                                value={role.id}
                            />
                            {role.label}
                        </label>
                    ))}
                </div>
            </fieldset>
            <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                <div class="flex flex-col gap-2">
                    <label class="flex flex-col gap-2">
                        <span class="label text-text-secondary">{PROFILE_FIELDS.city.label}</span>
                        <input
                            id="settings-city"
                            class="input"
                            aria-invalid="false"
                            autocomplete={PROFILE_FIELDS.city.autocomplete}
                            maxlength={PROFILE_FIELDS.city.maxLength}
                            name="city"
                            required={PROFILE_FIELDS.city.required}
                            type="text"
                        />
                    </label>
                </div>
                <div class="flex flex-col gap-2">
                    <label class="flex flex-col gap-2">
                        <span class="label text-text-secondary">{PROFILE_FIELDS.state.label}</span>
                        <span class="select">
                            <select
                                id="settings-state"
                                class="input"
                                aria-invalid="false"
                                autocomplete={PROFILE_FIELDS.state.autocomplete}
                                name="state"
                                required={PROFILE_FIELDS.state.required}
                            >
                                {US_STATES.map(state => (
                                    <option
                                        selected={state.code === DEFAULT_STATE}
                                        value={state.code}
                                    >
                                        {state.name}
                                    </option>
                                ))}
                            </select>
                        </span>
                    </label>
                </div>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save profile
            </button>
        </form>
        <form
            class="settings__form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            data-links-form
        >
            <hgroup class="flex flex-col gap-3">
                <h2 class="text-2xl">
                    Links
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Where else you live online. Every field is optional, and whatever you fill in shows
                    up on your roster card.
                </p>
            </hgroup>
            {LINK_FIELDS.map(field => (
                <div class="flex flex-col gap-2">
                    <label class="flex flex-col gap-2">
                        <span class="label text-text-secondary">{field.label}</span>
                        <input
                            id={`settings-${field.name}`}
                            class="input font-mono"
                            aria-invalid="false"
                            inputmode="url"
                            maxlength={LINK_MAX_LENGTH}
                            name={field.name}
                            placeholder={field.placeholder}
                            spellcheck="false"
                            type="url"
                        />
                    </label>
                </div>
            ))}
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save links
            </button>
        </form>
        <form
            class="settings__form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            data-track-form
        >
            <hgroup class="flex flex-col gap-3">
                <h2 class="text-2xl">
                    Spotlight
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    One file, and it is the one that plays on your roster card. Swap it whenever the
                    better take arrives.
                </p>
            </hgroup>
            <div class="flex flex-col gap-2">
                <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 grid gap-(--space-md)">
                    <label class="dropzone halftone basis-55 flex grow items-center relative min-h-(--control-size) px-4 py-2 border-2 border-border-strong border-dashed bg-bg-page">
                        <span class="label">Choose an audio file</span>
                        <input
                            id="settings-track"
                            class="dropzone__input sr-only"
                            accept={UPLOAD.acceptAttribute}
                            aria-describedby="settings-track-help"
                            aria-invalid="false"
                            data-track-input
                            name="track"
                            type="file"
                        />
                    </label>
                    <div
                        class="settings__staged slab slab--sunk basis-65 flex flex-wrap grow items-center justify-between gap-x-4 gap-y-1"
                        data-track-staged
                        hidden
                    >
                        <p
                            class="min-w-0 font-bold wrap-anywhere"
                            data-track-name
                        />
                        <button
                            class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                            aria-label="Remove track"
                            data-track-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                </div>
                <p
                    id="settings-track-help"
                    class="text-base text-text-secondary"
                >
                    A {uploadExtensionsOrList} file up to {formatBytes(UPLOAD.maxFileBytes)}.
                </p>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save track
            </button>
        </form>
        <form
            class="settings__form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            data-password-form
        >
            <h2 class="text-2xl">
                Password
            </h2>
            <div
                class="flex flex-col gap-2"
                data-password-current
            >
                <label class="flex flex-col gap-2">
                    <span class="label text-text-secondary">Current password</span>
                    <span class="block relative">
                        <input
                            id="settings-current"
                            class="input input--trailing"
                            aria-invalid="false"
                            autocomplete="current-password"
                            name="current"
                            required
                            type="password"
                        />
                        <button
                            class="reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-current"
                            type="button"
                        >
                            <span class="reveal__show flex items-center">
                                <IconEye />
                            </span>
                            <span class="reveal__hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex flex-col gap-2">
                    <span class="label text-text-secondary">New password</span>
                    <span class="block relative">
                        <input
                            id="settings-password"
                            class="input input--trailing"
                            aria-describedby="settings-password-help"
                            aria-invalid="false"
                            autocomplete="new-password"
                            minlength={PASSWORD_MIN_LENGTH}
                            name="password"
                            required
                            type="password"
                        />
                        <button
                            class="reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-password"
                            type="button"
                        >
                            <span class="reveal__show flex items-center">
                                <IconEye />
                            </span>
                            <span class="reveal__hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-password-help"
                    class="text-base text-text-secondary"
                >
                    At least {PASSWORD_MIN_LENGTH} characters with a letter and a digit.
                </p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex flex-col gap-2">
                    <span class="label text-text-secondary">Confirm new password</span>
                    <span class="block relative">
                        <input
                            id="settings-confirm"
                            class="input input--trailing"
                            aria-invalid="false"
                            autocomplete="new-password"
                            name="confirm"
                            required
                            type="password"
                        />
                        <button
                            class="reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-confirm"
                            type="button"
                        >
                            <span class="reveal__show flex items-center">
                                <IconEye />
                            </span>
                            <span class="reveal__hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Update password
            </button>
        </form>
        <section
            class="settings__panel slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            aria-labelledby="settings-attendance-title"
        >
            <hgroup class="flex flex-col gap-3">
                <h2
                    id="settings-attendance-title"
                    class="text-2xl"
                >
                    Attendance
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Every event you have checked in to since you joined, newest first.
                </p>
            </hgroup>
            <p
                class="slab slab--empty slab--sunk text-base text-text-secondary"
                data-settings-attendance-empty
                hidden
            >
                No check-ins on file. Events you check in to appear here.
            </p>
            <div class="scroll-slot settings__attendance overflow-x-auto border-2 border-border-strong">
                <table class="settings__table">
                    <caption class="sr-only">Events you checked in to, with the date of each check-in</caption>
                    <thead>
                        <tr class="label text-text-secondary">
                            <th
                                class="w-full px-4 py-3 text-left whitespace-nowrap max-md:px-2"
                                scope="col"
                            >
                                Event
                            </th>
                            <th
                                class="px-4 py-3 text-right whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Date
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-settings-attendance
                    />
                </table>
                <template data-settings-attendance-row>
                    <tr>
                        <th
                            class="px-4 py-4 font-bold text-left wrap-anywhere max-md:px-2"
                            scope="row"
                        >
                            <div class="grid gap-1">
                                <span data-cell="event" />
                                <time
                                    class="hidden font-mono font-normal text-base whitespace-nowrap text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </th>
                        <td class="px-4 py-4 font-mono text-base text-right whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                    </tr>
                </template>
            </div>
        </section>
        <section
            class="settings__panel slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
            aria-labelledby="settings-ledger-title"
        >
            <hgroup class="flex flex-col gap-3">
                <h2
                    id="settings-ledger-title"
                    class="text-2xl"
                >
                    Prods ledger
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Every Prod earned or spent since you joined, newest first, with the balance that
                    stood after each entry.
                </p>
            </hgroup>
            <div class="scroll-slot settings__ledger overflow-x-auto border-2 border-border-strong">
                <table class="settings__table">
                    <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                    <thead>
                        <tr class="label text-text-secondary">
                            <th
                                class="px-4 py-3 text-left whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Date
                            </th>
                            <th
                                class="w-full px-4 py-3 text-left whitespace-nowrap max-md:px-2"
                                scope="col"
                            >
                                Reason
                            </th>
                            <th
                                class="px-4 py-3 text-right whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Change
                            </th>
                            <th
                                class="px-4 py-3 text-right whitespace-nowrap max-md:px-2"
                                scope="col"
                            >
                                Balance
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-settings-ledger
                    />
                </table>
                <template data-settings-ledger-row>
                    <tr>
                        <td class="px-4 py-4 font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                        <td class="px-4 py-4 text-base wrap-anywhere max-md:px-2">
                            <div class="grid gap-1">
                                <span data-cell="reason" />
                                <time
                                    class="hidden font-mono text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </td>
                        <td
                            class="px-4 py-4 font-mono text-base text-right whitespace-nowrap max-md:hidden"
                            data-cell="change"
                        />
                        <td class="px-4 py-4 font-mono text-base text-right whitespace-nowrap max-md:px-2">
                            <div class="grid gap-1">
                                <span data-cell="balance" />
                                <span
                                    class="hidden max-md:block"
                                    data-cell="change"
                                />
                            </div>
                        </td>
                    </tr>
                </template>
            </div>
        </section>
    </div>
</section>

<style>
    .settings-stage {
        display: var(--session-in-only, grid);
    }

    .settings-stage:not(.is-ready) {
        opacity: 0;
    }

    .settings__attendance,
    .settings__ledger {
        --scroll-slot-max: calc(2 * 2px + 2 * 12px + var(--text-sm) + 5 * (2 * 16px + var(--text-base--line-height) + 1px));
    }

    .settings__overview {
        --slab-fill: var(--color-border-strong);
    }

    .settings__staged {
        padding: 8px 16px;
    }

    .settings__table thead th {
        background-color: var(--color-bg-raised);
        box-shadow: inset 0 -2px 0 var(--color-border-strong);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 768px) {
        .settings__attendance,
        .settings__ledger {
            --scroll-slot-max: calc(2 * 2px + 2 * 12px + var(--text-sm) + 5 * (2 * 16px + 2 * var(--text-base--line-height) + 4px + 1px));
        }
    }
</style>

<script>
    import { LINK_MAX_LENGTH, PORTRAIT_REMOVED_MESSAGE, PORTRAIT_STAGED_MESSAGE, PROFILE_FIELDS, UPLOAD } from '@lib/shared/constants';
    import { clearAuthLink, getAuthLink, getSession, onSessionChange, saveSession, saveTrack, updatePassword, whenSessionReady } from '@lib/account/session';
    import {
        clearFieldErrors,
        getConfirmRule,
        getPasswordRule,
        handleReveal,
        reportFieldErrors,
        serialize,
        setRole,
        validateFields,
        watchFieldErrors,
    } from '@lib/ui/forms';
    import {
        formatDateStamp,
        formatProds,
        formatRole,
        getInitials,
        pickTileColor,
        registerPageScript,
        setAvatarImage,
        setHidden,
        setPending,
        setText,
        toAustinIso,
    } from '@lib/shared/utils';
    import { getExtensionError, getSizeError, releaseAudioContext, uploadSubmission } from '@lib/audio/uploads';
    import { guardRoute } from '@lib/account/guard';
    import { loadAttendance, loadLedger } from '@lib/account/prods';
    import { observeRowWindow } from '@lib/account/ledger';
    import { stageAvatar } from '@lib/account/images';
    import { toast } from '@lib/ui/toasts';

    const CURRENT_PASSWORD_MESSAGE = 'Enter your current password.';

    const ERROR_FIELDS: Partial<Record<SessionErrorCode, string>> = {
        'invalid-credentials': 'current',
        'same-password': 'password',
        'upload-failed': 'portrait',
        'weak-password': 'password',
    };

    const HISTORY_MESSAGE = 'Your history could not be loaded. Check your connection and try again.';
    const LINK_LABELS: Record<string, string> = { instagram: 'Instagram', soundcloud: 'SoundCloud', spotify: 'Spotify', youtube: 'YouTube' };
    const LINK_PATTERN = /^https?:\/\/\S+\.\S+$/i;

    const PROFILE_RULES: Record<string, FieldRule> = {
        artistName: { max: PROFILE_FIELDS.artistName.maxLength, message: PROFILE_FIELDS.artistName.message },
        city: { max: PROFILE_FIELDS.city.maxLength, message: PROFILE_FIELDS.city.message, required: PROFILE_FIELDS.city.required },
    };

    const RECOVERY_MESSAGE = 'Choose a new password.';
    const TRACK_MISSING_MESSAGE = 'Stage an audio file before you save.';

    const LINK_RULES: Record<string, FieldRule> = Object.fromEntries(
        Object.entries(LINK_LABELS).map(([name, label]) => [
            name,
            { max: LINK_MAX_LENGTH, message: `Enter a full https:// address for ${label}.`, pattern: LINK_PATTERN },
        ]),
    );

    const PASSWORD_RULES: Record<string, FieldRule> = {
        confirm: getConfirmRule(),
        current: { message: CURRENT_PASSWORD_MESSAGE, required: true },
        password: getPasswordRule(),
    };

    const PASSWORDLESS_RULES: Record<string, FieldRule> = {
        confirm: PASSWORD_RULES.confirm,
        password: PASSWORD_RULES.password,
    };

    const savingForms = new Set<HTMLFormElement>();

    let appliedAvatar = '';
    let historyLoads = 0;
    let isReading = false;
    let isStaging = false;
    let linksSnapshot = '';
    let profileSnapshot = '';
    let renderedProds: number | undefined;
    let stagedAvatar = '';
    let stagedTrack: File | null = null;

    function applyForms(session: Session) {
        const links = document.querySelector<HTMLFormElement>('[data-links-form]');
        const profile = document.querySelector<HTMLFormElement>('[data-settings-form]');

        if (links && serialize(links) === linksSnapshot) fillLinks(links, session);
        if (profile && serialize(profile, stagedAvatar) === profileSnapshot) fillProfile(profile, session);
    }

    function fillLinks(form: HTMLFormElement, session: Session) {
        setValue(form, 'instagram', session.links.instagram);
        setValue(form, 'soundcloud', session.links.soundcloud);
        setValue(form, 'spotify', session.links.spotify);
        setValue(form, 'youtube', session.links.youtube);
        linksSnapshot = serialize(form);
    }

    function fillProfile(form: HTMLFormElement, session: Session) {
        appliedAvatar = session.avatar;
        stagedAvatar = session.avatar;

        form.querySelectorAll<HTMLInputElement>('[name="genres"]').forEach((input) => {
            input.checked = session.genres.includes(input.value);
        });

        renderPortrait(form);
        setRole(form, session.role);
        setText(form.querySelector('[data-bio-count]'), String(session.bio.length));
        setValue(form, 'artistName', session.artistName);
        setValue(form, 'bio', session.bio);
        setValue(form, 'city', session.city);
        setValue(form, 'state', session.state);
        profileSnapshot = serialize(form, stagedAvatar);
    }

    async function handleLinksSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (savingForms.has(form)) return;

        const errors = validateFields(form, LINK_RULES);
        const values = new FormData(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const submitted = serialize(form);

        savingForms.add(form);
        setPending(button, true);

        const result = await saveSession({
            links: {
                instagram: String(values.get('instagram') ?? '').trim(),
                soundcloud: String(values.get('soundcloud') ?? '').trim(),
                spotify: String(values.get('spotify') ?? '').trim(),
                youtube: String(values.get('youtube') ?? '').trim(),
            },
        });

        savingForms.delete(form);
        setPending(button, false);

        if (!result.ok) {
            reportFailure(form, result.code, result.message);

            return;
        }

        if (result.session && serialize(form) === submitted) fillLinks(form, result.session);

        toast('Links saved.', 'success');
    }

    async function handlePasswordSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (savingForms.has(form)) return;

        const rules = getSession()?.passwordless ? PASSWORDLESS_RULES : PASSWORD_RULES;
        const values = new FormData(form);

        const errors = validateFields(form, rules);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        savingForms.add(form);
        setPending(button, true);

        const result = await updatePassword(String(values.get('password') ?? ''), String(values.get('current') ?? ''));

        savingForms.delete(form);
        setPending(button, false);

        if (!result.ok) {
            reportFailure(form, result.code, result.code === 'invalid-credentials' ? CURRENT_PASSWORD_MESSAGE : result.message);

            return;
        }

        form.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"][data-reveal]').forEach(reveal => handleReveal(reveal));
        form.reset();
        toast('Password updated.', 'success');
    }

    async function handlePortraitChange(form: HTMLFormElement, input: HTMLInputElement) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || isStaging) return;

        isStaging = true;

        try {
            const staged = await stageAvatar(file);

            clearFieldErrors(form);

            if (!staged.ok) {
                reportFieldErrors(form, { portrait: staged.message });

                return;
            }

            stagedAvatar = staged.dataUrl;
            renderPortrait(form);
            toast(PORTRAIT_STAGED_MESSAGE, 'success');
        } finally {
            isStaging = false;
        }
    }

    async function handleProfileSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (isStaging || savingForms.has(form)) return;

        const errors = validateFields(form, PROFILE_RULES);
        const values = new FormData(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const submitted = serialize(form, stagedAvatar);

        savingForms.add(form);
        setPending(button, true);

        const result = await saveSession({
            ...(stagedAvatar === appliedAvatar ? {} : { avatar: stagedAvatar }),
            artistName: String(values.get('artistName') ?? '').trim(),
            bio: String(values.get('bio') ?? '').trim(),
            city: String(values.get('city') ?? '').trim(),
            genres: values.getAll('genres').map(String),
            role: String(values.get('role') ?? ''),
            state: String(values.get('state') ?? ''),
        });

        savingForms.delete(form);
        setPending(button, false);

        if (!result.ok) {
            reportFailure(form, result.code, result.message);

            return;
        }

        if (result.session && serialize(form, stagedAvatar) === submitted) fillProfile(form, result.session);

        toast('Profile saved.', 'success');
    }

    async function handleSessionReady(password: HTMLFormElement, signal: AbortSignal) {
        const session = await whenSessionReady();

        if (signal.aborted || !session) return;

        const link = getAuthLink();

        clearAuthLink();
        void loadHistory(session, signal);

        if (link !== 'recovery') return;

        password.scrollIntoView({ block: 'center' });
        password.querySelector<HTMLInputElement>('[name="password"]')?.focus();
        toast(RECOVERY_MESSAGE, 'info');
    }

    async function handleTrackChange(form: HTMLFormElement, input: HTMLInputElement, signal: AbortSignal) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || isReading || savingForms.has(form)) return;

        const error = getExtensionError(file.name) ?? getSizeError(file, UPLOAD.maxFileBytes);

        clearFieldErrors(form);

        if (error) {
            reportFieldErrors(form, { track: error });

            return;
        }

        isReading = true;
        setBusy(form, true);

        try {
            const result = await uploadSubmission(file, { signal });

            if (signal.aborted) return;

            if (!result.ok) {
                reportFieldErrors(form, { track: result.message });

                return;
            }

            stagedTrack = file;
            renderTrack();
            toast('Track staged.', 'success');
        } finally {
            isReading = false;
            setBusy(form, false);
        }
    }

    async function handleTrackRemove(form: HTMLFormElement, button: HTMLButtonElement) {
        if (isReading || savingForms.has(form)) return;

        clearFieldErrors(form);

        if (!stagedTrack) {
            savingForms.add(form);
            setPending(button, true);

            const result = await saveTrack(null);

            savingForms.delete(form);
            setPending(button, false);

            if (!result.ok) {
                reportFailure(form, result.code, result.message);

                return;
            }
        }

        stagedTrack = null;
        renderTrack();
        form.querySelector<HTMLInputElement>('[data-track-input]')?.focus();
        toast('Track removed.', 'info');
    }

    async function handleTrackSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (isReading || savingForms.has(form)) return;

        clearFieldErrors(form);

        if (!stagedTrack) {
            reportFieldErrors(form, { track: TRACK_MISSING_MESSAGE });

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        savingForms.add(form);
        setBusy(form, true);
        setPending(button, true);

        const result = await saveTrack(stagedTrack);

        savingForms.delete(form);
        setBusy(form, false);
        setPending(button, false);

        if (!result.ok) {
            reportFailure(form, result.code, result.message);

            return;
        }

        stagedTrack = null;
        renderTrack();
        toast('Track saved.', 'success');
    }

    function initSettings(signal: AbortSignal) {
        const links = document.querySelector<HTMLFormElement>('[data-links-form]');
        const password = document.querySelector<HTMLFormElement>('[data-password-form]');
        const profile = document.querySelector<HTMLFormElement>('[data-settings-form]');
        const track = document.querySelector<HTMLFormElement>('[data-track-form]');

        if (!links || !password || !profile || !track) return;

        const bio = profile.querySelector<HTMLTextAreaElement>('[name="bio"]');
        const file = track.querySelector<HTMLInputElement>('[data-track-input]');
        const picture = profile.querySelector<HTMLInputElement>('[data-portrait-input]');
        const remove = track.querySelector<HTMLButtonElement>('[data-track-remove]');

        appliedAvatar = '';
        isReading = false;
        linksSnapshot = serialize(links);
        renderedProds = undefined;
        stagedAvatar = '';
        stagedTrack = null;
        profileSnapshot = serialize(profile, stagedAvatar);
        links.noValidate = true;
        password.noValidate = true;
        profile.noValidate = true;
        track.noValidate = true;
        renderSession(signal);
        savingForms.clear();

        const unsubscribe = onSessionChange(() => renderSession(signal));

        bio?.addEventListener('input', () => setText(profile.querySelector('[data-bio-count]'), String(bio.value.length)), { signal });
        file?.addEventListener('change', () => void handleTrackChange(track, file, signal), { signal });
        links.addEventListener('submit', event => void handleLinksSubmit(event, links), { signal });
        password.addEventListener('submit', event => void handlePasswordSubmit(event, password), { signal });

        password.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });

        picture?.addEventListener('change', () => void handlePortraitChange(profile, picture), { signal });
        profile.addEventListener('submit', event => void handleProfileSubmit(event, profile), { signal });
        profile.querySelector<HTMLButtonElement>('[data-portrait-remove]')?.addEventListener('click', () => removePortrait(profile), { signal });
        remove?.addEventListener('click', () => void handleTrackRemove(track, remove), { signal });
        signal.addEventListener('abort', releaseAudioContext, { once: true });
        signal.addEventListener('abort', unsubscribe, { once: true });
        track.addEventListener('submit', event => void handleTrackSubmit(event, track), { signal });
        watchFieldErrors(links, signal);
        watchFieldErrors(password, signal);
        watchFieldErrors(profile, signal);
        watchFieldErrors(track, signal);

        document.querySelectorAll<HTMLElement>('.settings__attendance, .settings__ledger').forEach((scroller) => {
            observeRowWindow(scroller, signal);
        });

        void guardRoute('member', signal);
        void handleSessionReady(password, signal);
    }

    async function loadHistory(session: Session, signal: AbortSignal) {
        historyLoads++;
        renderedProds = session.prods;

        const load = historyLoads;

        const [attendance, ledger] = await Promise.all([loadAttendance(session.id), loadLedger(session.id)]);

        if (signal.aborted || load !== historyLoads) return;

        if (!attendance || !ledger) {
            toast(HISTORY_MESSAGE, 'error');

            return;
        }

        renderAttendance(attendance);
        renderLedger(ledger);
    }

    function removePortrait(form: HTMLFormElement) {
        stagedAvatar = '';
        clearFieldErrors(form);
        renderPortrait(form);
        form.querySelector<HTMLInputElement>('[data-portrait-input]')?.focus();
        toast(PORTRAIT_REMOVED_MESSAGE, 'info');
    }

    function renderAttendance(entries: ProdsAttendance[]) {
        const body = document.querySelector<HTMLElement>('[data-settings-attendance]');
        const empty = document.querySelector<HTMLElement>('[data-settings-attendance-empty]');
        const scroller = document.querySelector<HTMLElement>('.settings__attendance');
        const template = document.querySelector<HTMLTemplateElement>('[data-settings-attendance-row]');

        if (!body || !empty || !scroller || !template) return;

        body.replaceChildren();

        entries.forEach((entry) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', entry.date);
                setText(date, formatDateStamp(new Date(entry.date)));
            });

            setText(fragment.querySelector<HTMLElement>('[data-cell="event"]'), entry.event);
            body.append(fragment);
        });

        setText(document.querySelector('[data-settings-attended]'), String(entries.length));
        empty.toggleAttribute('hidden', entries.length > 0);
        scroller.toggleAttribute('hidden', entries.length === 0);
    }

    function renderGenres(genres: string[]) {
        const list = document.querySelector<HTMLElement>('[data-settings-genres]');
        const template = document.querySelector<HTMLTemplateElement>('[data-settings-chip]');

        if (!list || !template) return;

        list.replaceChildren();

        genres.forEach((genre) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            setText(fragment.querySelector('li'), genre);
            list.append(fragment);
        });
    }

    function renderLedger(rows: ProdsRow[]) {
        const body = document.querySelector<HTMLElement>('[data-settings-ledger]');
        const template = document.querySelector<HTMLTemplateElement>('[data-settings-ledger-row]');

        if (!body || !template) return;

        body.replaceChildren();

        rows.forEach((row) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fragment.querySelectorAll<HTMLElement>('[data-cell="change"]').forEach((change) => {
                change.classList.toggle('text-error-text', row.amount < 0);
                setText(change, row.amount > 0 ? `+${row.amount}` : `\u2212${Math.abs(row.amount)}`);
            });

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', row.date);
                setText(date, formatDateStamp(new Date(row.date)));
            });

            setText(fragment.querySelector<HTMLElement>('[data-cell="balance"]'), String(row.total));
            setText(fragment.querySelector<HTMLElement>('[data-cell="reason"]'), row.reason);
            body.append(fragment);
        });
    }

    function renderPortrait(form: HTMLFormElement) {
        const staged = form.querySelector<HTMLElement>('[data-portrait-staged]');

        setAvatarImage(form.querySelector<HTMLImageElement>('[data-portrait-preview]'), stagedAvatar);
        staged?.toggleAttribute('hidden', stagedAvatar.length === 0);
    }

    function renderSession(signal: AbortSignal) {
        const session = getSession();
        const tile = document.querySelector<HTMLElement>('.settings__tile');

        if (!session) return;

        const name = session.artistName || session.email;

        const tileColor = pickTileColor(name);

        if (tile) {
            tile.style.background = tileColor.background;
            tile.style.color = tileColor.text;
        }

        applyForms(session);
        document.querySelector('.settings-stage')?.classList.add('is-ready');
        renderGenres(session.genres);
        renderTrack();
        setAvatarImage(document.querySelector<HTMLImageElement>('[data-settings-avatar]'), session.avatar);
        setHidden(document.querySelector<HTMLElement>('[data-password-current]'), session.passwordless);
        setHidden(document.querySelector<HTMLElement>('[data-settings-onboarding]'), session.onboarded);
        setText(document.querySelector('.settings__initials'), getInitials(name));
        setText(document.querySelector('[data-settings-email]'), session.email);
        setText(document.querySelector('[data-settings-location]'), session.city ? [session.city, session.state].filter(Boolean).join(', ') : '');
        setText(document.querySelector('[data-settings-name]'), name);
        setText(document.querySelector('[data-settings-prods]'), formatProds(session.prods));
        setText(document.querySelector('[data-settings-role]'), formatRole(session.role));
        setText(document.querySelector('[data-settings-since]'), session.createdAt ? formatDateStamp(new Date(session.createdAt)) : '');

        if (session.createdAt) document.querySelector('[data-settings-since]')?.setAttribute('datetime', toAustinIso(new Date(session.createdAt)));
        else document.querySelector('[data-settings-since]')?.removeAttribute('datetime');

        if (renderedProds !== session.prods && renderedProds !== undefined) void loadHistory(session, signal);
    }

    function renderTrack() {
        const name = stagedTrack?.name ?? getSession()?.track ?? '';

        setHidden(document.querySelector<HTMLElement>('[data-track-staged]'), name.length === 0);
        setText(document.querySelector('[data-track-name]'), name);
    }

    function reportFailure(form: HTMLFormElement, code: SessionErrorCode, message: string) {
        const field = ERROR_FIELDS[code];

        if (field) reportFieldErrors(form, { [field]: message });
        else toast(message, code === 'signed-out' ? 'info' : 'error');
    }

    function setBusy(form: HTMLFormElement, isBusy: boolean) {
        const zone = form.querySelector<HTMLElement>('.settings__track');

        if (isBusy) zone?.setAttribute('aria-busy', 'true');
        else zone?.removeAttribute('aria-busy');
    }

    function setValue(form: HTMLFormElement, name: string, value: string) {
        const control = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);

        if (!control) return;
        if (control instanceof HTMLSelectElement && !Array.from(control.options).some(option => option.value === value)) return;

        control.value = value;
    }

    registerPageScript(initSettings);
</script>
