---
import IconArrow from '@components/icons/Arrow.astro';
import IconEye from '@components/icons/Eye.astro';
import IconEyeOff from '@components/icons/EyeOff.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { AVATAR, GENRES, PASSWORD_MIN_LENGTH, PROFILE_FIELDS, PROFILE_ROLES, UPLOAD, US_STATES } from '@lib/shared/constants';
import { AVATAR_EXTENSIONS_OR_LIST } from '@lib/account/images';
import { UPLOAD_EXTENSIONS_OR_LIST } from '@lib/audio/uploads';
import { formatBytes, formatDateStamp, formatProds, formatRole, getInitials, pickTileColor } from '@lib/shared/utils';
import { getProdsAttendance, getProdsBalance } from '@lib/account/prods';

const DEMO_PROFILE = {
    artistName: 'Nightshift',
    bio: 'I write patient, low-slung house in a converted garage on the east side and mix it loud enough to rattle the door.',
    city: 'Austin',
    email: 'nightshift@austinproduceralliance.com',
    genres: ['house', 'techno'],
    joined: new Date('2024-03-12T18:00:00Z'),
    links: {
        instagram: 'https://instagram.com/nightshift.wav',
        soundcloud: 'https://soundcloud.com/nightshift',
        spotify: 'https://open.spotify.com/artist/4kZ1nightshift',
        youtube: 'https://youtube.com/@nightshift',
    },
    role: 'producer',
    state: 'TX',
    track: { name: 'Untitled Sketch 09.mp3' },
};

const DEMO_TILE = pickTileColor(DEMO_PROFILE.artistName);

const LINK_FIELDS = [
    { label: 'Instagram', name: 'instagram', placeholder: 'https://instagram.com/\u2026', value: DEMO_PROFILE.links.instagram },
    { label: 'Spotify', name: 'spotify', placeholder: 'https://open.spotify.com/artist/\u2026', value: DEMO_PROFILE.links.spotify },
    { label: 'SoundCloud', name: 'soundcloud', placeholder: 'https://soundcloud.com/\u2026', value: DEMO_PROFILE.links.soundcloud },
    { label: 'YouTube', name: 'youtube', placeholder: 'https://youtube.com/@\u2026', value: DEMO_PROFILE.links.youtube },
];
---

<section
    class="stage stage--tight"
    aria-labelledby="settings-title"
>
    <h1
        id="settings-title"
        class="sr-only"
    >
        Settings
    </h1>
    <div
        class="flex flex-col gap-(--space-2xl)"
        data-motion-stagger="rise"
    >
        <div class="flex flex-col gap-(--space-md)">
            <div class="settings__overview slab slab--bare slab--card grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-px max-lg:grid-cols-2 max-md:grid-cols-1">
                <section
                    class="bg-bg-raised"
                    aria-label="Your card"
                >
                    <PlaceholderTile
                        class="settings__tile aspect-square"
                        color={DEMO_TILE.background}
                        label={getInitials(DEMO_PROFILE.artistName)}
                        labelClass="settings__initials leading-none text-6xl"
                        labelColor={DEMO_TILE.text}
                    >
                        <img
                            class="absolute inset-0 object-cover h-full w-full"
                            alt=""
                            data-settings-avatar
                            hidden
                        />
                        <p
                            class="label absolute left-0 top-0 p-(--space-xs) border-b-2 border-border-strong border-r-2 bg-bg-page text-text"
                            data-settings-role
                        >
                            {formatRole(DEMO_PROFILE.role)}
                        </p>
                    </PlaceholderTile>
                    <div class="p-(--space-md)">
                        <p
                            class="mb-3 font-bold font-sans text-2xl tracking-tight wrap-break-word"
                            data-settings-name
                        >
                            {DEMO_PROFILE.artistName}
                        </p>
                        <p class="mb-6 font-mono text-base wrap-anywhere text-text-secondary">
                            {DEMO_PROFILE.city}, {DEMO_PROFILE.state}
                        </p>
                        <ul class="flex flex-wrap gap-2 list-none">
                            {DEMO_PROFILE.genres.map(genre => (
                                <li class="label inline-flex items-center h-6 px-2 border-2 border-border-strong">{genre}</li>
                            ))}
                        </ul>
                    </div>
                </section>
                <dl
                    class="settings__stats grid grid-cols-2 gap-px max-lg:grid-cols-1"
                    aria-label="Account summary"
                >
                    <div class="flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Balance</dt>
                        <dd
                            class="font-bold font-sans text-xl"
                            data-settings-prods
                        >
                            {formatProds(getProdsBalance(DEMO_PROFILE.email))}
                        </dd>
                    </div>
                    <div class="flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Attended</dt>
                        <dd
                            class="font-bold font-sans text-xl"
                            data-settings-attended
                        >
                            {getProdsAttendance(DEMO_PROFILE.email).length}
                        </dd>
                    </div>
                    <div class="col-span-full flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Member since</dt>
                        <dd
                            class="font-bold font-sans text-xl"
                            data-settings-since
                        >
                            {formatDateStamp(DEMO_PROFILE.joined)}
                        </dd>
                    </div>
                    <div class="col-span-full flex flex-col justify-center p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Email</dt>
                        <dd
                            class="font-bold font-sans text-xl wrap-anywhere"
                            data-settings-email
                        >
                            {DEMO_PROFILE.email}
                        </dd>
                    </div>
                </dl>
            </div>
            <a
                class="action-text hover:text-link inline-flex items-center self-start min-h-(--control-size) gap-2 px-(--space-3xs) underline transition-[color,transform]"
                data-settings-onboarding
                hidden
                href="/onboarding"
            >
                Finish profile <IconArrow />
            </a>
        </div>
        <form
            class="settings__form slab slab--card"
            data-settings-form
        >
            <h2 class="text-2xl">
                Profile
            </h2>
            <div class="flex flex-col gap-(--space-2xs)">
                <p class="label text-text-secondary">{PROFILE_FIELDS.portrait.label}</p>
                <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 flex flex-wrap items-center gap-(--space-md)">
                    <label class="halftone settings__pick">
                        <span class="label">{PROFILE_FIELDS.portrait.picker}</span>
                        <input
                            id="settings-portrait"
                            class="settings__file sr-only"
                            accept={AVATAR.acceptAttribute}
                            aria-describedby="settings-portrait-error settings-portrait-help"
                            aria-invalid="false"
                            data-portrait-input
                            name="portrait"
                            type="file"
                        />
                    </label>
                    <div
                        class="settings__staged slab slab--sunk"
                        data-portrait-staged
                        hidden
                    >
                        <img
                            class="object-cover h-16 w-16 border-2 border-border-strong"
                            alt="Your staged portrait"
                            data-portrait-preview
                        />
                        <button
                            class="action-text hover:text-link flex items-center min-h-(--control-size) px-1 text-text-secondary transition-[color,transform]"
                            aria-label="Remove portrait"
                            data-portrait-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                </div>
                <p
                    id="settings-portrait-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-portrait-help"
                    class="text-base text-text-secondary"
                >
                    {AVATAR_EXTENSIONS_OR_LIST}. Up to {formatBytes(AVATAR.maxFileBytes)}, at least {AVATAR.minEdgePixels}px on each side.
                </p>
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">{PROFILE_FIELDS.artistName.label}</span>
                    <input
                        id="settings-name"
                        class="input font-sans"
                        aria-describedby="settings-name-error"
                        aria-invalid="false"
                        autocomplete={PROFILE_FIELDS.artistName.autocomplete}
                        maxlength={PROFILE_FIELDS.artistName.maxLength}
                        name="artistName"
                        type="text"
                        value={DEMO_PROFILE.artistName}
                    />
                </label>
                <p
                    id="settings-name-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">{PROFILE_FIELDS.bio.label}</span>
                    <textarea
                        id="settings-bio"
                        class="input input--area font-sans"
                        aria-describedby="settings-bio-error settings-bio-count"
                        aria-invalid="false"
                        maxlength={PROFILE_FIELDS.bio.maxLength}
                        name="bio"
                        rows="4"
                        set:text={DEMO_PROFILE.bio}
                    />
                </label>
                <p
                    id="settings-bio-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-bio-count"
                    class="font-mono tabular-nums text-sm text-text-secondary"
                    aria-live="polite"
                >
                    <span data-bio-count>{DEMO_PROFILE.bio.length}</span> / {PROFILE_FIELDS.bio.maxLength}<span class="sr-only">&#32;characters</span>
                </p>
            </div>
            <fieldset class="flex flex-col gap-(--space-2xs)">
                <legend class="label mb-(--space-2xs) text-text-secondary">
                    {PROFILE_FIELDS.genres.label}
                </legend>
                <div class="flex flex-wrap gap-2">
                    {GENRES.map(genre => (
                        <label class="settings__chip">
                            <input
                                class="box"
                                checked={DEMO_PROFILE.genres.includes(genre)}
                                name="genres"
                                type="checkbox"
                                value={genre}
                            />
                            {genre}
                        </label>
                    ))}
                </div>
            </fieldset>
            <fieldset class="flex flex-col gap-(--space-2xs)">
                <legend class="label mb-(--space-2xs) text-text-secondary">
                    {PROFILE_FIELDS.role.label} <span class="text-text-secondary">({PROFILE_FIELDS.role.qualifier})</span>
                </legend>
                <div class="flex flex-wrap gap-2">
                    {PROFILE_ROLES.map(role => (
                        <label class="settings__chip">
                            <input
                                class="box"
                                checked={role.id === DEMO_PROFILE.role}
                                name="role"
                                type="radio"
                                value={role.id}
                            />
                            {role.label}
                        </label>
                    ))}
                </div>
            </fieldset>
            <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">{PROFILE_FIELDS.city.label}</span>
                        <input
                            id="settings-city"
                            class="input font-sans"
                            aria-describedby="settings-city-error"
                            aria-invalid="false"
                            autocomplete={PROFILE_FIELDS.city.autocomplete}
                            name="city"
                            required={PROFILE_FIELDS.city.required}
                            type="text"
                            value={DEMO_PROFILE.city}
                        />
                    </label>
                    <p
                        id="settings-city-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">{PROFILE_FIELDS.state.label}</span>
                        <span class="select">
                            <select
                                id="settings-state"
                                class="input font-sans"
                                aria-describedby="settings-state-error"
                                aria-invalid="false"
                                autocomplete={PROFILE_FIELDS.state.autocomplete}
                                name="state"
                                required={PROFILE_FIELDS.state.required}
                            >
                                {US_STATES.map(state => (
                                    <option
                                        selected={state.code === DEMO_PROFILE.state}
                                        value={state.code}
                                    >
                                        {state.name}
                                    </option>
                                ))}
                            </select>
                        </span>
                    </label>
                    <p
                        id="settings-state-error"
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save profile
            </button>
        </form>
        <form
            class="settings__form slab slab--card"
            data-links-form
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2 class="text-2xl">
                    Links
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Where else you live online. Every field is optional, and whatever you fill in shows
                    up on your roster card.
                </p>
            </hgroup>
            {LINK_FIELDS.map(field => (
                <div class="flex flex-col gap-(--space-2xs)">
                    <label class="flex flex-col gap-(--space-2xs)">
                        <span class="label text-text-secondary">{field.label}</span>
                        <input
                            id={`settings-${field.name}`}
                            class="input font-mono"
                            aria-describedby={`settings-${field.name}-error`}
                            aria-invalid="false"
                            inputmode="url"
                            name={field.name}
                            placeholder={field.placeholder}
                            spellcheck="false"
                            type="url"
                            value={field.value}
                        />
                    </label>
                    <p
                        id={`settings-${field.name}-error`}
                        class="text-error-text"
                        data-field-error
                        hidden
                    />
                </div>
            ))}
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save links
            </button>
        </form>
        <form
            class="settings__form slab slab--card"
            data-track-form
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2 class="text-2xl">
                    Spotlight
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    One file, and it is the one that plays on your roster card. Swap it whenever the
                    better take arrives.
                </p>
            </hgroup>
            <div class="flex flex-col gap-(--space-2xs)">
                <div class="settings__track aria-busy:cursor-progress aria-busy:opacity-60 grid gap-(--space-md)">
                    <label class="halftone settings__pick">
                        <span class="label">Choose an audio file</span>
                        <input
                            id="settings-track"
                            class="settings__file sr-only"
                            accept={UPLOAD.acceptAttribute}
                            aria-describedby="settings-track-error settings-track-help"
                            aria-invalid="false"
                            data-track-input
                            name="track"
                            type="file"
                        />
                    </label>
                    <div
                        class="settings__staged slab slab--sunk"
                        data-track-staged
                    >
                        <p
                            class="min-w-0 font-bold font-sans wrap-anywhere"
                            data-track-name
                        >
                            {DEMO_PROFILE.track.name}
                        </p>
                        <button
                            class="action-text hover:text-link flex items-center min-h-(--control-size) px-1 text-text-secondary transition-[color,transform]"
                            aria-label="Remove track"
                            data-track-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </div>
                </div>
                <p
                    id="settings-track-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
                <p
                    id="settings-track-help"
                    class="text-base text-text-secondary"
                >
                    {UPLOAD_EXTENSIONS_OR_LIST} only. Up to {formatBytes(UPLOAD.maxFileBytes)}.
                </p>
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Save track
            </button>
        </form>
        <form
            class="settings__form slab slab--card"
            data-password-form
        >
            <h2 class="text-2xl">
                Password
            </h2>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">Current password</span>
                    <span class="block relative">
                        <input
                            id="settings-current"
                            class="input pr-12 font-sans"
                            aria-describedby="settings-current-error"
                            aria-invalid="false"
                            autocomplete="current-password"
                            minlength={PASSWORD_MIN_LENGTH}
                            name="current"
                            required
                            type="password"
                        />
                        <button
                            class="settings__reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-current"
                            type="button"
                        >
                            <span class="settings__glyph--show flex items-center">
                                <IconEye />
                            </span>
                            <span class="settings__glyph--hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-current-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">New password</span>
                    <span class="block relative">
                        <input
                            id="settings-password"
                            class="input pr-12 font-sans"
                            aria-describedby="settings-password-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            minlength={PASSWORD_MIN_LENGTH}
                            name="password"
                            required
                            type="password"
                        />
                        <button
                            class="settings__reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-password"
                            type="button"
                        >
                            <span class="settings__glyph--show flex items-center">
                                <IconEye />
                            </span>
                            <span class="settings__glyph--hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-password-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
                <p class="text-base text-text-secondary">
                    At least {PASSWORD_MIN_LENGTH} characters with a letter and a digit.
                </p>
            </div>
            <div class="flex flex-col gap-(--space-2xs)">
                <label class="flex flex-col gap-(--space-2xs)">
                    <span class="label text-text-secondary">Confirm new password</span>
                    <span class="block relative">
                        <input
                            id="settings-confirm"
                            class="input pr-12 font-sans"
                            aria-describedby="settings-confirm-error"
                            aria-invalid="false"
                            autocomplete="new-password"
                            name="confirm"
                            required
                            type="password"
                        />
                        <button
                            class="settings__reveal"
                            aria-label="Show password"
                            aria-pressed="false"
                            data-reveal="settings-confirm"
                            type="button"
                        >
                            <span class="settings__glyph--show flex items-center">
                                <IconEye />
                            </span>
                            <span class="settings__glyph--hide flex items-center">
                                <IconEyeOff />
                            </span>
                        </button>
                    </span>
                </label>
                <p
                    id="settings-confirm-error"
                    class="text-error-text"
                    data-field-error
                    hidden
                />
            </div>
            <button
                class="btn btn--primary self-start"
                type="submit"
            >
                Update password
            </button>
        </form>
        <section
            class="settings__panel slab slab--card"
            aria-labelledby="settings-attendance-title"
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2
                    id="settings-attendance-title"
                    class="text-2xl"
                >
                    Attendance
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Every event you have checked in to since you joined, newest first.
                </p>
            </hgroup>
            <p
                class="slab slab--empty slab--sunk text-base text-text-secondary"
                data-settings-attendance-empty
                hidden
            >
                No check-ins on file. Events you check in to appear here.
            </p>
            <div class="scroll-slot settings__scroller--attendance overflow-x-auto border-2 border-border-strong">
                <table class="settings__table">
                    <caption class="sr-only">Events you checked in to, with the date of each check-in</caption>
                    <thead>
                        <tr class="label text-text-secondary">
                            <th
                                class="w-full px-(--space-sm) py-(--space-xs) text-left whitespace-nowrap max-md:px-(--space-2xs)"
                                scope="col"
                            >
                                Event
                            </th>
                            <th
                                class="px-(--space-sm) py-(--space-xs) text-right whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Date
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-settings-attendance
                    />
                </table>
                <template data-settings-attendance-row>
                    <tr>
                        <th
                            class="px-(--space-sm) py-(--space-sm) font-bold font-sans text-left wrap-anywhere max-md:px-(--space-2xs)"
                            scope="row"
                        >
                            <div class="grid gap-(--space-3xs)">
                                <span data-cell="event" />
                                <time
                                    class="hidden font-mono font-normal text-base whitespace-nowrap text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </th>
                        <td class="px-(--space-sm) py-(--space-sm) font-mono text-base text-right whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                    </tr>
                </template>
            </div>
        </section>
        <section
            class="settings__panel slab slab--card"
            aria-labelledby="settings-ledger-title"
        >
            <hgroup class="flex flex-col gap-(--space-xs)">
                <h2
                    id="settings-ledger-title"
                    class="text-2xl"
                >
                    Prods ledger
                </h2>
                <p class="max-w-2xl text-lg text-text-secondary">
                    Every Prod earned or spent since you joined, newest first, with the balance that
                    stood after each entry.
                </p>
            </hgroup>
            <div class="scroll-slot settings__scroller--ledger overflow-x-auto border-2 border-border-strong">
                <table class="settings__table">
                    <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                    <thead>
                        <tr class="label text-text-secondary">
                            <th
                                class="px-(--space-sm) py-(--space-xs) text-left whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Date
                            </th>
                            <th
                                class="w-full px-(--space-sm) py-(--space-xs) text-left whitespace-nowrap max-md:px-(--space-2xs)"
                                scope="col"
                            >
                                Reason
                            </th>
                            <th
                                class="px-(--space-sm) py-(--space-xs) text-right whitespace-nowrap max-md:hidden"
                                scope="col"
                            >
                                Change
                            </th>
                            <th
                                class="px-(--space-sm) py-(--space-xs) text-right whitespace-nowrap max-md:px-(--space-2xs)"
                                scope="col"
                            >
                                Balance
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-settings-ledger
                    />
                </table>
                <template data-settings-ledger-row>
                    <tr>
                        <td class="px-(--space-sm) py-(--space-sm) font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                        <td class="px-(--space-sm) py-(--space-sm) text-base wrap-anywhere max-md:px-(--space-2xs)">
                            <div class="grid gap-(--space-3xs)">
                                <span data-cell="reason" />
                                <time
                                    class="hidden font-mono whitespace-nowrap text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </td>
                        <td
                            class="px-(--space-sm) py-(--space-sm) font-mono text-base text-right whitespace-nowrap max-md:hidden"
                            data-cell="change"
                        />
                        <td class="px-(--space-sm) py-(--space-sm) font-mono text-base text-right whitespace-nowrap max-md:px-(--space-2xs)">
                            <div class="grid gap-(--space-3xs)">
                                <span data-cell="balance" />
                                <span
                                    class="hidden max-md:block"
                                    data-cell="change"
                                />
                            </div>
                        </td>
                    </tr>
                </template>
            </div>
        </section>
    </div>
</section>

<style>
    .settings__chip {
        align-items: center;
        border: 2px solid var(--color-border-strong);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        gap: var(--space-2xs);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        text-transform: uppercase;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
        user-select: none;
    }

    .settings__chip:has(.box:checked) {
        background-color: var(--color-bg-sunken);
    }

    .settings__file {
        clip-path: inset(50%);
        height: 100%;
        inset: 0;
        margin: 0;
        width: 100%;
    }

    .settings__form {
        margin-inline: auto;
        max-width: var(--measure-form);
        width: 100%;
    }

    .settings__form,
    .settings__panel {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        padding: var(--space-lg);
    }

    .settings__overview {
        --slab-fill: var(--color-border-strong);
    }

    .settings__pick {
        align-items: center;
        background-color: var(--color-bg-page);
        border: 2px dashed var(--color-border-strong);
        display: flex;
        flex: 1 1 220px;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        position: relative;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .settings__pick > span {
        background-color: inherit;
    }

    .settings__pick:active {
        background-color: var(--color-bg-active);
        border-color: var(--color-border-selected);
    }

    .settings__pick:has(.settings__file:focus-visible) {
        border-color: var(--color-border-selected);
        border-style: solid;
    }

    .settings__pick:has(.settings__file[aria-invalid='true']) {
        border-color: var(--color-border-invalid);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-border-strong);
    }

    .settings__pick:hover {
        background-color: var(--color-bg-hover);
        border-color: var(--color-border-selected);
    }

    .settings__reveal {
        align-items: center;
        bottom: 0;
        color: var(--color-text-secondary);
        cursor: pointer;
        display: flex;
        justify-content: center;
        position: absolute;
        right: 0;
        top: 0;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 48px;
    }

    .settings__reveal:active {
        transform: translateY(1px);
    }

    .settings__reveal:focus-visible {
        outline-offset: -4px;
    }

    .settings__reveal:hover {
        color: var(--color-link);
    }

    .settings__reveal::after {
        content: '';
        height: 48px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
    }

    .settings__reveal[aria-pressed='false'] .settings__glyph--hide,
    .settings__reveal[aria-pressed='true'] .settings__glyph--show {
        display: none;
    }

    .settings__scroller--attendance {
        --scroll-slot-max: calc(2 * 2px + 2 * var(--space-xs) + var(--text-sm) + 5 * (2 * var(--space-sm) + var(--text-base--line-height) + 1px));
    }

    .settings__scroller--ledger {
        --scroll-slot-max: calc(2 * 2px + 2 * var(--space-xs) + var(--text-sm) + 5 * (2 * var(--space-sm) + var(--text-base--line-height) + 1px));
    }

    .settings__staged {
        align-items: center;
        column-gap: var(--space-sm);
        display: flex;
        flex: 1 1 260px;
        flex-wrap: wrap;
        justify-content: space-between;
        padding: var(--space-2xs) var(--space-sm);
        row-gap: var(--space-3xs);
    }

    .settings__table {
        display: table;
        overflow-x: visible;
        width: 100%;
    }

    .settings__table thead th {
        background-color: var(--color-bg-raised);
        box-shadow: inset 0 -2px 0 var(--color-border-strong);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 768px) {
        .settings__scroller--attendance,
        .settings__scroller--ledger {
            --scroll-slot-max: calc(2 * 2px + 2 * var(--space-xs) + var(--text-sm) + 5 * (2 * var(--space-sm) + 2 * var(--text-base--line-height) + var(--space-3xs) + 1px));
        }
    }
</style>

<script>
    import { MOCK_LATENCY_MILLISECONDS, PROFILE_FIELDS, UPLOAD } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, getConfirmRule, getPasswordRule, handleReveal, isValidationBypassed, setFieldErrors, setRole, validateFields } from '@lib/ui/forms';
    import { delay, formatDateStamp, formatProds, formatRole, getInitials, pickTileColor, registerPageScript, setAvatarImage, setPending, setText } from '@lib/shared/utils';
    import { getProdsAttendance, getProdsBalance, getProdsRows, onProdsChange } from '@lib/account/prods';
    import { observeRowWindow } from '@lib/account/ledger';
    import { UPLOAD_EXTENSIONS_OR_LIST, getExtension, getSizeError, releaseAudioContext, uploadSubmission } from '@lib/audio/uploads';
    import { getOnboardingHref } from '@lib/account/onboarding';
    import { getSession, onSessionChange, saveSession } from '@lib/account/session';
    import { stageAvatar } from '@lib/account/images';
    import { toast } from '@lib/ui/toasts';

    const CURRENT_PASSWORD_MESSAGE = 'Enter your current password.';
    const INVALID_MESSAGE = 'Check the fields.';
    const LINK_MESSAGE = 'Enter a full https:// address.';
    const LINK_NAMES = ['instagram', 'spotify', 'soundcloud', 'youtube'];
    const LINK_PATTERN = /^https?:\/\/\S+\.\S+$/i;

    const PROFILE_RULES: Record<string, FieldRule> = {
        artistName: { max: PROFILE_FIELDS.artistName.maxLength, message: PROFILE_FIELDS.artistName.message },
        city: { message: PROFILE_FIELDS.city.message, required: PROFILE_FIELDS.city.required },
    };

    const SIGNED_OUT_MESSAGE = 'Sign in to save changes.';
    const STORAGE_MESSAGE = 'Nothing was saved because your browser storage is full. Clear some space and try again.';
    const TRACK_MISSING_MESSAGE = 'Stage an audio file before you save.';

    const LINK_RULES: Record<string, FieldRule> = Object.fromEntries(
        LINK_NAMES.map(name => [name, { message: LINK_MESSAGE, pattern: LINK_PATTERN }]),
    );

    const PASSWORD_RULES: Record<string, FieldRule> = {
        confirm: getConfirmRule(),
        current: { ...getPasswordRule(), message: CURRENT_PASSWORD_MESSAGE },
        password: getPasswordRule(),
    };

    let demoSummary = { email: '', name: '', role: '', since: '' };
    let isReading = false;
    let isStaging = false;
    let stagedAvatar = '';
    let unsubscribe: (() => void) | undefined;
    let unsubscribeProds: (() => void) | undefined;

    async function handleLinksSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const errors = validateFields(form, LINK_RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MILLISECONDS);

        setPending(button, false);
        toast('Links saved.', 'success');
    }

    async function handlePasswordSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const errors = validateFields(form, PASSWORD_RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MILLISECONDS);

        setPending(button, false);

        if (!getSession()) {
            toast(SIGNED_OUT_MESSAGE, 'info');

            return;
        }

        form.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"][data-reveal]').forEach(button => handleReveal(button));
        form.reset();
        toast('Password updated.', 'success');
    }

    async function handlePortraitChange(form: HTMLFormElement, input: HTMLInputElement) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || isStaging) return;

        isStaging = true;

        try {
            const staged = await stageAvatar(file);

            clearFieldErrors(form);

            if (!staged.ok) {
                setFieldErrors(form, { portrait: staged.message });
                input.focus();

                return;
            }

            stagedAvatar = staged.dataUrl;
            renderPortrait(form);
            toast('Portrait staged.', 'success');
        } finally {
            isStaging = false;
        }
    }

    async function handleProfileSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (isStaging) return;

        const errors = validateFields(form, PROFILE_RULES);
        const values = new FormData(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        const saved = await saveSession({
            artistName: String(values.get('artistName') ?? '').trim(),
            avatar: stagedAvatar,
            role: String(values.get('role') ?? ''),
        });

        setPending(button, false);

        if (!saved.session) {
            toast(SIGNED_OUT_MESSAGE, 'info');

            return;
        }

        if (!saved.persisted) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        if (stagedAvatar && getSession()?.avatar !== stagedAvatar) {
            toast('That portrait could not be stored. Try a smaller image.', 'error');

            return;
        }

        toast('Profile saved.', 'success');
    }

    async function handleTrackChange(form: HTMLFormElement, input: HTMLInputElement, signal: AbortSignal) {
        const file = input.files?.item(0);

        input.value = '';

        if (!file || isReading) return;

        const error = validateTrack(file);

        clearFieldErrors(form);

        if (error) {
            setFieldErrors(form, { track: error });
            input.focus();

            return;
        }

        isReading = true;
        setBusy(form, true);

        try {
            const result = await uploadSubmission(file, { signal });

            if (signal.aborted) return;

            if (!result.ok) {
                setFieldErrors(form, { track: result.message });
                input.focus();

                return;
            }

            stageTrack(form, file.name);
            toast('Track staged.', 'success');
        } finally {
            isReading = false;
            setBusy(form, false);
        }
    }

    async function handleTrackSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();
        clearFieldErrors(form);

        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        if (!isValidationBypassed() && staged?.hasAttribute('hidden') !== false) {
            setFieldErrors(form, { track: TRACK_MISSING_MESSAGE });
            form.querySelector<HTMLInputElement>('[data-track-input]')?.focus();
            toast(INVALID_MESSAGE, 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        await delay(MOCK_LATENCY_MILLISECONDS);

        setPending(button, false);
        toast('Track saved.', 'success');
    }

    function initSettings(signal: AbortSignal) {
        const links = document.querySelector<HTMLFormElement>('[data-links-form]');
        const password = document.querySelector<HTMLFormElement>('[data-password-form]');
        const profile = document.querySelector<HTMLFormElement>('[data-settings-form]');
        const track = document.querySelector<HTMLFormElement>('[data-track-form]');

        if (!links || !password || !profile || !track) return;

        const bio = profile.querySelector<HTMLTextAreaElement>('[name="bio"]');
        const file = track.querySelector<HTMLInputElement>('[data-track-input]');
        const picture = profile.querySelector<HTMLInputElement>('[data-portrait-input]');

        demoSummary = {
            email: readText('[data-settings-email]'),
            name: readText('[data-settings-name]'),
            role: readText('[data-settings-role]'),
            since: readText('[data-settings-since]'),
        };

        links.noValidate = true;
        password.noValidate = true;
        profile.noValidate = true;
        track.noValidate = true;
        unsubscribe?.();
        unsubscribe = onSessionChange(renderSession);
        unsubscribeProds?.();
        unsubscribeProds = onProdsChange(renderSession);
        bio?.addEventListener('input', () => setText(document.querySelector('[data-bio-count]'), String(bio.value.length)), { signal });
        file?.addEventListener('change', () => void handleTrackChange(track, file, signal), { signal });
        links.addEventListener('submit', event => void handleLinksSubmit(event, links), { signal });
        password.addEventListener('submit', event => void handlePasswordSubmit(event, password), { signal });

        password.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((button) => {
            button.addEventListener('click', () => handleReveal(button), { signal });
        });

        picture?.addEventListener('change', () => void handlePortraitChange(profile, picture), { signal });
        profile.addEventListener('submit', event => void handleProfileSubmit(event, profile), { signal });
        profile.querySelector<HTMLButtonElement>('[data-portrait-remove]')?.addEventListener('click', () => removePortrait(profile), { signal });
        signal.addEventListener('abort', releaseAudioContext, { once: true });
        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });
        signal.addEventListener('abort', () => unsubscribeProds?.(), { once: true });
        track.addEventListener('submit', event => void handleTrackSubmit(event, track), { signal });
        track.querySelector<HTMLButtonElement>('[data-track-remove]')?.addEventListener('click', () => removeTrack(track), { signal });

        document.querySelectorAll<HTMLElement>('.settings__scroller--attendance, .settings__scroller--ledger').forEach((scroller) => {
            observeRowWindow(scroller, signal);
        });

        isReading = false;
        stagedAvatar = getSession()?.avatar ?? '';
        prefillProfile(profile);
        renderPortrait(profile);
        renderSession();
    }

    function prefillProfile(form: HTMLFormElement) {
        const name = form.querySelector<HTMLInputElement>('[name="artistName"]');
        const session = getSession();

        if (!session) return;

        if (name) name.value = session.artistName;

        setRole(form, session.role);
    }

    function readText(selector: string) {
        return document.querySelector<HTMLElement>(selector)?.textContent?.trim() ?? '';
    }

    function removePortrait(form: HTMLFormElement) {
        stagedAvatar = '';
        clearFieldErrors(form);
        renderPortrait(form);
        form.querySelector<HTMLInputElement>('[data-portrait-input]')?.focus();
        toast('Portrait removed.', 'info');
    }

    function removeTrack(form: HTMLFormElement) {
        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        clearFieldErrors(form);
        setText(form.querySelector('[data-track-name]'), '');
        staged?.setAttribute('hidden', '');
        form.querySelector<HTMLInputElement>('[data-track-input]')?.focus();
        toast('Track removed.', 'info');
    }

    function renderAttendance(email: string, joined?: number) {
        const body = document.querySelector<HTMLElement>('[data-settings-attendance]');
        const empty = document.querySelector<HTMLElement>('[data-settings-attendance-empty]');
        const scroller = document.querySelector<HTMLElement>('.settings__scroller--attendance');
        const template = document.querySelector<HTMLTemplateElement>('[data-settings-attendance-row]');

        if (!body || !empty || !scroller || !template) return;

        const entries = getProdsAttendance(email, joined);

        body.replaceChildren();

        entries.toReversed().forEach((entry) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', entry.date);
                setText(date, formatDateStamp(new Date(entry.date)));
            });

            setText(fragment.querySelector<HTMLElement>('[data-cell="event"]'), entry.event);
            body.append(fragment);
        });

        setText(document.querySelector('[data-settings-attended]'), String(entries.length));
        empty.toggleAttribute('hidden', entries.length > 0);
        scroller.toggleAttribute('hidden', entries.length === 0);
    }

    function renderLedger(email: string, joined?: number) {
        const body = document.querySelector<HTMLElement>('[data-settings-ledger]');
        const template = document.querySelector<HTMLTemplateElement>('[data-settings-ledger-row]');

        if (!body || !template) return;

        body.replaceChildren();

        getProdsRows(email, joined).toReversed().forEach((row) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fragment.querySelectorAll<HTMLElement>('[data-cell="change"]').forEach((change) => {
                change.classList.toggle('text-error-text', row.amount < 0);
                setText(change, row.amount > 0 ? `+${row.amount}` : `\u2212${Math.abs(row.amount)}`);
            });

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', row.date);
                setText(date, formatDateStamp(new Date(row.date)));
            });

            setText(fragment.querySelector<HTMLElement>('[data-cell="reason"]'), row.reason);
            setText(fragment.querySelector<HTMLElement>('[data-cell="balance"]'), String(row.total));
            body.append(fragment);
        });
    }

    function renderPortrait(form: HTMLFormElement) {
        const staged = form.querySelector<HTMLElement>('[data-portrait-staged]');

        setAvatarImage(form.querySelector<HTMLImageElement>('[data-portrait-preview]'), stagedAvatar);
        staged?.toggleAttribute('hidden', stagedAvatar.length === 0);
    }

    function renderSession() {
        const link = document.querySelector<HTMLAnchorElement>('[data-settings-onboarding]');
        const session = getSession();
        const tile = document.querySelector<HTMLElement>('.settings__tile');

        const name = session ? session.artistName || session.email : demoSummary.name;
        const role = session ? session.role : demoSummary.role;

        const tileColor = pickTileColor(name);

        if (tile) {
            tile.style.background = tileColor.background;
            tile.style.color = tileColor.text;
        }

        document.querySelectorAll<HTMLElement>('[data-settings-role]').forEach(element => setText(element, formatRole(role)));
        setAvatarImage(document.querySelector<HTMLImageElement>('[data-settings-avatar]'), session?.avatar ?? '');
        setText(document.querySelector('.settings__initials'), getInitials(name));
        setText(document.querySelector('[data-settings-email]'), session?.email ?? demoSummary.email);
        setText(document.querySelector('[data-settings-name]'), name);

        setText(
            document.querySelector('[data-settings-prods]'),
            formatProds(getProdsBalance(session?.email ?? demoSummary.email, session?.createdAt)),
        );

        renderAttendance(session?.email ?? demoSummary.email, session?.createdAt);
        renderLedger(session?.email ?? demoSummary.email, session?.createdAt);

        setText(
            document.querySelector('[data-settings-since]'),
            session?.createdAt ? formatDateStamp(new Date(session.createdAt)) : demoSummary.since,
        );

        if (!link) return;

        link.toggleAttribute('hidden', !session || session.onboarded);

        if (!session) return;

        link.href = getOnboardingHref(session.email);
    }

    function setBusy(form: HTMLFormElement, isBusy: boolean) {
        const zone = form.querySelector<HTMLElement>('.settings__track');

        if (isBusy) zone?.setAttribute('aria-busy', 'true');
        else zone?.removeAttribute('aria-busy');
    }

    function stageTrack(form: HTMLFormElement, name: string) {
        const staged = form.querySelector<HTMLElement>('[data-track-staged]');

        setText(form.querySelector('[data-track-name]'), name);
        staged?.removeAttribute('hidden');
    }

    function validateTrack(file: File) {
        const extension = getExtension(file.name);

        if (!UPLOAD.extensions.some(allowed => allowed === extension)) {
            return `That is a .${extension || 'file'}. We take ${UPLOAD_EXTENSIONS_OR_LIST}.`;
        }

        return getSizeError(file, UPLOAD.maxFileBytes);
    }

    registerPageScript(initSettings);
</script>
