---
import { getCollection } from 'astro:content';
import { formatPrice, PALETTE } from '@lib/utils';

const bgColors = PALETTE.slice(0, 4);
const products = (await getCollection('products')).slice(0, 4);
---

<section
    class="py-24 border-b-2 border-ink bg-surface"
    aria-label="Featured merch"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <div class="flex items-end justify-between mb-12 gap-6 reveal">
            <div>
                <p class="label mb-3 text-coral">MERCH</p>
                <h2 class="font-sans text-5xl tracking-tight font-extrabold">Wear the alliance.</h2>
            </div>
            <a class="hidden md:inline-flex items-center gap-2 btn-text hover:text-coral transition-colors" href="/merch">
                Shop all &rarr;
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 reveal--stagger">
            {products.map((p, i) => (
                <a class="block group" href={`/merch/${p.data.slug}`}>
                    <div
                        class="aspect-square border-2 border-ink relative overflow-hidden flex items-center justify-center card-hover"
                        style={`background: ${bgColors[i % bgColors.length]}; box-shadow: var(--shadow-card-sm);`}
                    >
                        <div class="absolute inset-0 halftone"></div>
                        <span class="font-sans font-extrabold text-4xl text-white/90 mix-blend-overlay select-none uppercase tracking-tight">{p.data.title.split(' ')[0]}</span>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                        <p class="font-sans font-bold tracking-tight">{p.data.title}</p>
                        <p class="font-mono text-[12px]">{formatPrice(p.data.priceCents)}</p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
