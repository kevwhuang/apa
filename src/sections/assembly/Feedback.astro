---
import IconUpload from '@components/icons/Upload.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { BOARD_PAGE_SIZE } from '@lib/programs/submissions';
import { UPLOAD } from '@lib/shared/constants';
import { formatBytes } from '@lib/shared/utils';
import { uploadExtensionsOrList } from '@lib/audio/uploads';

const CLASS_QUEUED_LINK = 'active:translate-y-px hover:text-link flex flex-[1_1_140px] items-center min-h-(--control-size) min-w-0 font-mono text-base underline underline-offset-4 wrap-anywhere transition-[color,translate]';

const fillerRows = Array.from({ length: BOARD_PAGE_SIZE - 1 });
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="feedback-title"
>
    <div>
        <SectionHead
            class="text-4xl text-balance"
            headingId="feedback-title"
        >
            Queue a demo
        </SectionHead>
        <div
            class="has-[+[hidden]]:mb-0 flex flex-col gap-(--space-2xl) mb-(--space-2xl)"
            data-motion="unfold"
        >
            <div class="flex flex-col gap-(--space-md)">
                <p
                    class="font-bold text-base"
                    data-intake-note
                    hidden
                >
                    Submissions are closed.
                </p>
                <div
                    class="flex flex-wrap gap-4"
                    aria-label="How to hand over your track"
                    data-motion="stamp"
                    role="group"
                >
                    <button
                        class="chip feedback__mode is-active hover:bg-bg-hover"
                        aria-controls="feedback-panel-link"
                        aria-pressed="true"
                        data-intake-control
                        data-mode="link"
                        type="button"
                    >
                        Paste a link
                    </button>
                    <button
                        class="chip feedback__mode hover:bg-bg-hover"
                        aria-controls="feedback-panel-file"
                        aria-pressed="false"
                        data-intake-control
                        data-mode="file"
                        type="button"
                    >
                        Drop a file
                    </button>
                </div>
                <form
                    id="feedback-panel-link"
                    class="slab slab--card flex flex-col gap-3"
                    data-feedback-panel="link"
                    data-motion="unfold"
                >
                    <label class="flex flex-col gap-2">
                        <span class="sr-only">Track link</span>
                        <input
                            id="feedback-link"
                            class="input font-mono"
                            aria-describedby="feedback-link-help"
                            aria-invalid="false"
                            autocomplete="off"
                            data-feedback-link
                            data-intake-control
                            name="link"
                            spellcheck="false"
                            type="url"
                        />
                    </label>
                    <p
                        id="feedback-link-help"
                        class="text-base text-text-secondary"
                    >
                        A Spotify or SoundCloud link.
                    </p>
                    <button
                        class="btn btn--primary self-start"
                        data-intake-control
                        type="submit"
                    >
                        Add to queue
                    </button>
                </form>
                <div
                    id="feedback-panel-file"
                    class="slab slab--card flex flex-col gap-3"
                    data-feedback-panel="file"
                    data-motion="unfold"
                    hidden
                >
                    <label
                        class="dropzone halftone flex flex-col items-center justify-center relative min-h-[220px] gap-3 p-(--space-lg) border-2 border-border-strong border-dashed text-center bg-bg-page"
                        data-dropzone
                        for="feedback-input"
                    >
                        <IconUpload />
                        <span class="font-bold font-sans text-2xl tracking-tight">
                            Drop your track
                        </span>
                        <span class="label text-text">or choose a file</span>
                        <input
                            id="feedback-input"
                            class="dropzone__input sr-only"
                            accept={UPLOAD.acceptAttribute}
                            aria-describedby="feedback-file-help"
                            aria-invalid="false"
                            data-dropzone-input
                            data-intake-control
                            multiple
                            name="feedback"
                            type="file"
                        />
                    </label>
                    <p
                        id="feedback-file-help"
                        class="text-base text-text-secondary"
                    >
                        {uploadExtensionsOrList} files up to {formatBytes(UPLOAD.maxFileBytes)}.
                    </p>
                </div>
            </div>
            <ol
                class="empty:hidden flex flex-col gap-(--space-2xl) list-none"
                aria-label="Queued for the next Assembly"
                data-feedback-list
            />
            <p
                class="sr-only"
                aria-live="polite"
                data-feedback-status
            />
        </div>
        <div data-board-root>
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
                <h3
                    class="text-2xl"
                    data-motion="rise"
                >
                    The demo board
                </h3>
                <p
                    class="label flex items-center gap-2 text-text-secondary"
                    data-board-refresh
                    hidden
                >
                    <span class="spinner" aria-hidden="true" />
                    <span data-board-refresh-text />
                </p>
            </div>
            <div
                class="@container overflow-x-auto mb-5"
                data-board-frame
                data-motion="unfold"
            >
                <table class="table-fixed border-2 border-border-strong [--board-index:calc(var(--text-base)*var(--board-digits,2)*0.612+33px)] [--board-time:calc(var(--text-sm)*6.048+33px)] max-md:[--board-index:calc(var(--text-base)*var(--board-digits,2)*0.612+17px)] max-md:[--board-time:calc(var(--text-sm)*6.048+17px)]">
                    <caption class="sr-only">Demos queued for the next Assembly</caption>
                    <colgroup>
                        <col class="w-(--board-index)" />
                        <col class="w-[clamp(160px,calc((100cqw-var(--board-index)-var(--board-time)-66px)*var(--board-share,0.391)+32px),calc(100cqw-var(--board-index)-var(--board-time)-162px))] max-md:w-[max(128px,calc(100cqw-var(--board-index)-var(--board-time)-2px))]" />
                        <col class="max-md:hidden" />
                        <col class="w-(--board-time)" />
                    </colgroup>
                    <thead>
                        <tr class="label border-b-2 border-border-strong text-text-secondary">
                            <th
                                class="px-4 py-3 text-left max-md:px-2"
                                scope="col"
                            >
                                #
                            </th>
                            <th
                                class="px-4 py-3 text-left max-md:px-2"
                                scope="col"
                            >
                                Producer
                            </th>
                            <th
                                class="px-4 py-3 text-left max-md:hidden"
                                scope="col"
                            >
                                Source
                            </th>
                            <th
                                class="px-4 py-3 text-right whitespace-nowrap max-md:px-2"
                                scope="col"
                            >
                                Submitted
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-board-body
                    >
                        <tr class="h-14 max-md:h-18">
                            <td
                                class="label px-4 text-text-secondary max-md:px-2"
                                colspan="4"
                            >
                                <span class="flex items-center gap-2">
                                    <span class="spinner" aria-hidden="true" />
                                    Pulling up the board&hellip;
                                </span>
                            </td>
                        </tr>
                        {fillerRows.map(() => (
                            <tr
                                class="h-14 max-md:h-18"
                                aria-hidden="true"
                            >
                                <td colspan="4" />
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-x-(--space-md) gap-y-3">
                <nav
                    class="flex flex-wrap gap-2"
                    aria-label="Demo board pages"
                    data-board-pager
                />
                <p
                    class="label text-text-secondary"
                    aria-live="polite"
                    data-board-status
                    data-motion="stamp"
                />
            </div>
        </div>
    </div>
    <template data-feedback-row-link>
        <li class="slab slab--card flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline gap-3">
                <p class="label px-2 py-1 bg-bg-inverse text-text-inverse">Link</p>
                <p
                    class="font-bold wrap-anywhere"
                    data-row-host
                />
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4">
                <a
                    class={CLASS_QUEUED_LINK}
                    data-row-href
                    href="/assemblies"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <span data-row-label>Queued link</span>
                    <span class="sr-only">&nbsp;(opens in a new tab)</span>
                </a>
                <button
                    class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                    data-row-remove
                    type="button"
                >
                    Remove
                </button>
            </div>
        </li>
    </template>
    <template data-feedback-row-file>
        <li class="slab slab--card flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div class="flex flex-wrap items-baseline gap-3">
                    <p class="label px-2 py-1 bg-bg-inverse text-text-inverse">File</p>
                    <p
                        class="font-bold wrap-anywhere"
                        data-row-name
                    />
                </div>
                <p
                    class="label text-text-secondary"
                    data-row-meta
                />
            </div>
            <canvas
                class="block h-18 max-w-full w-full text-text-brand"
                aria-hidden="true"
                data-row-canvas
                height="72"
                hidden
                width="640"
            />
            <div class="flex flex-wrap items-center justify-between gap-4">
                <progress
                    class="progress flex-[1_1_140px] h-3 min-w-0"
                    data-row-progress
                    max="100"
                    value="0"
                />
                <p
                    class="label min-w-[34px] text-text-secondary"
                    data-row-percent
                />
                <button
                    class="action-text flex items-center min-h-(--control-size) px-1 text-text-secondary"
                    data-row-cancel
                    type="button"
                >
                    Remove
                </button>
            </div>
        </li>
    </template>
    <template data-board-row>
        <tr class="h-14 max-md:h-18">
            <td
                class="px-4 font-mono text-base whitespace-nowrap text-text-secondary max-md:px-2"
                data-cell-index
            />
            <td class="px-4 max-md:px-2">
                <span
                    class="block font-bold truncate"
                    data-cell-producer
                />
                <span
                    class="has-[a]:overflow-visible has-[button]:overflow-visible hidden font-mono text-base truncate text-text-secondary max-md:block"
                    data-cell-source
                />
            </td>
            <td
                class="px-4 font-mono text-base truncate max-md:hidden"
                data-cell-source
            />
            <td
                class="px-4 font-mono text-right text-sm whitespace-nowrap text-text-secondary max-md:px-2"
                data-cell-submitted
            />
        </tr>
    </template>
    <template data-board-link>
        <a
            class="hit active:translate-y-px hover:text-link inline-flex max-w-full align-top transition-[color,translate]"
            href="/assemblies"
            rel="noopener noreferrer"
            target="_blank"
        >
            <span class="min-w-0 truncate" data-board-link-label />
            <span class="sr-only">&nbsp;(opens in a new tab)</span>
        </a>
    </template>
    <template data-board-play>
        <button
            class="hit active:translate-y-px aria-pressed:text-link hover:text-link inline-flex max-w-full align-top text-left transition-[color,translate]"
            aria-pressed="false"
            type="button"
        >
            <span class="sr-only">Play&nbsp;</span>
            <span class="min-w-0 truncate" data-board-play-label />
        </button>
    </template>
    <template data-board-filler>
        <tr
            class="h-14 max-md:h-18"
            aria-hidden="true"
        >
            <td />
            <td />
            <td class="max-md:hidden" />
            <td />
        </tr>
    </template>
    <template data-board-page>
        <button
            class="chip hover:bg-bg-hover min-w-(--control-size)"
            type="button"
        />
    </template>
</section>

<script>
    import { applyInstantly, initRovingFocus, registerPageScript, setPending, setText } from '@lib/shared/utils';
    import { bindIntake } from '@lib/programs/intake';
    import { createBoard } from '@lib/programs/board';
    import { createDropzone, findNextFocusTarget } from '@lib/audio/dropzone';
    import { getBoard, onBoardChange, removeSubmission, submitFile, submitLink, watchBoard } from '@lib/programs/submissions';
    import { isSwitchOpen } from '@lib/programs/switches';
    import { parseTrackLink } from '@lib/programs/feedback';
    import { toast } from '@lib/ui/toasts';

    const RESUBMIT_WINDOW_MILLISECONDS = 500;

    const linkRows = new Map<string, HTMLElement>();

    let isSubmitting = false;
    let linkQueuedAt = Number.NEGATIVE_INFINITY;

    function announce(message: string) {
        setText(document.querySelector('[data-feedback-status]'), message);
    }

    function clearLinkError(input: HTMLInputElement) {
        input.setAttribute('aria-invalid', 'false');
    }

    function handleLinkInput(input: HTMLInputElement) {
        linkQueuedAt = Number.NEGATIVE_INFINITY;
        clearLinkError(input);
    }

    async function handleLinkRemove(id: string, host: string, row: HTMLElement) {
        const button = row.querySelector<HTMLButtonElement>('[data-row-remove]');
        const target = findNextFocusTarget(row, '[data-feedback-link]');

        setPending(button, true);

        const result = await removeSubmission(id);

        if (!result.ok) {
            setPending(button, false);
            toast(result.message, 'error');

            return;
        }

        target?.focus();
        announce(`${host} link removed.`);
    }

    async function handleLinkSubmit(event: SubmitEvent, form: HTMLFormElement, input: HTMLInputElement) {
        event.preventDefault();

        if (isSubmitting) return;
        if (event.timeStamp - linkQueuedAt < RESUBMIT_WINDOW_MILLISECONDS && input.value.trim().length === 0) return;

        const parsed = parseTrackLink(input.value);

        if (!parsed.ok) {
            setLinkError(input, parsed.message);

            return;
        }

        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');

        isSubmitting = true;
        setPending(submit, true);

        const result = await submitLink('assembly', parsed.link);

        isSubmitting = false;
        setPending(submit, false);

        if (submit) submit.disabled = !isSwitchOpen('assembly_intake');

        if (!result.ok) {
            setLinkError(input, result.message);

            return;
        }

        clearLinkError(input);
        form.reset();
        linkQueuedAt = performance.now();
        input.focus();
        announce(`${parsed.link.host} link queued for the next Assembly.`);
    }

    function initAssemblyFeedback(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('[data-feedback-panel="link"]');
        const linkInput = document.querySelector<HTMLInputElement>('[data-feedback-link]');
        const list = document.querySelector<HTMLElement>('[data-feedback-list]');
        const modes = document.querySelectorAll<HTMLButtonElement>('.feedback__mode');

        if (!form || !linkInput || !list) return;

        isSubmitting = false;
        linkQueuedAt = Number.NEGATIVE_INFINITY;
        linkRows.clear();
        setMode('link');

        const syncFiles = createDropzone({
            selectors: {
                list: '[data-feedback-list]',
                row: '[data-feedback-row-file]',
                status: '[data-feedback-status]',
            },
            signal,
            store: {
                remove: removeSubmission,
                send: (file, options) => submitFile('assembly', file, options),
            },
        });

        form.noValidate = true;
        form.addEventListener('submit', event => void handleLinkSubmit(event, form, linkInput), { signal });
        linkInput.addEventListener('input', () => handleLinkInput(linkInput), { signal });
        initRovingFocus(modes, signal);

        modes.forEach((button) => {
            button.addEventListener('click', () => setMode(button.dataset.mode === 'file' ? 'file' : 'link'), { signal });
        });

        bindIntake('assembly', signal);
        watchBoard('assembly');
        syncQueue(list, syncFiles, signal);
        signal.addEventListener('abort', onBoardChange(() => syncQueue(list, syncFiles, signal)), { once: true });
    }

    function initDemoBoard(signal: AbortSignal) {
        createBoard({ board: 'assembly', signal, sourceSelector: '[data-cell-source]' });
    }

    function renderLinkRow(entry: BoardEntry, list: HTMLElement, signal: AbortSignal) {
        const template = document.querySelector<HTMLTemplateElement>('[data-feedback-row-link]');

        if (!template) return null;

        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const row = fragment.querySelector<HTMLElement>('li');

        if (!row) return null;

        const anchor = row.querySelector<HTMLAnchorElement>('[data-row-href]');
        const parsed = parseTrackLink(entry.href);
        const remove = row.querySelector<HTMLButtonElement>('[data-row-remove]');

        const host = parsed.ok ? parsed.link.host : '';

        setText(row.querySelector('[data-row-host]'), host);

        if (anchor) {
            anchor.href = entry.href;
            setText(anchor.querySelector('[data-row-label]'), entry.href);
        }

        remove?.setAttribute('aria-label', `Remove ${host} link`);
        remove?.addEventListener('click', () => void handleLinkRemove(entry.id, host, row), { signal });
        list.append(fragment);

        return row;
    }

    function setLinkError(input: HTMLInputElement, message: string) {
        input.setAttribute('aria-invalid', 'true');
        toast(message, 'error');
        input.focus();
    }

    function setMode(next: 'file' | 'link') {
        document.querySelectorAll<HTMLButtonElement>('.feedback__mode').forEach((button) => {
            const isActive = button.dataset.mode === next;

            applyInstantly(button, () => {
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-pressed', String(isActive));
            });
        });

        document.querySelectorAll<HTMLElement>('[data-feedback-panel]').forEach((panel) => {
            panel.toggleAttribute('hidden', panel.dataset.feedbackPanel !== next);
        });
    }

    function syncLinks(entries: BoardEntry[], list: HTMLElement, signal: AbortSignal) {
        const ids = new Set(entries.map(entry => entry.id));

        for (const [id, row] of linkRows) {
            if (ids.has(id)) continue;

            row.remove();
            linkRows.delete(id);
        }

        entries.forEach((entry) => {
            if (linkRows.has(entry.id)) return;

            const row = renderLinkRow(entry, list, signal);

            if (row) linkRows.set(entry.id, row);
        });
    }

    function syncQueue(list: HTMLElement, syncFiles: ((entries: BoardEntry[]) => void) | undefined, signal: AbortSignal) {
        const own = getBoard('assembly').entries.filter(entry => entry.self);

        syncLinks(own.filter(entry => entry.href), list, signal);
        syncFiles?.(own.filter(entry => entry.path));
    }

    registerPageScript(initAssemblyFeedback);
    registerPageScript(initDemoBoard);
</script>
