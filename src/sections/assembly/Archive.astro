---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate } from '@lib/utils';

const events = await getCollection('events');
const past = events
    .filter(event => event.data.type === 'assembly' && event.data.status === 'past')
    .sort((a, b) => +b.data.date - +a.data.date);
---

<section
    class="stage stage--assembly stage--tight"
    aria-labelledby="assembly-past-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`Archive / ${past.length} on file`}
            headingId="assembly-past-title"
        >
            Minutes from past sessions
        </SectionHead>
        <ol
            class="assembly-archive list-none"
            data-motion-stagger="rise"
        >
            {past.map((event, index) => (
                <li>
                    <article
                        id={event.id}
                        class="assembly-archive__card pt-4 border-t-2 border-ink"
                    >
                        <p
                            class="label mb-2 text-ink-muted"
                            data-placeholder
                        >
                            <span class="text-accent-deep">Session {String(past.length - index).padStart(2, '0')}</span>
                            {' / '}
                            <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                        </p>
                        <h3 class="font-bold font-sans text-lg tracking-tight">
                            {event.data.title}
                        </h3>
                        <address class="mt-1 font-mono not-italic text-xs uppercase text-ink-muted">
                            {event.data.location}
                        </address>
                        <p class="mt-3 leading-relaxed text-sm text-ink-muted">
                            {event.data.excerpt}
                        </p>
                    </article>
                </li>
            ))}
        </ol>
        <p class="mt-12">
            <a
                class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] transition-colors"
                href="/events#past-title"
            >
                The full archive, every program &rarr;
            </a>
        </p>
    </div>
</section>

<style>
    .assembly-archive {
        column-gap: var(--space-2xl);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-lg));
        row-gap: 0;
    }

    .assembly-archive > li {
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
        padding-bottom: var(--space-lg);
    }

    .assembly-archive__card {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
    }

    @media (max-width: 768px) {
        .assembly-archive {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
