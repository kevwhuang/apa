---
import { getCollection } from 'astro:content';

import ProgramCard from '@components/program/Card.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { isUpcoming, toProgramCard } from '@lib/shared/utils';

const events = await getCollection('events');

const archive = events
    .filter(event => event.data.type === 'assembly')
    .sort((a, b) => +b.data.date - +a.data.date)
    .map(entry => toProgramCard(entry));

const isStill = archive.some(card => card.notes.length > 0);
---

<section
    class="stage stage--assembly stage--tight"
    aria-labelledby="assembly-past-title"
>
    <div>
        <SectionHead
            class="text-4xl text-balance max-md:text-2xl"
            headingId="assembly-past-title"
        >
            Past Assemblies
        </SectionHead>
        <ol
            class="grid grid-cols-2 -mb-(--space-2xl) gap-x-(--space-lg) gap-y-0 list-none max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            {archive.map(card => (
                <li
                    id={isUpcoming(card.end) ? undefined : card.id}
                    class="grid grid-cols-[minmax(0,1fr)] grid-rows-subgrid row-span-3 pb-(--space-2xl)"
                    data-event-end={card.end.toISOString()}
                    data-event-id={card.id}
                    data-event-role="past"
                    hidden={isUpcoming(card.end)}
                >
                    <ProgramCard
                        credit={card.credit}
                        date={card.date}
                        group="assembly-archive"
                        heading={card.heading}
                        isStill={isStill}
                        location={card.location}
                        notes={card.notes}
                        program="assembly"
                        text={card.text}
                    />
                </li>
            ))}
        </ol>
    </div>
</section>

<Schedule />
