---
import ProgramCard from '@components/program/Card.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { isUpcoming, toAustinIso, toProgramCard } from '@lib/shared/utils';
import { loadEvents } from '@lib/programs/calendar';

const events = await loadEvents();

const archive = events
    .filter(event => event.program === 'Assembly')
    .toReversed()
    .map(event => toProgramCard(event));
---

<section
    class="stage stage--tight"
    aria-labelledby="assembly-past-title"
>
    <div>
        <SectionHead
            class="text-2xl-4xl text-balance"
            headingId="assembly-past-title"
        >
            Past Assemblies
        </SectionHead>
        <ol
            class="grid-tail grid-tail--wide grid grid-cols-2 -mb-(--space-2xl) gap-x-(--space-lg) gap-y-0 list-none max-md:grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))]"
            data-motion-stagger="flip"
        >
            {archive.map(card => (
                <li
                    class="grid grid-cols-1 grid-rows-subgrid row-span-3 pb-(--space-2xl)"
                    data-event-end={toAustinIso(card.endsAt)}
                    data-event-role="past"
                    hidden={isUpcoming(card.endsAt)}
                >
                    <ProgramCard
                        credit={card.credit}
                        group="assembly-archive"
                        heading={card.heading}
                        notes={card.notes}
                        program="Assembly"
                        startsAt={card.startsAt}
                        text={card.text}
                        venue={card.venue}
                    />
                </li>
            ))}
        </ol>
    </div>
</section>

<Schedule />
