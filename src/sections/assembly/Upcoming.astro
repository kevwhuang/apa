---
import { getCollection } from 'astro:content';

import ProgramCard from '@components/program/Card.astro';
import Schedule from '@components/program/Schedule.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { isUpcoming, toProgramCard } from '@lib/shared/utils';

const events = await getCollection('events');

const later = events
    .filter(event => event.data.type === 'assembly' && isUpcoming(event.data.end))
    .sort((a, b) => +a.data.date - +b.data.date)
    .slice(1)
    .map(entry => toProgramCard(entry));

const isStill = later.some(card => card.notes.length > 0);
---

<section
    class="stage stage--assembly stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-upcoming-title"
    data-event-group="assembly-upcoming"
    data-event-role="many"
    hidden={later.length === 0}
>
    <div>
        <SectionHead
            class="text-4xl text-balance max-md:text-2xl"
            headingId="assembly-upcoming-title"
        >
            Upcoming Assemblies
        </SectionHead>
        <ol
            class="grid grid-cols-2 -mb-(--space-2xl) gap-x-(--space-lg) gap-y-0 list-none max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            {later.map(card => (
                <li
                    id={card.id}
                    class="grid grid-cols-[minmax(0,1fr)] grid-rows-subgrid row-span-3 pb-(--space-2xl)"
                    data-event-end={card.end.toISOString()}
                    data-event-group="assembly-upcoming"
                    data-event-id={card.id}
                    data-event-role="later"
                >
                    <ProgramCard
                        credit={card.credit}
                        date={card.date}
                        group="assembly-upcoming"
                        heading={card.heading}
                        isStill={isStill}
                        location={card.location}
                        notes={card.notes}
                        program="assembly"
                        text={card.text}
                    />
                </li>
            ))}
        </ol>
    </div>
</section>

<Schedule />
