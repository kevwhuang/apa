---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import Schedule from '@components/program/Schedule.astro';
import { PALETTE } from '@lib/shared/constants';
import { getInitials, isUpcoming } from '@lib/shared/utils';

import type { ImageMetadata } from 'astro';

const PORTRAIT_SIZES = '(max-width: 768px) calc(81.5vw - 78px), (max-width: 1024px) calc(35.7vw - 76px), 373px';
const PORTRAIT_WIDTH = 500;

const SESSION_EXTRAS = {
    files: [
        { description: 'Two tracks prepared to mix cleanly, split out for rehearsing each blend.', meta: 'ZIP \u00b7 210 MB', title: 'Practice Stems' },
        { description: 'Every phrasing and beatmatching chart from the lab, annotated after the fact.', meta: 'PDF \u00b7 24 pages', title: 'Workshop Slides' },
    ],
    id: '2026_11_assembly_alt_slauson',
    role: 'Electronic music producer',
} as const;

const events = await getCollection('events');

const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/images/speakers/*.webp', { eager: true });

const sessions = events
    .filter(event => event.data.speakers.length > 0 && event.data.type === 'assembly' && event.data.workshop)
    .sort((a, b) => +a.data.date - +b.data.date);

const ended = sessions.filter(session => !isUpcoming(session.data.end));
const upcoming = sessions.filter(session => isUpcoming(session.data.end));

const cards = [...ended.slice(-1), ...upcoming].map((session, index) => ({
    bios: session.data.speakers.flatMap(({ bio }) => (bio ? [bio] : [])),
    description: session.data.description,
    end: session.data.end.toISOString(),
    extras: session.id === SESSION_EXTRAS.id ? SESSION_EXTRAS : undefined,
    headingId: index === 0 ? 'workshop-title' : `workshop-${index + 1}-title`,
    isUpcoming: isUpcoming(session.data.end),
    portrait: portraits[`/src/images/speakers/${session.data.speakers[0].name.toLowerCase().replace(/[^a-z0-9]+/g, '_')}.webp`]?.default,
    speaker: session.data.speaker ?? session.data.speakers.map(speaker => speaker.name).join(' & '),
    workshop: session.data.workshop,
}));

const shown = cards.find(card => card.isUpcoming) ?? cards.at(-1);
---

{cards.map(card => (
    <section
        class="stage stage--tight border-b-2 border-border-strong"
        aria-labelledby={card.headingId}
        data-event-end={card.end}
        data-event-group="workshop"
        data-event-role="current"
        hidden={card !== shown}
    >
        <div
            class="slab slab--lift slab--roomy workshop"
            data-motion="unfold"
        >
            <hgroup>
                <p
                    class="mark slab workshop__marker mb-(--space-lg) font-mono text-2xl-4xl"
                    data-motion="stamp"
                >
                    <span
                        data-event-end={card.end}
                        data-event-group="workshop"
                        data-event-role="upcoming"
                        hidden={!card.isUpcoming}
                    >
                        Upcoming workshop
                    </span>
                    <span
                        data-event-end={card.end}
                        data-event-group="workshop"
                        data-event-role="past"
                        hidden={card.isUpcoming}
                    >
                        Latest workshop
                    </span>
                </p>
                <h2
                    id={card.headingId}
                    class="mb-(--space-lg) font-display text-xl-5xl text-balance"
                >
                    {card.workshop}
                </h2>
            </hgroup>
            <div class="grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-12 max-md:grid-cols-1">
                <div class="flex flex-col self-start gap-(--space-md)">
                    <div class="slab slab--card">
                        <div
                            class="mb-6 pb-(--lift) pe-(--lift)"
                            data-motion="wipe"
                        >
                            {card.portrait
                                ? (
                                        <Image
                                            class="slab slab--bare slab--card block aspect-square h-auto w-full"
                                            alt="Portrait of the workshop presenter"
                                            sizes={PORTRAIT_SIZES}
                                            src={card.portrait}
                                            width={PORTRAIT_WIDTH}
                                            widths={[PORTRAIT_WIDTH, PORTRAIT_WIDTH * 2]}
                                        />
                                    )
                                : (
                                        <PlaceholderTile
                                            class="slab slab--bare slab--card aspect-square"
                                            color={PALETTE[0].background}
                                            label={getInitials(card.speaker)}
                                            labelClass="text-6xl"
                                            labelColor={PALETTE[0].text}
                                        />
                                    )}
                        </div>
                        <p class="label mb-2 text-text-secondary">Presented by</p>
                        <p class:list={[card.extras ? 'mb-1' : 'mb-3', 'font-bold text-xl tracking-tight']}>
                            {card.speaker}
                        </p>
                        {card.extras && (
                            <p class="mb-3 font-mono text-base text-text-secondary">
                                {card.extras.role}
                            </p>
                        )}
                        <div class="flex flex-col gap-3">
                            {card.bios.map(bio => (
                                <p class="text-base text-text-secondary">{bio}</p>
                            ))}
                        </div>
                    </div>
                </div>
                <div>
                    {card.description && (
                        <p class:list={[card.extras && 'mb-10', 'text-lg text-text-secondary']}>
                            {card.description}
                        </p>
                    )}
                    {card.extras && (
                        <div>
                            <h3 class="mb-(--space-md) font-display text-2xl">Workshop files</h3>
                            <ul
                                class="flex flex-col list-none"
                                data-motion-stagger="rise"
                            >
                                {card.extras.files.map(file => (
                                    <li class="workshop__row first:border-t-0 first:pt-0 grid grid-cols-[minmax(min-content,1fr)_auto] items-center gap-x-4 gap-y-1 py-3 border-t border-t-border-subtle">
                                        <div class="[grid-area:body] flex flex-col gap-1">
                                            <p class="py-4 font-mono">{file.title}</p>
                                            <p class="text-base text-text-secondary">{file.description}</p>
                                        </div>
                                        <p
                                            class="[grid-area:meta] font-mono text-base whitespace-nowrap text-text-secondary"
                                            data-placeholder
                                        >
                                            {file.meta}
                                        </p>
                                        <p class="label [grid-area:status] text-text-secondary">Coming soon</p>
                                    </li>
                                ))}
                            </ul>
                            <a
                                class="action-text inline-flex items-center min-h-(--control-size) gap-2"
                                href="/resources"
                            >
                                Browse resources <IconArrow />
                            </a>
                        </div>
                    )}
                </div>
            </div>
        </div>
    </section>
))}

<Schedule />

<style>
    .workshop {
        --slab-fill: var(--color-bg-sunken);
    }

    .workshop__marker {
        --slab-fill: var(--color-event-assembly);
        --slab-level: var(--z-ground);
        --slab-rule: 2px;
        color: var(--color-event-assembly-text);
    }

    .workshop__row {
        grid-template-areas:
            'body status'
            'meta status';
    }

    @media (max-width: 1024px) {
        .workshop__row {
            grid-template-areas:
                'body body'
                'meta status';
        }
    }
</style>
