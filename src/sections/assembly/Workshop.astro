---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import IconDownload from '@components/icons/Download.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import Schedule from '@components/program/Schedule.astro';
import { PALETTE } from '@lib/shared/constants';
import { getInitials, isUpcoming, toAustinIso } from '@lib/shared/utils';
import { isDownload, toAvailability } from '@lib/resources/unlocks';
import { loadEvents } from '@lib/programs/calendar';

import type { ImageMetadata } from 'astro';

const PORTRAIT_SIZES = '(max-width: 768px) calc(81.5vw - 78px), (max-width: 1024px) calc(35.7vw - 76px), 373px';
const PORTRAIT_WIDTH = 500;

const SESSION_EXTRAS = {
    event_id: '2026_11_assembly',
    files: ['logo_kit', 'press_kit'],
} as const;

const downloads = await getCollection('downloads');
const events = await loadEvents();

const files = SESSION_EXTRAS.files.map((id) => {
    const entry = downloads.find(download => download.id === id);

    if (!entry) throw new Error(`Download ${id} has no file.`);

    return {
        availability: toAvailability(entry.data),
        description: entry.data.description,
        href: entry.data.href,
        isDownload: isDownload(entry.data),
        title: entry.data.title,
    };
});

const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/images/speakers/*.webp', { eager: true });

const sessions = events.flatMap(event => (event.program === 'Assembly' && event.speaker ? [{ ...event, speaker: event.speaker }] : []));

const ended = sessions.filter(session => !isUpcoming(session.ends_at));
const upcoming = sessions.filter(session => isUpcoming(session.ends_at));

const cards = [...ended.slice(-1), ...upcoming].map((session, index) => ({
    bio: session.speaker.bio,
    body: session.body,
    endsAt: toAustinIso(session.ends_at),
    extras: session.id === SESSION_EXTRAS.event_id && files.length > 0 ? { files } : undefined,
    headingId: index === 0 ? 'workshop-title' : `workshop-${index + 1}-title`,
    isUpcoming: isUpcoming(session.ends_at),
    portrait: portraits[`/src/images/speakers/${session.speaker.name.toLowerCase().replace(/[^a-z0-9]+/g, '_')}.webp`]?.default,
    speaker: session.speaker.name,
    title: session.title,
}));

const shown = cards.find(card => card.isUpcoming) ?? cards.at(-1);
---

{cards.map(card => (
    <section
        class="stage stage--tight border-b-2 border-border-strong"
        aria-labelledby={card.headingId}
        data-event-end={card.endsAt}
        data-event-group="workshop"
        data-event-role="current"
        hidden={card !== shown}
    >
        <div
            class="slab slab--card slab--roomy workshop"
            data-motion="unfold"
        >
            <hgroup>
                <p
                    class="mark slab workshop__marker mb-(--space-lg) font-mono text-2xl-4xl"
                    data-motion="stamp"
                >
                    <span
                        data-event-end={card.endsAt}
                        data-event-group="workshop"
                        data-event-role="upcoming"
                        hidden={!card.isUpcoming}
                    >
                        Upcoming workshop
                    </span>
                    <span
                        data-event-end={card.endsAt}
                        data-event-group="workshop"
                        data-event-role="past"
                        hidden={card.isUpcoming}
                    >
                        Latest workshop
                    </span>
                </p>
                <h2
                    id={card.headingId}
                    class="mb-(--space-lg) font-display text-xl-5xl text-balance"
                >
                    {card.title}
                </h2>
            </hgroup>
            <div class="grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-12 max-md:grid-cols-1">
                <div class="flex flex-col self-start gap-(--space-md)">
                    <div class="slab slab--card">
                        <div
                            class="mb-6"
                            data-motion="wipe"
                        >
                            {card.portrait
                                ? (
                                        <Image
                                            class="slab slab--bare slab--card block aspect-square h-auto w-full"
                                            alt="Portrait of the workshop speaker"
                                            sizes={PORTRAIT_SIZES}
                                            src={card.portrait}
                                            width={PORTRAIT_WIDTH}
                                            widths={[PORTRAIT_WIDTH, PORTRAIT_WIDTH * 2]}
                                        />
                                    )
                                : (
                                        <PlaceholderTile
                                            class="slab slab--bare slab--card aspect-square"
                                            color={PALETTE[0].background}
                                            label={getInitials(card.speaker)}
                                            labelClass="text-6xl"
                                            labelColor={PALETTE[0].text}
                                        />
                                    )}
                        </div>
                        <dl>
                            <dt class="label mb-2 text-text-secondary">Speaker</dt>
                            <dd class="mb-3 font-bold text-xl tracking-tight">
                                {card.speaker}
                            </dd>
                        </dl>
                        <div class="flex flex-col gap-3">
                            <p class="text-base text-text-secondary">{card.bio}</p>
                        </div>
                    </div>
                </div>
                <div>
                    <p class:list={[card.extras && 'mb-10', 'text-lg text-text-secondary']}>
                        {card.body}
                    </p>
                    {card.extras && (
                        <ul
                            class="flex flex-col list-none"
                            aria-label="Workshop files"
                            data-motion-stagger="rise"
                        >
                            {card.extras.files.map(file => (
                                <li class="workshop__row first:border-t-0 first:pt-0 last:pb-0 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 py-4 border-t border-t-border-subtle">
                                    <div class="[grid-area:body] flex flex-col gap-1">
                                        <p class="overflow-hidden font-bold tracking-tight text-ellipsis wrap-normal">{file.title}</p>
                                        <p class="overflow-hidden text-base text-ellipsis wrap-normal text-text-secondary">{file.description}</p>
                                    </div>
                                    {file.availability === 'open' && (
                                        <a
                                            class:list={['hit active:translate-y-px focus-visible:text-link hover:text-link [grid-area:link] inline-flex size-8 transition-[color,translate]', file.isDownload ? '-me-0.75' : 'items-center justify-end text-2xl']}
                                            aria-label={`${file.isDownload ? 'Download' : 'View'} ${file.title}`}
                                            download={file.isDownload ? '' : undefined}
                                            href={file.href}
                                        >
                                            {file.isDownload ? <IconDownload /> : <IconArrow />}
                                        </a>
                                    )}
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            </div>
        </div>
    </section>
))}

<Schedule />

<style>
    .workshop {
        --slab-fill: var(--color-bg-sunken);
    }

    .workshop__marker {
        --slab-fill: var(--color-event-assembly);
        --slab-level: var(--z-ground);
        --slab-rule: 2px;
        color: var(--color-event-assembly-text);
    }

    .workshop__row {
        grid-template-areas: 'body link';
    }
</style>
