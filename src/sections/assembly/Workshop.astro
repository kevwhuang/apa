---
import IconArrow from '@components/icons/Arrow.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { PALETTE } from '@lib/shared/constants';

const INDEX_PAD = 2;

const SESSION_FILES = [
    { description: 'Every chart from the session, annotated after the fact.', meta: 'PDF \u00b7 24 pages', title: 'Workshop slides' },
    { description: 'The bus chain Rae builds live, saved out for six DAWs.', meta: 'ZIP \u00b7 6 presets', title: 'Low-end reference chain' },
    { description: 'The session bounced at the start and the end of the night.', meta: 'ZIP \u00b7 210 MB', title: 'Before-and-after stems' },
] as const;
---

<section
    class="stage stage--assembly stage--tight border-b-2 border-border-strong"
    aria-labelledby="workshop-title"
>
    <div
        class="slab slab--cut workshop"
        data-motion="unfold"
    >
        <div
            class="mark slab slab--accent workshop__marker flex flex-wrap items-center justify-between gap-x-(--space-md) gap-y-(--space-sm) mb-(--space-lg)"
            data-motion="stamp"
        >
            <p class="label inline-block px-2 py-1 bg-bg-inverse text-text-inverse">
                Next workshop
            </p>
            <p
                class="label font-bold"
                data-placeholder
            >
                Workshop 08
            </p>
            <p class="workshop__stamp font-bold font-mono leading-none text-4xl uppercase">
                August
            </p>
        </div>
        <h2
            id="workshop-title"
            class="mb-(--space-lg) text-4xl md:text-5xl text-balance"
        >
            Low end, under control
        </h2>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div class="flex flex-col self-start gap-(--space-md)">
                <div class="slab slab--card">
                    <div
                        class="workshop__plate mb-6"
                        data-motion="wipe"
                    >
                        <PlaceholderTile
                            class="slab slab--bare slab--card aspect-[4/3]"
                            color={PALETTE[1].bg}
                            label="08"
                            labelClass="leading-none text-7xl [text-shadow:2px_2px_0_var(--color-shadow-md)]"
                            labelColor={PALETTE[1].text}
                        >
                            <div
                                class="label absolute bottom-0 inset-x-0 p-3 bg-linear-to-t from-bg-overlay text-text-on-brand to-transparent"
                                data-placeholder
                            >
                                Workshop 08 / Low end
                            </div>
                        </PlaceholderTile>
                    </div>
                    <p class="label mb-2 text-link">Presented by</p>
                    <p
                        class="mb-1 font-bold font-sans text-xl tracking-tight"
                        data-placeholder
                    >
                        Rae Delgado
                    </p>
                    <p
                        class="mb-3 font-mono text-xs uppercase text-text-secondary"
                        data-placeholder
                    >
                        Mix engineer &middot; Eastside Sound Annex
                    </p>
                    <p
                        class="leading-relaxed text-sm text-text-secondary"
                        data-placeholder
                    >
                        Rae has spent a decade mixing club records out of an East Austin control
                        room and teaches low end the way she learned it &mdash; by breaking a
                        good mix in front of you and putting it back together.
                    </p>
                </div>
            </div>
            <div>
                <p class="mb-4 leading-relaxed text-lg text-text-secondary">
                    Sub that swallows the kick. Basslines that vanish on a phone speaker. Mixes
                    that fall apart the moment a real system turns on. This session takes the
                    bottom octaves apart and puts them back in order.
                </p>
                <p class="mb-10 leading-relaxed text-text-secondary">
                    Rae works through a live session from the roster &mdash; carving the
                    kick-and-bass pocket, choosing what carries the weight, and checking the
                    result on the worst speaker in the building. Bring headphones to follow along
                    in your own project.
                </p>
                <div>
                    <p class="label mb-2 text-text-secondary">Session files</p>
                    <ul
                        class="flex flex-col list-none"
                        data-motion-stagger="rise"
                    >
                        {SESSION_FILES.map((file, index) => (
                            <li class="workshop__row">
                                <p
                                    class="label font-bold text-link"
                                    aria-hidden="true"
                                >
                                    {String(index + 1).padStart(INDEX_PAD, '0')}
                                </p>
                                <div class="flex flex-col gap-1">
                                    <a
                                        class="active:translate-y-px hover:text-link inline-block self-start py-(--space-sm) decoration-2 decoration-text-brand font-bold font-sans underline underline-offset-4 transition-[color,transform]"
                                        href="/resources"
                                    >
                                        {file.title}
                                    </a>
                                    <p class="text-sm text-text-secondary">{file.description}</p>
                                </div>
                                <p
                                    class="label workshop__meta text-text-secondary"
                                    data-placeholder
                                >
                                    {file.meta}
                                </p>
                            </li>
                        ))}
                    </ul>
                    <a
                        class="action-text hover:text-link inline-flex items-center gap-2 min-h-(--control-size) transition-colors"
                        href="/resources"
                    >
                        Everything lands in the resource library <IconArrow />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .workshop {
        --slab-fill: var(--color-bg-sunken);
        --slab-level: var(--z-lift);
        --slab-rule: 2px;
        padding: var(--space-2xl);
    }

    .workshop__marker {
        --slab-level: var(--z-ground);
        --slab-rule: 2px;
    }

    .workshop__plate {
        --plate-drop: calc(var(--z-card) * var(--lift));
        padding-block-end: var(--plate-drop);
        padding-inline-end: var(--plate-drop);
    }

    .workshop__row {
        align-items: baseline;
        border-top: 1px solid var(--color-border-subtle);
        display: grid;
        gap: var(--space-2xs) var(--space-sm);
        grid-template-columns: auto minmax(0, 1fr) auto;
        padding-block: var(--space-xs);
    }

    .workshop__row:first-child {
        border-top: 0;
        padding-top: 0;
    }

    .workshop__stamp {
        flex-basis: 100%;
        rotate: calc(var(--tilt-unit) * -3);
        transform-origin: 0 50%;
    }

    @media (max-width: 768px) {
        .workshop {
            padding: var(--space-lg);
        }

        .workshop__meta {
            grid-column: 2;
        }

        .workshop__row {
            grid-template-columns: auto minmax(0, 1fr);
        }
    }
</style>
