---
import Domain from '@components/shared/Domain.astro';
import Schedule from '@components/program/Schedule.astro';
import { formatLongDate, formatTimeRange, isUpcoming, toAustinIso } from '@lib/shared/utils';
import { loadEvents } from '@lib/programs/calendar';

const events = await loadEvents();

const sessions = events
    .filter(event => event.program === 'Assembly' && isUpcoming(event.ends_at))
    .map((event, index) => ({
        endsAt: toAustinIso(event.ends_at),
        externalUrl: event.external_url,
        headingId: index === 0 ? 'assembly-next-title' : `assembly-next-${index + 1}-title`,
        longDate: formatLongDate(event.starts_at),
        room: event.room,
        startsAt: toAustinIso(event.starts_at),
        time: formatTimeRange(event.starts_at, event.ends_at),
        venue: event.venue,
    }));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-label="Next Assembly"
    data-event-group="assembly-upcoming"
    data-event-role="some"
    hidden={sessions.length === 0}
>
    {sessions.map((session, index) => (
        <article
            class="slab slab--lift slab--still"
            aria-labelledby={session.headingId}
            data-event-end={session.endsAt}
            data-event-group="assembly-upcoming"
            data-event-role="next"
            data-motion="unfold"
            hidden={index > 0}
        >
            <p class="label inline-block mb-4 px-2 py-1 border-2 border-event-assembly">
                Next Assembly
            </p>
            <h2
                id={session.headingId}
                class="mb-(--space-lg) font-display text-2xl-5xl text-balance"
            >
                <time datetime={session.startsAt}>{session.longDate}</time>
            </h2>
            <dl
                class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_minmax(0,1fr)] border-border-strong border-t-2 max-lg:grid-cols-2 max-md:grid-cols-1"
                data-motion-stagger="rise"
            >
                <div class="pr-(--space-lg) pt-(--space-lg) max-md:pr-0">
                    <dt class="label mb-2 text-text-secondary">Time</dt>
                    <dd class="font-bold text-balance text-xl">{session.time}</dd>
                </div>
                <div class="pt-(--space-lg) px-(--space-lg) border-border-strong border-l-2 max-md:border-l-0 max-md:px-0">
                    <dt class="label mb-2 text-text-secondary">Where</dt>
                    <dd class="font-bold text-xl">
                        <address class="mb-1 not-italic">{session.venue}</address>
                        {session.room && (
                            <p>{session.room}</p>
                        )}
                    </dd>
                </div>
                <div class="pl-(--space-lg) pt-(--space-lg) border-border-strong border-l-2 max-lg:border-l-0 max-lg:pl-0">
                    <dt class="label mb-2 text-text-secondary">RSVP</dt>
                    <dd class="font-bold text-xl">
                        {session.externalUrl
                            ? (
                                    <a
                                        class="hit active:translate-y-px hover:text-link inline-block underline underline-offset-4 wrap-anywhere transition-[color,translate]"
                                        href={session.externalUrl}
                                        rel="noopener noreferrer"
                                        target="_blank"
                                    >
                                        <Domain href={session.externalUrl} />
                                        <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                    </a>
                                )
                            : 'TBD'}
                    </dd>
                </div>
            </dl>
        </article>
    ))}
</section>

<Schedule />
