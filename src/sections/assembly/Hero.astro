---
import PageHead from '@components/shared/PageHead.astro';

const AGENDA = [
    { name: 'Doors open', note: 'Meet the room and talk shop.', time: '6:00 PM' },
    { name: 'Demo hour', note: 'Queued tracks play out loud for feedback.', time: '6:30 PM' },
    { name: 'Featured workshop', note: 'One topic, taken apart properly.', time: '7:30 PM' },
    { name: 'After hours', note: 'Collabs form on the way out the door.', time: '9:00 PM' },
] as const;

const CLASS_AGENDA_ITEM = 'first:border-t-0 first:pt-0 last:pb-0 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-(--space-md) gap-y-1 py-4 border-border-subtle border-t';
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-title"
>
    <div>
        <PageHead
            class="max-w-4xl mb-6 text-4xl-7xl"
            headingId="assembly-title"
        >
            The working<br />
            <span class="text-text-brand">session</span>
        </PageHead>
        <div class="grid grid-cols-2 gap-(--space-2xl) max-lg:grid-cols-1">
            <div class="flex flex-col gap-5">
                <p
                    class="text-lg text-text-secondary"
                    data-motion="blur"
                >
                    Assembly is the Alliance's monthly centerpiece, an evening at STATION
                    Austin devoted to craft and community.
                </p>
                <p
                    class="text-text-secondary"
                    data-motion="rise"
                >
                    The night opens with networking. Demos come next, where work in progress plays
                    out loud and gets talked through together. Then a workshop takes one topic
                    apart, and the evening ends with a mingle.
                </p>
            </div>
            <aside
                class="pl-(--space-lg) border-border-strong border-l-2 max-lg:border-l-0 max-lg:border-t-2 max-lg:pl-0 max-lg:pt-(--space-lg)"
                aria-labelledby="assembly-details-title"
            >
                <h2
                    id="assembly-details-title"
                    class="mb-(--space-md) font-display text-2xl"
                    data-motion="rise"
                >
                    How an Assembly runs
                </h2>
                <ol
                    class="list-none"
                    data-motion-stagger="rise"
                >
                    {AGENDA.map(item => (
                        <li class={CLASS_AGENDA_ITEM}>
                            <p
                                class="row-span-2 font-mono tabular-nums text-base text-text-brand"
                                data-placeholder
                            >
                                {item.time}
                            </p>
                            <p class="font-bold leading-(--text-lg) tracking-tight">{item.name}</p>
                            <p class="text-base text-text-secondary">{item.note}</p>
                        </li>
                    ))}
                </ol>
            </aside>
        </div>
    </div>
</section>
