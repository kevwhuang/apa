---
import PageHead from '@components/shared/PageHead.astro';

const AGENDA = [
    { name: 'Arrivals', note: 'Check in, meet the room, and talk shop', time: '6:00 PM' },
    { name: 'Demo drop', note: 'Each track plays out loud for the room\'s feedback', time: '6:30 PM' },
    { name: 'Workshop', note: 'One topic in depth, or an interactive session for everyone', time: '7:30 PM' },
    { name: 'After hours', note: 'The conversation carries on downstairs', time: '9:00 PM' },
] as const;

const CLASS_AGENDA_ITEM = 'first:border-t-0 first:pt-0 last:pb-0 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-(--space-md) gap-y-1 py-4 border-border-subtle border-t';
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-title"
>
    <div>
        <PageHead
            class="max-w-4xl mb-6 text-4xl-7xl"
            headingId="assembly-title"
        >
            Your people,<br />
            <span class="text-text-brand">your sound</span>
        </PageHead>
        <div class="grid grid-cols-2 gap-(--space-lg) max-lg:grid-cols-1">
            <div class="flex flex-col self-center gap-5">
                <p
                    class="text-lg text-text-secondary"
                    data-motion="blur"
                >
                    Assembly is the Alliance's monthly centerpiece at STATION Austin, an
                    evening devoted to craft and community, with time for tracks to be heard.
                </p>
                <p
                    class="text-text-secondary"
                    data-motion="rise"
                >
                    Producers meet and introduce themselves, play their tracks at
                    the demo drop, and hear feedback from the room. Each
                    evening centers on a featured workshop or an interactive session,
                    such as a producer round robin, lightning talks, or an open
                    discussion. Members and organizers share announcements, and the
                    conversation carries on after hours.
                </p>
            </div>
            <aside
                class="pl-(--space-lg) border-border-strong border-l-2 max-lg:border-l-0 max-lg:border-t-2 max-lg:pl-0 max-lg:pt-(--space-lg)"
                aria-labelledby="assembly-details-title"
            >
                <h2
                    id="assembly-details-title"
                    class="mb-(--space-md) font-display text-2xl"
                    data-motion="rise"
                >
                    How an Assembly runs
                </h2>
                <ol
                    class="list-none"
                    data-motion-stagger="rise"
                >
                    {AGENDA.map(item => (
                        <li class={CLASS_AGENDA_ITEM}>
                            <p
                                class="row-span-2 font-mono tabular-nums text-base text-text-brand"
                                data-placeholder
                            >
                                {item.time}
                            </p>
                            <p class="font-bold leading-(--text-lg) tracking-tight">{item.name}</p>
                            <p class="text-base text-text-secondary">{item.note}</p>
                        </li>
                    ))}
                </ol>
            </aside>
        </div>
    </div>
</section>
