---
import PageHead from '@components/shared/PageHead.astro';
import { getProgram } from '@lib/shared/utils';

const AGENDA = [
    { name: 'Doors', note: 'Load in, patch in, say hello.', time: '6:00 PM' },
    { name: 'Workshop', note: 'One topic, taken apart properly.', time: '6:30 PM' },
    { name: 'Track feedback', note: 'The queue plays out loud.', time: '7:30 PM' },
    { name: 'Open floor', note: 'Collabs form on the way out the door.', time: '8:30 PM' },
] as const;

const program = getProgram('assembly');
---

<section
    class="stage stage--assembly stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-4xl text-5xl md:text-7xl"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="assembly-title"
        >
            The working<br />
            <span class="text-text-brand">session.</span>
        </PageHead>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
            <div class="flex flex-col gap-5">
                <p
                    class="max-w-2xl leading-relaxed text-lg text-text-secondary"
                    data-motion="blur"
                >
                    Assembly is the Alliance's monthly centerpiece &mdash; one evening a
                    month at STATION Austin, given over to craft and conversation.
                </p>
                <p
                    class="max-w-2xl leading-relaxed text-text-secondary"
                    data-motion="rise"
                >
                    A workshop opens the night. Then the room turns to track feedback: work in
                    progress on the big speakers, played out loud and talked through together.
                    No clock, no showdown &mdash; just the work, taken seriously.
                </p>
            </div>
            <aside
                class="slab slab--card self-start"
                aria-label="How an Assembly runs"
                data-motion="unfold"
            >
                <p class="label mb-4 text-link">Running order / Every edition</p>
                <ol class="list-none">
                    {AGENDA.map(item => (
                        <li class="first:border-t-0 first:pt-0 last:pb-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-(--space-xs) py-(--space-sm) border-t border-border-subtle">
                            <span
                                class="label pt-1 text-text-secondary"
                                data-placeholder
                            >
                                {item.time}
                            </span>
                            <div>
                                <p class="mb-1 font-bold font-sans">{item.name}</p>
                                <p class="text-sm text-text-secondary">{item.note}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </aside>
        </div>
    </div>
</section>
