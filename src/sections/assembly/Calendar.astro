---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/shared/utils';

const events = await getCollection('events');

const program = getProgram('assembly');

const upcoming = events
    .filter(event => event.data.type === 'assembly' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);

const [next, ...later] = upcoming;
---

<section
    class="stage stage--assembly stage--tight border-b-2 border-border-strong"
    aria-labelledby="assembly-next-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            eyebrow={`${program.shortName}, ${program.cadence}`}
            headingId="assembly-next-title"
        >
            Next up
            <a
                class="action-text hover:text-link hidden items-center gap-2 min-h-(--control-size) transition-colors md:inline-flex"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                slot="cta"
                target="_blank"
            >
                RSVP on Meetup <IconArrow />
            </a>
        </SectionHead>
        {next
            ? (
                    <Fragment>
                        <div
                            class:list={['mark', later.length > 0 ? 'mb-(--space-2xl)' : 'mb-6 md:mb-0']}
                            data-motion="unfold"
                        >
                            <article
                                id={next.id}
                                class="slab slab--cut slab--lift grid grid-cols-12 items-start gap-x-2 gap-y-5 md:gap-x-6"
                            >
                                <div class="col-span-12 md:col-span-5 lg:col-span-4">
                                    <p class="label inline-block mb-3 px-2 py-1 bg-event-assembly text-event-assembly-text">
                                        Next
                                    </p>
                                    <p
                                        class="mb-2 font-bold font-display leading-[0.95] text-3xl text-balance tracking-[-0.02em]"
                                        data-placeholder
                                    >
                                        <time datetime={next.data.date.toISOString()}>{formatDate(next.data.date)}</time>
                                    </p>
                                    <p
                                        class="font-mono text-xs text-text-secondary"
                                        data-placeholder
                                    >
                                        {formatTimeRange(next.data.date, next.data.end)}
                                    </p>
                                </div>
                                <div class="col-span-12 md:col-span-7 lg:col-span-8">
                                    <h3 class="mb-2 text-2xl">
                                        {next.data.title}
                                    </h3>
                                    <address class="mb-3 font-mono not-italic text-xs text-text-secondary">
                                        {next.data.location}
                                    </address>
                                    <p class="max-w-2xl mb-4 leading-relaxed text-text-secondary">
                                        {next.data.excerpt}
                                    </p>
                                    <p>
                                        <a
                                            class="action-text hover:text-link inline-flex items-center gap-(--space-2xs) min-h-(--control-size) underline underline-offset-4 transition-colors"
                                            href={LINKS.meetup}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            RSVP on Meetup <IconArrow />
                                            <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                        </a>
                                    </p>
                                </div>
                            </article>
                        </div>
                        {later.length > 0 && (
                            <Fragment>
                                <p
                                    class="label mb-4 text-text-secondary"
                                    data-motion="rise"
                                >
                                    And after that
                                </p>
                                <ul
                                    class="mb-6 border-2 border-border-strong list-none md:mb-0"
                                    data-motion-stagger="rise"
                                >
                                    {later.map(event => (
                                        <li
                                            id={event.id}
                                            class="assembly-next__row rank last:border-b-0 items-baseline px-5 py-3 border-b-2 border-border-strong"
                                        >
                                            <p
                                                class="font-bold font-sans text-base"
                                                data-placeholder
                                            >
                                                <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                                            </p>
                                            <p
                                                class="assembly-next__meta font-mono text-xs text-text-secondary"
                                                data-placeholder
                                            >
                                                {formatTimeRange(event.data.date, event.data.end)}
                                            </p>
                                            <h3 class="text-base">
                                                {event.data.title}
                                            </h3>
                                            <address class="assembly-next__meta font-mono not-italic text-xs text-text-secondary">
                                                {event.data.location}
                                            </address>
                                        </li>
                                    ))}
                                </ul>
                            </Fragment>
                        )}
                    </Fragment>
                )
            : (
                    <p
                        class="slab slab--cut slab--lift max-w-(--measure-form) w-full mb-6 mx-auto leading-relaxed text-text-secondary md:mb-0"
                        data-motion="rise"
                    >
                        Nothing on the calendar right now &mdash; the next date goes up as soon as
                        the room is booked.
                    </p>
                )}
        <p
            class="md:hidden"
            data-motion="rise"
        >
            <a
                class="action-text hover:text-link inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 transition-colors"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                target="_blank"
            >
                RSVP on Meetup <IconArrow />
            </a>
        </p>
    </div>
</section>

<style>
    .assembly-next__meta {
        text-align: right;
    }

    .assembly-next__row {
        gap: var(--space-xs) var(--space-md);
    }

    @media (max-width: 768px) {
        .assembly-next__meta {
            text-align: left;
        }

        .assembly-next__row {
            --rank-cols: minmax(0, 1fr);
            gap: var(--space-3xs);
        }
    }
</style>
