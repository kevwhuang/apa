---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/utils';

const program = getProgram('assembly');

const events = await getCollection('events');
const upcoming = events
    .filter(event => event.data.type === 'assembly' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);
---

<section
    class="stage stage--assembly stage--tight border-b-2 border-ink"
    aria-labelledby="assembly-next-title"
>
    <div class="mark">
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="assembly-next-title"
        >
            Next up
            <a
                class="action-text hover:text-accent-deep hidden items-center min-h-[50px] transition-colors md:inline-flex"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                slot="cta"
                target="_blank"
            >
                RSVP on Meetup &rarr;
            </a>
        </SectionHead>
        <hr
            class="border-0 border-t-2 border-ink"
            data-motion="rule"
        />
        {upcoming.length > 0
            ? (
                    <ul
                        class="list-none"
                        data-motion-stagger="rise"
                    >
                        {upcoming.map((event, index) => (
                            <li
                                id={event.id}
                                class="rank items-baseline py-4 border-b-2 border-ink"
                            >
                                <div>
                                    <p
                                        class:list={['label inline-block mb-2 px-2 py-0.5 bg-accent text-ink', index > 0 && 'invisible']}
                                        aria-hidden={index > 0 ? 'true' : undefined}
                                    >
                                        Next
                                    </p>
                                    <p
                                        class="font-bold font-sans text-lg"
                                        data-placeholder
                                    >
                                        <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                                    </p>
                                    <p
                                        class="font-mono text-xs uppercase text-ink-muted"
                                        data-placeholder
                                    >
                                        {formatTimeRange(event.data.date, event.data.end)}
                                    </p>
                                </div>
                                <h3 class="font-extrabold font-sans text-lg tracking-tight">
                                    {event.data.title}
                                </h3>
                                <p class="leading-relaxed text-sm text-ink-muted">
                                    {event.data.excerpt}
                                </p>
                                <address class="font-mono not-italic text-xs uppercase text-ink-muted md:text-right">
                                    {event.data.location}
                                </address>
                            </li>
                        ))}
                    </ul>
                )
            : (
                    <p
                        class="mt-6 text-ink-muted"
                        data-motion="rise"
                    >
                        Nothing on the calendar right now &mdash; the next date goes up as soon as
                        the room is booked.
                    </p>
                )}
        <p class="mt-6 md:hidden">
            <a
                class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] underline underline-offset-4 transition-colors"
                href={LINKS.meetup}
                rel="noopener noreferrer"
                target="_blank"
            >
                RSVP on Meetup &rarr;
            </a>
        </p>
    </div>
</section>

<style>
    @media (max-width: 768px) {
        .rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>
