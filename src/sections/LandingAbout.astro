---
import SectionHead from '@components/SectionHead.astro';
---

<section
    class="py-24 border-b-2 border-ink"
    aria-labelledby="about-title"
>
    <div class="shell">
        <div class="grid items-start gap-12 md:grid-cols-12">
            <div class="md:col-span-5">
                <SectionHead
                    class="font-extrabold font-sans leading-[1.05] text-5xl tracking-[-0.03em]"
                    eyebrow="About"
                    eyebrowClass="mb-4"
                    headingId="about-title"
                >
                    A working room, not a label.
                </SectionHead>
            </div>
            <div class="about__body reveal space-y-5 leading-relaxed text-[17px] md:col-span-7 md:pt-3">
                <p>
                    APA was started in <time datetime="2019">2019</time> by six producers who wanted a regular space to make
                    music together. It is now 142 members strong: hip-hop, footwork, ambient,
                    house, jazz, noise &mdash; anybody making sound in the city.
                </p>
                <p class="text-taupe">
                    We don't sign artists. We don't take a cut. We run the events, ship the
                    compilations, and split the store profit back across the room.
                </p>
                <a
                    class="action-text hover:text-coral-dark inline-flex items-center gap-2 transition-colors"
                    href="/about"
                >
                    Read the full story &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .about__body {
        transition-delay: 0.12s;
    }
</style>
