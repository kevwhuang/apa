---
import SectionHead from '@components/shared/SectionHead.astro';

const ACTIONS = [
    {
        blurb: 'Deletes every demo on the Assembly board, from every event, along with any uploaded audio.',
        board: 'assembly',
        confirmLabel: 'clear Assembly demos',
        confirmMany: 'Clear all {count} demo entries? This cannot be undone.',
        confirmOne: 'Clear the 1 demo entry? This cannot be undone.',
        id: 'assembly-entries',
        label: 'Clear Assembly demos',
        name: 'Assembly demos',
    },
    {
        blurb: 'Deletes every track on the Bash board, from every event, along with its uploaded audio.',
        board: 'bash',
        confirmLabel: 'clear Bash submissions',
        confirmMany: 'Clear all {count} submission entries and their uploads? This cannot be undone.',
        confirmOne: 'Clear the 1 submission entry and its upload? This cannot be undone.',
        id: 'bash-entries',
        label: 'Clear Bash submissions',
        name: 'Bash submissions',
    },
];

const SWITCHES = [
    {
        blurb: 'Controls whether check-in and the site accept new member signups.',
        id: 'signups',
        name: 'Signups',
        off: 'Closed',
        on: 'Open',
    },
    {
        blurb: 'Controls whether people at an event can check in with the code at the door.',
        id: 'check_in',
        name: 'Check-in',
        off: 'Closed',
        on: 'Open',
    },
    {
        blurb: 'Controls whether members can queue a demo for the next Assembly.',
        id: 'assembly_intake',
        name: 'Assembly intake',
        off: 'Closed',
        on: 'Open',
    },
    {
        blurb: 'Controls whether the submission form accepts new tracks for the current prompt.',
        id: 'bash_intake',
        name: 'Bash intake',
        off: 'Closed',
        on: 'Open',
    },
];
---

<section
    class="admin__stage stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="admin-switches-title"
>
    <h1 class="sr-only">
        Admin
    </h1>
    <div>
        <SectionHead
            class="text-2xl-3xl"
            headingId="admin-switches-title"
        >
            Switches
        </SectionHead>
        <ul
            class="flex flex-col gap-(--space-md) list-none"
            data-motion-stagger="rise"
        >
            {SWITCHES.map(control => (
                <li>
                    <div class="admin__row slab slab--card flex flex-wrap items-center gap-x-6 gap-y-4">
                        <div class="flex-1 min-w-50">
                            <h3
                                id={`${control.id}-title`}
                                class="mb-3 text-balance text-lg"
                            >
                                {control.name}
                            </h3>
                            <p class="max-w-xl text-base text-text-secondary">
                                {control.blurb}
                            </p>
                        </div>
                        <p class="label min-w-18 text-right select-none max-md:text-left">
                            <span class="admin__state-on">{control.on}</span>
                            <span class="admin__state-off">{control.off}</span>
                        </p>
                        <input
                            id={control.id}
                            class="admin__switch"
                            aria-labelledby={`${control.id}-title`}
                            autocomplete="off"
                            data-admin-off={`${control.name} closed.`}
                            data-admin-on={`${control.name} opened.`}
                            data-admin-switch={control.id}
                            disabled
                            role="switch"
                            type="checkbox"
                        />
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<section
    class="admin__stage stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="admin-actions-title"
>
    <div>
        <SectionHead
            class="text-2xl-3xl"
            headingId="admin-actions-title"
        >
            Actions
        </SectionHead>
        <ul
            class="grid grid-cols-2 -mb-(--space-2xl) gap-x-(--space-lg) list-none max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            {ACTIONS.map(action => (
                <li class="content-start grid grid-cols-1 grid-rows-subgrid row-span-4 gap-y-3 pb-(--space-2xl)">
                    <article class="slab slab--card content-start grid grid-cols-1 grid-rows-subgrid row-span-4 gap-y-3">
                        <div class="flex items-baseline justify-between gap-x-4">
                            <h3 class="min-w-0 text-lg">
                                {action.name}
                            </h3>
                            <p class="label shrink-0 text-text-secondary" data-admin-count={action.id} />
                        </div>
                        <p class="text-base text-text-secondary">
                            {action.blurb}
                        </p>
                        <button
                            class="btn"
                            autocomplete="off"
                            data-admin-action={action.id}
                            data-admin-board={action.board}
                            disabled
                            type="button"
                        >
                            {action.label}
                        </button>
                        <div
                            class="slab slab--sunk"
                            data-admin-confirm={action.id}
                            hidden
                        >
                            <p
                                class="mb-3 text-base"
                                data-admin-many={action.confirmMany}
                                data-admin-message={action.id}
                                data-admin-one={action.confirmOne}
                            />
                            <div class="flex flex-wrap gap-2">
                                <button
                                    class="btn btn--accent"
                                    aria-label={`Yes, ${action.confirmLabel}`}
                                    data-admin-commit={action.id}
                                    type="button"
                                >
                                    Yes
                                </button>
                                <button
                                    class="btn"
                                    data-admin-cancel={action.id}
                                    type="button"
                                >
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    html[data-theme='dark'] .admin__switch:active:not(:checked) {
        background-color: var(--color-bg-active);
    }

    .admin__row:has(.admin__switch:checked) .admin__state-off,
    .admin__row:has(.admin__switch:disabled) .admin__state-off {
        display: none;
    }

    .admin__row:not(:has(.admin__switch:checked)) .admin__state-on {
        display: none;
    }

    .admin__stage {
        display: var(--admin-only, grid);
    }

    .admin__switch {
        appearance: none;
        background-color: var(--color-bg-sunken);
        background-image: linear-gradient(var(--color-bg-inverse), var(--color-bg-inverse));
        background-position: 4px center;
        background-repeat: no-repeat;
        background-size: 36px 36px;
        border: 2px solid var(--color-control-border);
        cursor: pointer;
        flex-shrink: 0;
        height: var(--control-size);
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            background-position var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            opacity var(--duration-fast) var(--motion-ease-ui);
        width: 80px;
    }

    .admin__switch:active {
        background-color: var(--color-bg-page);
    }

    .admin__switch:checked {
        background-color: var(--color-control-checked-bg);
        background-position: calc(100% - 4px) center;
    }

    .admin__switch:disabled {
        visibility: hidden;
    }

    .admin__switch:hover {
        border-color: var(--color-border-strong);
    }

    .admin__switch[aria-busy='true'] {
        opacity: 0.6;
    }
</style>

<script>
    import { LOAD_FAILED_MESSAGE } from '@lib/shared/constants';
    import { applyInstantly, registerPageScript, setText } from '@lib/shared/utils';
    import { clearSubmissions, countSubmissions, onBoardChange, removeOrphans, watchBoard } from '@lib/programs/submissions';
    import { getSession } from '@lib/account/session';
    import { guardRoute } from '@lib/account/guard';
    import { isSiteSwitch, isSwitchClosed, isSwitchOpen, loadSwitches, onSwitchChange, setSwitchOpen } from '@lib/programs/switches';
    import { syncEvents } from '@lib/account/checkin';
    import { toast } from '@lib/ui/toasts';

    const pending = new Set<string>();

    let isCounting = false;
    let isRecountQueued = false;

    function closeConfirm(id: string, shouldFocusTrigger: boolean) {
        const panel = document.querySelector<HTMLElement>(`[data-admin-confirm="${id}"]`);
        const trigger = document.querySelector<HTMLButtonElement>(`[data-admin-action="${id}"]`);

        panel?.setAttribute('hidden', '');

        if (shouldFocusTrigger) trigger?.focus();
    }

    function describeEntries(count: number) {
        return count === 1 ? '1 entry' : `${count} entries`;
    }

    function handleActionClick(button: HTMLButtonElement) {
        const panel = document.querySelector<HTMLElement>(`[data-admin-confirm="${button.dataset.adminAction}"]`);

        panel?.removeAttribute('hidden');
        panel?.querySelector<HTMLButtonElement>('[data-admin-commit]')?.focus();
    }

    async function handleToggleChange(input: HTMLInputElement) {
        const id = input.dataset.adminSwitch ?? '';

        if (!isSiteSwitch(id) || pending.has(id)) return;

        let isOpen = input.checked;

        pending.add(id);
        input.setAttribute('aria-busy', 'true');

        let result = await setSwitchOpen(id, isOpen);

        while (input.checked !== isOpen && result.ok) {
            isOpen = input.checked;

            result = await setSwitchOpen(id, isOpen);
        }

        pending.delete(id);
        input.removeAttribute('aria-busy');
        syncToggles();

        if (result.ok) toast((isOpen ? input.dataset.adminOn : input.dataset.adminOff) ?? '', 'success');
        else toast(result.message, 'error');
    }

    function initAdminConsole(signal: AbortSignal) {
        const toggles = document.querySelectorAll<HTMLInputElement>('[data-admin-switch]');

        if (toggles.length === 0) return;

        void guardRoute('admin', signal);

        if (!getSession()?.admin) return;

        syncToggles();

        toggles.forEach((input) => {
            input.addEventListener('change', () => void handleToggleChange(input), { signal });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-admin-action]').forEach((button) => {
            button.addEventListener('click', () => handleActionClick(button), { signal });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-admin-cancel]').forEach((button) => {
            button.addEventListener('click', () => closeConfirm(button.dataset.adminCancel ?? '', true), { signal });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-admin-commit]').forEach((button) => {
            button.addEventListener('click', () => void runAction(button), { signal });
        });

        void loadSwitchStates();
        void refreshCounts();
        signal.addEventListener('abort', onBoardChange(() => void refreshCounts()), { once: true });
        signal.addEventListener('abort', onSwitchChange(syncToggles), { once: true });
        watchBoard('assembly');
        watchBoard('bash');
        void removeOrphans();
        void syncEvents();
    }

    async function loadSwitchStates() {
        const isLoaded = await loadSwitches();

        if (!isLoaded) toast(LOAD_FAILED_MESSAGE, 'error');
    }

    function readBoard(id: string) {
        const board = document.querySelector<HTMLButtonElement>(`[data-admin-action="${id}"]`)?.dataset.adminBoard;

        return board === 'assembly' || board === 'bash' ? board : null;
    }

    async function refreshCount(trigger: HTMLButtonElement) {
        const id = trigger.dataset.adminAction ?? '';

        const board = readBoard(id);
        const label = document.querySelector<HTMLElement>(`[data-admin-count="${id}"]`);
        const message = document.querySelector<HTMLElement>(`[data-admin-message="${id}"]`);

        if (!board || !message) return true;

        const count = await countSubmissions(board);

        if (count === null) return false;

        const template = (count === 1 ? message.dataset.adminOne : message.dataset.adminMany) ?? '';

        setText(label, describeEntries(count));
        setText(message, template.replace('{count}', String(count)));
        trigger.disabled = count === 0;

        if (count === 0) closeConfirm(id, false);

        return true;
    }

    async function refreshCounts() {
        if (isCounting) {
            isRecountQueued = true;

            return;
        }

        isCounting = true;

        let isLoaded: boolean;

        do {
            isRecountQueued = false;

            const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-admin-board]'));

            const results = await Promise.all(triggers.map(trigger => refreshCount(trigger)));

            isLoaded = results.every(Boolean);
        } while (isRecountQueued);

        isCounting = false;

        if (!isLoaded) toast(LOAD_FAILED_MESSAGE, 'error');
    }

    async function runAction(commit: HTMLButtonElement) {
        const id = commit.dataset.adminCommit ?? '';

        const board = readBoard(id);

        if (!board || pending.has(id)) return;

        commit.setAttribute('aria-busy', 'true');
        pending.add(id);

        const result = await clearSubmissions(board);

        commit.removeAttribute('aria-busy');
        pending.delete(id);
        closeConfirm(id, true);

        if (result.ok) toast(`Cleared ${describeEntries(result.cleared)}.`, 'success');
        else toast(result.message, 'error');

        void refreshCounts();
    }

    function syncToggles() {
        document.querySelectorAll<HTMLInputElement>('[data-admin-switch]').forEach((input) => {
            const id = input.dataset.adminSwitch ?? '';

            if (!isSiteSwitch(id) || pending.has(id)) return;

            const isOpen = isSwitchOpen(id);

            if (!isOpen && !isSwitchClosed(id)) return;
            if (!input.disabled && input.checked === isOpen) return;

            applyInstantly(input, () => {
                input.checked = isOpen;
                input.disabled = false;
            });
        });
    }

    registerPageScript(initAdminConsole);
</script>
