---
import IconClose from '@components/icons/Close.astro';
import SearchField from '@components/shared/SearchField.astro';
import SectionHead from '@components/shared/SectionHead.astro';

const CLASS_MEMBER_ROW = 'active:translate-y-px hover:bg-bg-hover grid min-h-(--control-size) w-full gap-1 px-(--space-md) py-4 text-left wrap-anywhere transition-[translate]';
---

<section
    class="prods__stage stage stage--tight"
    aria-labelledby="admin-prods-title"
>
    <div>
        <SectionHead
            class="text-2xl-3xl"
            headingId="admin-prods-title"
        >
            Prods management
        </SectionHead>
        <div data-motion="rise">
            <div class="flex items-center justify-between gap-x-6 gap-y-3 mb-4 max-md:flex-col max-md:items-stretch">
                <SearchField
                    class="grow"
                    label="Find a member"
                    placeholder={'Search members\u2026'}
                />
                <p class="label text-text-secondary" aria-live="polite" data-prods-count />
            </div>
            <ul class="prods__members scroll-slot border-2 border-border-strong divide-border-strong divide-y list-none">
                <li
                    class="hidden"
                    data-prods-none
                >
                    <p class="slab slab--empty slab--sunk text-base text-text-secondary">No members match that search.</p>
                </li>
            </ul>
            <template data-member-row>
                <li>
                    <button
                        class={CLASS_MEMBER_ROW}
                        aria-controls="prods-modal"
                        aria-haspopup="dialog"
                        data-member-id
                        type="button"
                    >
                        <span
                            class="font-bold leading-(--text-xl) text-lg tracking-tight"
                            data-member-label="name"
                        />
                        <span
                            class="font-mono text-base text-text-secondary"
                            data-member-label="email"
                        />
                    </button>
                </li>
            </template>
        </div>
        <dialog
            id="prods-modal"
            class="prods__modal"
            aria-labelledby="prods-modal-title"
            data-prods-modal
        >
            <div class="flex items-start justify-between gap-4 p-(--space-md) border-b-2 border-border-strong">
                <div class="flex flex-col min-w-0 gap-2 wrap-anywhere">
                    <h3
                        id="prods-modal-title"
                        class="text-2xl text-balance"
                        data-prods-member
                    >
                        Member ledger
                    </h3>
                    <p
                        class="font-mono text-base text-text-secondary"
                        data-prods-email
                    />
                </div>
                <button
                    class="prods__close [&_line]:[vector-effect:non-scaling-stroke] [&_svg]:size-7"
                    data-prods-close
                    type="button"
                >
                    <IconClose />
                    <span class="sr-only">Close member ledger</span>
                </button>
            </div>
            <div class="flex flex-col overflow-y-auto overscroll-contain [scrollbar-gutter:stable] gap-(--space-lg) p-(--space-md)">
                <dl class="grid grid-cols-2 gap-px border-2 border-border-strong bg-border-strong max-md:grid-cols-1">
                    <div class="p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Balance</dt>
                        <dd
                            class="font-bold text-xl"
                            data-prods-balance
                        />
                    </div>
                    <div class="p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Member since</dt>
                        <dd class="font-bold text-xl">
                            <time data-prods-since />
                        </dd>
                    </div>
                </dl>
                <div class="flex flex-col gap-2">
                    <p class="label text-text-secondary">Ledger</p>
                    <div class="prods__scroller scroll-slot overflow-x-auto border-2 border-border-strong">
                        <table class="prods__table">
                            <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                            <thead>
                                <tr class="label text-text-secondary">
                                    <th
                                        class="px-4 py-3 text-left whitespace-nowrap max-md:hidden"
                                        scope="col"
                                    >
                                        Date
                                    </th>
                                    <th
                                        class="w-full px-4 py-3 text-left whitespace-nowrap max-md:px-2"
                                        scope="col"
                                    >
                                        Reason
                                    </th>
                                    <th
                                        class="px-4 py-3 text-right whitespace-nowrap max-md:hidden"
                                        scope="col"
                                    >
                                        Change
                                    </th>
                                    <th
                                        class="px-4 py-3 text-right whitespace-nowrap max-md:px-2"
                                        scope="col"
                                    >
                                        Balance
                                    </th>
                                </tr>
                            </thead>
                            <tbody
                                class="divide-border-strong divide-y"
                                data-prods-ledger
                            />
                        </table>
                    </div>
                </div>
                <template data-prods-row>
                    <tr>
                        <td class="px-4 py-4 font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                        <td class="px-4 py-4 text-base wrap-anywhere max-md:px-2">
                            <div class="grid gap-1">
                                <span data-cell="reason" />
                                <time
                                    class="hidden font-mono whitespace-nowrap text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </td>
                        <td
                            class="px-4 py-4 font-mono text-base text-right whitespace-nowrap max-md:hidden"
                            data-cell="change"
                        />
                        <td class="px-4 py-4 font-mono text-base text-right whitespace-nowrap max-md:px-2">
                            <div class="grid gap-1">
                                <span data-cell="balance" />
                                <span
                                    class="hidden max-md:block"
                                    data-cell="change"
                                />
                            </div>
                        </td>
                    </tr>
                </template>
                <form
                    class="flex flex-col gap-(--space-lg)"
                    aria-label="Adjust balance"
                    data-prods-form
                >
                    <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                        <div class="flex flex-col gap-2">
                            <label class="flex flex-col gap-2">
                                <span class="label text-text-secondary">Amount</span>
                                <input
                                    class="input font-mono"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    max="100"
                                    min="-100"
                                    name="amount"
                                    required
                                    step="1"
                                    type="number"
                                />
                            </label>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="flex flex-col gap-2">
                                <span class="label text-text-secondary">Reason</span>
                                <input
                                    class="input"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    maxlength="80"
                                    name="reason"
                                    required
                                    type="text"
                                />
                            </label>
                        </div>
                    </div>
                    <button
                        class="btn btn--primary self-start max-md:self-stretch"
                        data-prods-apply
                        type="submit"
                    >
                        Apply adjustment
                    </button>
                </form>
            </div>
        </dialog>
    </div>
</section>

<style>
    .input[type='number'] {
        appearance: textfield;
    }

    .input[type='number']::-webkit-inner-spin-button,
    .input[type='number']::-webkit-outer-spin-button {
        appearance: none;
    }

    .prods__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .prods__close:active {
        transform: translateY(1px);
    }

    .prods__close:hover {
        color: var(--color-link);
    }

    .prods__members {
        --scroll-slot-max: calc(2 * 2px + 5 * (2 * 16px + 4px + var(--text-xl) + var(--text-base--line-height) + 1px));
    }

    .prods__modal {
        background-color: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        color: var(--color-text);
        inset: 50% auto auto 50%;
        max-height: calc(100dvh - 2 * var(--space-md));
        max-width: none;
        overflow: visible;
        padding: 0;
        position: fixed;
        translate: -50% -50%;
        width: min(var(--measure-form), calc(100vw - 2 * var(--space-md)));
    }

    .prods__modal::before {
        content: '';
        cursor: zoom-out;
        inset: -100vmax;
        position: absolute;
        z-index: -1;
    }

    .prods__modal[open] {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .prods__scroller {
        --scroll-slot-max: calc(2 * 2px + 2 * 12px + var(--text-sm) + 5 * (2 * 16px + var(--text-base--line-height) + 1px));
        overscroll-behavior: auto;
    }

    .prods__stage {
        display: var(--admin-only, grid);
    }

    .prods__table thead th {
        background-color: var(--color-bg-raised);
        box-shadow: inset 0 -2px 0 var(--color-border-strong);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 768px) {
        .prods__scroller {
            --scroll-slot-max: calc(2 * 2px + 2 * 12px + var(--text-sm) + 5 * (2 * 16px + 2 * var(--text-base--line-height) + 4px + 1px));
        }
    }
</style>

<script>
    import { LOAD_FAILED_MESSAGE, PRODS_NEGATIVE_MESSAGE } from '@lib/shared/constants';
    import { adjustProds, loadLedger, loadMembers } from '@lib/account/prods';
    import { clearFieldErrors, reportFieldErrors, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { fitRowWindow, observeRowWindow } from '@lib/account/ledger';
    import { formatDateStamp, formatProds, initSearchField, isOutsideBox, registerPageScript, setPending, setText } from '@lib/shared/utils';
    import { getSession } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const AMOUNT_LIMIT = 100;
    const REASON_MAX = 80;

    const RULES: Record<string, FieldRule> = {
        amount: { message: 'Enter a whole number, \u2212100 to 100, not zero.', required: true, validate: isAdjustment },
        reason: { max: REASON_MAX, message: 'Give the ledger a reason for this change.', required: true },
    };

    let balance: null | number = null;
    let isBackdropPress = false;
    let isPending = false;
    let ledgerLoads = 0;
    let members: ProdsMember[] = [];
    let selected: ProdsMember | null = null;
    let trigger: HTMLButtonElement | null = null;

    async function handleAdjustSubmit(event: SubmitEvent, form: HTMLFormElement, dialog: HTMLDialogElement) {
        event.preventDefault();

        if (!selected || isPending) return;

        const errors = validateAdjustment(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const member = selected;
        const submit = form.querySelector<HTMLButtonElement>('[data-prods-apply]');
        const values = new FormData(form);

        const amount = Number(String(values.get('amount') ?? '').trim());
        const reason = String(values.get('reason') ?? '').trim();

        const size = Math.abs(amount);

        isPending = true;
        setPending(submit, true);

        const result = await adjustProds(member.id, amount, reason);

        isPending = false;
        setPending(submit, false);

        const isOpen = selected === member;

        if (!result.ok && isOpen && result.code === 'negative') {
            reportFieldErrors(form, { amount: PRODS_NEGATIVE_MESSAGE });
            void loadDetail(member, dialog);

            return;
        }

        if (!result.ok) {
            if (isOpen) submit?.focus();

            toast(result.message, 'error');

            return;
        }

        if (isOpen) {
            balance = result.prods;
            clearFieldErrors(form);
            form.reset();
            setText(dialog.querySelector('[data-prods-balance]'), String(result.prods));
            submit?.focus();
            void loadDetail(member, dialog);
        }

        toast(`${amount < 0 ? 'Removed' : 'Added'} ${formatProds(size)} ${amount < 0 ? 'from' : 'to'} ${member.artistName}.`, 'success');
    }

    function handleFieldInput(form: HTMLFormElement) {
        const invalidNames = Array.from(form.querySelectorAll<HTMLInputElement>('[aria-invalid="true"]'), input => input.name);

        if (invalidNames.length === 0) return;

        const remaining = Object.fromEntries(Object.entries(validateAdjustment(form)).filter(([name]) => invalidNames.includes(name)));

        if (Object.keys(remaining).length === invalidNames.length) return;

        clearFieldErrors(form);
        setFieldErrors(form, remaining);
    }

    function handleMemberClick(event: MouseEvent, dialog: HTMLDialogElement, form: HTMLFormElement) {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-member-id]') : null;

        if (button) openModal(button, dialog, form);
    }

    function handleModalClick(event: MouseEvent, dialog: HTMLDialogElement) {
        if (event.detail <= 1 && isBackdropPress && isOutsideBox(event, dialog)) dialog.close();

        isBackdropPress = false;
    }

    function handleModalClose() {
        const previous = trigger;

        balance = null;
        selected = null;
        trigger = null;
        document.documentElement.style.overflow = '';
        previous?.focus();
    }

    function handleModalTab(event: KeyboardEvent, dialog: HTMLDialogElement) {
        if (!dialog.open || event.key !== 'Tab') return;

        const first = dialog.querySelector<HTMLButtonElement>('[data-prods-close]');
        const last = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-prods-apply], [data-toast-close]')).at(-1);

        if (document.activeElement !== (event.shiftKey ? first : last)) return;

        event.preventDefault();
        (event.shiftKey ? last : first)?.focus();
    }

    function handleSearch(input: HTMLInputElement) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-member-id]');
        const count = document.querySelector<HTMLElement>('[data-prods-count]');
        const none = document.querySelector<HTMLElement>('[data-prods-none]');
        const query = input.value.trim().toLowerCase();

        const isSingle = buttons.length === 1;

        const noun = isSingle ? 'member' : 'members';
        const verb = isSingle ? 'matches' : 'match';

        let shown = 0;

        buttons.forEach((button) => {
            const haystack = `${button.dataset.memberName} ${button.dataset.memberEmail}`.toLowerCase();

            const isMatch = haystack.includes(query) || query.length === 0;

            button.closest('li')?.classList.toggle('hidden', !isMatch);

            if (isMatch) shown++;
        });

        none?.classList.toggle('hidden', query.length === 0 || shown > 0);
        setText(count, query.length === 0 ? `${buttons.length} ${noun}` : `${shown} of ${buttons.length} ${noun} ${verb}`);
    }

    function initAdminProds(signal: AbortSignal) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-prods-modal]');
        const form = document.querySelector<HTMLFormElement>('[data-prods-form]');
        const list = document.querySelector<HTMLElement>('.prods__members');
        const scroller = document.querySelector<HTMLElement>('.prods__scroller');
        const search = document.querySelector<HTMLInputElement>('[data-search-input]');

        if (!dialog || !form || !list || !scroller || !search) return;
        if (!getSession()?.admin) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        balance = null;
        isBackdropPress = false;
        isPending = false;
        members = [];
        selected = null;
        trigger = null;
        form.noValidate = true;
        dialog.addEventListener('click', event => handleModalClick(event, dialog), { signal });
        dialog.addEventListener('close', handleModalClose, { signal });
        dialog.addEventListener('keydown', event => handleModalTab(event, dialog), { signal });

        dialog.addEventListener('pointerdown', (event) => {
            isBackdropPress = isOutsideBox(event, dialog);
        }, { signal });

        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.addEventListener('click', () => dialog.close(), { signal });
        form.addEventListener('input', () => handleFieldInput(form), { signal });
        form.addEventListener('submit', event => void handleAdjustSubmit(event, form, dialog), { signal });
        list.addEventListener('click', event => handleMemberClick(event, dialog, form), { signal });
        search.addEventListener('input', () => handleSearch(search), { signal });
        signal.addEventListener('abort', () => teardown(dialog), { once: true });
        observeRowWindow(scroller, signal);

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement: search,
            signal,
        });

        void loadRoster(list, search, signal);
    }

    function isAdjustment(value: string) {
        const amount = Number(value);

        return Math.abs(amount) <= AMOUNT_LIMIT && Number.isInteger(amount) && amount !== 0;
    }

    async function loadDetail(member: ProdsMember, dialog: HTMLDialogElement) {
        ledgerLoads++;

        const load = ledgerLoads;

        const rows = await loadLedger(member.id);

        if (load !== ledgerLoads || selected !== member) return;

        if (rows) renderDetail(rows, dialog);
        else toast(LOAD_FAILED_MESSAGE, 'error');
    }

    async function loadRoster(list: HTMLElement, search: HTMLInputElement, signal: AbortSignal) {
        const roster = await loadMembers();

        if (signal.aborted) return;

        if (!roster) {
            toast(LOAD_FAILED_MESSAGE, 'error');

            return;
        }

        members = roster;
        renderMembers(list);
        handleSearch(search);
    }

    function openModal(button: HTMLButtonElement, dialog: HTMLDialogElement, form: HTMLFormElement) {
        const member = members.find(entry => entry.id === button.dataset.memberId);

        if (!member) return;

        balance = null;
        selected = member;
        trigger = button;
        clearFieldErrors(form);
        form.reset();
        dialog.querySelector('[data-prods-ledger]')?.replaceChildren();
        setText(dialog.querySelector('[data-prods-balance]'), '');
        setText(dialog.querySelector('[data-prods-email]'), member.email);
        setText(dialog.querySelector('[data-prods-member]'), member.artistName);
        dialog.querySelector('[data-prods-since]')?.setAttribute('datetime', member.joined);
        setText(dialog.querySelector('[data-prods-since]'), formatDateStamp(new Date(member.joined)));
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.focus();
        void loadDetail(member, dialog);
    }

    function renderDetail(rows: ProdsRow[], dialog: HTMLDialogElement) {
        const body = dialog.querySelector<HTMLElement>('[data-prods-ledger]');
        const scroller = dialog.querySelector<HTMLElement>('.prods__scroller');
        const template = dialog.querySelector<HTMLTemplateElement>('[data-prods-row]');

        if (!body || !scroller || !template) return;

        balance = rows.at(0)?.total ?? 0;
        body.replaceChildren();

        rows.forEach((row) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const reason = fragment.querySelector<HTMLElement>('[data-cell="reason"]');

            fragment.querySelectorAll<HTMLElement>('[data-cell="change"]').forEach((change) => {
                change.classList.toggle('text-error-text', row.amount < 0);
                setText(change, row.amount > 0 ? `+${row.amount}` : `\u2212${Math.abs(row.amount)}`);
            });

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', row.date);
                setText(date, formatDateStamp(new Date(row.date)));
            });

            setText(reason, row.reason);
            setText(fragment.querySelector<HTMLElement>('[data-cell="balance"]'), String(row.total));
            body.append(fragment);
        });

        setText(dialog.querySelector('[data-prods-balance]'), String(balance));
        fitRowWindow(scroller);
    }

    function renderMembers(list: HTMLElement) {
        const none = list.querySelector('[data-prods-none]');
        const template = document.querySelector<HTMLTemplateElement>('[data-member-row]');

        if (!none || !template) return;

        list.querySelectorAll('[data-member-id]').forEach(button => button.closest('li')?.remove());

        members.forEach((member) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const button = fragment.querySelector<HTMLButtonElement>('[data-member-id]');

            if (!button) return;

            button.dataset.memberEmail = member.email;
            button.dataset.memberId = member.id;
            button.dataset.memberName = member.artistName;
            setText(fragment.querySelector('[data-member-label="email"]'), member.email);
            setText(fragment.querySelector('[data-member-label="name"]'), member.artistName);
            none.before(fragment);
        });
    }

    function teardown(dialog: HTMLDialogElement) {
        document.documentElement.style.overflow = '';
        dialog.close();
    }

    function validateAdjustment(form: HTMLFormElement) {
        const errors = validateFields(form, RULES);
        const amount = Number(String(new FormData(form).get('amount') ?? '').trim());

        if (!errors.amount && balance !== null && balance + amount < 0) errors.amount = PRODS_NEGATIVE_MESSAGE;

        return errors;
    }

    registerPageScript(initAdminProds);
</script>
