---
import IconClose from '@components/icons/Close.astro';
import SearchField from '@components/shared/SearchField.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { PRODS_MEMBERS as MEMBERS } from '@lib/account/prods';
import { formatDateStamp } from '@lib/shared/utils';
---

<section
    class="stage stage--tight"
    aria-labelledby="admin-prods-title"
>
    <div>
        <SectionHead
            class="text-3xl max-md:text-2xl"
            headingId="admin-prods-title"
        >
            Prods management
        </SectionHead>
        <div data-motion="rise">
            <div class="flex items-center justify-between gap-x-6 gap-y-3 mb-4 max-md:flex-col max-md:items-stretch">
                <SearchField
                    class="grow"
                    label="Find a member"
                    placeholder={'Search members\u2026'}
                />
                <p
                    class="label text-text-secondary"
                    aria-live="polite"
                    data-prods-count
                >
                    {MEMBERS.length} members
                </p>
            </div>
            <ul class="prods__members scroll-slot border-2 border-border-strong divide-border-strong divide-y list-none">
                {MEMBERS.map(member => (
                    <li>
                        <button
                            class="active:translate-y-px hover:bg-bg-hover grid min-h-(--control-size) w-full gap-(--space-3xs) px-(--space-md) py-(--space-sm) text-left wrap-anywhere transition-[translate]"
                            aria-controls="prods-modal"
                            aria-haspopup="dialog"
                            data-member-email={member.email}
                            data-member-joined={formatDateStamp(new Date(member.joined))}
                            data-member-name={member.artistName}
                            type="button"
                        >
                            <span class="font-bold font-sans leading-(--text-xl) text-lg tracking-tight">{member.artistName}</span>
                            <span class="font-mono text-base text-text-secondary">{member.email}</span>
                        </button>
                    </li>
                ))}
                <li
                    class="hidden"
                    data-prods-none
                >
                    <p class="slab slab--empty slab--sunk text-base text-text-secondary">No members match that search.</p>
                </li>
            </ul>
        </div>
        <dialog
            id="prods-modal"
            class="prods__modal"
            aria-labelledby="prods-modal-title"
            data-prods-modal
        >
            <div class="flex items-start justify-between gap-(--space-sm) p-(--space-md) border-b-2 border-border-strong">
                <div class="flex flex-col min-w-0 gap-(--space-2xs) wrap-anywhere">
                    <h3
                        id="prods-modal-title"
                        class="text-2xl text-balance"
                        data-prods-member
                    >
                        Member ledger
                    </h3>
                    <p
                        class="font-mono text-base text-text-secondary"
                        data-prods-email
                    />
                </div>
                <button
                    class="prods__close [&_line]:[vector-effect:non-scaling-stroke] [&_svg]:size-7"
                    data-prods-close
                    type="button"
                >
                    <IconClose />
                    <span class="sr-only">Close member ledger</span>
                </button>
            </div>
            <div class="flex flex-col overflow-y-auto overscroll-contain [scrollbar-gutter:stable] gap-(--space-lg) p-(--space-md)">
                <dl class="grid grid-cols-2 gap-px border-2 border-border-strong bg-border-strong max-md:grid-cols-1">
                    <div class="p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Balance</dt>
                        <dd
                            class="font-bold font-sans text-xl"
                            data-prods-balance
                        />
                    </div>
                    <div class="p-(--space-md) bg-bg-raised">
                        <dt class="label mb-2 text-text-secondary">Member since</dt>
                        <dd
                            class="font-bold font-sans text-xl"
                            data-prods-since
                        />
                    </div>
                </dl>
                <div class="flex flex-col gap-(--space-2xs)">
                    <p class="label text-text-secondary">Ledger</p>
                    <div class="prods__scroller scroll-slot overflow-x-auto border-2 border-border-strong">
                        <table class="prods__table">
                            <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                            <thead>
                                <tr class="label text-text-secondary">
                                    <th
                                        class="px-(--space-sm) py-(--space-xs) text-left whitespace-nowrap max-md:hidden"
                                        scope="col"
                                    >
                                        Date
                                    </th>
                                    <th
                                        class="w-full px-(--space-sm) py-(--space-xs) text-left whitespace-nowrap max-md:px-(--space-2xs)"
                                        scope="col"
                                    >
                                        Reason
                                    </th>
                                    <th
                                        class="px-(--space-sm) py-(--space-xs) text-right whitespace-nowrap max-md:hidden"
                                        scope="col"
                                    >
                                        Change
                                    </th>
                                    <th
                                        class="px-(--space-sm) py-(--space-xs) text-right whitespace-nowrap max-md:px-(--space-2xs)"
                                        scope="col"
                                    >
                                        Balance
                                    </th>
                                </tr>
                            </thead>
                            <tbody
                                class="divide-border-strong divide-y"
                                data-prods-ledger
                            />
                        </table>
                    </div>
                </div>
                <template data-prods-row>
                    <tr>
                        <td class="px-(--space-sm) py-(--space-sm) font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">
                            <time data-cell="date" />
                        </td>
                        <td class="px-(--space-sm) py-(--space-sm) text-base wrap-anywhere max-md:px-(--space-2xs)">
                            <div class="grid gap-(--space-3xs)">
                                <span data-cell="reason" />
                                <time
                                    class="hidden font-mono whitespace-nowrap text-text-secondary max-md:block"
                                    data-cell="date"
                                />
                            </div>
                        </td>
                        <td
                            class="px-(--space-sm) py-(--space-sm) font-mono text-base text-right whitespace-nowrap max-md:hidden"
                            data-cell="change"
                        />
                        <td class="px-(--space-sm) py-(--space-sm) font-mono text-base text-right whitespace-nowrap max-md:px-(--space-2xs)">
                            <div class="grid gap-(--space-3xs)">
                                <span data-cell="balance" />
                                <span
                                    class="hidden max-md:block"
                                    data-cell="change"
                                />
                            </div>
                        </td>
                    </tr>
                </template>
                <form
                    class="flex flex-col gap-(--space-lg)"
                    aria-label="Adjust balance"
                    data-prods-form
                >
                    <div class="grid grid-cols-2 gap-(--space-lg) max-md:grid-cols-1">
                        <div class="flex flex-col gap-(--space-2xs)">
                            <label class="flex flex-col gap-(--space-2xs)">
                                <span class="label text-text-secondary">Amount</span>
                                <input
                                    class="input aria-invalid:shadow-none font-mono"
                                    aria-describedby="prods-amount-error"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    max="100"
                                    min="-100"
                                    name="amount"
                                    required
                                    step="1"
                                    type="number"
                                />
                            </label>
                            <p
                                id="prods-amount-error"
                                class="text-error-text"
                                data-field-error
                                hidden
                            />
                        </div>
                        <div class="flex flex-col gap-(--space-2xs)">
                            <label class="flex flex-col gap-(--space-2xs)">
                                <span class="label text-text-secondary">Reason</span>
                                <input
                                    class="input aria-invalid:shadow-none font-sans"
                                    aria-describedby="prods-reason-error"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    maxlength="80"
                                    name="reason"
                                    required
                                    type="text"
                                />
                            </label>
                            <p
                                id="prods-reason-error"
                                class="text-error-text"
                                data-field-error
                                hidden
                            />
                        </div>
                    </div>
                    <button
                        class="btn btn--primary self-start max-md:self-stretch"
                        data-prods-apply
                        type="submit"
                    >
                        Apply adjustment
                    </button>
                </form>
            </div>
        </dialog>
    </div>
</section>

<style>
    .prods__close {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .prods__close:active {
        transform: translateY(1px);
    }

    .prods__close:hover {
        color: var(--color-link);
    }

    .prods__members {
        --scroll-slot-max: calc(2 * 2px + 5 * (2 * var(--space-sm) + var(--space-3xs) + var(--text-xl) + var(--text-base--line-height) + 1px));
    }

    .prods__modal {
        background-color: var(--color-bg-raised);
        border: 2px solid var(--color-border-strong);
        color: var(--color-text);
        inset: 50% auto auto 50%;
        max-height: calc(100dvh - 2 * var(--space-md));
        max-width: none;
        overflow: visible;
        padding: 0;
        position: fixed;
        translate: -50% -50%;
        width: min(var(--measure-form), calc(100vw - 2 * var(--space-md)));
    }

    .prods__modal[open] {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .prods__modal::before {
        content: '';
        cursor: zoom-out;
        inset: -100vmax;
        position: absolute;
        z-index: -1;
    }

    .prods__scroller {
        --scroll-slot-max: calc(2 * 2px + 2 * var(--space-xs) + var(--text-sm) + 5 * (2 * var(--space-sm) + var(--text-base--line-height) + 1px));
        overscroll-behavior: auto;
    }

    .prods__table {
        display: table;
        overflow-x: visible;
        width: 100%;
    }

    .prods__table thead th {
        background-color: var(--color-bg-raised);
        box-shadow: inset 0 -2px 0 var(--color-border-strong);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 768px) {
        .prods__scroller {
            --scroll-slot-max: calc(2 * 2px + 2 * var(--space-xs) + var(--text-sm) + 5 * (2 * var(--space-sm) + 2 * var(--text-base--line-height) + var(--space-3xs) + 1px));
        }
    }
</style>

<script>
    import { MOCK_LATENCY_MILLISECONDS } from '@lib/shared/constants';
    import { addProdsEntry, getProdsBalance, getProdsRows } from '@lib/account/prods';
    import { clearFieldErrors, focusFirstError, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { delay, formatDateStamp, formatProds, initSearchField, isOutsideBox, registerPageScript, setPending, setText } from '@lib/shared/utils';
    import { fitRowWindow, observeRowWindow } from '@lib/account/ledger';
    import { toast } from '@lib/ui/toasts';

    const AMOUNT_LIMIT = 100;
    const NEGATIVE_MESSAGE = 'This would take the balance below zero.';
    const REASON_MAX = 80;
    const STORAGE_MESSAGE = 'Nothing was saved because your browser storage is full. Clear some space and try again.';

    const RULES: Record<string, FieldRule> = {
        amount: { message: 'Enter a whole number, \u2212100 to 100, not zero.', required: true, validate: isAdjustment },
        reason: { max: REASON_MAX, message: 'Give the ledger a reason for this change.', required: true },
    };

    let isBackdropPress = false;
    let isPending = false;
    let selectedEmail = '';
    let trigger: HTMLButtonElement | null = null;

    async function handleAdjustSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (!selectedEmail || isPending) return;

        const errors = validateAdjustment(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const memberEmail = selectedEmail;
        const name = document.querySelector<HTMLButtonElement>(`[data-member-email="${selectedEmail}"]`)?.dataset.memberName ?? '';
        const submit = form.querySelector<HTMLButtonElement>('[data-prods-apply]');
        const values = new FormData(form);

        const amount = Number(String(values.get('amount') ?? '').trim());
        const reason = String(values.get('reason') ?? '').trim();

        const size = Math.abs(amount);

        isPending = true;
        setPending(submit, true);

        await delay(MOCK_LATENCY_MILLISECONDS);

        const isSaved = addProdsEntry(memberEmail, {
            amount,
            date: new Date().toISOString(),
            reason,
        });

        setPending(submit, false);
        isPending = false;

        if (!isSaved) {
            submit?.focus();
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        clearFieldErrors(form);
        form.reset();

        if (selectedEmail === memberEmail) renderDetail();

        submit?.focus();
        toast(`${amount < 0 ? 'Removed' : 'Added'} ${formatProds(size)} ${amount < 0 ? 'from' : 'to'} ${name}.`, 'success');
    }

    function handleFieldInput(form: HTMLFormElement) {
        const invalidNames = Array.from(form.querySelectorAll<HTMLInputElement>('[aria-invalid="true"]'), input => input.name);

        if (invalidNames.length === 0) return;

        const remaining = Object.fromEntries(Object.entries(validateAdjustment(form)).filter(([name]) => invalidNames.includes(name)));

        if (Object.keys(remaining).length === invalidNames.length) return;

        clearFieldErrors(form);
        setFieldErrors(form, remaining);
    }

    function handleModalClick(event: MouseEvent, dialog: HTMLDialogElement) {
        if (isBackdropPress && isOutsideBox(event, dialog)) dialog.close();

        isBackdropPress = false;
    }

    function handleModalClose() {
        const previous = trigger;

        document.documentElement.style.overflow = '';
        selectedEmail = '';
        trigger = null;
        previous?.focus();
    }

    function handleModalTab(event: KeyboardEvent, dialog: HTMLDialogElement) {
        if (!dialog.open || event.key !== 'Tab') return;

        const first = dialog.querySelector<HTMLButtonElement>('[data-prods-close]');
        const last = dialog.querySelector<HTMLButtonElement>('[data-prods-apply]');

        if (document.activeElement !== (event.shiftKey ? first : last)) return;

        event.preventDefault();
        (event.shiftKey ? last : first)?.focus();
    }

    function handleSearch(input: HTMLInputElement) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-member-email]');
        const count = document.querySelector<HTMLElement>('[data-prods-count]');
        const none = document.querySelector<HTMLElement>('[data-prods-none]');
        const query = input.value.trim().toLowerCase();

        let shown = 0;

        buttons.forEach((button) => {
            const haystack = `${button.dataset.memberName} ${button.dataset.memberEmail}`.toLowerCase();

            const isMatch = haystack.includes(query) || query.length === 0;

            button.closest('li')?.classList.toggle('hidden', !isMatch);

            if (isMatch) shown += 1;
        });

        none?.classList.toggle('hidden', shown > 0);
        setText(count, query.length === 0 ? `${buttons.length} members` : `${shown} of ${buttons.length} members match`);
    }

    function initAdminProds(signal: AbortSignal) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-prods-modal]');
        const form = document.querySelector<HTMLFormElement>('[data-prods-form]');
        const scroller = document.querySelector<HTMLElement>('.prods__scroller');
        const search = document.querySelector<HTMLInputElement>('[data-search-input]');

        if (!dialog || !form || !scroller || !search) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        isBackdropPress = false;
        isPending = false;
        selectedEmail = '';
        trigger = null;
        form.noValidate = true;
        dialog.addEventListener('click', event => handleModalClick(event, dialog), { signal });
        dialog.addEventListener('close', handleModalClose, { signal });
        dialog.addEventListener('keydown', event => handleModalTab(event, dialog), { signal });

        dialog.addEventListener('pointerdown', (event) => {
            isBackdropPress = isOutsideBox(event, dialog);
        }, { signal });

        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.addEventListener('click', () => dialog.close(), { signal });
        form.addEventListener('input', () => handleFieldInput(form), { signal });
        form.addEventListener('submit', event => void handleAdjustSubmit(event, form), { signal });
        search.addEventListener('input', () => handleSearch(search), { signal });
        signal.addEventListener('abort', () => teardown(dialog), { once: true });
        observeRowWindow(scroller, signal);

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement: search,
            signal,
        });

        document.querySelectorAll<HTMLButtonElement>('[data-member-email]').forEach((button) => {
            button.addEventListener('click', () => openModal(button, dialog, form), { signal });
        });
    }

    function isAdjustment(value: string) {
        const amount = Number(value);

        return Math.abs(amount) <= AMOUNT_LIMIT && Number.isInteger(amount) && amount !== 0;
    }

    function openModal(button: HTMLButtonElement, dialog: HTMLDialogElement, form: HTMLFormElement) {
        selectedEmail = button.dataset.memberEmail ?? '';
        trigger = button;
        clearFieldErrors(form);
        form.reset();
        renderDetail();
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.focus();
    }

    function renderDetail() {
        const balance = document.querySelector<HTMLElement>('[data-prods-balance]');
        const body = document.querySelector<HTMLElement>('[data-prods-ledger]');
        const button = document.querySelector<HTMLButtonElement>(`[data-member-email="${selectedEmail}"]`);
        const email = document.querySelector<HTMLElement>('[data-prods-email]');
        const member = document.querySelector<HTMLElement>('[data-prods-member]');
        const scroller = document.querySelector<HTMLElement>('.prods__scroller');
        const since = document.querySelector<HTMLElement>('[data-prods-since]');
        const template = document.querySelector<HTMLTemplateElement>('[data-prods-row]');

        if (!balance || !body || !button || !scroller || !template) return;

        const rows = getProdsRows(selectedEmail);

        const total = rows.at(-1)?.total ?? 0;

        body.replaceChildren();

        rows.toReversed().forEach((row) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const reason = fragment.querySelector<HTMLElement>('[data-cell="reason"]');

            fragment.querySelectorAll<HTMLElement>('[data-cell="change"]').forEach((change) => {
                change.classList.toggle('text-error-text', row.amount < 0);
                setText(change, row.amount > 0 ? `+${row.amount}` : `\u2212${Math.abs(row.amount)}`);
            });

            fragment.querySelectorAll<HTMLTimeElement>('[data-cell="date"]').forEach((date) => {
                date.setAttribute('datetime', row.date);
                setText(date, formatDateStamp(new Date(row.date)));
            });

            setText(reason, row.reason);
            setText(fragment.querySelector<HTMLElement>('[data-cell="balance"]'), String(row.total));
            body.append(fragment);
        });

        balance.classList.toggle('text-error-text', total < 0);
        setText(balance, String(total));
        setText(email, button.dataset.memberEmail ?? '');
        setText(member, button.dataset.memberName ?? '');
        setText(since, button.dataset.memberJoined ?? '');
        fitRowWindow(scroller);
    }

    function teardown(dialog: HTMLDialogElement) {
        document.documentElement.style.overflow = '';
        dialog.close();
    }

    function validateAdjustment(form: HTMLFormElement) {
        const errors = validateFields(form, RULES, true);
        const amount = Number(String(new FormData(form).get('amount') ?? '').trim());

        if (!errors.amount && getProdsBalance(selectedEmail) + amount < 0) errors.amount = NEGATIVE_MESSAGE;

        return errors;
    }

    registerPageScript(initAdminProds);
</script>
