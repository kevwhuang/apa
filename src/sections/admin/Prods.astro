---

<section
    class="stage stage--tight"
    aria-labelledby="admin-prods-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-3xl tracking-tight"
            eyebrow={`Console / ${MEMBERS.length} members`}
            headingId="admin-prods-title"
        >
            Prods management
        </SectionHead>
        <div data-motion="rise">
            <SearchField
                class="mb-3"
                label="Find a member"
                placeholder={'Search members\u2026'}
            />
            <p
                class="label mb-4 text-ink-subtle"
                aria-live="polite"
                data-prods-count
            >
                {MEMBERS.length} members
            </p>
            <ul
                class="prods__members scroll-slot border-2 border-ink divide-y divide-ink list-none"
                data-prods-seed={LEDGER_SEED}
            >
                {MEMBERS.map(member => (
                    <li>
                        <button
                            class="active:bg-surface hover:bg-surface-sunken grid min-h-(--control-size) w-full gap-(--space-3xs) px-(--space-md) py-(--space-sm) text-left transition-colors"
                            aria-controls="prods-modal"
                            aria-haspopup="dialog"
                            data-member-email={member.email}
                            data-member-id={member.id}
                            data-member-joined={formatDate(new Date(member.joined))}
                            data-member-name={member.artistName}
                            type="button"
                        >
                            <span class="font-bold font-sans leading-snug text-md tracking-tight">{member.artistName}</span>
                            <span class="font-mono text-xs text-ink-muted">{member.email}</span>
                            <span class="font-mono text-2xs text-ink-subtle">Joined {formatDate(new Date(member.joined))}</span>
                        </button>
                    </li>
                ))}
                <li
                    class="hidden"
                    data-prods-none
                >
                    <p class="px-4 py-4 font-mono text-sm text-ink-muted">No members match that search.</p>
                </li>
            </ul>
        </div>
        <dialog
            id="prods-modal"
            class="prods__modal"
            aria-labelledby="prods-modal-title"
            data-prods-modal
        >
            <div class="flex items-start justify-between gap-(--space-sm) p-(--space-md) border-b-2 border-ink">
                <div>
                    <h3
                        id="prods-modal-title"
                        class="mb-2 font-extrabold font-sans text-2xl tracking-tight"
                    >
                        <span data-prods-member>Member ledger</span>
                    </h3>
                    <p class="flex flex-col gap-(--space-3xs) font-mono text-xs text-ink-muted">
                        <span data-prods-email />
                        <span
                            class="text-ink-subtle"
                            data-prods-joined
                        />
                    </p>
                </div>
                <button
                    class="prods__close"
                    data-prods-close
                    type="button"
                >
                    <IconClose />
                    <span class="sr-only">Close member ledger</span>
                </button>
            </div>
            <div class="overflow-y-auto overscroll-contain p-(--space-md)">
                <dl class="grid gap-px mb-8 border-2 border-ink bg-ink md:grid-cols-3">
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Prod balance</dt>
                        <dd
                            class="font-extrabold font-sans text-3xl tracking-tight"
                            data-prods-balance
                        />
                    </div>
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Standing</dt>
                        <dd
                            class="label"
                            data-prods-standing
                        />
                    </div>
                    <div class="p-(--space-md) bg-surface-raised">
                        <dt class="label mb-2 text-ink-muted">Member since</dt>
                        <dd
                            class="font-mono text-sm"
                            data-prods-since
                        />
                    </div>
                </dl>
                <p class="label mb-3 text-ink-muted">Ledger history</p>
                <div class="prods__scroller scroll-slot overflow-x-auto mb-8 border-2 border-ink">
                    <table class="prods__table">
                        <caption class="sr-only">Dated ledger entries with reason, change, and running balance</caption>
                        <thead>
                            <tr class="font-bold font-mono text-2xs tracking-wide uppercase text-ink-muted">
                                <th
                                    class="px-4 py-3 text-left"
                                    scope="col"
                                >
                                    Date
                                </th>
                                <th
                                    class="px-4 py-3 text-left"
                                    scope="col"
                                >
                                    Reason
                                </th>
                                <th
                                    class="px-4 py-3 text-right"
                                    scope="col"
                                >
                                    Change
                                </th>
                                <th
                                    class="px-4 py-3 text-right"
                                    scope="col"
                                >
                                    Balance
                                </th>
                            </tr>
                        </thead>
                        <tbody
                            class="divide-y divide-ink"
                            data-prods-ledger
                        />
                    </table>
                </div>
                <template data-prods-row>
                    <tr>
                        <td
                            class="px-4 py-4 font-mono text-xs whitespace-nowrap text-ink-muted"
                            data-cell="date"
                        />
                        <td
                            class="px-4 py-4 text-sm wrap-anywhere"
                            data-cell="reason"
                        />
                        <td
                            class="px-4 py-4 font-mono text-right text-xs"
                            data-cell="change"
                        />
                        <td
                            class="px-4 py-4 font-mono text-right text-xs"
                            data-cell="balance"
                        />
                    </tr>
                </template>
                <form
                    class="slab slab--sunk"
                    data-prods-form
                >
                    <p class="label mb-4 text-ink-muted">Adjust balance</p>
                    <div class="prods__fields mb-3">
                        <label class="block">
                            <span class="label block mb-2 text-ink-muted">Amount</span>
                            <input
                                class="input font-bold font-mono text-smd"
                                aria-describedby="prods-amount-hint prods-amount-error"
                                aria-invalid="false"
                                autocomplete="off"
                                inputmode="numeric"
                                max="100"
                                min="-100"
                                name="amount"
                                required
                                step="1"
                                type="number"
                            />
                        </label>
                        <label class="block">
                            <span class="label block mb-2 text-ink-muted">Reason</span>
                            <input
                                class="input font-sans"
                                aria-describedby="prods-reason-error"
                                aria-invalid="false"
                                autocomplete="off"
                                maxlength="80"
                                name="reason"
                                type="text"
                            />
                        </label>
                    </div>
                    <div class="flex flex-col gap-2 mb-6">
                        <p
                            id="prods-amount-hint"
                            class="font-mono text-2xs text-ink-subtle"
                        >
                            Whole amounts from &minus;100 to 100, excluding zero.
                        </p>
                        <p
                            id="prods-amount-error"
                            class="action-text text-accent-deep"
                            data-field-error
                            hidden
                        />
                        <p
                            id="prods-reason-error"
                            class="action-text text-accent-deep"
                            data-field-error
                            hidden
                        />
                    </div>
                    <button
                        class="btn btn--primary"
                        data-prods-apply
                        type="submit"
                    >
                        Apply adjustment
                    </button>
                </form>
            </div>
        </dialog>
    </div>
</section>

<style>
    .prods__close {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .prods__close:active {
        transform: translateY(1px);
    }

    .prods__close:hover {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .prods__fields {
        align-items: end;
        display: grid;
        gap: var(--space-sm);
        grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    }

    .prods__members {
        --scroll-slot-max: calc(4px + 5 * (73.5px + 11 * var(--text-md) / 8));
    }

    .prods__modal {
        background-color: var(--color-surface-raised);
        border: 2px solid var(--color-ink);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-ink);
        color: var(--color-ink);
        inset: 50% auto auto 50%;
        max-height: min(88vh, 760px);
        padding: 0;
        position: fixed;
        translate: -50% -50%;
        width: min(720px, calc(100vw - 2 * var(--space-md)));
    }

    .prods__modal::backdrop {
        background-color: var(--color-ink-70);
    }

    .prods__modal[open] {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .prods__scroller {
        --scroll-slot-max: calc(44px + 5 * (33px + 10 * var(--text-sm) / 7));
    }

    .prods__table {
        display: table;
        overflow-x: visible;
        width: 100%;
    }

    .prods__table thead th {
        background-color: var(--color-surface-raised);
        box-shadow: inset 0 -2px 0 var(--color-ink);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    :global(html[data-theme='dark']) .prods__modal::backdrop {
        background-color: var(--color-ink-inverse);
        opacity: 0.7;
    }

    @media (max-width: 768px) {
        .prods__fields {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { MOCK_LATENCY_MS, STORAGE } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { createStore } from '@lib/shared/state';
    import { delay, formatDateStamp, formatProds, getStanding, initSearchField, registerPageScript, setPending, setText } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    type LedgerMap = Record<string, LedgerEntry[]>;

    interface LedgerEntry {
        amount: number;
        date: string;
        reason: string;
    }

    const AMOUNT_LIMIT = 100;
    const REASON_MAX = 80;
    const STORAGE_MESSAGE = 'Nothing was saved \u2014 your browser storage is full. Clear some space and try again.';

    const RULES: Record<string, FieldRule> = {
        amount: { message: 'Enter a non-zero amount between \u2212100 and 100.', required: true, validate: isAdjustment },
        reason: { max: REASON_MAX, message: 'Give the ledger a reason for this change.', required: true },
    };

    const adjustments = createStore<LedgerMap>({
        fallback: {},
        key: STORAGE.adminProds.key,
        scope: STORAGE.adminProds.scope,
        topic: STORAGE.adminProds.topic,
    });

    let pending = false;
    let seed: LedgerMap = {};
    let selectedId = '';
    let trigger: HTMLButtonElement | null = null;

    function formatChange(amount: number) {
        return amount > 0 ? `+${amount}` : String(amount);
    }

    function getLedger(id: string) {
        return [...(seed[id] ?? []), ...(adjustments.get()[id] ?? [])];
    }

    async function handleAdjustSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        if (!selectedId || pending) return;

        const errors = validateFields(form, RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const memberId = selectedId;
        const name = selectedName();
        const submit = form.querySelector<HTMLButtonElement>('[data-prods-apply]');
        const values = new FormData(form);

        const amount = Number(String(values.get('amount') ?? '').trim());
        const reason = String(values.get('reason') ?? '').trim();

        const size = Math.abs(amount);

        pending = true;
        setPending(submit, true);

        await delay(MOCK_LATENCY_MS);

        const entry: LedgerEntry = {
            amount,
            date: new Date().toISOString(),
            reason,
        };

        adjustments.update(value => ({ ...value, [memberId]: [...(value[memberId] ?? []), entry] }));
        setPending(submit, false);
        pending = false;

        if (!adjustments.persisted()) {
            submit?.focus();
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        clearFieldErrors(form);
        form.reset();

        if (selectedId === memberId) renderDetail();

        submit?.focus();
        toast(`${amount < 0 ? 'Removed' : 'Added'} ${formatProds(size)} ${amount < 0 ? 'from' : 'to'} ${name}.`, 'success');
    }

    function handleModalClick(event: MouseEvent, dialog: HTMLDialogElement) {
        if (event.target === dialog) dialog.close();
    }

    function handleModalClose() {
        const previous = trigger;

        selectedId = '';
        trigger = null;
        previous?.focus();
    }

    function handleSearch(input: HTMLInputElement) {
        const query = input.value.trim().toLowerCase();
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-member-id]');
        const count = document.querySelector<HTMLElement>('[data-prods-count]');
        const none = document.querySelector<HTMLElement>('[data-prods-none]');

        let shown = 0;

        buttons.forEach((button) => {
            const haystack = `${button.dataset.memberName} ${button.dataset.memberEmail}`.toLowerCase();

            const match = query.length === 0 || haystack.includes(query);

            button.closest('li')?.classList.toggle('hidden', !match);

            if (match) shown += 1;
        });

        none?.classList.toggle('hidden', shown > 0);
        setText(count, query.length === 0 ? `${buttons.length} members` : `${shown} of ${buttons.length} members match`);
    }

    function initAdminProds(signal: AbortSignal) {
        const dialog = document.querySelector<HTMLDialogElement>('[data-prods-modal]');
        const form = document.querySelector<HTMLFormElement>('[data-prods-form]');
        const search = document.querySelector<HTMLInputElement>('[data-search-input]');

        if (!dialog || !form || !search) return;

        if ('closedBy' in dialog) dialog.setAttribute('closedby', 'closerequest');

        pending = false;
        seed = readSeed();
        selectedId = '';
        trigger = null;
        form.noValidate = true;

        dialog.addEventListener('click', event => handleModalClick(event, dialog), { signal });
        dialog.addEventListener('close', handleModalClose, { signal });
        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.addEventListener('click', () => dialog.close(), { signal });
        form.addEventListener('submit', event => void handleAdjustSubmit(event, form), { signal });
        search.addEventListener('input', () => handleSearch(search), { signal });

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement: search,
            signal,
        });

        document.querySelectorAll<HTMLButtonElement>('[data-member-id]').forEach((button) => {
            button.addEventListener('click', () => openModal(button, dialog, form), { signal });
        });
    }

    function isAdjustment(value: string) {
        const amount = Number(value);

        return Number.isInteger(amount) && amount !== 0 && Math.abs(amount) <= AMOUNT_LIMIT;
    }

    function openModal(button: HTMLButtonElement, dialog: HTMLDialogElement, form: HTMLFormElement) {
        selectedId = button.dataset.memberId ?? '';
        trigger = button;
        clearFieldErrors(form);
        form.reset();
        renderDetail();
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-prods-close]')?.focus();
    }

    function readSeed() {
        const raw = document.querySelector<HTMLElement>('[data-prods-seed]')?.dataset.prodsSeed;

        try {
            return JSON.parse(raw ?? '{}') as LedgerMap;
        } catch {
            return {};
        }
    }

    function renderDetail() {
        const balance = document.querySelector<HTMLElement>('[data-prods-balance]');
        const body = document.querySelector<HTMLElement>('[data-prods-ledger]');
        const button = document.querySelector<HTMLButtonElement>(`[data-member-id="${selectedId}"]`);
        const email = document.querySelector<HTMLElement>('[data-prods-email]');
        const joined = document.querySelector<HTMLElement>('[data-prods-joined]');
        const member = document.querySelector<HTMLElement>('[data-prods-member]');
        const since = document.querySelector<HTMLElement>('[data-prods-since]');
        const standing = document.querySelector<HTMLElement>('[data-prods-standing]');
        const template = document.querySelector<HTMLTemplateElement>('[data-prods-row]');

        if (!balance || !body || !button || !template) return;

        let total = 0;

        const rows = getLedger(selectedId).map((entry) => {
            total += entry.amount;

            return { ...entry, total };
        });

        body.replaceChildren();

        rows.toReversed().forEach((row) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const change = fragment.querySelector<HTMLElement>('[data-cell="change"]');

            change?.classList.toggle('text-accent-deep', row.amount < 0);
            setText(change, formatChange(row.amount));
            setText(fragment.querySelector<HTMLElement>('[data-cell="balance"]'), String(row.total));
            setText(fragment.querySelector<HTMLElement>('[data-cell="date"]'), formatDateStamp(new Date(row.date)));
            setText(fragment.querySelector<HTMLElement>('[data-cell="reason"]'), row.reason);
            body.append(fragment);
        });

        setText(balance, String(total));
        setText(email, button.dataset.memberEmail ?? '');
        setText(joined, `Joined ${button.dataset.memberJoined ?? ''}`);
        setText(member, button.dataset.memberName ?? '');
        setText(since, button.dataset.memberJoined ?? '');
        setText(standing, getStanding(total));
        standing?.classList.toggle('text-accent-deep', total < 0);
    }

    function selectedName() {
        return document.querySelector<HTMLButtonElement>(`[data-member-id="${selectedId}"]`)?.dataset.memberName ?? '';
    }

    registerPageScript(initAdminProds);
</script>
