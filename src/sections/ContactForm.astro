---
import PageHead from '@components/PageHead.astro';
import { LINKS } from '@lib/utils';

const TOPICS = ['Booking', 'Membership', 'Press', 'Sponsor inquiry', 'Something else'];
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="contact-title"
>
    <div class="shell shell--narrow">
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Contact"
            headingId="contact-title"
        >
            Send a signal.
        </PageHead>
    </div>
</section>

<section
    class="py-16"
    aria-label="Contact form"
>
    <div class="reveal--stagger shell shell--narrow grid gap-12 md:grid-cols-[1.4fr_1fr]">
        <form class="contact-form space-y-5">
            <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                    <span class="label block mb-2 text-taupe">Name</span>
                    <input class="h-12 w-full px-4 border-2 border-ink font-sans bg-transparent" autocomplete="name" name="name" required />
                </label>
                <label class="block">
                    <span class="label block mb-2 text-taupe">Email</span>
                    <input class="h-12 w-full px-4 border-2 border-ink font-mono text-[13px] bg-transparent" autocomplete="email" name="email" required type="email" />
                </label>
            </div>
            <label class="block">
                <span class="label block mb-2 text-taupe">Topic</span>
                <select
                    class="h-12 w-full px-4 border-2 border-ink bg-transparent"
                    name="topic"
                >
                    <option
                        disabled
                        selected
                        value=""
                    >
                        Choose a topic&hellip;
                    </option>
                    {TOPICS.map(topic => (
                        <option>{topic}</option>
                    ))}
                </select>
            </label>
            <label class="block">
                <span class="label block mb-2 text-taupe">Message</span>
                <textarea class="w-full p-4 border-2 border-ink bg-transparent" name="message" required rows="6" />
            </label>
            <button
                class="btn btn--primary h-12"
                type="submit"
            >
                Send &rarr;
            </button>
            <p
                class="action-text hidden p-3 bg-coral text-ink"
                data-output
                role="status"
            />
        </form>
        <aside>
            <dl class="space-y-8">
                <div>
                    <dt class="label mb-2 text-taupe">Email</dt>
                    <dd>
                        <a
                            class="hover:text-coral-dark font-mono text-[14px] transition-colors"
                            href={`mailto:${LINKS.email}`}
                        >
                            {LINKS.email}
                        </a>
                    </dd>
                </div>
                <div>
                    <dt class="label mb-2 text-taupe">Studio</dt>
                    <dd>
                        <address class="not-italic">2107 E 5th St<br />Austin, TX 78702</address>
                    </dd>
                </div>
            </dl>
        </aside>
    </div>
</section>

<script>
    let contactController: AbortController | undefined;

    function handleContactSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const output = form.querySelector<HTMLElement>('[data-output]');

        if (!output) return;

        output.classList.remove('hidden');
        output.textContent = 'Demo form \u2014 nothing was sent. Email us at hello@austinproduceralliance.com.';
    }

    function initContactForm() {
        contactController?.abort();
        contactController = new AbortController();

        const { signal } = contactController;

        const form = document.querySelector<HTMLFormElement>('.contact-form');

        if (!form) return;

        form.addEventListener('submit', event => handleContactSubmit(event, form), { signal });
    }

    document.addEventListener('astro:page-load', initContactForm);
</script>
