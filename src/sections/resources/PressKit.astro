---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { toAvailability } from '@lib/resources/unlocks';

const files = (await getCollection('downloads', asset => asset.data.kind === 'bash'))
    .toSorted((a, b) => Number(b.data.available) - Number(a.data.available) || a.data.title.localeCompare(b.data.title))
    .map(file => ({ ...file, availability: toAvailability(file.data) }));
---

{files.length > 0 && (
    <section
        class="stage stage--tight border-border-strong border-t-2"
        aria-labelledby="bash-files-title"
    >
        <div>
            <SectionHead
                class="text-3xl"
                headingId="bash-files-title"
            >
                Bash files
            </SectionHead>
            <p
                class="max-w-2xl mb-10 text-lg text-text-secondary"
                data-motion="blur"
            >
                Files for the Bash, posted here as each edition opens.
            </p>
            <div
                class="overflow-x-auto"
                data-motion="unfold"
            >
                <table class="bash-files__table border-2 border-border-strong">
                    <caption class="sr-only">Bash files with their format, size, and download</caption>
                    <colgroup>
                        <col />
                        <col class="w-24 max-md:hidden" />
                        <col class="w-24 max-md:hidden" />
                        <col class="w-36" />
                    </colgroup>
                    <thead>
                        <tr class="label border-b-2 border-border-strong text-text-secondary">
                            <th
                                class="p-4 text-left max-md:px-2"
                                scope="col"
                            >
                                Name
                            </th>
                            <th
                                class="p-4 text-left max-md:hidden"
                                scope="col"
                            >
                                Format
                            </th>
                            <th
                                class="p-4 text-left max-md:hidden"
                                scope="col"
                            >
                                Size
                            </th>
                            <th
                                class="p-4 text-center max-md:px-2"
                                scope="col"
                            >
                                Download
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-border-strong divide-y">
                        {files.map(file => (
                            <tr id={file.id}>
                                <th
                                    class="p-4 font-bold font-sans text-left max-md:px-2"
                                    scope="row"
                                >
                                    {file.data.title}
                                    <span class="hidden font-mono font-normal text-base text-text-secondary max-md:block">
                                        {file.data.format} &middot; {file.data.size}
                                    </span>
                                </th>
                                <td class="p-4 font-mono text-base whitespace-nowrap max-md:hidden">{file.data.format}</td>
                                <td class="p-4 font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">{file.data.size}</td>
                                <td class="p-4 text-center max-md:px-2">
                                    {file.availability === 'open' && (
                                        <a
                                            class="action-text inline-flex items-center min-h-(--control-size) transition-[color,transform]"
                                            aria-label={`Download ${file.data.title}`}
                                            download
                                            href={file.data.href}
                                        >
                                            Download
                                        </a>
                                    )}
                                    {file.availability !== 'open' && (
                                        <span class="action-text inline-flex items-center min-h-(--control-size) whitespace-nowrap text-text-secondary">Coming soon</span>
                                    )}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
)}

<style>
    .bash-files__table {
        display: table;
        overflow-x: visible;
        table-layout: fixed;
    }
</style>
