---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import SearchField from '@components/shared/SearchField.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { ASSET_KIND_LABELS, KIND_COLORS } from '@lib/shared/constants';
import { formatDate, formatTime, mergeAssets, toIsoDate } from '@lib/shared/utils';
import { isDownload, toAvailability } from '@lib/resources/unlocks';

const assets = mergeAssets(await getCollection('downloads'), await getCollection('docs'))
    .map(asset => ({
        ...asset,
        availability: toAvailability(asset.data),
        isDownload: isDownload(asset.data),
        search: [asset.data.title, asset.data.description, ASSET_KIND_LABELS[asset.data.kind], asset.data.format].join(' ').toLowerCase(),
    }));

const kinds = Array.from(new Set(assets.map(asset => asset.data.kind)))
    .map(kind => ({ count: assets.filter(asset => asset.data.kind === kind).length, kind, label: ASSET_KIND_LABELS[kind] }))
    .sort((a, b) => a.label.localeCompare(b.label));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="resources-title"
>
    <div>
        <PageHead
            class="max-w-3xl mb-6 text-4xl md:text-7xl sm:text-5xl"
            eyebrow="Downloads & press kit"
            headingId="resources-title"
        >
            Take what you need.
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            Everything the Alliance hands out in one place &mdash; press material, brand assets,
            event packs, and the working documents behind how the community runs.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="library-title"
>
    <div>
        <SectionHead
            class="text-3xl"
            eyebrow={`Library, ${assets.length} assets`}
            headingId="library-title"
        >
            Asset library
        </SectionHead>
        <SearchField
            class="mb-4"
            data-motion="rise"
            label="Search the library"
            placeholder={'Search assets\u2026'}
        />
        <div
            class="flex flex-wrap gap-2 mb-6"
            aria-label="Filter by asset kind"
            data-motion="rise"
            role="group"
        >
            <button
                class="chip is-active resources__chip active:bg-bg-inverse active:text-text-inverse hover:bg-bg-inverse hover:text-text-inverse gap-(--space-3xs)"
                aria-pressed="true"
                data-kind=""
                type="button"
            >
                All {assets.length}
            </button>
            {kinds.map(entry => (
                <button
                    class="chip resources__chip active:bg-bg-inverse active:text-text-inverse hover:bg-bg-inverse hover:text-text-inverse gap-(--space-3xs)"
                    aria-pressed="false"
                    data-kind={entry.kind}
                    style={`--kind-color: ${KIND_COLORS[entry.kind]}`}
                    type="button"
                >
                    <span
                        class="resources__swatch--chip flex-none size-2 bg-(--kind-color)"
                        aria-hidden="true"
                    />
                    {entry.label} {entry.count}
                </button>
            ))}
        </div>
        <p
            class="label mb-10 text-text-secondary"
            aria-live="polite"
            data-motion="stamp"
            data-resources-status
        >
            Showing all {assets.length} assets.
        </p>
        <ul
            class="resources__grid list-none"
            data-motion-from="center"
            data-motion-stagger="flip"
        >
            {assets.map(asset => (
                <li
                    id={asset.id}
                    class="resource-card"
                    data-kind={asset.data.kind}
                    data-search={asset.search}
                    style={`--kind-color: ${KIND_COLORS[asset.data.kind]}`}
                >
                    <article class="resources__card slab slab--card slab--hover">
                        <header class="flex flex-wrap items-start justify-between gap-2">
                            <p class="label inline-flex items-center gap-(--space-3xs) px-(--space-2xs) py-(--space-3xs) border-2 border-(--kind-color) text-text">
                                <span
                                    class="flex-none size-2 bg-(--kind-color)"
                                    aria-hidden="true"
                                />
                                {ASSET_KIND_LABELS[asset.data.kind]}
                            </p>
                            {asset.data.available && (
                                <p class="label px-2 py-1 bg-bg-signal text-text-on-signal">
                                    Published
                                </p>
                            )}
                        </header>
                        <div class="flex flex-col gap-3">
                            <h3 class="text-xl">
                                {asset.data.title}
                            </h3>
                            <p class="leading-relaxed text-sm text-text-secondary">
                                {asset.data.description}
                            </p>
                        </div>
                        <dl class="flex flex-col gap-(--space-3xs) pt-(--space-xs) border-t border-border-subtle">
                            <div class="flex justify-between gap-(--space-xs)">
                                <dt class="label text-text-secondary">Format</dt>
                                <dd class="font-mono text-xs">{asset.data.format}</dd>
                            </div>
                            <div class="flex justify-between gap-(--space-xs)">
                                <dt class="label text-text-secondary">Size</dt>
                                <dd
                                    class="font-mono text-xs"
                                    data-placeholder={asset.data.available ? undefined : ''}
                                >
                                    {asset.data.size}
                                </dd>
                            </div>
                            <div class="flex justify-between gap-(--space-xs)">
                                <dt class="label text-text-secondary">Updated</dt>
                                <dd class="font-mono text-xs">
                                    <time datetime={toIsoDate(asset.data.date)}>{formatDate(asset.data.date)}</time>
                                </dd>
                            </div>
                            {asset.data.unlocksAt && (
                                <div class="flex justify-between gap-(--space-xs)">
                                    <dt class="label text-text-secondary">Unlocks</dt>
                                    <dd class="font-mono text-xs">
                                        <time datetime={asset.data.unlocksAt.toISOString()}>{formatDate(asset.data.unlocksAt)} &middot; {formatTime(asset.data.unlocksAt)}</time>
                                    </dd>
                                </div>
                            )}
                        </dl>
                        {asset.availability === 'open' && (
                            <a
                                class="btn btn--primary"
                                aria-label={asset.isDownload ? `Download ${asset.data.title}` : undefined}
                                download={asset.isDownload ? '' : undefined}
                                href={asset.data.href}
                            >
                                {asset.isDownload ? 'Download' : `Open ${asset.data.title}`} <IconArrow />
                            </a>
                        )}
                        {asset.availability === 'scheduled' && (
                            <div
                                data-unlock
                                data-unlocks-at={asset.data.unlocksAt?.toISOString()}
                            >
                                <p
                                    class="label resources__countdown flex items-center gap-2 min-h-(--control-size) px-4"
                                    data-unlock-locked
                                >
                                    <span>Unlocks in</span>
                                    <span data-unlock-remaining>&hellip;</span>
                                </p>
                                {asset.data.href && (
                                    <a
                                        class="btn btn--primary"
                                        aria-label={asset.isDownload ? `Download ${asset.data.title}` : undefined}
                                        data-unlock-ready
                                        download={asset.isDownload ? '' : undefined}
                                        hidden
                                        href={asset.data.href}
                                    >
                                        {asset.isDownload ? 'Download' : `Open ${asset.data.title}`} <IconArrow />
                                    </a>
                                )}
                            </div>
                        )}
                        {asset.availability === 'pending' && (
                            <p class="label resources__blocked flex items-center min-h-(--control-size) px-4 text-text-secondary">
                                Not published yet
                            </p>
                        )}
                    </article>
                </li>
            ))}
        </ul>
        <div
            class="slab slab--sunk flex flex-col items-start max-w-(--measure-form) w-full gap-4 mx-auto"
            data-resources-empty
            hidden
        >
            <p class="font-bold font-sans text-xl tracking-tight">No matches.</p>
            <p class="text-sm text-text-secondary">
                Nothing in the library answers to &ldquo;<span class="font-mono wrap-anywhere" data-search-echo />&rdquo;.
            </p>
            <button
                class="btn"
                data-search-clear
                type="button"
            >
                Clear search
            </button>
        </div>
    </div>
</section>

<style>
    .resources__blocked {
        background-image: repeating-linear-gradient(135deg, var(--color-bg-sunken) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-border-subtle);
    }

    .resources__card {
        --slab-fill: var(--color-bg-raised);
        border-top: 4px solid var(--kind-color);
    }

    .resources__card,
    .resources__grid > li:not(.hidden) {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        row-gap: var(--space-sm);
    }

    .resources__countdown {
        background-image: repeating-linear-gradient(135deg, var(--color-bg-sunken) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-link);
        color: var(--color-link);
    }

    .resources__grid {
        display: grid;
        gap: var(--space-lg);
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .resources__grid > * {
        min-width: 0;
    }

    .resources__swatch--chip {
        outline: 1px solid var(--color-bg-page);
    }

    @media (max-width: 1024px) {
        .resources__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .resources__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { initFilterGroup, initSearchField, registerPageScript } from '@lib/shared/utils';
    import { initUnlocks } from '@lib/resources/unlocks';

    function describeAssets(shown: number, total: number, kind: string, query: string) {
        if (query) return `Showing ${shown} of ${total} assets for \u201c${query}\u201d.`;

        return kind ? `Showing ${shown} of ${total} assets.` : `Showing all ${total} assets.`;
    }

    function initResourcesLibrary(signal: AbortSignal) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.resources__chip');
        const cards = document.querySelectorAll<HTMLElement>('.resource-card');

        if (!buttons.length || !cards.length) return;

        const searchElement = document.querySelector<HTMLInputElement>('[data-search-input]');

        initFilterGroup({
            buttons,
            cards,
            dataKey: 'kind',
            emptyElement: document.querySelector<HTMLElement>('[data-resources-empty]'),
            initial: '',
            matches: (card, kind) => !kind || card.dataset.kind === kind,
            searchElement,
            signal,
            status: describeAssets,
            statusElement: document.querySelector<HTMLElement>('[data-resources-status]'),
        });

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement,
            signal,
        });
    }

    initUnlocks();
    registerPageScript(initResourcesLibrary);
</script>
