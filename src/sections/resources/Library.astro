---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SearchField from '@components/shared/SearchField.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { ASSET_KIND_LABELS, KIND_COLORS } from '@lib/shared/constants';
import { formatDateStamp, mergeAssets, toIsoDate } from '@lib/shared/utils';
import { isDownload, toAvailability } from '@lib/resources/unlocks';

const downloads = await getCollection('downloads', entry => entry.data.kind !== 'bash');

const titles = new Map(downloads.map(entry => [entry.id, entry.data.title]));

const assets = mergeAssets(downloads, await getCollection('docs'))
    .map((asset) => {
        const title = titles.get(asset.id) ?? asset.data.title;

        return {
            ...asset,
            availability: toAvailability(asset.data),
            isDownload: isDownload(asset.data),
            search: [title, asset.data.description, ASSET_KIND_LABELS[asset.data.kind], asset.data.format].join(' ').toLowerCase(),
            title,
        };
    })
    .sort((a, b) => ASSET_KIND_LABELS[a.data.kind].localeCompare(ASSET_KIND_LABELS[b.data.kind]) || a.title.localeCompare(b.title));

const kinds = Array.from(new Set(assets.map(asset => asset.data.kind)))
    .map(kind => ({ count: assets.filter(asset => asset.data.kind === kind).length, kind, label: ASSET_KIND_LABELS[kind] }))
    .sort((a, b) => a.label.localeCompare(b.label));
---

<section
    class="stage stage--tight"
    aria-labelledby="library-title"
>
    <h1 class="sr-only">
        Resources
    </h1>
    <div>
        <SectionHead
            class="text-3xl"
            headingId="library-title"
        >
            Asset library
        </SectionHead>
        <SearchField
            class="mb-4"
            data-motion="rise"
            label="Search the library"
            placeholder={'Search assets\u2026'}
        />
        <div
            class="flex flex-wrap gap-3 mb-6"
            aria-label="Filter by asset kind"
            data-motion="rise"
            role="group"
        >
            <button
                class="chip is-active resources__chip hover:bg-bg-hover gap-(--space-3xs)"
                aria-pressed="true"
                data-kind=""
                type="button"
            >
                All {assets.length}
            </button>
            {kinds.map(entry => (
                <button
                    class="chip resources__chip hover:bg-bg-hover gap-(--space-3xs)"
                    aria-pressed="false"
                    data-kind={entry.kind}
                    style={`--kind-color: ${KIND_COLORS[entry.kind]}`}
                    type="button"
                >
                    <span
                        class="resources__swatch--chip flex-none size-2 bg-(--kind-color)"
                        aria-hidden="true"
                    />
                    {entry.label} {entry.count}
                </button>
            ))}
        </div>
        <p
            class="label mb-10 text-text-secondary"
            aria-live="polite"
            data-motion="stamp"
            data-resources-status
        >
            Showing all {assets.length} assets
        </p>
        <ul
            class="resources__grid list-none"
            data-motion-stagger="flip"
        >
            {assets.map(asset => (
                <li
                    id={asset.id}
                    class="resource-card"
                    data-kind={asset.data.kind}
                    data-search={asset.search}
                    style={`--kind-color: ${KIND_COLORS[asset.data.kind]}`}
                >
                    <article class="resources__card slab slab--card slab--still">
                        <header class="flex items-start pb-(--space-md)">
                            <p class="label inline-flex items-center gap-(--space-3xs) px-(--space-2xs) py-(--space-3xs) border-(--kind-color) border-2 text-text">
                                <span
                                    class="flex-none size-2 bg-(--kind-color)"
                                    aria-hidden="true"
                                />
                                {ASSET_KIND_LABELS[asset.data.kind]}
                            </p>
                        </header>
                        <div class="flex flex-col gap-(--space-2xs) pb-(--space-2xs)">
                            <h3 class="text-balance text-xl">
                                {asset.title}
                            </h3>
                            <p class="text-base text-text-secondary">
                                {asset.data.description}
                            </p>
                        </div>
                        <dl class="flex flex-col gap-(--space-3xs) pb-(--space-md) pt-(--space-xs) border-border-subtle border-t">
                            <div class="flex justify-between gap-(--space-xs)">
                                <dt class="label text-text-secondary">Format</dt>
                                <dd class="font-mono text-base">{asset.data.format}</dd>
                            </div>
                            <div class="flex justify-between gap-(--space-xs)">
                                <dt class="label text-text-secondary">Size</dt>
                                <dd
                                    class="font-mono text-base"
                                    data-placeholder={asset.data.available ? undefined : ''}
                                >
                                    {asset.data.size}
                                </dd>
                            </div>
                            {asset.availability === 'open' && (
                                <div class="flex justify-between gap-(--space-xs)">
                                    <dt class="label text-text-secondary">Date</dt>
                                    <dd class="font-mono text-base">
                                        <time datetime={toIsoDate(asset.data.date)}>{formatDateStamp(asset.data.date)}</time>
                                    </dd>
                                </div>
                            )}
                        </dl>
                        {asset.availability === 'open' && (
                            <a
                                class="btn btn--primary"
                                aria-label={asset.isDownload ? `Download ${asset.title}` : undefined}
                                download={asset.isDownload ? '' : undefined}
                                href={asset.data.href}
                            >
                                {asset.isDownload ? 'Download' : 'View product'} <IconArrow />
                            </a>
                        )}
                        {asset.availability === 'scheduled' && (
                            <div
                                data-unlock
                                data-unlocks-at={asset.data.unlocksAt?.toISOString()}
                            >
                                <p
                                    class="halftone label resources__blocked flex items-center justify-center min-h-(--control-size) px-4 text-text-secondary"
                                    data-unlock-locked
                                >
                                    <span>Coming soon</span>
                                </p>
                                {asset.data.href && (
                                    <a
                                        class="btn btn--primary"
                                        aria-label={asset.isDownload ? `Download ${asset.title}` : undefined}
                                        data-unlock-ready
                                        download={asset.isDownload ? '' : undefined}
                                        hidden
                                        href={asset.data.href}
                                    >
                                        {asset.isDownload ? 'Download' : 'View product'} <IconArrow />
                                    </a>
                                )}
                            </div>
                        )}
                        {asset.availability === 'pending' && (
                            <p class="halftone label resources__blocked flex items-center justify-center min-h-(--control-size) px-4 text-text-secondary">
                                <span>Coming soon</span>
                            </p>
                        )}
                    </article>
                </li>
            ))}
        </ul>
        <div
            class="slab slab--empty slab--sunk max-w-(--measure-form) w-full mx-auto"
            data-resources-empty
            hidden
        >
            <div class="flex flex-col gap-(--space-2xs)">
                <p class="font-bold font-sans text-2xl text-balance tracking-tight">No matches.</p>
                <p class="text-base text-text-secondary">
                    Nothing in the library matches
                    &ldquo;<span class="font-mono wrap-anywhere" data-search-echo />&rdquo;.
                </p>
            </div>
            <button
                class="btn"
                data-search-clear
                type="button"
            >
                Clear search
            </button>
        </div>
    </div>
</section>

<style>
    .resources__blocked {
        border: 2px dashed var(--color-border-subtle);
    }

    .resources__blocked > span {
        background-color: var(--slab-fill);
    }

    .resources__card {
        --slab-fill: var(--color-bg-raised);
        border-top: 4px solid var(--kind-color);
    }

    .resources__card,
    .resources__grid > li:not(.hidden) {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        row-gap: 0;
    }

    .resources__grid {
        column-gap: var(--space-lg);
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        row-gap: var(--space-2xl);
    }

    .resources__grid > * {
        min-width: 0;
    }

    .resources__swatch--chip {
        outline: 1px solid var(--color-bg-page);
    }

    @media (max-width: 1024px) {
        .resources__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .resources__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { initFilterGroup, initSearchField, registerPageScript } from '@lib/shared/utils';
    import { initUnlocks } from '@lib/resources/unlocks';

    function describeAssets(shown: number, total: number, isFiltered: boolean, query: string) {
        if (query) return `Showing ${shown} of ${total} assets for \u201c${query}\u201d`;

        return isFiltered ? `Showing ${shown} of ${total} assets` : `Showing all ${total} assets`;
    }

    function initResourcesLibrary(signal: AbortSignal) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.resources__chip');
        const cards = document.querySelectorAll<HTMLElement>('.resource-card');

        if (!buttons.length || !cards.length) return;

        const searchElement = document.querySelector<HTMLInputElement>('[data-search-input]');

        initFilterGroup({
            cards,
            emptyElement: document.querySelector<HTMLElement>('[data-resources-empty]'),
            filters: [
                {
                    buttons,
                    dataKey: 'kind',
                    matches: (card, active) => active.has(card.dataset.kind ?? ''),
                },
            ],
            searchElement,
            signal,
            status: describeAssets,
            statusElement: document.querySelector<HTMLElement>('[data-resources-status]'),
        });

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement,
            signal,
        });
    }

    initUnlocks();
    registerPageScript(initResourcesLibrary);
</script>
