---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { ASSET_KIND_LABELS } from '@lib/constants';
import { formatDateOnly, mergeAssets, toIsoDate } from '@lib/utils';

const assets = mergeAssets(await getCollection('downloads'), await getCollection('docs'));

const kinds = Array.from(new Set(assets.map(asset => asset.data.kind)))
    .map(kind => ({ count: assets.filter(asset => asset.data.kind === kind).length, kind, label: ASSET_KIND_LABELS[kind] }))
    .sort((a, b) => a.label.localeCompare(b.label));
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="resources-title"
>
    <div>
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Downloads & press kit"
            headingId="resources-title"
        >
            Resources.
        </PageHead>
        <p
            class="max-w-2xl mt-6 text-[18px] text-ink-muted"
            data-motion="rise"
        >
            Everything the Alliance hands out in one place &mdash; press material, brand assets,
            event packs, and the working documents behind how the community runs.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="library-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-3xl tracking-tight"
            eyebrow={`Library / ${assets.length} assets`}
            headingId="library-title"
        >
            Asset library
        </SectionHead>
        <div
            class="flex flex-wrap gap-2 mt-10"
            aria-label="Filter by asset kind"
            role="group"
        >
            <button
                class="chip resources__chip is-active active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                aria-pressed="true"
                data-kind=""
                type="button"
            >
                All {assets.length}
            </button>
            {kinds.map(entry => (
                <button
                    class="chip resources__chip active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                    aria-pressed="false"
                    data-kind={entry.kind}
                    type="button"
                >
                    {entry.label} {entry.count}
                </button>
            ))}
        </div>
        <p
            class="label mt-6 text-ink-subtle"
            aria-live="polite"
            data-resources-status
        >
            Showing all {assets.length} assets.
        </p>
        <ul class="resources__grid mt-10 list-none">
            {assets.map(asset => (
                <li
                    id={asset.id}
                    class="resource-card"
                    data-kind={asset.data.kind}
                >
                    <article class="resources__card slab slab--card slab--hover">
                        <header class="flex flex-wrap items-start justify-between gap-2">
                            <p class="label px-2 py-1 bg-ink text-ink-inverse">
                                {ASSET_KIND_LABELS[asset.data.kind]}
                            </p>
                            {asset.data.available && (
                                <p class="label px-2 py-1 bg-accent text-ink">
                                    Published
                                </p>
                            )}
                        </header>
                        <div class="flex flex-col gap-3">
                            <h3 class="font-extrabold font-sans text-xl tracking-tight">
                                {asset.data.title}
                            </h3>
                            <p class="leading-relaxed text-[14px] text-ink-muted">
                                {asset.data.description}
                            </p>
                        </div>
                        <dl class="resources__meta">
                            <div class="resources__meta-row">
                                <dt class="label text-ink-subtle">Format</dt>
                                <dd class="font-mono text-[12px]">{asset.data.format}</dd>
                            </div>
                            <div class="resources__meta-row">
                                <dt class="label text-ink-subtle">Size</dt>
                                <dd
                                    class="font-mono text-[12px]"
                                    data-placeholder
                                >
                                    {asset.data.size}
                                </dd>
                            </div>
                            <div class="resources__meta-row">
                                <dt class="label text-ink-subtle">Updated</dt>
                                <dd class="font-mono text-[12px]">
                                    <time datetime={toIsoDate(asset.data.date)}>{formatDateOnly(asset.data.date)}</time>
                                </dd>
                            </div>
                        </dl>
                        {asset.data.available && asset.data.href
                            ? (
                                    <a
                                        class="btn btn--primary"
                                        href={asset.data.href}
                                    >
                                        Open {asset.data.title} &rarr;
                                    </a>
                                )
                            : (
                                    <p class="resources__blocked action-text flex items-center min-h-[50px] px-4 text-ink-subtle">
                                        Not published yet
                                    </p>
                                )}
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .resources__blocked {
        background-image: repeating-linear-gradient(135deg, var(--color-ink-10) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-ink-20);
    }

    .resources__card {
        --slab-fill: var(--color-surface-raised);
    }

    .resources__card,
    .resources__grid > li:not(.hidden) {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
        row-gap: var(--space-sm);
    }

    .resources__grid {
        display: grid;
        gap: var(--space-lg);
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .resources__grid > * {
        min-width: 0;
    }

    .resources__meta {
        border-top: 1px solid var(--color-ink-20);
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding-top: var(--space-xs);
    }

    .resources__meta-row {
        display: flex;
        gap: var(--space-xs);
        justify-content: space-between;
    }

    @media (max-width: 1024px) {
        .resources__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .resources__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { applyFilter, registerPageScript, rovingFocus } from '@lib/utils';

    let activeKind = '';

    function handleKindClick(button: HTMLButtonElement, buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        activeKind = button.dataset.kind ?? '';
        updateKindFilter(buttons, cards);
    }

    function initResourcesLibrary(signal: AbortSignal) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.resources__chip');
        const cards = document.querySelectorAll<HTMLElement>('.resource-card');

        if (!buttons.length || !cards.length) return;

        activeKind = '';
        updateKindFilter(buttons, cards);
        rovingFocus(buttons, signal);

        buttons.forEach((button) => {
            button.addEventListener('click', () => handleKindClick(button, buttons, cards), { signal });
        });
    }

    function updateKindFilter(buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        applyFilter(buttons, cards, activeKind, 'kind', (card, kind) => !kind || card.dataset.kind === kind);

        const status = document.querySelector<HTMLElement>('[data-resources-status]');
        const shown = Array.from(cards).filter(card => !card.classList.contains('hidden')).length;

        if (!status) return;

        status.textContent = activeKind
            ? `Showing ${shown} of ${cards.length} assets.`
            : `Showing all ${cards.length} assets.`;
    }

    registerPageScript(initResourcesLibrary);
</script>
