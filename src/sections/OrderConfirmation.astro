---

---

<section
    class="py-24"
    aria-label="Order confirmation"
>
    <div class="max-w-[800px] mx-auto px-6 text-center">
        <p id="order-number" class="label mb-6 text-ink-soft">ORDER #APA-00000</p>
        <div class="inline-flex items-center justify-center w-16 h-16 mb-8 bg-coral border-2 border-ink" style="box-shadow: var(--shadow-card-sm);">
            <svg class="text-coral-ink" fill="none" height="28" stroke="currentColor" stroke-width="2.5" viewBox="0 0 28 28" width="28">
                <polyline points="5,14 12,21 23,7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <h1 class="font-sans font-extrabold tracking-[-0.03em] text-5xl md:text-6xl leading-[0.95]">
            Order received.
        </h1>
        <p class="mt-6 text-[18px] text-ink-soft">
            We'll send a confirmation to your email. Orders ship in 14 business days from East Austin.
        </p>
        <div class="mt-12 flex gap-3 justify-center">
            <a class="inline-flex items-center px-6 h-11 btn-text bg-ink text-sand border-2 border-ink hover:bg-coral hover:border-coral transition-colors" href="/merch">Keep shopping</a>
            <a class="inline-flex items-center px-6 h-11 btn-text border-2 border-ink hover:bg-ink hover:text-sand transition-colors" href="/">Home</a>
        </div>
    </div>
</section>

<script>
    const ORDER_ID_MAX = 90_000;
    const ORDER_ID_OFFSET = 10_000;

    const el = document.getElementById('order-number');

    if (el) {
        el.textContent = `ORDER #APA-${Math.floor(Math.random() * ORDER_ID_MAX + ORDER_ID_OFFSET)}`;
    }
</script>
