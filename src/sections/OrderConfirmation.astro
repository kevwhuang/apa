---
import IconCheck from '@components/IconCheck.astro';
---

<section
    class="py-24"
    aria-labelledby="order-title"
>
    <div class="reveal shell shell--prose text-center">
        <p
            class="label mb-6 text-taupe"
            data-order-number
        >
            Order #APA-00000
        </p>
        <div
            class="inline-flex items-center justify-center h-16 w-16 mb-8 border-2 border-ink bg-coral shadow-card-sm"
            aria-hidden="true"
        >
            <IconCheck />
        </div>
        <h1
            id="order-title"
            class="mb-6 font-extrabold font-sans leading-[0.95] text-5xl tracking-[-0.04em] md:text-6xl"
        >
            Order received.
        </h1>
        <p class="mb-12 text-[18px] text-taupe">
            This is a demo store &mdash; no real order was placed and nothing will ship.
        </p>
        <div class="flex justify-center gap-3">
            <a
                class="btn btn--primary h-11"
                href="/store"
            >
                Back to the store
            </a>
            <a
                class="btn h-11"
                href="/"
            >
                Home
            </a>
        </div>
    </div>
</section>

<script>
    const ORDER_ID_MAX = 90_000;
    const ORDER_ID_OFFSET = 10_000;

    function initOrderConfirmation() {
        const element = document.querySelector<HTMLElement>('[data-order-number]');

        if (!element) return;

        element.textContent = `Order #APA-${Math.floor(Math.random() * ORDER_ID_MAX + ORDER_ID_OFFSET)}`;
    }

    document.addEventListener('astro:page-load', initOrderConfirmation);
</script>
