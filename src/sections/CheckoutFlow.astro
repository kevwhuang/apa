---
import PageHead from '@components/PageHead.astro';

const STEPS = ['01 Shipping', '02 Payment', '03 Review'];
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="checkout-title"
>
    <div class="shell shell--narrow">
        <PageHead
            class="font-extrabold font-sans text-5xl tracking-[-0.03em]"
            eyebrow="Checkout"
            headingId="checkout-title"
        >
            Checkout
        </PageHead>
        <ol
            class="reveal flex mt-8 border-2 border-ink"
            aria-label="Checkout steps"
        >
            {STEPS.map((step, index) => (
                <li
                    class:list={[
                        'step flex-1 p-4 font-bold font-mono text-[11px] tracking-wide uppercase',
                        index === 0 ? 'ink-block' : 'bg-sand',
                        index > 0 && 'border-l-2 border-ink',
                    ]}
                    aria-current={index === 0 ? 'step' : undefined}
                >
                    {step}
                </li>
            ))}
        </ol>
    </div>
</section>

<section
    class="py-16"
    aria-label="Checkout form"
>
    <div class="reveal shell shell--narrow grid gap-12 md:grid-cols-[1.5fr_1fr]">
        <form
            class="checkout-form space-y-6"
            novalidate
        >
            <fieldset class="step-pane">
                <legend class="mb-6 font-extrabold font-sans text-2xl tracking-tight">
                    Shipping
                </legend>
                <div class="grid gap-4 mb-4 md:grid-cols-2">
                    <label class="block">
                        <span class="label block mb-2 text-taupe">First name</span>
                        <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="given-name" name="given-name" required />
                    </label>
                    <label class="block">
                        <span class="label block mb-2 text-taupe">Last name</span>
                        <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="family-name" name="family-name" required />
                    </label>
                </div>
                <label class="block mb-4">
                    <span class="label block mb-2 text-taupe">Email</span>
                    <input class="h-11 w-full px-4 border-2 border-ink font-mono text-[13px] bg-transparent" autocomplete="email" name="email" required type="email" />
                </label>
                <label class="block mb-4">
                    <span class="label block mb-2 text-taupe">Street address</span>
                    <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="street-address" name="address" required />
                </label>
                <div class="grid gap-4 md:grid-cols-3">
                    <label class="block">
                        <span class="label block mb-2 text-taupe">City</span>
                        <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="address-level2" name="city" required />
                    </label>
                    <label class="block">
                        <span class="label block mb-2 text-taupe">State</span>
                        <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="address-level1" name="state" required />
                    </label>
                    <label class="block">
                        <span class="label block mb-2 text-taupe">ZIP code</span>
                        <input class="h-11 w-full px-4 border-2 border-ink font-mono bg-transparent" autocomplete="postal-code" name="zip" required />
                    </label>
                </div>
            </fieldset>
            <fieldset class="step-pane hidden">
                <legend class="mb-6 font-extrabold font-sans text-2xl tracking-tight">
                    Payment
                </legend>
                <label class="block mb-4">
                    <span class="label block mb-2 text-taupe">Card number</span>
                    <input class="h-11 w-full px-4 border-2 border-ink font-mono bg-transparent" autocomplete="cc-number" inputmode="numeric" name="cc-number" required />
                </label>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <label class="block">
                        <span class="label block mb-2 text-taupe">Expiration date</span>
                        <input class="h-11 w-full px-4 border-2 border-ink font-mono bg-transparent" autocomplete="cc-exp" name="cc-exp" placeholder="MM / YY" required />
                    </label>
                    <label class="block">
                        <span class="label block mb-2 text-taupe">Security code</span>
                        <input class="h-11 w-full px-4 border-2 border-ink font-mono bg-transparent" autocomplete="cc-csc" inputmode="numeric" name="cc-csc" required />
                    </label>
                </div>
                <label class="block mb-4">
                    <span class="label block mb-2 text-taupe">Name on card</span>
                    <input class="h-11 w-full px-4 border-2 border-ink bg-transparent" autocomplete="cc-name" name="cc-name" required />
                </label>
                <p class="label text-coral-dark">Demo only / no real payment processed</p>
            </fieldset>
            <fieldset class="step-pane hidden">
                <legend class="mb-6 font-extrabold font-sans text-2xl tracking-tight">
                    Review
                </legend>
                <ul class="review-list mb-6 border-2 border-ink list-none" />
                <p class="text-[14px] text-taupe">
                    By placing this order you agree to our <a class="hover:text-coral-dark decoration-2 decoration-coral underline underline-offset-4 transition-colors" href="/terms">terms</a>.
                </p>
            </fieldset>
            <div class="flex justify-between gap-4">
                <button
                    class="btn checkout-back invisible h-11"
                    type="button"
                >
                    Back
                </button>
                <button
                    class="btn btn--primary checkout-next h-11"
                    type="submit"
                >
                    Continue
                </button>
            </div>
        </form>
        <aside class="self-start p-6 border-2 border-ink bg-cream">
            <h2 class="label mb-4 text-taupe">Summary</h2>
            <ul class="summary-list mb-4 space-y-3 list-none text-[14px]" />
            <dl class="pt-4 space-y-1.5 border-t-2 border-ink font-mono text-[14px]">
                <div class="flex justify-between">
                    <dt>Subtotal</dt>
                    <dd data-subtotal>$0.00</dd>
                </div>
                <div class="flex justify-between">
                    <dt>Shipping</dt>
                    <dd data-shipping>&mdash;</dd>
                </div>
                <div class="flex justify-between">
                    <dt>Tax</dt>
                    <dd data-tax>$0.00</dd>
                </div>
                <div class="flex justify-between mt-2 pt-2 border-t-2 border-ink font-extrabold font-sans text-lg">
                    <dt>Total</dt>
                    <dd data-total>$0.00</dd>
                </div>
            </dl>
        </aside>
    </div>
</section>

<script>
    import { navigate } from 'astro:transitions/client';

    import { clear, getItems, subtotalCents } from '@lib/store';
    import { escapeHtml, formatPrice, formatVariant, PALETTE } from '@lib/utils';

    const LAST_STEP = 2;
    const SHIPPING_CENTS = 800;
    const TAX_RATE = 0.0825;

    const cardColors = PALETTE.slice(0, 4);

    let checkoutController: AbortController | undefined;
    let step = 0;

    function handleBackClick(backButton: HTMLElement, nextButton: HTMLElement, panes: NodeListOf<HTMLElement>, steps: NodeListOf<HTMLElement>) {
        step = Math.max(0, step - 1);
        updateSteps(backButton, nextButton, panes, steps);
    }

    function handleFormSubmit(event: SubmitEvent, backButton: HTMLElement, nextButton: HTMLElement, panes: NodeListOf<HTMLElement>, steps: NodeListOf<HTMLElement>) {
        event.preventDefault();

        const pane = panes[step];

        if (!pane) return;

        const inputs = pane.querySelectorAll<HTMLInputElement>('input');

        for (const input of inputs) {
            if (!input.checkValidity()) {
                input.reportValidity();

                return;
            }
        }

        if (step < LAST_STEP) {
            step++;
            updateSteps(backButton, nextButton, panes, steps);
            renderReview();
        } else {
            clear();
            navigate('/store/order');
        }
    }

    function initCheckoutFlow() {
        checkoutController?.abort();
        checkoutController = new AbortController();

        const { signal } = checkoutController;

        const backButton = document.querySelector<HTMLButtonElement>('.checkout-back');
        const form = document.querySelector<HTMLFormElement>('.checkout-form');
        const nextButton = document.querySelector<HTMLButtonElement>('.checkout-next');
        const panes = document.querySelectorAll<HTMLElement>('.step-pane');
        const steps = document.querySelectorAll<HTMLElement>('.step');

        if (!backButton || !form || !nextButton) return;

        step = 0;
        updateSteps(backButton, nextButton, panes, steps);
        renderSummary();

        if (getItems().length === 0) nextButton.disabled = true;

        backButton.addEventListener('click', () => handleBackClick(backButton, nextButton, panes, steps), { signal });
        form.addEventListener('submit', event => handleFormSubmit(event, backButton, nextButton, panes, steps), { signal });
    }

    function renderReview() {
        const list = document.querySelector<HTMLElement>('.review-list');

        if (!list) return;

        list.innerHTML = getItems().map((item, index) => `
            <li class='flex items-center gap-4 p-4 ${index > 0 ? 'border-t-2 border-ink' : ''}'>
                <div class='flex items-center justify-center overflow-hidden relative shrink-0 h-14 w-14' style='background: ${cardColors[index % cardColors.length]};'>
                    <div class='halftone absolute inset-0' aria-hidden='true'></div>
                </div>
                <div class='flex-1'>
                    <p class='font-bold font-sans'>${escapeHtml(item.title)}</p>
                    <p class='label text-taupe'>${[escapeHtml(formatVariant(item)), `\u00d7 ${item.quantity}`].filter(Boolean).join(' / ')}</p>
                </div>
                <p class='font-bold font-mono'>${formatPrice(item.priceCents * item.quantity)}</p>
            </li>
        `).join('');
    }

    function renderSummary() {
        const list = document.querySelector<HTMLElement>('.summary-list');

        if (list) {
            list.innerHTML = getItems().map(item => `
                <li class='flex justify-between gap-2'>
                    <span>${item.quantity} \u00d7 ${escapeHtml(item.title)}<br><span class='label text-taupe'>${escapeHtml(formatVariant(item))}</span></span>
                    <span class='font-bold font-mono'>${formatPrice(item.priceCents * item.quantity)}</span>
                </li>
            `).join('');
        }

        const subtotal = subtotalCents();
        const tax = Math.round(subtotal * TAX_RATE);
        const total = subtotal + tax + (subtotal > 0 ? SHIPPING_CENTS : 0);

        const shippingOutput = document.querySelector('[data-shipping]');
        const subtotalOutput = document.querySelector('[data-subtotal]');
        const taxOutput = document.querySelector('[data-tax]');
        const totalOutput = document.querySelector('[data-total]');

        if (shippingOutput) shippingOutput.textContent = subtotal > 0 ? formatPrice(SHIPPING_CENTS) : '\u2014';
        if (subtotalOutput) subtotalOutput.textContent = formatPrice(subtotal);
        if (taxOutput) taxOutput.textContent = formatPrice(tax);
        if (totalOutput) totalOutput.textContent = formatPrice(total);
    }

    function updateSteps(backButton: HTMLElement, nextButton: HTMLElement, panes: NodeListOf<HTMLElement>, steps: NodeListOf<HTMLElement>) {
        steps.forEach((item, index) => {
            item.classList.toggle('ink-block', index <= step);
            item.classList.toggle('bg-sand', index > step);

            if (index === step) item.setAttribute('aria-current', 'step');
            else item.removeAttribute('aria-current');
        });

        panes.forEach((pane, index) => pane.classList.toggle('hidden', index !== step));
        backButton.classList.toggle('invisible', step === 0);
        nextButton.textContent = step === LAST_STEP ? 'Place order' : 'Continue';
    }

    document.addEventListener('astro:page-load', initCheckoutFlow);
</script>
