---
import PageHead from '@components/shared/PageHead.astro';
import { LINKS } from '@lib/shared/constants';

const DETAILS: { detail: string; href?: string; term: string }[] = [
    { detail: 'The fourth Tuesday of the month', term: 'When' },
    { detail: 'A borrowed room, announced to members ahead of the date', term: 'Where' },
    { detail: 'A track or a project file for feedback, or gear to pass around', term: 'Bring' },
    { detail: 'One on one or in small groups, with plenty of time to socialize', term: 'Feedback' },
    { detail: 'meetup.com', href: LINKS.meetup, term: 'RSVP' },
];
---

<section
    class="stage stage--hangout stage--tight"
    aria-labelledby="hangout-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-4xl text-7xl max-md:text-5xl"
            headingId="hangout-title"
        >
            Bring a track,<br />
            <span class="text-text-brand">keep it loose</span>
        </PageHead>
        <div class="grid grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] items-start gap-(--space-2xl) max-lg:grid-cols-1">
            <aside
                class="hangout-hero__card slab slab--bare slab--lift slab--still overflow-clip"
                aria-labelledby="hangout-details-title"
                data-motion="unfold"
            >
                <h2
                    id="hangout-details-title"
                    class="p-(--space-lg) font-display text-2xl"
                >
                    How a Hangout runs
                </h2>
                <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-px border-border-on-brand border-t bg-border-on-brand max-lg:grid-cols-2 max-md:grid-cols-1">
                    {DETAILS.map(item => (
                        <div class:list={['col-span-full content-start grid grid-cols-subgrid items-baseline gap-x-(--space-md) gap-y-(--space-xs) px-(--space-lg) py-(--space-sm) bg-event-hangout max-lg:grid-cols-1 max-lg:py-(--space-lg)', !item.href && 'max-lg:col-auto']}>
                            <dt class="label">{item.term}</dt>
                            <dd>
                                {item.href
                                    ? (
                                            <a
                                                class="active:translate-y-px hover:text-link-on-brand inline-block underline underline-offset-4 transition-[color,translate]"
                                                href={item.href}
                                                rel="noopener noreferrer"
                                                target="_blank"
                                            >
                                                {item.detail}
                                                <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                            </a>
                                        )
                                    : item.detail}
                            </dd>
                        </div>
                    ))}
                </dl>
            </aside>
            <div class="flex flex-col gap-5">
                <p
                    class="text-lg text-text-secondary"
                    data-motion="blur"
                >
                    Hangout is the Alliance's monthly pop-up social for track feedback and conversation, held midway between Assemblies.
                </p>
                <p
                    class="text-text-secondary"
                    data-motion="rise"
                >
                    Three hours on a midweek evening. People bring a track, a project file, or a piece of gear,
                    and feedback happens one on one or in small groups. That leaves time to talk through a mix
                    and get to know the person who made it.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .hangout-hero__card {
        --color-focus-ring: var(--color-focus-ring-on-brand);
        --slab-fill: var(--color-event-hangout);
        color: var(--color-event-hangout-text);
    }
</style>
