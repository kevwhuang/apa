---
import PageHead from '@components/shared/PageHead.astro';

const CLASS_DETAIL_ROW = 'col-span-full content-start grid grid-cols-subgrid items-baseline gap-x-(--space-md) gap-y-3 px-(--space-lg) py-4 bg-event-hangout max-lg:col-auto max-lg:grid-cols-1 max-lg:py-(--space-lg)';

const DETAILS: { detail: string; term: string }[] = [
    { detail: 'Open to everyone', term: 'Who' },
    { detail: 'A track, project, or gear', term: 'What' },
    { detail: 'Fourth Tuesday, 7 to 10 PM', term: 'When' },
    { detail: 'A different spot each month', term: 'Where' },
    { detail: 'Feedback and good company', term: 'Why' },
];
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="hangout-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-4xl text-5xl-7xl"
            headingId="hangout-title"
        >
            Fresh ears,<br />
            <span class="text-text-brand">new faces</span>
        </PageHead>
        <div class="grid grid-cols-2 items-start gap-(--space-2xl) max-lg:grid-cols-1">
            <aside
                class="hangout-hero__card slab slab--bare slab--card overflow-clip"
                aria-labelledby="hangout-details-title"
                data-motion="unfold"
            >
                <h2
                    id="hangout-details-title"
                    class="p-(--space-lg) font-display text-2xl"
                >
                    How a Hangout runs
                </h2>
                <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-px border-border-on-brand border-t bg-border-on-brand max-lg:grid-cols-2 max-md:grid-cols-1">
                    {DETAILS.map(item => (
                        <div class={CLASS_DETAIL_ROW}>
                            <dt class="label">{item.term}</dt>
                            <dd>{item.detail}</dd>
                        </div>
                    ))}
                </dl>
            </aside>
            <div class="flex flex-col self-center gap-5">
                <p
                    class="text-lg text-text-secondary"
                    data-motion="blur"
                >
                    The Alliance's monthly pop-up social for conversation and feedback lands midway between Assemblies.
                </p>
                <p
                    class="text-text-secondary"
                    data-motion="rise"
                >
                    Producers drop in and get to know one another. Evenings center on good
                    company and conversation about life outside the studio. Anyone who brings a
                    track is welcome to play it for the room. The night stays casual and goes
                    until closing.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .hangout-hero__card {
        --slab-fill: var(--color-event-hangout);
        color: var(--color-event-hangout-text);
    }
</style>
