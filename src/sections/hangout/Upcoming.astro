---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/shared/utils';

const events = await getCollection('events');

const program = getProgram('hangout');

const upcoming = events
    .filter(event => event.data.type === 'hangout' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);

const [next, ...later] = upcoming;
---

<section
    class="stage stage--hangout stage--tight border-b-2 border-border-strong"
    aria-labelledby="hangout-upcoming-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            eyebrow={`${program.shortName} / planned`}
            headingId="hangout-upcoming-title"
        >
            On the calendar
        </SectionHead>
        {next
            ? (
                    <Fragment>
                        <div
                            class:list={['mark', later.length > 0 ? 'mb-(--space-2xl)' : 'mb-8']}
                            data-motion="unfold"
                        >
                            <article
                                id={next.id}
                                class="slab slab--cut slab--lift grid grid-cols-12 items-start gap-x-2 gap-y-5 md:gap-x-6"
                            >
                                <div class="col-span-12 md:col-span-5 lg:col-span-4">
                                    <p class="label inline-block mb-3 px-2 py-1 bg-event-hangout text-event-hangout-text">
                                        Next date
                                    </p>
                                    <p
                                        class="mb-2 font-bold font-display leading-[0.95] text-3xl text-balance tracking-[-0.02em]"
                                        data-placeholder
                                    >
                                        <time datetime={next.data.date.toISOString()}>{formatDate(next.data.date)}</time>
                                    </p>
                                    <p
                                        class="font-mono text-xs uppercase text-text-secondary"
                                        data-placeholder
                                    >
                                        {formatTimeRange(next.data.date, next.data.end)}
                                    </p>
                                </div>
                                <div class="col-span-12 md:col-span-7 lg:col-span-8">
                                    <h3 class="mb-2 font-display text-3xl">
                                        {next.data.title}
                                    </h3>
                                    <address class="mb-3 font-mono not-italic text-xs uppercase text-text-secondary">
                                        {next.data.location}
                                    </address>
                                    <p class="max-w-2xl mb-4 leading-relaxed text-text-secondary">
                                        {next.data.excerpt}
                                    </p>
                                    <p>
                                        <a
                                            class="action-text hover:text-link inline-flex items-center gap-(--space-2xs) min-h-(--control-size) underline underline-offset-4 transition-colors"
                                            href={LINKS.meetup}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            RSVP on Meetup <IconArrow />
                                            <span class="sr-only">&nbsp;(opens in a new tab)</span>
                                        </a>
                                    </p>
                                </div>
                            </article>
                        </div>
                        {later.length > 0 && (
                            <Fragment>
                                <p
                                    class="label mb-4 text-text-secondary"
                                    data-motion="stamp"
                                >
                                    And after that
                                </p>
                                <ol
                                    class="mb-8 list-none"
                                    data-motion-stagger="rise"
                                >
                                    {later.map(event => (
                                        <li
                                            id={event.id}
                                            class="rank items-baseline py-4 border-b-2 border-border-strong"
                                        >
                                            <div>
                                                <p
                                                    class="mb-1 font-bold font-sans text-lg"
                                                    data-placeholder
                                                >
                                                    <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                                                </p>
                                                <p
                                                    class="font-mono text-xs uppercase text-text-secondary"
                                                    data-placeholder
                                                >
                                                    {formatTimeRange(event.data.date, event.data.end)}
                                                </p>
                                            </div>
                                            <h3 class="text-lg">
                                                {event.data.title}
                                            </h3>
                                            <address class="hangout-next__meta font-mono not-italic text-xs uppercase text-text-secondary">
                                                {event.data.location}
                                            </address>
                                        </li>
                                    ))}
                                </ol>
                            </Fragment>
                        )}
                    </Fragment>
                )
            : (
                    <p
                        class="max-w-(--measure-form) mb-8 text-text-secondary"
                        data-motion="rise"
                    >
                        Nothing yet &mdash; the {program.name} has not launched, and the first date
                        goes up as soon as the room is booked.
                    </p>
                )}
        <p data-motion="rise">
            <a
                class="action-text hover:text-link inline-flex items-center gap-2 min-h-(--control-size) transition-colors"
                href="/events"
            >
                See the full calendar <IconArrow />
            </a>
        </p>
    </div>
</section>

<style>
    .hangout-next__meta {
        text-align: right;
    }

    @media (max-width: 768px) {
        .hangout-next__meta {
            text-align: left;
        }
    }
</style>
