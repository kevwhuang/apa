---
import { getCollection } from 'astro:content';

import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/utils';

const program = getProgram('hangout');

const events = await getCollection('events');
const upcoming = events
    .filter(event => event.data.type === 'hangout' && event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date);

const [next, ...later] = upcoming;
---

<section
    class="stage stage--hangout stage--tight border-b-2 border-ink"
    aria-labelledby="hangout-upcoming-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId="hangout-upcoming-title"
        >
            Next up
        </SectionHead>
        {next
            ? (
                    <Fragment>
                        <div
                            class="mark"
                            data-motion="unfold"
                        >
                            <article
                                id={next.id}
                                class="slab slab--cut slab--lift grid grid-cols-12 items-start gap-x-6 gap-y-5"
                            >
                                <div class="col-span-12 md:col-span-4">
                                    <p class="label inline-block mb-3 px-2 py-0.5 bg-accent text-ink">
                                        Next date
                                    </p>
                                    <p
                                        class="font-extrabold font-sans leading-[0.95] text-4xl tracking-tight"
                                        data-placeholder
                                    >
                                        <time datetime={next.data.date.toISOString()}>{formatDate(next.data.date)}</time>
                                    </p>
                                    <p
                                        class="mt-2 font-mono text-xs uppercase text-ink-muted"
                                        data-placeholder
                                    >
                                        {formatTimeRange(next.data.date, next.data.end)}
                                    </p>
                                </div>
                                <div class="col-span-12 md:col-span-8">
                                    <h3 class="font-extrabold font-sans text-3xl tracking-tight">
                                        {next.data.title}
                                    </h3>
                                    <address class="mt-2 font-mono not-italic text-xs uppercase text-ink-muted">
                                        {next.data.location}
                                    </address>
                                    <p class="max-w-2xl mt-3 leading-relaxed text-ink-muted">
                                        {next.data.excerpt}
                                    </p>
                                    <p class="mt-4">
                                        <a
                                            class="action-text hangout-next__rsvp hover:text-accent-deep underline underline-offset-4 transition-colors"
                                            href={LINKS.meetup}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            RSVP on Meetup &rarr;
                                            <span class="sr-only"> (opens in a new tab)</span>
                                        </a>
                                    </p>
                                </div>
                            </article>
                        </div>
                        {later.length > 0 && (
                            <Fragment>
                                <p class="label mb-4 mt-16 text-ink-muted">And after that</p>
                                <ol
                                    class="list-none"
                                    data-motion-stagger="rise"
                                >
                                    {later.map(event => (
                                        <li
                                            id={event.id}
                                            class="rank items-baseline py-4 border-b-2 border-ink"
                                        >
                                            <div>
                                                <p
                                                    class="font-bold font-sans text-lg"
                                                    data-placeholder
                                                >
                                                    <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                                                </p>
                                                <p
                                                    class="mt-1 font-mono text-xs uppercase text-ink-muted"
                                                    data-placeholder
                                                >
                                                    {formatTimeRange(event.data.date, event.data.end)}
                                                </p>
                                            </div>
                                            <h3 class="font-extrabold font-sans text-lg tracking-tight">
                                                {event.data.title}
                                            </h3>
                                            <address class="hangout-next__meta font-mono not-italic text-xs uppercase text-ink-muted">
                                                {event.data.location}
                                            </address>
                                        </li>
                                    ))}
                                </ol>
                            </Fragment>
                        )}
                    </Fragment>
                )
            : (
                    <p
                        class="text-ink-muted"
                        data-motion="rise"
                    >
                        Nothing on the calendar right now &mdash; the next date goes up as soon as
                        the room is booked.
                    </p>
                )}
        <p class="mt-8">
            <a
                class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] transition-colors"
                href="/events"
            >
                See the full calendar &rarr;
            </a>
        </p>
    </div>
</section>

<style>
    .hangout-next__meta {
        text-align: right;
    }

    .hangout-next__rsvp {
        align-items: center;
        display: inline-flex;
        min-height: 50px;
    }

    @media (max-width: 768px) {
        .hangout-next__meta {
            text-align: left;
        }
    }
</style>
