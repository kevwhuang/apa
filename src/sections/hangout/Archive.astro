---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { formatDate, formatTimeRange } from '@lib/shared/utils';

const events = await getCollection('events');

const past = events
    .filter(event => event.data.type === 'hangout' && event.data.status === 'past')
    .sort((a, b) => +b.data.date - +a.data.date);
---

<section
    class="stage stage--hangout stage--tight"
    aria-labelledby="hangout-past-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-4xl tracking-tight"
            eyebrow={`Archive / ${past.length} on file`}
            headingId="hangout-past-title"
        >
            Evenings already spent
        </SectionHead>
        <ol
            class="hangout-archive list-none"
            data-motion-stagger="rise"
        >
            {past.map(event => (
                <li class="tilt">
                    <article
                        id={event.id}
                        class="hangout-archive__card slab slab--card"
                    >
                        <p
                            class="label mb-2 text-accent-deep"
                            data-placeholder
                        >
                            <time datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
                        </p>
                        <h3 class="mb-2 font-extrabold font-sans text-2xl tracking-tight">
                            {event.data.title}
                        </h3>
                        <address class="mb-1 font-mono not-italic text-xs uppercase text-ink-muted">
                            {event.data.location}
                        </address>
                        <p
                            class="mb-3 font-mono text-2xs uppercase text-ink-subtle"
                            data-placeholder
                        >
                            {formatTimeRange(event.data.date, event.data.end)}
                        </p>
                        <p class="leading-relaxed text-sm text-ink-muted">
                            {event.data.excerpt}
                        </p>
                    </article>
                </li>
            ))}
        </ol>
        <p data-motion="rise">
            <a
                class="action-text hover:text-accent-deep inline-flex items-center gap-2 min-h-(--control-size) transition-colors"
                href="/events#past-title"
            >
                The full archive, every program <IconArrow />
            </a>
        </p>
    </div>
</section>

<style>
    .hangout-archive {
        column-gap: var(--space-lg);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(48px - var(--space-lg));
        row-gap: 0;
    }

    .hangout-archive > li {
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding-bottom: var(--space-lg);
    }

    .hangout-archive__card {
        align-content: start;
        display: grid;
        grid-row: span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    @media (max-width: 1024px) {
        .hangout-archive {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .hangout-archive {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
