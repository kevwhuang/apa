---
import IconPause from '@components/icons/Pause.astro';
import IconPlay from '@components/icons/Play.astro';
import IconUpload from '@components/icons/Upload.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import {
    CHORUS_DEPTH_DEFAULT,
    CHORUS_RATE_DEFAULT,
    COMPRESSOR_RATIO_DEFAULT,
    COMPRESSOR_THRESHOLD_DEFAULT,
    DELAY_FEEDBACK_DEFAULT,
    DELAY_TIME_DEFAULT,
    FILTER_RESONANCE_DEFAULT,
    GATE_THRESHOLD_DEFAULT,
    HIGHPASS_RESONANCE_DEFAULT,
    LIMITER_THRESHOLD_DEFAULT,
    PAN_POSITION_DEFAULT,
    REVERB_DECAY_DEFAULT,
    REVERB_WET_DEFAULT,
    SATURATOR_DRIVE_DEFAULT,
    TREMOLO_DEPTH_DEFAULT,
    TREMOLO_RATE_DEFAULT,
    TRIM_GAIN_DEFAULT,
} from '@lib/audio/sandbox/blocks';
import { MODULE_NAMES } from '@lib/audio/sandbox/rack';
import { SANDBOX_EXTENSION_LIST } from '@lib/audio/sandbox/loader';
import { UPLOAD } from '@lib/constants';
import { formatBytes } from '@lib/utils';

interface Module {
    blurb: string;
    id: string;
    kind: keyof typeof MODULE_NAMES;
    readout?: string;
    role: string;
    sliders: ModuleSlider[];
    viz?: 'canvas' | 'readout';
    well?: boolean;
}

interface ModuleSlider {
    display: string;
    label: string;
    max: number;
    min: number;
    param: string;
    step: number;
    value: number;
}

const MODULES: Module[] = [
    {
        blurb: 'Sets the level running into everything downstream. Pull it back before you drive the saturator, or lean on it to push the compressor harder.',
        id: 'tare',
        kind: 'trim',
        role: 'Input trim',
        sliders: [
            { display: '+0.0 dB', label: 'Gain', max: 12, min: -24, param: 'gain', step: 0.5, value: TRIM_GAIN_DEFAULT },
        ],
    },
    {
        blurb: 'Cuts everything under the corner, where rumble and mud collect. The scale is logarithmic, and a high Q rings the corner itself.',
        id: 'ridge',
        kind: 'highpass',
        role: 'High-pass filter',
        sliders: [
            { display: '126 Hz', label: 'Cutoff', max: 1, min: 0, param: 'cutoff', step: 0.001, value: 0.4 },
            { display: 'Q 1.0', label: 'Reso', max: 12, min: 0.5, param: 'resonance', step: 0.1, value: HIGHPASS_RESONANCE_DEFAULT },
        ],
    },
    {
        blurb: 'The other end of the same idea \u2014 a resonant low-pass. Sweep the cutoff against a running loop and raise Q until the corner sings.',
        id: 'sieve',
        kind: 'filter',
        role: 'Low-pass filter',
        sliders: [
            { display: '1.15 kHz', label: 'Cutoff', max: 1, min: 0, param: 'cutoff', step: 0.001, value: 0.55 },
            { display: 'Q 4.0', label: 'Reso', max: 18, min: 0.5, param: 'resonance', step: 0.1, value: FILTER_RESONANCE_DEFAULT },
        ],
    },
    {
        blurb: 'Low and high shelves around a fixed mid band. Boost or cut either end and the tilt lands on the chain immediately.',
        id: 'ledger',
        kind: 'eq',
        role: 'Equalizer',
        sliders: [
            { display: '+4.0 dB', label: 'Low', max: 12, min: -12, param: 'low', step: 0.5, value: 4 },
            { display: '+3.0 dB', label: 'High', max: 12, min: -12, param: 'high', step: 0.5, value: 3 },
        ],
    },
    {
        blurb: 'An RMS watcher opens and closes a gain stage with fast ramps. Set the threshold above the noise floor and below the hits.',
        id: 'latch',
        kind: 'gate',
        readout: 'Gate closed',
        role: 'Noise gate',
        sliders: [
            { display: '-45 dB', label: 'Thresh', max: -10, min: -70, param: 'threshold', step: 1, value: GATE_THRESHOLD_DEFAULT },
        ],
        viz: 'readout',
    },
    {
        blurb: 'Pull the threshold down until the gain-reduction readout moves, then set how hard it leans once the signal crosses the line.',
        id: 'clamp',
        kind: 'compressor',
        readout: 'GR 0.0 dB',
        role: 'Compressor',
        sliders: [
            { display: '-28 dB', label: 'Thresh', max: 0, min: -60, param: 'threshold', step: 1, value: COMPRESSOR_THRESHOLD_DEFAULT },
            { display: '4.0:1', label: 'Ratio', max: 20, min: 1, param: 'ratio', step: 0.5, value: COMPRESSOR_RATIO_DEFAULT },
        ],
        viz: 'readout',
    },
    {
        blurb: 'A tanh drive curve, oversampled 4x, with makeup gain tied to drive so the level stays honest. It sits ahead of the time effects, so the repeats inherit the dirt.',
        id: 'grit',
        kind: 'saturator',
        role: 'Saturator',
        sliders: [
            { display: '3.0', label: 'Drive', max: 10, min: 1, param: 'drive', step: 0.1, value: SATURATOR_DRIVE_DEFAULT },
        ],
        well: true,
    },
    {
        blurb: 'Two modulated delay lines run against the dry path. Rate moves the LFO, depth widens the sweep either side of it.',
        id: 'swell',
        kind: 'chorus',
        role: 'Chorus',
        sliders: [
            { display: '1.20 Hz', label: 'Rate', max: 5, min: 0.1, param: 'rate', step: 0.05, value: CHORUS_RATE_DEFAULT },
            { display: '50%', label: 'Depth', max: 1, min: 0, param: 'depth', step: 0.01, value: CHORUS_DEPTH_DEFAULT },
        ],
    },
    {
        blurb: 'One LFO on one gain stage \u2014 amplitude modulation, nothing more. Rate is the speed of the pulse, depth is how far each dip falls.',
        id: 'flutter',
        kind: 'tremolo',
        role: 'Tremolo',
        sliders: [
            { display: '4.5 Hz', label: 'Rate', max: 12, min: 0.1, param: 'rate', step: 0.1, value: TREMOLO_RATE_DEFAULT },
            { display: '60%', label: 'Depth', max: 1, min: 0, param: 'depth', step: 0.01, value: TREMOLO_DEPTH_DEFAULT },
        ],
    },
    {
        blurb: 'An equal-power panner across the stereo field. Center is dead ahead, and either edge leaves you with a single speaker.',
        id: 'bearing',
        kind: 'pan',
        role: 'Stereo panner',
        sliders: [
            { display: 'Center', label: 'Position', max: 1, min: -1, param: 'position', step: 0.01, value: PAN_POSITION_DEFAULT },
        ],
    },
    {
        blurb: 'Time and feedback into a real feedback loop, capped just short of self-oscillation. Long times with high feedback stack up fast.',
        id: 'offset',
        kind: 'delay',
        role: 'Delay',
        sliders: [
            { display: '0.35 s', label: 'Time', max: 1, min: 0.05, param: 'time', step: 0.01, value: DELAY_TIME_DEFAULT },
            { display: '45%', label: 'Feedback', max: 0.85, min: 0, param: 'feedback', step: 0.01, value: DELAY_FEEDBACK_DEFAULT },
        ],
    },
    {
        blurb: 'Convolution against a noise impulse that regenerates whenever the decay changes. Wet sets how much of the room reaches the output.',
        id: 'chamber',
        kind: 'reverb',
        role: 'Reverb',
        sliders: [
            { display: '2.4 s', label: 'Decay', max: 6, min: 0.2, param: 'decay', step: 0.1, value: REVERB_DECAY_DEFAULT },
            { display: '40%', label: 'Wet', max: 1, min: 0, param: 'wet', step: 0.01, value: REVERB_WET_DEFAULT },
        ],
        well: true,
    },
    {
        blurb: 'A 20:1 brickwall with a 1 ms attack, sitting last before the analysis stages. Drag the ceiling down and the readout catches every peak.',
        id: 'ceiling',
        kind: 'limiter',
        readout: 'Ceiling -12.0 dB \u00b7 GR 0.0 dB',
        role: 'Limiter',
        sliders: [
            { display: '-12.0 dB', label: 'Ceiling', max: 0, min: -30, param: 'threshold', step: 0.5, value: LIMITER_THRESHOLD_DEFAULT },
        ],
        viz: 'readout',
    },
    {
        blurb: 'A passthrough level meter reading whatever reaches it. The bars run while the rack plays and rest the moment it stops.',
        id: 'needle',
        kind: 'meter',
        role: 'Metering',
        sliders: [],
        viz: 'canvas',
    },
    {
        blurb: 'Autocorrelation on the signal at this point in the chain: hertz, nearest note, cents off. Feed it something monophonic \u2014 chords read as nonsense.',
        id: 'pitchfork',
        kind: 'tuner',
        readout: '\u2014',
        role: 'Tuner',
        sliders: [],
        viz: 'readout',
    },
];

const PAD_LENGTH = 2;
---

<section
    class="sandbox__hero stage stage--overhang stage--tight border-b-2 border-ink"
    aria-labelledby="sandbox-title"
>
    <div>
        <PageHead
            class="max-w-4xl font-extrabold font-sans leading-[0.9] text-6xl tracking-[-0.04em] md:text-8xl"
            eyebrow="Resources / Sandbox"
            headingId="sandbox-title"
        >
            One rack, live.
        </PageHead>
        <p
            class="max-w-2xl mt-6 text-lmd text-ink-muted"
            data-motion="blur"
        >
            Fifteen Web Audio processors wired as a single chain in your browser &mdash; no
            install, no license server. Load one file at the top, switch modules in and out of the
            signal path, and hear the rack change under you.
        </p>
    </div>
    <aside
        class="mark slab slab--accent flex flex-wrap items-center gap-4"
        aria-label="How the rack works"
        data-motion="unfold"
    >
        <p class="action-text sandbox__flag px-3 py-2">Live processing</p>
        <p class="max-w-2xl text-smd">
            Files stay in this browser &mdash; nothing uploads. The rack takes&#32;
            {SANDBOX_EXTENSION_LIST} up to {formatBytes(UPLOAD.maxDecodeBytes)}, and it plays
            through the site player.
        </p>
    </aside>
</section>

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="rack-title"
>
    <div
        class="mark rack slab slab--well"
        data-motion="unfold"
        data-rack-master
    >
        <div class="rack__head">
            <p class="label rack__eyebrow">Master / One source</p>
            <h2
                id="rack-title"
                class="font-extrabold font-sans text-2xl tracking-tight"
            >
                Load a file. Build the chain.
            </h2>
        </div>
        <label
            class="rack__drop"
            data-rack-drop
            for="rack-file"
        >
            <IconUpload />
            <span class="action-text">Drop audio or browse</span>
            <span class="rack__hint font-mono text-xs">
                {SANDBOX_EXTENSION_LIST} up to {formatBytes(UPLOAD.maxDecodeBytes)}
            </span>
            <input
                id="rack-file"
                class="sr-only"
                accept={UPLOAD.acceptAttribute}
                aria-label="Load an audio file into the rack"
                data-rack-input
                type="file"
            />
        </label>
        <div class="rack__deck">
            <button
                class="rack__play"
                aria-pressed="false"
                data-rack-toggle
                disabled
                type="button"
            >
                <span data-rack-icon-play><IconPlay /></span>
                <span
                    data-rack-icon-pause
                    hidden
                >
                    <IconPause />
                </span>
                <span
                    class="sr-only"
                    data-rack-toggle-label
                >
                    Play the rack
                </span>
            </button>
            <div class="rack__status">
                <p
                    class="rack__meta font-mono text-smd"
                    aria-live="polite"
                    data-rack-meta
                >
                    <span
                        class="spinner"
                        aria-hidden="true"
                        data-rack-spinner
                        hidden
                    />
                    <span
                        class="rack__meta-text"
                        data-rack-meta-text
                    >
                        No file loaded
                    </span>
                </p>
                <p
                    class="rack__error font-mono text-xs"
                    aria-live="polite"
                    data-rack-error
                />
            </div>
        </div>
        <div class="rack__signal">
            <p class="label rack__signal-label">Signal path</p>
            <ol
                class="rack__path list-none"
                data-rack-path
            >
                <li class="rack__node">In</li>
                <li
                    class="rack__node rack__node--idle"
                    data-rack-idle
                >
                    Straight through
                </li>
                <li class="rack__node">Out</li>
            </ol>
        </div>
        <div class="rack__notes">
            <p class="rack__note text-smd">
                Files stay in this browser &mdash; nothing uploads, and nothing is kept.
            </p>
            <p class="label rack__dock">
                Transport and active plugins also live in the site player.
            </p>
        </div>
        <template data-rack-chip>
            <li
                class="rack__node rack__node--plug"
                data-rack-plug
            />
        </template>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="modules-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-3xl tracking-tight"
            eyebrow={`Rack / ${MODULES.length} modules`}
            headingId="modules-title"
        >
            The modules, in signal order
        </SectionHead>
        <ul
            class="rank sandbox__grid list-none"
            data-motion-from="center"
            data-motion-stagger="flip"
        >
            {MODULES.map((module, index) => (
                <li class="sandbox__tile">
                    <article
                        id={module.id}
                        class:list={[
                            'module sandbox__card slab slab--card',
                            module.well && 'module--well slab--well',
                        ]}
                        data-module={module.kind}
                    >
                        <p class="label module__role">
                            <span class="module__index">{String(index + 1).padStart(PAD_LENGTH, '0')}</span>
                            <span>{module.role}</span>
                        </p>
                        <div class="module__head">
                            <h3
                                class="module__name font-extrabold font-sans text-xl tracking-tight"
                                data-module-name
                            >
                                {MODULE_NAMES[module.kind]}
                            </h3>
                            <button
                                class="chip module__active"
                                aria-pressed="false"
                                data-module-active
                                type="button"
                            >
                                <span aria-hidden="true">Active</span>
                                <span class="sr-only">{MODULE_NAMES[module.kind]} active</span>
                            </button>
                        </div>
                        <p class="module__blurb leading-relaxed text-sm">
                            {module.blurb}
                        </p>
                        {module.sliders.length > 0 && (
                            <div class="module__params">
                                {module.sliders.map(slider => (
                                    <label class="module__param">
                                        <span class="label module__param-label">{slider.label}</span>
                                        <input
                                            class="module__range"
                                            aria-valuetext={slider.display}
                                            data-module-param={slider.param}
                                            max={slider.max}
                                            min={slider.min}
                                            step={slider.step}
                                            type="range"
                                            value={slider.value}
                                        />
                                        <output
                                            class="module__value font-mono text-xs"
                                            data-module-value={slider.param}
                                        >
                                            {slider.display}
                                        </output>
                                    </label>
                                ))}
                            </div>
                        )}
                        {module.viz === 'canvas' && (
                            <div class="module__viz">
                                <canvas
                                    class="module__canvas"
                                    aria-label={`${MODULE_NAMES[module.kind]} level meter`}
                                    data-module-canvas
                                    height="80"
                                    role="img"
                                    width="320"
                                />
                            </div>
                        )}
                        {module.viz === 'readout' && (
                            <div class="module__viz">
                                <p
                                    class="module__readout font-mono"
                                    data-module-readout
                                >
                                    {module.readout}
                                </p>
                            </div>
                        )}
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .module {
        --module-accent: var(--color-accent-deep);
        --module-contrast: var(--color-ink-inverse);
        --module-error: var(--color-accent-deep);
        --module-fill: var(--color-surface-sunken);
        --module-line: var(--color-ink);
        --module-mute: var(--color-ink-muted);
    }

    .module :focus-visible {
        outline-color: var(--module-accent);
    }

    .module > * {
        margin-bottom: var(--space-xs);
    }

    .module--well {
        --module-accent: var(--color-accent-light);
        --module-contrast: var(--color-ink);
        --module-error: var(--color-accent-light);
        --module-fill: var(--color-ink-inverse-10);
        --module-line: var(--color-ink-inverse);
        --module-mute: var(--color-ink-inverse-muted);
        --slab-level: var(--z-card);
        --slab-line: var(--color-ink);
        --slab-rule: 2px;
    }

    .module.is-active::before {
        background-color: var(--color-accent);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--lift);
    }

    .module__active {
        border-color: var(--module-line);
        color: inherit;
        flex: 0 0 auto;
        transition: background var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .module__active:active {
        transform: translateY(1px);
    }

    .module__active:hover {
        background-color: var(--module-line);
        border-color: var(--module-line);
        color: var(--module-contrast);
    }

    .module__active[aria-pressed='true'] {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--color-ink);
    }

    .module__active[aria-pressed='true']:hover {
        background-color: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    .module__blurb {
        color: var(--module-mute);
        grid-row: 3;
    }

    .module__canvas {
        background-color: var(--module-fill);
        border: 2px solid var(--module-line);
        display: block;
        min-height: 80px;
        width: 100%;
    }

    .module__head {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        grid-row: 2;
        justify-content: space-between;
    }

    .module__index {
        color: var(--module-accent);
    }

    .module__name {
        min-width: 0;
    }

    .module__param {
        align-items: center;
        display: grid;
        gap: var(--space-2xs);
        grid-template-columns: 64px minmax(0, 1fr) 76px;
        min-height: var(--control-size);
    }

    .module__param-label {
        color: var(--module-mute);
    }

    .module__params {
        display: flex;
        flex-direction: column;
        grid-row: 4;
    }

    .module__range {
        appearance: none;
        background: transparent;
        height: var(--control-size);
        min-width: 0;
        width: 100%;
    }

    .module__range:focus-visible {
        outline: 2px solid var(--module-accent);
        outline-offset: 2px;
    }

    .module__range::-moz-range-thumb {
        background: var(--color-accent);
        border: 2px solid var(--module-line);
        border-radius: 0;
        height: 20px;
        transition: background var(--duration-fast) var(--motion-ease-ui);
        width: 20px;
    }

    .module__range::-moz-range-track {
        background: var(--module-line);
        height: 2px;
    }

    .module__range::-webkit-slider-runnable-track {
        background: var(--module-line);
        height: 2px;
        translate: 0 9px;
    }

    .module__range::-webkit-slider-thumb {
        appearance: none;
        background: var(--color-accent);
        border: 2px solid var(--module-line);
        height: 20px;
        transition: background var(--duration-fast) var(--motion-ease-ui);
        translate: 0 -9px;
        width: 20px;
    }

    .module__range:active::-moz-range-thumb,
    .module__range:hover::-moz-range-thumb {
        background: var(--module-accent);
    }

    .module__range:active::-webkit-slider-thumb,
    .module__range:hover::-webkit-slider-thumb {
        background: var(--module-accent);
    }

    .module__readout {
        align-items: center;
        background-color: var(--module-fill);
        border: 2px solid var(--module-line);
        display: flex;
        font-size: var(--text-md);
        justify-content: center;
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-xs);
        text-align: center;
    }

    .module__role {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
        grid-row: 1;
    }

    .module__viz {
        grid-row: 5;
        margin-bottom: 0;
    }

    .rack {
        display: grid;
        gap: var(--space-md);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .rack .action-text:hover {
        color: var(--color-accent-light);
    }

    .rack.is-decoding .rack__meta {
        color: var(--color-accent-light);
    }

    .rack__deck {
        align-items: center;
        border: 1px solid var(--color-ink-inverse-10);
        display: flex;
        gap: var(--space-sm);
        padding: var(--space-sm);
    }

    .rack__dock {
        color: var(--color-accent-light);
    }

    .rack__drop {
        align-items: center;
        background-color: var(--color-ink-inverse-10);
        background-image: repeating-linear-gradient(135deg, var(--color-ink-inverse-10) 0 6px, transparent 6px 12px);
        border: 2px dashed var(--color-ink-inverse);
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        justify-content: center;
        min-height: 132px;
        padding: var(--space-sm);
        text-align: center;
        transition: background var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .rack__drop:active {
        transform: translateY(1px);
    }

    .rack__drop:has(input:focus-visible) {
        border-color: var(--color-accent-light);
        outline: 2px solid var(--color-accent-light);
        outline-offset: 2px;
    }

    .rack__drop:hover {
        border-color: var(--color-accent-light);
    }

    .rack__drop.is-dragging {
        background-color: var(--color-accent-20);
        border-color: var(--color-accent-light);
        border-style: solid;
    }

    .rack__error {
        color: var(--color-accent-light);
    }

    .rack__error:empty {
        display: none;
    }

    .rack__eyebrow {
        color: var(--color-accent-light);
        margin-bottom: var(--space-2xs);
    }

    .rack__head {
        grid-column: 1 / -1;
    }

    .rack__hint {
        color: var(--color-ink-inverse-muted);
    }

    .rack__meta {
        align-items: center;
        display: flex;
        gap: var(--space-2xs);
    }

    .rack__meta-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rack__node {
        align-items: center;
        border: 1px solid var(--color-ink-inverse-10);
        color: var(--color-ink-inverse-muted);
        display: inline-flex;
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.06em;
        min-height: 36px;
        padding: 0 var(--space-2xs);
        position: relative;
        text-transform: uppercase;
    }

    .rack__node + .rack__node::before {
        color: var(--color-ink-inverse-muted);
        content: '\2192';
        inset: auto calc(100% + var(--space-3xs)) auto auto;
        position: absolute;
    }

    .rack__node--idle {
        border-style: dashed;
    }

    .rack__node--plug {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: var(--color-ink);
        font-weight: 700;
    }

    .rack__notes {
        align-items: baseline;
        border-top: 1px solid var(--color-ink-inverse-10);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        grid-column: 1 / -1;
        justify-content: space-between;
        padding-top: var(--space-sm);
    }

    .rack__path {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }

    .rack__play {
        align-items: center;
        background-color: var(--color-accent);
        border: 2px solid var(--color-accent);
        color: var(--color-ink);
        display: inline-flex;
        flex: 0 0 auto;
        height: 64px;
        justify-content: center;
        transition: background var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: 64px;
    }

    .rack__play:active:not(:disabled) {
        transform: translateY(1px);
    }

    .rack__play:disabled {
        background-color: transparent;
        border-color: var(--color-ink-inverse-muted);
        color: var(--color-ink-inverse-muted);
        opacity: 0.55;
    }

    .rack__play:hover:not(:disabled) {
        background-color: var(--color-accent-light);
        border-color: var(--color-accent-light);
    }

    .rack__play[aria-pressed='true'] {
        background-color: var(--color-ink-inverse);
        border-color: var(--color-ink-inverse);
    }

    .rack__play[aria-pressed='true']:hover {
        background-color: var(--color-ink-inverse-muted);
        border-color: var(--color-ink-inverse-muted);
    }

    .rack__signal {
        grid-column: 1 / -1;
    }

    .rack__signal-label {
        color: var(--color-ink-inverse-muted);
        margin-bottom: var(--space-2xs);
    }

    .rack__status {
        min-width: 0;
    }

    .sandbox__card {
        display: grid;
        grid-row: 1 / span 5;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .sandbox__flag {
        background-color: var(--color-ink);
        color: var(--color-ink-inverse);
    }

    .sandbox__grid {
        --rank-cols: repeat(2, minmax(0, 1fr));
        column-gap: var(--space-lg);
        grid-auto-rows: auto;
        row-gap: 0;
    }

    .sandbox__hero {
        --overhang-step: 2.5;
    }

    .sandbox__tile {
        display: grid;
        grid-row: span 6;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .sandbox__tile::after {
        content: '';
        display: block;
        grid-row: 6;
        height: var(--space-lg);
    }

    @media (max-width: 768px) {
        .rack {
            grid-template-columns: minmax(0, 1fr);
        }

        .sandbox__grid {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { ANALYSER_FFT } from '@lib/audio/sandbox/blocks';
    import {
        MODULE_NAMES,
        getRackAnalyser,
        getRackReadout,
        getRackState,
        loadRackFile,
        onRackChange,
        setModuleActive,
        setRackParam,
        toggleRack,
    } from '@lib/audio/sandbox/rack';
    import { formatDuration, registerPageScript, setHidden, setText } from '@lib/utils';
    import { validateSandboxFile } from '@lib/audio/sandbox/loader';

    interface MeterView {
        accent: string;
        height: number;
        ink: string;
        width: number;
    }

    interface ModuleView {
        canvas: HTMLCanvasElement | null;
        card: HTMLElement;
        idle: string;
        kind: SandboxKind;
        meter: MeterView | null;
        readout: HTMLElement | null;
        toggle: HTMLButtonElement;
    }

    const ACCENT_SEGMENTS = 4;

    const CUTOFF_MAX = 18_000;

    const CUTOFF_MIN = 40;

    const HERTZ_PER_KILOHERTZ = 1_000;

    const HIGHPASS_MAX = 2_000;

    const HIGHPASS_MIN = 20;

    const METER_SEGMENTS = 24;

    const PERCENT = 100;

    const PIXEL_RATIO_MAX = 2;

    const UNLIT_ALPHA = 0.15;

    const FORMAT: Record<string, (value: number) => string> = {
        'chorus:depth': value => `${Math.round(value * PERCENT)}%`,
        'chorus:rate': value => `${value.toFixed(2)} Hz`,
        'compressor:ratio': value => `${value.toFixed(1)}:1`,
        'compressor:threshold': value => `${Math.round(value)} dB`,
        'delay:feedback': value => `${Math.round(value * PERCENT)}%`,
        'delay:time': value => `${value.toFixed(2)} s`,
        'eq:high': signedDecibels,
        'eq:low': signedDecibels,
        'filter:cutoff': formatHertz,
        'filter:resonance': value => `Q ${value.toFixed(1)}`,
        'gate:threshold': value => `${Math.round(value)} dB`,
        'highpass:cutoff': formatHertz,
        'highpass:resonance': value => `Q ${value.toFixed(1)}`,
        'limiter:threshold': value => `${value.toFixed(1)} dB`,
        'pan:position': value => (value === 0 ? 'Center' : `${value < 0 ? 'L' : 'R'} ${Math.round(Math.abs(value) * PERCENT)}`),
        'reverb:decay': value => `${value.toFixed(1)} s`,
        'reverb:wet': value => `${Math.round(value * PERCENT)}%`,
        'saturator:drive': value => value.toFixed(1),
        'tremolo:depth': value => `${Math.round(value * PERCENT)}%`,
        'tremolo:rate': value => `${value.toFixed(1)} Hz`,
        'trim:gain': signedDecibels,
    };

    const MAP: Record<string, (value: number) => number> = {
        'filter:cutoff': value => CUTOFF_MIN * (CUTOFF_MAX / CUTOFF_MIN) ** value,
        'highpass:cutoff': value => HIGHPASS_MIN * (HIGHPASS_MAX / HIGHPASS_MIN) ** value,
    };

    const meterData = new Float32Array(ANALYSER_FFT);

    let depth = 0;
    let frame = 0;
    let requests = 0;
    let unsubscribe: (() => void) | undefined;
    let views: ModuleView[] = [];

    function applyParam(view: ModuleView, range: HTMLInputElement) {
        const param = range.dataset.moduleParam ?? '';
        const key = `${view.kind}:${param}`;
        const mapped = (MAP[key] ?? (value => value))(Number(range.value));
        const text = (FORMAT[key] ?? String)(mapped);

        range.ariaValueText = text;
        setText(view.card.querySelector(`[data-module-value="${param}"]`), text);
        setRackParam(view.kind, param, mapped);
    }

    function bindParam(view: ModuleView, range: HTMLInputElement, signal: AbortSignal) {
        range.addEventListener('input', () => applyParam(view, range), { signal });
        applyParam(view, range);
    }

    function buildView(card: HTMLElement, signal: AbortSignal) {
        const canvas = card.querySelector<HTMLCanvasElement>('[data-module-canvas]');
        const readout = card.querySelector<HTMLElement>('[data-module-readout]');
        const toggle = card.querySelector<HTMLButtonElement>('[data-module-active]');

        if (!toggle) return null;

        const kind = card.dataset.module as SandboxKind;
        const view: ModuleView = {
            canvas,
            card,
            idle: readout?.textContent?.trim() ?? '',
            kind,
            meter: canvas ? createMeterView(canvas) : null,
            readout,
            toggle,
        };

        toggle.addEventListener('click', () => handleActiveClick(view), { signal });
        card.querySelectorAll<HTMLInputElement>('[data-module-param]').forEach(range => bindParam(view, range, signal));

        return view;
    }

    function collectViews(cards: NodeListOf<HTMLElement>, signal: AbortSignal) {
        const collected: ModuleView[] = [];

        cards.forEach((card) => {
            const view = buildView(card, signal);

            if (view) collected.push(view);
        });

        return collected;
    }

    function createMeterView(canvas: HTMLCanvasElement) {
        const rect = canvas.getBoundingClientRect();
        const styles = getComputedStyle(canvas);
        const height = Math.round(rect.height) || canvas.height;
        const ratio = Math.min(PIXEL_RATIO_MAX, Math.max(1, window.devicePixelRatio || 1));
        const width = Math.round(rect.width) || canvas.width;

        canvas.height = Math.round(height * ratio);
        canvas.width = Math.round(width * ratio);
        canvas.getContext('2d')?.setTransform(ratio, 0, 0, ratio, 0, 0);

        return {
            accent: styles.getPropertyValue('--color-accent').trim(),
            height,
            ink: styles.getPropertyValue('--module-line').trim(),
            width,
        };
    }

    function drawMeter(canvas: HTMLCanvasElement, analyser: AnalyserNode | undefined, view: MeterView) {
        const surface = canvas.getContext('2d');

        if (!surface) return;

        surface.clearRect(0, 0, view.width, view.height);

        if (!analyser) return;

        analyser.getFloatTimeDomainData(meterData);

        let peak = 0;

        for (let index = 0; index < meterData.length; index += 1) {
            const value = Math.abs(meterData[index]);

            if (value > peak) peak = value;
        }

        const level = Math.min(1, Math.sqrt(peak));
        const lit = Math.round(level * METER_SEGMENTS);
        const width = view.width / METER_SEGMENTS;

        for (let index = 0; index < METER_SEGMENTS; index += 1) {
            surface.fillStyle = index >= METER_SEGMENTS - ACCENT_SEGMENTS ? view.accent : view.ink;
            surface.globalAlpha = index < lit ? 1 : UNLIT_ALPHA;
            surface.fillRect(index * width + 1, 4, width - 2, view.height - 8);
        }

        surface.globalAlpha = 1;
    }

    function formatHertz(value: number) {
        if (value >= HERTZ_PER_KILOHERTZ) return `${(value / HERTZ_PER_KILOHERTZ).toFixed(2)} kHz`;

        return `${Math.round(value)} Hz`;
    }

    function handleActiveClick(view: ModuleView) {
        setModuleActive(view.kind, view.toggle.getAttribute('aria-pressed') !== 'true');
    }

    function handleDragEnter(event: DragEvent, zone: HTMLElement) {
        preventNavigation(event);
        setDragDepth(zone, depth + 1);
    }

    function handleDragLeave(zone: HTMLElement) {
        setDragDepth(zone, depth - 1);
    }

    function handleDrop(event: DragEvent, zone: HTMLElement, signal: AbortSignal) {
        preventNavigation(event);
        setDragDepth(zone, 0);
        handleFiles(event.dataTransfer?.files, signal);
    }

    function handleFiles(files: FileList | null | undefined, signal: AbortSignal) {
        const file = files?.[0];

        if (file) void intake(file, signal);
    }

    function handleInputChange(input: HTMLInputElement, signal: AbortSignal) {
        handleFiles(input.files, signal);
        input.value = '';
    }

    function handleInputKeydown(event: KeyboardEvent, input: HTMLInputElement) {
        if (event.key !== 'Enter') return;

        event.preventDefault();
        input.click();
    }

    function initSandbox(signal: AbortSignal) {
        const cards = document.querySelectorAll<HTMLElement>('[data-module]');
        const input = document.querySelector<HTMLInputElement>('[data-rack-input]');
        const toggle = document.querySelector<HTMLButtonElement>('[data-rack-toggle]');
        const zone = document.querySelector<HTMLElement>('[data-rack-drop]');

        if (!input || !toggle || !zone || cards.length === 0) return;

        unsubscribe?.();
        views = collectViews(cards, signal);
        unsubscribe = onRackChange(render);
        signal.addEventListener('abort', teardown, { once: true });
        input.addEventListener('change', () => handleInputChange(input, signal), { signal });
        input.addEventListener('keydown', event => handleInputKeydown(event, input), { signal });
        toggle.addEventListener('click', toggleRack, { signal });
        zone.addEventListener('dragenter', event => handleDragEnter(event, zone), { signal });
        zone.addEventListener('dragleave', () => handleDragLeave(zone), { signal });
        zone.addEventListener('dragover', preventNavigation, { signal });
        zone.addEventListener('drop', event => handleDrop(event, zone, signal), { signal });
        window.addEventListener('dragover', preventNavigation, { signal });
        window.addEventListener('drop', preventNavigation, { signal });
        render();
    }

    async function intake(file: File, signal: AbortSignal) {
        const invalid = validateSandboxFile(file);
        const token = (requests += 1);

        setText(document.querySelector('[data-rack-error]'), invalid ?? '');

        if (invalid) {
            setDecoding(false);

            return;
        }

        setText(document.querySelector('[data-rack-meta-text]'), 'Decoding\u2026');
        setDecoding(true);

        const result = await loadRackFile(file);

        if (signal.aborted || token !== requests) return;

        setDecoding(false);
        render();

        if (!result.ok) setText(document.querySelector('[data-rack-error]'), result.message);
    }

    function paintView(view: ModuleView) {
        if (view.canvas && view.meter) drawMeter(view.canvas, getRackAnalyser(view.kind), view.meter);
        if (view.readout) setText(view.readout, getRackReadout(view.kind) ?? view.idle);
    }

    function preventNavigation(event: DragEvent) {
        event.preventDefault();
    }

    function render() {
        const state = getRackState();

        renderMaster(state);
        renderPath(state);
        views.forEach(view => renderView(view, state));
        cancelAnimationFrame(frame);

        if (state.playing) frame = requestAnimationFrame(renderFrame);
    }

    function renderFrame() {
        views.forEach(paintView);
        frame = requestAnimationFrame(renderFrame);
    }

    function renderMaster(state: RackState) {
        const meta = document.querySelector<HTMLElement>('[data-rack-meta]');
        const toggle = document.querySelector<HTMLButtonElement>('[data-rack-toggle]');

        if (!meta || !toggle) return;

        meta.title = state.fileName ?? '';
        toggle.disabled = state.fileName === null;
        toggle.setAttribute('aria-pressed', String(state.playing));
        setHidden(document.querySelector<HTMLElement>('[data-rack-icon-pause]'), !state.playing);
        setHidden(document.querySelector<HTMLElement>('[data-rack-icon-play]'), state.playing);
        setText(document.querySelector('[data-rack-meta-text]'), state.fileName === null ? 'No file loaded' : `${state.fileName} \u00b7 ${formatDuration(state.durationSeconds)}`);
        setText(document.querySelector('[data-rack-toggle-label]'), state.playing ? 'Pause the rack' : 'Play the rack');
    }

    function renderPath(state: RackState) {
        const idle = document.querySelector<HTMLElement>('[data-rack-idle]');
        const path = document.querySelector<HTMLElement>('[data-rack-path]');
        const template = document.querySelector<HTMLTemplateElement>('[data-rack-chip]');

        if (!idle || !path || !template) return;

        path.querySelectorAll('[data-rack-plug]').forEach(node => node.remove());

        for (const kind of state.activeKinds) {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const node = fragment.querySelector<HTMLElement>('[data-rack-plug]');

            if (!node) continue;

            setText(node, MODULE_NAMES[kind]);
            idle.before(fragment);
        }

        idle.hidden = state.activeKinds.length > 0;
    }

    function renderView(view: ModuleView, state: RackState) {
        const active = state.activeKinds.includes(view.kind);

        view.card.classList.toggle('is-active', active);
        view.toggle.setAttribute('aria-pressed', String(active));

        if (!active || !state.playing) resetView(view);
    }

    function resetView(view: ModuleView) {
        if (view.canvas && view.meter) drawMeter(view.canvas, undefined, view.meter);
        if (view.readout) setText(view.readout, view.idle);
    }

    function setDecoding(active: boolean) {
        const master = document.querySelector<HTMLElement>('[data-rack-master]');
        const zone = document.querySelector<HTMLElement>('[data-rack-drop]');

        setHidden(document.querySelector<HTMLElement>('[data-rack-spinner]'), !active);
        master?.classList.toggle('is-decoding', active);

        if (active) zone?.setAttribute('aria-busy', 'true');
        else zone?.removeAttribute('aria-busy');
    }

    function setDragDepth(zone: HTMLElement, next: number) {
        depth = Math.max(0, next);
        zone.classList.toggle('is-dragging', depth > 0);
    }

    function signedDecibels(value: number) {
        return `${value >= 0 ? '+' : ''}${value.toFixed(1)} dB`;
    }

    function teardown() {
        cancelAnimationFrame(frame);
        unsubscribe?.();
        depth = 0;
        frame = 0;
        unsubscribe = undefined;
        views = [];
    }

    registerPageScript(initSandbox);
</script>
