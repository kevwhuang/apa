---
import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';

interface Endpoint {
    blurb: string;
    path: string;
}

const ENDPOINTS: Endpoint[] = [
    { blurb: 'Every event date in one chronological list; Bash editions carry their edition, prompt, recap, sponsors, and winners.', path: '/api/events' },
    { blurb: 'The full roster, ordered by six-digit string ID, with genres, role, links, location, and spotlight tracks.', path: '/api/producers' },
    { blurb: 'The asset library with formats, sizes, publication state, and unlock times.', path: '/api/resources' },
    { blurb: 'The store catalog with five-digit string SKUs, variations and their prices, sizes, and stock.', path: '/api/store' },
];
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="api-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-4xl text-7xl max-md:text-5xl"
            headingId="api-title"
        >
            Read the data
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            Everything the site publishes is readable as JSON: the calendar, the roster, the store
            catalog, and the asset library. The API needs no key and answers GET requests only.
        </p>
    </div>
    <dl
        class="api__ledger"
        aria-label="API contract"
        data-motion-stagger="rise"
    >
        <div class="api__cell--flag content-center grid px-(--space-sm) py-(--space-xs)">
            <dt class="label mb-(--space-2xs) text-text-inverse-secondary">Endpoints</dt>
            <dd
                class="font-bold font-display leading-none text-4xl tracking-[-0.02em]"
                data-motion-count={String(ENDPOINTS.length)}
            >
                {ENDPOINTS.length}
            </dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Methods</dt>
            <dd class="font-mono text-base">GET</dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Format</dt>
            <dd class="font-mono text-base">JSON</dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Caching</dt>
            <dd class="font-mono text-base">no-store</dd>
        </div>
    </dl>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="endpoints-title"
>
    <div>
        <SectionHead
            class="text-3xl"
            headingId="endpoints-title"
        >
            Endpoints
        </SectionHead>
        <div
            class="overflow-x-auto"
            data-motion="unfold"
        >
            <table class="api__table border-2 border-border-strong">
                <caption class="sr-only">API endpoints, the payload each returns, and a link to open each one</caption>
                <thead>
                    <tr class="label border-b-2 border-border-strong text-text-secondary">
                        <th
                            class="px-4 py-3 text-left"
                            scope="col"
                        >
                            Endpoint
                        </th>
                        <th
                            class="px-4 py-3 text-left"
                            scope="col"
                        >
                            Payload
                        </th>
                        <th
                            class="px-4 py-3 text-right"
                            scope="col"
                        >
                            <span class="sr-only">Open</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-border-strong divide-y">
                    {ENDPOINTS.map(endpoint => (
                        <tr>
                            <th
                                class="px-4 py-4 font-normal text-left whitespace-nowrap"
                                scope="row"
                            >
                                <span class="label mr-2 px-2 py-1 bg-bg-inverse text-text-inverse">GET</span>
                                <code class="font-bold font-mono text-base">{endpoint.path}</code>
                            </th>
                            <td class="min-w-[320px] px-4 py-4 text-base text-text-secondary">{endpoint.blurb}</td>
                            <td class="px-4 py-4 text-right">
                                <a
                                    class="action-text api__open inline-flex items-center min-h-(--control-size) gap-2 transition-[color,transform]"
                                    aria-label={`Open ${endpoint.path}`}
                                    href={endpoint.path}
                                >
                                    Open <IconArrow />
                                </a>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</section>

<style>
    .api__cell--flag {
        background-color: var(--color-bg-inverse);
        color: var(--color-text-inverse);
        padding: var(--space-md) var(--space-lg);
    }

    .api__ledger {
        background-color: var(--color-border-strong);
        border: 2px solid var(--color-border-strong);
        display: grid;
        gap: 2px;
        grid-template-columns: minmax(200px, 0.62fr) repeat(3, minmax(0, 1fr));
    }

    .api__table {
        display: table;
        min-width: 560px;
        overflow-x: visible;
        width: 100%;
    }

    @media (max-width: 1024px) {
        .api__cell--flag {
            grid-row: span 3;
        }

        .api__ledger {
            grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .api__cell--flag {
            grid-row: auto;
            padding: var(--space-sm) var(--space-md);
        }

        .api__ledger {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
