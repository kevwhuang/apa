---
import IconCart from '@components/IconCart.astro';
import IconMenu from '@components/IconMenu.astro';
import Monogram from '@components/Monogram.astro';
import { ROUTES } from '@lib/utils';

const isStorePage = Astro.url.pathname.startsWith('/store');
---

<header class="site-header sticky top-0 z-40 border-b-2 border-ink bg-sand">
    <div class="shell flex items-center h-18 gap-8">
        <a
            class="flex items-center shrink-0 gap-3 select-none"
            aria-label="Austin Producer Alliance &mdash; home"
            href="/"
        >
            <Monogram decorative size={30} />
            <span class="hidden font-extrabold font-sans text-[15px] tracking-tight uppercase md:inline">
                Austin Producer Alliance
            </span>
        </a>
        <nav
            id="site-nav"
            class="site-nav absolute hidden inset-x-0 top-full border-t-2 border-ink bg-sand lg:block lg:border-t-0 lg:static"
            aria-label="Primary"
        >
            <ul class="flex flex-col gap-4 px-6 py-5 font-mono list-none text-[14px] tracking-wide uppercase lg:flex-row lg:gap-6 lg:items-center lg:p-0 lg:text-[12px]">
                {ROUTES.map(route => (
                    <li>
                        <a
                            class="hover:text-coral-dark block py-1 transition-colors"
                            href={route.href}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="flex items-center gap-1 ml-auto">
            {isStorePage && (
                <a
                    class="cart-link hover:text-coral-dark relative p-2 transition-colors"
                    href="/store/cart"
                >
                    <IconCart />
                    <span
                        class="cart-count -right-0.5 -top-0.5 absolute hidden h-4 min-w-4 px-1 font-mono leading-4 text-[10px] text-center bg-coral text-ink"
                        aria-hidden="true"
                    >
                        0
                    </span>
                    <span
                        class="cart-label sr-only"
                        aria-live="polite"
                    >
                        Cart
                    </span>
                </a>
            )}
            <button
                class="nav-toggle hover:text-coral-dark relative -mr-2 p-2 transition-colors lg:hidden"
                aria-controls="site-nav"
                aria-expanded="false"
                aria-label="Toggle menu"
                type="button"
            >
                <IconMenu />
            </button>
        </div>
    </div>
</header>

<style>
    .cart-link::after {
        content: '';
        inset: -7px;
        position: absolute;
    }

    .nav-toggle::after {
        content: '';
        inset: -5px;
        position: absolute;
    }

    .site-header {
        transition: transform var(--duration-slow) ease;
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .site-nav a[aria-current] {
        color: var(--color-coral-dark);
        font-weight: 700;
    }
</style>

<script>
    import { count, getItems, onChange } from '@lib/store';

    const SCROLL_DELTA = 6;
    const SCROLL_TOP_THRESHOLD = 80;

    let cartUnsubscribe: (() => void) | undefined;
    let lastScrollY = 0;
    let navController: AbortController | undefined;
    let scrollTicking = false;

    function closeMenu(menu: HTMLElement, toggle: HTMLElement) {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
    }

    function handleMenuClick(event: Event, menu: HTMLElement, toggle: HTMLElement) {
        if (menu.classList.contains('hidden')) return;

        if (event.target instanceof Element && event.target.closest('a')) closeMenu(menu, toggle);
    }

    function handleMenuKeydown(event: KeyboardEvent, menu: HTMLElement, toggle: HTMLElement) {
        if (menu.classList.contains('hidden')) return;

        if (event.key === 'Escape') {
            closeMenu(menu, toggle);
        } else if (event.key === 'Tab') {
            trapFocus(event, menu);
        }
    }

    function handleScroll(header: HTMLElement) {
        if (scrollTicking) return;

        scrollTicking = true;
        requestAnimationFrame(() => updateHeaderVisibility(header));
    }

    function handleToggleClick(menu: HTMLElement, toggle: HTMLElement) {
        if (menu.classList.contains('hidden')) {
            openMenu(menu, toggle);
        } else {
            closeMenu(menu, toggle);
        }
    }

    function initNavbar() {
        cartUnsubscribe?.();
        cartUnsubscribe = onChange(updateCart);
        navController?.abort();
        navController = new AbortController();

        const { signal } = navController;

        const header = document.querySelector<HTMLElement>('.site-header');
        const menu = document.querySelector<HTMLElement>('.site-nav');
        const toggle = document.querySelector<HTMLElement>('.nav-toggle');

        if (!header || !menu || !toggle) return;

        header.classList.remove('is-hidden');
        lastScrollY = window.scrollY;
        scrollTicking = false;
        updateActiveLink(menu);
        updateCart();

        document.addEventListener('keydown', event => handleMenuKeydown(event, menu, toggle), { signal });
        menu.addEventListener('click', event => handleMenuClick(event, menu, toggle), { signal });
        toggle.addEventListener('click', () => handleToggleClick(menu, toggle), { signal });
        window.addEventListener('scroll', () => handleScroll(header), { passive: true, signal });
    }

    function openMenu(menu: HTMLElement, toggle: HTMLElement) {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
            requestAnimationFrame(() => menu.querySelector<HTMLElement>('a')?.focus());
        });
    }

    function trapFocus(event: KeyboardEvent, menu: HTMLElement) {
        const focusables = menu.querySelectorAll<HTMLElement>('a');
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    }

    function updateActiveLink(menu: HTMLElement) {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        menu.querySelectorAll<HTMLElement>('a').forEach((link) => {
            const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';

            if (href === currentPath) {
                link.setAttribute('aria-current', 'page');
            } else if (currentPath.startsWith(`${href}/`)) {
                link.setAttribute('aria-current', 'true');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    }

    function updateCart() {
        const badge = document.querySelector<HTMLElement>('.cart-count');
        const label = document.querySelector<HTMLElement>('.cart-label');

        if (!badge || !label) return;

        const total = count(getItems());

        badge.textContent = String(total);
        badge.classList.toggle('hidden', total === 0);
        label.textContent = `Cart, ${total} ${total === 1 ? 'item' : 'items'}`;
    }

    function updateHeaderVisibility(header: HTMLElement) {
        const currentScrollY = window.scrollY;

        if (currentScrollY < SCROLL_TOP_THRESHOLD) {
            header.classList.remove('is-hidden');
        } else if (currentScrollY > lastScrollY + SCROLL_DELTA) {
            header.classList.add('is-hidden');
        } else if (currentScrollY < lastScrollY - SCROLL_DELTA) {
            header.classList.remove('is-hidden');
        }

        lastScrollY = currentScrollY;
        scrollTicking = false;
    }

    document.addEventListener('astro:page-load', initNavbar);
</script>
