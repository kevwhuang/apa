---
import Monogram from '@components/Monogram.astro';

const links = [
    { href: '/events', label: 'Events' },
    { href: '/producers', label: 'Producers' },
    { href: '/bash', label: 'The Bash' },
    { href: '/about', label: 'About' },
    { href: '/merch', label: 'Merch' },
    { href: '/sponsor', label: 'Sponsor' },
    { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header
    id="nav"
    class="sticky top-0 z-40 border-b-2 border-ink"
    style="background: var(--color-sand);"
>
    <div class="max-w-[1400px] mx-auto px-6 h-[4.5rem] flex items-center gap-8">
        <a class="flex items-center gap-3 shrink-0" aria-label="APA home" href="/">
            <Monogram size={30} />
            <span class="hidden sm:inline font-sans font-extrabold tracking-tight text-[15px] uppercase">
                Austin Producer Alliance
            </span>
        </a>

        <nav class="hidden md:flex items-center gap-6 font-mono text-[12px] uppercase tracking-wide" aria-label="Primary">
            {links.map(l => (
                <a
                    class:list={[
                        'transition-colors hover:text-coral',
                        path.startsWith(l.href) ? 'text-coral font-bold' : '',
                    ]}
                    href={l.href}
                >
                    {l.label}
                </a>
            ))}
        </nav>

        <div class="ml-auto flex items-center gap-1">
            {path.startsWith('/merch') && (
                <a
                    id="cart-badge"
                    class="relative p-2 transition-colors hover:text-coral"
                    aria-label="Cart"
                    href="/merch/cart"
                >
                    <svg fill="none" height="18" stroke="currentColor" stroke-width="1.5" viewBox="0 0 18 18" width="18">
                        <path d="M2 3 H4.5 L6 12 H15 L16.5 5 H5" stroke-linejoin="round" />
                        <circle cx="7" cy="15" r="1.2" />
                        <circle cx="13" cy="15" r="1.2" />
                    </svg>
                    <span
                        id="cart-count"
                        class="absolute -top-0.5 -right-0.5 min-w-[16px] h-[16px] px-1 text-[10px] font-mono leading-[16px] text-center hidden bg-coral text-coral-ink"
                    >
                        0
                    </span>
                </a>
            )}
            <button
                id="nav-menu-btn"
                class="md:hidden p-2 -mr-2"
                aria-expanded="false"
                aria-label="Open menu"
            >
                <svg fill="none" height="22" stroke="currentColor" stroke-width="2" viewBox="0 0 22 22" width="22">
                    <line x1="3" x2="19" y1="6" y2="6" />
                    <line x1="3" x2="19" y1="11" y2="11" />
                    <line x1="3" x2="19" y1="16" y2="16" />
                </svg>
            </button>
        </div>
    </div>

    <div
        id="nav-mobile"
        class="md:hidden hidden border-t-2 border-ink bg-sand"
        aria-label="Mobile navigation"
        role="region"
    >
        <nav class="px-6 py-5 flex flex-col gap-4 font-mono text-[14px] uppercase tracking-wide">
            {links.map(l => (
                <a class="py-1 hover:text-coral" href={l.href}>{l.label}</a>
            ))}
        </nav>
    </div>
</header>

<script>
    import { count, getItems, onChange } from '@/lib/store';

    const SCROLL_DELTA = 6;
    const SCROLL_TOP_THRESHOLD = 80;

    const btn = document.getElementById('nav-menu-btn');
    const drawer = document.getElementById('nav-mobile');
    const nav = document.getElementById('nav');

    let lastY = window.scrollY;
    let ticking = false;

    function setMenu(open: boolean) {
        drawer?.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
    }

    function updateCart() {
        const el = document.getElementById('cart-count');

        if (!el) return;

        const c = count(getItems());
        el.textContent = String(c);
        el.classList.toggle('hidden', c === 0);
    }

    window.addEventListener('scroll', () => {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {
            const y = window.scrollY;

            if (y < SCROLL_TOP_THRESHOLD) {
                nav?.style.setProperty('transform', 'translateY(0)');
            } else if (y > lastY + SCROLL_DELTA) {
                nav?.style.setProperty('transform', 'translateY(-100%)');
            } else if (y < lastY - SCROLL_DELTA) {
                nav?.style.setProperty('transform', 'translateY(0)');
            }

            lastY = y;
            ticking = false;
        });
    }, { passive: true });

    btn?.addEventListener('click', () => {
        setMenu(drawer?.classList.contains('hidden') ?? false);
    });

    drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer?.classList.contains('hidden')) {
            setMenu(false);
            btn?.focus();
        }
    });

    updateCart();
    onChange(updateCart);
</script>
