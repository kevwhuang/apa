---
import { getCollection } from 'astro:content';

import PageHead from '@components/PageHead.astro';
import PlaceholderTile from '@components/PlaceholderTile.astro';
import { PALETTE } from '@lib/utils';

const producers = await getCollection('producers');
const allGenres = Array.from(new Set(producers.flatMap(producer => producer.data.genres))).sort((a, b) => a.localeCompare(b));
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="roster-title"
>
    <div class="shell">
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-8xl"
            eyebrow={`Featured / ${producers.length} of 142 members`}
            headingId="roster-title"
        >
            The producers.
        </PageHead>
        <div
            class="flex flex-wrap gap-2 mt-10"
            aria-label="Filter by genre"
            role="group"
        >
            <button
                class="chip genre-btn is-active active:bg-ink active:text-sand hover:bg-ink hover:text-sand"
                aria-pressed="true"
                data-genre=""
                type="button"
            >
                All
            </button>
            {allGenres.map(genre => (
                <button
                    class="chip genre-btn active:bg-ink active:text-sand hover:bg-ink hover:text-sand"
                    aria-pressed="false"
                    data-genre={genre}
                    type="button"
                >
                    {genre}
                </button>
            ))}
        </div>
    </div>
</section>

<section
    class="py-16"
    aria-label="Roster"
>
    <ul class="reveal--stagger shell grid gap-5 list-none lg:grid-cols-3 md:grid-cols-2">
        {producers.map((producer, index) => (
            <li
                id={producer.id}
                class="producer-card"
                data-genres={producer.data.genres.join(',')}
            >
                <article class="card card-hover h-full">
                    <PlaceholderTile
                        class="aspect-[5/3]"
                        color={PALETTE[index % PALETTE.length]}
                        label={producer.data.name.split(' ').map(word => word[0]).join('')}
                        labelClass="leading-none text-[80px] text-white/80"
                    />
                    <div class="p-5">
                        <p class="label mb-1 text-coral-dark">{producer.data.handle}</p>
                        <h2 class="mb-2 font-extrabold font-sans text-xl tracking-tight">{producer.data.name}</h2>
                        <p class="mb-4 leading-relaxed text-[13px] text-taupe">{producer.data.bio}</p>
                        <div class="flex flex-wrap gap-1.5">
                            {producer.data.genres.map(genre => (
                                <span class="inline-flex items-center h-6 px-2 border-2 border-ink font-bold font-mono text-[10px] tracking-wide uppercase">{genre}</span>
                            ))}
                        </div>
                    </div>
                </article>
            </li>
        ))}
    </ul>
</section>

<script>
    import { applyFilter, rovingFocus } from '@lib/utils';

    let activeGenre = '';
    let producersController: AbortController | undefined;

    function handleGenreClick(button: HTMLButtonElement, buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        activeGenre = button.dataset.genre ?? '';
        updateGenreFilter(buttons, cards);
    }

    function initProducersGrid() {
        producersController?.abort();
        producersController = new AbortController();

        const { signal } = producersController;

        const buttons = document.querySelectorAll<HTMLButtonElement>('.genre-btn');
        const cards = document.querySelectorAll<HTMLElement>('.producer-card');

        if (!buttons.length || !cards.length) return;

        activeGenre = '';
        updateGenreFilter(buttons, cards);
        rovingFocus(buttons, signal);

        buttons.forEach((button) => {
            button.addEventListener('click', () => handleGenreClick(button, buttons, cards), { signal });
        });
    }

    function updateGenreFilter(buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        applyFilter(buttons, cards, activeGenre, 'genre', (card, genre) => !genre || (card.dataset.genres ?? '').split(',').includes(genre));
    }

    document.addEventListener('astro:page-load', initProducersGrid);
</script>
