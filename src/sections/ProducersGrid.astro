---
import { getCollection } from 'astro:content';
import { PALETTE } from '@lib/utils';

const cardColors = PALETTE;
const producers = await getCollection('producers');
const allGenres = Array.from(new Set(producers.flatMap(p => p.data.genres))).sort();
---

<section
    class="pt-20 pb-12 border-b-2 border-ink"
    aria-label="Producer roster"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <p class="label mb-4 text-coral reveal">ROSTER / {producers.length} MEMBERS</p>
        <h1 class="font-sans font-extrabold tracking-[-0.04em] text-6xl md:text-8xl leading-[0.9] max-w-3xl reveal" style="transition-delay: 0.08s;">
            The producers.
        </h1>
        <div id="genre-filter" class="mt-10 flex flex-wrap gap-2" aria-label="Filter by genre" role="group">
            <button class="genre-btn filter-on px-3 h-8 font-mono text-[11px] font-bold uppercase tracking-wide border-2 border-ink" aria-pressed="true" data-genre="">All</button>
            {allGenres.map(g => (
                <button class="genre-btn px-3 h-8 font-mono text-[11px] font-bold uppercase tracking-wide border-2 border-ink hover:bg-ink hover:text-sand transition-colors" aria-pressed="false" data-genre={g}>{g}</button>
            ))}
        </div>
    </div>
</section>

<section
    class="py-16"
    aria-label="Producer cards"
>
    <div id="producer-grid" class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 reveal--stagger">
        {producers.map((p, i) => (
            <article
                id={p.id}
                class="producer-card border-2 border-ink p-0 bg-sand card-hover"
                data-genres={p.data.genres.join(',')}
                style="box-shadow: var(--shadow-card-sm);"
            >
                <div
                    class="aspect-[5/3] relative overflow-hidden flex items-center justify-center"
                    style={`background: ${cardColors[i % cardColors.length]};`}
                >
                    <div class="absolute inset-0 halftone"></div>
                    <span class="font-sans font-extrabold text-[80px] leading-none text-white/80 mix-blend-overlay select-none">
                        {p.data.name.split(' ').map(w => w[0]).join('')}
                    </span>
                </div>
                <div class="p-5">
                    <p class="label text-coral">{p.data.handle}</p>
                    <h2 class="font-sans font-extrabold text-xl tracking-tight mt-1">{p.data.name}</h2>
                    <p class="text-[13px] mt-2 text-ink-soft leading-relaxed">{p.data.bio}</p>
                    <div class="mt-4 flex flex-wrap gap-1.5">
                        {p.data.genres.map(g => (
                            <span class="inline-flex items-center px-2 h-6 font-mono text-[10px] font-bold uppercase tracking-wide border-2 border-ink">{g}</span>
                        ))}
                    </div>
                    <div class="flex gap-3 mt-4 font-mono text-[11px] font-bold uppercase text-ink-soft">
                        {p.data.links.instagram && <a class="hover:text-coral transition-colors" aria-label={`${p.data.name} on Instagram`} href={p.data.links.instagram} rel="noopener noreferrer" target="_blank">IG</a>}
                        {p.data.links.soundcloud && <a class="hover:text-coral transition-colors" aria-label={`${p.data.name} on SoundCloud`} href={p.data.links.soundcloud} rel="noopener noreferrer" target="_blank">SC</a>}
                        {p.data.links.spotify && <a class="hover:text-coral transition-colors" aria-label={`${p.data.name} on Spotify`} href={p.data.links.spotify} rel="noopener noreferrer" target="_blank">SP</a>}
                        {p.data.links.bandcamp && <a class="hover:text-coral transition-colors" aria-label={`${p.data.name} on Bandcamp`} href={p.data.links.bandcamp} rel="noopener noreferrer" target="_blank">BC</a>}
                    </div>
                </div>
            </article>
        ))}
    </div>
</section>

<script>
    import { applyFilter, rovingFocus } from '@/lib/utils';

    const buttons = document.querySelectorAll<HTMLButtonElement>('.genre-btn');
    const cards = document.querySelectorAll<HTMLElement>('.producer-card');

    let activeGenre = '';

    function apply() {
        applyFilter(buttons, cards, activeGenre, 'genre', (card, genre) => !genre || (card.dataset.genres ?? '').split(',').includes(genre));
    }

    rovingFocus(buttons);

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            activeGenre = btn.dataset.genre ?? '';
            apply();
        });
    });

    apply();
</script>
