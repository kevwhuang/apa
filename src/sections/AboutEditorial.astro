---
import PageHead from '@components/PageHead.astro';
import PlaceholderTile from '@components/PlaceholderTile.astro';
import { PALETTE } from '@lib/utils';

const BIOS = [
    { city: 'East Side', name: 'Yara Soto', role: 'Co-founder / Director', years: '2019 \u2014' },
    { city: 'South Lamar', name: 'Devon Park', role: 'Co-founder / Programs', years: '2019 \u2014' },
    { city: 'North Loop', name: 'Inez Rao', role: 'Producer Bash lead', years: '2021 \u2014' },
    { city: 'Hyde Park', name: 'Marcus Hale', role: 'Store & ops', years: '2022 \u2014' },
    { city: 'Govalle', name: 'Tana Wolfe', role: 'Membership', years: '2023 \u2014' },
    { city: 'Bouldin', name: 'June Castillo', role: 'Press & partnerships', years: '2024 \u2014' },
];

const SECTIONS = [
    { href: '#beginning', label: 'The beginning' },
    { href: '#how', label: 'How it works' },
    { href: '#values', label: 'What we believe' },
    { href: '#team', label: 'The team' },
];

const VALUES = [
    'Producers own their masters. We don\'t sign anyone.',
    'Every event is open to every member, regardless of genre.',
    'Store profit splits back across the room.',
    'Sliding-scale dues. Always.',
];

const teamColors = PALETTE.slice(0, 6);
---

<section
    class="pb-16 pt-20 border-b-2 border-ink"
    aria-labelledby="about-title"
>
    <div class="shell shell--narrow">
        <PageHead
            class="font-extrabold font-sans leading-[0.95] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="About / Est 2019"
            eyebrowClass="mb-6"
            headingId="about-title"
        >
            Six producers met every Tuesday at a coffee shop on Cesar Chavez. Today there are 142 of us.
        </PageHead>
    </div>
</section>

<section
    class="py-20"
    aria-label="About details"
>
    <div class="shell shell--narrow grid gap-12 md:grid-cols-[1fr_2fr]">
        <aside class="self-start md:sticky md:top-28">
            <p class="label mb-3 text-taupe">Sections</p>
            <nav aria-label="Sections">
                <ul class="space-y-2.5 list-none text-[14px]">
                    {SECTIONS.map(section => (
                        <li>
                            <a
                                class="hover:text-coral-dark transition-colors"
                                href={section.href}
                            >
                                {section.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <div class="space-y-8 leading-[1.65] text-[18px]">
            <section
                id="beginning"
                aria-labelledby="beginning-title"
            >
                <h2
                    id="beginning-title"
                    class="reveal mb-3 font-extrabold font-sans text-3xl tracking-tight"
                >
                    The beginning
                </h2>
                <p class="mb-4">
                    Austin's music economy has always favored the performer. Songwriters get rooms, bands
                    get residencies, but producers &mdash; the engineers, beatmakers, and arrangers behind the
                    record &mdash; were everywhere and nowhere at once.
                </p>
                <p>
                    APA started as a Tuesday-night beat-making circle in <time datetime="2019">2019</time>. Six producers, one coffee shop,
                    one rule: bring an unfinished track. Within a year it was sixty people in a basement, and
                    by <time datetime="2022">2022</time> we had moved into a permanent room above a print shop in Austin.
                </p>
            </section>
            <figure class="reveal my-10 py-10 border-y-2 border-ink">
                <blockquote class="mb-6 font-extrabold font-sans leading-[1.1] text-3xl tracking-[-0.02em] md:text-4xl">
                    <span class="text-coral">&ldquo;</span>It's the only room in the city where you can show up with a half-finished beat at 9 p.m. on a Tuesday and leave with a finished record.<span class="text-coral">&rdquo;</span>
                </blockquote>
                <figcaption class="label text-taupe">Yara Soto / co-founder</figcaption>
            </figure>
            <section
                id="how"
                aria-labelledby="how-title"
            >
                <h2
                    id="how-title"
                    class="reveal mb-3 font-extrabold font-sans text-3xl tracking-tight"
                >
                    How it works
                </h2>
                <p>
                    Membership is open to anyone making music in Austin. We charge sliding-scale annual dues
                    ($0&ndash;$120) that cover room rent and equipment. Members get the keys.
                </p>
            </section>
            <section
                id="values"
                aria-labelledby="values-title"
            >
                <h2
                    id="values-title"
                    class="reveal mb-3 font-extrabold font-sans text-3xl tracking-tight"
                >
                    What we believe
                </h2>
                <ul class="reveal--stagger space-y-3 list-none">
                    {VALUES.map((value, index) => (
                        <li class="flex gap-4">
                            <span class="label pt-1 text-coral-dark">{String(index + 1).padStart(2, '0')}</span>
                            <span>{value}</span>
                        </li>
                    ))}
                </ul>
            </section>
            <section
                id="team"
                aria-labelledby="team-title"
            >
                <h2
                    id="team-title"
                    class="reveal mb-6 font-extrabold font-sans text-3xl tracking-tight"
                >
                    The team
                </h2>
                <ul class="reveal--stagger grid gap-5 list-none md:grid-cols-2">
                    {BIOS.map((bio, index) => (
                        <li class="card card-hover">
                            <PlaceholderTile
                                class="aspect-[4/3]"
                                color={teamColors[index]}
                                label={bio.name.split(' ').map(word => word[0]).join('')}
                                labelClass="text-[64px] text-white/80"
                            />
                            <div class="p-4">
                                <h3 class="font-extrabold font-sans tracking-tight">{bio.name}</h3>
                                <p class="font-mono text-[12px] text-taupe">
                                    {`${bio.role} / ${bio.city} / ${bio.years}`}
                                </p>
                            </div>
                        </li>
                    ))}
                </ul>
            </section>
        </div>
    </div>
</section>
