---
import PageHead from '@components/PageHead.astro';
import PlaceholderTile from '@components/PlaceholderTile.astro';

const CTAS = [
    { href: '/', label: 'Home', primary: true },
    { href: '/events', label: 'Events', primary: false },
    { href: '/producers', label: 'Producers', primary: false },
];
---

<section
    class="flex items-center min-h-[80vh]"
    aria-labelledby="not-found-title"
>
    <div class="shell shell--narrow grid items-center gap-12 py-20 md:grid-cols-2">
        <div>
            <PageHead
                class="font-extrabold font-sans leading-[0.85] text-[clamp(96px,17.2vw,220px)] tracking-[-0.04em]"
                eyebrow="Error / Signal lost"
                eyebrowClass="mb-6"
                headingId="not-found-title"
            >
                404
            </PageHead>
            <p class="reveal max-w-md mb-8 pt-6 text-[18px] text-taupe">
                That track isn't on the timeline. Try one of these instead.
            </p>
            <div class="reveal flex flex-wrap gap-3">
                {CTAS.map(cta => (
                    <a
                        class:list={['btn', cta.primary && 'btn--primary', 'h-11']}
                        href={cta.href}
                    >
                        {cta.label}
                    </a>
                ))}
            </div>
        </div>
        <PlaceholderTile
            class="reveal aspect-square border-2 border-ink shadow-card"
            color="var(--color-coral)"
            label="?"
            labelClass="text-[180px] text-white/80"
        />
    </div>
</section>
