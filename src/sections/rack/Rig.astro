---
import IconPause from '@components/icons/Pause.astro';
import IconPlay from '@components/icons/Play.astro';
import IconPower from '@components/icons/Power.astro';
import IconUpload from '@components/icons/Upload.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import {
    CHORUS_DEPTH_DEFAULT,
    CHORUS_RATE_DEFAULT,
    COMPRESSOR_RATIO_DEFAULT,
    COMPRESSOR_THRESHOLD_DEFAULT,
    DELAY_FEEDBACK_DEFAULT,
    DELAY_TIME_DEFAULT,
    DISTORTION_DRIVE_DEFAULT,
    EQ_HIGH_GAIN_DEFAULT,
    EQ_LOW_GAIN_DEFAULT,
    EQ_MID_GAIN_DEFAULT,
    FILTER_RESONANCE_DEFAULT,
    GATE_THRESHOLD_DEFAULT,
    HIGHPASS_RESONANCE_DEFAULT,
    LIMITER_THRESHOLD_DEFAULT,
    PAN_POSITION_DEFAULT,
    REVERB_DECAY_DEFAULT,
    REVERB_WET_DEFAULT,
    SATURATOR_DRIVE_DEFAULT,
    TREMOLO_DEPTH_DEFAULT,
    TREMOLO_RATE_DEFAULT,
    TRIM_GAIN_DEFAULT,
} from '@lib/rack/blocks';
import { MODULE_NAMES } from '@lib/rack/rack';
import { RACK_EXTENSION_LIST, RACK_MAX_BYTES } from '@lib/rack/loader';
import { UPLOAD } from '@lib/shared/constants';
import { formatBytes, formatEntry } from '@lib/shared/utils';

interface Module {
    blurb: string;
    featured?: boolean;
    id: string;
    kind: keyof typeof MODULE_NAMES;
    readout?: string;
    role: string;
    sliders: ModuleSlider[];
    visualization?: 'canvas' | 'readout';
}

interface ModuleSlider {
    display: string;
    label: string;
    max: number;
    min: number;
    parameter: string;
    step: number;
    value: number;
}

const DISTORTION_TONE_POSITION = 0.7819;
const FILTER_CUTOFF_POSITION = 0.5498;
const HIGHPASS_CUTOFF_POSITION = 0.389;

const MODULES: Module[] = [
    {
        blurb: 'Sets the level running into everything downstream. Pull it back before you drive the saturator, or lean on it to push the compressor harder.',
        id: 'tare',
        kind: 'trim',
        role: 'Input trim',
        sliders: [
            { display: '+0.0 dB', label: 'Gain', max: 12, min: -24, parameter: 'gain', step: 0.5, value: TRIM_GAIN_DEFAULT },
        ],
    },
    {
        blurb: 'A resonant low-pass: everything above the corner falls away. Sweep the cutoff against a running loop and raise Q until the corner sings.',
        id: 'sieve',
        kind: 'filter',
        role: 'Low-pass filter',
        sliders: [
            { display: '1.15 kHz', label: 'Cutoff', max: 1, min: 0, parameter: 'cutoff', step: 0.001, value: FILTER_CUTOFF_POSITION },
            { display: 'Q 4.0', label: 'Reso', max: 18, min: 0.5, parameter: 'resonance', step: 0.1, value: FILTER_RESONANCE_DEFAULT },
        ],
    },
    {
        blurb: 'Cuts everything under the corner, where rumble and mud collect. The scale is logarithmic, and a high Q rings the corner itself.',
        id: 'sill',
        kind: 'highpass',
        role: 'High-pass filter',
        sliders: [
            { display: '120 Hz', label: 'Cutoff', max: 1, min: 0, parameter: 'cutoff', step: 0.001, value: HIGHPASS_CUTOFF_POSITION },
            { display: 'Q 1.0', label: 'Reso', max: 12, min: 0.5, parameter: 'resonance', step: 0.1, value: HIGHPASS_RESONANCE_DEFAULT },
        ],
    },
    {
        blurb: 'Three bands: a low shelf, a peaking mid, and a high shelf. Boost or cut any of them and the tilt lands on the chain immediately.',
        featured: true,
        id: 'ledger',
        kind: 'eq',
        role: 'Equalizer',
        sliders: [
            { display: '+4.0 dB', label: 'Low', max: 12, min: -12, parameter: 'low', step: 0.5, value: EQ_LOW_GAIN_DEFAULT },
            { display: '+0.0 dB', label: 'Mid', max: 12, min: -12, parameter: 'mid', step: 0.5, value: EQ_MID_GAIN_DEFAULT },
            { display: '+3.0 dB', label: 'High', max: 12, min: -12, parameter: 'high', step: 0.5, value: EQ_HIGH_GAIN_DEFAULT },
        ],
    },
    {
        blurb: 'An RMS watcher opens and closes a gain stage with fast ramps. Set the threshold above the noise floor and below the hits.',
        id: 'latch',
        kind: 'gate',
        readout: 'Gate closed',
        role: 'Noise gate',
        sliders: [
            { display: '-45 dB', label: 'Thresh', max: -10, min: -70, parameter: 'threshold', step: 1, value: GATE_THRESHOLD_DEFAULT },
        ],
        visualization: 'readout',
    },
    {
        blurb: 'Pull the threshold down until the gain-reduction readout moves, then set how hard it leans once the signal crosses the line.',
        featured: true,
        id: 'clamp',
        kind: 'compressor',
        readout: 'GR 0.0 dB',
        role: 'Compressor',
        sliders: [
            { display: '-28 dB', label: 'Thresh', max: 0, min: -60, parameter: 'threshold', step: 1, value: COMPRESSOR_THRESHOLD_DEFAULT },
            { display: '4.0:1', label: 'Ratio', max: 20, min: 1, parameter: 'ratio', step: 0.5, value: COMPRESSOR_RATIO_DEFAULT },
        ],
        visualization: 'readout',
    },
    {
        blurb: 'Hard clipping, harder-edged than the saturator that follows. The curve shears flat at the rails instead of rounding into them, so the harmonics come out brittle and loud. The tone control is a low-pass that tames the fizz clipping throws off.',
        id: 'scorch',
        kind: 'distortion',
        role: 'Distortion',
        sliders: [
            { display: '8.0', label: 'Drive', max: 30, min: 1, parameter: 'drive', step: 0.5, value: DISTORTION_DRIVE_DEFAULT },
            { display: '6.00 kHz', label: 'Tone', max: 1, min: 0, parameter: 'tone', step: 0.001, value: DISTORTION_TONE_POSITION },
        ],
    },
    {
        blurb: 'A tanh drive curve, oversampled 4x, and makeup gain that holds the level steady as drive rises. Soft knees, no hard edges. It sits ahead of the time effects, so the repeats inherit the dirt.',
        id: 'grit',
        kind: 'saturator',
        role: 'Saturator',
        sliders: [
            { display: '3.0', label: 'Drive', max: 10, min: 1, parameter: 'drive', step: 0.1, value: SATURATOR_DRIVE_DEFAULT },
        ],
    },
    {
        blurb: 'Two modulated delay lines run against the dry path. Rate moves the LFO, depth widens the sweep either side of it.',
        id: 'weave',
        kind: 'chorus',
        role: 'Chorus',
        sliders: [
            { display: '1.20 Hz', label: 'Rate', max: 5, min: 0.1, parameter: 'rate', step: 0.05, value: CHORUS_RATE_DEFAULT },
            { display: '50%', label: 'Depth', max: 1, min: 0, parameter: 'depth', step: 0.01, value: CHORUS_DEPTH_DEFAULT },
        ],
    },
    {
        blurb: 'One LFO on one gain stage: amplitude modulation, nothing more. Rate is the speed of the pulse, depth is how far each dip falls.',
        id: 'pulse',
        kind: 'tremolo',
        role: 'Tremolo',
        sliders: [
            { display: '4.5 Hz', label: 'Rate', max: 12, min: 0.1, parameter: 'rate', step: 0.1, value: TREMOLO_RATE_DEFAULT },
            { display: '60%', label: 'Depth', max: 1, min: 0, parameter: 'depth', step: 0.01, value: TREMOLO_DEPTH_DEFAULT },
        ],
    },
    {
        blurb: 'Time and feedback into a real feedback loop, capped just short of self-oscillation. Long times with high feedback stack up fast.',
        id: 'relay',
        kind: 'delay',
        role: 'Delay',
        sliders: [
            { display: '0.35 s', label: 'Time', max: 1, min: 0.05, parameter: 'time', step: 0.01, value: DELAY_TIME_DEFAULT },
            { display: '45%', label: 'Feedback', max: 0.85, min: 0, parameter: 'feedback', step: 0.01, value: DELAY_FEEDBACK_DEFAULT },
        ],
    },
    {
        blurb: 'Convolution against a noise impulse that regenerates whenever the decay changes. Wet sets how much of the room reaches the output.',
        featured: true,
        id: 'chamber',
        kind: 'reverb',
        role: 'Reverb',
        sliders: [
            { display: '2.4 s', label: 'Decay', max: 6, min: 0.2, parameter: 'decay', step: 0.1, value: REVERB_DECAY_DEFAULT },
            { display: '40%', label: 'Wet', max: 1, min: 0, parameter: 'wet', step: 0.01, value: REVERB_WET_DEFAULT },
        ],
    },
    {
        blurb: 'A stereo panner across the field. Center is dead ahead, and either edge leaves you with a single speaker.',
        id: 'bearing',
        kind: 'pan',
        role: 'Stereo panner',
        sliders: [
            { display: 'Center', label: 'Position', max: 1, min: -1, parameter: 'position', step: 0.01, value: PAN_POSITION_DEFAULT },
        ],
    },
    {
        blurb: 'A 20:1 brickwall with a 1 ms attack, sitting last before the analysis stages. Drag the ceiling down and the gain-reduction readout shows how many decibels it pulls off the peaks.',
        id: 'ceiling',
        kind: 'limiter',
        readout: 'GR 0.0 dB',
        role: 'Limiter',
        sliders: [
            { display: '-12.0 dB', label: 'Ceiling', max: 0, min: -30, parameter: 'threshold', step: 0.5, value: LIMITER_THRESHOLD_DEFAULT },
        ],
        visualization: 'readout',
    },
    {
        blurb: 'A passthrough level meter reading whatever reaches it. The bars run while the rack plays and rest the moment it stops.',
        id: 'needle',
        kind: 'meter',
        role: 'Metering',
        sliders: [],
        visualization: 'canvas',
    },
    {
        blurb: 'Autocorrelation on the signal at this point in the chain: hertz, nearest note, cents off. Feed it something monophonic. Chords read as nonsense.',
        id: 'pitchfork',
        kind: 'tuner',
        readout: '\u2014',
        role: 'Tuner',
        sliders: [],
        visualization: 'readout',
    },
];
---

<section
    class="stage stage--tight content-between overflow-hidden relative min-h-[min(820px,82svh)] border-b-2 border-border-strong"
    aria-labelledby="rig-title"
>
    <div
        class="rack__scene stage__item--full absolute inset-0 pointer-events-none"
        aria-hidden="true"
    >
        <canvas class="rack__canvas" hidden />
    </div>
    <div class="flex flex-col relative gap-6">
        <PageHead
            class="max-w-4xl text-7xl max-md:text-5xl"
            headingId="rig-title"
        >
            One live rack
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            Sixteen Web Audio processors run as a single chain in your browser, with nothing to
            install. Load one file, switch modules in and out of the signal path, and hear the
            change as it plays.
        </p>
    </div>
    <dl
        class="rack__ledger relative"
        aria-label="How the rack works"
        data-motion-stagger="rise"
    >
        <div class="rack__cell--flag content-center grid px-(--space-sm) py-(--space-xs)">
            <dt class="label mb-(--space-2xs) text-text-inverse-secondary">Modules</dt>
            <dd
                class="font-bold font-display leading-none text-4xl tracking-[-0.02em]"
                data-motion-count={String(MODULES.length)}
            >
                {MODULES.length}
            </dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Formats</dt>
            <dd class="font-mono text-base">{RACK_EXTENSION_LIST}</dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Ceiling</dt>
            <dd class="font-mono text-base">{formatBytes(RACK_MAX_BYTES)} per file</dd>
        </div>
        <div class="content-center grid px-(--space-sm) py-(--space-xs) bg-bg-page">
            <dt class="label mb-(--space-3xs) text-text-secondary">Output</dt>
            <dd class="font-mono text-base">Plays through the site player</dd>
        </div>
    </dl>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="rack-title"
>
    <div
        class="mark rack slab slab--well"
        data-motion="unfold"
        data-rack-master
    >
        <SectionHead
            class="text-2xl text-balance"
            headingId="rack-title"
            tone="dark"
        >
            Load a file and build the chain
        </SectionHead>
        <div class="rack__body">
            <label
                class="halftone rack__drop"
                data-rack-drop
                for="rack-file"
            >
                <IconUpload />
                <span class="action-text transition-colors">Drop or choose audio</span>
                <span class="font-mono text-base text-text-inverse">
                    {RACK_EXTENSION_LIST} only. Up to {formatBytes(RACK_MAX_BYTES)}.
                </span>
                <input
                    id="rack-file"
                    class="sr-only"
                    accept={UPLOAD.acceptAttribute}
                    aria-describedby="rack-error"
                    aria-label="Drop or choose audio"
                    data-rack-input
                    type="file"
                />
            </label>
            <div class="flex items-center gap-(--space-sm) p-(--space-sm) border border-border-inverse-subtle">
                <button
                    class="rack__play"
                    aria-pressed="false"
                    data-rack-toggle
                    disabled
                    type="button"
                >
                    <span data-rack-icon-play><IconPlay /></span>
                    <span
                        data-rack-icon-pause
                        hidden
                    >
                        <IconPause />
                    </span>
                    <span
                        class="sr-only"
                        data-rack-toggle-label
                    >
                        Play rack
                    </span>
                </button>
                <div class="min-w-0">
                    <p
                        class="rack__meta flex items-center gap-(--space-2xs) text-base"
                        aria-live="polite"
                        data-rack-meta
                    >
                        <span
                            class="spinner"
                            aria-hidden="true"
                            data-rack-spinner
                            hidden
                        />
                        <span
                            class="truncate"
                            data-rack-meta-text
                        >
                            No file loaded
                        </span>
                    </p>
                    <p
                        id="rack-error"
                        class="empty:hidden text-base text-error-text-on-inverse"
                        aria-live="polite"
                        data-rack-error
                    />
                </div>
            </div>
            <ol
                class="col-span-full flex flex-wrap items-center gap-(--space-sm) list-none"
                data-rack-path
            >
                <li class="rack__node">In</li>
                <li
                    class="rack__node rack__node--idle"
                    data-rack-idle
                >
                    Straight through
                </li>
                <li class="rack__node">Out</li>
            </ol>
            <template data-rack-chip>
                <li
                    class="rack__node rack__node--plug"
                    data-rack-plug
                />
            </template>
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="modules-title"
>
    <div>
        <SectionHead
            class="text-3xl text-balance"
            headingId="modules-title"
        >
            The modules, in signal order
        </SectionHead>
        <ul
            class="rack__grid rank list-none"
            data-motion-stagger="flip"
        >
            {MODULES.map((module, index) => (
                <li class="rack__tile">
                    <article
                        id={module.id}
                        class:list={[
                            'module slab slab--card slab--still grid grid-cols-[minmax(0,1fr)] grid-rows-subgrid row-[1/span_5] space-y-(--space-xs)',
                            module.featured && 'module--featured',
                        ]}
                        data-module={module.kind}
                    >
                        <p class="label flex flex-wrap items-baseline row-1 gap-(--space-2xs)">
                            <span class="text-(--module-accent)">{formatEntry(index + 1)}</span>
                            <span>{module.role}</span>
                        </p>
                        <div class="flex flex-wrap items-center justify-between row-2 gap-(--space-2xs)">
                            <h3
                                class="min-w-0 text-xl"
                                data-module-name
                            >
                                {MODULE_NAMES[module.kind]}
                            </h3>
                            <button
                                class="chip module__active"
                                aria-pressed="false"
                                data-module-active
                                type="button"
                            >
                                <IconPower />
                                <span class="sr-only">{MODULE_NAMES[module.kind]} active</span>
                            </button>
                        </div>
                        <p class="row-3 text-base text-(--module-mute)">
                            {module.blurb}
                        </p>
                        {module.sliders.length > 0 && (
                            <div class="flex flex-col row-4">
                                {module.sliders.map(slider => (
                                    <label class="grid grid-cols-[80px_minmax(0,1fr)_76px] items-center min-h-(--control-size) gap-(--space-2xs) max-lg:grid-cols-[72px_minmax(0,1fr)_76px]">
                                        <span class="label whitespace-nowrap text-(--module-mute)">{slider.label}</span>
                                        <input
                                            class="range h-(--control-size)"
                                            aria-valuetext={slider.display}
                                            data-module-parameter={slider.parameter}
                                            max={slider.max}
                                            min={slider.min}
                                            step={slider.step}
                                            type="range"
                                            value={slider.value}
                                        />
                                        <output
                                            class="font-mono text-sm select-none"
                                            data-module-value={slider.parameter}
                                        >
                                            {slider.display}
                                        </output>
                                    </label>
                                ))}
                            </div>
                        )}
                        {module.visualization === 'canvas' && (
                            <div class="row-5">
                                <canvas
                                    class="block min-h-20 w-full border-(--module-line) border-2 bg-(--module-fill)"
                                    aria-label={`${MODULE_NAMES[module.kind]} level meter`}
                                    data-module-canvas
                                    height="80"
                                    role="img"
                                    width="320"
                                />
                            </div>
                        )}
                        {module.visualization === 'readout' && (
                            <div class="row-5">
                                <p
                                    class="flex items-center justify-center min-h-(--control-size) px-(--space-xs) py-(--space-2xs) border-(--module-line) border-2 font-mono text-center text-lg bg-(--module-fill) select-none"
                                    data-module-readout
                                >
                                    {module.readout}
                                </p>
                            </div>
                        )}
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .module {
        --module-accent: var(--color-link);
        --module-contrast: var(--color-text-inverse);
        --module-fill: var(--color-bg-sunken);
        --module-invert: var(--color-bg-inverse);
        --module-line: var(--color-border-strong);
        --module-mute: var(--color-text-secondary);
    }

    .module--engaged::before {
        background-color: var(--color-signal);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--space-3xs);
    }

    .module--featured {
        --slab-line: var(--color-signal);
    }

    .module__active {
        border-color: var(--module-line);
        color: inherit;
        flex: 0 0 auto;
        height: var(--control-size);
        padding: 0;
        transition: transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .module__active:active {
        transform: translateY(1px);
    }

    .module__active:hover {
        background-color: var(--module-invert);
        border-color: var(--module-invert);
        color: var(--module-contrast);
    }

    .module__active[aria-pressed='true'] {
        background-color: var(--color-btn-primary-bg);
        border-color: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .module__active[aria-pressed='true']:hover {
        background-color: var(--color-btn-primary-bg-hover);
        border-color: var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
    }

    .rack .action-text:hover {
        color: var(--color-link-on-inverse);
    }

    .rack.is-decoding .rack__meta {
        color: var(--color-link-on-inverse);
    }

    .rack__body {
        display: grid;
        gap: var(--space-md);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .rack__canvas {
        display: block;
        height: 100%;
        transition: opacity var(--duration-cinematic) var(--motion-ease-entrance);
        width: 100%;
    }

    .rack__cell--flag {
        background-color: var(--color-bg-inverse);
        color: var(--color-text-inverse);
        padding: var(--space-md) var(--space-lg);
    }

    .rack__drop {
        --halftone-ink: var(--color-text-secondary);
        align-items: center;
        background-color: var(--color-bg-inverse-raised);
        border: 2px dashed currentColor;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        justify-content: center;
        min-height: 132px;
        padding: var(--space-sm);
        text-align: center;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .rack__drop > span {
        background-color: var(--color-bg-inverse-raised);
    }

    .rack__drop.is-dragging {
        background-image: none;
        border-color: var(--color-border-selected);
        border-style: solid;
    }

    .rack__drop:active {
        transform: translateY(1px);
    }

    .rack__drop:has(input:focus-visible) {
        border-color: var(--color-border-selected);
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 2px;
    }

    .rack__drop:hover {
        border-color: var(--color-border-selected);
    }

    .rack__grid {
        --rank-cols: repeat(2, minmax(0, 1fr));
        column-gap: var(--space-lg);
        margin-bottom: calc(-1 * var(--space-2xl));
        row-gap: 0;
    }

    .rack__ledger {
        background-color: var(--color-border-strong);
        border: 2px solid var(--color-border-strong);
        display: grid;
        gap: 2px;
        grid-template-columns: minmax(200px, 0.62fr) repeat(3, minmax(0, 1fr));
    }

    .rack__node {
        align-items: center;
        border: 1px solid var(--color-border-inverse-subtle);
        color: var(--color-text-inverse-secondary);
        display: inline-flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.06em;
        line-height: 1;
        min-height: 36px;
        padding: 0 var(--space-2xs);
        position: relative;
        text-transform: uppercase;
    }

    .rack__node + .rack__node::before {
        background-color: var(--color-text-inverse-secondary);
        content: '';
        height: 8px;
        inset: auto calc(100% + var(--space-3xs)) auto auto;
        mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='59' height='50' viewBox='0 0 59 50'><path d='M6 25h44M34 6l19 19-19 19' fill='none' stroke='currentColor' stroke-linecap='square' stroke-width='8'/></svg>");
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: contain;
        position: absolute;
        width: 8px;
    }

    .rack__node--idle {
        border-style: dashed;
    }

    .rack__node--plug {
        background-color: var(--color-signal);
        border-color: var(--color-signal);
        color: var(--color-text-on-signal);
    }

    .rack__play {
        align-items: center;
        background-color: var(--color-btn-primary-bg);
        border: 2px solid var(--color-btn-primary-bg);
        color: var(--color-btn-primary-text);
        display: inline-flex;
        flex: 0 0 auto;
        height: 64px;
        justify-content: center;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 64px;
    }

    .rack__play:active:not(:disabled) {
        transform: translateY(1px);
    }

    .rack__play:disabled {
        background-color: transparent;
        border-color: currentColor;
        color: var(--color-text-inverse-disabled);
    }

    .rack__play:hover:not(:disabled) {
        background-color: var(--color-btn-primary-bg-hover);
        border-color: var(--color-btn-primary-bg);
    }

    .rack__play[aria-pressed='true'] {
        background-color: var(--color-text-inverse);
        border-color: var(--color-text-inverse);
        color: var(--color-bg-inverse);
    }

    .rack__play[aria-pressed='true']:hover {
        background-color: var(--color-bg-hover);
        border-color: var(--color-border-selected);
        color: var(--color-text);
    }

    .rack__tile {
        display: grid;
        grid-row: span 6;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .rack__tile::after {
        content: '';
        display: block;
        grid-row: 6;
        height: var(--space-2xl);
    }

    @media (max-width: 1024px) {
        .rack__cell--flag {
            grid-row: span 3;
        }

        .rack__ledger {
            grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .rack__body {
            grid-template-columns: minmax(0, 1fr);
        }

        .rack__cell--flag {
            grid-row: auto;
            padding: var(--space-sm) var(--space-md);
        }

        .rack__grid {
            --rank-cols: minmax(0, 1fr);
        }

        .rack__ledger {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { ANALYSER_FFT } from '@lib/rack/blocks';
    import {
        MODULE_NAMES,
        RACK_ORDER,
        getRackAnalyser,
        getRackReadout,
        getRackState,
        loadRackFile,
        onRackChange,
        setModuleActive,
        setRackParameter,
        toggleRack,
    } from '@lib/rack/rack';
    import { STORAGE } from '@lib/shared/constants';
    import { formatDuration, preventNavigation, registerPageScript, setHidden, setText } from '@lib/shared/utils';
    import { initRig } from '@lib/motion/rig';
    import { readColorToken } from '@lib/motion/tokens';
    import { validateRackFile } from '@lib/rack/loader';

    interface MeterView {
        accent: string;
        height: number;
        ink: string;
        unlit: string;
        unlitAccent: string;
        width: number;
    }

    interface ModuleView {
        canvas: HTMLCanvasElement | null;
        card: HTMLElement;
        idle: string;
        kind: RackKind;
        meter: MeterView | null;
        readout: HTMLElement | null;
        toggle: HTMLButtonElement;
    }

    const ACCENT_SEGMENTS = 4;
    const CUTOFF_MAX = 18_000;
    const CUTOFF_MIN = 40;
    const DISTORTION_TONE_MAX = 12_000;
    const DISTORTION_TONE_MIN = 500;
    const HERTZ_PER_KILOHERTZ = 1_000;
    const HIGHPASS_MAX = 2_000;
    const HIGHPASS_MIN = 20;
    const METER_GAP = 2;
    const METER_INSET = 4;
    const METER_SEGMENTS = 24;
    const PERCENT = 100;
    const PIXEL_RATIO_MAX = 2;

    const PARAMETER_FORMATS: Record<string, (value: number) => string> = {
        'chorus:depth': value => `${Math.round(value * PERCENT)}%`,
        'chorus:rate': value => `${value.toFixed(2)} Hz`,
        'compressor:ratio': value => `${value.toFixed(1)}:1`,
        'compressor:threshold': value => `${Math.round(value)} dB`,
        'delay:feedback': value => `${Math.round(value * PERCENT)}%`,
        'delay:time': value => `${value.toFixed(2)} s`,
        'distortion:drive': value => value.toFixed(1),
        'distortion:tone': formatHertz,
        'eq:high': formatSignedDecibels,
        'eq:low': formatSignedDecibels,
        'eq:mid': formatSignedDecibels,
        'filter:cutoff': formatHertz,
        'filter:resonance': value => `Q ${value.toFixed(1)}`,
        'gate:threshold': value => `${Math.round(value)} dB`,
        'highpass:cutoff': formatHertz,
        'highpass:resonance': value => `Q ${value.toFixed(1)}`,
        'limiter:threshold': value => `${value.toFixed(1)} dB`,
        'pan:position': value => (value === 0 ? 'Center' : `${value < 0 ? 'L' : 'R'} ${Math.round(Math.abs(value) * PERCENT)}`),
        'reverb:decay': value => `${value.toFixed(1)} s`,
        'reverb:wet': value => `${Math.round(value * PERCENT)}%`,
        'saturator:drive': value => value.toFixed(1),
        'tremolo:depth': value => `${Math.round(value * PERCENT)}%`,
        'tremolo:rate': value => `${value.toFixed(1)} Hz`,
        'trim:gain': formatSignedDecibels,
    };

    const PARAMETER_SCALES: Record<string, (value: number) => number> = {
        'distortion:tone': value => DISTORTION_TONE_MIN * (DISTORTION_TONE_MAX / DISTORTION_TONE_MIN) ** value,
        'filter:cutoff': value => CUTOFF_MIN * (CUTOFF_MAX / CUTOFF_MIN) ** value,
        'highpass:cutoff': value => HIGHPASS_MIN * (HIGHPASS_MAX / HIGHPASS_MIN) ** value,
    };

    const meterData = new Float32Array(ANALYSER_FFT);

    let depth = 0;
    let frame = 0;
    let requests = 0;
    let unsubscribe: (() => void) | undefined;
    let views: ModuleView[] = [];

    function applyParameter(view: ModuleView, range: HTMLInputElement) {
        const parameter = range.dataset.moduleParameter ?? '';

        const key = `${view.kind}:${parameter}`;

        const mapped = (PARAMETER_SCALES[key] ?? (value => value))(Number(range.value));

        const text = (PARAMETER_FORMATS[key] ?? String)(mapped);

        range.ariaValueText = text;
        setRackParameter(view.kind, parameter, mapped);
        setText(view.card.querySelector(`[data-module-value="${parameter}"]`), text);
    }

    function bindParameter(view: ModuleView, range: HTMLInputElement, signal: AbortSignal) {
        range.addEventListener('input', () => applyParameter(view, range), { signal });
        applyParameter(view, range);
    }

    function buildView(card: HTMLElement, signal: AbortSignal) {
        const canvas = card.querySelector<HTMLCanvasElement>('[data-module-canvas]');
        const readout = card.querySelector<HTMLElement>('[data-module-readout]');
        const toggle = card.querySelector<HTMLButtonElement>('[data-module-active]');

        if (!toggle) return null;

        const kind = card.dataset.module as RackKind;

        const view: ModuleView = {
            canvas,
            card,
            idle: readout?.textContent?.trim() ?? '',
            kind,
            meter: canvas ? createMeterView(canvas) : null,
            readout,
            toggle,
        };

        toggle.addEventListener('click', () => setModuleActive(view.kind, view.toggle.getAttribute('aria-pressed') !== 'true'), { signal });
        card.querySelectorAll<HTMLInputElement>('[data-module-parameter]').forEach(range => bindParameter(view, range, signal));

        return view;
    }

    function collectViews(cards: NodeListOf<HTMLElement>, signal: AbortSignal) {
        const collected: ModuleView[] = [];

        cards.forEach((card) => {
            const view = buildView(card, signal);

            if (view) collected.push(view);
        });

        return collected;
    }

    function createMeterView(canvas: HTMLCanvasElement) {
        const bounds = canvas.getBoundingClientRect();
        const ratio = Math.min(PIXEL_RATIO_MAX, Math.max(1, window.devicePixelRatio || 1));
        const styles = getComputedStyle(canvas);

        const height = Math.round(bounds.height) || canvas.height;
        const width = Math.round(bounds.width) || canvas.width;

        canvas.height = Math.round(height * ratio);
        canvas.width = Math.round(width * ratio);
        canvas.getContext('2d')?.setTransform(ratio, 0, 0, ratio, 0, 0);

        return {
            accent: readColorToken(styles, '--color-chart-1'),
            height,
            ink: readColorToken(styles, '--module-line'),
            unlit: readColorToken(styles, '--color-unlit'),
            unlitAccent: readColorToken(styles, '--color-unlit-accent'),
            width,
        };
    }

    function drawMeter(canvas: HTMLCanvasElement, analyser: AnalyserNode | undefined, view: MeterView) {
        const surface = canvas.getContext('2d');

        if (!surface) return;

        surface.clearRect(0, 0, view.width, view.height);

        if (!analyser) return;

        analyser.getFloatTimeDomainData(meterData);

        let peak = 0;

        for (let index = 0; index < meterData.length; index += 1) {
            const value = Math.abs(meterData[index]);

            if (value > peak) peak = value;
        }

        const level = Math.min(1, Math.sqrt(peak));
        const width = view.width / METER_SEGMENTS;

        const lit = Math.round(level * METER_SEGMENTS);

        for (let index = 0; index < METER_SEGMENTS; index += 1) {
            const isAccented = index >= METER_SEGMENTS - ACCENT_SEGMENTS;

            const litColor = isAccented ? view.accent : view.ink;
            const unlitColor = isAccented ? view.unlitAccent : view.unlit;

            surface.fillStyle = index < lit ? litColor : unlitColor;
            surface.fillRect(index * width + METER_GAP / 2, METER_INSET, width - METER_GAP, view.height - 2 * METER_INSET);
        }
    }

    function formatHertz(value: number) {
        if (value >= HERTZ_PER_KILOHERTZ) return `${(value / HERTZ_PER_KILOHERTZ).toFixed(2)} kHz`;

        return `${Math.round(value)} Hz`;
    }

    function formatSignedDecibels(value: number) {
        return `${value >= 0 ? '+' : ''}${value.toFixed(1)} dB`;
    }

    function handleDragEnter(event: DragEvent, zone: HTMLElement) {
        preventNavigation(event);
        setDragDepth(zone, depth + 1);
    }

    function handleDragLeave(zone: HTMLElement) {
        setDragDepth(zone, depth - 1);
    }

    function handleDrop(event: DragEvent, zone: HTMLElement, signal: AbortSignal) {
        preventNavigation(event);
        handleFiles(event.dataTransfer?.files, signal);
        setDragDepth(zone, 0);
    }

    function handleFiles(files: FileList | null | undefined, signal: AbortSignal) {
        const file = files?.[0];

        if (file) void intake(file, signal);
    }

    function handleInputChange(input: HTMLInputElement, signal: AbortSignal) {
        handleFiles(input.files, signal);
        input.value = '';
    }

    function handleInputKeydown(event: KeyboardEvent, input: HTMLInputElement) {
        if (event.key !== 'Enter') return;

        event.preventDefault();
        input.click();
    }

    function handleThemeChange() {
        views.forEach((view) => {
            if (view.canvas) view.meter = createMeterView(view.canvas);
        });

        render();
    }

    function initRack(signal: AbortSignal) {
        const cards = document.querySelectorAll<HTMLElement>('[data-module]');
        const input = document.querySelector<HTMLInputElement>('[data-rack-input]');
        const toggle = document.querySelector<HTMLButtonElement>('[data-rack-toggle]');
        const zone = document.querySelector<HTMLElement>('[data-rack-drop]');

        if (!input || !toggle || !zone || cards.length === 0) return;

        unsubscribe?.();
        unsubscribe = onRackChange(render);
        views = collectViews(cards, signal);
        input.addEventListener('change', () => handleInputChange(input, signal), { signal });
        input.addEventListener('keydown', event => handleInputKeydown(event, input), { signal });
        signal.addEventListener('abort', teardown, { once: true });
        toggle.addEventListener('click', toggleRack, { signal });
        window.addEventListener(STORAGE.theme.topic, handleThemeChange, { signal });
        window.addEventListener('dragover', preventNavigation, { signal });
        window.addEventListener('drop', preventNavigation, { signal });
        zone.addEventListener('dragenter', event => handleDragEnter(event, zone), { signal });
        zone.addEventListener('dragleave', () => handleDragLeave(zone), { signal });
        zone.addEventListener('dragover', preventNavigation, { signal });
        zone.addEventListener('drop', event => handleDrop(event, zone, signal), { signal });
        render();
    }

    async function intake(file: File, signal: AbortSignal) {
        const invalid = validateRackFile(file);
        const token = (requests += 1);

        setText(document.querySelector('[data-rack-error]'), invalid ?? '');

        if (invalid) {
            setDecoding(false);

            return;
        }

        setDecoding(true);
        setText(document.querySelector('[data-rack-meta-text]'), 'Decoding\u2026');

        const result = await loadRackFile(file);

        if (signal.aborted || token !== requests) return;

        render();
        setDecoding(false);

        if (!result.ok) setText(document.querySelector('[data-rack-error]'), result.message);
    }

    function paintView(view: ModuleView) {
        if (view.canvas && view.meter) drawMeter(view.canvas, getRackAnalyser(view.kind), view.meter);
        if (view.readout) setText(view.readout, getRackReadout(view.kind) ?? view.idle);
    }

    function render() {
        const state = getRackState();

        cancelAnimationFrame(frame);
        renderMaster(state);
        renderPath(state);
        views.forEach(view => renderView(view, state));

        if (state.playing) frame = requestAnimationFrame(renderFrame);
    }

    function renderFrame() {
        views.forEach(paintView);
        frame = requestAnimationFrame(renderFrame);
    }

    function renderMaster(state: RackState) {
        const meta = document.querySelector<HTMLElement>('[data-rack-meta]');
        const toggle = document.querySelector<HTMLButtonElement>('[data-rack-toggle]');

        if (!meta || !toggle) return;

        meta.classList.toggle('font-mono', state.fileName !== null);
        meta.title = state.fileName ?? '';
        toggle.disabled = state.fileName === null;
        setHidden(document.querySelector<HTMLElement>('[data-rack-icon-pause]'), !state.playing);
        setHidden(document.querySelector<HTMLElement>('[data-rack-icon-play]'), state.playing);

        setText(
            document.querySelector('[data-rack-meta-text]'),
            state.fileName === null ? 'No file loaded' : `${state.fileName} \u00b7 ${formatDuration(state.durationSeconds)}`,
        );

        setText(document.querySelector('[data-rack-toggle-label]'), state.playing ? 'Pause rack' : 'Play rack');
        toggle.setAttribute('aria-pressed', String(state.playing));
    }

    function renderPath(state: RackState) {
        const chain = [...state.activeKinds].sort((left, right) => RACK_ORDER.indexOf(left) - RACK_ORDER.indexOf(right));
        const idle = document.querySelector<HTMLElement>('[data-rack-idle]');
        const path = document.querySelector<HTMLElement>('[data-rack-path]');
        const template = document.querySelector<HTMLTemplateElement>('[data-rack-chip]');

        if (!idle || !path || !template) return;

        path.querySelectorAll('[data-rack-plug]').forEach(node => node.remove());

        for (const kind of chain) {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const node = fragment.querySelector<HTMLElement>('[data-rack-plug]');

            if (!node) continue;

            setText(node, MODULE_NAMES[kind]);
            idle.before(fragment);
        }

        idle.hidden = state.activeKinds.length > 0;
    }

    function renderView(view: ModuleView, state: RackState) {
        const isActive = state.activeKinds.includes(view.kind);

        view.card.classList.toggle('module--engaged', isActive);
        view.toggle.setAttribute('aria-pressed', String(isActive));

        if (isActive && state.playing) return;

        if (view.canvas && view.meter) drawMeter(view.canvas, undefined, view.meter);
        if (view.readout) setText(view.readout, view.idle);
    }

    function setDecoding(isActive: boolean) {
        const master = document.querySelector<HTMLElement>('[data-rack-master]');
        const zone = document.querySelector<HTMLElement>('[data-rack-drop]');

        master?.classList.toggle('is-decoding', isActive);
        setHidden(document.querySelector<HTMLElement>('[data-rack-spinner]'), !isActive);

        if (isActive) zone?.setAttribute('aria-busy', 'true');
        else zone?.removeAttribute('aria-busy');
    }

    function setDragDepth(zone: HTMLElement, next: number) {
        depth = Math.max(0, next);
        zone.classList.toggle('is-dragging', depth > 0);
    }

    function teardown() {
        cancelAnimationFrame(frame);
        unsubscribe?.();
        depth = 0;
        frame = 0;
        unsubscribe = undefined;
        views = [];
    }

    registerPageScript(initRack);
    registerPageScript(initRig);
</script>
