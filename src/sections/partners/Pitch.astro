---
import { Image } from 'astro:assets';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { EVENT_PROGRAMS, PARTNERS, PARTNER_INQUIRY_TOPIC, PARTNER_LOGO_WIDTH } from '@lib/shared/constants';
import { getProgram } from '@lib/shared/utils';

interface Lane {
    detail: string;
    name: string;
}

interface Tier {
    featured?: boolean;
    name: string;
    perks: string[];
    price: string;
}

const DONATION_AMOUNTS = ['$10', '$25', '$50', '$100'];

const DONATION_USES = [
    'Venue deposits and room fees',
    'Cables, adapters, and spare gear',
    'Showcase staging and production',
];

const FOUNDING_YEAR = '2022';
const PRODUCERS_WELCOMED = '1,000+';

const assembly = getProgram('assembly');
const bash = getProgram('bash');
const camp = getProgram('camp');
const contactHref = `/contact?topic=${encodeURIComponent(PARTNER_INQUIRY_TOPIC)}#contact-topic`;
const programs = Object.values(EVENT_PROGRAMS);

const LANES: Lane[] = [
    { detail: `${assembly.name}, the ${bash.name}, and ${camp.name} are open to every genre and experience level. ${assembly.name} meets monthly, the ${bash.name} quarterly, and ${camp.name} twice a year. Showing up is the simplest way in.`, name: 'Come to an event' },
    { detail: `Back the programs with a monthly contribution. It pays for rooms, gear, and keeping ${assembly.name} free to attend. Three levels run from $5 to $250 a month.`, name: 'Sponsor us' },
    { detail: `Host a night, lead a workshop, or bring your venue, gear, studio, or school into a program. Our sponsors already host ${assembly.name} and the ${bash.name}.`, name: 'Collaborate' },
    { detail: 'Cover the Alliance in your publication, podcast, or social feed, with recaps, premieres, and the stories behind the tracks. Our press kit on the resources page has logos and photos.', name: 'Feature us' },
];

const STATS = [
    { label: 'Founded', value: FOUNDING_YEAR },
    { label: 'Welcomed', value: PRODUCERS_WELCOMED },
    { label: 'Programs running', value: String(programs.filter(program => program.state === 'active').length) },
    { label: 'Programs planned', value: String(programs.filter(program => program.state === 'planned').length) },
];

const TIERS: Tier[] = [
    { name: 'Supporter', perks: ['Name on the site', 'Newsletter thank-you'], price: '$5' },
    { featured: true, name: 'Backer', perks: ['Everything in Supporter', 'Featured on the website as a sponsor', `Mention from the front of the room at the ${bash.name}`, 'Guest passes across the year'], price: '$25' },
    { name: 'Patron', perks: ['Everything in Backer', 'Logo on the site and event flyers', `Named partner on one ${bash.name}`, 'Co-branded workshop each year', 'Presence at every event'], price: '$250' },
];
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="partners-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="text-7xl max-md:text-4xl"
            headingId="partners-title"
        >
            Partner with us
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            The Alliance works with venues, brands, studios, and press, and with sponsors who prefer
            to back the work financially. Since May 2022, we've welcomed more than 1,000 producers
            and creatives to our events. Every partnership starts with a conversation about what you
            already have.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="numbers-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="numbers-title"
        >
            By the numbers
        </SectionHead>
        <dl
            class="mark grid grid-cols-4 gap-px border-2 border-border-strong bg-border-strong max-lg:grid-cols-2 max-md:grid-cols-1"
            data-motion-stagger="stamp"
        >
            {STATS.map(stat => (
                <div class="flex flex-col gap-3 p-(--space-md) text-center bg-bg-page">
                    <dt class="label text-text-secondary">{stat.label}</dt>
                    <dd
                        class="font-bold font-display leading-none text-3xl tracking-[-0.02em] max-md:text-2xl"
                        data-motion-count={stat.value}
                    >
                        {stat.value}
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="lanes-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="lanes-title"
        >
            Four ways in
        </SectionHead>
        <p
            class="max-w-2xl mb-10 text-lg text-text-secondary"
            data-motion="blur"
        >
            There are four main ways to get involved. Pick the one that fits what you already have.
            Each one helps keep our volunteer-run programs going.
        </p>
        <ul
            class="grid grid-cols-2 gap-x-(--space-lg) gap-y-(--space-2xl) mb-8 list-none max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            {LANES.map(lane => (
                <li class="slab slab--card p-(--space-lg)">
                    <h3 class="mb-2 text-2xl">{lane.name}</h3>
                    <p class="text-base text-text-secondary">{lane.detail}</p>
                </li>
            ))}
        </ul>
        <div
            class="flex"
            data-motion="rise"
        >
            <a
                class="action-text hover:text-link inline-flex items-center min-h-(--control-size) gap-2 underline underline-offset-4 transition-[color,transform]"
                href={contactHref}
            >
                Start a conversation <IconArrow />
            </a>
        </div>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="tiers-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="tiers-title"
        >
            Support monthly
        </SectionHead>
        <p
            class="max-w-2xl mb-10 text-lg text-text-secondary"
            data-motion="blur"
        >
            Monthly support comes in three levels. Each level builds on the one before it. Every
            dollar goes to the programs.
        </p>
        <ul
            class="tiers grid grid-cols-3 gap-x-(--space-lg) gap-y-(--space-2xl) list-none max-lg:grid-cols-1"
            data-motion-stagger="flip"
        >
            {TIERS.map(tier => (
                <li class="gap-y-5">
                    <article
                        class:list={[
                            'slab slab--still tier',
                            tier.featured ? 'slab--well tier--featured' : 'slab--card',
                            'text-center',
                        ]}
                    >
                        <h3 class="mb-2 font-display text-2xl">{tier.name}</h3>
                        <p
                            class="mb-8 font-mono text-2xl"
                            data-placeholder
                        >
                            {tier.price}<span class:list={['text-base', tier.featured ? 'text-text-inverse-secondary' : 'text-text-secondary']}> / mo</span>
                        </p>
                        <ul class="mb-8 space-y-3 text-base">
                            {tier.perks.map(perk => (
                                <li>
                                    <span
                                        class:list={['font-bold', tier.featured ? 'text-link-on-inverse' : 'text-link']}
                                        aria-hidden="true"
                                    >
                                        +
                                    </span>&nbsp;
                                    {perk}
                                </li>
                            ))}
                        </ul>
                        <a
                            class:list={['btn', tier.featured ? 'btn--accent' : 'btn--primary']}
                            href={contactHref}
                        >
                            Choose this level
                        </a>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="donate-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="donate-title"
        >
            Chip in once
        </SectionHead>
        <div class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-10 max-lg:grid-cols-1">
            <div data-motion="rise">
                <p class="max-w-2xl mb-8 text-lg text-text-secondary">
                    A donation is a one-time gift of any amount. It suits anyone who would rather
                    give once than monthly. It goes directly to the costs that keep the calendar
                    running:
                </p>
                <ul class="mb-8 space-y-3 text-base">
                    {DONATION_USES.map(use => (
                        <li class="flex gap-2">
                            <span
                                class="font-bold text-link"
                                aria-hidden="true"
                            >
                                +
                            </span>
                            {use}
                        </li>
                    ))}
                </ul>
                <p class="max-w-2xl text-sm text-text-secondary">
                    The Alliance is a volunteer-run collective, not a 501(c)(3), so donations aren't
                    tax-deductible. Every dollar still goes to the programs.
                </p>
            </div>
            <div
                class="slab slab--card slab--roomy slab--still"
                data-motion="unfold"
            >
                <p class="label mb-4 text-text-secondary">Suggested amounts</p>
                <ul class="flex flex-wrap gap-3 mb-8 list-none">
                    {DONATION_AMOUNTS.map(amount => (
                        <li class="chip">{amount}</li>
                    ))}
                </ul>
                <a
                    class="btn btn--accent w-full mb-4"
                    data-placeholder
                    href={contactHref}
                >
                    Arrange a donation
                </a>
                <p class="text-base text-text-secondary">
                    Donations are arranged by message, so the contact form is the way to give.
                    Tell us the amount you have in mind and we'll take it from there.
                </p>
            </div>
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="backers-title"
>
    <div>
        <SectionHead
            class="text-4xl"
            headingId="backers-title"
        >
            Backed by
        </SectionHead>
        <ul
            class="grid grid-cols-2 gap-px border-2 border-border-strong list-none bg-border-strong max-md:grid-cols-1"
            data-motion="rise"
        >
            {PARTNERS.map(partner => (
                <li class="partner-tile flex flex-col gap-5 p-[round(clamp(24px,calc(18.667px_+_1.6667vw),40px),4px)] bg-bg-page">
                    <p class="label text-text-secondary">{partner.name}</p>
                    <div class="flex items-center justify-center h-[round(clamp(80px,calc(69.333px_+_3.3333vw),112px),4px)] w-full">
                        <Image
                            class="partner-tile__logo object-contain max-h-full max-w-full"
                            alt={partner.name}
                            densities={[1, 2]}
                            src={partner.logo}
                            width={PARTNER_LOGO_WIDTH}
                        />
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .tier {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
        padding: var(--space-lg) var(--space-md);
    }

    .tier--featured {
        --slab-level: var(--z-card);
        --slab-line: var(--color-border-strong);
        --slab-rule: 2px;
    }

    .tiers > li {
        align-content: start;
        display: grid;
        grid-row: span 4;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }
</style>
