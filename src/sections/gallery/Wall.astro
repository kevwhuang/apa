---
import { Image, getImage } from 'astro:assets';

import PageHead from '@components/shared/PageHead.astro';
import { formatLongMonth } from '@lib/shared/utils';
import { loadEvents } from '@lib/programs/calendar';

import type { ImageMetadata } from 'astro';

const CLASS_VIEWER = 'wall__viewer group fixed grid inset-0 overflow-visible place-items-center z-301 h-auto max-h-none max-w-none w-auto cursor-zoom-out';
const CLASS_VIEWER_PHOTO = 'block box-content object-contain aspect-(--wall-ratio) h-auto min-h-0 w-[calc(100%-4px)] border-2 border-current bg-ink cursor-default pointer-events-auto select-none';

const FIGURES = [
    { alt: 'Nine people gather around a round black metal table on a covered dock, two seated and seven standing, with a lake and a bright cloud-filled sky behind them', image_path: '/src/images/gallery/2026_10_camp_river_oaks.webp', label: 'October 2026 CAMP' },
    { alt: 'Sixteen people pose beneath a projected Austin Producer Alliance Meetup page, three crouching in the front row, a handwritten track list on a whiteboard at left', event_id: '2026_07_bash', image_path: '/src/images/gallery/2026_07_bash.webp' },
    { alt: 'About twenty people pose against a black wall, four crouching in the front row and several flashing peace signs, folded T-shirts stacked on a table at right', event_id: '2026_06_assembly', image_path: '/src/images/gallery/2026_06_assembly_alex_lacroix.webp' },
    { alt: 'A yellow waveform and plugin window are projected on the wall above a wooden cabinet as a speaker sits at a desk at right and attendees follow on laptops', event_id: '2026_05_assembly', image_path: '/src/images/gallery/2026_05_assembly_vonryk.webp' },
    { alt: 'Thirteen people pose behind gray tables in front of a teal Ableton banner, four crouching in the front row', event_id: '2026_04_bash', image_path: '/src/images/gallery/2026_04_bash.webp' },
    { alt: 'Fourteen attendees seated at tables on both sides of a concrete aisle look toward the camera, while a person in a yellow jacket stands at the back by the black wall', event_id: '2025_11_assembly', image_path: '/src/images/gallery/2025_11_assembly.webp' },
    { alt: 'A speaker in a dark blazer gestures mid-sentence between two wall screens showing a Final Tips slide, with a handwritten note on the whiteboard behind', event_id: '2025_08_assembly', image_path: '/src/images/gallery/2025_08_assembly_austin_breckenridge.webp' },
    { alt: 'Attendees spread across rows of white tables face the front, with a MIDI keyboard and laptop on the table at right and a red lettered wall panel on the left', event_id: '2025_07_assembly', image_path: '/src/images/gallery/2025_07_assembly_justin_m.webp' },
    { alt: 'Seen from the front of the room over a laptop, two studio monitors and printed QR code sheets, attendees sit at tables on both sides of a concrete aisle', event_id: '2025_05_assembly', image_path: '/src/images/gallery/2025_05_assembly_jonathan_bolton.webp' },
    { alt: 'Two people stand at the front beside a whiteboard and a title slide, one talking to attendees at tables, as a third stands at right below word-covered panels', event_id: '2025_04_assembly', image_path: '/src/images/gallery/2025_04_assembly_alt_slauson.webp' },
    { alt: 'Attendees sit at rows of tables and laptops in a long room, facing a speaker between two wall screens of music software in the distance', event_id: '2025_03_assembly', image_path: '/src/images/gallery/2025_03_assembly_dreamshift.webp' },
    { alt: 'A speaker at a laptop stands between two wall screens showing the same blue software window, with attendees following along on laptops at rows of tables', event_id: '2025_02_assembly', image_path: '/src/images/gallery/2025_02_assembly_shane_hazleton.webp' },
    { alt: 'Attendees sit in office chairs around a central table of laptops and MIDI keyboards in a lab with blue accent lighting, water bottles on a desk in the foreground', event_id: '2025_02_bash', image_path: '/src/images/gallery/2025_02_bash.webp' },
    { alt: 'A person stands smiling at right beside a laptop and studio monitor as attendees chat at tables across a wide room with a white line-art mural on the far wall', event_id: '2025_01_assembly', image_path: '/src/images/gallery/2025_01_assembly_boomchii.webp' },
    { alt: 'Seen from the front of the room over a laptop and two studio monitors, attendees sit on both sides of a concrete aisle with a white line-art mural on the far wall', event_id: '2024_12_assembly', image_path: '/src/images/gallery/2024_12_assembly_justin_m.webp' },
    { alt: 'Attendees sit at white tables under foil-wrapped ceiling ducts, one smiling toward the camera, with a red water bottle and a phone on the table in the foreground', event_id: '2024_10_assembly', image_path: '/src/images/gallery/2024_10_assembly.webp' },
    { alt: 'Attendees sit at rows of white tables with laptops and water bottles, a black wall on the left and a blue mural with red stars at the far end', event_id: '2024_09_assembly', image_path: '/src/images/gallery/2024_09_assembly.webp' },
    { alt: 'Attendees listen at rows of white tables, one leaning back with hands on the head, a red water bottle and cooler bag in front and a blue mural with red stars behind', event_id: '2024_08_assembly', image_path: '/src/images/gallery/2024_08_assembly.webp' },
    { alt: 'A smiling speaker in a cap stands at a rolling desk with a laptop and two small studio monitors beside a projected slide titled Tips to Get Started in Sync', event_id: '2024_06_assembly', image_path: '/src/images/gallery/2024_06_assembly_will_evans.webp' },
    { alt: 'A speaker stands beside a DJ controller and two studio monitors, talking to attendees seated at tables in front of tall windows looking out on a lit street', event_id: '2024_05_assembly', image_path: '/src/images/gallery/2024_05_assembly_kai_castro.webp' },
    { alt: 'Attendees at rows of white tables face a speaker seated at a laptop as a video page is projected on the wall behind', event_id: '2024_04_assembly', image_path: '/src/images/gallery/2024_04_assembly_justin_m.webp' },
    { alt: 'A speaker with headphones around the neck stands behind a laptop and studio monitors as attendees at rows of tables watch a music session projected between two flags', event_id: '2024_03_assembly', image_path: '/src/images/gallery/2024_03_assembly_den_zuko.webp' },
    { alt: 'Attendees work heads-down with pens and laptops around a U of white tables, beneath a Cisco DevNet sign on a black wall', event_id: '2024_02_assembly', image_path: '/src/images/gallery/2024_02_assembly_henyx.webp' },
    { alt: 'Producers in headphones work at laptops and MIDI keyboards around a long central table in a computer lab with green accent lighting on the walls', event_id: '2023_08_bash', image_path: '/src/images/gallery/2023_08_bash.webp' },
    { alt: 'A speaker stands between two wall screens showing the same colorful track arrangement and addresses attendees seated at rows of white tables', event_id: '2023_08_assembly', image_path: '/src/images/gallery/2023_08_assembly_lonely_child.webp' },
] as const;

const IMAGE_DENSITY = 2;
const IMAGE_PHONE_WIDTH = 1_200;
const IMAGE_SIZES = 'auto, (max-width: 768px) calc(100vw - 44px), 452px';

const events = await loadEvents();

const images = import.meta.glob<{ default: ImageMetadata }>('/src/images/gallery/*.webp', { eager: true });

const figures = await Promise.all(FIGURES.map(async (figure) => {
    const asset = images[figure.image_path];

    if (!asset) throw new Error(`Gallery asset ${figure.image_path} is missing.`);

    const event = 'event_id' in figure ? events.find(candidate => candidate.id === figure.event_id) : undefined;

    const label = 'label' in figure ? figure.label : event && formatCaption(event);

    if (!label) throw new Error(`Gallery photo ${figure.image_path} has no event.`);

    const metadata = asset.default;

    const full = await getImage({ src: metadata, width: metadata.width });

    return {
        alt: figure.alt,
        columnWidth: Math.round(metadata.width / IMAGE_DENSITY),
        image: metadata,
        label,
        ratio: metadata.width / metadata.height,
        source: full.src,
    };
}));

function formatCaption(event: (typeof events)[number]) {
    if (event.program === 'Bash') return `${event.title} ${event.program}`;

    const stamp = event.program === 'Hangout' ? event.title : formatLongMonth(event.starts_at);

    return event.speaker ? `${stamp} ${event.program} \u00b7 ${event.speaker.name}` : stamp;
}
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="gallery-title"
>
    <div>
        <PageHead
            class="max-w-3xl mb-6 text-5xl-7xl"
            headingId="gallery-title"
        >
            The wall
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            These photos come from Assembly nights, Bash afternoons, and CAMP weekends.
            Open any photo to view it full screen.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Photo wall"
>
    <ul
        class="wall__list flex flex-wrap gap-(--space-md) list-none"
        data-motion-stagger="rise"
    >
        {figures.map((figure, index) => (
            <li
                class="wall__item grow-(--figure-ratio) min-w-0"
                style={`--figure-ratio: ${figure.ratio}`}
            >
                <figure class="flex flex-col gap-3">
                    <button
                        class="slab slab--bare slab--card slab--still wall__frame block overflow-hidden w-full mb-(--lift)"
                        aria-label={`View ${figure.label}`}
                        data-wall-alt={figure.alt}
                        data-wall-label={figure.label}
                        data-wall-ratio={figure.ratio}
                        data-wall-source={figure.source}
                        data-wall-width={`${figure.image.width}px`}
                        type="button"
                    >
                        <Image
                            class="block h-auto w-full select-none"
                            alt={figure.alt}
                            draggable="false"
                            fetchpriority={index === 0 ? 'high' : undefined}
                            loading="lazy"
                            sizes={IMAGE_SIZES}
                            src={figure.image}
                            width={figure.columnWidth}
                            widths={[figure.columnWidth, IMAGE_PHONE_WIDTH, figure.image.width]}
                        />
                    </button>
                    <figcaption class="label text-text-secondary">{figure.label}</figcaption>
                </figure>
            </li>
        ))}
    </ul>
    <dialog
        class={CLASS_VIEWER}
        aria-labelledby="wall-viewer-title"
    >
        <h2
            id="wall-viewer-title"
            class="sr-only"
            data-wall-title
        >
            Gallery viewer
        </h2>
        <div
            class="wall__stack flex flex-col relative"
            tabindex="-1"
        >
            <img
                class={CLASS_VIEWER_PHOTO}
                alt=""
                data-wall-photo
                draggable="false"
            />
            <div class="flex items-baseline justify-between shrink-0 h-(--text-sm) gap-(--wall-gap)">
                <p
                    class="label"
                    aria-live="polite"
                    data-wall-caption
                />
                <button
                    class="group-open:visible sr-only transition-[translate]"
                    aria-label="Close viewer"
                    data-wall-close
                    type="button"
                />
            </div>
            <span
                class="spinner"
                aria-hidden="true"
            />
        </div>
    </dialog>
</section>

<style>
    .wall__item {
        flex-basis: calc(var(--figure-ratio) * clamp(156px, calc(129.333px + 8.3333vw), 236px) + 4px);
    }

    .wall__list::after {
        content: '';
        flex-grow: 999999;
        margin-inline-start: calc(-1 * var(--space-md));
    }

    .wall__stack {
        gap: var(--wall-gap);
        max-height: 100%;
        padding-top: var(--wall-meta);
        pointer-events: none;
        width: min(calc(var(--wall-width) + 4px), 100%, calc((100dvh - 2 * var(--shell-pad) - 2 * var(--wall-meta) - 4px) * var(--wall-ratio) + 4px));
    }

    .wall__stack .spinner {
        display: none;
        font-size: round(var(--text-4xl), 2px);
        inset: 50% auto auto 50%;
        position: absolute;
        translate: -50% -50%;
    }

    .wall__viewer {
        --color-focus-ring: var(--color-focus-ring-on-brand);
        --wall-gap: 12px;
        --wall-meta: calc(var(--wall-gap) + var(--text-sm));
        --wall-ratio: 1;
        --wall-width: 100%;
        background-color: transparent;
        color: var(--color-text-on-brand);
        opacity: 0;
        padding: var(--shell-pad);
        transition:
            opacity var(--duration-fast) var(--motion-ease-ui),
            visibility 0s var(--duration-fast);
        visibility: hidden;
    }

    .wall__viewer .spinner {
        --spinner-track: var(--color-border-on-brand);
    }

    .wall__viewer[data-loading] .spinner {
        display: inline-block;
    }

    .wall__viewer[data-pending] .wall__stack::before {
        background-color: var(--color-ink);
        border: 2px solid currentColor;
        content: '';
        inset: var(--wall-meta) 0;
        position: absolute;
    }

    .wall__viewer[open] {
        opacity: 1;
        transition: opacity var(--duration-fast) var(--motion-ease-ui);
        visibility: visible;
    }

    @media (max-width: 768px) {
        .wall__item {
            flex-basis: 100%;
        }
    }
</style>

<script>
    import { isOutsideBox, registerPageScript } from '@lib/shared/utils';

    const SPINNER_DELAY_MILLISECONDS = 300;

    let frames: HTMLButtonElement[] = [];
    let isBackdropPress = false;
    let spinnerTimer: Timer | undefined;
    let trigger: HTMLButtonElement | null = null;
    let viewer: HTMLDialogElement | null = null;
    let viewerCaption: HTMLElement | null = null;
    let viewerClose: HTMLButtonElement | null = null;
    let viewerPhoto: HTMLImageElement | null = null;
    let viewerTitle: HTMLElement | null = null;

    function clearSpinnerTimer() {
        clearTimeout(spinnerTimer);
        spinnerTimer = undefined;
    }

    function closeViewer() {
        if (!viewer?.open) return;

        document.documentElement.style.overflow = '';
        clearSpinnerTimer();
        viewer.close();
        trigger?.focus();
    }

    function handleViewerCancel(event: Event) {
        event.preventDefault();
        closeViewer();
    }

    function handleViewerClick(event: MouseEvent) {
        if (isBackdropPress && isOutsideBox(event, viewerPhoto)) closeViewer();

        isBackdropPress = false;
    }

    function handleViewerKeydown(event: KeyboardEvent) {
        if (!viewer?.open) return;

        const hasModifier = event.altKey || event.ctrlKey || event.metaKey || event.shiftKey;

        if (event.key === 'Tab') {
            event.preventDefault();
            viewerClose?.focus();
        } else if (!hasModifier && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
            const offset = event.key === 'ArrowRight' ? 1 : -1;

            const frame = trigger ? frames[frames.indexOf(trigger) + offset] : undefined;

            event.preventDefault();

            if (frame) showViewerFrame(frame);
        }
    }

    function initWall(signal: AbortSignal) {
        frames = Array.from(document.querySelectorAll<HTMLButtonElement>('.wall__frame'));
        isBackdropPress = false;
        trigger = null;
        viewer = document.querySelector<HTMLDialogElement>('.wall__viewer');
        viewerCaption = null;
        viewerClose = null;
        viewerPhoto = null;
        viewerTitle = null;
        signal.addEventListener('abort', teardown, { once: true });

        if (!frames.length || !viewer) return;

        viewerCaption = viewer.querySelector<HTMLElement>('[data-wall-caption]');
        viewerClose = viewer.querySelector<HTMLButtonElement>('[data-wall-close]');
        viewerPhoto = viewer.querySelector<HTMLImageElement>('[data-wall-photo]');
        viewerTitle = viewer.querySelector<HTMLElement>('[data-wall-title]');

        if (!viewerCaption || !viewerClose || !viewerPhoto || !viewerTitle) return;

        document.addEventListener('keydown', handleViewerKeydown, { signal });

        frames.forEach((frame) => {
            frame.addEventListener('click', () => openViewer(frame), { signal });
        });

        viewer.addEventListener('cancel', handleViewerCancel, { signal });
        viewer.addEventListener('click', handleViewerClick, { signal });

        viewer.addEventListener('pointerdown', (event) => {
            isBackdropPress = isOutsideBox(event, viewerPhoto);
        }, { signal });

        viewerClose.addEventListener('click', closeViewer, { signal });
        viewerPhoto.addEventListener('error', showViewerPhoto, { signal });
        viewerPhoto.addEventListener('load', showViewerPhoto, { signal });
    }

    function openViewer(frame: HTMLButtonElement) {
        if (!viewer || !viewerClose) return;

        document.documentElement.style.overflow = 'hidden';
        showViewerFrame(frame);
        viewer.removeAttribute('data-loading');
        viewer.showModal();
        viewerClose.focus();
    }

    function showViewerFrame(frame: HTMLButtonElement) {
        if (!viewer || !viewerCaption || !viewerPhoto || !viewerTitle) return;

        const isBroken = viewerPhoto.complete && !viewerPhoto.naturalWidth;
        const { wallAlt = '', wallLabel = '', wallRatio = '1', wallSource = '', wallWidth = '100%' } = frame.dataset;

        if (isBroken || viewerPhoto.getAttribute('src') !== wallSource) viewerPhoto.src = wallSource;

        trigger = frame;
        viewer.style.setProperty('--wall-ratio', wallRatio);
        viewer.style.setProperty('--wall-width', wallWidth);
        viewerCaption.textContent = wallLabel;
        viewerPhoto.alt = wallAlt;
        viewerTitle.textContent = wallLabel;

        if (viewerPhoto.complete) {
            showViewerPhoto();
        } else {
            spinnerTimer ??= setTimeout(() => viewer?.setAttribute('data-loading', ''), SPINNER_DELAY_MILLISECONDS);
            viewer.setAttribute('data-pending', '');
        }
    }

    function showViewerPhoto() {
        if (!viewerPhoto?.complete) return;

        clearSpinnerTimer();
        viewer?.removeAttribute('data-loading');
        viewer?.removeAttribute('data-pending');
    }

    function teardown() {
        document.documentElement.style.overflow = '';
        clearSpinnerTimer();
        viewer?.close();
    }

    registerPageScript(initWall);
</script>
