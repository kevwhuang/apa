---
import { getCollection } from 'astro:content';

import PlaceholderTile from '@components/PlaceholderTile.astro';
import SectionHead from '@components/SectionHead.astro';
import { PALETTE } from '@lib/utils';

const producers = (await getCollection('producers')).slice(0, 8);
---

<section
    class="py-24 border-b-2 border-ink bg-cream"
    aria-labelledby="producers-title"
>
    <div class="shell">
        <SectionHead
            class="max-w-2xl font-extrabold font-sans text-5xl tracking-tight"
            eyebrow="Producers"
            headingId="producers-title"
        >
            142 producers. One scene.
            <a
                class="action-text hover:text-coral-dark hidden items-center gap-2 transition-colors md:inline-flex"
                href="/producers"
                slot="cta"
            >
                Full roster &rarr;
            </a>
        </SectionHead>
        <ul class="reveal--stagger grid grid-cols-2 gap-4 list-none md:grid-cols-4">
            {producers.map((producer, index) => (
                <li>
                    <a
                        class="block"
                        href={`/producers#${producer.id}`}
                    >
                        <PlaceholderTile
                            class="card-hover aspect-square mb-3 border-2 border-ink shadow-card-sm"
                            color={PALETTE[index % PALETTE.length]}
                            label={producer.data.name.split(' ').map(word => word[0]).join('')}
                            labelClass="leading-none text-[60px] text-white/80 [text-shadow:2px_2px_0_var(--color-black-20)] md:text-[72px]"
                        >
                            <div class="label absolute bottom-0 inset-x-0 p-3 bg-linear-to-t from-black-70 text-white to-transparent">
                                {producer.data.handle}
                            </div>
                        </PlaceholderTile>
                        <h3 class="font-bold font-sans tracking-tight">{producer.data.name}</h3>
                        <p class="font-mono text-[11px] uppercase text-taupe">{producer.data.genres.slice(0, 2).join(' / ')}</p>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
