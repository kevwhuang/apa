---
import { getCollection } from 'astro:content';
const producers = (await getCollection('producers')).slice(0, 8);
const colors = ['#FF4D3A', '#2D2B85', '#1A1A1A', '#D4A843', '#FF4D3A', '#6B68D9', '#2D2B85', '#CC3E2E'];
---
<section class="py-24 border-b-2 border-ink bg-surface">
    <div class="max-w-[1400px] mx-auto px-6">
        <div class="flex items-end justify-between mb-12 gap-6 reveal">
            <div>
                <p class="label mb-3 text-coral">PRODUCERS</p>
                <h2 class="font-display text-5xl tracking-tight font-extrabold max-w-2xl">
                    142 producers. One scene.
                </h2>
            </div>
            <a href="/producers" class="hidden md:inline-flex items-center gap-2 font-mono text-[12px] font-bold uppercase tracking-wide hover:text-coral transition-colors">
                Full roster &rarr;
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 reveal-stagger">
            {producers.map((p, i) => (
                <a href={`/producers#${p.id}`} class="group block">
                    <div
                        class="aspect-square relative overflow-hidden border-2 border-ink card-hover"
                        style={`background: ${colors[i % colors.length]}; box-shadow: var(--shadow-card-sm);`}
                    >
                        <div class="absolute inset-0 halftone"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="font-display font-extrabold text-[60px] md:text-[72px] leading-none text-white/90 mix-blend-overlay select-none" style="text-shadow: 2px 2px 0 rgba(0,0,0,0.2);">
                                {p.data.name.split(' ').map(w => w[0]).join('')}
                            </span>
                        </div>
                        <div class="absolute bottom-0 inset-x-0 p-3 label text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                            {p.data.handle}
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="font-display font-bold tracking-tight">{p.data.name}</p>
                        <p class="text-[11px] font-mono text-ink-soft uppercase">{p.data.genres.slice(0, 2).join(' / ')}</p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
