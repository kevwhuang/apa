---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import ProducerLinks from '@components/producer/Links.astro';
import ProducerTrack from '@components/producer/Track.astro';
import SearchField from '@components/shared/SearchField.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { JOIN_ROUTE, LINKS, PALETTE } from '@lib/shared/constants';
import { formatCalendarMonth, getInitials, toIsoDate } from '@lib/shared/utils';

const producers = await getCollection('producers');

const allGenres = Array.from(new Set(producers.flatMap(producer => producer.data.genres))).sort((a, b) => a.localeCompare(b));
const allRoles = Array.from(new Set(producers.flatMap(producer => producer.data.roles))).sort((a, b) => a.localeCompare(b));

const roster = [...producers]
    .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name))
    .map(producer => ({
        ...producer,
        search: [producer.data.name, ...producer.data.genres, ...producer.data.roles, producer.data.location, producer.data.bio].join(' ').toLowerCase(),
    }));
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="directory-title"
>
    <div>
        <PageHead
            class="max-w-3xl mb-6 font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-8xl"
            eyebrow="Directory / Roster"
            headingId="directory-title"
        >
            The directory.
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lmd text-ink-muted"
            data-motion="blur"
        >
            Every member card carries what they make, what they do, where they are based, and
            where else to find them &mdash; plus a spotlight track where there is one. Filter by
            role or genre, or press play and just listen.
        </p>
        <SearchField
            class="mb-4"
            data-motion="rise"
            label="Search the directory"
            placeholder={'Search members\u2026'}
        />
        <div
            class="flex flex-col gap-5 mb-6"
            data-motion="rise"
        >
            <div>
                <p class="label mb-3 text-ink-muted">Role</p>
                <div
                    class="flex flex-wrap gap-2"
                    aria-label="Filter by role"
                    role="group"
                >
                    <button
                        class="chip is-active role-btn active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                        aria-pressed="true"
                        data-role=""
                        type="button"
                    >
                        All
                    </button>
                    {allRoles.map(role => (
                        <button
                            class="chip role-btn active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                            aria-pressed="false"
                            data-role={role}
                            type="button"
                        >
                            {role}
                        </button>
                    ))}
                </div>
            </div>
            <div>
                <p class="label mb-3 text-ink-muted">Genre</p>
                <div
                    class="flex flex-wrap gap-2"
                    aria-label="Filter by genre"
                    role="group"
                >
                    <button
                        class="chip genre-btn is-active active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                        aria-pressed="true"
                        data-genre=""
                        type="button"
                    >
                        All
                    </button>
                    {allGenres.map(genre => (
                        <button
                            class="chip genre-btn active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse"
                            aria-pressed="false"
                            data-genre={genre}
                            type="button"
                        >
                            {genre}
                        </button>
                    ))}
                </div>
            </div>
        </div>
        <p
            class="label text-ink-subtle"
            aria-live="polite"
            data-directory-status
            data-motion="stamp"
        >
            Showing all {roster.length} members.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-label="Directory"
>
    <ul
        class="roster__grid list-none"
        data-motion-stagger="flip"
    >
        {roster.map((producer, index) => (
            <li
                id={producer.id}
                class="producer-card"
                data-genres={producer.data.genres.join(',')}
                data-role={producer.data.roles[0]}
                data-search={producer.search}
            >
                <article class="producer-card__frame slab slab--bare slab--card">
                    <PlaceholderTile
                        class="aspect-[5/3] border-b-2 border-ink"
                        color={PALETTE[(index + 1) % PALETTE.length]}
                        label={getInitials(producer.data.name)}
                        labelClass="leading-none text-[80px] text-surface-raised/80 [text-shadow:2px_2px_0_var(--color-ink-20)]"
                    >
                        {producer.data.featured && (
                            <p class="label absolute left-0 top-0 px-2 py-2 border-b-2 border-r-2 border-ink bg-surface text-ink">Spotlight</p>
                        )}
                    </PlaceholderTile>
                    <div class="producer-card__body p-(--space-md)">
                        <h2
                            class="row-start-1 mb-2 font-extrabold font-sans text-xl tracking-tight"
                            data-placeholder
                        >
                            {producer.data.name}
                        </h2>
                        <p
                            class="row-start-2 mb-3 font-mono text-2xs uppercase text-ink-muted"
                            data-placeholder
                        >
                            {producer.data.roles.length > 0
                                ? `${producer.data.roles.join(' \u00b7 ')} \u2014 ${producer.data.location}`
                                : producer.data.location}
                        </p>
                        {producer.data.bio.length > 0 && (
                            <p
                                class="producer-card__bio scroll-slot row-start-3 mb-4 leading-relaxed text-sm text-ink-muted"
                                data-placeholder
                            >
                                {producer.data.bio}
                            </p>
                        )}
                        <ul class="flex flex-wrap row-start-4 gap-2 mb-5 list-none">
                            {producer.data.genres.map(genre => (
                                <li class="inline-flex items-center h-6 px-2 border-2 border-ink font-bold font-mono text-2xs tracking-wide uppercase">{genre}</li>
                            ))}
                        </ul>
                        {producer.data.tracks[0] && (
                            <ProducerTrack
                                class="row-start-5 mb-4"
                                producerId={producer.id}
                                track={producer.data.tracks[0]}
                            />
                        )}
                        <div class="flex flex-wrap items-center justify-between row-start-6 gap-x-4 gap-y-2 pt-4 border-t-2 border-ink">
                            <p
                                class="font-mono text-2xs uppercase text-ink-muted"
                                data-placeholder
                            >
                                Since <time datetime={toIsoDate(producer.data.joined)}>{formatCalendarMonth(producer.data.joined)}</time>
                            </p>
                            <ProducerLinks
                                linkClass="hover:text-accent-deep"
                                links={producer.data.links}
                            />
                        </div>
                    </div>
                </article>
            </li>
        ))}
    </ul>
    <div
        class="slab slab--sunk flex flex-col items-start max-w-(--measure-form) w-full gap-4 mx-auto"
        data-directory-empty
        hidden
    >
        <p class="font-extrabold font-sans text-xl tracking-tight">No matches.</p>
        <p class="text-sm text-ink-muted">
            Nobody in the directory answers to &ldquo;<span class="font-mono wrap-anywhere" data-search-echo />&rdquo;.
        </p>
        <button
            class="btn"
            data-search-clear
            type="button"
        >
            Clear search
        </button>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="roster-join-title"
>
    <div
        class="mark slab slab--roomy slab--sunk grid grid-cols-1 items-end gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
        data-motion="unfold"
    >
        <div>
            <SectionHead
                class="font-extrabold font-sans leading-[1.05] text-3xl tracking-[-0.035em] md:text-5xl"
                eyebrow="Producers / Join"
                headingId="roster-join-title"
            >
                Want on this list?
            </SectionHead>
            <p class="max-w-md text-ink-muted">
                Two ways in. Pick Membership on the contact form and tell us what you make, or open
                the Discord and say hello in the room where the day-to-day happens.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a
                class="btn btn--primary"
                href={JOIN_ROUTE}
            >
                Ask about membership
            </a>
            <a
                class="btn"
                href={LINKS.discord}
                rel="noopener noreferrer"
                target="_blank"
            >
                Open the Discord
                <span class="sr-only"> (opens in a new tab)</span>
            </a>
        </div>
    </div>
</section>

<style>
    .producer-card:not(.hidden) {
        align-content: start;
        display: grid;
        grid-row: span 8;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .producer-card::after {
        content: '';
        display: block;
        grid-row: 8;
        height: var(--space-lg);
    }

    .producer-card__bio {
        --scroll-slot-max: calc(4 * 1.625 * var(--text-sm));
    }

    .producer-card__body {
        align-content: start;
        display: grid;
        grid-row: 2 / span 6;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .producer-card__frame {
        align-content: start;
        display: grid;
        grid-row: 1 / span 7;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .roster__grid {
        column-gap: var(--space-lg);
        display: grid;
        grid-auto-rows: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        row-gap: 0;
    }

    .roster__grid > * {
        min-width: 0;
    }

    @media (max-width: 1024px) {
        .roster__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .roster__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { initSearchField, registerPageScript, rovingFocus, setHidden, setText } from '@lib/shared/utils';
    import { initTracks } from '@lib/audio/tracks';

    let activeGenre = '';
    let activeRole = '';

    function describeMembers(shown: number, total: number, query: string) {
        if (query) return `Showing ${shown} of ${total} members for \u201c${query}\u201d.`;

        return activeGenre || activeRole ? `Showing ${shown} of ${total} members.` : `Showing all ${total} members.`;
    }

    function initDirectoryGrid(signal: AbortSignal) {
        const cards = document.querySelectorAll<HTMLElement>('.producer-card');
        const genreButtons = document.querySelectorAll<HTMLButtonElement>('.genre-btn');
        const roleButtons = document.querySelectorAll<HTMLButtonElement>('.role-btn');

        if (!cards.length || !genreButtons.length || !roleButtons.length) return;

        const emptyElement = document.querySelector<HTMLElement>('[data-directory-empty]');
        const searchElement = document.querySelector<HTMLInputElement>('[data-search-input]');
        const statusElement = document.querySelector<HTMLElement>('[data-directory-status]');

        activeGenre = '';
        activeRole = '';

        function apply() {
            const query = (searchElement?.value ?? '').trim();

            const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);

            let shown = 0;

            paintButtons(genreButtons, 'genre', activeGenre);
            paintButtons(roleButtons, 'role', activeRole);

            cards.forEach((card) => {
                const haystack = card.dataset.search ?? '';

                const matchesGenre = !activeGenre || (card.dataset.genres ?? '').split(',').includes(activeGenre);
                const matchesRole = !activeRole || card.dataset.role === activeRole;

                const on = matchesGenre && matchesRole && tokens.every(token => haystack.includes(token));

                if (on) shown += 1;

                card.classList.toggle('hidden', !on);
            });

            if (emptyElement) {
                setText(emptyElement.querySelector('[data-search-echo]'), query);
                setHidden(emptyElement, shown > 0);
            }

            if (statusElement) statusElement.textContent = describeMembers(shown, cards.length, query);
        }

        function handleGenreClick(button: HTMLButtonElement) {
            activeGenre = button.dataset.genre ?? '';
            apply();
        }

        function handleRoleClick(button: HTMLButtonElement) {
            activeRole = button.dataset.role ?? '';
            apply();
        }

        apply();
        rovingFocus(genreButtons, signal);
        rovingFocus(roleButtons, signal);

        genreButtons.forEach((button) => {
            button.addEventListener('click', () => handleGenreClick(button), { signal });
        });

        roleButtons.forEach((button) => {
            button.addEventListener('click', () => handleRoleClick(button), { signal });
        });

        searchElement?.addEventListener('input', apply, { signal });

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement,
            signal,
        });
    }

    function paintButtons(buttons: NodeListOf<HTMLButtonElement>, key: string, active: string) {
        buttons.forEach((button) => {
            const on = (button.dataset[key] ?? '') === active;

            button.classList.toggle('is-active', on);
            button.setAttribute('aria-pressed', String(on));
        });
    }

    initTracks();
    registerPageScript(initDirectoryGrid);
</script>
