---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import ProducerLinks from '@components/producer/Links.astro';
import ProducerPortrait from '@components/producer/Portrait.astro';
import ProducerTrack from '@components/producer/Track.astro';
import SearchField from '@components/shared/SearchField.astro';
import { PALETTE } from '@lib/shared/constants';
import { formatCalendarMonth, formatRole, toIsoDate, toRoster } from '@lib/shared/utils';

import type { CollectionEntry } from 'astro:content';

const ROLE_COLORS: Record<CollectionEntry<'producers'>['data']['roles'][number], string> = {
    artist: 'var(--color-chart-3)',
    engineer: 'var(--color-marker-cobalt)',
    fan: 'var(--color-text-secondary)',
    producer: 'var(--color-signal)',
};

const producers = toRoster(await getCollection('producers'));

const allGenres = Array.from(new Set(producers.flatMap(producer => producer.data.genres))).sort((a, b) => a.localeCompare(b));
const allRoles = Array.from(new Set(producers.flatMap(producer => producer.data.roles))).sort((a, b) => a.localeCompare(b));

const roster = [...producers]
    .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name))
    .map(producer => ({
        ...producer,
        search: [
            producer.data.name,
            ...producer.data.genres,
            ...producer.data.roles,
            producer.data.location,
            producer.data.bio,
        ].join(' ').toLowerCase(),
    }));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="directory-title"
>
    <div>
        <PageHead
            class="max-w-4xl mb-6 text-7xl max-md:text-4xl"
            headingId="directory-title"
        >
            Meet the Alliance
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            Each member card shows what they make, what they do, where they are based, and
            where else to find them, plus a spotlight track where there is one. Filter by role
            or genre, or press play and listen.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Directory"
>
    <div>
        <SearchField
            class="mb-4"
            data-motion="rise"
            label="Search the directory"
            placeholder={'Search members\u2026'}
        />
        <div
            class="flex flex-col gap-4 mb-6"
            data-motion="rise"
        >
            <div>
                <p class="label mb-3 text-text-secondary">Role</p>
                <div
                    class="flex flex-wrap gap-3"
                    aria-label="Filter by role"
                    role="group"
                >
                    <button
                        class="chip is-active role-btn hover:bg-bg-hover"
                        aria-pressed="true"
                        data-role=""
                        type="button"
                    >
                        All
                    </button>
                    {allRoles.map(role => (
                        <button
                            class="chip role-btn hover:bg-bg-hover gap-(--space-3xs)"
                            aria-pressed="false"
                            data-role={role}
                            style={`--role-color: ${ROLE_COLORS[role]}`}
                            type="button"
                        >
                            <span
                                class="roster__swatch flex-none size-2 bg-(--role-color)"
                                aria-hidden="true"
                            />
                            {formatRole(role)}
                        </button>
                    ))}
                </div>
            </div>
            <div>
                <p class="label mb-3 text-text-secondary">Genre</p>
                <div
                    class="flex flex-wrap gap-3"
                    aria-label="Filter by genre"
                    role="group"
                >
                    <button
                        class="chip genre-btn is-active hover:bg-bg-hover"
                        aria-pressed="true"
                        data-genre=""
                        type="button"
                    >
                        All
                    </button>
                    {allGenres.map(genre => (
                        <button
                            class="chip genre-btn hover:bg-bg-hover"
                            aria-pressed="false"
                            data-genre={genre}
                            type="button"
                        >
                            {genre}
                        </button>
                    ))}
                </div>
            </div>
        </div>
        <p
            class="label mb-10 text-text-secondary"
            aria-live="polite"
            data-directory-status
            data-motion="stamp"
        >
            Showing all {roster.length} members
        </p>
        <ul
            class="roster__grid grid grid-cols-3 gap-x-(--space-lg) list-none max-lg:grid-cols-2 max-md:grid-cols-1"
            data-motion-stagger="flip"
        >
            {roster.map((producer, index) => (
                <li
                    id={producer.data.producerId}
                    class="producer-card mb-(--space-2xl)"
                    data-genres={producer.data.genres.join(',')}
                    data-role={producer.data.roles[0]}
                    data-search={producer.search}
                    style={`--role-color: ${ROLE_COLORS[producer.data.roles[0]]}`}
                >
                    <article class="producer-card__frame slab slab--bare slab--card slab--still">
                        <ProducerPortrait
                            class="aspect-square"
                            color={PALETTE[(index + 1) % PALETTE.length].background}
                            labelClass="leading-none text-6xl"
                            labelColor={PALETTE[(index + 1) % PALETTE.length].text}
                            name={producer.data.name}
                            producerId={producer.data.producerId}
                        >
                            {producer.data.featured && (
                                <p class="label absolute left-0 top-0 p-(--space-xs) border-b-2 border-border-strong border-r-2 bg-bg-page text-text">Spotlight</p>
                            )}
                        </ProducerPortrait>
                        <div class="producer-card__body grid grid-cols-[minmax(0,1fr)] grid-rows-subgrid row-span-6 p-(--space-md)">
                            <h2
                                class="mb-3 text-2xl text-balance"
                                data-placeholder
                            >
                                {producer.data.name}
                            </h2>
                            <div class="flex flex-wrap items-center justify-between self-start gap-(--space-xs) mb-6">
                                <p class="label inline-flex items-center gap-(--space-3xs) px-(--space-2xs) py-(--space-3xs) border-(--role-color) border-2 text-text">
                                    <span
                                        class="flex-none size-2 bg-(--role-color)"
                                        aria-hidden="true"
                                    />
                                    {formatRole(producer.data.roles[0])}
                                </p>
                                <p
                                    class="font-mono text-base wrap-anywhere text-text-secondary"
                                    data-placeholder
                                >
                                    {producer.data.location}
                                </p>
                            </div>
                            <p
                                class="producer-card__bio scroll-slot empty:mb-0 self-start mb-6 text-base text-text-secondary"
                                data-placeholder
                            >
                                {producer.data.bio}
                            </p>
                            <ul class="empty:mb-0 flex flex-wrap self-end gap-2 mb-6 list-none">
                                {producer.data.genres.map(genre => (
                                    <li class="label inline-flex items-center h-6 px-2 border-2 border-border-strong">{genre}</li>
                                ))}
                            </ul>
                            {producer.data.tracks[0]
                                ? (
                                        <ProducerTrack
                                            class="mb-3"
                                            hasWave={false}
                                            producerId={producer.data.producerId}
                                            track={producer.data.tracks[0]}
                                        />
                                    )
                                : (
                                        <div
                                            class="min-h-(--control-size) mb-3 border-2 border-border-subtle border-dashed"
                                            aria-hidden="true"
                                        />
                                    )}
                            <div class="flex flex-wrap items-center justify-between self-start min-h-(--control-size) gap-x-(--space-sm) gap-y-(--space-xs)">
                                <p
                                    class="font-mono text-base whitespace-nowrap text-text-secondary"
                                    data-placeholder
                                >
                                    <span class="sr-only">Member since </span><time datetime={toIsoDate(producer.data.joined)}>{formatCalendarMonth(producer.data.joined)}</time>
                                </p>
                                <ProducerLinks
                                    linkClass="hover:text-link"
                                    links={producer.data.links}
                                />
                            </div>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
        <div
            class="slab slab--empty slab--sunk max-w-(--measure-form) w-full mx-auto"
            data-directory-empty
            hidden
        >
            <div class="flex flex-col gap-(--space-2xs)">
                <p class="font-bold font-sans text-2xl text-balance tracking-tight">No matches.</p>
                <p
                    class="text-base text-text-secondary"
                    data-empty-query
                >
                    No one in the directory matches
                    &ldquo;<span class="font-mono wrap-anywhere" data-search-echo />&rdquo;.
                </p>
                <p
                    class="text-base text-text-secondary"
                    data-empty-filters
                    hidden
                >
                    No one in the directory matches these filters.
                </p>
            </div>
            <button
                class="btn"
                data-search-clear
                type="button"
            >
                Clear search
            </button>
        </div>
    </div>
</section>

<style>
    .producer-card:not(.hidden),
    .producer-card__frame {
        display: grid;
        grid-row: span 7;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .producer-card__bio {
        --scroll-slot-max: 12lh;
    }

    .roster__grid > * {
        min-width: 0;
    }

    .roster__grid:has(> :not(.hidden)) {
        margin-bottom: calc(-1 * var(--space-2xl));
    }

    .roster__swatch {
        outline: 1px solid var(--color-bg-page);
    }
</style>

<script>
    import { initFilterGroup, initSearchField, registerPageScript } from '@lib/shared/utils';
    import { initTracks } from '@lib/audio/tracks';

    function describeMembers(shown: number, total: number, isFiltered: boolean, query: string) {
        if (query) return `Showing ${shown} of ${total} members for \u201c${query}\u201d`;

        return isFiltered ? `Showing ${shown} of ${total} members` : `Showing all ${total} members`;
    }

    function initDirectoryGrid(signal: AbortSignal) {
        const cards = document.querySelectorAll<HTMLElement>('.producer-card');
        const genreButtons = document.querySelectorAll<HTMLButtonElement>('.genre-btn');
        const roleButtons = document.querySelectorAll<HTMLButtonElement>('.role-btn');

        if (!cards.length || !genreButtons.length || !roleButtons.length) return;

        const searchElement = document.querySelector<HTMLInputElement>('[data-search-input]');

        initFilterGroup({
            cards,
            emptyElement: document.querySelector<HTMLElement>('[data-directory-empty]'),
            filters: [
                {
                    buttons: genreButtons,
                    dataKey: 'genre',
                    matches: (card, active) => (card.dataset.genres ?? '').split(',').some(genre => active.has(genre)),
                },
                {
                    buttons: roleButtons,
                    dataKey: 'role',
                    matches: (card, active) => active.has(card.dataset.role ?? ''),
                },
            ],
            searchElement,
            signal,
            status: describeMembers,
            statusElement: document.querySelector<HTMLElement>('[data-directory-status]'),
        });

        initSearchField({
            clearElements: document.querySelectorAll<HTMLButtonElement>('[data-search-clear]'),
            searchElement,
            signal,
        });
    }

    initTracks();
    registerPageScript(initDirectoryGrid);
</script>
