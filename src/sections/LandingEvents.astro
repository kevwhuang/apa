---
import { getCollection } from 'astro:content';
import { formatDateShort, formatTime } from '@lib/utils';

const all = await getCollection('events');
const upcoming = all
    .filter(e => e.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date)
    .slice(0, 4);
---

<section
    class="py-24 border-b-2 border-ink"
    aria-label="Upcoming events"
>
    <div class="max-w-[1400px] mx-auto px-6">
        <div class="flex items-end justify-between mb-12 gap-6 reveal">
            <div>
                <p class="label mb-3 text-coral">EVENTS</p>
                <h2 class="font-sans text-5xl tracking-tight font-extrabold">What's coming up</h2>
            </div>
            <a class="hidden md:inline-flex items-center gap-2 btn-text hover:text-coral transition-colors" href="/events">
                All events &rarr;
            </a>
        </div>

        <ul class="border-2 border-ink crop-marks reveal" style="transition-delay: 0.15s;">
            {upcoming.map((e, i) => (
                <li class={i > 0 ? 'border-t-2 border-ink' : ''}>
                    <a class="grid grid-cols-12 items-center gap-6 py-6 px-5 transition-colors hover:bg-surface group" href={`/events#${e.id}`}>
                        <div class="col-span-3 md:col-span-2">
                            <div class="text-[24px] font-sans font-extrabold">{formatDateShort(e.data.date)}</div>
                            <div class="font-mono text-[11px] text-ink-soft uppercase">{formatTime(e.data.date)}</div>
                        </div>
                        <div class="col-span-9 md:col-span-7">
                            <span class="label inline-block px-2 py-0.5 bg-coral text-coral-ink mb-1.5">{e.data.type}</span>
                            <h3 class="font-sans font-extrabold text-[22px] tracking-tight">{e.data.title}</h3>
                            <p class="text-[13px] mt-1 text-ink-soft font-mono">{e.data.location}</p>
                        </div>
                        <div class="hidden md:flex col-span-3 justify-end font-mono text-[11px] items-center gap-2 text-ink-soft group-hover:text-coral transition-colors uppercase">
                            <span>RSVP</span>
                            <span>&rarr;</span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
