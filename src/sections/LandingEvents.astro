---
import { getCollection } from 'astro:content';

import SectionHead from '@components/SectionHead.astro';
import { formatTime } from '@lib/utils';

const all = await getCollection('events');

const past = all
    .filter(event => event.data.status === 'past')
    .sort((a, b) => +b.data.date - +a.data.date)
    .slice(0, 4);

const upcoming = all
    .filter(event => event.data.status === 'upcoming')
    .sort((a, b) => +a.data.date - +b.data.date)
    .slice(0, 4);

const events = upcoming.length ? upcoming : past;
const heading = upcoming.length ? 'What\'s coming up' : 'Recent events';

function formatDateShort(date: Date): string {
    return date.toLocaleDateString('en-US', { day: 'numeric', month: 'short' });
}
---

<section
    class="py-24 border-b-2 border-ink"
    aria-labelledby="upcoming-title"
>
    <div class="shell">
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow="Events"
            headingId="upcoming-title"
        >
            {heading}
            <a
                class="action-text hover:text-coral-dark hidden items-center gap-2 transition-colors md:inline-flex"
                href="/events"
                slot="cta"
            >
                All events &rarr;
            </a>
        </SectionHead>
        <ul class="crop-marks events__list reveal border-2 border-ink list-none">
            {events.map((event, index) => (
                <li class:list={[index > 0 && 'border-t-2 border-ink']}>
                    <a
                        class="group hover:bg-cream grid grid-cols-12 items-center gap-6 px-5 py-6 transition-colors"
                        href={`/events#${event.id}`}
                    >
                        <div class="col-span-3 md:col-span-2">
                            <p class="font-extrabold font-sans text-[24px]">
                                <time datetime={event.data.date.toISOString()}>{formatDateShort(event.data.date)}</time>
                            </p>
                            <p class="font-mono text-[11px] uppercase text-taupe">
                                <time datetime={event.data.date.toISOString()}>{formatTime(event.data.date)}</time>
                            </p>
                        </div>
                        <div class="col-span-9 md:col-span-7">
                            <span class="label inline-block mb-1.5 px-2 py-0.5 bg-coral text-ink">{event.data.type}</span>
                            <h3 class="font-extrabold font-sans text-[22px] tracking-tight">{event.data.title}</h3>
                            <address class="mt-1 font-mono not-italic text-[13px] text-taupe">{event.data.location}</address>
                        </div>
                        <div class="group-hover:text-coral-dark col-span-3 hidden items-center justify-end gap-2 font-mono text-[11px] uppercase text-taupe transition-colors md:flex">
                            <span>{upcoming.length ? 'RSVP' : 'Details'}</span>
                            <span>&rarr;</span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .events__list {
        transition-delay: 0.15s;
    }
</style>
