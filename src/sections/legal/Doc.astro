---
import { LINKS, SESSION_TTL_DAYS, SITE_UPDATED, STORAGE } from '@lib/shared/constants';
import { formatDateStamp } from '@lib/shared/utils';

type Inline =
    | { attributes: Record<string, string>; kind: 'link'; label: string }
    | { code: string; kind: 'code' }
    | { kind: 'text'; text: string };

interface Props {
    kind: 'privacy' | 'terms';
}

const ATTRIBUTE_PATTERN = /([a-z]+)="([^"]*)"/g;
const INLINE_PATTERN = /<a ([^>]+)>(.*?)<\/a>|<code>(.*?)<\/code>/g;

const SECTIONS: Record<Props['kind'], { body: string[]; heading: string }[]> = {
    privacy: [
        {
            body: [
                'Nothing, on our side. This site has no database, and the only code it runs on a server serves a read-only content <a href="/api">API</a> and its error page. Every interactive surface is a demonstration that runs entirely in your browser: the contact and newsletter forms, the event check-in, the sign-in, onboarding, and settings, the store checkout, the member chat, the demo and Bash uploaders, the rack, the admin console, and the AI assistant. Submitting them sends nothing anywhere. The <a href="/terms">terms of service</a> describe how the demonstrations behave; this page covers the little they keep, all of it on your device.',
                'The specifics people reasonably worry about. The contact form composes a message in your own mail app through a mailto link, and nothing is sent unless you press send there. Files handed to an uploader or the rack are read locally to draw waveforms and meters, then go nowhere; the one picture that stays is a portrait you choose for your profile, which is kept in your browser\'s own storage and listed below. Passwords are checked while the page is open and then dropped, never stored. Checkout checks only that the card details are the right shape and unexpired, charges nothing, and never keeps them; the receipt it saves holds the order number, the line items, the totals, a timestamp, and the email you entered. The AI assistant matches keywords against canned answers written into the page and makes no requests.',
            ],
            heading: 'What we collect',
        },
        {
            body: [
                'A few features remember things between pages or visits, using your browser\'s built-in storage: twelve keys in all, every one of them in localStorage on your device and none transmitted to us or anyone else.',
