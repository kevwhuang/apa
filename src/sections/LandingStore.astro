---
import { getCollection } from 'astro:content';

import PlaceholderTile from '@components/PlaceholderTile.astro';
import SectionHead from '@components/SectionHead.astro';
import { formatPrice, PALETTE } from '@lib/utils';

const bgColors = PALETTE.slice(0, 4);
const products = (await getCollection('products')).slice(0, 4);
---

<section
    class="py-24 border-b-2 border-ink bg-cream"
    aria-labelledby="landing-store-title"
>
    <div class="shell">
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow="Store"
            headingId="landing-store-title"
        >
            Wear the alliance.
            <a
                class="action-text hover:text-coral-dark hidden items-center gap-2 transition-colors md:inline-flex"
                href="/store"
                slot="cta"
            >
                Browse all &rarr;
            </a>
        </SectionHead>
        <ul class="reveal--stagger grid grid-cols-2 gap-4 list-none md:grid-cols-4">
            {products.map((product, index) => (
                <li>
                    <a
                        class="block"
                        href={`/store/${product.id}`}
                    >
                        <PlaceholderTile
                            class="card-hover aspect-square mb-3 border-2 border-ink shadow-card-sm"
                            color={bgColors[index % bgColors.length]}
                            label={product.data.title.split(' ')[0]}
                            labelClass="text-4xl tracking-tight uppercase text-white/80"
                        />
                        <div class="flex items-baseline justify-between">
                            <h3 class="font-bold font-sans tracking-tight">
                                {product.data.title}
                            </h3>
                            <p class="font-mono text-[12px]">
                                {formatPrice(product.data.priceCents)}
                            </p>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
