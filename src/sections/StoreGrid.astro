---
import { getCollection } from 'astro:content';

import PageHead from '@components/PageHead.astro';
import PlaceholderTile from '@components/PlaceholderTile.astro';
import { formatPrice, PALETTE } from '@lib/utils';

const CATEGORIES = ['all', 'accessory', 'apparel', 'music'] as const;

const cardColors = PALETTE.slice(0, 6);
const products = await getCollection('products');
---

<section
    class="pb-12 pt-20 border-b-2 border-ink"
    aria-labelledby="store-title"
>
    <div class="shell">
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow={`Store / ${products.length} items`}
            headingId="store-title"
        >
            Wear the alliance.
        </PageHead>
        <div
            class="flex flex-wrap gap-2 mt-10"
            aria-label="Filter by category"
            role="group"
        >
            {CATEGORIES.map((category, index) => (
                <button
                    class:list={[
                        'chip category-btn active:bg-ink active:text-sand hover:bg-ink hover:text-sand',
                        { 'is-active': index === 0 },
                    ]}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-category={category}
                    type="button"
                >
                    {category}
                </button>
            ))}
        </div>
    </div>
</section>

<section
    class="py-16"
    aria-labelledby="products-title"
>
    <h2
        id="products-title"
        class="sr-only"
    >
        Products
    </h2>
    <ul class="reveal--stagger shell grid grid-cols-2 gap-x-5 gap-y-10 list-none lg:grid-cols-4 md:grid-cols-3">
        {products.map((product, index) => (
            <li
                class="product-card"
                data-category={product.data.category}
            >
                <a
                    class="block"
                    href={`/store/${product.id}`}
                >
                    <PlaceholderTile
                        class="card-hover aspect-square border-2 border-ink shadow-card-sm"
                        color={cardColors[index % cardColors.length]}
                        label={product.data.title.split(' ')[0]}
                        labelClass="text-4xl tracking-tight uppercase text-white/80"
                    />
                    <div class="mt-4">
                        <p class="label text-taupe">
                            {product.data.category}
                        </p>
                        <div class="flex items-baseline justify-between gap-3 mt-1">
                            <h3 class="font-bold font-sans tracking-tight">
                                {product.data.title}
                            </h3>
                            <p class="font-bold font-mono text-[13px]">
                                {formatPrice(product.data.priceCents)}
                            </p>
                        </div>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</section>

<script>
    import { applyFilter, rovingFocus } from '@lib/utils';

    let activeCategory = 'all';
    let storeGridController: AbortController | undefined;

    function handleCategoryClick(button: HTMLButtonElement, buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        activeCategory = button.dataset.category ?? 'all';
        updateCategoryFilter(buttons, cards);
    }

    function initStoreGrid() {
        storeGridController?.abort();
        storeGridController = new AbortController();

        const { signal } = storeGridController;

        const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
        const cards = document.querySelectorAll<HTMLElement>('.product-card');

        if (!buttons.length || !cards.length) return;

        activeCategory = 'all';
        updateCategoryFilter(buttons, cards);
        rovingFocus(buttons, signal);

        buttons.forEach((button) => {
            button.addEventListener('click', () => handleCategoryClick(button, buttons, cards), { signal });
        });
    }

    function updateCategoryFilter(buttons: NodeListOf<HTMLButtonElement>, cards: NodeListOf<HTMLElement>) {
        applyFilter(buttons, cards, activeCategory, 'category', (card, active) => active === 'all' || card.dataset.category === active);
    }

    document.addEventListener('astro:page-load', initStoreGrid);
</script>
