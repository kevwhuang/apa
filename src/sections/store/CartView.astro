---
import { getCollection } from 'astro:content';

import IconTrash from '@components/icons/Trash.astro';
import PageHead from '@components/shared/PageHead.astro';
import { toCatalog } from '@lib/utils';

const catalog = toCatalog(await getCollection('products'));
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="cart-title"
>
    <div>
        <PageHead
            class="mb-6 font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Your cart"
            headingId="cart-title"
        >
            Cart
        </PageHead>
        <p
            class="max-w-2xl text-lmd text-ink-muted"
            data-motion="rise"
        >
            Every line updates as you change it. Head to checkout when it reads right.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Cart contents"
    data-catalog={JSON.stringify(catalog)}
>
    <div class="cart__grid grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
        <div class="cart__main flex flex-col gap-6">
            <aside
                class="cart__notice slab slab--card flex flex-col gap-4"
                aria-label="Cart changes"
                data-cart-notice
                hidden
                role="status"
            >
                <p class="label text-accent-deep">Your cart changed</p>
                <ul
                    class="cart__issues list-none"
                    data-cart-issues
                />
                <button
                    class="btn self-start"
                    data-cart-dismiss
                    type="button"
                >
                    Got it
                </button>
            </aside>
            <div
                class="slab slab--card slab--roomy max-w-xl w-full mx-auto text-center"
                data-cart-empty
                tabindex="-1"
            >
                <p class="label mb-3 text-ink-muted">Empty</p>
                <p class="mb-6 font-extrabold font-sans text-2xl">Nothing in the cart yet.</p>
                <a
                    class="btn btn--primary"
                    href="/store"
                >
                    Browse the store
                </a>
            </div>
            <ul
                class="cart-items flex flex-col list-none"
                data-cart-list
            />
            <p
                class="sr-only"
                aria-live="polite"
                data-cart-status
            />
        </div>
        <aside
            class="cart__summary slab slab--sunk"
            aria-label="Order summary"
            data-cart-summary
        >
            <h2 class="label mb-4 text-ink-muted">Summary</h2>
            <dl class="flex flex-col gap-2 mb-4 font-mono text-sm">
                <div class="flex justify-between gap-3">
                    <dt>Subtotal</dt>
                    <dd data-subtotal>$0.00</dd>
                </div>
                <div class="flex justify-between gap-3">
                    <dt>Shipping</dt>
                    <dd data-shipping>&mdash;</dd>
                </div>
                <div class="flex justify-between gap-3">
                    <dt>Estimated tax</dt>
                    <dd data-tax>$0.00</dd>
                </div>
                <div class="flex justify-between gap-3 pt-3 border-t-2 border-ink font-extrabold font-sans text-lg">
                    <dt>Total</dt>
                    <dd
                        aria-live="polite"
                        data-total
                    >
                        $0.00
                    </dd>
                </div>
            </dl>
            <p
                class="action-text mb-6 text-ink-subtle"
                data-cart-shipping-hint
                hidden
            />
            <a
                class="btn btn--primary cart-checkout w-full"
                aria-disabled="true"
                href="/store/checkout"
            >
                Checkout
            </a>
        </aside>
    </div>
    <template data-cart-row>
        <li class="cart-items__row slab slab--bare slab--card">
            <div
                class="cart-items__tile aspect-square flex items-center justify-center overflow-hidden relative"
                aria-hidden="true"
                data-row-tile
            >
                <div class="halftone absolute inset-0" />
                <span
                    class="font-extrabold font-sans text-[length:14cqi] uppercase text-surface-raised/80 select-none"
                    data-row-initial
                />
            </div>
            <div class="cart-items__body flex flex-col">
                <div class="flex flex-col gap-1 mb-3">
                    <div class="cart-items__heading flex items-start gap-3">
                        <p
                            class="min-w-0 font-extrabold font-sans"
                            data-row-title
                        />
                        <p
                            class="shrink-0 ml-auto font-mono text-2xs text-ink-subtle"
                            data-row-sku
                        />
                    </div>
                    <p
                        class="label text-ink-muted"
                        data-row-variant
                    />
                </div>
                <div class="cart-items__controls flex flex-wrap items-center">
                    <div class="inline-flex items-center border-2 border-ink">
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold transition-colors"
                            data-row-decrease
                            type="button"
                        >
                            &minus;
                        </button>
                        <span
                            class="w-10 font-bold font-mono text-center"
                            data-row-quantity
                        />
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold transition-colors"
                            data-row-increase
                            type="button"
                        >
                            +
                        </button>
                    </div>
                    <button
                        class="cart-items__remove"
                        data-row-remove
                        type="button"
                    >
                        <IconTrash />
                    </button>
                    <p
                        class="ml-auto font-bold font-mono text-base md:text-lg"
                        data-row-price
                    />
                </div>
            </div>
        </li>
    </template>
    <template data-cart-issue>
        <li class="flex gap-2 text-sm text-ink-muted">
            <span
                class="font-bold text-accent-deep"
                aria-hidden="true"
            >
                &middot;
            </span>
            <span
                class="min-w-0"
                data-issue-text
            />
        </li>
    </template>
</section>

<style>
    .cart-checkout {
        transition: background var(--duration-fast) var(--motion-ease-ui), border-color var(--duration-fast) var(--motion-ease-ui), color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .cart-checkout[aria-disabled='true'] {
        background: transparent;
        border-color: var(--color-ink-20);
        color: var(--color-ink-subtle);
        cursor: not-allowed;
        opacity: 1;
    }

    .cart-checkout[aria-disabled='true']:active {
        transform: none;
    }

    .cart-checkout[aria-disabled='true']:hover {
        background: transparent;
        border-color: var(--color-ink-20);
        color: var(--color-ink-subtle);
    }

    .cart-items {
        gap: var(--space-lg);
    }

    .cart-items:empty {
        display: none;
    }

    .cart-items__body {
        align-self: start;
        gap: var(--space-sm);
        padding: var(--space-lg);
    }

    .cart-items__controls {
        column-gap: var(--space-md);
        row-gap: var(--space-2xs);
    }

    .cart-items__remove {
        align-items: center;
        color: var(--color-ink-muted);
        display: inline-flex;
        flex-shrink: 0;
        height: var(--control-size);
        justify-content: center;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
        width: var(--control-size);
    }

    .cart-items__remove :global(svg) {
        height: 24px;
        width: 24px;
    }

    .cart-items__remove:active {
        transform: translateY(1px);
    }

    .cart-items__remove:focus-visible {
        outline-offset: -2px;
    }

    .cart-items__remove:hover {
        color: var(--color-accent-deep);
    }

    .cart-items__row {
        --row-tile: clamp(72px, calc(32px + 10vw), 160px);
        display: grid;
        grid-template-columns: var(--row-square, var(--row-tile)) minmax(0, 1fr);
    }

    .cart-items__tile {
        align-self: start;
        container-type: inline-size;
    }

    .cart__grid:has([data-cart-summary][hidden]) > .cart__main {
        grid-column: 1 / -1;
    }

    .cart__issues {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .cart__notice {
        border-left: 2px solid var(--color-accent-deep);
    }

    .cart__summary {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    @media (max-width: 768px) {
        .cart-items__body {
            padding: var(--space-sm);
        }

        .cart-items__heading {
            align-items: flex-end;
            flex-wrap: wrap-reverse;
        }

        .cart-items__row {
            grid-template-columns: var(--row-tile) minmax(0, 1fr);
        }
    }
</style>

<script>
    import { CARD_COLORS, COMMERCE } from '@lib/constants';
    import { formatPrice, formatVariant, parseCatalog, registerPageScript, setText } from '@lib/utils';
    import { getItems, onChange, reconcile, remove, setQuantity, totals } from '@lib/commerce/cart';
    import { isValidationBypassed, renderIssueList } from '@lib/ui/forms';
    import { toast } from '@lib/ui/toasts';

    interface FocusMark {
        control: string;
        count: number;
        index: number;
    }

    const MOBILE_WIDTH = 768;
    const ROW_CONTROLS = ['[data-row-decrease]', '[data-row-increase]', '[data-row-remove]'];
    const SKU_DIGITS = 4;
    const SQUARE_PASSES = 6;
    const SQUARE_RATIO = 0.6;
    const SQUARE_TOLERANCE = 0.5;

    let catalog: CatalogEntry[] = [];
    let squareFrame = 0;

    function announce(message: string) {
        setText(document.querySelector('[data-cart-status]'), message);
    }

    function bodyHeight(row: HTMLElement) {
        return row.querySelector<HTMLElement>('.cart-items__body')?.getBoundingClientRect().height ?? 0;
    }

    function captureFocus(list: HTMLElement) {
        const active = document.activeElement;

        if (!(active instanceof HTMLElement) || !list.contains(active)) return null;

        const control = ROW_CONTROLS.find(selector => active.matches(selector));
        const row = active.closest('li');

        if (!control || !row) return null;

        return { control, count: list.children.length, index: Array.from(list.children).indexOf(row) };
    }

    function ceilingFor(slug: string) {
        const entry = catalog.find(item => item.slug === slug);

        return Math.max(1, Math.min(entry?.stock ?? COMMERCE.maxQuantityPerItem, COMMERCE.maxQuantityPerItem));
    }

    function handleCheckoutClick(event: Event, checkout: HTMLElement) {
        if (isValidationBypassed()) return;

        if (checkout.getAttribute('aria-disabled') === 'true') event.preventDefault();
    }

    function handleQuantityClick(button: HTMLButtonElement, index: number, item: CartItem, ceiling: number, step: number) {
        if (button.getAttribute('aria-disabled') === 'true') return;

        setQuantity(index, item.quantity + step, ceiling);

        const line = getItems()[index];

        if (line) announce(`${line.quantity} \u00d7 ${line.title}, ${formatPrice(line.priceCents * line.quantity)}`);
    }

    function handleRemoveClick(index: number, item: CartItem) {
        remove(index);
        toast(`Removed ${item.title} from your cart.`, 'info');
    }

    function initCartView(signal: AbortSignal) {
        const checkout = document.querySelector<HTMLElement>('.cart-checkout');
        const dismiss = document.querySelector<HTMLButtonElement>('[data-cart-dismiss]');
        const issueList = document.querySelector<HTMLElement>('[data-cart-issues]');
        const issueTemplate = document.querySelector<HTMLTemplateElement>('[data-cart-issue]');
        const list = document.querySelector<HTMLElement>('[data-cart-list]');
        const notice = document.querySelector<HTMLElement>('[data-cart-notice]');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        if (!checkout || !list) return;

        catalog = parseCatalog(source?.dataset.catalog);

        renderIssueList(reconcile(catalog), notice, issueList, issueTemplate);
        renderCart(checkout, list, signal);

        const observer = new ResizeObserver(() => scheduleSquares(list));
        const unsubscribe = onChange(() => renderCart(checkout, list, signal));

        observer.observe(list);
        signal.addEventListener('abort', unsubscribe, { once: true });
        signal.addEventListener('abort', () => stopSquares(observer), { once: true });
        checkout.addEventListener('click', event => handleCheckoutClick(event, checkout), { signal });
        dismiss?.addEventListener('click', () => notice?.setAttribute('hidden', ''), { signal });
    }

    function isSquareFilled(row: HTMLElement) {
        return bodyHeight(row) <= squareOf(row) + SQUARE_TOLERANCE;
    }

    function measureSquares(list: HTMLElement) {
        const rows = Array.from(list.querySelectorAll<HTMLElement>('.cart-items__row'));

        resetSquares(rows);

        if (window.innerWidth <= MOBILE_WIDTH) return;

        for (let pass = 0; pass < SQUARE_PASSES; pass += 1) {
            const sides = rows.map(squareFor);

            if (sides.every((side, index) => Math.abs(side - squareOf(rows[index])) < SQUARE_TOLERANCE)) break;

            rows.forEach((row, index) => row.style.setProperty('--row-square', `${sides[index]}px`));
        }

        if (!rows.every(isSquareFilled)) resetSquares(rows);
    }

    function renderCart(checkout: HTMLElement, list: HTMLElement, signal: AbortSignal) {
        const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
        const items = getItems();
        const mark = captureFocus(list);
        const summary = document.querySelector<HTMLElement>('[data-cart-summary]');
        const template = document.querySelector<HTMLTemplateElement>('[data-cart-row]');

        checkout.setAttribute('aria-disabled', String(items.length === 0));
        empty?.toggleAttribute('hidden', items.length > 0);
        summary?.toggleAttribute('hidden', items.length === 0);
        list.replaceChildren();

        if (template) items.forEach((item, index) => list.append(renderRow(template, item, index, signal)));

        renderSummary(items);
        restoreFocus(list, mark);
        measureSquares(list);
    }

    function renderRow(template: HTMLTemplateElement, item: CartItem, index: number, signal: AbortSignal) {
        const ceiling = ceilingFor(item.productSlug);
        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const decrease = fragment.querySelector<HTMLButtonElement>('[data-row-decrease]');
        const increase = fragment.querySelector<HTMLButtonElement>('[data-row-increase]');
        const removeButton = fragment.querySelector<HTMLButtonElement>('[data-row-remove]');
        const tile = fragment.querySelector<HTMLElement>('[data-row-tile]');

        setText(fragment.querySelector('[data-row-initial]'), item.title.split(' ')[0]);
        setText(fragment.querySelector('[data-row-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-row-quantity]'), String(item.quantity));
        setText(fragment.querySelector('[data-row-sku]'), skuFor(item));
        setText(fragment.querySelector('[data-row-title]'), item.title);
        setText(fragment.querySelector('[data-row-variant]'), formatVariant(item));

        if (tile) tile.style.background = CARD_COLORS[index % CARD_COLORS.length];

        if (decrease) {
            decrease.setAttribute('aria-disabled', String(item.quantity <= 1));
            decrease.setAttribute('aria-label', `Decrease quantity of ${item.title}`);
            decrease.addEventListener('click', () => handleQuantityClick(decrease, index, item, ceiling, -1), { signal });
        }

        if (increase) {
            increase.setAttribute('aria-disabled', String(item.quantity >= ceiling));
            increase.setAttribute('aria-label', `Increase quantity of ${item.title}`);
            increase.addEventListener('click', () => handleQuantityClick(increase, index, item, ceiling, 1), { signal });
        }

        if (removeButton) {
            removeButton.setAttribute('aria-label', `Remove ${item.title} from your cart`);
            removeButton.addEventListener('click', () => handleRemoveClick(index, item), { signal });
        }

        return fragment;
    }

    function renderSummary(items: CartItem[]) {
        const hint = document.querySelector<HTMLElement>('[data-cart-shipping-hint]');
        const summary = totals(items);
        const remaining = COMMERCE.freeShippingThresholdCents - summary.subtotalCents;
        const hideHint = summary.subtotalCents === 0 || remaining <= 0;

        setText(document.querySelector('[data-shipping]'), summary.subtotalCents === 0 ? '\u2014' : formatPrice(summary.shippingCents));
        setText(document.querySelector('[data-subtotal]'), formatPrice(summary.subtotalCents));
        setText(document.querySelector('[data-tax]'), formatPrice(summary.taxCents));
        setText(document.querySelector('[data-total]'), formatPrice(summary.totalCents));

        if (!hint) return;

        hint.textContent = hideHint ? '' : `${formatPrice(remaining)} more for free shipping.`;
        hint.toggleAttribute('hidden', hideHint);
    }

    function resetSquares(rows: HTMLElement[]) {
        rows.forEach(row => row.style.removeProperty('--row-square'));
    }

    function restoreFocus(list: HTMLElement, mark: FocusMark | null) {
        if (!mark) return;

        const rows = Array.from(list.children);

        if (rows.length === 0) {
            document.querySelector<HTMLElement>('[data-cart-empty]')?.focus();

            return;
        }

        if (rows.length === mark.count) {
            rows[mark.index]?.querySelector<HTMLElement>(mark.control)?.focus();

            return;
        }

        (rows[mark.index] ?? rows[rows.length - 1]).querySelector<HTMLElement>('[data-row-remove]')?.focus();
    }

    function scheduleSquares(list: HTMLElement) {
        cancelAnimationFrame(squareFrame);
        squareFrame = requestAnimationFrame(() => measureSquares(list));
    }

    function skuFor(item: CartItem) {
        const position = catalog.findIndex(entry => entry.slug === item.productSlug) + 1;

        return `sku-${String(position).padStart(SKU_DIGITS, '0')}`;
    }

    function squareFor(row: HTMLElement) {
        return Math.min(bodyHeight(row), row.getBoundingClientRect().width * SQUARE_RATIO);
    }

    function squareOf(row: HTMLElement) {
        return Number.parseFloat(row.style.getPropertyValue('--row-square')) || 0;
    }

    function stopSquares(observer: ResizeObserver) {
        cancelAnimationFrame(squareFrame);
        observer.disconnect();
    }

    registerPageScript(initCartView);
</script>
