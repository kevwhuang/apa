---
import { getCollection } from 'astro:content';

import BackLink from '@components/shared/BackLink.astro';
import IconTrash from '@components/icons/Trash.astro';
import { SEED_ROWS } from '@lib/commerce/cart';
import { toCatalog, toImageSources } from '@lib/commerce/products';

const REMOVE_ICON_SIZE = 24;

const catalog = toCatalog(await getCollection('products'));
const images = await toImageSources();
---

<BackLink
    href="/store"
    label="Back to store"
/>

<section
    class="stage stage--tight"
    aria-labelledby="cart-title"
    data-catalog={JSON.stringify(catalog)}
    data-images={JSON.stringify(images)}
>
    <div>
        <h1
            id="cart-title"
            class="mb-12 text-4xl text-balance max-lg:text-3xl"
            data-motion="strike"
        >
            Your cart
        </h1>
        <div class="cart__grid grid grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] gap-12 max-md:grid-cols-1">
            <div class="cart__main flex flex-col gap-6">
                <aside
                    class="cart__notice slab slab--card flex flex-col max-w-(--measure-form) w-full gap-4 mx-auto"
                    aria-label="Cart changes"
                    data-cart-notice
                    hidden
                    role="status"
                >
                    <p class="label text-warning-text">Your cart changed</p>
                    <ul
                        class="flex flex-col gap-(--space-3xs) list-none"
                        data-cart-issues
                    />
                    <button
                        class="btn self-start"
                        data-cart-dismiss
                        type="button"
                    >
                        Dismiss
                    </button>
                </aside>
                <div
                    class="cart__empty slab slab--card slab--empty max-w-(--measure-form) w-full mx-auto"
                    data-cart-empty
                    data-motion="rise"
                    tabindex="-1"
                >
                    <p class="font-bold font-sans text-2xl text-balance tracking-tight">Nothing in the cart.</p>
                    <a
                        class="btn btn--primary"
                        href="/store"
                    >
                        Browse store
                    </a>
                </div>
                <ul
                    class="cart__list empty:hidden flex flex-col gap-(--space-2xl) list-none"
                    data-cart-list
                    style={`--cart-seed-rows: ${SEED_ROWS}`}
                />
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-cart-status
                />
            </div>
            <aside
                class="cart__summary slab slab--sunk"
                aria-label="Order summary"
                data-cart-summary
                data-motion="wipe"
            >
                <h2 class="label mb-4 text-text-secondary">Summary</h2>
                <dl class="flex flex-col gap-2 mb-4 font-mono text-base">
                    <div class="flex justify-between gap-3">
                        <dt>Subtotal</dt>
                        <dd data-subtotal>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt>Shipping</dt>
                        <dd data-shipping>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 mb-2">
                        <dt>Estimated tax</dt>
                        <dd data-tax>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 pt-2 border-border-strong border-t-2 text-lg">
                        <dt>Total</dt>
                        <dd
                            aria-live="polite"
                            data-total
                        >
                            $0.00
                        </dd>
                    </div>
                </dl>
                <a
                    class="btn btn--primary cart-checkout w-full"
                    aria-disabled="true"
                    href="/store/checkout"
                >
                    Check out
                </a>
            </aside>
        </div>
    </div>
    <template data-cart-row>
        <li class="cart-items__row slab slab--bare slab--card slab--still">
            <div
                class="flex items-center justify-center overflow-hidden relative self-start aspect-square"
                data-row-tile
            >
                <div
                    class="halftone absolute inset-0"
                    aria-hidden="true"
                />
                <span
                    class="font-bold font-display leading-none text-sm tracking-[-0.02em] select-none"
                    aria-hidden="true"
                    data-row-initial
                />
                <img
                    class="absolute inset-0 object-cover h-full w-full"
                    alt=""
                    data-row-photo
                    hidden
                    loading="lazy"
                />
            </div>
            <div class="cart-items__body flex flex-col">
                <div class="flex flex-col gap-1 mb-3">
                    <div class="cart-items__heading flex items-start gap-3">
                        <p class="min-w-0 font-bold font-sans leading-(--text-lg) tracking-tight">
                            <a
                                class="active:translate-y-px hover:text-link hover:underline inline-block underline-offset-4 wrap-anywhere transition-[color,translate]"
                                data-row-title
                                href="/store"
                            >
                                Item
                            </a>
                        </p>
                        <p
                            class="shrink-0 ml-auto font-mono text-sm text-text-secondary"
                            data-row-sku
                        />
                    </div>
                    <p
                        class="font-mono leading-none text-base tracking-[0.06em] uppercase text-text-secondary"
                        data-row-variant
                    />
                </div>
                <div class="flex flex-wrap items-center gap-x-(--space-md) gap-y-(--space-2xs)">
                    <div class="flex items-center">
                        <div class="inline-flex items-center border-2 border-border-strong">
                            <button
                                class="active:bg-bg-inverse active:text-text-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-text-disabled aria-disabled:hover:bg-transparent aria-disabled:text-text-disabled hover:bg-bg-raised-hover h-(--control-size) w-(--control-size) font-bold font-mono"
                                data-row-decrease
                                type="button"
                            >
                                &minus;
                            </button>
                            <span
                                class="w-10 font-bold font-mono text-center select-none"
                                data-row-quantity
                            />
                            <button
                                class="active:bg-bg-inverse active:text-text-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-text-disabled aria-disabled:hover:bg-transparent aria-disabled:text-text-disabled hover:bg-bg-raised-hover h-(--control-size) w-(--control-size) font-bold font-mono"
                                data-row-increase
                                type="button"
                            >
                                +
                            </button>
                        </div>
                        <button
                            class="cart-items__remove active:translate-y-px hover:text-link inline-flex items-center justify-center shrink-0 h-(--control-size) w-(--control-size) text-text-secondary transition-[color,translate]"
                            data-row-remove
                            type="button"
                        >
                            <IconTrash size={REMOVE_ICON_SIZE} />
                        </button>
                    </div>
                    <p
                        class="ml-auto font-mono text-base"
                        data-row-price
                    />
                </div>
            </div>
        </li>
    </template>
    <template data-cart-issue>
        <li class="flex gap-2 text-base text-text-secondary">
            <span
                class="font-bold text-warning-text"
                aria-hidden="true"
            >
                &middot;
            </span>
            <span
                class="min-w-0"
                data-issue-text
            />
        </li>
    </template>
</section>

<style>
    html[data-cart='empty'] .cart__main {
        grid-column: 1 / -1;
    }

    html[data-cart='empty'] .cart__summary {
        display: none;
    }

    html[data-cart='filled'] .cart__empty {
        display: none;
    }

    html[data-cart='filled'] .cart__list:empty {
        display: flex;
        min-height: calc(var(--row-count) * var(--row-height) + (var(--row-count) - 1) * var(--space-2xl));
    }

    .cart-checkout[aria-disabled='true'] {
        background: var(--color-btn-disabled-bg);
        border-color: var(--color-btn-disabled-border);
        color: var(--color-btn-disabled-text);
        cursor: not-allowed;
    }

    .cart-checkout[aria-disabled='true']:active {
        transform: none;
    }

    .cart-items__body {
        align-self: start;
        gap: var(--space-sm);
        padding: var(--row-pad);
    }

    .cart-items__remove:focus-visible {
        outline-offset: -2px;
    }

    .cart-items__row {
        --row-tile: clamp(72px, calc(42.667px + 9.1667vw), 160px);
        display: grid;
        grid-template-columns: var(--row-square, var(--row-tile)) minmax(0, 1fr);
    }

    .cart__list {
        --row-controls: calc(var(--control-size) + 4px);
        --row-count: var(--cart-rows, var(--cart-seed-rows));
        --row-height: calc(2 * var(--row-pad) + var(--text-lg) + var(--text-base) + 4 * var(--spacing) + var(--space-sm) + var(--row-controls) + 4px);
        --row-pad: round(clamp(16px, calc(9.333px + 2.0833vw), 36px), 4px);
    }

    .cart__notice {
        border-left: 2px solid var(--color-warning-border);
    }

    .cart__summary {
        align-self: start;
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    @media (max-width: 768px) {
        .cart-items__heading {
            align-items: flex-end;
            flex-wrap: wrap-reverse;
        }

        .cart-items__row {
            grid-template-columns: var(--row-tile) minmax(0, 1fr);
        }

        .cart__list {
            --row-controls: calc(var(--control-size) + 4px + var(--space-2xs) + var(--text-base--line-height));
        }
    }
</style>

<script>
    import { CARD_COLORS, COMMERCE, MOBILE_WIDTH } from '@lib/shared/constants';
    import { formatPrice, formatSku, formatVariant, parseCatalog, parseImageSources, registerPageScript, setProductImage, setText, setTitleLink } from '@lib/shared/utils';
    import { getItems, getTotals, onCartChange, reconcile, remove, setQuantity } from '@lib/commerce/cart';
    import { isValidationBypassed, renderIssueList } from '@lib/ui/forms';
    import { toast } from '@lib/ui/toasts';

    interface FocusMark {
        control: string;
        count: number;
        index: number;
    }

    const ROW_CONTROLS = ['[data-row-decrease]', '[data-row-increase]', '[data-row-remove]'];
    const SQUARE_PASSES = 6;
    const SQUARE_RATIO = 0.6;
    const SQUARE_TOLERANCE = 0.5;
    const STORAGE_MESSAGE = 'Nothing was removed because your browser storage is full. Clear some space and try again.';

    let catalog: CatalogEntry[] = [];
    let images: ImageSources = {};
    let squareFrame = 0;

    function announce(message: string) {
        setText(document.querySelector('[data-cart-status]'), message);
    }

    function captureFocus(list: HTMLElement) {
        const active = document.activeElement;

        if (!(active instanceof HTMLElement) || !list.contains(active)) return null;

        const control = ROW_CONTROLS.find(selector => active.matches(selector));
        const row = active.closest('li');

        if (!control || !row) return null;

        return { control, count: list.children.length, index: Array.from(list.children).indexOf(row) };
    }

    function getCeiling(slug: string) {
        const entry = catalog.find(item => item.slug === slug);

        return Math.max(1, Math.min(entry?.stock ?? COMMERCE.maxQuantityPerItem, COMMERCE.maxQuantityPerItem));
    }

    function handleCheckoutClick(event: Event, checkout: HTMLElement) {
        if (isValidationBypassed()) return;

        if (checkout.getAttribute('aria-disabled') === 'true') event.preventDefault();
    }

    function handleQuantityClick(button: HTMLButtonElement, index: number, item: CartItem, ceiling: number, step: number) {
        if (button.getAttribute('aria-disabled') === 'true') return;

        setQuantity(index, item.quantity + step, ceiling);

        const line = getItems()[index];

        if (line) announce(`${line.quantity} \u00d7 ${line.title}, ${formatPrice(line.priceCents * line.quantity)}.`);
    }

    function handleRemoveClick(index: number, item: CartItem) {
        if (!remove(index)) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        toast(`Removed ${item.title} from your cart.`, 'info');
    }

    function initCartView(signal: AbortSignal) {
        const checkout = document.querySelector<HTMLElement>('.cart-checkout');
        const dismiss = document.querySelector<HTMLButtonElement>('[data-cart-dismiss]');
        const issueList = document.querySelector<HTMLElement>('[data-cart-issues]');
        const issueTemplate = document.querySelector<HTMLTemplateElement>('[data-cart-issue]');
        const list = document.querySelector<HTMLElement>('[data-cart-list]');
        const notice = document.querySelector<HTMLElement>('[data-cart-notice]');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        if (!checkout || !list) return;

        catalog = parseCatalog(source?.dataset.catalog);
        images = parseImageSources(source?.dataset.images);
        renderIssueList(reconcile(catalog), notice, issueList, issueTemplate);
        renderCart(checkout, list, signal);

        const observer = new ResizeObserver(() => scheduleSquares(list));
        const unsubscribe = onCartChange(() => renderCart(checkout, list, signal));

        observer.observe(list);
        checkout.addEventListener('click', event => handleCheckoutClick(event, checkout), { signal });
        dismiss?.addEventListener('click', () => notice?.setAttribute('hidden', ''), { signal });
        signal.addEventListener('abort', unsubscribe, { once: true });
        signal.addEventListener('abort', () => stopSquares(observer), { once: true });
    }

    function measureBodyHeight(row: HTMLElement) {
        return row.querySelector<HTMLElement>('.cart-items__body')?.getBoundingClientRect().height ?? 0;
    }

    function measureSquares(list: HTMLElement) {
        const rows = Array.from(list.querySelectorAll<HTMLElement>('.cart-items__row'));

        resetSquares(rows);

        if (window.innerWidth <= MOBILE_WIDTH) return;

        for (let pass = 0; pass < SQUARE_PASSES; pass += 1) {
            const sides = rows.map(row => Math.min(measureBodyHeight(row), row.getBoundingClientRect().width * SQUARE_RATIO));

            if (sides.every((side, index) => Math.abs(side - readSquare(rows[index])) < SQUARE_TOLERANCE)) break;

            rows.forEach((row, index) => row.style.setProperty('--row-square', `${sides[index]}px`));
        }

        if (!rows.every(row => measureBodyHeight(row) <= readSquare(row) + SQUARE_TOLERANCE)) resetSquares(rows);
    }

    function readSquare(row: HTMLElement) {
        return Number.parseFloat(row.style.getPropertyValue('--row-square')) || 0;
    }

    function renderCart(checkout: HTMLElement, list: HTMLElement, signal: AbortSignal) {
        const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
        const items = getItems();
        const mark = captureFocus(list);
        const template = document.querySelector<HTMLTemplateElement>('[data-cart-row]');

        checkout.setAttribute('aria-disabled', String(items.length === 0));
        document.documentElement.dataset.cart = items.length > 0 ? 'filled' : 'empty';
        empty?.toggleAttribute('hidden', items.length > 0);
        list.replaceChildren();

        if (template) items.forEach((item, index) => list.append(renderRow(template, item, index, signal)));

        renderSummary(items);
        restoreFocus(list, mark);
        measureSquares(list);
    }

    function renderRow(template: HTMLTemplateElement, item: CartItem, index: number, signal: AbortSignal) {
        const ceiling = getCeiling(item.productSlug);
        const fragment = template.content.cloneNode(true) as DocumentFragment;

        const decrease = fragment.querySelector<HTMLButtonElement>('[data-row-decrease]');
        const increase = fragment.querySelector<HTMLButtonElement>('[data-row-increase]');
        const photo = fragment.querySelector<HTMLImageElement>('[data-row-photo]');
        const removeButton = fragment.querySelector<HTMLButtonElement>('[data-row-remove]');
        const tile = fragment.querySelector<HTMLElement>('[data-row-tile]');

        setProductImage(photo, images, item);
        setText(fragment.querySelector('[data-row-initial]'), item.title.split(' ')[0]);
        setText(fragment.querySelector('[data-row-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-row-quantity]'), String(item.quantity));
        setText(fragment.querySelector('[data-row-sku]'), item.sku ? formatSku(item.sku) : '');
        setTitleLink(fragment.querySelector('[data-row-title]'), catalog, item, item.title);
        setText(fragment.querySelector('[data-row-variant]'), formatVariant(item));

        if (tile) {
            const color = CARD_COLORS[index % CARD_COLORS.length];

            tile.style.background = color.background;
            tile.style.color = color.text;
        }

        if (decrease) {
            decrease.setAttribute('aria-disabled', String(item.quantity <= 1));
            decrease.setAttribute('aria-label', `Decrease quantity of ${item.title}`);
            decrease.addEventListener('click', () => handleQuantityClick(decrease, index, item, ceiling, -1), { signal });
        }

        if (increase) {
            increase.setAttribute('aria-disabled', String(item.quantity >= ceiling));
            increase.setAttribute('aria-label', `Increase quantity of ${item.title}`);
            increase.addEventListener('click', () => handleQuantityClick(increase, index, item, ceiling, 1), { signal });
        }

        if (removeButton) {
            removeButton.setAttribute('aria-label', `Remove ${item.title} from cart`);
            removeButton.addEventListener('click', () => handleRemoveClick(index, item), { signal });
        }

        return fragment;
    }

    function renderSummary(items: CartItem[]) {
        const summary = getTotals(items);

        setText(document.querySelector('[data-shipping]'), formatPrice(summary.shippingCents));
        setText(document.querySelector('[data-subtotal]'), formatPrice(summary.subtotalCents));
        setText(document.querySelector('[data-tax]'), formatPrice(summary.taxCents));
        setText(document.querySelector('[data-total]'), formatPrice(summary.totalCents));
    }

    function resetSquares(rows: HTMLElement[]) {
        rows.forEach(row => row.style.removeProperty('--row-square'));
    }

    function restoreFocus(list: HTMLElement, mark: FocusMark | null) {
        if (!mark) return;

        const rows = Array.from(list.children);

        if (rows.length === 0) {
            document.querySelector<HTMLElement>('[data-cart-empty]')?.focus();

            return;
        }

        if (rows.length === mark.count) {
            rows[mark.index]?.querySelector<HTMLElement>(mark.control)?.focus();

            return;
        }

        (rows[mark.index] ?? rows[rows.length - 1]).querySelector<HTMLElement>('[data-row-remove]')?.focus();
    }

    function scheduleSquares(list: HTMLElement) {
        cancelAnimationFrame(squareFrame);
        squareFrame = requestAnimationFrame(() => measureSquares(list));
    }

    function stopSquares(observer: ResizeObserver) {
        cancelAnimationFrame(squareFrame);
        observer.disconnect();
    }

    registerPageScript(initCartView);
</script>
