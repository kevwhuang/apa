---
import IconCheck from '@components/icons/Check.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
---

<section
    class="stage stage--tight"
    aria-labelledby="order-title"
>
    <div class="text-center">
        <div
            class="slab slab--accent slab--bare inline-flex items-center justify-center h-16 w-16 mb-8"
            aria-hidden="true"
            data-order-mark
            hidden
        >
            <IconCheck />
        </div>
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Store / Orders"
            headingId="order-title"
        >
            <span data-order-heading>Your orders.</span>
        </PageHead>
        <p
            class="label mt-6 text-ink-muted"
            data-order-number
            data-placeholder
        />
    </div>
    <div
        class="flex flex-col gap-8"
        data-motion="rise"
        data-order-detail
    >
        <p class="text-center text-lmd text-ink-muted">
            Receipt sent to&#32;
            <span
                class="font-mono wrap-break-word text-smd"
                data-order-email
            />.
        </p>
        <ul
            class="order__list scroll-slot border-2 border-ink list-none"
            data-order-list
        />
        <dl class="slab slab--sunk space-y-1.5 font-mono text-sm">
            <div class="flex justify-between gap-3">
                <dt>Subtotal</dt>
                <dd data-order-subtotal>$0.00</dd>
            </div>
            <div
                class="flex justify-between gap-3"
                data-order-discount-row
                hidden
            >
                <dt>Prods credit</dt>
                <dd data-order-discount>$0.00</dd>
            </div>
            <div class="flex justify-between gap-3">
                <dt>Shipping</dt>
                <dd data-order-shipping>&mdash;</dd>
            </div>
            <div class="flex justify-between gap-3">
                <dt>Tax</dt>
                <dd data-order-tax>$0.00</dd>
            </div>
            <div class="flex justify-between gap-3 mt-2 pt-2 border-t-2 border-ink font-extrabold font-sans text-lg">
                <dt>Total</dt>
                <dd data-order-total>$0.00</dd>
            </div>
        </dl>
        <div class="flex flex-wrap justify-center gap-3">
            <a
                class="btn btn--primary"
                href="/store"
            >
                Back to the store
            </a>
            <a
                class="btn"
                href="/store/cart"
            >
                Go to the cart
            </a>
        </div>
    </div>
    <template data-order-row>
        <li class="first:border-t-0 flex items-center gap-4 p-4 border-t-2 border-ink">
            <div class="flex-1 min-w-0">
                <p
                    class="font-bold font-sans"
                    data-row-title
                />
                <p
                    class="label text-ink-muted"
                    data-row-variant
                />
            </div>
            <p
                class="font-bold font-mono"
                data-row-price
            />
        </li>
    </template>
</section>

<section
    class="stage stage--tight border-t-2 border-ink"
    aria-labelledby="order-ledger-title"
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-3xl tracking-tight"
            eyebrow="Store / Ledger"
            headingId="order-ledger-title"
        >
            Order history
        </SectionHead>
        <div data-motion="unfold">
            <p
                class="slab slab--card max-w-xl w-full mx-auto leading-relaxed text-center text-ink-muted"
                data-order-empty
            >
                No orders yet &mdash; receipts from the store land here.
            </p>
            <div
                class="order__scroller"
                data-order-ledger
                hidden
            >
                <table class="order__table border-2 border-ink">
                    <caption class="sr-only">Orders with date, items, and total &mdash; pick a row to load its receipt</caption>
                    <thead>
                        <tr class="border-b-2 border-ink font-bold font-mono text-2xs tracking-wide uppercase text-ink-muted">
                            <th
                                class="order__cell text-left"
                                scope="col"
                            >
                                Order
                            </th>
                            <th
                                class="order__cell order__date text-left"
                                scope="col"
                            >
                                Date
                            </th>
                            <th
                                class="order__cell text-left"
                                scope="col"
                            >
                                Items
                            </th>
                            <th
                                class="order__cell text-right"
                                scope="col"
                            >
                                Total
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-y divide-ink"
                        data-order-ledger-body
                    />
                </table>
            </div>
        </div>
    </div>
    <template data-order-ledger-row>
        <tr
            class="order__row"
            data-order-index
        >
            <th
                class="order__cell text-left"
                scope="row"
            >
                <button
                    class="order__pick font-mono text-xs whitespace-nowrap"
                    data-cell="id"
                    type="button"
                />
                <time class="order__stamp font-mono text-2xs text-ink-muted" />
            </th>
            <td class="order__cell order__date font-mono text-xs whitespace-nowrap text-ink-muted">
                <time data-cell="date" />
            </td>
            <td
                class="order__cell order__items text-sm"
                data-cell="items"
            />
            <td
                class="order__cell font-bold font-mono text-right text-xs whitespace-nowrap"
                data-cell="total"
            />
        </tr>
    </template>
</section>

<style>
    .order__cell {
        padding: var(--space-sm);
    }

    .order__items {
        overflow-wrap: anywhere;
    }

    .order__list {
        --scroll-slot-max: 40vh;
    }

    .order__pick {
        align-items: center;
        display: flex;
        min-height: var(--space-md);
        transition: color var(--duration-fast) var(--motion-ease-ui), font-weight var(--duration-fast) var(--motion-ease-ui);
        width: 100%;
    }

    .order__pick:active {
        font-weight: 700;
    }

    .order__pick:focus-visible {
        outline-offset: -2px;
    }

    .order__pick:hover {
        color: var(--color-accent-deep);
    }

    .order__pick[aria-current] {
        color: var(--color-accent-deep);
        font-weight: 700;
    }

    .order__row {
        cursor: pointer;
        transition: background-color var(--duration-fast) var(--motion-ease-ui), translate var(--duration-fast) var(--motion-ease-ui);
    }

    .order__row:active {
        translate: 0 1px;
    }

    .order__row:has([aria-current]) {
        background-color: var(--color-accent-20);
    }

    .order__row:hover {
        background-color: var(--color-surface-sunken);
    }

    .order__scroller {
        overflow-x: auto;
    }

    .order__stamp {
        display: none;
    }

    .order__table {
        display: table;
        overflow-x: visible;
        width: 100%;
    }

    @media (max-width: 768px) {
        .order__cell {
            padding: var(--space-sm) var(--space-2xs);
        }

        .order__date {
            display: none;
        }

        .order__stamp {
            display: block;
            margin-top: var(--space-3xs);
            white-space: nowrap;
        }
    }
</style>

<script>
    import { MILLISECONDS_PER_DAY } from '@lib/constants';
    import { formatDateStamp, formatPrice, formatVariant, registerPageScript, setText, toIsoDate } from '@lib/utils';
    import { getLastOrder } from '@lib/commerce/checkout';
    import { totals } from '@lib/commerce/cart';

    const NEWEST_ORDER_AGE_DAYS = 9;
    const NEWEST_ORDER_ITEMS: CartItem[] = [
        { color: 'Bone', image: 'tick-tee-1', priceCents: 3_500, productSlug: 'tick-tee', quantity: 1, size: 'M', title: 'Tick Tee' },
        { image: 'stickers-1', priceCents: 800, productSlug: 'sticker-pack', quantity: 2, title: 'Sticker Pack' },
        { color: 'Natural', image: 'tote-1', priceCents: 2_200, productSlug: 'tote-bag', quantity: 1, title: 'Tote Bag' },
    ];
    const OLDER_ORDER_AGE_DAYS = 24;
    const OLDER_ORDER_ITEMS: CartItem[] = [
        { image: 'stickers-1', priceCents: 800, productSlug: 'sticker-pack', quantity: 2, title: 'Sticker Pack' },
        { color: 'Natural', image: 'tote-1', priceCents: 2_200, productSlug: 'tote-bag', quantity: 1, title: 'Tote Bag' },
    ];
    const OLDEST_ORDER_AGE_DAYS = 96;
    const OLDEST_ORDER_ITEMS: CartItem[] = [
        { color: 'Charcoal', image: 'hoodie-1', priceCents: 7_800, productSlug: 'bash-hoodie', quantity: 1, size: 'L', title: 'Bash Hoodie' },
        { image: 'stickers-1', priceCents: 800, productSlug: 'sticker-pack', quantity: 1, title: 'Sticker Pack' },
    ];
    const PAST_ORDERS: Order[] = [
        {
            email: 'p\u2022\u2022\u2022\u2022\u2022\u2022@example.com',
            id: 'APA-04217',
            items: NEWEST_ORDER_ITEMS,
            placedAt: Date.now() - NEWEST_ORDER_AGE_DAYS * MILLISECONDS_PER_DAY,
            totals: totals(NEWEST_ORDER_ITEMS),
        },
        {
            email: 'r\u2022\u2022\u2022\u2022\u2022@example.com',
            id: 'APA-03586',
            items: OLDER_ORDER_ITEMS,
            placedAt: Date.now() - OLDER_ORDER_AGE_DAYS * MILLISECONDS_PER_DAY,
            totals: totals(OLDER_ORDER_ITEMS),
        },
        {
            email: 'm\u2022\u2022\u2022\u2022@example.com',
            id: 'APA-03581',
            items: OLDEST_ORDER_ITEMS,
            placedAt: Date.now() - OLDEST_ORDER_AGE_DAYS * MILLISECONDS_PER_DAY,
            totals: totals(OLDEST_ORDER_ITEMS),
        },
    ];
    const RECEIPT_FRESH_MS = 120_000;

    let orders: Order[] = [];
    let placedId: string | null = null;

    function formatItemsSummary(items: CartItem[]) {
        return items.map(item => `${item.quantity} \u00d7 ${item.title}`).join(', ');
    }

    function handleLedgerClick(event: MouseEvent) {
        const row = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-order-index]') : null;

        if (!row) return;

        selectOrder(Number(row.dataset.orderIndex), true);
    }

    function initOrderHistory(signal: AbortSignal) {
        const body = document.querySelector<HTMLElement>('[data-order-ledger-body]');
        const detail = document.querySelector<HTMLElement>('[data-order-detail]');
        const heading = document.querySelector<HTMLElement>('#order-title');
        const placed = getLastOrder();

        orders = placed ? [placed, ...PAST_ORDERS] : [...PAST_ORDERS];
        placedId = placed?.id ?? null;

        if (heading) heading.tabIndex = -1;

        detail?.toggleAttribute('hidden', orders.length === 0);
        renderLedger();
        selectOrder(0, false);
        body?.addEventListener('click', handleLedgerClick, { signal });
    }

    function renderHeading(order: Order, fresh: boolean) {
        document.querySelector<HTMLElement>('[data-order-mark]')?.toggleAttribute('hidden', !fresh);

        setText(document.querySelector('[data-order-email]'), order.email);
        setText(document.querySelector('[data-order-heading]'), fresh ? 'Order received.' : 'Your orders.');
        setText(document.querySelector('[data-order-number]'), `Order ${order.id} \u00b7 ${formatDateStamp(new Date(order.placedAt))}`);
    }

    function renderItems(order: Order) {
        const list = document.querySelector<HTMLElement>('[data-order-list]');
        const template = document.querySelector<HTMLTemplateElement>('[data-order-row]');

        if (!list || !template) return;

        list.replaceChildren();

        order.items.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const variant = formatVariant(item);

            setText(fragment.querySelector('[data-row-price]'), formatPrice(item.priceCents * item.quantity));
            setText(fragment.querySelector('[data-row-title]'), item.title);
            setText(fragment.querySelector('[data-row-variant]'), [variant, `\u00d7 ${item.quantity}`].filter(Boolean).join(' / '));
            list.append(fragment);
        });
    }

    function renderLedger() {
        const body = document.querySelector<HTMLElement>('[data-order-ledger-body]');
        const empty = document.querySelector<HTMLElement>('[data-order-empty]');
        const ledger = document.querySelector<HTMLElement>('[data-order-ledger]');
        const template = document.querySelector<HTMLTemplateElement>('[data-order-ledger-row]');

        if (!body || !empty || !ledger || !template) return;

        body.replaceChildren();

        orders.forEach((order, index) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const pick = fragment.querySelector('[data-cell="id"]');
            const placedDate = new Date(order.placedAt);
            const row = fragment.querySelector('[data-order-index]');
            const stamps = fragment.querySelectorAll('time');

            pick?.setAttribute('aria-label', `View order ${order.id}`);
            row?.setAttribute('data-order-index', String(index));

            stamps.forEach((stamp) => {
                stamp.setAttribute('datetime', toIsoDate(placedDate));
                setText(stamp, formatDateStamp(placedDate));
            });

            setText(pick, order.id);
            setText(fragment.querySelector('[data-cell="items"]'), formatItemsSummary(order.items));
            setText(fragment.querySelector('[data-cell="total"]'), formatPrice(order.totals.totalCents));
            body.append(fragment);
        });

        empty.toggleAttribute('hidden', orders.length > 0);
        ledger.toggleAttribute('hidden', orders.length === 0);
    }

    function renderTotals(summary: CartTotals) {
        const row = document.querySelector<HTMLElement>('[data-order-discount-row]');

        row?.toggleAttribute('hidden', summary.discountCents === 0);

        setText(document.querySelector('[data-order-discount]'), `\u2212${formatPrice(summary.discountCents)}`);
        setText(document.querySelector('[data-order-shipping]'), summary.shippingCents === 0 ? 'Free' : formatPrice(summary.shippingCents));
        setText(document.querySelector('[data-order-subtotal]'), formatPrice(summary.subtotalCents));
        setText(document.querySelector('[data-order-tax]'), formatPrice(summary.taxCents));
        setText(document.querySelector('[data-order-total]'), formatPrice(summary.totalCents));
    }

    function selectOrder(index: number, moveFocus: boolean) {
        const order = orders[index];

        if (!order) return;

        const fresh = order.id === placedId && Date.now() - order.placedAt < RECEIPT_FRESH_MS;

        document.querySelectorAll<HTMLElement>('[data-order-index]').forEach((row) => {
            const pick = row.querySelector('[data-cell="id"]');

            if (Number(row.dataset.orderIndex) === index) pick?.setAttribute('aria-current', 'true');
            else pick?.removeAttribute('aria-current');
        });

        renderHeading(order, fresh);
        renderItems(order);
        renderTotals(order.totals);

        if (!moveFocus) return;

        document.querySelector<HTMLElement>('#order-title')?.focus();
    }

    registerPageScript(initOrderHistory);
</script>
