---
import IconCheck from '@components/icons/Check.astro';
import PageHead from '@components/shared/PageHead.astro';
---

<section
    class="stage stage--tight"
    aria-labelledby="order-title"
>
    <div class="text-center">
        <div
            class="slab slab--accent slab--bare inline-flex items-center justify-center h-16 w-16 mb-8"
            aria-hidden="true"
            data-order-mark
            hidden
        >
            <IconCheck />
        </div>
        <PageHead
            class="font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Store / Orders"
            headingId="order-title"
        >
            <span data-order-heading>Orders</span>
        </PageHead>
        <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
            <span
                class="chip"
                data-order-sample
                hidden
            >
                Sample order
            </span>
            <p
                class="label text-ink-muted"
                data-order-number
                data-placeholder
            />
        </div>
    </div>
    <div
        class="flex flex-col gap-8"
        data-motion="rise"
        data-order-detail
    >
        <p class="text-center text-lmd text-ink-muted">
            Receipt sent to&#32;
            <span
                class="font-mono wrap-break-word text-smd"
                data-order-email
            />.
        </p>
        <ul
            class="order__list scroll-slot border-2 border-ink list-none"
            data-order-list
        />
        <dl class="slab slab--sunk space-y-1.5 font-mono text-sm">
            <div class="flex justify-between gap-3">
                <dt>Subtotal</dt>
                <dd data-order-subtotal>$0.00</dd>
            </div>
            <div
                class="flex justify-between gap-3"
                data-order-discount-row
                hidden
            >
                <dt>Prods credit</dt>
                <dd data-order-discount>$0.00</dd>
            </div>
            <div class="flex justify-between gap-3">
                <dt>Shipping</dt>
                <dd data-order-shipping>&mdash;</dd>
            </div>
            <div class="flex justify-between gap-3">
                <dt>Tax</dt>
                <dd data-order-tax>$0.00</dd>
            </div>
            <div class="flex justify-between gap-3 mt-2 pt-2 border-t-2 border-ink font-extrabold font-sans text-lg">
                <dt>Total</dt>
                <dd data-order-total>$0.00</dd>
            </div>
        </dl>
        <div class="flex flex-wrap justify-center gap-3">
            <a
                class="btn btn--primary"
                href="/store"
            >
                Back to the store
            </a>
            <a
                class="btn"
                href="/store/cart"
            >
                Go to the cart
            </a>
        </div>
    </div>
    <template data-order-row>
        <li class="first:border-t-0 flex items-center gap-4 p-4 border-t-2 border-ink">
            <div class="flex-1 min-w-0">
                <p
                    class="font-bold font-sans"
                    data-row-title
                />
                <p
                    class="label text-ink-muted"
                    data-row-variant
                />
            </div>
            <p
                class="font-bold font-mono"
                data-row-price
            />
        </li>
    </template>
</section>

<style>
    .order__list {
        --scroll-slot-max: 40vh;
    }
</style>

<script>
    import { MILLISECONDS_PER_DAY } from '@lib/constants';
    import { formatDateStamp, formatPrice, formatVariant, registerPageScript, setText } from '@lib/utils';
    import { getLastOrder } from '@lib/commerce/checkout';
    import { totals } from '@lib/commerce/cart';

    const SAMPLE_AGE_DAYS = 9;
    const SAMPLE_ITEMS: CartItem[] = [
        { color: 'Bone', image: 'tick-tee-1', priceCents: 3_500, productSlug: 'tick-tee', quantity: 1, size: 'M', title: 'Tick Tee' },
        { image: 'stickers-1', priceCents: 800, productSlug: 'sticker-pack', quantity: 2, title: 'Sticker Pack' },
        { color: 'Natural', image: 'tote-1', priceCents: 2_200, productSlug: 'tote-bag', quantity: 1, title: 'Tote Bag' },
    ];
    const SAMPLE_ORDER: Order = {
        email: 'p\u2022\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-04217',
        items: SAMPLE_ITEMS,
        placedAt: Date.now() - SAMPLE_AGE_DAYS * MILLISECONDS_PER_DAY,
        totals: totals(SAMPLE_ITEMS),
    };

    function initOrderHistory() {
        const placed = getLastOrder();
        const order = placed ?? SAMPLE_ORDER;

        document.querySelector<HTMLElement>(placed ? '[data-order-mark]' : '[data-order-sample]')?.removeAttribute('hidden');

        renderHeading(order, placed !== null);
        renderItems(order);
        renderTotals(order.totals);
    }

    function renderHeading(order: Order, placed: boolean) {
        setText(document.querySelector('[data-order-email]'), order.email);
        setText(document.querySelector('[data-order-heading]'), placed ? 'Order received.' : 'Orders');
        setText(document.querySelector('[data-order-number]'), `Order ${order.id} \u00b7 ${formatDateStamp(new Date(order.placedAt))}`);
    }

    function renderItems(order: Order) {
        const list = document.querySelector<HTMLElement>('[data-order-list]');
        const template = document.querySelector<HTMLTemplateElement>('[data-order-row]');

        if (!list || !template) return;

        list.replaceChildren();

        order.items.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const variant = formatVariant(item);

            setText(fragment.querySelector('[data-row-price]'), formatPrice(item.priceCents * item.quantity));
            setText(fragment.querySelector('[data-row-title]'), item.title);
            setText(fragment.querySelector('[data-row-variant]'), [variant, `\u00d7 ${item.quantity}`].filter(Boolean).join(' / '));
            list.append(fragment);
        });
    }

    function renderTotals(summary: CartTotals) {
        const row = document.querySelector<HTMLElement>('[data-order-discount-row]');

        row?.toggleAttribute('hidden', summary.discountCents === 0);

        setText(document.querySelector('[data-order-discount]'), `\u2212${formatPrice(summary.discountCents)}`);
        setText(document.querySelector('[data-order-shipping]'), summary.shippingCents === 0 ? 'Free' : formatPrice(summary.shippingCents));
        setText(document.querySelector('[data-order-subtotal]'), formatPrice(summary.subtotalCents));
        setText(document.querySelector('[data-order-tax]'), formatPrice(summary.taxCents));
        setText(document.querySelector('[data-order-total]'), formatPrice(summary.totalCents));
    }

    registerPageScript(initOrderHistory);
</script>
