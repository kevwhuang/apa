---
import { getCollection } from 'astro:content';

import BackLink from '@components/shared/BackLink.astro';
import PageHead from '@components/shared/PageHead.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { COMMERCE } from '@lib/shared/constants';
import { formatPrice } from '@lib/shared/utils';
import { toCatalog, toImageSources } from '@lib/commerce/products';
import { getTotals } from '@lib/commerce/cart';

interface OrderSeed {
    email: string;
    id: string;
    items: Parameters<typeof getTotals>[0];
    placedAt: string;
    prodsApplied?: number;
    promoCode?: string;
}

const PAST_ORDER_SEEDS: OrderSeed[] = [
    {
        email: 'p\u2022\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-04217',
        items: [
            { image: '02000_digital', priceCents: 500, productSlug: 'alliance_samples_i', quantity: 1, sku: '02000', title: 'Alliance Samples I', variation: 'Digital' },
            { image: '01001_symbol', priceCents: 100, productSlug: 'alliance_sticker', quantity: 2, sku: '01001', title: 'Alliance Sticker', variation: 'Symbol' },
            { image: '00010_bone', priceCents: 3_000, productSlug: 'alliance_tee', quantity: 1, size: 'M', sku: '00010', title: 'Alliance Tee', variation: 'Bone' },
        ],
        placedAt: '2026-07-28T16:42:00-05:00',
    },
    {
        email: 'd\u2022\u2022\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-04106',
        items: [
            { image: '02000_digital', priceCents: 500, productSlug: 'alliance_samples_i', quantity: 1, sku: '02000', title: 'Alliance Samples I', variation: 'Digital' },
            { image: '00001_navy', priceCents: 1_000, productSlug: 'legacy_tee', quantity: 1, size: 'L', sku: '00001', title: 'Legacy Tee', variation: 'Navy' },
        ],
        placedAt: '2026-07-04T11:15:00-05:00',
        promoCode: COMMERCE.discountCode,
    },
    {
        email: 'j\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-03994',
        items: [
            { image: '00020_charcoal', priceCents: 10_000, productSlug: 'alliance_hoodie', quantity: 1, size: 'L', sku: '00020', title: 'Alliance Hoodie', variation: 'Charcoal' },
        ],
        placedAt: '2026-06-13T18:20:00-05:00',
        prodsApplied: 15,
    },
    {
        email: 'i\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-03871',
        items: [
            { image: '00031_bone', priceCents: 4_000, productSlug: 'alliance_cap', quantity: 1, sku: '00031', title: 'Alliance Cap', variation: 'Bone' },
            { image: '01001_symbol', priceCents: 100, productSlug: 'alliance_sticker', quantity: 1, sku: '01001', title: 'Alliance Sticker', variation: 'Symbol' },
            { image: '00000_cotton', priceCents: 1_000, productSlug: 'legacy_tee', quantity: 1, size: 'M', sku: '00000', title: 'Legacy Tee', variation: 'Cotton' },
        ],
        placedAt: '2026-05-22T09:05:00-05:00',
        prodsApplied: 24,
        promoCode: COMMERCE.discountCode,
    },
    {
        email: 's\u2022\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-03742',
        items: [
            { image: '02000_digital', priceCents: 500, productSlug: 'alliance_samples_i', quantity: 1, sku: '02000', title: 'Alliance Samples I', variation: 'Digital' },
            { image: '00013_lime', priceCents: 3_000, productSlug: 'alliance_tee', quantity: 1, size: 'S', sku: '00013', title: 'Alliance Tee', variation: 'Lime' },
        ],
        placedAt: '2026-04-18T14:30:00-05:00',
    },
    {
        email: 'r\u2022\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-03586',
        items: [
            { image: '00030_black', priceCents: 4_000, productSlug: 'alliance_cap', quantity: 1, sku: '00030', title: 'Alliance Cap', variation: 'Black' },
            { image: '01001_symbol', priceCents: 100, productSlug: 'alliance_sticker', quantity: 2, sku: '01001', title: 'Alliance Sticker', variation: 'Symbol' },
        ],
        placedAt: '2026-03-09T12:48:00-05:00',
    },
    {
        email: 'm\u2022\u2022\u2022\u2022@example.com',
        id: 'APA-03581',
        items: [
            { image: '00021_smoke', priceCents: 10_000, productSlug: 'alliance_hoodie', quantity: 1, size: 'XL', sku: '00021', title: 'Alliance Hoodie', variation: 'Smoke' },
            { image: '01001_symbol', priceCents: 100, productSlug: 'alliance_sticker', quantity: 1, sku: '01001', title: 'Alliance Sticker', variation: 'Symbol' },
        ],
        placedAt: '2026-02-14T15:10:00-06:00',
    },
];

const catalog = toCatalog(await getCollection('products'));
const images = await toImageSources();

const pastOrders = PAST_ORDER_SEEDS.map(seed => ({
    email: seed.email,
    id: seed.id,
    items: seed.items,
    placedAt: Date.parse(seed.placedAt),
    totals: getTotals(seed.items, seed.prodsApplied ?? 0, seed.promoCode ?? ''),
}));

const receipt = pastOrders[0];
---

<BackLink
    href="/store"
    label="Back to store"
/>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="order-title"
    data-catalog={JSON.stringify(catalog)}
    data-images={JSON.stringify(images)}
    data-order-seed={JSON.stringify(pastOrders)}
>
    <div class="text-center">
        <PageHead
            class="mb-6 text-4xl-7xl"
            headingId="order-title"
        >
            <span data-order-heading>Your receipts</span>
        </PageHead>
        <p
            class="min-h-lh font-mono text-base text-text-secondary"
            data-motion="stamp"
            data-order-number
            data-placeholder
        />
    </div>
    <div
        class="flex flex-col gap-8"
        data-motion="rise"
        data-order-detail
    >
        <ul
            class="order__list scroll-slot border-2 border-border-strong divide-border-strong divide-y-2 list-none"
            data-order-list
        >
            {receipt.items.map(() => (
                <li
                    class="p-4"
                    aria-hidden="true"
                >
                    <span class="block h-14" />
                </li>
            ))}
        </ul>
        <dl class="slab slab--sunk flex flex-col gap-2 font-mono text-base">
            <div class="flex justify-between gap-3">
                <dt>Subtotal</dt>
                <dd
                    class="min-w-0 wrap-break-word"
                    data-order-subtotal
                >
                    {formatPrice(receipt.totals.subtotalCents)}
                </dd>
            </div>
            <div
                class="flex justify-between gap-3"
                data-order-promo-row
                hidden
            >
                <dt>Discount ({COMMERCE.discountCode})</dt>
                <dd
                    class="whitespace-nowrap"
                    data-order-promo
                >
                    $0.00
                </dd>
            </div>
            <div
                class="flex justify-between gap-3"
                data-order-discount-row
                hidden
            >
                <dt>Prods credit</dt>
                <dd
                    class="min-w-0 wrap-break-word"
                    data-order-discount
                >
                    $0.00
                </dd>
            </div>
            <div class="flex justify-between gap-3">
                <dt>Shipping</dt>
                <dd
                    class="min-w-0 wrap-break-word"
                    data-order-shipping
                >
                    {formatPrice(receipt.totals.shippingCents)}
                </dd>
            </div>
            <div class="flex justify-between gap-3 mb-2">
                <dt>Tax</dt>
                <dd
                    class="min-w-0 wrap-break-word"
                    data-order-tax
                >
                    {formatPrice(receipt.totals.taxCents)}
                </dd>
            </div>
            <div class="flex justify-between gap-3 pt-2 border-border-strong border-t-2 text-lg">
                <dt>Total</dt>
                <dd
                    class="min-w-0 wrap-break-word"
                    data-order-total
                >
                    {formatPrice(receipt.totals.totalCents)}
                </dd>
            </div>
        </dl>
        <div class="flex flex-wrap justify-center gap-3">
            <a
                class="btn btn--primary"
                href="/store"
            >
                Browse store
            </a>
            <a
                class="btn"
                href="/store/cart"
            >
                Go to cart
            </a>
        </div>
    </div>
    <template data-order-row>
        <li class="flex flex-wrap items-center justify-end gap-4 p-4">
            <span class="block shrink-0 size-14 border-2 border-border-strong bg-bg-inverse">
                <img
                    class="block object-cover size-full"
                    alt=""
                    data-row-photo
                    hidden
                    loading="lazy"
                />
            </span>
            <div class="flex flex-1 flex-col min-w-36 gap-1">
                <p
                    class="font-bold leading-(--text-lg) tracking-tight"
                    data-row-title
                />
                <p
                    class="font-mono leading-none text-base tracking-[0.06em] uppercase text-text-secondary"
                    data-row-variant
                />
            </div>
            <p
                class="font-mono text-base"
                data-row-price
            />
        </li>
    </template>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="order-ledger-title"
>
    <div>
        <SectionHead
            class="text-3xl"
            headingId="order-ledger-title"
        >
            Order history
        </SectionHead>
        <div data-motion="unfold">
            <p
                class="slab slab--card slab--empty max-w-(--measure-form) w-full mx-auto text-base text-text-secondary"
                data-order-empty
                hidden
            >
                No orders on file. Receipts from the store appear here.
            </p>
            <div
                class="order__scroller scroll-slot overflow-x-auto border-2 border-border-strong"
                data-order-ledger
            >
                <table class="order__table">
                    <caption class="sr-only">Orders with date, items, and total. Pick a row to load its receipt</caption>
                    <thead>
                        <tr class="label text-text-secondary">
                            <th
                                class="order__cell text-left"
                                scope="col"
                            >
                                Order
                            </th>
                            <th
                                class="order__cell order__date text-left max-md:hidden"
                                scope="col"
                            >
                                Date
                            </th>
                            <th
                                class="order__cell order__items text-left max-md:hidden"
                                scope="col"
                            >
                                Items
                            </th>
                            <th
                                class="order__cell text-right"
                                scope="col"
                            >
                                Total
                            </th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-border-strong divide-y"
                        data-order-ledger-body
                    />
                </table>
            </div>
        </div>
    </div>
    <template data-order-ledger-row>
        <tr
            class="order__row"
            data-order-index
        >
            <th
                class="order__cell font-normal text-left"
                scope="row"
            >
                <button
                    class="order__pick font-mono text-base whitespace-nowrap"
                    data-cell="id"
                    type="button"
                />
                <time class="order__stamp hidden font-mono text-base whitespace-nowrap text-text-secondary max-md:block" />
                <span
                    class="hidden text-base max-md:line-clamp-1"
                    data-cell="summary"
                />
            </th>
            <td class="order__cell order__date font-mono text-base whitespace-nowrap text-text-secondary max-md:hidden">
                <time data-cell="date" />
            </td>
            <td class="order__cell order__items text-base wrap-anywhere max-md:hidden">
                <span
                    class="line-clamp-1"
                    data-cell="items"
                />
            </td>
            <td
                class="order__cell font-mono text-base text-right whitespace-nowrap"
                data-cell="total"
            />
        </tr>
    </template>
</section>

<style>
    .order__cell {
        padding: 16px round(clamp(8px, calc(5.333px + 0.8333vw), 16px), 4px);
    }

    .order__list {
        --scroll-slot-max: 40vh;
        scrollbar-gutter: auto;
    }

    .order__pick {
        align-items: center;
        display: flex;
        min-height: var(--space-md);
        transition: color var(--duration-fast) var(--motion-ease-ui);
        width: 100%;
    }

    .order__pick:focus-visible {
        outline-offset: -2px;
    }

    .order__pick:hover {
        color: var(--color-link);
    }

    .order__pick[aria-current] {
        color: var(--color-link);
    }

    .order__row {
        cursor: pointer;
        transition:
            background-color var(--duration-fast) var(--motion-ease-ui),
            translate var(--duration-fast) var(--motion-ease-ui);
    }

    .order__row:active {
        translate: 0 1px;
    }

    .order__row:has([aria-current]) {
        background-color: var(--color-bg-selected);
    }

    .order__row:hover {
        background-color: var(--color-bg-hover);
    }

    .order__scroller {
        --scroll-slot-max: calc(40px + var(--text-sm) + 5 * (32px + max(var(--space-md), var(--text-base--line-height))));
        min-height: var(--scroll-slot-max);
    }

    .order__table thead th {
        background-color: var(--color-bg-page);
        box-shadow: inset 0 -2px 0 var(--color-border-strong);
        position: sticky;
        top: 0;
        z-index: var(--z-page);
    }

    @media (max-width: 768px) {
        .order__pick {
            margin-bottom: 4px;
        }

        .order__scroller {
            --scroll-slot-max: calc(40px + var(--text-sm) + 5 * (32px + max(var(--space-md), var(--text-base--line-height)) + 4px + 2 * var(--text-base--line-height)));
        }
    }
</style>

<script>
    import { formatDateStamp, formatPrice, formatVariant, parseCatalog, parseImageSources, registerPageScript, setProductImage, setText, toIsoDate } from '@lib/shared/utils';
    import { reconcileOrder } from '@lib/commerce/checkout';

    let images: ImageSources = {};
    let orders: Order[] = [];
    let placedId: null | string = null;

    function handleLedgerClick(event: MouseEvent) {
        const row = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-order-index]') : null;

        if (!row) return;

        selectOrder(Number(row.dataset.orderIndex), true);
    }

    function initOrderHistory(signal: AbortSignal) {
        const body = document.querySelector<HTMLElement>('[data-order-ledger-body]');
        const detail = document.querySelector<HTMLElement>('[data-order-detail]');
        const heading = document.querySelector<HTMLElement>('[data-order-heading]')?.closest('h1');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        const placed = reconcileOrder(parseCatalog(source?.dataset.catalog));

        images = parseImageSources(source?.dataset.images);
        orders = placed ? [placed, ...readSeed()] : readSeed();
        placedId = placed?.id ?? null;

        if (heading) heading.tabIndex = -1;

        detail?.toggleAttribute('hidden', orders.length === 0);
        renderLedger();
        selectOrder(0, false);
        body?.addEventListener('click', handleLedgerClick, { signal });
    }

    function readSeed() {
        const raw = document.querySelector<HTMLElement>('[data-order-seed]')?.dataset.orderSeed;

        try {
            return JSON.parse(raw ?? '[]') as Order[];
        } catch {
            return [];
        }
    }

    function renderHeading(order: Order, isFresh: boolean) {
        const stamp = formatDateStamp(new Date(order.placedAt)).replaceAll(' ', '\u00a0');

        setText(document.querySelector('[data-order-heading]'), isFresh ? 'Order received' : 'Your receipts');
        setText(document.querySelector('[data-order-number]'), `Order ${order.id}\u00a0\u00b7 ${stamp}`);
    }

    function renderItems(order: Order) {
        const list = document.querySelector<HTMLElement>('[data-order-list]');
        const template = document.querySelector<HTMLTemplateElement>('[data-order-row]');

        if (!list || !template) return;

        list.replaceChildren();

        order.items.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const variant = formatVariant(item);

            setProductImage(fragment.querySelector<HTMLImageElement>('[data-row-photo]'), images, item);
            setText(fragment.querySelector('[data-row-price]'), formatPrice(item.priceCents * item.quantity));
            setText(fragment.querySelector('[data-row-title]'), item.title);
            setText(fragment.querySelector('[data-row-variant]'), [variant, `\u00d7\u00a0${item.quantity}`].filter(Boolean).join(' / '));
            list.append(fragment);
        });
    }

    function renderLedger() {
        const body = document.querySelector<HTMLElement>('[data-order-ledger-body]');
        const empty = document.querySelector<HTMLElement>('[data-order-empty]');
        const ledger = document.querySelector<HTMLElement>('[data-order-ledger]');
        const template = document.querySelector<HTMLTemplateElement>('[data-order-ledger-row]');

        if (!body || !empty || !ledger || !template) return;

        body.replaceChildren();

        orders.forEach((order, index) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const placedDate = new Date(order.placedAt);
            const summary = summarizeItems(order.items);

            const pick = fragment.querySelector('[data-cell="id"]');
            const row = fragment.querySelector('[data-order-index]');
            const stamps = fragment.querySelectorAll('time');

            pick?.setAttribute('aria-label', `View order ${order.id}`);
            row?.setAttribute('data-order-index', String(index));

            stamps.forEach((stamp) => {
                stamp.setAttribute('datetime', toIsoDate(placedDate));
                setText(stamp, formatDateStamp(placedDate));
            });

            setText(fragment.querySelector('[data-cell="items"]'), summary);
            setText(fragment.querySelector('[data-cell="summary"]'), summary);
            setText(fragment.querySelector('[data-cell="total"]'), formatPrice(order.totals.totalCents));
            setText(pick, order.id);
            body.append(fragment);
        });

        empty.toggleAttribute('hidden', orders.length > 0);
        ledger.toggleAttribute('hidden', orders.length === 0);
    }

    function renderTotals(summary: CartTotals) {
        const promoCents = summary.promoCents ?? 0;

        const prodsCents = summary.discountCents - promoCents;

        document.querySelector<HTMLElement>('[data-order-discount-row]')?.toggleAttribute('hidden', prodsCents === 0);
        document.querySelector<HTMLElement>('[data-order-promo-row]')?.toggleAttribute('hidden', promoCents === 0);
        setText(document.querySelector('[data-order-discount]'), `\u2212${formatPrice(prodsCents)}`);
        setText(document.querySelector('[data-order-promo]'), `\u2212${formatPrice(promoCents)}`);
        setText(document.querySelector('[data-order-shipping]'), formatPrice(summary.shippingCents));
        setText(document.querySelector('[data-order-subtotal]'), formatPrice(summary.subtotalCents));
        setText(document.querySelector('[data-order-tax]'), formatPrice(summary.taxCents));
        setText(document.querySelector('[data-order-total]'), formatPrice(summary.totalCents));
    }

    function selectOrder(index: number, shouldMoveFocus: boolean) {
        const order = orders[index];

        if (!order) return;

        const isFresh = document.documentElement.dataset.receipt === 'fresh' && order.id === placedId;

        document.querySelectorAll<HTMLElement>('[data-order-index]').forEach((row) => {
            const pick = row.querySelector('[data-cell="id"]');

            if (Number(row.dataset.orderIndex) === index) pick?.setAttribute('aria-current', 'true');
            else pick?.removeAttribute('aria-current');
        });

        renderHeading(order, isFresh);
        renderItems(order);
        renderTotals(order.totals);

        if (!shouldMoveFocus) return;

        document.querySelector<HTMLElement>('[data-order-heading]')?.closest('h1')?.focus();
    }

    function summarizeItems(items: CartItem[]) {
        const counts = new Map<string, number>();

        items.forEach(item => counts.set(item.title, (counts.get(item.title) ?? 0) + item.quantity));

        return Array.from(counts, ([title, quantity]) => `${quantity} \u00d7 ${title}`).join(', ');
    }

    registerPageScript(initOrderHistory);
</script>
