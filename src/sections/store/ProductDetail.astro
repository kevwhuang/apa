---
import { Image } from 'astro:assets';

import IconArrow from '@components/icons/Arrow.astro';
import { COMMERCE } from '@lib/shared/constants';
import { formatPrice } from '@lib/shared/utils';
import { getVariationImage, toVariationSlug, toVariations } from '@lib/commerce/products';

import type { CollectionEntry } from 'astro:content';

interface Props {
    product: CollectionEntry<'products'>['data'];
    slug: string;
}

const FRAME_IMAGE_WIDTH = 620;
const THUMB_IMAGE_WIDTH = 140;

const { product, slug } = Astro.props;

const ceiling = Math.min(product.stock, COMMERCE.maxQuantityPerItem);
const inStock = product.stock > 0;
const swatches = [...product.variations].toSorted((a, b) => a.name.localeCompare(b.name));
const variations = toVariations(product);

const gallery = variations.map(variation => ({ image: getVariationImage(product.sku, variation), variation }));
---

<nav
    class="stage stage--strip border-b-2 border-ink"
    aria-label="Breadcrumb"
>
    <div data-motion="stamp">
        <a
            class="active:translate-y-px hover:text-accent-deep inline-flex items-center min-h-(--control-size) gap-(--space-2xs) font-bold font-mono text-sm tracking-wide uppercase text-ink-muted transition-[color,transform]"
            href="/store"
        >
            <IconArrow left /> All products
        </a>
    </div>
</nav>

<section
    class="stage stage--tight"
    aria-labelledby="product-title"
>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <div
            class="flex flex-col gap-5"
            data-motion="unfold"
        >
            <div class="product-gallery__frame slab slab--bare slab--lift">
                {gallery.map(({ image, variation }) => image && (
                    <Image
                        class:list={['product-gallery__photo', variation === product.base && 'is-current']}
                        alt={`${product.title} \u2014 ${variation}`}
                        data-gallery-photo={variation}
                        densities={[1, 2]}
                        draggable="false"
                        src={image}
                        width={FRAME_IMAGE_WIDTH}
                    />
                ))}
            </div>
            <ul
                class="grid grid-cols-4 gap-4 list-none"
                aria-label="Product views"
                data-gallery-thumbs
            >
                {gallery.map(({ image, variation }) => (
                    <li>
                        <button
                            class="product-gallery__thumb"
                            aria-label={`Show the ${variation} view`}
                            aria-pressed={variation === product.base ? 'true' : 'false'}
                            data-gallery-thumb={variation}
                            type="button"
                        >
                            {image && (
                                <Image
                                    alt=""
                                    densities={[1, 2]}
                                    draggable="false"
                                    src={image}
                                    width={THUMB_IMAGE_WIDTH}
                                />
                            )}
                        </button>
                    </li>
                ))}
            </ul>
        </div>
        <div class="self-start space-y-8 md:sticky md:top-28">
            <div data-motion="rise">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 mb-2">
                    <p class="label text-accent-deep">{product.category}</p>
                    <p
                        class="font-mono text-2xs text-ink-subtle"
                        data-placeholder
                    >
                        SKU-{product.sku}
                    </p>
                </div>
                <h1
                    id="product-title"
                    class="mb-3 font-extrabold font-sans leading-tight text-4xl tracking-[-0.03em] md:text-5xl"
                >
                    {product.title}
                </h1>
                <p
                    class="font-bold font-mono text-2xl"
                    data-placeholder
                >
                    {formatPrice(product.priceCents)}
                </p>
            </div>
            <p
                class="leading-relaxed text-base text-ink-muted"
                data-motion="blur"
            >
                {product.description}
            </p>
            <form
                class="add-form space-y-6"
                data-image={`${product.sku}_${toVariationSlug(product.base)}`}
                data-max={ceiling}
                data-motion="rise"
                data-price-cents={product.priceCents}
                data-slug={slug}
                data-stock={product.stock}
                data-title={product.title}
            >
                <div>
                    <p class="label mb-3 text-ink-muted">
                        Variation / <span data-variation-output>{product.base}</span>
                    </p>
                    <div
                        class="flex flex-wrap gap-4"
                        aria-label="Variation options"
                        role="group"
                    >
                        {swatches.map(variation => (
                            <button
                                class="product__swatch active:border-ink aria-pressed:border-ink hover:border-ink h-10 w-10 border-2 border-ink-muted"
                                aria-label={variation.name}
                                aria-pressed={variation.name === product.base ? 'true' : 'false'}
                                data-image={`${product.sku}_${toVariationSlug(variation.name)}`}
                                data-variation={variation.name}
                                style={`background: ${variation.hex};`}
                                type="button"
                            />
                        ))}
                    </div>
                </div>
                {product.sizes.length > 0 && (
                    <div>
                        <p class="label mb-3 text-ink-muted">Size</p>
                        <div
                            class="flex flex-wrap gap-2"
                            aria-label="Size options"
                            role="group"
                        >
                            {product.sizes.map((size, index) => (
                                <button
                                    class:list={[
                                        'active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse h-(--control-size) min-w-(--control-size) px-3 border-2 border-ink font-bold font-mono text-xs uppercase transition-colors select-none',
                                        index === 0 && 'is-active',
                                    ]}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-size={size}
                                    type="button"
                                >
                                    {size}
                                </button>
                            ))}
                        </div>
                    </div>
                )}
                <div>
                    <p class="label mb-3 text-ink-muted">
                        {inStock && 'Quantity'}
                        {!inStock && (
                            <Fragment>
                                <s>Quantity</s>
                                <span class="text-accent-deep"> / Out of stock</span>
                            </Fragment>
                        )}
                    </p>
                    <div class:list={['inline-flex items-center border-2', inStock ? 'border-ink' : 'border-ink-20 opacity-55']}>
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold text-lg transition-colors"
                            aria-disabled="true"
                            aria-label="Decrease quantity"
                            data-quantity="-1"
                            type="button"
                        >
                            &minus;
                        </button>
                        <span
                            class:list={['w-12 font-bold font-mono text-center select-none', !inStock && 'line-through text-ink-subtle']}
                            aria-live="polite"
                            data-quantity-output
                        >
                            1
                        </span>
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold text-lg transition-colors"
                            aria-disabled={!inStock || ceiling <= 1}
                            aria-label="Increase quantity"
                            data-quantity="+1"
                            type="button"
                        >
                            +
                        </button>
                    </div>
                </div>
                <button
                    class="btn btn--primary w-full"
                    disabled={!inStock}
                    type="submit"
                >
                    {inStock ? 'Add to cart' : 'Sold out'}
                </button>
            </form>
            {product.details.length > 0 && (
                <div
                    class="pt-5 border-t-2 border-ink"
                    data-motion="unfold"
                >
                    <p class="label mb-4 text-ink-muted">Details</p>
                    <ul class="space-y-2 list-none text-smd text-ink-muted">
                        {product.details.map(detail => (
                            <li class="flex gap-3">
                                <span
                                    class="font-bold text-accent-deep"
                                    aria-hidden="true"
                                >
                                    &middot;
                                </span>
                                {detail}
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </div>
    </div>
</section>

<style>
    .product-gallery__frame {
        aspect-ratio: 1;
        background-color: var(--color-surface-sunken);
        margin-bottom: calc(var(--z-lift) * var(--lift));
        overflow: hidden;
        position: relative;
    }

    .product-gallery__photo {
        height: 100%;
        inset: 0;
        object-fit: cover;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity var(--duration-slow) var(--motion-ease-ui);
        width: 100%;
    }

    .product-gallery__photo.is-current {
        opacity: 1;
        pointer-events: auto;
    }

    .product-gallery__thumb {
        aspect-ratio: 1;
        border: 2px solid var(--color-ink-subtle);
        display: block;
        overflow: hidden;
        padding: 0;
        transition:
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 100%;
    }

    .product-gallery__thumb :global(img) {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .product-gallery__thumb:active {
        transform: translateY(1px);
    }

    .product-gallery__thumb:hover {
        border-color: var(--color-accent-deep);
    }

    .product-gallery__thumb[aria-pressed='true'] {
        border-color: var(--color-ink);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-ink);
    }

    .product__swatch {
        transition:
            border-color var(--duration-fast) var(--motion-ease-ui),
            box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .product__swatch[aria-pressed='true'] {
        box-shadow:
            0 0 0 3px var(--color-surface),
            0 0 0 5px var(--color-ink);
    }

    [data-variation] {
        position: relative;
    }

    [data-variation]::after {
        content: '';
        inset: -8px;
        position: absolute;
    }
</style>

<script>
    import { COMMERCE } from '@lib/shared/constants';
    import { add, getItems } from '@lib/commerce/cart';
    import { registerPageScript } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const STORAGE_MESSAGE = 'Nothing was added \u2014 your browser storage is full. Clear some space and try again.';

    let maxQuantity = 1;
    let quantity = 1;
    let stock = 0;

    function applyVariationFromQuery(swatches: NodeListOf<HTMLButtonElement>) {
        const requested = new URLSearchParams(window.location.search).get('variation')?.trim().toLowerCase();

        if (!requested) return;

        const match = Array.from(swatches).find(swatch => swatch.dataset.variation?.toLowerCase() === requested);

        if (!match) return;

        selectVariation(match.dataset.variation ?? '');
    }

    function countInCart(slug: string, variation: string | undefined, size: string | undefined) {
        const line = getItems().find(item => item.productSlug === slug
            && (item.size ?? '') === (size ?? '')
            && (item.variation ?? '') === (variation ?? ''));

        return line?.quantity ?? 0;
    }

    function handleAddSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const pressed = form.querySelector<HTMLButtonElement>('[data-variation][aria-pressed="true"]');

        const image = pressed?.dataset.image ?? form.dataset.image ?? '';
        const size = form.querySelector<HTMLButtonElement>('[data-size][aria-pressed="true"]')?.dataset.size;
        const slug = form.dataset.slug ?? '';
        const title = form.dataset.title ?? '';
        const variation = pressed?.dataset.variation;

        if (countInCart(slug, variation, size) >= maxQuantity) {
            toast(`Already at the maximum \u2014 ${maxQuantity} \u00d7 ${title} is all we can hold for you.`, 'error');

            return;
        }

        const persisted = add({
            image,
            priceCents: Number(form.dataset.priceCents),
            productSlug: slug,
            quantity,
            size,
            title,
            variation,
        }, maxQuantity);

        if (!persisted) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        toast(`${countInCart(slug, variation, size)} \u00d7 ${title} in your cart.`, 'success');
    }

    function handleQuantityClick(step: number, decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        const button = step < 0 ? decrease : increase;

        if (button.getAttribute('aria-disabled') === 'true') return;

        quantity = Math.min(maxQuantity, Math.max(1, quantity + step));
        updateQuantity(decrease, increase, output);

        if (quantity >= maxQuantity && step > 0) toast(limitMessage(), 'info');
    }

    function handleSizeClick(button: HTMLButtonElement, sizeButtons: NodeListOf<HTMLButtonElement>) {
        sizeButtons.forEach((sizeButton) => {
            sizeButton.classList.toggle('is-active', sizeButton === button);
            sizeButton.setAttribute('aria-pressed', String(sizeButton === button));
        });
    }

    function initProductDetail(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.add-form');

        if (!form) return;

        const decrease = form.querySelector<HTMLButtonElement>('[data-quantity="-1"]');
        const increase = form.querySelector<HTMLButtonElement>('[data-quantity="+1"]');
        const quantityOutput = form.querySelector<HTMLElement>('[data-quantity-output]');
        const sizeButtons = form.querySelectorAll<HTMLButtonElement>('[data-size]');
        const swatches = form.querySelectorAll<HTMLButtonElement>('[data-variation]');
        const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

        maxQuantity = Math.max(1, Math.min(Number(form.dataset.max) || 1, COMMERCE.maxQuantityPerItem));
        quantity = 1;
        stock = Number(form.dataset.stock) || 0;

        applyVariationFromQuery(swatches);

        if (decrease && increase && quantityOutput) {
            updateQuantity(decrease, increase, quantityOutput);
            decrease.addEventListener('click', () => handleQuantityClick(-1, decrease, increase, quantityOutput), { signal });
            increase.addEventListener('click', () => handleQuantityClick(1, decrease, increase, quantityOutput), { signal });
        }

        form.addEventListener('submit', event => handleAddSubmit(event, form), { signal });

        sizeButtons.forEach((button) => {
            button.addEventListener('click', () => handleSizeClick(button, sizeButtons), { signal });
        });

        swatches.forEach((button) => {
            button.addEventListener('click', () => selectVariation(button.dataset.variation ?? ''), { signal });
        });

        thumbs.forEach((button) => {
            button.addEventListener('click', () => selectVariation(button.dataset.galleryThumb ?? ''), { signal });
        });
    }

    function limitMessage() {
        return stock > COMMERCE.maxQuantityPerItem ? 'Five per order is the limit.' : 'That\'s all we have.';
    }

    function selectVariation(variation: string) {
        if (!variation) return;

        const output = document.querySelector<HTMLElement>('[data-variation-output]');

        document.querySelectorAll<HTMLElement>('[data-gallery-photo]').forEach((photo) => {
            photo.classList.toggle('is-current', photo.dataset.galleryPhoto === variation);
        });

        document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb) => {
            thumb.setAttribute('aria-pressed', String(thumb.dataset.galleryThumb === variation));
        });

        document.querySelectorAll<HTMLButtonElement>('[data-variation]').forEach((swatch) => {
            swatch.setAttribute('aria-pressed', String(swatch.dataset.variation === variation));
        });

        if (output) output.textContent = variation;
    }

    function updateQuantity(decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        decrease.setAttribute('aria-disabled', String(quantity <= 1));
        increase.setAttribute('aria-disabled', String(quantity >= maxQuantity));
        output.textContent = String(quantity);
    }

    registerPageScript(initProductDetail);
</script>
