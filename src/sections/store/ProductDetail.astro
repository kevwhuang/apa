---
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { COMMERCE, PALETTE } from '@lib/constants';
import { formatPrice, getStockLabel } from '@lib/utils';

import type { CollectionEntry } from 'astro:content';

interface Props {
    product: CollectionEntry<'products'>['data'];
}

const imageColors = PALETTE.slice(0, 3);
const { product } = Astro.props;
const { slug = '' } = Astro.params;

const ceiling = Math.min(product.stock, COMMERCE.maxQuantityPerItem);
const inStock = product.stock > 0;
---

<nav
    class="stage stage--strip border-b-2 border-ink"
    aria-label="Breadcrumb"
>
    <div
        class="label text-ink-muted"
        data-motion="stamp"
    >
        <a
            class="product__crumb hover:text-accent-deep"
            href="/store"
        >
            &larr; All products
        </a>&#32;
        / {product.category}
    </div>
</nav>

<section
    class="stage stage--tight"
    aria-labelledby="product-title"
>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <ul
            class="grid grid-cols-2 gap-8 list-none"
            data-motion-stagger="unfold"
        >
            {product.images.map((_, index) => (
                <li class:list={[index === 0 && 'col-span-2']}>
                    <PlaceholderTile
                        class="slab slab--bare slab--lift aspect-square"
                        color={imageColors[index % imageColors.length]}
                        label={product.title.split(' ')[0]}
                        labelClass="text-[length:14cqi] uppercase text-surface-raised/80"
                    />
                </li>
            ))}
        </ul>
        <div class="self-start space-y-8 md:sticky md:top-28">
            <div data-motion="rise">
                <p class="label mb-2 text-accent-deep">{product.category}</p>
                <h1
                    id="product-title"
                    class="mb-3 font-extrabold font-sans leading-tight text-4xl tracking-[-0.03em] md:text-5xl"
                >
                    {product.title}
                </h1>
                <p
                    class="mb-4 font-bold font-mono text-2xl"
                    data-placeholder
                >
                    {formatPrice(product.priceCents)}
                </p>
                <p
                    class:list={[
                        'label inline-block px-2 py-2',
                        inStock && 'text-ink-muted',
                        !inStock && 'product__sold text-accent-deep',
                    ]}
                    data-placeholder
                >
                    {getStockLabel(product.stock, 'In stock')}
                </p>
            </div>
            <p class="leading-relaxed text-base text-ink-muted">{product.description}</p>
            <form
                class="add-form space-y-6"
                data-image={product.images[0]}
                data-max={ceiling}
                data-price-cents={product.priceCents}
                data-slug={slug}
                data-stock={product.stock}
                data-title={product.title}
            >
                {product.colors.length > 0 && (
                    <div>
                        <p class="label mb-3 text-ink-muted">
                            Color / <span data-color-output>{product.colors[0].name}</span>
                        </p>
                        <div
                            class="flex gap-4"
                            aria-label="Color options"
                            role="group"
                        >
                            {product.colors.map((color, index) => (
                                <button
                                    class="product__swatch active:border-ink aria-pressed:border-ink hover:border-ink h-10 w-10 border-2 border-ink-muted"
                                    aria-label={color.name}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-color={color.name}
                                    style={`background: ${color.hex};`}
                                    type="button"
                                />
                            ))}
                        </div>
                    </div>
                )}
                {product.sizes.length > 0 && (
                    <div>
                        <p class="label mb-3 text-ink-muted">Size</p>
                        <div
                            class="flex flex-wrap gap-2"
                            aria-label="Size options"
                            role="group"
                        >
                            {product.sizes.map((size, index) => (
                                <button
                                    class:list={[
                                        'active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse h-(--control-size) min-w-(--control-size) px-3 border-2 border-ink font-bold font-mono text-xs uppercase transition-colors',
                                        index === 0 && 'is-active',
                                    ]}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-size={size}
                                    type="button"
                                >
                                    {size}
                                </button>
                            ))}
                        </div>
                    </div>
                )}
                <div>
                    <p class="label mb-3 text-ink-muted">Quantity</p>
                    <div class="inline-flex items-center border-2 border-ink">
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold text-lg transition-colors"
                            aria-disabled="true"
                            aria-label="Decrease quantity"
                            data-quantity="-1"
                            type="button"
                        >
                            &minus;
                        </button>
                        <span
                            class="w-12 font-bold font-mono text-center"
                            aria-live="polite"
                            data-quantity-output
                        >
                            1
                        </span>
                        <button
                            class="active:bg-ink active:text-ink-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-ink aria-disabled:hover:bg-transparent aria-disabled:opacity-55 hover:bg-surface-sunken h-(--control-size) w-(--control-size) font-bold text-lg transition-colors"
                            aria-disabled={!inStock || ceiling <= 1}
                            aria-label="Increase quantity"
                            data-quantity="+1"
                            type="button"
                        >
                            +
                        </button>
                    </div>
                </div>
                <button
                    class="btn btn--primary w-full"
                    disabled={!inStock}
                    type="submit"
                >
                    {inStock ? 'Add to cart' : 'Sold out'}
                </button>
            </form>
            {product.details.length > 0 && (
                <details class="product__details open:gap-3 flex flex-col pt-4 border-t-2 border-ink">
                    <summary class="label product__summary hover:text-accent-deep flex items-center min-h-(--control-size) cursor-pointer select-none">
                        Details
                        <span
                            class="action-text product__sign ml-auto"
                            aria-hidden="true"
                        >
                            +
                        </span>
                    </summary>
                    <ul class="space-y-1 text-sm text-ink-muted">
                        {product.details.map(detail => (
                            <li class="flex gap-2">
                                <span
                                    class="font-bold text-accent-deep"
                                    aria-hidden="true"
                                >
                                    &middot;
                                </span>
                                {detail}
                            </li>
                        ))}
                    </ul>
                </details>
            )}
        </div>
    </div>
</section>

<style>
    .product__crumb {
        align-items: center;
        display: inline-flex;
        min-height: var(--control-size);
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .product__crumb:active {
        transform: translateY(1px);
    }

    .product__details[open] .product__sign {
        rotate: 45deg;
    }

    .product__sold {
        background-image: repeating-linear-gradient(135deg, var(--color-ink-10) 0 4px, transparent 4px 8px);
    }

    .product__summary {
        list-style: none;
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .product__summary::marker {
        content: none;
    }

    .product__summary:active {
        transform: translateY(1px);
    }

    .product__swatch {
        transition: border-color var(--duration-fast) var(--motion-ease-ui), box-shadow var(--duration-fast) var(--motion-ease-ui);
    }

    .product__swatch[aria-pressed='true'] {
        box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 5px var(--color-ink);
    }

    [data-color] {
        position: relative;
    }

    [data-color]::after {
        content: '';
        inset: -8px;
        position: absolute;
    }
</style>

<script>
    import { COMMERCE } from '@lib/constants';
    import { add, getItems } from '@lib/commerce/cart';
    import { registerPageScript } from '@lib/utils';
    import { toast } from '@lib/ui/toasts';

    let maxQuantity = 1;
    let quantity = 1;
    let stock = 0;

    function countInCart(slug: string, color: string | undefined, size: string | undefined) {
        const line = getItems().find(item => item.productSlug === slug
            && (item.color ?? '') === (color ?? '')
            && (item.size ?? '') === (size ?? ''));

        return line?.quantity ?? 0;
    }

    function handleAddSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const color = form.querySelector<HTMLButtonElement>('[data-color][aria-pressed="true"]')?.dataset.color;
        const size = form.querySelector<HTMLButtonElement>('[data-size][aria-pressed="true"]')?.dataset.size;
        const slug = form.dataset.slug ?? '';
        const title = form.dataset.title ?? '';

        if (countInCart(slug, color, size) >= maxQuantity) {
            toast(`Already at the maximum \u2014 ${maxQuantity} \u00d7 ${title} is all we can hold for you.`, 'error');

            return;
        }

        add({
            color,
            image: form.dataset.image ?? '',
            priceCents: Number(form.dataset.priceCents),
            productSlug: slug,
            quantity,
            size,
            title,
        }, maxQuantity);

        toast(`${countInCart(slug, color, size)} \u00d7 ${title} in your cart.`, 'success');
    }

    function handleColorClick(button: HTMLButtonElement, swatches: NodeListOf<HTMLButtonElement>, output: HTMLElement | null) {
        swatches.forEach((swatch) => {
            swatch.setAttribute('aria-pressed', String(swatch === button));
        });

        if (output) output.textContent = button.dataset.color ?? '';
    }

    function handleQuantityClick(step: number, decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        const button = step < 0 ? decrease : increase;

        if (button.getAttribute('aria-disabled') === 'true') return;

        quantity = Math.min(maxQuantity, Math.max(1, quantity + step));
        updateQuantity(decrease, increase, output);

        if (step > 0 && quantity >= maxQuantity) toast(limitMessage(), 'info');
    }

    function handleSizeClick(button: HTMLButtonElement, sizeButtons: NodeListOf<HTMLButtonElement>) {
        sizeButtons.forEach((sizeButton) => {
            sizeButton.classList.toggle('is-active', sizeButton === button);
            sizeButton.setAttribute('aria-pressed', String(sizeButton === button));
        });
    }

    function initProductDetail(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.add-form');

        if (!form) return;

        const colorOutput = form.querySelector<HTMLElement>('[data-color-output]');
        const decrease = form.querySelector<HTMLButtonElement>('[data-quantity="-1"]');
        const increase = form.querySelector<HTMLButtonElement>('[data-quantity="+1"]');
        const quantityOutput = form.querySelector<HTMLElement>('[data-quantity-output]');
        const sizeButtons = form.querySelectorAll<HTMLButtonElement>('[data-size]');
        const swatches = form.querySelectorAll<HTMLButtonElement>('[data-color]');

        maxQuantity = Math.max(1, Math.min(Number(form.dataset.max) || 1, COMMERCE.maxQuantityPerItem));
        quantity = 1;
        stock = Number(form.dataset.stock) || 0;

        if (decrease && increase && quantityOutput) {
            updateQuantity(decrease, increase, quantityOutput);
            decrease.addEventListener('click', () => handleQuantityClick(-1, decrease, increase, quantityOutput), { signal });
            increase.addEventListener('click', () => handleQuantityClick(1, decrease, increase, quantityOutput), { signal });
        }

        form.addEventListener('submit', event => handleAddSubmit(event, form), { signal });

        sizeButtons.forEach((button) => {
            button.addEventListener('click', () => handleSizeClick(button, sizeButtons), { signal });
        });

        swatches.forEach((button) => {
            button.addEventListener('click', () => handleColorClick(button, swatches, colorOutput), { signal });
        });
    }

    function limitMessage() {
        return stock > COMMERCE.maxQuantityPerItem ? 'Ten per order is the limit.' : 'That\u2019s all we have.';
    }

    function updateQuantity(decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        decrease.setAttribute('aria-disabled', String(quantity <= 1));
        increase.setAttribute('aria-disabled', String(quantity >= maxQuantity));
        output.textContent = String(quantity);
    }

    registerPageScript(initProductDetail);
</script>
