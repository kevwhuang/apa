---
import { Image } from 'astro:assets';

import BackLink from '@components/shared/BackLink.astro';
import { COMMERCE } from '@lib/shared/constants';
import { formatPrice, formatSku, getStockLabel } from '@lib/shared/utils';
import { getBaseVariation, getVariationImage, getVariationPrice, toImageKey } from '@lib/commerce/products';

import type { CollectionEntry } from 'astro:content';

interface Props {
    product: CollectionEntry<'products'>['data'];
    slug: string;
}

const FRAME_IMAGE_WIDTH = 620;
const THUMB_IMAGE_WIDTH = 140;

const { product, slug } = Astro.props;

const baseVariation = getBaseVariation(product);
const ceiling = Math.min(product.stock, COMMERCE.maxQuantityPerItem);
const gallery = product.variations.map(variation => ({ image: getVariationImage(variation), variation: variation.name }));
const isInStock = product.stock > 0;

const priceCents = getVariationPrice(product, baseVariation);
---

<BackLink
    href="/store"
    label="Back to store"
/>

<section
    class="stage stage--tight"
    aria-labelledby="product-title"
>
    <div class="grid grid-cols-2 gap-12 max-md:grid-cols-1">
        <div
            class="flex flex-col gap-5"
            data-motion="unfold"
        >
            <div class="product-gallery__frame slab slab--bare slab--lift">
                {gallery.map(({ image, variation }) => image && (
                    <Image
                        class:list={['product-gallery__photo absolute inset-0 object-cover size-full opacity-0 pointer-events-none', variation === product.base && 'is-current']}
                        alt={`${product.title}, ${variation}`}
                        data-gallery-photo={variation}
                        decoding="sync"
                        densities={[1, 2]}
                        draggable="false"
                        src={image}
                        width={FRAME_IMAGE_WIDTH}
                    />
                ))}
                {getStockLabel(product.stock) && (
                    <span
                        class="absolute left-0 top-0 p-(--space-xs) border-b-2 border-border-strong border-r-2 font-mono leading-none text-base tracking-[0.06em] uppercase bg-bg-page text-text"
                        data-placeholder
                    >
                        {getStockLabel(product.stock)}
                    </span>
                )}
            </div>
            <ul
                class="product-gallery__thumbs grid grid-cols-5 list-none"
                aria-label="Product views"
                data-gallery-thumbs
            >
                {gallery.map(({ image, variation }) => (
                    <li>
                        <button
                            class="product-gallery__thumb block relative aspect-square w-full p-0 border-2 border-border"
                            aria-label={`Show ${variation} view`}
                            aria-pressed={variation === product.base ? 'true' : 'false'}
                            data-gallery-thumb={variation}
                            type="button"
                        >
                            {image && (
                                <Image
                                    class="product-gallery__thumb-image"
                                    alt=""
                                    densities={[1, 2]}
                                    draggable="false"
                                    src={image}
                                    width={THUMB_IMAGE_WIDTH}
                                />
                            )}
                        </button>
                    </li>
                ))}
            </ul>
        </div>
        <div class="self-start sticky top-28 space-y-8 max-md:static">
            <div>
                <h1
                    id="product-title"
                    class="mb-3 text-4xl text-balance max-lg:text-3xl"
                    data-motion="strike"
                >
                    {product.title}
                </h1>
                <p
                    class="font-mono text-2xl"
                    data-motion="rise"
                    data-placeholder
                    data-price-output
                >
                    {formatPrice(priceCents)}
                </p>
            </div>
            <p
                class="text-lg text-text-secondary"
                data-motion="blur"
            >
                {product.description}
            </p>
            <form
                class="add-form space-y-6"
                data-image={toImageKey(baseVariation)}
                data-max={ceiling}
                data-motion="rise"
                data-price-cents={priceCents}
                data-sku={baseVariation.sku}
                data-slug={slug}
                data-stock={product.stock}
                data-title={product.title}
            >
                <div>
                    <p class="label mb-3 text-text-secondary">
                        Variation / <span data-variation-output>{product.base}</span>
                    </p>
                    <div
                        class="flex flex-wrap gap-4"
                        aria-label="Variation options"
                        role="group"
                    >
                        {product.variations.map(variation => (
                            <button
                                class="product__swatch active:border-border-strong aria-pressed:border-border-strong hover:border-border-strong h-10 w-10 border-2 border-border"
                                aria-label={variation.name}
                                aria-pressed={variation.name === product.base ? 'true' : 'false'}
                                data-image={toImageKey(variation)}
                                data-price-cents={getVariationPrice(product, variation)}
                                data-price-label={formatPrice(getVariationPrice(product, variation))}
                                data-sku={variation.sku}
                                data-sku-label={formatSku(variation.sku)}
                                data-variation={variation.name}
                                style={`background: ${variation.hex};`}
                                type="button"
                            />
                        ))}
                    </div>
                </div>
                {product.sizes.length > 0 && (
                    <div>
                        <p class="label mb-3 text-text-secondary">Size</p>
                        <div
                            class="flex flex-wrap gap-2"
                            aria-label="Size options"
                            role="group"
                        >
                            {product.sizes.map((size, index) => (
                                <button
                                    class:list={[
                                        'chip hover:bg-bg-hover h-(--control-size) min-w-(--control-size)',
                                        index === 0 && 'is-active',
                                    ]}
                                    aria-pressed={index === 0 ? 'true' : 'false'}
                                    data-size={size}
                                    type="button"
                                >
                                    {size}
                                </button>
                            ))}
                        </div>
                    </div>
                )}
                <div>
                    <p class="label mb-3 text-text-secondary">
                        {isInStock && 'Quantity'}
                        {!isInStock && (
                            <Fragment>
                                <s>Quantity</s>
                                <span class="text-link"> (out of stock)</span>
                            </Fragment>
                        )}
                    </p>
                    <div class:list={['inline-flex items-center border-2', isInStock ? 'border-border-strong' : 'border-border-disabled text-text-disabled']}>
                        <button
                            class="active:bg-bg-inverse active:text-text-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-text-disabled aria-disabled:hover:bg-transparent aria-disabled:text-text-disabled hover:bg-bg-hover h-(--control-size) w-(--control-size) font-bold font-mono text-lg"
                            aria-disabled="true"
                            aria-label="Decrease quantity"
                            data-quantity="-1"
                            type="button"
                        >
                            &minus;
                        </button>
                        <span
                            class:list={['w-12 font-bold font-mono', !isInStock && 'line-through', 'text-center', !isInStock && 'text-text-secondary', 'select-none']}
                            aria-live="polite"
                            data-quantity-output
                        >
                            1
                        </span>
                        <button
                            class="active:bg-bg-inverse active:text-text-inverse aria-disabled:active:bg-transparent aria-disabled:active:text-text-disabled aria-disabled:hover:bg-transparent aria-disabled:text-text-disabled hover:bg-bg-hover h-(--control-size) w-(--control-size) font-bold font-mono text-lg"
                            aria-disabled={!isInStock || ceiling <= 1}
                            aria-label="Increase quantity"
                            data-quantity="+1"
                            type="button"
                        >
                            +
                        </button>
                    </div>
                </div>
                <button
                    class="btn btn--primary w-full"
                    disabled={!isInStock}
                    type="submit"
                >
                    {isInStock ? 'Add to cart' : 'Sold out'}
                </button>
            </form>
            <div
                class="flex flex-col gap-4 pt-5 border-border-strong border-t-2"
                data-motion="unfold"
            >
                <p class="label text-text-secondary">Details</p>
                {product.details.length > 0 && (
                    <ul class="space-y-2 list-none text-text-secondary">
                        {product.details.map(detail => (
                            <li class="flex gap-3">
                                <span
                                    class="font-bold text-text-brand"
                                    aria-hidden="true"
                                >
                                    &middot;
                                </span>
                                {detail}
                            </li>
                        ))}
                    </ul>
                )}
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 font-mono text-sm text-text-secondary">
                    <p class="first-letter:uppercase">{product.category}</p>
                    <p
                        data-placeholder
                        data-sku-output
                    >
                        {formatSku(baseVariation.sku)}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script
    data-astro-rerun
    is:inline
>
    function initVariationQuery() {
        const requested = new URLSearchParams(globalThis.location.search).get('variation')?.trim().toLowerCase();
        const swatches = Array.from(document.querySelectorAll('[data-variation]'));

        const match = requested ? swatches.find(swatch => swatch.dataset.variation.toLowerCase() === requested) : undefined;

        if (!match) return;

        const variation = match.dataset.variation;

        document.querySelectorAll('[data-gallery-photo]').forEach((photo) => {
            photo.classList.toggle('is-current', photo.dataset.galleryPhoto === variation);
        });

        document.querySelectorAll('[data-gallery-thumb]').forEach((thumb) => {
            thumb.setAttribute('aria-pressed', String(thumb.dataset.galleryThumb === variation));
        });

        swatches.forEach((swatch) => {
            swatch.setAttribute('aria-pressed', String(swatch === match));
        });

        document.querySelector('[data-price-output]').textContent = match.dataset.priceLabel;
        document.querySelector('[data-sku-output]').textContent = match.dataset.skuLabel;
        document.querySelector('[data-variation-output]').textContent = variation;
    }

    initVariationQuery();
</script>

<style>
    .product-gallery__frame {
        aspect-ratio: 1;
        background-color: var(--color-bg-sunken);
        margin-bottom: var(--lift);
        overflow: hidden;
        position: relative;
    }

    .product-gallery__photo.is-current {
        opacity: 1;
        pointer-events: auto;
    }

    .product-gallery__thumb {
        transition: transform var(--duration-fast) var(--motion-ease-ui);
    }

    .product-gallery__thumb:active {
        transform: translateY(1px);
    }

    .product-gallery__thumb:hover {
        border-color: var(--color-link);
    }

    .product-gallery__thumb::after {
        content: '';
        inset: min(0px, calc(50% - var(--control-size) / 2));
        position: absolute;
    }

    .product-gallery__thumb[aria-pressed='true'] {
        border-color: var(--color-border-strong);
        box-shadow: var(--lift) var(--lift) 0 0 var(--color-border-strong);
    }

    .product-gallery__thumb-image {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .product-gallery__thumbs {
        gap: calc(var(--lift) + var(--space-xs));
    }

    .product__swatch[aria-pressed='true'] {
        box-shadow:
            0 0 0 3px var(--color-bg-page),
            0 0 0 5px var(--color-border-strong);
    }

    [data-variation] {
        position: relative;
    }

    [data-variation]::after {
        content: '';
        inset: -8px;
        position: absolute;
    }
</style>

<script>
    import { COMMERCE } from '@lib/shared/constants';
    import { add, getItems } from '@lib/commerce/cart';
    import { registerPageScript } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    const STORAGE_MESSAGE = 'Nothing was added because your browser storage is full. Clear some space and try again.';

    let maxQuantity = 1;
    let quantity = 1;
    let stock = 0;

    function countInCart(slug: string, variation: string | undefined, size: string | undefined) {
        const line = getItems().find(item => (item.size ?? '') === (size ?? '')
            && (item.variation ?? '') === (variation ?? '')
            && item.productSlug === slug);

        return line?.quantity ?? 0;
    }

    function getLimitMessage() {
        return stock > COMMERCE.maxQuantityPerItem ? 'Five per order is the limit.' : 'That\'s all we have.';
    }

    function handleAddSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const pressed = form.querySelector<HTMLButtonElement>('[data-variation][aria-pressed="true"]');
        const size = form.querySelector<HTMLButtonElement>('[data-size][aria-pressed="true"]')?.dataset.size;
        const slug = form.dataset.slug ?? '';
        const title = form.dataset.title ?? '';

        const image = pressed?.dataset.image ?? form.dataset.image ?? '';
        const priceCents = Number(pressed?.dataset.priceCents ?? form.dataset.priceCents);
        const sku = pressed?.dataset.sku ?? form.dataset.sku ?? '';
        const variation = pressed?.dataset.variation;

        if (countInCart(slug, variation, size) >= maxQuantity) {
            toast(`Already at the maximum. ${maxQuantity} \u00d7 ${title} is the limit per order.`, 'error');

            return;
        }

        const persisted = add({
            image,
            priceCents,
            productSlug: slug,
            quantity,
            size,
            sku,
            title,
            variation,
        }, maxQuantity);

        if (!persisted) {
            toast(STORAGE_MESSAGE, 'error');

            return;
        }

        toast(`${countInCart(slug, variation, size)} \u00d7 ${title} in your cart.`, 'success');
    }

    function handleQuantityClick(step: number, decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        const button = step < 0 ? decrease : increase;

        if (button.getAttribute('aria-disabled') === 'true') return;

        quantity = Math.min(maxQuantity, Math.max(1, quantity + step));
        updateQuantity(decrease, increase, output);

        if (quantity >= maxQuantity && step > 0) toast(getLimitMessage(), 'info');
    }

    function handleSizeClick(button: HTMLButtonElement, sizeButtons: NodeListOf<HTMLButtonElement>) {
        sizeButtons.forEach((sizeButton) => {
            const isActive = sizeButton === button;

            if (sizeButton.classList.contains('is-active') === isActive) return;

            sizeButton.classList.toggle('is-active', isActive);
            sizeButton.setAttribute('aria-pressed', String(isActive));
        });
    }

    function initProductDetail(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.add-form');

        if (!form) return;

        const decrease = form.querySelector<HTMLButtonElement>('[data-quantity="-1"]');
        const increase = form.querySelector<HTMLButtonElement>('[data-quantity="+1"]');
        const quantityOutput = form.querySelector<HTMLElement>('[data-quantity-output]');
        const sizeButtons = form.querySelectorAll<HTMLButtonElement>('[data-size]');
        const swatches = form.querySelectorAll<HTMLButtonElement>('[data-variation]');
        const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

        maxQuantity = Math.max(1, Math.min(Number(form.dataset.max) || 1, COMMERCE.maxQuantityPerItem));
        quantity = 1;
        stock = Number(form.dataset.stock) || 0;

        if (decrease && increase && quantityOutput) {
            updateQuantity(decrease, increase, quantityOutput);
            decrease.addEventListener('click', () => handleQuantityClick(-1, decrease, increase, quantityOutput), { signal });
            increase.addEventListener('click', () => handleQuantityClick(1, decrease, increase, quantityOutput), { signal });
        }

        form.addEventListener('submit', event => handleAddSubmit(event, form), { signal });

        sizeButtons.forEach((button) => {
            button.addEventListener('click', () => handleSizeClick(button, sizeButtons), { signal });
        });

        swatches.forEach((button) => {
            button.addEventListener('click', () => selectVariation(button.dataset.variation ?? ''), { signal });
        });

        thumbs.forEach((button) => {
            button.addEventListener('click', () => selectVariation(button.dataset.galleryThumb ?? ''), { signal });
        });
    }

    function selectVariation(variation: string) {
        if (!variation) return;

        const output = document.querySelector<HTMLElement>('[data-variation-output]');
        const priceOutput = document.querySelector<HTMLElement>('[data-price-output]');
        const skuOutput = document.querySelector<HTMLElement>('[data-sku-output]');

        document.querySelectorAll<HTMLElement>('[data-gallery-photo]').forEach((photo) => {
            photo.classList.toggle('is-current', photo.dataset.galleryPhoto === variation);
        });

        document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb) => {
            thumb.setAttribute('aria-pressed', String(thumb.dataset.galleryThumb === variation));
        });

        document.querySelectorAll<HTMLButtonElement>('[data-variation]').forEach((swatch) => {
            const isSelected = swatch.dataset.variation === variation;

            swatch.setAttribute('aria-pressed', String(isSelected));

            if (isSelected && priceOutput && swatch.dataset.priceLabel) priceOutput.textContent = swatch.dataset.priceLabel;
            if (isSelected && skuOutput && swatch.dataset.skuLabel) skuOutput.textContent = swatch.dataset.skuLabel;
        });

        if (output) output.textContent = variation;
    }

    function updateQuantity(decrease: HTMLButtonElement, increase: HTMLButtonElement, output: HTMLElement) {
        decrease.setAttribute('aria-disabled', String(quantity <= 1));
        increase.setAttribute('aria-disabled', String(quantity >= maxQuantity));
        output.textContent = String(quantity);
    }

    registerPageScript(initProductDetail);
</script>
