---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { PALETTE, PRODUCT_CATEGORIES } from '@lib/constants';
import { formatPrice, getStockLabel } from '@lib/utils';

const CATEGORIES = ['all', ...PRODUCT_CATEGORIES] as const;

const cardColors = PALETTE.slice(0, 6);
const products = await getCollection('products');
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="store-title"
>
    <div>
        <PageHead
            class="mb-6 font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow={`Store / ${products.length} items`}
            headingId="store-title"
        >
            Wear the alliance.
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lmd text-ink-muted"
            data-motion="blur"
        >
            Every order goes back into the calendar &mdash; room hire, gear for the Bash, and
            keeping Assembly free to attend. Runs are small and printed in Austin; collect at
            the next Assembly or have it shipped.
        </p>
        <div
            class="flex flex-wrap gap-2 mb-6"
            aria-label="Filter by category"
            data-motion="rise"
            role="group"
        >
            {CATEGORIES.map((category, index) => (
                <button
                    class:list={[
                        'category-btn chip store__chip active:bg-ink active:text-ink-inverse hover:bg-ink hover:text-ink-inverse',
                        { 'is-active': index === 0 },
                    ]}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-category={category}
                    type="button"
                >
                    {category}
                </button>
            ))}
        </div>
        <p
            class="label text-ink-subtle"
            aria-live="polite"
            data-store-status
        >
            Showing all {products.length} products.
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="products-title"
>
    <h2
        id="products-title"
        class="sr-only"
    >
        Products
    </h2>
    <ul
        class="rank rank--4 store__grid list-none"
        data-motion-from="center"
        data-motion-stagger="flip"
    >
        {products.map((product, index) => (
            <li
                class="product-card"
                data-category={product.data.category}
            >
                <a href={`/store/${product.id}`}>
                    <PlaceholderTile
                        class="slab slab--bare slab--card slab--hover aspect-square mb-4"
                        color={cardColors[index % cardColors.length]}
                        label={product.data.title.split(' ')[0]}
                        labelClass="text-lg tracking-tight uppercase text-surface-raised/80 md:text-2xl"
                    >
                        {getStockLabel(product.data.stock) && (
                            <p
                                class="label store__flag absolute px-2 py-1 bg-ink text-ink-inverse"
                                data-placeholder
                            >
                                {getStockLabel(product.data.stock)}
                            </p>
                        )}
                    </PlaceholderTile>
                    <p class="label mb-1 text-ink-muted">
                        {product.data.category}
                    </p>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                        <h3 class="min-w-0 font-bold font-sans tracking-tight">
                            {product.data.title}
                        </h3>
                        <p
                            class="shrink-0 font-bold font-mono text-sm whitespace-nowrap"
                            data-placeholder
                        >
                            {formatPrice(product.data.priceCents)}
                        </p>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</section>

<style>
    .product-card:not(.hidden),
    .product-card > a {
        display: grid;
        grid-row: span 3;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .product-card:not(.hidden) {
        padding-bottom: var(--space-lg);
    }

    .product-card > a:focus-visible :global(.slab) {
        box-shadow: none;
    }

    .store__chip {
        height: var(--control-size);
    }

    .store__flag {
        left: 0;
        top: 0;
    }

    .store__grid {
        grid-auto-rows: auto;
        margin-bottom: calc(-1 * var(--space-lg));
        row-gap: 0;
    }

    @media (max-width: 1024px) {
        .store__grid {
            --rank-cols: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<script>
    import { initFilterGroup, registerPageScript } from '@lib/utils';

    function initStoreGrid(signal: AbortSignal) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
        const cards = document.querySelectorAll<HTMLElement>('.product-card');

        if (!buttons.length || !cards.length) return;

        initFilterGroup({
            buttons,
            cards,
            dataKey: 'category',
            initial: 'all',
            matches: (card, category) => category === 'all' || card.dataset.category === category,
            signal,
            status: (shown, total, category) => (category === 'all' ? `Showing all ${total} products.` : `Showing ${shown} of ${total} products.`),
            statusElement: document.querySelector<HTMLElement>('[data-store-status]'),
        });
    }

    registerPageScript(initStoreGrid);
</script>
