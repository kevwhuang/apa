---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import { PRODUCT_CATEGORIES } from '@lib/shared/constants';
import { formatPrice, getStockLabel } from '@lib/shared/utils';
import { getBaseVariation, getVariationImage, getVariationPrice } from '@lib/commerce/products';

const CARD_IMAGE_WIDTH = 420;

const products = (await getCollection('products')).toSorted((a, b) => a.data.sku.localeCompare(b.data.sku));

const cards = products.map(product => ({
    isInStock: product.data.stock > 0,
    photos: product.data.variations.map(variation => ({ image: getVariationImage(variation), isBase: variation.name === product.data.base })),
    priceCents: getVariationPrice(product.data, getBaseVariation(product.data)),
    product,
    swatches: product.data.variations.map(variation => variation.hex),
}));

const categories = PRODUCT_CATEGORIES.filter(category => products.some(product => product.data.category === category));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="store-title"
>
    <div>
        <PageHead
            class="mb-6 text-7xl max-md:text-4xl"
            headingId="store-title"
        >
            Wear the Alliance
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lg text-text-secondary"
            data-motion="blur"
        >
            Every order helps pay for room hire, gear for the Bash, and keeping Assembly free to
            attend. Runs are small and printed in Austin. Orders placed at least two weeks before
            the next Assembly are brought there for pickup.
        </p>
        <div
            class="flex flex-wrap gap-3 mb-6"
            aria-label="Filter by category"
            data-motion="rise"
            role="group"
        >
            <button
                class="category-btn chip is-active hover:bg-bg-hover h-(--control-size)"
                aria-pressed="true"
                data-category=""
                type="button"
            >
                All
            </button>
            {categories.map(category => (
                <button
                    class="category-btn chip hover:bg-bg-hover h-(--control-size)"
                    aria-pressed="false"
                    data-category={category}
                    type="button"
                >
                    {category}
                </button>
            ))}
        </div>
        <p
            class="label text-text-secondary"
            aria-live="polite"
            data-motion="stamp"
            data-store-status
        >
            Showing all {products.length} products
        </p>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-labelledby="products-title"
>
    <h2
        id="products-title"
        class="sr-only"
    >
        Products
    </h2>
    <ul
        class="store__grid list-none"
        data-motion-stagger="flip"
    >
        {cards.map(({ isInStock, photos, priceCents, product, swatches }) => (
            <li
                class="product-card"
                data-category={product.data.category}
            >
                <a
                    class:list={['product-card__link slab slab--bare slab--card', isInStock && 'slab--still']}
                    aria-disabled={isInStock ? undefined : 'true'}
                    data-product-link
                    href={`/store/${product.data.sku}`}
                >
                    <span
                        class="product-card__frame block overflow-hidden relative aspect-square border-b-2 border-border-strong bg-bg-sunken"
                        data-product-frame={isInStock && photos.length > 1 ? 'loop' : undefined}
                    >
                        {photos.map(({ image, isBase }) => image && (
                            <Image
                                class:list={['product-card__photo', isBase && 'is-current']}
                                alt=""
                                data-product-photo={isBase ? 'base' : undefined}
                                densities={[1, 2]}
                                src={image}
                                width={CARD_IMAGE_WIDTH}
                            />
                        ))}
                        {getStockLabel(product.data.stock) && (
                            <span
                                class="absolute left-0 top-0 p-(--space-xs) border-b-2 border-border-strong border-r-2 font-mono leading-none text-base tracking-[0.06em] uppercase bg-bg-page text-text"
                                data-placeholder
                            >
                                {getStockLabel(product.data.stock)}
                            </span>
                        )}
                    </span>
                    <span class="block pb-(--space-2xs) pt-(--space-md) px-(--space-md)">
                        <span class="flex flex-wrap items-center justify-between gap-x-4 mb-2">
                            <span class="label text-text-secondary">
                                {product.data.category}
                            </span>
                            {swatches.length > 1 && (
                                <span
                                    class="flex gap-1.5"
                                    aria-label={`${swatches.length} variations`}
                                    data-placeholder
                                    role="img"
                                >
                                    {swatches.map(hex => (
                                        <span
                                            class="size-3.5 border-2 border-border"
                                            style={`background: ${hex};`}
                                        />
                                    ))}
                                </span>
                            )}
                        </span>
                        <span class="block font-bold font-sans text-xl tracking-tight">
                            {product.data.title}
                        </span>
                    </span>
                    <span
                        class="block pb-(--space-md) px-(--space-md) font-mono text-lg"
                        data-placeholder
                    >
                        {formatPrice(priceCents)}
                    </span>
                </a>
            </li>
        ))}
    </ul>
</section>

<style>
    .product-card:not(.hidden) {
        padding-bottom: var(--space-2xl);
    }

    .product-card:not(.hidden),
    .product-card__link {
        display: grid;
        grid-row: span 3;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: subgrid;
    }

    .product-card__photo {
        height: 100%;
        inset: 0;
        object-fit: cover;
        opacity: 0;
        position: absolute;
        transition: opacity var(--duration-slow) var(--motion-ease-ui);
        width: 100%;
    }

    .product-card__photo.is-current {
        opacity: 1;
    }

    .store__grid {
        column-gap: var(--space-lg);
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: calc(-1 * var(--space-2xl));
        row-gap: 0;
    }

    .store__grid > * {
        min-width: 0;
    }

    @media (max-width: 1024px) {
        .store__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .store__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { REDUCED_MOTION_QUERY } from '@lib/shared/constants';
    import { initFilterGroup, registerPageScript } from '@lib/shared/utils';
    import { isValidationBypassed } from '@lib/ui/forms';

    const HOVER_QUERY = '(hover: hover)';
    const SLIDESHOW_INTERVAL_MILLISECONDS = 1_000;

    let slideshowTimer: Timer | undefined;

    function advanceSlideshow(frame: HTMLElement) {
        const photos = Array.from(frame.querySelectorAll<HTMLElement>('.product-card__photo'));

        const current = Math.max(0, photos.findIndex(photo => photo.classList.contains('is-current')));

        photos[current]?.classList.remove('is-current');
        photos[(current + 1) % photos.length]?.classList.add('is-current');
    }

    function handleDisabledClick(event: Event) {
        if (isValidationBypassed()) return;

        event.preventDefault();
    }

    function handleLinkEnter(frame: HTMLElement) {
        if (!window.matchMedia(HOVER_QUERY).matches || window.matchMedia(REDUCED_MOTION_QUERY).matches) return;

        clearInterval(slideshowTimer);
        slideshowTimer = setInterval(() => advanceSlideshow(frame), SLIDESHOW_INTERVAL_MILLISECONDS);
    }

    function handleLinkLeave(frame: HTMLElement) {
        clearInterval(slideshowTimer);

        frame.querySelectorAll<HTMLElement>('.product-card__photo').forEach((photo) => {
            photo.classList.toggle('is-current', photo.dataset.productPhoto === 'base');
        });

        slideshowTimer = undefined;
    }

    function initStoreGrid(signal: AbortSignal) {
        const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
        const cards = document.querySelectorAll<HTMLElement>('.product-card');

        if (!buttons.length || !cards.length) return;

        initFilterGroup({
            cards,
            filters: [
                {
                    buttons,
                    dataKey: 'category',
                    matches: (card, active) => active.has(card.dataset.category ?? ''),
                },
            ],
            signal,
            status: (shown, total, isFiltered) => (isFiltered ? `Showing ${shown} of ${total} products` : `Showing all ${total} products`),
            statusElement: document.querySelector<HTMLElement>('[data-store-status]'),
        });

        signal.addEventListener('abort', () => clearInterval(slideshowTimer), { once: true });

        document.querySelectorAll<HTMLAnchorElement>('[data-product-link]').forEach((link) => {
            const frame = link.querySelector<HTMLElement>('[data-product-frame="loop"]');

            if (link.getAttribute('aria-disabled') === 'true') link.addEventListener('click', handleDisabledClick, { signal });

            if (!frame) return;

            link.addEventListener('pointerenter', () => handleLinkEnter(frame), { signal });
            link.addEventListener('pointerleave', () => handleLinkLeave(frame), { signal });
        });
    }

    registerPageScript(initStoreGrid);
</script>
