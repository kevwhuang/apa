---
import { getCollection } from 'astro:content';

import BackLink from '@components/shared/BackLink.astro';
import { CHECKOUT_STEPS, COMMERCE, FIELD_LIMITS, US_STATES } from '@lib/shared/constants';
import { toCatalog, toImageSources } from '@lib/commerce/products';

interface CheckoutField {
    autocomplete: string;
    column: string;
    inputmode?: 'numeric';
    kind?: 'select' | 'text';
    label: string;
    maxlength?: number;
    name: string;
    optional?: boolean;
    pattern?: string;
    placeholder?: string;
    type?: 'email' | 'text';
}

const PAYMENT_FIELDS: CheckoutField[] = [
    { autocomplete: 'off', column: 'col-span-6 max-md:col-auto', inputmode: 'numeric', label: 'Card number', maxlength: FIELD_LIMITS.card, name: 'cc-number', pattern: '[0-9 ]{13,19}' },
    { autocomplete: 'off', column: 'col-span-3 max-md:col-auto', inputmode: 'numeric', label: 'Expiration date', maxlength: FIELD_LIMITS.expiry, name: 'cc-exp', pattern: '(0[1-9]|1[0-2]) ?/ ?[0-9]{2}', placeholder: 'MM / YY' },
    { autocomplete: 'off', column: 'col-span-3 max-md:col-auto', inputmode: 'numeric', label: 'CCV', maxlength: FIELD_LIMITS.csc, name: 'cc-csc', pattern: '[0-9]{3,4}' },
    { autocomplete: 'off', column: 'col-span-3 max-md:col-auto', label: 'Name on card', maxlength: FIELD_LIMITS.name, name: 'cc-name' },
    { autocomplete: 'billing postal-code', column: 'col-span-3 max-md:col-auto', inputmode: 'numeric', label: 'Billing ZIP code', maxlength: FIELD_LIMITS.zip, name: 'cc-zip', pattern: '[0-9]{5}(-[0-9]{4})?' },
];

const SHIPPING_FIELDS: CheckoutField[] = [
    { autocomplete: 'given-name', column: 'col-span-6 max-md:col-auto', label: 'First name', maxlength: FIELD_LIMITS.name, name: 'given-name' },
    { autocomplete: 'family-name', column: 'col-span-6 max-md:col-auto', label: 'Last name', maxlength: FIELD_LIMITS.name, name: 'family-name' },
    { autocomplete: 'email', column: 'col-span-12 max-md:col-auto', label: 'Email', maxlength: FIELD_LIMITS.email, name: 'email', type: 'email' },
    { autocomplete: 'address-line1', column: 'col-span-12 max-md:col-auto', label: 'Address line 1', maxlength: FIELD_LIMITS.address, name: 'address-line1' },
    { autocomplete: 'address-line2', column: 'col-span-12 max-md:col-auto', label: 'Address line 2 (optional)', maxlength: FIELD_LIMITS.address, name: 'address-line2', optional: true },
    { autocomplete: 'address-level2', column: 'col-span-12 max-md:col-auto', label: 'City', maxlength: FIELD_LIMITS.name, name: 'city' },
    { autocomplete: 'address-level1', column: 'col-span-7 max-lg:col-span-12 max-md:col-auto', kind: 'select', label: 'State', name: 'state' },
    { autocomplete: 'postal-code', column: 'col-span-5 max-lg:col-span-12 max-md:col-auto', inputmode: 'numeric', label: 'ZIP code', maxlength: FIELD_LIMITS.zip, name: 'zip', pattern: '[0-9]{5}(-[0-9]{4})?' },
];

const catalog = toCatalog(await getCollection('products'));
const images = await toImageSources();
---

<BackLink
    href="/store/cart"
    label="Back to cart"
/>

<section
    class="stage stage--tight"
    aria-labelledby="checkout-title"
    data-catalog={JSON.stringify(catalog)}
    data-images={JSON.stringify(images)}
>
    <div>
        <h1
            id="checkout-title"
            class="mb-12 text-4xl text-balance max-lg:text-3xl"
            data-motion="strike"
        >
            Checkout
        </h1>
        <div class="checkout__empty slab slab--card slab--empty max-w-(--measure-form) w-full mx-auto">
            <p class="font-bold font-sans text-2xl text-balance tracking-tight">There is nothing to check out.</p>
            <a
                class="btn btn--primary"
                href="/store"
            >
                Browse store
            </a>
        </div>
        <div
            class="checkout__body checkout__body--solo gap-12"
            data-checkout-body
        >
            <form
                class="flex flex-col gap-6"
                data-checkout-form
                data-motion="unfold"
            >
                <ol
                    class="grid grid-cols-[repeat(3,minmax(max-content,1fr))] border-2 border-border-strong"
                    aria-label="Checkout steps"
                >
                    {CHECKOUT_STEPS.map((step, index) => (
                        <li
                            class:list={[
                                'label step p-4 whitespace-nowrap max-lg:px-1 max-lg:text-center',
                                index === 0 ? 'is-active' : 'bg-bg-page',
                                index > 0 && 'border-border-strong border-l-2',
                            ]}
                            aria-current={index === 0 ? 'step' : undefined}
                        >
                            {step}
                        </li>
                    ))}
                </ol>
                <aside
                    class="checkout__notice slab slab--card flex flex-col gap-4"
                    aria-label="Cart changes"
                    data-checkout-notice
                    hidden
                    role="status"
                >
                    <p class="label text-warning-text">Your cart changed</p>
                    <ul
                        class="flex flex-col gap-(--space-3xs) list-none"
                        data-checkout-issues
                    />
                </aside>
                <fieldset
                    class="slab slab--card step-pane min-w-0"
                    aria-labelledby="checkout-review-title"
                    data-step="0"
                >
                    <h2
                        id="checkout-review-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Review
                    </h2>
                    <ul
                        class="mb-(--space-lg) border-2 border-border-strong list-none"
                        data-review-list
                    />
                    <div class="flex flex-col gap-2 mb-(--space-lg)">
                        <div
                            class="checkout__code-entry flex items-end gap-4"
                            data-code-entry
                        >
                            <label class="flex flex-1 flex-col min-w-0 gap-2">
                                <span class="label text-text-secondary">Discount code</span>
                                <input
                                    id="checkout-code"
                                    class="input font-mono"
                                    aria-describedby="checkout-code-error"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    maxlength={FIELD_LIMITS.code}
                                    name="code"
                                    placeholder="Enter a code"
                                    type="text"
                                />
                            </label>
                            <button
                                class="btn shrink-0"
                                data-code-apply
                                disabled
                                type="button"
                            >
                                Apply
                            </button>
                        </div>
                        <p
                            class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 border-2 border-border-strong"
                            data-code-tag
                            hidden
                        >
                            <span
                                class="label"
                                data-code-label
                            />
                            <button
                                class="action-text min-h-(--control-size) text-text-secondary transition-[color,transform]"
                                aria-label="Remove discount code"
                                data-code-remove
                                type="button"
                            >
                                Remove
                            </button>
                        </p>
                        <p
                            id="checkout-code-error"
                            class="text-error-text"
                            data-field-error
                            hidden
                        />
                    </div>
                    <dl class="flex flex-col gap-(--space-2xs) pt-(--space-sm) border-border-strong border-t-2 font-mono text-base">
                        <div class="flex justify-between gap-(--space-sm)">
                            <dt>Subtotal</dt>
                            <dd data-subtotal>$0.00</dd>
                        </div>
                        <div
                            class="flex justify-between gap-(--space-sm)"
                            data-promo-row
                            hidden
                        >
                            <dt>Discount ({COMMERCE.discountCode})</dt>
                            <dd
                                class="whitespace-nowrap"
                                data-promo
                            >
                                $0.00
                            </dd>
                        </div>
                        <div
                            class="flex justify-between gap-(--space-sm)"
                            data-discount-row
                            hidden
                        >
                            <dt>Prods credit</dt>
                            <dd data-discount>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-(--space-sm)">
                            <dt>Shipping</dt>
                            <dd data-shipping>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-(--space-sm) mb-(--space-2xs)">
                            <dt>Tax</dt>
                            <dd data-tax>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-(--space-sm) pt-(--space-2xs) border-border-strong border-t-2 text-lg">
                            <dt>Total</dt>
                            <dd
                                aria-live="polite"
                                data-total
                            >
                                $0.00
                            </dd>
                        </div>
                    </dl>
                </fieldset>
                <fieldset
                    class="slab slab--card step-pane hidden min-w-0"
                    aria-labelledby="checkout-shipping-title"
                    data-step="1"
                    disabled
                >
                    <h2
                        id="checkout-shipping-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Shipping
                    </h2>
                    <div class="grid grid-cols-12 gap-x-(--space-sm) gap-y-(--space-md) max-md:grid-cols-1">
                        {SHIPPING_FIELDS.map(field => (
                            <div class:list={['flex flex-col gap-2', field.column]}>
                                <label class="flex flex-col gap-2">
                                    <span class="label text-text-secondary">{field.label}</span>
                                    {field.kind === 'select'
                                        ? (
                                                <span class="select">
                                                    <select
                                                        id={`checkout-${field.name}`}
                                                        class="input"
                                                        aria-describedby={`checkout-${field.name}-error`}
                                                        aria-invalid="false"
                                                        autocomplete={field.autocomplete}
                                                        name={field.name}
                                                        required
                                                    >
                                                        <option value="">Choose&hellip;</option>
                                                        {US_STATES.map(state => (
                                                            <option value={state.code}>{state.name}</option>
                                                        ))}
                                                    </select>
                                                </span>
                                            )
                                        : (
                                                <input
                                                    id={`checkout-${field.name}`}
                                                    class="input"
                                                    aria-describedby={`checkout-${field.name}-error`}
                                                    aria-invalid="false"
                                                    autocomplete={field.autocomplete}
                                                    inputmode={field.inputmode}
                                                    maxlength={field.maxlength}
                                                    name={field.name}
                                                    pattern={field.pattern}
                                                    placeholder={field.placeholder}
                                                    required={!field.optional}
                                                    type={field.type ?? 'text'}
                                                />
                                            )}
                                </label>
                                <p
                                    id={`checkout-${field.name}-error`}
                                    class="text-error-text"
                                    data-field-error
                                    hidden
                                />
                            </div>
                        ))}
                    </div>
                </fieldset>
                <fieldset
                    class="slab slab--card step-pane hidden min-w-0"
                    aria-labelledby="checkout-payment-title"
                    data-step="2"
                    disabled
                >
                    <h2
                        id="checkout-payment-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Payment
                    </h2>
                    <div
                        class="checkout__prods mb-(--space-lg)"
                        data-prods-field
                        hidden
                    >
                        <label class="checkout__check">
                            <input
                                id="checkout-prods"
                                class="box"
                                name="prods"
                                type="checkbox"
                            />
                            <span>Pay with Prods</span>
                        </label>
                        <p
                            class="font-mono leading-none text-base tracking-[0.06em] uppercase"
                            data-prods-balance
                        />
                    </div>
                    <fieldset
                        class="checkout__card-fields mb-(--space-lg)"
                        data-card-fields
                    >
                        <legend class="sr-only">Card details</legend>
                        <div class="grid grid-cols-6 gap-x-(--space-sm) gap-y-(--space-md) max-md:grid-cols-1">
                            {PAYMENT_FIELDS.map(field => (
                                <div class:list={['flex flex-col gap-2', field.column]}>
                                    <label class="flex flex-col gap-2">
                                        <span class="label text-text-secondary">{field.label}</span>
                                        <input
                                            id={`checkout-${field.name}`}
                                            class="input font-mono"
                                            aria-describedby={`checkout-${field.name}-error`}
                                            aria-invalid="false"
                                            autocomplete={field.autocomplete}
                                            inputmode={field.inputmode}
                                            maxlength={field.maxlength}
                                            name={field.name}
                                            pattern={field.pattern}
                                            placeholder={field.placeholder}
                                            required
                                            type="text"
                                        />
                                    </label>
                                    <p
                                        id={`checkout-${field.name}-error`}
                                        class="text-error-text"
                                        data-field-error
                                        hidden
                                    />
                                </div>
                            ))}
                        </div>
                    </fieldset>
                    <div class="flex flex-col gap-(--space-3xs)">
                        <label class="checkout__check">
                            <input
                                id="checkout-terms"
                                class="box"
                                aria-describedby="checkout-terms-error"
                                aria-invalid="false"
                                name="terms"
                                required
                                type="checkbox"
                            />
                            <span>
                                I accept the&#32;
                                <a
                                    class="active:translate-y-px hover:text-link inline-block font-mono underline underline-offset-4 transition-[color,translate]"
                                    href="/terms"
                                >
                                    terms of service
                                </a>.
                            </span>
                        </label>
                        <p
                            id="checkout-terms-error"
                            class="text-error-text"
                            data-field-error
                            hidden
                        />
                    </div>
                </fieldset>
                <div class="flex flex-wrap justify-between gap-4">
                    <button
                        class="btn checkout-back invisible"
                        type="button"
                    >
                        Back
                    </button>
                    <button
                        class="btn btn--primary checkout-next"
                        type="submit"
                    >
                        Continue
                    </button>
                </div>
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-checkout-announce
                />
            </form>
            <aside
                class="checkout__aside slab slab--sunk self-start"
                aria-label="Order summary"
                data-checkout-aside
                hidden
            >
                <h2 class="label mb-4 text-text-secondary">Summary</h2>
                <ul
                    class="checkout__summary scroll-slot mb-4 list-none text-base"
                    data-summary-list
                />
                <dl class="flex flex-col gap-2 pt-4 border-border-strong border-t-2 font-mono text-base">
                    <div class="flex justify-between gap-3">
                        <dt>Subtotal</dt>
                        <dd data-subtotal>$0.00</dd>
                    </div>
                    <div
                        class="flex justify-between gap-3"
                        data-promo-row
                        hidden
                    >
                        <dt>Discount ({COMMERCE.discountCode})</dt>
                        <dd
                            class="whitespace-nowrap"
                            data-promo
                        >
                            $0.00
                        </dd>
                    </div>
                    <div
                        class="flex justify-between gap-3"
                        data-discount-row
                        hidden
                    >
                        <dt>Prods credit</dt>
                        <dd data-discount>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt>Shipping</dt>
                        <dd data-shipping>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 mb-2">
                        <dt>Tax</dt>
                        <dd data-tax>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 pt-2 border-border-strong border-t-2 text-lg">
                        <dt>Total</dt>
                        <dd
                            aria-live="polite"
                            data-total
                        >
                            $0.00
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>
    </div>
    <template data-issue-row>
        <li class="flex gap-2 text-base text-text-secondary">
            <span
                class="font-bold text-warning-text"
                aria-hidden="true"
            >
                &middot;
            </span>
            <span
                class="min-w-0"
                data-issue-text
            />
        </li>
    </template>
    <template data-review-row>
        <li class="first:border-t-0 flex flex-wrap items-baseline justify-between gap-(--space-sm) p-(--space-md) border-border-strong border-t-2">
            <span class="block self-center shrink-0 h-14 w-14 border-2 border-border-strong bg-bg-inverse">
                <img
                    class="block object-cover h-full w-full"
                    alt=""
                    data-review-photo
                    hidden
                    loading="lazy"
                />
            </span>
            <div class="flex flex-[1_1_88px] flex-col min-w-0 gap-(--space-2xs)">
                <p class="font-bold font-sans leading-(--text-xl) text-lg tracking-tight max-md:leading-(--text-lg) max-md:text-base">
                    <a
                        class="active:translate-y-px hover:text-link hover:underline inline-block underline-offset-4 wrap-anywhere transition-[color,translate]"
                        data-review-title
                        href="/store"
                    >
                        Item
                    </a>
                </p>
                <p class="flex flex-wrap items-center gap-(--space-2xs)">
                    <span
                        class="min-w-0 font-mono leading-none text-base tracking-[0.06em] uppercase text-text-secondary"
                        data-review-variant
                    />
                    <span
                        class="px-(--space-2xs) py-(--space-3xs) border border-border-subtle font-mono leading-none text-base tracking-[0.06em] uppercase"
                        data-review-qty
                    />
                </p>
            </div>
            <p
                class="ms-auto font-mono text-base whitespace-nowrap"
                data-review-price
            />
        </li>
    </template>
    <template data-summary-row>
        <li class="flex items-center justify-between gap-2 mb-3">
            <span class="flex items-center min-w-0 gap-2">
                <span class="block shrink-0 h-8 w-8 border-2 border-border-strong bg-bg-inverse">
                    <img
                        class="block object-cover h-full w-full"
                        alt=""
                        data-summary-photo
                        hidden
                        loading="lazy"
                    />
                </span>
                <span class="min-w-0">
                    <a
                        class="active:translate-y-px hover:text-link hover:underline inline-block underline-offset-4 wrap-anywhere transition-[color,translate]"
                        data-summary-title
                        href="/store"
                    >
                        Item
                    </a>
                </span>
            </span>
            <span
                class="font-mono text-base"
                data-summary-price
            />
        </li>
    </template>
</section>

<style>
    html[data-cart='empty'] .checkout__body {
        display: none;
    }

    html[data-cart='filled'] .checkout__empty {
        display: none;
    }

    .checkout__aside {
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .checkout__body {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .checkout__body--solo {
        grid-template-columns: minmax(0, 1fr);
    }

    .checkout__card-fields:disabled .label {
        color: var(--color-text-disabled);
    }

    .checkout__check {
        align-items: center;
        align-self: flex-start;
        display: flex;
        font-size: var(--text-sm);
        gap: var(--space-xs);
        line-height: var(--text-sm--line-height);
        min-height: var(--control-size);
        padding-block: var(--space-2xs);
    }

    .checkout__code-entry:has(.input[aria-invalid='true']) .btn {
        border-color: var(--color-border-invalid);
        color: var(--color-error-text);
    }

    .checkout__code-entry:has(.input[aria-invalid='true']) .btn:hover:not(:disabled) {
        color: var(--color-error-text-on-inverse);
    }

    .checkout__notice {
        border-left: 2px solid var(--color-warning-border);
    }

    .checkout__prods {
        align-items: center;
        border: 2px solid var(--color-border-strong);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-sm);
        justify-content: space-between;
        padding: var(--space-2xs) var(--space-sm);
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .checkout__prods:has(.box:checked) {
        background-color: var(--color-bg-sunken);
    }

    .checkout__prods:has(.box:disabled) {
        cursor: not-allowed;
    }

    .checkout__summary {
        --scroll-slot-max: 40vh;
    }

    .step--done {
        background: var(--color-bg-sunken);
        color: var(--color-text-secondary);
    }

    .step--done::before {
        content: '\2713\00a0';
    }

    .step-pane {
        padding: var(--space-lg);
    }

    @media (max-width: 768px) {
        .checkout__body {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { CHECKOUT_STEPS, COMMERCE, EMAIL_PATTERN, FIELD_LIMITS } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, isValidationBypassed, renderIssueList, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { formatPrice, formatProds, formatVariant, parseCatalog, parseImageSources, registerPageScript, setPending, setProductImage, setText, setTitleLink } from '@lib/shared/utils';
    import { getItems, getTotals, isPromoCode, reconcile, toCatalogItem, toProds } from '@lib/commerce/cart';
    import { getProdsBalance as readProdsBalance } from '@lib/account/prods';
    import { getSession } from '@lib/account/session';
    import { placeOrder } from '@lib/commerce/checkout';
    import { toast } from '@lib/ui/toasts';

    interface CheckoutControls {
        aside: HTMLElement;
        backButton: HTMLButtonElement;
        body: HTMLElement;
        form: HTMLFormElement;
        nextButton: HTMLButtonElement;
        panes: NodeListOf<HTMLFieldSetElement>;
        steps: NodeListOf<HTMLElement>;
    }

    const ADDRESS_MIN = 5;
    const BASIS_POINTS_PER_PERCENT = 100;
    const CARD_FIELDS = ['cc-csc', 'cc-exp', 'cc-name', 'cc-number', 'cc-zip'];
    const CARD_PATTERN = /^\d{13,19}$/;
    const CENTURY = 2_000;
    const CITY_MIN = 2;
    const CODE_MESSAGE = 'That code is not valid.';
    const CSC_PATTERN = /^\d{3,4}$/;
    const EXPIRY_PATTERN = /^(0[1-9]|1[0-2]) ?\/ ?(\d{2})$/;
    const LAST_STEP = 2;
    const MAX_EXPIRY_YEARS = 20;
    const REVIEW_STEP = 0;
    const ZIP_PATTERN = /^\d{5}(-\d{4})?$/;

    const CARD_RULES: Record<string, FieldRule> = {
        'cc-csc': { message: 'Enter the three- or four-digit CCV.', pattern: CSC_PATTERN, required: true },
        'cc-exp': { message: 'Use MM / YY, this month or later.', required: true, validate: isFutureExpiry },
        'cc-name': { max: FIELD_LIMITS.name, message: 'Enter the name on the card.', required: true },
        'cc-number': { message: 'Enter the digits on your card.', required: true, validate: value => CARD_PATTERN.test(value.replace(/\s/g, '')) },
        'cc-zip': { message: 'Enter a five-digit billing ZIP code.', pattern: ZIP_PATTERN, required: true },
    };

    const STEP_RULES: Record<string, FieldRule>[] = [
        {},
        {
            'address-line1': { max: FIELD_LIMITS.address, message: 'Enter your street address.', min: ADDRESS_MIN, required: true },
            'address-line2': { max: FIELD_LIMITS.address, message: 'Shorten the second address line.' },
            'city': { max: FIELD_LIMITS.name, message: 'Enter your city.', min: CITY_MIN, required: true },
            'email': { max: FIELD_LIMITS.email, message: 'Enter a valid email address.', pattern: EMAIL_PATTERN, required: true },
            'family-name': { max: FIELD_LIMITS.name, message: 'Enter your last name.', required: true },
            'given-name': { max: FIELD_LIMITS.name, message: 'Enter your first name.', required: true },
            'state': { message: 'Choose your state.', required: true },
            'zip': { message: 'Enter a five-digit ZIP code.', pattern: ZIP_PATTERN, required: true },
        },
        {
            terms: { message: 'Accept the terms to place the order.', required: true },
        },
    ];

    let catalog: CatalogEntry[] = [];
    let images: ImageSources = {};
    let isBlocked = false;
    let orderItems: CartItem[] = [];
    let promoCode = '';
    let step = REVIEW_STEP;

    function clearCardFields(form: HTMLFormElement) {
        CARD_FIELDS.forEach((name) => {
            const field = form.elements.namedItem(name);

            if (field instanceof HTMLInputElement) field.value = '';
        });
    }

    function fillReviewRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-review-photo]'), images, item);
        setText(fragment.querySelector('[data-review-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-review-qty]'), `\u00d7 ${item.quantity}`);
        setTitleLink(fragment.querySelector('[data-review-title]'), catalog, item, item.title);
        setText(fragment.querySelector('[data-review-variant]'), formatVariant(item));
    }

    function fillSummaryRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-summary-photo]'), images, item);
        setText(fragment.querySelector('[data-summary-price]'), formatPrice(item.priceCents * item.quantity));

        setTitleLink(
            fragment.querySelector('[data-summary-title]'),
            catalog,
            item,
            `${item.quantity} \u00d7 ${item.title} \u00b7 ${formatVariant(item)}`,
        );
    }

    function focusPane(pane: HTMLFieldSetElement | undefined) {
        if (!pane) return;

        const controls = Array.from(pane.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));

        const control = controls.find(element => !element.disabled && element.offsetParent !== null);

        (control ?? pane.querySelector<HTMLElement>('[tabindex="-1"]'))?.focus();
    }

    function getDiscountPercent() {
        return COMMERCE.discountBasisPoints / BASIS_POINTS_PER_PERCENT;
    }

    function getProdsApplied(form: HTMLFormElement) {
        return isProdsEngaged(form) ? getProdsCharge() : 0;
    }

    function getProdsBalance() {
        const session = getSession();

        return session ? readProdsBalance(session.email, session.createdAt) : 0;
    }

    function getProdsCharge() {
        return Math.min(getProdsBalance(), toProds(getTotals(getItems(), 0, promoCode).totalCents));
    }

    function getStepRules(form: HTMLFormElement) {
        if (isCardWaived(form) || step !== LAST_STEP) return STEP_RULES[step];

        return { ...CARD_RULES, ...STEP_RULES[step] };
    }

    function handleBackClick(controls: CheckoutControls) {
        if (isBlocked) {
            isBlocked = false;
            renderIssues([]);
        }

        step = Math.max(REVIEW_STEP, step - 1);
        updateSteps(controls, true);
    }

    function handleCodeApply(form: HTMLFormElement) {
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!input || input.value.trim().length === 0) return;

        if (!isPromoCode(input.value)) {
            setFieldErrors(form, { code: CODE_MESSAGE });
            input.focus();

            return;
        }

        clearFieldErrors(form);
        input.value = '';
        promoCode = COMMERCE.discountCode;
        renderOrder(form);
        toast(`${COMMERCE.discountCode} applied: ${getDiscountPercent()}% off your subtotal.`, 'success');
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.focus();
    }

    function handleCodeInput(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!apply || !input) return;

        apply.disabled = input.value.trim().length === 0;

        if (input.getAttribute('aria-invalid') === 'true') clearFieldErrors(form);
    }

    function handleCodeKeydown(event: KeyboardEvent, form: HTMLFormElement) {
        if (event.key !== 'Enter') return;

        event.preventDefault();
        handleCodeApply(form);
    }

    function handleCodeRemove(form: HTMLFormElement) {
        promoCode = '';
        clearFieldErrors(form);
        renderOrder(form);
        toast('Discount code removed.', 'info');
        form.querySelector<HTMLInputElement>('[name="code"]')?.focus();
    }

    async function handleFormSubmit(event: SubmitEvent, controls: CheckoutControls) {
        event.preventDefault();

        const shouldBypass = isValidationBypassed();

        if (!shouldBypass && isBlocked) {
            await navigate('/store/cart');

            return;
        }

        isBlocked = false;

        const errors = validateFields(controls.form, getStepRules(controls.form));

        clearFieldErrors(controls.form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(controls.form, errors);
            focusFirstError(controls.form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        if (step < LAST_STEP) {
            step += 1;
            updateSteps(controls, true);

            return;
        }

        await submitOrder(controls, shouldBypass);
    }

    function handleProdsToggle(form: HTMLFormElement) {
        clearFieldErrors(form);
        renderCardFields(form);
        renderTotals(form);
    }

    function initCheckoutFlow(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('[data-checkout-aside]');
        const backButton = document.querySelector<HTMLButtonElement>('.checkout-back');
        const body = document.querySelector<HTMLElement>('[data-checkout-body]');
        const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
        const nextButton = document.querySelector<HTMLButtonElement>('.checkout-next');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        if (!aside || !backButton || !body || !form || !nextButton) return;

        const codeInput = form.querySelector<HTMLInputElement>('[name="code"]');

        const controls: CheckoutControls = {
            aside,
            backButton,
            body,
            form,
            nextButton,
            panes: document.querySelectorAll<HTMLFieldSetElement>('.step-pane'),
            steps: document.querySelectorAll<HTMLElement>('.step'),
        };

        catalog = parseCatalog(source?.dataset.catalog);
        images = parseImageSources(source?.dataset.images);
        isBlocked = false;
        promoCode = '';
        step = REVIEW_STEP;
        form.noValidate = true;
        renderIssues(reconcile(catalog));

        const hasItems = getItems().length > 0;

        document.documentElement.dataset.cart = hasItems ? 'filled' : 'empty';

        if (!hasItems) return;

        updateSteps(controls, false);
        backButton.addEventListener('click', () => handleBackClick(controls), { signal });
        form.addEventListener('submit', event => void handleFormSubmit(event, controls), { signal });
        signal.addEventListener('abort', () => clearCardFields(form), { once: true });

        form.querySelectorAll<HTMLInputElement>('[name="cc-number"], [name="cc-csc"]').forEach((input) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/[^\d ]/g, '');
            }, { signal });
        });

        codeInput?.addEventListener('input', () => handleCodeInput(form), { signal });
        codeInput?.addEventListener('keydown', event => handleCodeKeydown(event, form), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-apply]')?.addEventListener('click', () => handleCodeApply(form), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.addEventListener('click', () => handleCodeRemove(form), { signal });
        form.querySelector<HTMLInputElement>('[name="prods"]')?.addEventListener('change', () => handleProdsToggle(form), { signal });
    }

    function isCardWaived(form: HTMLFormElement) {
        return isProdsEngaged(form) && isFullyCovered();
    }

    function isFullyCovered() {
        const charge = getProdsCharge();

        return charge > 0 && getTotals(getItems(), charge, promoCode).totalCents === 0;
    }

    function isFutureExpiry(value: string) {
        const match = EXPIRY_PATTERN.exec(value);

        if (!match) return false;

        const expiry = new Date(CENTURY + Number(match[2]), Number(match[1]), 1);
        const now = new Date();

        const limit = new Date(now.getFullYear() + MAX_EXPIRY_YEARS, now.getMonth(), 1);

        return expiry <= limit && expiry > now;
    }

    function isProdsEngaged(form: HTMLFormElement) {
        const checkbox = form.elements.namedItem('prods');

        return checkbox instanceof HTMLInputElement && checkbox.checked && !checkbox.disabled;
    }

    function readValue(form: HTMLFormElement, name: string) {
        const field = form.elements.namedItem(name);

        return field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : '';
    }

    function renderCardFields(form: HTMLFormElement) {
        const fields = form.querySelector<HTMLFieldSetElement>('[data-card-fields]');

        if (!fields) return;

        fields.disabled = isCardWaived(form);
    }

    function renderCode(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const entry = form.querySelector<HTMLElement>('[data-code-entry]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');
        const tag = form.querySelector<HTMLElement>('[data-code-tag]');

        if (!apply || !entry || !input || !tag) return;

        const isApplied = promoCode.length > 0;

        apply.disabled = input.value.trim().length === 0;
        entry.toggleAttribute('hidden', isApplied);
        tag.toggleAttribute('hidden', !isApplied);
        setText(form.querySelector('[data-code-label]'), isApplied ? `${promoCode} \u00b7 ${getDiscountPercent()}% off` : '');
    }

    function renderIssues(issues: CartIssue[]) {
        renderIssueList(
            issues,
            document.querySelector<HTMLElement>('[data-checkout-notice]'),
            document.querySelector<HTMLElement>('[data-checkout-issues]'),
            document.querySelector<HTMLTemplateElement>('[data-issue-row]'),
        );
    }

    function renderItems() {
        renderList(
            document.querySelector<HTMLElement>('[data-review-list]'),
            document.querySelector<HTMLTemplateElement>('[data-review-row]'),
            fillReviewRow,
        );

        renderList(
            document.querySelector<HTMLElement>('[data-summary-list]'),
            document.querySelector<HTMLTemplateElement>('[data-summary-row]'),
            fillSummaryRow,
        );
    }

    function renderList(list: HTMLElement | null, template: HTMLTemplateElement | null, fill: (fragment: DocumentFragment, item: CartItem) => void) {
        if (!list || !template) return;

        list.replaceChildren();

        orderItems.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fill(fragment, item);
            list.append(fragment);
        });
    }

    function renderOrder(form: HTMLFormElement) {
        orderItems = getItems().map(item => toCatalogItem(catalog, item));
        renderCode(form);
        renderProds(form);
        renderCardFields(form);
        renderItems();
        renderTotals(form);
    }

    function renderProds(form: HTMLFormElement) {
        const checkbox = form.querySelector<HTMLInputElement>('[name="prods"]');
        const field = form.querySelector<HTMLElement>('[data-prods-field]');

        if (!checkbox || !field) return;

        const balance = getProdsBalance();

        field.toggleAttribute('hidden', getSession() === null);
        checkbox.disabled = balance === 0;

        if (checkbox.disabled) checkbox.checked = false;

        setText(field.querySelector('[data-prods-balance]'), formatProds(balance));
    }

    function renderTotals(form: HTMLFormElement) {
        const summary = getTotals(getItems(), getProdsApplied(form), promoCode);

        const prodsCents = summary.discountCents - summary.promoCents;

        document.querySelectorAll('[data-discount-row]').forEach((row) => {
            row.toggleAttribute('hidden', prodsCents === 0);
        });

        document.querySelectorAll('[data-promo-row]').forEach((row) => {
            row.toggleAttribute('hidden', summary.promoCents === 0);
        });

        setAll('[data-discount]', `\u2212${formatPrice(prodsCents)}`);
        setAll('[data-promo]', `\u2212${formatPrice(summary.promoCents)}`);
        setAll('[data-shipping]', formatPrice(summary.shippingCents));
        setAll('[data-subtotal]', formatPrice(summary.subtotalCents));
        setAll('[data-tax]', formatPrice(summary.taxCents));
        setAll('[data-total]', formatPrice(summary.totalCents));
    }

    function setAll(selector: string, value: string) {
        document.querySelectorAll(selector).forEach(element => setText(element, value));
    }

    async function submitOrder(controls: CheckoutControls, shouldBypass: boolean) {
        const issues = reconcile(catalog);

        if (!shouldBypass && issues.length > 0) {
            isBlocked = true;
            renderIssues(issues);
            renderOrder(controls.form);
            controls.nextButton.textContent = 'Back to cart';

            return;
        }

        setPending(controls.nextButton, true);

        const result = await placeOrder({
            cardNumber: readValue(controls.form, 'cc-number'),
            email: readValue(controls.form, 'email'),
            items: orderItems,
            prodsApplied: getProdsApplied(controls.form),
            promoCode,
        });

        setPending(controls.nextButton, false);

        if (!result.ok) {
            isBlocked = true;
            controls.nextButton.textContent = 'Back to cart';
            toast(result.message, 'error');

            return;
        }

        clearCardFields(controls.form);

        await navigate('/store/orders');
    }

    function updateSteps(controls: CheckoutControls, shouldMoveFocus: boolean) {
        controls.steps.forEach((item, index) => {
            item.classList.toggle('is-active', index === step);
            item.classList.toggle('step--done', index < step);
            item.classList.toggle('bg-bg-page', index > step);

            if (index === step) item.setAttribute('aria-current', 'step');
            else item.removeAttribute('aria-current');
        });

        controls.panes.forEach((pane, index) => {
            pane.classList.toggle('hidden', index !== step);
            pane.disabled = index !== step;
        });

        controls.aside.toggleAttribute('hidden', step === REVIEW_STEP);
        controls.backButton.classList.toggle('invisible', step === REVIEW_STEP);
        controls.body.classList.toggle('checkout__body--solo', step === REVIEW_STEP);
        controls.nextButton.textContent = step === LAST_STEP ? 'Place order' : 'Continue';
        renderOrder(controls.form);

        if (!shouldMoveFocus) return;

        setText(document.querySelector('[data-checkout-announce]'), `Step ${step + 1} of ${CHECKOUT_STEPS.length}, ${CHECKOUT_STEPS[step]}.`);
        focusPane(controls.panes[step]);
    }

    registerPageScript(initCheckoutFlow);
</script>
