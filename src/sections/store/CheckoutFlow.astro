---
import { getCollection } from 'astro:content';

import BackLink from '@components/shared/BackLink.astro';
import { CHECKOUT_STEPS, FIELD_LIMITS, US_STATES } from '@lib/shared/constants';
import { toCatalog, toImageSources } from '@lib/commerce/products';

interface CheckoutField {
    autocomplete: string;
    column: string;
    inputmode?: 'numeric';
    kind?: 'select' | 'text';
    label: string;
    maxlength?: number;
    name: string;
    optional?: boolean;
    pattern?: string;
    type?: 'email' | 'text';
}

const SHIPPING_FIELDS: CheckoutField[] = [
    { autocomplete: 'given-name', column: 'col-span-6 max-md:col-auto', label: 'First name', maxlength: FIELD_LIMITS.name, name: 'given-name' },
    { autocomplete: 'family-name', column: 'col-span-6 max-md:col-auto', label: 'Last name', maxlength: FIELD_LIMITS.name, name: 'family-name' },
    { autocomplete: 'email', column: 'col-span-12 max-md:col-auto', label: 'Email', maxlength: FIELD_LIMITS.email, name: 'email', type: 'email' },
    { autocomplete: 'address-line1', column: 'col-span-12 max-md:col-auto', label: 'Address line 1', maxlength: FIELD_LIMITS.address, name: 'address-line1' },
    { autocomplete: 'address-line2', column: 'col-span-12 max-md:col-auto', label: 'Address line 2 (optional)', maxlength: FIELD_LIMITS.address, name: 'address-line2', optional: true },
    { autocomplete: 'address-level2', column: 'col-span-12 max-md:col-auto', label: 'City', maxlength: FIELD_LIMITS.name, name: 'city' },
    { autocomplete: 'address-level1', column: 'col-span-7 max-lg:col-span-12 max-md:col-auto', kind: 'select', label: 'State', name: 'state' },
    { autocomplete: 'postal-code', column: 'col-span-5 max-lg:col-span-12 max-md:col-auto', inputmode: 'numeric', label: 'ZIP code', maxlength: FIELD_LIMITS.zip, name: 'zip', pattern: '[0-9]{5}(-[0-9]{4})?' },
];

const catalog = toCatalog(await getCollection('products'));
const images = await toImageSources();

const steps = CHECKOUT_STEPS.map(step => step.split(' '));
---

<BackLink
    href="/store/cart"
    label="Back to cart"
/>

<section
    class="stage stage--tight"
    aria-labelledby="checkout-title"
    data-catalog={JSON.stringify(catalog)}
    data-images={JSON.stringify(images)}
>
    <div>
        <h1
            id="checkout-title"
            class="mb-12 text-3xl-4xl text-balance"
            data-motion="strike"
        >
            Checkout
        </h1>
        <div class="checkout__empty slab slab--card slab--empty max-w-(--measure-form) w-full mx-auto">
            <p class="font-bold text-2xl text-balance tracking-tight">There is nothing to check out.</p>
            <a
                class="btn btn--primary"
                href="/store"
            >
                Browse store
            </a>
        </div>
        <div
            class="checkout__body checkout__body--solo gap-12"
            data-checkout-body
        >
            <form
                class="flex flex-col gap-6"
                data-checkout-form
                data-motion="unfold"
            >
                <ol
                    class="grid grid-cols-[repeat(3,minmax(max-content,1fr))] border-2 border-border-strong"
                    aria-label="Checkout steps"
                >
                    {steps.map(([number, name], index) => (
                        <li
                            class:list={[
                                'label step p-4 whitespace-nowrap max-lg:px-2 max-lg:text-center',
                                index === 0 ? 'is-active' : 'bg-bg-page',
                                index > 0 && 'border-border-strong border-l-2',
                            ]}
                            aria-current={index === 0 ? 'step' : undefined}
                        >
                            <span class="step__number">{number}&#32;</span>{name}
                        </li>
                    ))}
                </ol>
                <fieldset
                    class="slab slab--card slab--plush step-pane min-w-0"
                    aria-labelledby="checkout-review-title"
                    data-step="0"
                >
                    <h2
                        id="checkout-review-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Review
                    </h2>
                    <ul
                        class="mb-(--space-lg) border-2 border-border-strong divide-border-strong divide-y-2 list-none"
                        data-review-list
                    />
                    <div class="flex flex-col gap-2 mb-(--space-lg)">
                        <div class="checkout__code-entry flex flex-wrap items-end gap-4">
                            <label class="flex flex-[1_1_160px] flex-col min-w-0 gap-2">
                                <span class="label text-text-secondary">Promo code</span>
                                <input
                                    id="checkout-code"
                                    class="input font-mono"
                                    aria-invalid="false"
                                    autocomplete="off"
                                    maxlength={FIELD_LIMITS.code}
                                    name="code"
                                    type="text"
                                />
                            </label>
                            <button
                                class="btn shrink-0"
                                data-code-apply
                                disabled
                                type="button"
                            >
                                Apply
                            </button>
                        </div>
                        <p
                            class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 border-2 border-border-strong"
                            data-code-tag
                            hidden
                        >
                            <span
                                class="label"
                                data-code-label
                            />
                            <button
                                class="action-text min-h-(--control-size) text-text-secondary"
                                aria-label="Remove promo code"
                                data-code-remove
                                type="button"
                            >
                                Remove
                            </button>
                        </p>
                    </div>
                    <dl class="flex flex-col gap-2 pt-4 border-border-strong border-t-2 font-mono text-base">
                        <div class="flex justify-between gap-4">
                            <dt>Subtotal</dt>
                            <dd data-subtotal>$0.00</dd>
                        </div>
                        <div
                            class="flex justify-between gap-4"
                            data-promo-row
                            hidden
                        >
                            <dt>Discount</dt>
                            <dd
                                class="whitespace-nowrap"
                                data-promo
                            >
                                $0.00
                            </dd>
                        </div>
                        <div
                            class="flex justify-between gap-4"
                            data-discount-row
                            hidden
                        >
                            <dt>Prods credit</dt>
                            <dd data-discount>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt>Shipping</dt>
                            <dd data-shipping>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-4 mb-2">
                            <dt>Tax</dt>
                            <dd data-tax>$0.00</dd>
                        </div>
                        <div class="flex justify-between gap-4 pt-2 border-border-strong border-t-2 text-lg">
                            <dt>Total</dt>
                            <dd
                                aria-live="polite"
                                data-total
                            >
                                $0.00
                            </dd>
                        </div>
                    </dl>
                </fieldset>
                <fieldset
                    class="slab slab--card slab--plush step-pane hidden min-w-0"
                    aria-labelledby="checkout-shipping-title"
                    data-step="1"
                    disabled
                >
                    <h2
                        id="checkout-shipping-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Shipping
                    </h2>
                    <div class="grid grid-cols-12 gap-x-4 gap-y-(--space-md) max-md:grid-cols-1">
                        {SHIPPING_FIELDS.map(field => (
                            <label class:list={['flex flex-col gap-2', field.column]}>
                                <span class="label text-text-secondary">{field.label}</span>
                                {field.kind === 'select'
                                    ? (
                                            <span class="select">
                                                <select
                                                    id={`checkout-${field.name}`}
                                                    class="input"
                                                    aria-invalid="false"
                                                    autocomplete={field.autocomplete}
                                                    name={field.name}
                                                    required
                                                >
                                                    <option value="">Choose&hellip;</option>
                                                    {US_STATES.map(state => (
                                                        <option value={state.code}>{state.name}</option>
                                                    ))}
                                                </select>
                                            </span>
                                        )
                                    : (
                                            <input
                                                id={`checkout-${field.name}`}
                                                class="input"
                                                aria-invalid="false"
                                                autocomplete={field.autocomplete}
                                                inputmode={field.inputmode}
                                                maxlength={field.maxlength}
                                                name={field.name}
                                                pattern={field.pattern}
                                                required={!field.optional}
                                                type={field.type ?? 'text'}
                                            />
                                        )}
                            </label>
                        ))}
                    </div>
                </fieldset>
                <fieldset
                    class="slab slab--card slab--plush step-pane hidden min-w-0"
                    aria-labelledby="checkout-payment-title"
                    data-step="2"
                    disabled
                >
                    <h2
                        id="checkout-payment-title"
                        class="mb-6 text-2xl"
                        tabindex="-1"
                    >
                        Payment
                    </h2>
                    <div
                        class="checkout__prods mb-(--space-lg)"
                        data-prods-field
                        hidden
                    >
                        <label class="checkout__check self-start gap-3 py-2 text-sm">
                            <input
                                id="checkout-prods"
                                class="box"
                                name="prods"
                                type="checkbox"
                            />
                            <span>Pay with Prods</span>
                        </label>
                        <p
                            class="font-mono leading-none text-base tracking-[0.06em] uppercase"
                            data-prods-balance
                        />
                    </div>
                    <fieldset
                        class="mb-(--space-lg)"
                        data-card-fields
                        hidden
                    >
                        <legend class="sr-only">Card details</legend>
                        <div data-payment-field />
                    </fieldset>
                    <div class="flex flex-col">
                        <label class="checkout__check self-start gap-3 py-2 text-sm">
                            <input
                                id="checkout-terms"
                                class="box"
                                aria-invalid="false"
                                name="terms"
                                required
                                type="checkbox"
                            />
                            <span>
                                I accept the&#32;
                                <a
                                    class="active:translate-y-px hover:text-link inline-block font-mono underline underline-offset-4 transition-[color,translate]"
                                    href="/terms"
                                >
                                    terms of service
                                </a>.
                            </span>
                        </label>
                    </div>
                </fieldset>
                <div class="flex flex-wrap justify-between gap-4">
                    <button
                        class="btn checkout-back invisible"
                        type="button"
                    >
                        Back
                    </button>
                    <button
                        class="btn btn--primary checkout-next"
                        type="submit"
                    >
                        Continue
                    </button>
                </div>
                <p
                    class="sr-only"
                    aria-live="polite"
                    data-checkout-announce
                />
            </form>
            <aside
                class="checkout__aside slab slab--sunk self-start"
                aria-label="Order summary"
                data-checkout-aside
                hidden
            >
                <h2 class="label mb-4 text-text-secondary">Summary</h2>
                <ul
                    class="checkout__summary scroll-slot mb-4 list-none text-base"
                    data-summary-list
                />
                <dl class="flex flex-col gap-2 pt-4 border-border-strong border-t-2 font-mono text-base">
                    <div class="flex justify-between gap-3">
                        <dt>Subtotal</dt>
                        <dd data-subtotal>$0.00</dd>
                    </div>
                    <div
                        class="flex justify-between gap-3"
                        data-promo-row
                        hidden
                    >
                        <dt>Discount</dt>
                        <dd
                            class="whitespace-nowrap"
                            data-promo
                        >
                            $0.00
                        </dd>
                    </div>
                    <div
                        class="flex justify-between gap-3"
                        data-discount-row
                        hidden
                    >
                        <dt>Prods credit</dt>
                        <dd data-discount>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt>Shipping</dt>
                        <dd data-shipping>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 mb-2">
                        <dt>Tax</dt>
                        <dd data-tax>$0.00</dd>
                    </div>
                    <div class="flex justify-between gap-3 pt-2 border-border-strong border-t-2 text-lg">
                        <dt>Total</dt>
                        <dd
                            aria-live="polite"
                            data-total
                        >
                            $0.00
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>
    </div>
    <template data-review-row>
        <li class="flex flex-wrap items-baseline justify-between gap-4 p-(--space-md)">
            <span class="block self-center shrink-0 size-14 border-2 border-border-strong bg-bg-inverse">
                <img
                    class="block object-cover size-full"
                    alt=""
                    data-review-photo
                    hidden
                    loading="lazy"
                />
            </span>
            <div class="flex flex-[1_1_88px] flex-col min-w-0 gap-2">
                <p class="font-bold leading-(--text-lg-xl) text-base-lg tracking-tight">
                    <a
                        class="hit active:translate-y-px hover:text-link hover:underline inline-block underline-offset-4 wrap-anywhere transition-[color,translate]"
                        data-review-title
                        href="/store"
                    >
                        Item
                    </a>
                </p>
                <p class="flex flex-wrap items-center gap-2">
                    <span
                        class="min-w-0 font-mono leading-none text-base tracking-[0.06em] uppercase text-text-secondary"
                        data-review-variant
                    />
                    <span
                        class="px-2 py-1 border border-border-subtle font-mono leading-none text-base tracking-[0.06em] uppercase"
                        data-review-qty
                    />
                </p>
            </div>
            <p
                class="ms-auto font-mono text-base whitespace-nowrap"
                data-review-price
            />
        </li>
    </template>
    <template data-summary-row>
        <li class="flex items-center justify-between gap-2 mb-3">
            <span class="flex items-center min-w-0 gap-2">
                <span class="block shrink-0 size-8 border-2 border-border-strong bg-bg-inverse">
                    <img
                        class="block object-cover size-full"
                        alt=""
                        data-summary-photo
                        hidden
                        loading="lazy"
                    />
                </span>
                <span class="min-w-0">
                    <a
                        class="active:translate-y-px hover:text-link hover:underline inline-block underline-offset-4 wrap-anywhere transition-[color,translate]"
                        data-summary-title
                        href="/store"
                    >
                        Item
                    </a>
                </span>
            </span>
            <span
                class="font-mono text-base"
                data-summary-price
            />
        </li>
    </template>
</section>

<style>
    html[data-cart='empty'] .checkout__body {
        display: none;
    }

    html[data-cart='filled'] .checkout__empty {
        display: none;
    }

    html[data-cart='filled'] [data-review-list]:empty {
        min-height: calc(var(--cart-rows) * (2 * var(--space-md) + 64px) + (var(--cart-rows) + 1) * 2px);
    }

    .checkout__aside {
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .checkout__body {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .checkout__body--solo {
        grid-template-columns: minmax(0, 1fr);
        margin-inline: auto;
        max-width: var(--measure-form);
    }

    .checkout__code-entry:has(.input[aria-invalid='true']) .btn {
        border-color: var(--color-border-invalid);
        color: var(--color-error-text);
    }

    .checkout__code-entry:has(.input[aria-invalid='true']) .btn:hover:not(:disabled) {
        color: var(--color-error-text-on-inverse);
    }

    .checkout__prods {
        align-items: center;
        border: 2px solid var(--color-border-strong);
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        justify-content: space-between;
        padding: 8px 16px;
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .checkout__prods:has(.box:checked) {
        background-color: var(--color-bg-sunken);
    }

    .checkout__prods:has(.box:disabled) {
        cursor: not-allowed;
    }

    .checkout__summary {
        --scroll-slot-max: 40vh;
        scrollbar-gutter: auto;
    }

    .step--done {
        background: var(--color-bg-sunken);
        color: var(--color-text-secondary);
    }

    .step--done .step__number {
        display: none;
    }

    .step--done::before {
        content: '\2713\00a0';
    }

    @media (max-width: 768px) {
        .checkout__body {
            grid-template-columns: minmax(0, 1fr);
        }

        .step {
            letter-spacing: normal;
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { CHECKOUT_STEPS, EMAIL_MESSAGE, EMAIL_PATTERN, FIELD_LIMITS, ZIP_PATTERN } from '@lib/shared/constants';
    import {
        applyInstantly,
        describeCartChange,
        formatPrice,
        formatProds,
        formatVariant,
        parseCatalog,
        parseImageSources,
        registerPageScript,
        setPending,
        setProductImage,
        setText,
        setTitleLink,
    } from '@lib/shared/utils';
    import { checkPromo, placeOrder } from '@lib/commerce/checkout';
    import { clearFieldErrors, reportFieldErrors, validateFields, watchFieldErrors } from '@lib/ui/forms';
    import { createPaymentField } from '@lib/commerce/payments';
    import { fetchCatalog, getItems, getProdsCharge, getTotals, onCartChange, reconcile, toCatalogItem } from '@lib/commerce/cart';
    import { getSession, onSessionChange } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    interface CheckoutControls {
        aside: HTMLElement;
        backButton: HTMLButtonElement;
        body: HTMLElement;
        form: HTMLFormElement;
        nextButton: HTMLButtonElement;
        panes: NodeListOf<HTMLFieldSetElement>;
        steps: NodeListOf<HTMLElement>;
    }

    interface CheckoutDraft {
        fields: Record<string, string>;
        promo: Promo | null;
        step: number;
        userId: string;
    }

    const ACTIVATION_WINDOW_MILLISECONDS = 500;
    const BASIS_POINTS_PER_PERCENT = 100;
    const LAST_STEP = 2;
    const PROMO_KEPT_MESSAGE = 'Your current promo code stays applied because it gives an equal or larger discount. Only one code applies per order.';
    const REVIEW_STEP = 0;
    const SHIPPING_STEP = 1;

    const STEP_RULES: Record<string, FieldRule>[] = [
        {},
        {
            'address-line1': { max: FIELD_LIMITS.address, message: 'Enter your street address.', min: FIELD_LIMITS.addressMin, required: true },
            'address-line2': { max: FIELD_LIMITS.address, message: 'Shorten the second address line.' },
            'city': { max: FIELD_LIMITS.name, message: 'Enter your city.', min: FIELD_LIMITS.cityMin, required: true },
            'email': { max: FIELD_LIMITS.email, message: EMAIL_MESSAGE, pattern: EMAIL_PATTERN, required: true },
            'family-name': { max: FIELD_LIMITS.name, message: 'Enter your last name.', required: true },
            'given-name': { max: FIELD_LIMITS.name, message: 'Enter your first name.', required: true },
            'state': { message: 'Choose your state.', required: true },
            'zip': { message: 'Enter a five-digit ZIP code.', pattern: ZIP_PATTERN, required: true },
        },
        {
            terms: { message: 'Accept the terms to place the order.', required: true },
        },
    ];

    let catalog: CatalogEntry[] = [];
    let codeAppliedAt = Number.NEGATIVE_INFINITY;
    let draft: CheckoutDraft | null = null;
    let images: ImageSources = {};
    let isBlocked = false;
    let isCheckingCode = false;
    let isSubmitting = false;
    let orderItems: CartItem[] = [];
    let payment: PaymentField | null = null;
    let paymentReady = Promise.resolve();
    let promo: Promo | null = null;
    let step = REVIEW_STEP;
    let stepChangedAt = Number.NEGATIVE_INFINITY;

    function blockCheckout(controls: CheckoutControls) {
        isBlocked = true;
        renderOrder(controls.form);
        controls.nextButton.textContent = 'Back to cart';
    }

    function destroyPayment() {
        payment?.destroy();
        payment = null;
    }

    function dropStaleDraft() {
        const isEmpty = getItems().length === 0;

        if (draft?.userId !== (getSession()?.id ?? '') || isEmpty) draft = null;
        if (isEmpty) promo = null;
    }

    function fillReviewRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-review-photo]'), images, item);
        setText(fragment.querySelector('[data-review-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-review-qty]'), `\u00d7 ${item.quantity}`);
        setText(fragment.querySelector('[data-review-variant]'), formatVariant(item));
        setTitleLink(fragment.querySelector('[data-review-title]'), catalog, item, item.title);
    }

    function fillSummaryRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-summary-photo]'), images, item);
        setText(fragment.querySelector('[data-summary-price]'), formatPrice(item.priceCents * item.quantity));

        setTitleLink(
            fragment.querySelector('[data-summary-title]'),
            catalog,
            item,
            `${item.quantity} \u00d7 ${item.title} \u00b7 ${formatVariant(item)}`,
        );
    }

    function focusPane(pane: HTMLFieldSetElement | undefined) {
        if (!pane) return;

        const targets = Array.from(pane.querySelectorAll<HTMLElement>('input:enabled, select:enabled, [data-payment-field]'));

        const target = targets.find(element => element.offsetParent !== null);

        const control = target?.hasAttribute('data-payment-field') ? null : target;

        const focusTarget = control ?? pane.querySelector<HTMLElement>('[tabindex="-1"]');

        focusTarget?.focus();
        focusTarget?.scrollIntoView({ block: 'nearest' });
    }

    function getDiscountPercent() {
        return (promo?.discountBasisPoints ?? 0) / BASIS_POINTS_PER_PERCENT;
    }

    function getProdsApplied(form: HTMLFormElement) {
        return isProdsEngaged(form) ? readProdsCharge() : 0;
    }

    function handleBackClick(controls: CheckoutControls) {
        if (isSubmitting) return;

        isBlocked = false;
        step = Math.max(REVIEW_STEP, step - 1);
        stepChangedAt = performance.now();
        updateSteps(controls, true);
    }

    function handleCartChange(form: HTMLFormElement) {
        if (isSubmitting) return;

        document.documentElement.dataset.cart = getItems().length > 0 ? 'filled' : 'empty';
        renderOrder(form);
    }

    async function handleCodeApply(form: HTMLFormElement, signal: AbortSignal) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!input || input.value.trim().length === 0 || isCheckingCode) return;

        isCheckingCode = true;
        setPending(apply, true);

        const result = await checkPromo(input.value.trim());

        if (signal.aborted) return;

        isCheckingCode = false;
        setPending(apply, false);
        handleCodeInput(form);

        if (!result.ok && result.code === 'rejected') {
            reportFieldErrors(form, { code: result.message });

            return;
        }

        if (!result.ok) {
            apply?.focus();
            toast(result.message, 'error');

            return;
        }

        input.value = '';
        clearFieldErrors(form);

        if (promo && result.promo.discountBasisPoints <= promo.discountBasisPoints) {
            handleCodeInput(form);
            input.focus();
            toast(PROMO_KEPT_MESSAGE, 'info');

            return;
        }

        codeAppliedAt = performance.now();
        promo = result.promo;
        renderOrder(form);
        toast(`Promo code applied: ${getDiscountPercent()}% off your subtotal.`, 'success');
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.focus();
    }

    function handleCodeInput(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!apply || !input) return;

        applyInstantly(apply, () => {
            apply.disabled = input.value.trim().length === 0;
        });
    }

    function handleCodeKeydown(event: KeyboardEvent, form: HTMLFormElement, signal: AbortSignal) {
        if (event.key !== 'Enter') return;

        event.preventDefault();
        void handleCodeApply(form, signal);
    }

    function handleCodeRemove(form: HTMLFormElement) {
        if (performance.now() - codeAppliedAt < ACTIVATION_WINDOW_MILLISECONDS) return;

        promo = null;
        clearFieldErrors(form);
        renderOrder(form);
        toast('Promo code removed.', 'info');
        form.querySelector<HTMLInputElement>('[name="code"]')?.focus();
    }

    function handleFormKeydown(event: KeyboardEvent) {
        if (event.key === 'Enter' && event.repeat) event.preventDefault();
    }

    async function handleFormSubmit(event: SubmitEvent, controls: CheckoutControls, signal: AbortSignal) {
        event.preventDefault();

        if (isSubmitting || performance.now() - stepChangedAt < ACTIVATION_WINDOW_MILLISECONDS) return;

        if (isBlocked) {
            await navigate('/store/cart');

            return;
        }

        const errors = validateFields(controls.form, STEP_RULES[step]);

        clearFieldErrors(controls.form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(controls.form, errors);

            return;
        }

        if (step < LAST_STEP) {
            step++;
            stepChangedAt = performance.now();
            updateSteps(controls, true);

            return;
        }

        await submitOrder(controls, signal);
    }

    function handleProdsToggle(form: HTMLFormElement) {
        clearFieldErrors(form);
        renderCardFields(form);
        renderTotals(form);
    }

    function initCheckoutFlow(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('[data-checkout-aside]');
        const backButton = document.querySelector<HTMLButtonElement>('.checkout-back');
        const body = document.querySelector<HTMLElement>('[data-checkout-body]');
        const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
        const nextButton = document.querySelector<HTMLButtonElement>('.checkout-next');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        if (!aside || !backButton || !body || !form || !nextButton) return;

        const codeInput = form.querySelector<HTMLInputElement>('[name="code"]');

        const controls: CheckoutControls = {
            aside,
            backButton,
            body,
            form,
            nextButton,
            panes: document.querySelectorAll<HTMLFieldSetElement>('.step-pane'),
            steps: document.querySelectorAll<HTMLElement>('.step'),
        };

        catalog = parseCatalog(source?.dataset.catalog);
        codeAppliedAt = Number.NEGATIVE_INFINITY;
        images = parseImageSources(source?.dataset.images);
        isBlocked = false;
        isCheckingCode = false;
        isSubmitting = false;
        payment = null;
        paymentReady = Promise.resolve();
        promo = null;
        step = REVIEW_STEP;
        stepChangedAt = Number.NEGATIVE_INFINITY;
        form.noValidate = true;

        const issues = reconcile(catalog);

        if (issues.length > 0) toast(describeCartChange(issues), 'info');

        const hasItems = getItems().length > 0;

        document.documentElement.dataset.cart = hasItems ? 'filled' : 'empty';

        if (!hasItems) return;

        const unsubscribe = onSessionChange(() => renderOrder(form));
        const unsubscribeCart = onCartChange(() => handleCartChange(form));
        const userId = getSession()?.id ?? '';

        restoreDraft(form);
        updateSteps(controls, false);
        paymentReady = initPayment(controls, signal);
        void refreshCheckout(controls, signal);
        backButton.addEventListener('click', () => handleBackClick(controls), { signal });
        codeInput?.addEventListener('input', () => handleCodeInput(form), { signal });
        codeInput?.addEventListener('keydown', event => handleCodeKeydown(event, form, signal), { signal });
        form.addEventListener('keydown', handleFormKeydown, { signal });
        form.addEventListener('submit', event => void handleFormSubmit(event, controls, signal), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-apply]')?.addEventListener('click', () => void handleCodeApply(form, signal), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.addEventListener('click', () => handleCodeRemove(form), { signal });
        form.querySelector<HTMLInputElement>('[name="prods"]')?.addEventListener('change', () => handleProdsToggle(form), { signal });
        signal.addEventListener('abort', () => saveDraft(form, userId), { once: true });
        signal.addEventListener('abort', unsubscribe, { once: true });
        signal.addEventListener('abort', unsubscribeCart, { once: true });
        watchFieldErrors(form, signal);
    }

    async function initPayment(controls: CheckoutControls, signal: AbortSignal) {
        const field = await createPaymentField(getTotals(getItems(), 0, promo?.discountBasisPoints).totalCents);

        if (!field) return;

        if (signal.aborted) {
            field.destroy();

            return;
        }

        payment = field;
        signal.addEventListener('abort', destroyPayment, { once: true });
        renderCardFields(controls.form);
        renderTotals(controls.form);
        mountPayment(controls.form);
    }

    function isCardWaived(form: HTMLFormElement) {
        return isFullyCovered() && isProdsEngaged(form);
    }

    function isFullyCovered() {
        const charge = readProdsCharge();

        return charge > 0 && getTotals(getItems(), charge, promo?.discountBasisPoints).totalCents === 0;
    }

    function isProdsEngaged(form: HTMLFormElement) {
        const checkbox = form.elements.namedItem('prods');

        return checkbox instanceof HTMLInputElement && checkbox.checked && !checkbox.disabled;
    }

    function mountPayment(form: HTMLFormElement) {
        const container = form.querySelector<HTMLElement>('[data-payment-field]');

        if (container && step === LAST_STEP) payment?.mount(container);
    }

    function readProdsBalance() {
        return getSession()?.prods ?? 0;
    }

    function readProdsCharge() {
        return getProdsCharge(readProdsBalance(), getTotals(getItems(), 0, promo?.discountBasisPoints).totalCents);
    }

    function readShipping(form: HTMLFormElement) {
        return {
            city: readValue(form, 'city'),
            familyName: readValue(form, 'family-name'),
            givenName: readValue(form, 'given-name'),
            line1: readValue(form, 'address-line1'),
            line2: readValue(form, 'address-line2'),
            state: readValue(form, 'state'),
            zip: readValue(form, 'zip'),
        };
    }

    function readValue(form: HTMLFormElement, name: string) {
        const field = form.elements.namedItem(name);

        return field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : '';
    }

    async function refreshCheckout(controls: CheckoutControls, signal: AbortSignal) {
        const issues = await syncCatalog(signal);

        if (!issues || issues.length === 0) return;

        document.documentElement.dataset.cart = getItems().length > 0 ? 'filled' : 'empty';
        renderOrder(controls.form);
        toast(describeCartChange(issues), 'info');
    }

    function renderCardFields(form: HTMLFormElement) {
        const fields = form.querySelector<HTMLFieldSetElement>('[data-card-fields]');

        if (!fields) return;

        fields.disabled = isCardWaived(form);
        fields.toggleAttribute('hidden', payment === null);
        payment?.setReadOnly(fields.disabled);
    }

    function renderCode(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');
        const tag = form.querySelector<HTMLElement>('[data-code-tag]');

        if (!apply || !input || !tag) return;

        applyInstantly(apply, () => {
            apply.disabled = input.value.trim().length === 0;
        });

        tag.toggleAttribute('hidden', promo === null);
        setText(form.querySelector('[data-code-label]'), promo ? `${getDiscountPercent()}% off` : '');
    }

    function renderItems() {
        renderList(
            document.querySelector<HTMLElement>('[data-review-list]'),
            document.querySelector<HTMLTemplateElement>('[data-review-row]'),
            fillReviewRow,
        );

        renderList(
            document.querySelector<HTMLElement>('[data-summary-list]'),
            document.querySelector<HTMLTemplateElement>('[data-summary-row]'),
            fillSummaryRow,
        );
    }

    function renderList(list: HTMLElement | null, template: HTMLTemplateElement | null, fill: (fragment: DocumentFragment, item: CartItem) => void) {
        if (!list || !template) return;

        list.replaceChildren();

        orderItems.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fill(fragment, item);
            list.append(fragment);
        });
    }

    function renderOrder(form: HTMLFormElement) {
        orderItems = getItems().map(item => toCatalogItem(catalog, item));
        renderCode(form);
        renderProds(form);
        renderCardFields(form);
        renderItems();
        renderTotals(form);
    }

    function renderProds(form: HTMLFormElement) {
        const checkbox = form.querySelector<HTMLInputElement>('[name="prods"]');
        const field = form.querySelector<HTMLElement>('[data-prods-field]');

        if (!checkbox || !field) return;

        checkbox.disabled = readProdsCharge() === 0;
        field.toggleAttribute('hidden', getSession() === null);

        if (checkbox.disabled) checkbox.checked = false;

        setText(field.querySelector('[data-prods-balance]'), formatProds(readProdsBalance()));
    }

    function renderTotals(form: HTMLFormElement) {
        const summary = getTotals(getItems(), getProdsApplied(form), promo?.discountBasisPoints);

        const prodsCents = summary.discountCents - summary.promoCents;

        document.querySelectorAll('[data-discount-row]').forEach((row) => {
            row.toggleAttribute('hidden', prodsCents === 0);
        });

        document.querySelectorAll('[data-promo-row]').forEach((row) => {
            row.toggleAttribute('hidden', summary.promoCents === 0);
        });

        payment?.setAmount(summary.totalCents);
        setAll('[data-discount]', `\u2212${formatPrice(prodsCents)}`);
        setAll('[data-promo]', `\u2212${formatPrice(summary.promoCents)}`);
        setAll('[data-shipping]', formatPrice(summary.shippingCents));
        setAll('[data-subtotal]', formatPrice(summary.subtotalCents));
        setAll('[data-tax]', formatPrice(summary.taxCents));
        setAll('[data-total]', formatPrice(summary.totalCents));
    }

    function restoreDraft(form: HTMLFormElement) {
        dropStaleDraft();

        if (!draft) return;

        Object.entries(draft.fields).forEach(([name, value]) => {
            const field = form.elements.namedItem(name);

            if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
        });

        promo = draft.promo;
        step = Math.min(draft.step, SHIPPING_STEP);
    }

    function saveDraft(form: HTMLFormElement, userId: string) {
        draft = {
            fields: Object.fromEntries(Object.keys(STEP_RULES[SHIPPING_STEP]).map(name => [name, readValue(form, name)])),
            promo,
            step,
            userId,
        };

        dropStaleDraft();
    }

    async function sendOrder(form: HTMLFormElement, signal: AbortSignal): Promise<OrderResult | null> {
        const items = orderItems;

        await paymentReady;

        if (signal.aborted) return null;

        const issues = await syncCatalog(signal);

        if (!issues) return null;

        if (issues.length > 0) return { code: 'cart-changed', message: describeCartChange(issues), ok: false };

        const result = await placeOrder({
            email: readValue(form, 'email'),
            items,
            payment: isCardWaived(form) ? null : payment,
            prodsApplied: getProdsApplied(form),
            promo,
            shipping: readShipping(form),
        });

        if (!result.ok && result.code === 'cart-changed') await syncCatalog(signal);

        return result;
    }

    function setAll(selector: string, value: string) {
        document.querySelectorAll(selector).forEach(element => setText(element, value));
    }

    async function submitOrder(controls: CheckoutControls, signal: AbortSignal) {
        isSubmitting = true;
        setPending(controls.nextButton, true);

        const result = await sendOrder(controls.form, signal);

        if (!result) return;

        if (result.ok) {
            await navigate('/store/orders');

            return;
        }

        if (signal.aborted) return;

        isSubmitting = false;
        setPending(controls.nextButton, false);

        if (result.code === 'cart-changed' || result.code === 'empty-cart') blockCheckout(controls);

        controls.nextButton.focus();
        toast(result.message, 'error');
    }

    async function syncCatalog(signal: AbortSignal) {
        const live = await fetchCatalog(catalog);

        if (signal.aborted) return null;

        catalog = live;

        return reconcile(catalog);
    }

    function updateSteps(controls: CheckoutControls, shouldMoveFocus: boolean) {
        controls.steps.forEach((item, index) => {
            item.classList.toggle('bg-bg-page', index > step);
            item.classList.toggle('is-active', index === step);
            item.classList.toggle('step--done', index < step);

            if (index === step) item.setAttribute('aria-current', 'step');
            else item.removeAttribute('aria-current');
        });

        controls.panes.forEach((pane, index) => {
            pane.classList.toggle('hidden', index !== step);
            pane.disabled = index !== step;
        });

        controls.aside.toggleAttribute('hidden', step === REVIEW_STEP);
        controls.backButton.classList.toggle('invisible', step === REVIEW_STEP);
        controls.body.classList.toggle('checkout__body--solo', step === REVIEW_STEP);
        controls.nextButton.textContent = step === LAST_STEP ? 'Place order' : 'Continue';
        renderOrder(controls.form);
        mountPayment(controls.form);

        if (!shouldMoveFocus) return;

        setText(document.querySelector('[data-checkout-announce]'), `Step ${step + 1} of ${CHECKOUT_STEPS.length}, ${CHECKOUT_STEPS[step]}.`);
        focusPane(controls.panes[step]);
    }

    onCartChange(dropStaleDraft);
    onSessionChange(dropStaleDraft);
    registerPageScript(initCheckoutFlow);
</script>
