---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import { CHECKOUT_STEPS, COMMERCE, FIELD_LIMITS, US_STATES } from '@lib/shared/constants';
import { photoKey } from '@lib/commerce/cart';
import { toCatalog } from '@lib/shared/utils';
import { toImageSources, toVariationSlug, toVariations } from '@lib/commerce/products';

type FieldInputMode = 'numeric';

type FieldKind = 'select' | 'text';

type FieldType = 'email' | 'text';

interface CheckoutField {
    autocomplete: string;
    column: string;
    inputmode?: FieldInputMode;
    kind?: FieldKind;
    label: string;
    maxlength?: number;
    name: string;
    pattern?: string;
    placeholder?: string;
    type?: FieldType;
}

const PAYMENT_FIELDS: CheckoutField[] = [
    { autocomplete: 'off', column: 'md:col-span-6', inputmode: 'numeric', label: 'Card number', maxlength: FIELD_LIMITS.card, name: 'cc-number', pattern: '[0-9 ]{13,19}' },
    { autocomplete: 'off', column: 'md:col-span-3', inputmode: 'numeric', label: 'Expiration date', maxlength: FIELD_LIMITS.expiry, name: 'cc-exp', pattern: '(0[1-9]|1[0-2]) ?/ ?[0-9]{2}', placeholder: 'MM / YY' },
    { autocomplete: 'off', column: 'md:col-span-3', inputmode: 'numeric', label: 'Security code', maxlength: FIELD_LIMITS.csc, name: 'cc-csc', pattern: '[0-9]{3,4}' },
    { autocomplete: 'off', column: 'md:col-span-6', label: 'Name on card', maxlength: FIELD_LIMITS.name, name: 'cc-name' },
];

const SHIPPING_FIELDS: CheckoutField[] = [
    { autocomplete: 'given-name', column: 'md:col-span-6', label: 'First name', maxlength: FIELD_LIMITS.name, name: 'given-name' },
    { autocomplete: 'family-name', column: 'md:col-span-6', label: 'Last name', maxlength: FIELD_LIMITS.name, name: 'family-name' },
    { autocomplete: 'email', column: 'md:col-span-12', label: 'Email', maxlength: FIELD_LIMITS.email, name: 'email', type: 'email' },
    { autocomplete: 'street-address', column: 'md:col-span-12', label: 'Street address', maxlength: FIELD_LIMITS.address, name: 'address' },
    { autocomplete: 'address-level2', column: 'md:col-span-12', label: 'City', maxlength: FIELD_LIMITS.name, name: 'city' },
    { autocomplete: 'address-level1', column: 'lg:col-span-7 md:col-span-12', kind: 'select', label: 'State', name: 'state' },
    { autocomplete: 'postal-code', column: 'lg:col-span-5 md:col-span-12', inputmode: 'numeric', label: 'ZIP code', name: 'zip', pattern: '[0-9]{5}(-[0-9]{4})?' },
];

const products = await getCollection('products');
const catalog = toCatalog(products);
const images = await toImageSources();

const variants = Object.fromEntries(products
    .flatMap(product => toVariations(product.data).map(variation => [photoKey(product.id, variation), `${product.data.sku}_${toVariationSlug(variation)}`]))
    .filter(([, key]) => key in images));
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="checkout-title"
>
    <div>
        <PageHead
            class="mb-6 font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Store / Checkout"
            headingId="checkout-title"
        >
            Lock it in.
        </PageHead>
        <p
            class="max-w-2xl mb-10 text-lmd text-ink-muted"
            data-motion="rise"
        >
            Review, shipping, payment &mdash; three steps, and nothing places until you confirm the last one.
        </p>
        <ol
            class="flex border-2 border-ink"
            aria-label="Checkout steps"
            data-motion="rule"
        >
            {CHECKOUT_STEPS.map((step, index) => (
                <li
                    class:list={[
                        'step flex-1 p-4 font-bold font-mono text-xs tracking-wide uppercase',
                        index === 0 ? 'slab--well' : 'bg-surface',
                        index > 0 && 'border-l-2 border-ink',
                    ]}
                    aria-current={index === 0 ? 'step' : undefined}
                >
                    {step}
                </li>
            ))}
        </ol>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Checkout form"
    data-catalog={JSON.stringify(catalog)}
    data-images={JSON.stringify(images)}
    data-variants={JSON.stringify(variants)}
>
    <div
        class="slab slab--card flex flex-col items-start max-w-(--measure-form) w-full gap-4 mx-auto"
        data-checkout-empty
        hidden
    >
        <p class="label text-ink-muted">Empty</p>
        <p class="font-extrabold font-sans text-2xl">There is nothing to check out.</p>
        <a
            class="btn btn--primary"
            href="/store"
        >
            Browse the store
        </a>
    </div>
    <div
        class="checkout__body checkout__body--solo gap-12"
        data-checkout-body
    >
        <form
            class="checkout-form flex flex-col gap-6"
            data-checkout-form
            data-motion="unfold"
        >
            <aside
                class="checkout__notice slab slab--card flex flex-col gap-4"
                aria-label="Cart changes"
                data-checkout-notice
                hidden
                role="status"
            >
                <p class="label text-accent-deep">Your cart changed</p>
                <ul
                    class="checkout__issues list-none"
                    data-checkout-issues
                />
            </aside>
            <fieldset
                class="slab slab--card step-pane"
                aria-labelledby="checkout-review-title"
                data-step="0"
            >
                <h2
                    id="checkout-review-title"
                    class="mb-6 font-extrabold font-sans text-2xl tracking-tight"
                    tabindex="-1"
                >
                    Review
                </h2>
                <ul
                    class="review-list mb-(--space-lg) border-2 border-ink list-none"
                    data-review-list
                />
                <div class="flex flex-col gap-2 mb-(--space-lg)">
                    <div
                        class="checkout__code-entry flex items-end gap-4"
                        data-code-entry
                    >
                        <label class="flex flex-1 flex-col min-w-0 gap-2">
                            <span class="label text-ink-muted">Discount code</span>
                            <input
                                id="checkout-code"
                                class="input font-mono uppercase"
                                aria-describedby="checkout-code-error"
                                aria-invalid="false"
                                autocomplete="off"
                                maxlength={FIELD_LIMITS.code}
                                name="code"
                                placeholder="Enter a code"
                                type="text"
                            />
                        </label>
                        <button
                            class="btn shrink-0"
                            data-code-apply
                            disabled
                            type="button"
                        >
                            Apply
                        </button>
                    </div>
                    <p
                        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 border-2 border-ink"
                        data-code-tag
                        hidden
                    >
                        <span
                            class="label"
                            data-code-label
                        />
                        <button
                            class="action-text checkout__code-remove text-ink-muted"
                            aria-label="Remove the discount code"
                            data-code-remove
                            type="button"
                        >
                            Remove
                        </button>
                    </p>
                    <p
                        id="checkout-code-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
                <dl class="review-totals">
                    <div class="review-totals__row">
                        <dt>Subtotal</dt>
                        <dd data-subtotal>$0.00</dd>
                    </div>
                    <div
                        class="review-totals__row"
                        data-promo-row
                        hidden
                    >
                        <dt>Discount ({COMMERCE.discountCode})</dt>
                        <dd
                            class="whitespace-nowrap"
                            data-promo
                        >
                            $0.00
                        </dd>
                    </div>
                    <div
                        class="review-totals__row"
                        data-discount-row
                        hidden
                    >
                        <dt>Prods credit</dt>
                        <dd data-discount>$0.00</dd>
                    </div>
                    <div class="review-totals__row">
                        <dt>Shipping</dt>
                        <dd data-shipping>$0.00</dd>
                    </div>
                    <div class="review-totals__row">
                        <dt>Tax</dt>
                        <dd data-tax>$0.00</dd>
                    </div>
                    <div class="review-totals__row review-totals__row--total">
                        <dt>Total</dt>
                        <dd
                            aria-live="polite"
                            data-total
                        >
                            $0.00
                        </dd>
                    </div>
                </dl>
            </fieldset>
            <fieldset
                class="slab slab--card step-pane hidden"
                aria-labelledby="checkout-shipping-title"
                data-step="1"
                disabled
            >
                <h2
                    id="checkout-shipping-title"
                    class="mb-6 font-extrabold font-sans text-2xl tracking-tight"
                    tabindex="-1"
                >
                    Shipping
                </h2>
                <div class="checkout__fields grid grid-cols-1 md:grid-cols-12">
                    {SHIPPING_FIELDS.map(field => (
                        <div class:list={['flex flex-col gap-2', field.column]}>
                            <label class="flex flex-col gap-2">
                                <span class="label text-ink-muted">{field.label}</span>
                                {field.kind === 'select'
                                    ? (
                                            <span class="select">
                                                <select
                                                    id={`checkout-${field.name}`}
                                                    class="input"
                                                    aria-describedby={`checkout-${field.name}-error`}
                                                    aria-invalid="false"
                                                    autocomplete={field.autocomplete}
                                                    name={field.name}
                                                    required
                                                >
                                                    <option value="">Choose&hellip;</option>
                                                    {US_STATES.map(state => (
                                                        <option value={state.code}>{state.name}</option>
                                                    ))}
                                                </select>
                                            </span>
                                        )
                                    : (
                                            <input
                                                id={`checkout-${field.name}`}
                                                class="input"
                                                aria-describedby={`checkout-${field.name}-error`}
                                                aria-invalid="false"
                                                autocomplete={field.autocomplete}
                                                inputmode={field.inputmode}
                                                maxlength={field.maxlength}
                                                name={field.name}
                                                pattern={field.pattern}
                                                placeholder={field.placeholder}
                                                required
                                                type={field.type ?? 'text'}
                                            />
                                        )}
                            </label>
                            <p
                                id={`checkout-${field.name}-error`}
                                class="action-text text-accent-deep"
                                data-field-error
                                hidden
                            />
                        </div>
                    ))}
                </div>
            </fieldset>
            <fieldset
                class="slab slab--card step-pane hidden"
                aria-labelledby="checkout-payment-title"
                data-step="2"
                disabled
            >
                <h2
                    id="checkout-payment-title"
                    class="mb-6 font-extrabold font-sans text-2xl tracking-tight"
                    tabindex="-1"
                >
                    Payment
                </h2>
                <div
                    class="checkout__prods mb-(--space-lg)"
                    data-prods-field
                    hidden
                >
                    <label class="checkout__check">
                        <input
                            id="checkout-prods"
                            class="box"
                            name="prods"
                            type="checkbox"
                        />
                        <span>Pay with Prods</span>
                    </label>
                    <p class="checkout__prods-meta">
                        <span
                            class="label"
                            data-prods-balance
                        />
                        <span
                            class="checkout__note"
                            data-prods-note
                        />
                    </p>
                </div>
                <fieldset
                    class="checkout__card-fields mb-(--space-lg)"
                    data-card-fields
                >
                    <legend class="sr-only">Card details</legend>
                    <div class="checkout__fields grid grid-cols-1 md:grid-cols-6">
                        {PAYMENT_FIELDS.map(field => (
                            <div class:list={['flex flex-col gap-2', field.column]}>
                                <label class="flex flex-col gap-2">
                                    <span class="label text-ink-muted">{field.label}</span>
                                    <input
                                        id={`checkout-${field.name}`}
                                        class="input font-mono text-sm"
                                        aria-describedby={`checkout-${field.name}-error`}
                                        aria-invalid="false"
                                        autocomplete={field.autocomplete}
                                        inputmode={field.inputmode}
                                        maxlength={field.maxlength}
                                        name={field.name}
                                        pattern={field.pattern}
                                        placeholder={field.placeholder}
                                        required
                                        type="text"
                                    />
                                </label>
                                <p
                                    id={`checkout-${field.name}-error`}
                                    class="action-text text-accent-deep"
                                    data-field-error
                                    hidden
                                />
                            </div>
                        ))}
                    </div>
                </fieldset>
                <div class="checkout__check-field">
                    <label class="checkout__check">
                        <input
                            id="checkout-terms"
                            class="box"
                            aria-describedby="checkout-terms-error"
                            aria-invalid="false"
                            name="terms"
                            required
                            type="checkbox"
                        />
                        <span>
                            I accept the&#32;
                            <a
                                class="hover:text-accent-deep decoration-2 decoration-accent font-bold underline underline-offset-4"
                                href="/terms"
                            >
                                terms of service
                            </a>.
                        </span>
                    </label>
                    <p
                        id="checkout-terms-error"
                        class="action-text text-accent-deep"
                        data-field-error
                        hidden
                    />
                </div>
            </fieldset>
            <div class="flex flex-wrap justify-between gap-4">
                <button
                    class="btn checkout-back invisible"
                    type="button"
                >
                    Back
                </button>
                <button
                    class="btn btn--primary checkout-next"
                    type="submit"
                >
                    Continue
                </button>
            </div>
            <p
                class="sr-only"
                aria-live="polite"
                data-checkout-announce
            />
        </form>
        <aside
            class="checkout__aside slab slab--sunk self-start"
            aria-label="Order summary"
            data-checkout-aside
            hidden
        >
            <h2 class="label mb-4 text-ink-muted">Summary</h2>
            <ul
                class="checkout__summary scroll-slot mb-4 list-none text-sm"
                data-summary-list
            />
            <dl class="flex flex-col gap-2 pt-4 border-t-2 border-ink font-mono text-sm">
                <div class="flex justify-between gap-3">
                    <dt>Subtotal</dt>
                    <dd data-subtotal>$0.00</dd>
                </div>
                <div
                    class="flex justify-between gap-3"
                    data-promo-row
                    hidden
                >
                    <dt>Discount ({COMMERCE.discountCode})</dt>
                    <dd
                        class="whitespace-nowrap"
                        data-promo
                    >
                        $0.00
                    </dd>
                </div>
                <div
                    class="flex justify-between gap-3"
                    data-discount-row
                    hidden
                >
                    <dt>Prods credit</dt>
                    <dd data-discount>$0.00</dd>
                </div>
                <div class="flex justify-between gap-3">
                    <dt>Shipping</dt>
                    <dd data-shipping>$0.00</dd>
                </div>
                <div class="flex justify-between gap-3 mb-2">
                    <dt>Tax</dt>
                    <dd data-tax>$0.00</dd>
                </div>
                <div class="flex justify-between gap-3 pt-2 border-t-2 border-ink font-extrabold font-sans text-lg">
                    <dt>Total</dt>
                    <dd
                        aria-live="polite"
                        data-total
                    >
                        $0.00
                    </dd>
                </div>
            </dl>
        </aside>
    </div>
    <template data-issue-row>
        <li class="flex gap-2 text-sm text-ink-muted">
            <span
                class="font-bold text-accent-deep"
                aria-hidden="true"
            >
                &middot;
            </span>
            <span
                class="min-w-0"
                data-issue-text
            />
        </li>
    </template>
    <template data-review-row>
        <li class="review-row first:border-t-0 border-t-2 border-ink">
            <img
                class="object-cover self-center shrink-0 h-16 w-16 border-2 border-ink"
                alt=""
                data-review-photo
                hidden
                loading="lazy"
            />
            <div class="review-row__body">
                <p
                    class="font-bold font-sans text-lmd"
                    data-review-title
                />
                <p class="review-row__meta">
                    <span
                        class="label min-w-0 text-ink-muted"
                        data-review-variant
                    />
                    <span
                        class="label review-row__qty"
                        data-review-qty
                    />
                </p>
            </div>
            <p
                class="review-row__price font-bold font-mono text-lmd"
                data-review-price
            />
        </li>
    </template>
    <template data-summary-row>
        <li class="flex items-center justify-between gap-2 mb-3">
            <span class="flex items-center min-w-0 gap-2">
                <img
                    class="object-cover shrink-0 h-8 w-8 border-2 border-ink"
                    alt=""
                    data-summary-photo
                    hidden
                    loading="lazy"
                />
                <span
                    class="min-w-0"
                    data-summary-title
                />
            </span>
            <span
                class="font-bold font-mono"
                data-summary-price
            />
        </li>
    </template>
</section>

<style>
    .checkout__aside {
        position: sticky;
        top: calc(var(--header-height) + var(--space-md));
    }

    .checkout__body {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .checkout__body--solo {
        grid-template-columns: minmax(0, 1fr);
    }

    .checkout__card-fields:disabled {
        opacity: 0.55;
    }

    .checkout__card-fields:disabled .input {
        opacity: 1;
    }

    .checkout__check {
        align-items: center;
        align-self: flex-start;
        display: flex;
        font-size: var(--text-smd);
        gap: var(--space-xs);
        min-height: var(--control-size);
        padding-block: var(--space-2xs);
    }

    .checkout__check-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .checkout__code-entry:has(.input[aria-invalid='true']) .btn {
        border-color: var(--color-accent-deep);
        color: var(--color-accent-deep);
    }

    .checkout__code-remove {
        min-height: var(--control-size);
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
    }

    .checkout__fields {
        column-gap: var(--space-sm);
        row-gap: var(--space-md);
    }

    .checkout__issues {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .checkout__note {
        color: var(--color-ink-muted);
        font-size: var(--text-sm);
    }

    .checkout__notice {
        border-left: 2px solid var(--color-accent-deep);
    }

    .checkout__prods {
        align-items: center;
        border: 2px solid var(--color-ink);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-sm);
        justify-content: space-between;
        padding: var(--space-2xs) var(--space-sm);
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .checkout__prods:has(.box:checked) {
        background-color: var(--color-surface-sunken);
    }

    .checkout__prods:has(.box:disabled) {
        cursor: not-allowed;
    }

    .checkout__prods-meta {
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
    }

    .checkout__summary {
        --scroll-slot-max: 40vh;
    }

    .review-row {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        justify-content: space-between;
        padding: var(--space-md);
    }

    .review-row__body {
        display: flex;
        flex: 1 1 88px;
        flex-direction: column;
        gap: var(--space-2xs);
        min-width: 0;
    }

    .review-row__meta {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs);
    }

    .review-row__price {
        margin-inline-start: auto;
        white-space: nowrap;
    }

    .review-row__qty {
        border: 1px solid var(--color-ink-20);
        font-weight: 700;
        padding: var(--space-3xs) var(--space-2xs);
    }

    .review-totals {
        border-top: 2px solid var(--color-ink);
        display: flex;
        flex-direction: column;
        font-family: var(--font-mono);
        gap: var(--space-2xs);
        padding-top: var(--space-sm);
    }

    .review-totals__row {
        display: flex;
        gap: var(--space-sm);
        justify-content: space-between;
    }

    .review-totals__row--total {
        border-top: 2px solid var(--color-ink);
        font-family: var(--font-sans);
        font-size: var(--text-2xl);
        font-weight: 800;
        letter-spacing: -0.02em;
        padding-top: var(--space-sm);
    }

    .step--done {
        background: var(--color-surface-sunken);
        color: var(--color-ink-muted);
    }

    .step--done::before {
        content: '\2713\00a0';
    }

    .step-pane {
        min-width: 0;
        padding: var(--space-lg);
    }

    @media (max-width: 768px) {
        .checkout__body {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { CHECKOUT_STEPS, COMMERCE, EMAIL_PATTERN, FIELD_LIMITS } from '@lib/shared/constants';
    import { clearFieldErrors, focusFirstError, isValidationBypassed, renderIssueList, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { formatPrice, formatProds, formatVariant, parseCatalog, parseImageSources, registerPageScript, setPending, setProductImage, setText } from '@lib/shared/utils';
    import { getItems, isPromoCode, photoKey, prodsForCents, prodsToCents, reconcile, totals } from '@lib/commerce/cart';
    import { getSession } from '@lib/account/session';
    import { placeOrder } from '@lib/commerce/checkout';
    import { toast } from '@lib/ui/toasts';

    interface CheckoutControls {
        aside: HTMLElement;
        backButton: HTMLButtonElement;
        body: HTMLElement;
        form: HTMLFormElement;
        nextButton: HTMLButtonElement;
        panes: NodeListOf<HTMLFieldSetElement>;
        steps: NodeListOf<HTMLElement>;
    }

    const ADDRESS_MIN = 5;
    const BASIS_POINTS_PER_PERCENT = 100;
    const CARD_FIELDS = ['cc-csc', 'cc-exp', 'cc-name', 'cc-number'];
    const CARD_PATTERN = /^\d{13,19}$/;
    const CENTURY = 2_000;
    const CITY_MIN = 2;
    const CODE_MESSAGE = 'That code is not valid.';
    const CSC_PATTERN = /^\d{3,4}$/;
    const EXPIRY_PATTERN = /^(0[1-9]|1[0-2]) ?\/ ?(\d{2})$/;
    const LAST_STEP = 2;
    const MAX_EXPIRY_YEARS = 20;
    const REVIEW_STEP = 0;
    const ZIP_PATTERN = /^\d{5}(-\d{4})?$/;

    const CARD_RULES: Record<string, FieldRule> = {
        'cc-csc': { message: 'Enter the three or four digit security code.', pattern: CSC_PATTERN, required: true },
        'cc-exp': { message: 'Use MM / YY, this month or later.', required: true, validate: isFutureExpiry },
        'cc-name': { max: FIELD_LIMITS.name, message: 'Enter the name on the card.', required: true },
        'cc-number': { message: 'Enter the digits on your card.', required: true, validate: isCardFormat },
    };

    const STEP_RULES: Record<string, FieldRule>[] = [
        {},
        {
            'address': { max: FIELD_LIMITS.address, message: 'Enter your street address.', min: ADDRESS_MIN, required: true },
            'city': { max: FIELD_LIMITS.name, message: 'Enter your city.', min: CITY_MIN, required: true },
            'email': { max: FIELD_LIMITS.email, message: 'Enter a valid email address.', pattern: EMAIL_PATTERN, required: true },
            'family-name': { max: FIELD_LIMITS.name, message: 'Enter your last name.', required: true },
            'given-name': { max: FIELD_LIMITS.name, message: 'Enter your first name.', required: true },
            'state': { message: 'Choose your state.', required: true },
            'zip': { message: 'Enter a five-digit ZIP code.', pattern: ZIP_PATTERN, required: true },
        },
        {
            terms: { message: 'Accept the terms to place the order.', required: true },
        },
    ];

    let blocked = false;
    let catalog: CatalogEntry[] = [];
    let images: ImageSources = {};
    let orderItems: CartItem[] = [];
    let promoCode = '';
    let step = REVIEW_STEP;
    let variants: ImageSources = {};

    function clearCardFields(form: HTMLFormElement) {
        CARD_FIELDS.forEach((name) => {
            const field = form.elements.namedItem(name);

            if (field instanceof HTMLInputElement) field.value = '';
        });
    }

    function describeProds(balance: number, charge: number) {
        if (balance === 0) return 'No Prods yet \u2014 earn them at events and on orders.';
        if (isFullyCovered()) return 'Covers this order in full.';

        return `Applies ${formatPrice(prodsToCents(charge))} toward this order \u2014 your card covers the rest.`;
    }

    function discountPercent() {
        return COMMERCE.discountBasisPoints / BASIS_POINTS_PER_PERCENT;
    }

    function fillReviewRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-review-photo]'), images, item);
        setText(fragment.querySelector('[data-review-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-review-qty]'), `\u00d7 ${item.quantity}`);
        setText(fragment.querySelector('[data-review-title]'), item.title);
        setText(fragment.querySelector('[data-review-variant]'), formatVariant(item));
    }

    function fillSummaryRow(fragment: DocumentFragment, item: CartItem) {
        setProductImage(fragment.querySelector<HTMLImageElement>('[data-summary-photo]'), images, item);
        setText(fragment.querySelector('[data-summary-price]'), formatPrice(item.priceCents * item.quantity));
        setText(fragment.querySelector('[data-summary-title]'), `${item.quantity} \u00d7 ${item.title} \u2014 ${formatVariant(item)}`);
    }

    function focusPane(pane: HTMLFieldSetElement | undefined) {
        if (!pane) return;

        const controls = Array.from(pane.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));

        const control = controls.find(element => !element.disabled && element.offsetParent !== null);

        (control ?? pane.querySelector<HTMLElement>('[tabindex="-1"]'))?.focus();
    }

    function getProdsApplied(form: HTMLFormElement) {
        return isProdsEngaged(form) ? getProdsCharge() : 0;
    }

    function getProdsBalance() {
        return getSession()?.prods ?? 0;
    }

    function getProdsCharge() {
        return Math.min(getProdsBalance(), prodsForCents(totals(getItems(), 0, promoCode).totalCents));
    }

    function getStepRules(form: HTMLFormElement) {
        if (step !== LAST_STEP || isCardWaived(form)) return STEP_RULES[step];

        return { ...CARD_RULES, ...STEP_RULES[step] };
    }

    function handleBackClick(controls: CheckoutControls) {
        if (blocked) {
            blocked = false;
            renderIssues([]);
        }

        step = Math.max(REVIEW_STEP, step - 1);
        updateSteps(controls, true);
    }

    function handleCardInput(input: HTMLInputElement) {
        input.value = input.value.replace(/[^\d ]/g, '');
    }

    function handleCodeApply(form: HTMLFormElement) {
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!input || input.value.trim().length === 0) return;

        if (!isPromoCode(input.value)) {
            setFieldErrors(form, { code: CODE_MESSAGE });
            input.focus();

            return;
        }

        clearFieldErrors(form);
        input.value = '';
        promoCode = COMMERCE.discountCode;
        renderOrder(form);
        toast(`${COMMERCE.discountCode} applied \u2014 ${discountPercent()}% off your subtotal.`, 'success');
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.focus();
    }

    function handleCodeInput(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');

        if (!apply || !input) return;

        apply.disabled = input.value.trim().length === 0;

        if (input.getAttribute('aria-invalid') === 'true') clearFieldErrors(form);
    }

    function handleCodeKeydown(event: KeyboardEvent, form: HTMLFormElement) {
        if (event.key !== 'Enter') return;

        event.preventDefault();
        handleCodeApply(form);
    }

    function handleCodeRemove(form: HTMLFormElement) {
        promoCode = '';
        clearFieldErrors(form);
        renderOrder(form);
        toast('Discount code removed.', 'info');
        form.querySelector<HTMLInputElement>('[name="code"]')?.focus();
    }

    async function handleFormSubmit(event: SubmitEvent, controls: CheckoutControls) {
        event.preventDefault();

        const bypass = isValidationBypassed();

        if (blocked && !bypass) {
            await navigate('/store/cart');

            return;
        }

        blocked = false;

        const errors = validateFields(controls.form, getStepRules(controls.form));

        clearFieldErrors(controls.form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(controls.form, errors);
            focusFirstError(controls.form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        if (step < LAST_STEP) {
            step += 1;
            updateSteps(controls, true);

            return;
        }

        await submitOrder(controls, bypass);
    }

    function handleProdsToggle(form: HTMLFormElement) {
        clearFieldErrors(form);
        renderCardFields(form);
        renderTotals(form);
    }

    function initCheckoutFlow(signal: AbortSignal) {
        const aside = document.querySelector<HTMLElement>('[data-checkout-aside]');
        const backButton = document.querySelector<HTMLButtonElement>('.checkout-back');
        const body = document.querySelector<HTMLElement>('[data-checkout-body]');
        const empty = document.querySelector<HTMLElement>('[data-checkout-empty]');
        const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
        const nextButton = document.querySelector<HTMLButtonElement>('.checkout-next');
        const source = document.querySelector<HTMLElement>('[data-catalog]');

        if (!aside || !backButton || !body || !form || !nextButton) return;

        const codeInput = form.querySelector<HTMLInputElement>('[name="code"]');

        const controls: CheckoutControls = {
            aside,
            backButton,
            body,
            form,
            nextButton,
            panes: document.querySelectorAll<HTMLFieldSetElement>('.step-pane'),
            steps: document.querySelectorAll<HTMLElement>('.step'),
        };

        blocked = false;
        catalog = parseCatalog(source?.dataset.catalog);
        images = parseImageSources(source?.dataset.images);
        promoCode = '';
        step = REVIEW_STEP;
        variants = parseImageSources(source?.dataset.variants);
        form.noValidate = true;

        if (getItems().length === 0) {
            body.setAttribute('hidden', '');
            empty?.removeAttribute('hidden');

            return;
        }

        updateSteps(controls, false);
        backButton.addEventListener('click', () => handleBackClick(controls), { signal });
        form.addEventListener('submit', event => void handleFormSubmit(event, controls), { signal });
        signal.addEventListener('abort', () => clearCardFields(form), { once: true });

        form.querySelectorAll<HTMLInputElement>('[name="cc-number"], [name="cc-csc"]').forEach((input) => {
            input.addEventListener('input', () => handleCardInput(input), { signal });
        });

        codeInput?.addEventListener('input', () => handleCodeInput(form), { signal });
        codeInput?.addEventListener('keydown', event => handleCodeKeydown(event, form), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-apply]')?.addEventListener('click', () => handleCodeApply(form), { signal });
        form.querySelector<HTMLButtonElement>('[data-code-remove]')?.addEventListener('click', () => handleCodeRemove(form), { signal });
        form.querySelector<HTMLInputElement>('[name="prods"]')?.addEventListener('change', () => handleProdsToggle(form), { signal });
    }

    function isCardFormat(value: string) {
        return CARD_PATTERN.test(value.replace(/\s/g, ''));
    }

    function isCardWaived(form: HTMLFormElement) {
        return isProdsEngaged(form) && isFullyCovered();
    }

    function isFullyCovered() {
        const charge = getProdsCharge();

        return charge > 0 && totals(getItems(), charge, promoCode).totalCents === 0;
    }

    function isFutureExpiry(value: string) {
        const match = EXPIRY_PATTERN.exec(value);

        if (!match) return false;

        const now = new Date();
        const expiry = new Date(CENTURY + Number(match[2]), Number(match[1]), 1);

        const limit = new Date(now.getFullYear() + MAX_EXPIRY_YEARS, now.getMonth(), 1);

        return expiry > now && expiry <= limit;
    }

    function isProdsEngaged(form: HTMLFormElement) {
        const checkbox = form.elements.namedItem('prods');

        return checkbox instanceof HTMLInputElement && checkbox.checked && !checkbox.disabled;
    }

    function readValue(form: HTMLFormElement, name: string) {
        const field = form.elements.namedItem(name);

        return field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : '';
    }

    function renderCardFields(form: HTMLFormElement) {
        const fields = form.querySelector<HTMLFieldSetElement>('[data-card-fields]');

        if (!fields) return;

        fields.disabled = isCardWaived(form);
    }

    function renderCode(form: HTMLFormElement) {
        const apply = form.querySelector<HTMLButtonElement>('[data-code-apply]');
        const entry = form.querySelector<HTMLElement>('[data-code-entry]');
        const input = form.querySelector<HTMLInputElement>('[name="code"]');
        const tag = form.querySelector<HTMLElement>('[data-code-tag]');

        if (!apply || !entry || !input || !tag) return;

        const applied = promoCode.length > 0;

        apply.disabled = input.value.trim().length === 0;
        entry.toggleAttribute('hidden', applied);
        tag.toggleAttribute('hidden', !applied);
        setText(form.querySelector('[data-code-label]'), applied ? `${promoCode} \u00b7 ${discountPercent()}% off` : '');
    }

    function renderIssues(issues: CartIssue[]) {
        renderIssueList(
            issues,
            document.querySelector<HTMLElement>('[data-checkout-notice]'),
            document.querySelector<HTMLElement>('[data-checkout-issues]'),
            document.querySelector<HTMLTemplateElement>('[data-issue-row]'),
        );
    }

    function renderItems() {
        renderList(
            document.querySelector<HTMLElement>('[data-review-list]'),
            document.querySelector<HTMLTemplateElement>('[data-review-row]'),
            fillReviewRow,
        );
        renderList(
            document.querySelector<HTMLElement>('[data-summary-list]'),
            document.querySelector<HTMLTemplateElement>('[data-summary-row]'),
            fillSummaryRow,
        );
    }

    function renderList(list: HTMLElement | null, template: HTMLTemplateElement | null, fill: (fragment: DocumentFragment, item: CartItem) => void) {
        if (!list || !template) return;

        list.replaceChildren();

        orderItems.forEach((item) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            fill(fragment, item);
            list.append(fragment);
        });
    }

    function renderOrder(form: HTMLFormElement) {
        orderItems = getItems().map(toPhotoItem);
        renderCode(form);
        renderProds(form);
        renderCardFields(form);
        renderItems();
        renderTotals(form);
    }

    function renderProds(form: HTMLFormElement) {
        const checkbox = form.querySelector<HTMLInputElement>('[name="prods"]');
        const field = form.querySelector<HTMLElement>('[data-prods-field]');

        if (!checkbox || !field) return;

        const balance = getProdsBalance();
        const charge = getProdsCharge();

        field.toggleAttribute('hidden', getSession() === null);
        checkbox.disabled = balance === 0;

        if (checkbox.disabled) checkbox.checked = false;

        setText(field.querySelector('[data-prods-balance]'), `${formatProds(balance)} \u00b7 ${formatPrice(prodsToCents(balance))}`);
        setText(field.querySelector('[data-prods-note]'), describeProds(balance, charge));
    }

    function renderTotals(form: HTMLFormElement) {
        const summary = totals(getItems(), getProdsApplied(form), promoCode);

        const prodsCents = summary.discountCents - summary.promoCents;

        document.querySelectorAll('[data-discount-row]').forEach((row) => {
            row.toggleAttribute('hidden', prodsCents === 0);
        });

        document.querySelectorAll('[data-promo-row]').forEach((row) => {
            row.toggleAttribute('hidden', summary.promoCents === 0);
        });

        setAll('[data-discount]', `\u2212${formatPrice(prodsCents)}`);
        setAll('[data-promo]', `\u2212${formatPrice(summary.promoCents)}`);
        setAll('[data-shipping]', formatPrice(summary.shippingCents));
        setAll('[data-subtotal]', formatPrice(summary.subtotalCents));
        setAll('[data-tax]', formatPrice(summary.taxCents));
        setAll('[data-total]', formatPrice(summary.totalCents));
    }

    function setAll(selector: string, value: string) {
        document.querySelectorAll(selector).forEach(element => setText(element, value));
    }

    async function submitOrder(controls: CheckoutControls, bypass: boolean) {
        const issues = reconcile(catalog);

        if (issues.length > 0 && !bypass) {
            blocked = true;
            renderIssues(issues);
            renderOrder(controls.form);
            controls.nextButton.textContent = 'Back to cart';

            return;
        }

        setPending(controls.nextButton, true);

        const result = await placeOrder({
            cardNumber: readValue(controls.form, 'cc-number'),
            email: readValue(controls.form, 'email'),
            items: orderItems,
            prodsApplied: getProdsApplied(controls.form),
            promoCode,
        });

        setPending(controls.nextButton, false);

        if (!result.ok) {
            blocked = true;
            controls.nextButton.textContent = 'Back to cart';
            toast(result.message, 'error');

            return;
        }

        clearCardFields(controls.form);

        await navigate('/store/orders');
    }

    function toPhotoItem(item: CartItem): CartItem {
        const image = variants[photoKey(item.productSlug, item.variation)];

        return image ? { ...item, image } : item;
    }

    function updateSteps(controls: CheckoutControls, moveFocus: boolean) {
        controls.steps.forEach((item, index) => {
            item.classList.toggle('slab--well', index === step);
            item.classList.toggle('step--done', index < step);
            item.classList.toggle('bg-surface', index > step);

            if (index === step) item.setAttribute('aria-current', 'step');
            else item.removeAttribute('aria-current');
        });

        controls.panes.forEach((pane, index) => {
            pane.classList.toggle('hidden', index !== step);
            pane.disabled = index !== step;
        });

        controls.aside.toggleAttribute('hidden', step === REVIEW_STEP);
        controls.backButton.classList.toggle('invisible', step === REVIEW_STEP);
        controls.body.classList.toggle('checkout__body--solo', step === REVIEW_STEP);
        controls.nextButton.textContent = step === LAST_STEP ? 'Place order' : 'Continue';
        renderOrder(controls.form);

        if (!moveFocus) return;

        setText(document.querySelector('[data-checkout-announce]'), `Step ${step + 1} of ${CHECKOUT_STEPS.length}, ${CHECKOUT_STEPS[step]}`);
        focusPane(controls.panes[step]);
    }

    registerPageScript(initCheckoutFlow);
</script>
