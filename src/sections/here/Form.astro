---
import { getCollection } from 'astro:content';

import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import QrCode from '@components/shared/QrCode.astro';
import Schedule from '@components/program/Schedule.astro';
import { EMAIL_MAX_LENGTH } from '@lib/shared/constants';
import { formatDateStamp, formatTime, formatVenue, getProgram, mergeCalendar } from '@lib/shared/utils';

const DOOR_HOST_PARTS = ['austinproducer', 'alliance.com'];
const DOOR_PATH = 'here';

const bashEditions = await getCollection('bash');
const events = await getCollection('events');

const doorUrl = `${DOOR_HOST_PARTS.join('')}/${DOOR_PATH}`;

const { upcoming } = mergeCalendar(events, bashEditions);
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="checkin-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-3xl text-5xl-7xl text-balance"
            headingId="checkin-title"
        >
            You made it
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            This is where the welcome code at the door sends you. Leave an address and the
            Alliance opens your account with your first Prod already on it.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-label="Door pass"
>
    <div class="rank rank--2 items-stretch">
        <aside
            class="mark"
            aria-label="What you scanned"
            data-motion="wipe"
        >
            <div class="door-pass__panel slab slab--plush slab--well flex flex-col h-full gap-(--space-lg)">
                <div class="flex flex-col gap-(--space-lg) mb-auto">
                    <p class="font-mono text-base-lg wrap-break-word text-link-on-inverse">
                        {DOOR_HOST_PARTS[0]}<wbr />{DOOR_HOST_PARTS[1]}/<wbr />{DOOR_PATH}
                    </p>
                    {upcoming.map((event, index) => (
                        <dl
                            class="door-pass__rows flex flex-col pt-(--space-md) bg-repeat-x bg-top-left"
                            data-event-end={event.end.toISOString()}
                            data-event-group="door"
                            data-event-role="next"
                            data-event-title={`${getProgram(event.type).name} on ${formatDateStamp(event.date)}`}
                            hidden={index > 0}
                        >
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">Program</dt>
                                <dd class="text-base">
                                    {getProgram(event.type).name}
                                </dd>
                            </div>
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">When</dt>
                                <dd class="font-mono text-base">
                                    <time datetime={event.date.toISOString()}>
                                        {formatDateStamp(event.date)}, {formatTime(event.date)}
                                    </time>
                                </dd>
                            </div>
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">Where</dt>
                                <dd class="font-mono text-base">
                                    {formatVenue(event.location)}
                                </dd>
                            </div>
                        </dl>
                    ))}
                </div>
                <div class="door-pass__foot flex flex-wrap items-center justify-between gap-3 pt-(--space-md) bg-repeat-x bg-top-left">
                    <p class="label px-2 py-1 border-2 border-link-on-inverse text-link-on-inverse">Checked</p>
                    <p class="label text-text-inverse-secondary">1 Prod on arrival</p>
                </div>
            </div>
        </aside>
        <div
            class="door-scan slab slab--card slab--plush flex items-center justify-center"
            data-motion="rise"
        >
            <QrCode
                caption="Scan to check in"
                data={doorUrl}
                label={`QR code for ${doorUrl}`}
            />
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Check in"
>
    <form
        class="checkin-form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
        data-checkin-form
        data-motion="unfold"
    >
        <h2 class="text-2xl">
            Check in
        </h2>
        <div class="flex flex-col gap-2">
            <label class="flex flex-col gap-2">
                <span class="label flex flex-wrap items-baseline text-text">
                    <span class="pr-2 text-link">1</span>
                    Email
                </span>
                <input
                    id="checkin-email"
                    class="input font-mono"
                    aria-describedby="checkin-email-error"
                    aria-invalid="false"
                    autocomplete="email"
                    maxlength={EMAIL_MAX_LENGTH}
                    name="email"
                    required
                    type="email"
                />
            </label>
            <p
                id="checkin-email-error"
                class="text-error-text"
                data-field-error
                hidden
            />
        </div>
        <div class="flex flex-col gap-2">
            <p class="label flex flex-wrap items-baseline text-text">
                <span class="pr-2 text-link">2</span>
                Terms
            </p>
            <label class="self-start gap-3 py-2 text-sm">
                <input
                    id="checkin-terms"
                    class="box"
                    aria-describedby="checkin-terms-error"
                    aria-invalid="false"
                    name="terms"
                    required
                    type="checkbox"
                />
                <span>
                    I accept the&#32;
                    <a
                        class="active:translate-y-px hover:text-link inline-block font-mono underline underline-offset-4 transition-[color,translate]"
                        href="/terms"
                    >
                        terms
                    </a>
                </span>
            </label>
            <p
                id="checkin-terms-error"
                class="text-error-text"
                data-field-error
                hidden
            />
        </div>
        <div class="flex flex-col gap-2">
            <p class="label flex flex-wrap items-baseline text-text">
                <span class="pr-2 text-link">3</span>
                Newsletter
            </p>
            <label class="self-start gap-3 py-2 text-sm">
                <input
                    id="checkin-newsletter"
                    class="box"
                    checked
                    name="newsletter"
                    type="checkbox"
                />
                Add me to the seasonal newsletter
            </label>
        </div>
        <button
            class="btn btn--primary w-full"
            type="submit"
        >
            Check in <IconArrow />
        </button>
    </form>
    <div
        class="flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
        data-checkin-done
        hidden
    >
        <div class="checkin__receipt slab slab--card slab--plush flex flex-col gap-(--space-lg)">
            <hgroup class="flex flex-col gap-3">
                <h2
                    class="font-display text-3xl"
                    data-checkin-heading
                    tabindex="-1"
                >
                    You are checked in
                </h2>
                <p class="text-lg text-text-secondary">
                    An account is open for&#32;
                    <span
                        class="font-mono text-base wrap-anywhere"
                        data-checkin-email
                    />&#32;
                    with&#32;
                    <span
                        class="font-mono text-base"
                        data-checkin-prods
                    />&#32;
                    on it.&#32;
                    <span data-checkin-newsletter />
                </p>
            </hgroup>
            <p class="p-3 bg-signal text-text-on-signal">
                Your welcome email is below.
            </p>
            <div class="flex flex-wrap gap-3 pt-(--space-md) border-border-strong border-t-2">
                <button
                    class="btn"
                    data-checkin-again
                    type="button"
                >
                    Check in another address
                </button>
            </div>
        </div>
        <article
            class="mail slab slab--lift slab--plush flex flex-col gap-(--space-lg)"
            aria-label="Welcome email"
        >
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b-2 border-border-strong">
                <p class="label text-link">Welcome email</p>
                <p class="label px-2 py-1 border-2 border-link text-link">Sent</p>
            </div>
            <dl class="flex flex-col">
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">From</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-from
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">To</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-to
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">Reply to</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-reply
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">Subject</dt>
                    <dd
                        class="font-bold leading-(--text-xl) text-lg"
                        data-mail-subject
                    />
                </div>
            </dl>
            <p
                class="text-base text-text-secondary"
                data-mail-preheader
            />
            <div
                class="flex flex-col gap-4"
                data-mail-body
            />
            <div class="mail__actions flex flex-wrap items-center gap-3 pt-(--space-md) bg-repeat-x bg-top-left">
                <a
                    class="btn btn--accent"
                    data-mail-action
                    href="/onboarding"
                >
                    Finish profile
                </a>
                <p class="label text-text-secondary">Link lasts 24 hours</p>
            </div>
        </article>
        <template data-mail-template>
            <p />
        </template>
    </div>
</section>

<Schedule />

<style>
    .door-pass__foot,
    .door-pass__rows {
        background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
        background-size: var(--halftone-pitch) 2px;
    }

    .mail__actions {
        background-image: radial-gradient(circle, var(--color-border-subtle) 1px, transparent 1px);
        background-size: var(--halftone-pitch) 2px;
    }
</style>

<script>
    import { clearFieldErrors, focusFirstError, readEmail, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { composeOnboardingEmail } from '@lib/shared/email';
    import { createOnboardingToken } from '@lib/account/onboarding';
    import { formatProds, registerPageScript, setPending, setText } from '@lib/shared/utils';
    import { startSession } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        terms: { message: 'Accept the terms to check in.', required: true },
    };

    function handleCheckInAgain(form: HTMLFormElement, done: HTMLElement) {
        done.setAttribute('hidden', '');
        form.removeAttribute('hidden');
        form.querySelector<HTMLInputElement>('[name="email"]')?.focus();
    }

    async function handleCheckInSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const errors = validateFields(form, RULES);
        const values = new FormData(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        const result = await startSession({ email: readEmail(values) });

        setPending(button, false);

        if (!result.ok) {
            setFieldErrors(form, { email: result.message });
            focusFirstError(form, { email: result.message });

            return;
        }

        renderCheckIn(form, result.session, values.get('newsletter') !== null);
    }

    function initCheckInForm(signal: AbortSignal) {
        const again = document.querySelector<HTMLButtonElement>('[data-checkin-again]');
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');
        const form = document.querySelector<HTMLFormElement>('[data-checkin-form]');

        if (!done || !form) return;

        form.noValidate = true;
        again?.addEventListener('click', () => handleCheckInAgain(form, done), { signal });
        form.addEventListener('submit', event => handleCheckInSubmit(event, form), { signal });
    }

    function renderBody(container: HTMLElement, template: HTMLTemplateElement, paragraphs: string[]) {
        container.replaceChildren();

        paragraphs.forEach((text) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const paragraph = fragment.querySelector('p');

            if (paragraph) paragraph.textContent = text;

            container.append(fragment);
        });
    }

    function renderCheckIn(form: HTMLFormElement, session: Session, isSubscribed: boolean) {
        const body = document.querySelector<HTMLElement>('[data-mail-body]');
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');
        const template = document.querySelector<HTMLTemplateElement>('[data-mail-template]');

        if (!body || !done || !template) return;

        const action = document.querySelector<HTMLAnchorElement>('[data-mail-action]');

        const message = composeOnboardingEmail({
            email: session.email,
            eventName: document.querySelector<HTMLElement>('[data-event-title]:not([hidden])')?.dataset.eventTitle,
            prods: session.prods,
            token: createOnboardingToken(session.email),
        });

        form.setAttribute('hidden', '');
        done.removeAttribute('hidden');
        setText(document.querySelector<HTMLElement>('[data-checkin-email]'), session.email);

        setText(
            document.querySelector<HTMLElement>('[data-checkin-newsletter]'),
            isSubscribed ? 'You are on the seasonal newsletter too.' : 'You are not on the newsletter.',
        );

        setText(document.querySelector<HTMLElement>('[data-checkin-prods]'), formatProds(session.prods));
        setText(document.querySelector<HTMLElement>('[data-mail-from]'), message.from);
        setText(document.querySelector<HTMLElement>('[data-mail-preheader]'), message.preheader);
        setText(document.querySelector<HTMLElement>('[data-mail-reply]'), message.replyTo);
        setText(document.querySelector<HTMLElement>('[data-mail-subject]'), message.subject);
        setText(document.querySelector<HTMLElement>('[data-mail-to]'), message.to);
        renderBody(body, template, message.body);

        if (action) {
            action.href = message.actionHref;
            action.textContent = message.actionLabel;
        }

        document.querySelector<HTMLElement>('[data-checkin-heading]')?.focus();
        toast(`Checked in as ${session.email}.`, 'success');
    }

    registerPageScript(initCheckInForm);
</script>
