---
import { getCollection } from 'astro:content';

import PageHead from '@components/shared/PageHead.astro';
import QrCode from '@components/shared/QrCode.astro';
import { EMAIL_MAX_LENGTH } from '@lib/constants';
import { formatDate, formatTime, mergeCalendar } from '@lib/utils';

const DOOR_URL = 'austinproduceralliance.com/here';

const bashEditions = await getCollection('bash');
const events = await getCollection('events');

const { upcoming } = mergeCalendar(events, bashEditions);
const nextEvent = upcoming.at(0);
---

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-labelledby="checkin-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-3xl font-extrabold font-sans leading-[0.9] text-5xl tracking-[-0.04em] md:text-7xl"
            eyebrow="Events / Check-in"
            headingId="checkin-title"
        >
            You made it.
        </PageHead>
        <p
            class="max-w-2xl text-lmd text-ink-muted"
            data-motion="blur"
        >
            This is where the welcome code at the door sends you. Leave an address and the
            Alliance opens your account with your first Prod already on it.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-ink"
    aria-label="Door pass"
>
    <div class="rank rank--2 items-stretch">
        <aside
            class="door-pass mark"
            aria-label="What you scanned"
            data-motion="wipe"
        >
            <div class="door-pass__panel slab slab--well flex flex-col gap-6 h-full">
                <div class="flex flex-col gap-6 mb-auto">
                    <p class="label text-accent-light">Door pass</p>
                    <p class="door-pass__url font-mono md:text-lmd text-sm wrap-break-word">
                        {DOOR_URL}
                    </p>
                    {nextEvent && (
                        <dl class="door-pass__rows">
                            <div class="door-pass__row">
                                <dt class="label text-ink-inverse-muted">Event</dt>
                                <dd
                                    class="text-smd"
                                    data-placeholder
                                >
                                    {nextEvent.title}
                                </dd>
                            </div>
                            <div class="door-pass__row">
                                <dt class="label text-ink-inverse-muted">When</dt>
                                <dd
                                    class="text-smd"
                                    data-placeholder
                                >
                                    <time datetime={nextEvent.date.toISOString()}>
                                        {formatDate(nextEvent.date)}, {formatTime(nextEvent.date)}
                                    </time>
                                </dd>
                            </div>
                            <div class="door-pass__row">
                                <dt class="label text-ink-inverse-muted">Where</dt>
                                <dd
                                    class="text-smd"
                                    data-placeholder
                                >
                                    {nextEvent.location}
                                </dd>
                            </div>
                        </dl>
                    )}
                </div>
                <div class="door-pass__foot">
                    <p class="action-text door-pass__stamp">Checked</p>
                    <p class="label text-ink-inverse-muted">1 Prod on arrival</p>
                </div>
            </div>
        </aside>
        <div
            class="door-scan slab slab--card flex items-center justify-center"
            data-motion="rise"
        >
            <QrCode
                caption={`Scan to check in \u00b7 ${DOOR_URL}`}
                data={DOOR_URL}
                label={`QR code for ${DOOR_URL}`}
            />
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Check in"
>
    <form
        class="checkin-form slab slab--card flex flex-col gap-6"
        data-checkin-form
        data-motion="unfold"
    >
        <header class="checkin__masthead">
            <p class="label text-accent-deep">Check-in</p>
            <p class="label text-ink-subtle">APA / Door 01</p>
        </header>
        <h2 class="font-extrabold font-sans text-2xl tracking-tight">
            Check in
        </h2>
        <div class="flex flex-col gap-2">
            <label class="flex flex-col gap-2">
                <span class="checkin-field__head label text-ink"><span class="checkin-field__index">01</span>Email</span>
                <input
                    id="checkin-email"
                    class="input font-mono text-sm"
                    aria-describedby="checkin-email-error"
                    aria-invalid="false"
                    autocomplete="email"
                    maxlength={EMAIL_MAX_LENGTH}
                    name="email"
                    required
                    type="email"
                />
            </label>
            <p
                id="checkin-email-error"
                class="action-text text-accent-deep"
                data-field-error
                hidden
            />
        </div>
        <div class="flex flex-col gap-2">
            <p class="checkin-field__head label text-ink"><span class="checkin-field__index">02</span>Terms</p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <label class="checkin__check">
                    <input
                        id="checkin-terms"
                        class="box"
                        aria-describedby="checkin-terms-error"
                        aria-invalid="false"
                        name="terms"
                        required
                        type="checkbox"
                    />
                    I accept the terms
                </label>
                <a
                    class="checkin__link hover:text-accent-deep text-sm underline"
                    href="/terms"
                >
                    Read them first
                </a>
            </div>
            <p
                id="checkin-terms-error"
                class="action-text text-accent-deep"
                data-field-error
                hidden
            />
        </div>
        <div class="flex flex-col gap-2">
            <p class="checkin-field__head label text-ink"><span class="checkin-field__index">03</span>Newsletter</p>
            <label class="checkin__check">
                <input
                    id="checkin-newsletter"
                    class="box"
                    checked
                    name="newsletter"
                    type="checkbox"
                />
                Add me to the seasonal newsletter
            </label>
        </div>
        <div class="checkin-form__foot">
            <button
                class="btn btn--primary checkin-form__submit"
                type="submit"
            >
                Check in &rarr;
            </button>
        </div>
    </form>
    <div
        class="checkin__done flex flex-col gap-6"
        data-checkin-done
        hidden
    >
        <div class="checkin__receipt slab slab--card flex flex-col gap-4">
            <header class="checkin__masthead">
                <p class="label text-accent-deep">Arrival receipt</p>
                <p class="label text-ink-subtle">APA / Door 01</p>
            </header>
            <h2
                class="font-extrabold font-sans text-3xl tracking-tight"
                data-checkin-heading
                tabindex="-1"
            >
                You are checked in.
            </h2>
            <p class="text-md text-ink-muted">
                An account is open for&#32;
                <span
                    class="font-mono text-sm wrap-anywhere"
                    data-checkin-email
                />&#32;
                with&#32;
                <span
                    class="font-mono text-sm"
                    data-checkin-prods
                />&#32;
                on it.&#32;
                <span data-checkin-newsletter />
            </p>
            <p class="action-text px-3 py-3 bg-accent text-ink">
                Your welcome email is below.
            </p>
            <button
                class="btn self-start"
                data-checkin-again
                type="button"
            >
                Check in another address
            </button>
        </div>
        <article
            class="mail slab slab--lift flex flex-col gap-4"
            aria-label="Welcome email"
            data-checkin-mail
            data-event={nextEvent?.title}
        >
            <header class="mail__masthead">
                <p class="label text-accent-deep">Welcome email</p>
                <p class="action-text mail__stamp">Sent</p>
            </header>
            <dl class="mail__head">
                <div class="mail__row">
                    <dt class="label text-ink-subtle">From</dt>
                    <dd
                        class="font-mono text-sm wrap-anywhere"
                        data-mail-from
                    />
                </div>
                <div class="mail__row">
                    <dt class="label text-ink-subtle">To</dt>
                    <dd
                        class="font-mono text-sm wrap-anywhere"
                        data-mail-to
                    />
                </div>
                <div class="mail__row">
                    <dt class="label text-ink-subtle">Reply to</dt>
                    <dd
                        class="font-mono text-sm wrap-anywhere"
                        data-mail-reply
                    />
                </div>
                <div class="mail__row">
                    <dt class="label text-ink-subtle">Subject</dt>
                    <dd
                        class="font-bold font-sans text-md"
                        data-mail-subject
                    />
                </div>
            </dl>
            <p
                class="mail__preheader text-sm text-ink-subtle"
                data-mail-preheader
            />
            <div
                class="mail__body flex flex-col gap-4 text-smd"
                data-mail-body
            />
            <div class="mail__actions">
                <a
                    class="btn btn--accent"
                    data-mail-action
                    href="/onboarding"
                >
                    Finish your profile
                </a>
                <p class="action-text text-ink-subtle">Link lasts 24 hours</p>
            </div>
        </article>
        <template data-mail-template>
            <p class="mail__paragraph leading-relaxed" />
        </template>
    </div>
</section>

<style>
    .checkin-field__head {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
    }

    .checkin-field__index {
        color: var(--color-accent-deep);
        padding-right: var(--space-2xs);
    }

    .checkin-form,
    .checkin__done {
        margin-inline: auto;
        max-width: var(--measure-form);
        width: 100%;
    }

    .checkin-form,
    .checkin__receipt,
    .door-pass__panel,
    .door-scan,
    .mail {
        padding: var(--space-lg);
    }

    .checkin-form__foot {
        align-items: center;
        border-top: 2px solid var(--color-ink);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        padding-top: var(--space-md);
    }

    .checkin__masthead,
    .mail__masthead {
        align-items: center;
        border-bottom: 2px solid var(--color-ink);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        justify-content: space-between;
        padding-bottom: var(--space-xs);
    }

    .checkin__check {
        align-items: center;
        align-self: flex-start;
        display: flex;
        font-size: var(--text-smd);
        gap: var(--space-xs);
        min-height: var(--control-size);
        padding: var(--space-2xs) var(--space-sm);
        transition: background-color var(--duration-fast) var(--motion-ease-ui);
    }

    .checkin__check:active,
    .checkin__check:hover {
        background-color: var(--color-surface-sunken);
    }

    .checkin__link {
        align-items: center;
        display: inline-flex;
        min-height: var(--control-size);
        padding-inline: var(--space-3xs);
        transition: color var(--duration-fast) var(--motion-ease-ui), transform var(--duration-fast) var(--motion-ease-ui);
    }

    .checkin__link:active {
        transform: translateY(1px);
    }

    .door-pass__foot,
    .door-pass__rows {
        background-image: repeating-linear-gradient(90deg, var(--color-ink-inverse-muted) 0 8px, transparent 8px 16px);
        background-position: top left;
        background-repeat: no-repeat;
        background-size: 100% 1px;
        padding-top: var(--space-md);
    }

    .door-pass__foot {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        justify-content: space-between;
    }

    .door-pass__row {
        align-items: baseline;
        border-bottom: 1px solid var(--color-ink-inverse-10);
        display: grid;
        gap: var(--space-sm);
        grid-template-columns: 64px minmax(0, 1fr);
        padding-block: var(--space-2xs);
    }

    .door-pass__row:last-child {
        border-bottom: 0;
    }

    .door-pass__rows {
        display: flex;
        flex-direction: column;
    }

    .door-pass__stamp {
        border: 2px solid var(--color-accent-light);
        color: var(--color-accent-light);
        padding: var(--space-3xs) var(--space-2xs);
        rotate: calc(var(--tilt-unit) * -4);
    }

    .door-pass__url {
        color: var(--color-pulse);
        letter-spacing: -0.01em;
    }

    .mail__actions {
        align-items: center;
        background-image: repeating-linear-gradient(90deg, var(--color-ink-20) 0 8px, transparent 8px 16px);
        background-position: top left;
        background-repeat: no-repeat;
        background-size: 100% 1px;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        padding-top: var(--space-md);
    }

    .mail__head {
        display: flex;
        flex-direction: column;
    }

    .mail__row {
        align-items: baseline;
        border-bottom: 1px solid var(--color-ink-20);
        display: grid;
        gap: var(--space-sm);
        grid-template-columns: 72px minmax(0, 1fr);
        padding-block: var(--space-2xs);
    }

    .mail__stamp {
        border: 2px solid var(--color-accent-deep);
        color: var(--color-accent-deep);
        padding: var(--space-3xs) var(--space-2xs);
        rotate: calc(var(--tilt-unit) * -3);
    }

    @media (max-width: 768px) {
        .checkin-form__submit {
            width: 100%;
        }
    }

    @media (forced-colors: active) {
        .door-pass__stamp,
        .mail__stamp {
            border-color: CanvasText;
            color: CanvasText;
        }
    }
</style>

<script>
    import { clearFieldErrors, focusFirstError, isValidationBypassed, setFieldErrors, validateFields } from '@lib/ui/forms';
    import { composeOnboardingEmail } from '@lib/email';
    import { createOnboardingToken } from '@lib/account/onboarding';
    import { formatProds, registerPageScript, setPending, setText } from '@lib/utils';
    import { startSession } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const PLACEHOLDER_EMAIL = 'you@studio.fm';

    const RULES: Record<string, FieldRule> = {
        email: { message: 'Enter your email address.', required: true },
        terms: { message: 'Accept the terms to check in.', required: true },
    };

    function handleCheckInAgain(form: HTMLFormElement, done: HTMLElement) {
        done.setAttribute('hidden', '');
        form.removeAttribute('hidden');
        form.querySelector<HTMLInputElement>('#checkin-email')?.focus();
    }

    async function handleCheckInSubmit(event: SubmitEvent, form: HTMLFormElement) {
        event.preventDefault();

        const values = new FormData(form);
        const errors = validateFields(form, RULES);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            setFieldErrors(form, errors);
            focusFirstError(form, errors);
            toast('Check the fields.', 'error');

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        setPending(button, true);

        const result = await startSession({ email: readEmail(values) });

        setPending(button, false);

        if (!result.ok) {
            setFieldErrors(form, { email: result.message });
            focusFirstError(form, { email: result.message });

            return;
        }

        renderCheckIn(form, result.session, values.get('newsletter') !== null);
    }

    function initCheckInForm(signal: AbortSignal) {
        const again = document.querySelector<HTMLButtonElement>('[data-checkin-again]');
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');
        const form = document.querySelector<HTMLFormElement>('[data-checkin-form]');

        if (!done || !form) return;

        form.noValidate = true;
        form.addEventListener('submit', event => handleCheckInSubmit(event, form), { signal });
        again?.addEventListener('click', () => handleCheckInAgain(form, done), { signal });
    }

    function readEmail(values: FormData) {
        const email = String(values.get('email') ?? '').trim();

        if (email.length > 0 || !isValidationBypassed()) return email;

        return PLACEHOLDER_EMAIL;
    }

    function renderBody(container: HTMLElement, template: HTMLTemplateElement, paragraphs: string[]) {
        container.replaceChildren();

        paragraphs.forEach((text) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;
            const paragraph = fragment.querySelector('p');

            if (paragraph) paragraph.textContent = text;

            container.append(fragment);
        });
    }

    function renderCheckIn(form: HTMLFormElement, session: Session, newsletter: boolean) {
        const body = document.querySelector<HTMLElement>('[data-mail-body]');
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');
        const mail = document.querySelector<HTMLElement>('[data-checkin-mail]');
        const template = document.querySelector<HTMLTemplateElement>('[data-mail-template]');

        if (!body || !done || !mail || !template) return;

        const message = composeOnboardingEmail({
            email: session.email,
            eventName: mail.dataset.event,
            prods: session.prods,
            token: createOnboardingToken(session.email),
        });

        const action = document.querySelector<HTMLAnchorElement>('[data-mail-action]');

        form.setAttribute('hidden', '');
        done.removeAttribute('hidden');

        setText(document.querySelector<HTMLElement>('[data-checkin-email]'), session.email);
        setText(document.querySelector<HTMLElement>('[data-checkin-prods]'), formatProds(session.prods));
        setText(document.querySelector<HTMLElement>('[data-checkin-newsletter]'), newsletter ? 'You are on the seasonal newsletter too.' : 'You are not on the newsletter.');
        setText(document.querySelector<HTMLElement>('[data-mail-from]'), message.from);
        setText(document.querySelector<HTMLElement>('[data-mail-preheader]'), message.preheader);
        setText(document.querySelector<HTMLElement>('[data-mail-reply]'), message.replyTo);
        setText(document.querySelector<HTMLElement>('[data-mail-subject]'), message.subject);
        setText(document.querySelector<HTMLElement>('[data-mail-to]'), message.to);
        renderBody(body, template, message.body);

        if (action) {
            action.href = message.actionHref;
            action.textContent = message.actionLabel;
        }

        document.querySelector<HTMLElement>('[data-checkin-heading]')?.focus();
        toast(`Checked in as ${session.email}.`, 'success');
    }

    registerPageScript(initCheckInForm);
</script>
