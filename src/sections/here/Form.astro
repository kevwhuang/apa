---
import IconArrow from '@components/icons/Arrow.astro';
import PageHead from '@components/shared/PageHead.astro';
import QrCode from '@components/shared/QrCode.astro';
import Schedule from '@components/program/Schedule.astro';
import { EMAIL_MAX_LENGTH } from '@lib/shared/constants';
import { formatDateStamp, formatTime, isUpcoming, toAustinIso } from '@lib/shared/utils';
import { loadEvents } from '@lib/programs/calendar';

const DOOR_HOST_PARTS = ['austinproducer', 'alliance.com'];
const DOOR_PATH = 'here';

const doorUrl = `${DOOR_HOST_PARTS.join('')}/${DOOR_PATH}`;

const events = await loadEvents();

const upcoming = events.filter(event => isUpcoming(event.ends_at));
---

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-labelledby="checkin-title"
>
    <div class="flex flex-col gap-6">
        <PageHead
            class="max-w-3xl text-4xl-7xl text-balance"
            headingId="checkin-title"
        >
            You made it
        </PageHead>
        <p
            class="max-w-2xl text-lg text-text-secondary"
            data-motion="blur"
        >
            This is where the welcome code at the door sends you. Leave an address and the
            Alliance opens your account with your first Prod already on it.
        </p>
    </div>
</section>

<section
    class="stage stage--tight border-b-2 border-border-strong"
    aria-label="Door pass"
>
    <div class="rank rank--2 items-stretch">
        <aside
            class="mark"
            aria-label="What you scanned"
            data-motion="wipe"
        >
            <div class="door-pass__panel slab slab--plush slab--well flex flex-col h-full gap-(--space-lg)">
                <div class="flex flex-col gap-(--space-lg) mb-auto">
                    <p class="font-mono text-base-lg wrap-break-word text-link-on-inverse">
                        {DOOR_HOST_PARTS[0]}<wbr />{DOOR_HOST_PARTS[1]}/<wbr />{DOOR_PATH}
                    </p>
                    {upcoming.map((event, index) => (
                        <dl
                            class="door-pass__rows flex flex-col pt-(--space-md) bg-repeat-x bg-top-left"
                            data-event-end={toAustinIso(event.ends_at)}
                            data-event-group="door"
                            data-event-id={event.id}
                            data-event-role="next"
                            hidden={index > 0}
                        >
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">Program</dt>
                                <dd class="text-base">
                                    {event.program}
                                </dd>
                            </div>
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">When</dt>
                                <dd class="font-mono text-base">
                                    <time datetime={toAustinIso(event.starts_at)}>
                                        {formatDateStamp(event.starts_at)}, {formatTime(event.starts_at)}
                                    </time>
                                </dd>
                            </div>
                            <div class="last:border-b-0 grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-inverse-subtle">
                                <dt class="label text-text-inverse-secondary">Where</dt>
                                <dd class="font-mono text-base">
                                    {event.venue}
                                </dd>
                            </div>
                        </dl>
                    ))}
                </div>
                <div class="door-pass__foot flex flex-wrap items-center justify-between gap-3 pt-(--space-md) bg-repeat-x bg-top-left">
                    <p class="label px-2 py-1 border-2 border-link-on-inverse text-link-on-inverse">Checked</p>
                    <p class="label text-text-inverse-secondary">1 Prod on arrival</p>
                </div>
            </div>
        </aside>
        <div
            class="door-scan slab slab--card slab--plush flex items-center justify-center"
            data-motion="rise"
        >
            <QrCode
                caption="Scan to check in"
                data={new URL(DOOR_PATH, Astro.site).href}
                label={`QR code for ${doorUrl}`}
            />
        </div>
    </div>
</section>

<section
    class="stage stage--tight"
    aria-label="Check in"
>
    <form
        class="checkin-form slab slab--card slab--plush flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
        data-checkin-form
        data-motion="unfold"
    >
        <h2 class="text-2xl">
            Check in
        </h2>
        <div class="flex flex-col gap-2">
            <label class="flex flex-col gap-2">
                <span class="label flex flex-wrap items-baseline text-text">
                    <span class="pr-2 text-link">1</span>
                    Email
                </span>
                <input
                    id="checkin-email"
                    class="input font-mono"
                    aria-invalid="false"
                    autocomplete="email"
                    maxlength={EMAIL_MAX_LENGTH}
                    name="email"
                    required
                    type="email"
                />
            </label>
        </div>
        <div class="flex flex-col gap-2">
            <p class="label flex flex-wrap items-baseline text-text">
                <span class="pr-2 text-link">2</span>
                Terms
            </p>
            <label class="self-start gap-3 py-2 text-sm">
                <input
                    id="checkin-terms"
                    class="box"
                    aria-invalid="false"
                    name="terms"
                    required
                    type="checkbox"
                />
                <span>
                    I accept the&#32;
                    <a
                        class="active:translate-y-px hover:text-link inline-block font-mono underline underline-offset-4 transition-[color,translate]"
                        href="/terms"
                    >
                        terms
                    </a>
                </span>
            </label>
        </div>
        <div class="flex flex-col gap-2">
            <p class="label flex flex-wrap items-baseline text-text">
                <span class="pr-2 text-link">3</span>
                Newsletter
            </p>
            <label class="self-start gap-3 py-2 text-sm">
                <input
                    id="checkin-newsletter"
                    class="box"
                    checked
                    name="newsletter"
                    type="checkbox"
                />
                Add me to the seasonal newsletter
            </label>
        </div>
        <button
            class="btn btn--primary w-full"
            autocomplete="off"
            disabled
            type="submit"
        >
            Check in <IconArrow />
        </button>
    </form>
    <div
        class="flex flex-col max-w-(--measure-form) w-full gap-(--space-lg) mx-auto"
        data-checkin-done
        hidden
    >
        <div class="checkin__receipt slab slab--card slab--plush flex flex-col gap-(--space-lg)">
            <hgroup class="flex flex-col gap-3">
                <h2
                    class="font-display text-2xl-3xl"
                    data-checkin-heading
                    tabindex="-1"
                >
                    You are checked in
                </h2>
                <p
                    class="text-lg text-text-secondary"
                    data-checkin-account
                >
                    An account is open for&#32;
                    <span
                        class="font-mono text-base wrap-anywhere"
                        data-checkin-email
                    />&#32;
                    with&#32;
                    <span
                        class="font-mono text-base"
                        data-checkin-prods
                    />&#32;
                    on it.&#32;
                    <span data-checkin-newsletter />
                </p>
            </hgroup>
            <p
                class="p-3 bg-signal text-text-on-signal"
                data-checkin-mailed
            >
                Your welcome email is below.
            </p>
            <div class="flex flex-wrap gap-3 pt-(--space-md) border-border-strong border-t-2">
                <button
                    class="btn text-balance"
                    data-checkin-again
                    type="button"
                >
                    Check in another address
                </button>
            </div>
        </div>
        <article
            class="mail slab slab--card slab--plush flex flex-col gap-(--space-lg)"
            aria-label="Welcome email"
            data-checkin-mail
        >
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b-2 border-border-strong">
                <p class="label text-link">Welcome email</p>
                <p class="label px-2 py-1 border-2 border-link text-link">Sent</p>
            </div>
            <dl class="flex flex-col">
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">From</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-from
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">To</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-to
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">Reply to</dt>
                    <dd
                        class="font-mono text-base wrap-anywhere"
                        data-mail-reply
                    />
                </div>
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-baseline gap-3 py-1 border-b border-border-subtle">
                    <dt class="label text-text-secondary">Subject</dt>
                    <dd
                        class="font-bold leading-(--text-xl) text-lg"
                        data-mail-subject
                    />
                </div>
            </dl>
            <p
                class="text-base text-text-secondary"
                data-mail-preheader
            />
            <div
                class="flex flex-col gap-4"
                data-mail-body
            />
            <div class="mail__actions flex flex-wrap items-center gap-3 pt-(--space-md) bg-repeat-x bg-top-left">
                <a
                    class="btn btn--accent"
                    data-mail-action
                    href="/onboarding"
                >
                    Finish profile
                </a>
                <p class="label text-text-secondary">Link lasts 1 hour</p>
            </div>
        </article>
        <template data-mail-template>
            <p />
        </template>
    </div>
</section>

<Schedule />

<style>
    .door-pass__foot,
    .door-pass__rows {
        background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
        background-size: var(--halftone-pitch) 2px;
    }

    .mail__actions {
        background-image: radial-gradient(circle, var(--color-border-subtle) 1px, transparent 1px);
        background-size: var(--halftone-pitch) 2px;
    }
</style>

<script>
    import { CODE_EXPIRED_MESSAGE, checkIn, getDoorCode, getDoorEvent, syncEvents } from '@lib/account/checkin';
    import { EMAIL_REQUIRED_MESSAGE, MILLISECONDS_PER_SECOND } from '@lib/shared/constants';
    import { buildQrPath } from '@lib/ui/qr';
    import { clearFieldErrors, reportFieldErrors, validateFields, watchFieldErrors } from '@lib/ui/forms';
    import { composeOnboardingEmail } from '@lib/shared/email';
    import { formatProds, registerPageScript, setHidden, setPending, setText } from '@lib/shared/utils';
    import { getSession, onSessionChange, sendSignInLink } from '@lib/account/session';
    import { toast } from '@lib/ui/toasts';

    const CODE_PARAMETER = 'c';
    const DOOR_ROUTE = '/here';
    const FAILED_RETRY_SECONDS = 5;
    const LINK_FAILED_MESSAGE = 'You are checked in, but your sign-in link was not sent. Create an account with this address later and this check-in will be on it.';
    const RETRY_SECONDS = 60;

    const RULES: Record<string, FieldRule> = {
        email: { message: EMAIL_REQUIRED_MESSAGE, required: true },
        terms: { message: 'Accept the terms to check in.', required: true },
    };

    let displayEventId = '';
    let doorCode = '';
    let doorTimer: Timer | undefined;
    let isDisplaying = false;
    let isSubmitting = false;
    let staticQr = { path: '', viewBox: '' };
    let stopSessionWatch: (() => void) | undefined;

    function closeDisplay() {
        clearTimeout(doorTimer);
        stopSessionWatch?.();
    }

    function drawQr(path: string, viewBox: string) {
        document.querySelector('[data-qr-path]')?.setAttribute('d', path);
        document.querySelector('[data-qr]')?.setAttribute('viewBox', viewBox);
    }

    function handleCheckInAgain(form: HTMLFormElement, done: HTMLElement) {
        done.setAttribute('hidden', '');
        form.removeAttribute('hidden');
        form.querySelector<HTMLInputElement>('[name="email"]')?.focus();
    }

    async function handleCheckInSubmit(event: SubmitEvent, form: HTMLFormElement, signal: AbortSignal) {
        event.preventDefault();

        if (isSubmitting) return;

        const errors = validateFields(form, RULES);
        const values = new FormData(form);

        clearFieldErrors(form);

        if (Object.keys(errors).length > 0) {
            reportFieldErrors(form, errors);

            return;
        }

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const email = String(values.get('email') ?? '').trim().toLowerCase();
        const wantsNewsletter = values.get('newsletter') !== null;

        isSubmitting = true;
        setPending(button, true);

        const result = await checkIn(doorCode, email, wantsNewsletter);

        const link = result.ok && !result.confirmed && result.prods === null ? await sendSignInLink(email) : null;

        if (signal.aborted) return;

        isSubmitting = false;
        setPending(button, false);

        if (!result.ok) {
            if (result.code === 'invalid-email') reportFieldErrors(form, { email: result.message });
            else toast(result.message, 'error');

            return;
        }

        const isMailed = link?.ok === true;

        renderCheckIn(form, email, result.prods, wantsNewsletter, isMailed);

        if (result.repeated) toast(`Already checked in as ${email}.`, 'info');
        else if (isMailed || result.prods !== null) toast(`Checked in as ${email}.`, 'success');
        else toast(result.confirmed ? `Checked in as ${email}. Sign in to add it to your account.` : LINK_FAILED_MESSAGE, 'info');
    }

    function handleVisibilityChange(signal: AbortSignal) {
        if (document.visibilityState === 'visible' && isDisplaying) void refreshDisplay(signal);
    }

    function initCheckInForm(signal: AbortSignal) {
        const again = document.querySelector<HTMLButtonElement>('[data-checkin-again]');
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');
        const form = document.querySelector<HTMLFormElement>('[data-checkin-form]');

        if (!done || !form) return;

        const email = form.querySelector<HTMLInputElement>('[name="email"]');

        displayEventId = '';
        doorCode = new URLSearchParams(window.location.search).get(CODE_PARAMETER) ?? '';
        isDisplaying = false;
        isSubmitting = false;

        staticQr = {
            path: document.querySelector('[data-qr-path]')?.getAttribute('d') ?? '',
            viewBox: document.querySelector('[data-qr]')?.getAttribute('viewBox') ?? '',
        };

        form.noValidate = true;

        if (email && !email.value) email.value = getSession()?.email ?? '';

        again?.addEventListener('click', () => handleCheckInAgain(form, done), { signal });
        document.addEventListener('visibilitychange', () => handleVisibilityChange(signal), { signal });
        form.addEventListener('submit', event => void handleCheckInSubmit(event, form, signal), { signal });
        setPending(form.querySelector<HTMLButtonElement>('button[type="submit"]'), false);
        watchFieldErrors(form, signal);
        void loadDoorEvent(signal);
        syncDisplay(signal);
        stopSessionWatch?.();
        stopSessionWatch = onSessionChange(() => syncDisplay(signal));
        signal.addEventListener('abort', closeDisplay, { once: true });
    }

    async function loadDoorEvent(signal: AbortSignal) {
        if (!doorCode) return;

        const eventId = await getDoorEvent(doorCode);

        if (signal.aborted) return;

        if (eventId) showEvent(eventId);
        else toast(CODE_EXPIRED_MESSAGE, 'error');
    }

    async function refreshDisplay(signal: AbortSignal) {
        clearTimeout(doorTimer);

        const door = await getDoorCode();

        if (signal.aborted || !isDisplaying) return;

        if (door) {
            const shape = buildQrPath(`${window.location.origin}${DOOR_ROUTE}?${CODE_PARAMETER}=${door.code}`);

            drawQr(shape.path, `0 0 ${shape.size} ${shape.size}`);

            if (door.eventId !== displayEventId) showEvent(door.eventId);

            displayEventId = door.eventId;
        } else if (door === null) {
            drawQr(staticQr.path, staticQr.viewBox);
        }

        const seconds = door === undefined ? FAILED_RETRY_SECONDS : door?.secondsLeft ?? RETRY_SECONDS;

        clearTimeout(doorTimer);
        doorTimer = setTimeout(() => void refreshDisplay(signal), seconds * MILLISECONDS_PER_SECOND);
    }

    function renderBody(container: HTMLElement, template: HTMLTemplateElement, paragraphs: string[]) {
        container.replaceChildren();

        paragraphs.forEach((text) => {
            const fragment = template.content.cloneNode(true) as DocumentFragment;

            const paragraph = fragment.querySelector('p');

            if (paragraph) paragraph.textContent = text;

            container.append(fragment);
        });
    }

    function renderCheckIn(form: HTMLFormElement, email: string, prods: null | number, isSubscribed: boolean, isMailed: boolean) {
        const done = document.querySelector<HTMLElement>('[data-checkin-done]');

        if (!done) return;

        if (isMailed) renderMail(done, email);

        setHidden(done.querySelector<HTMLElement>('[data-checkin-account]'), prods === null);
        setHidden(done.querySelector<HTMLElement>('[data-checkin-mail]'), !isMailed);
        setHidden(done.querySelector<HTMLElement>('[data-checkin-mailed]'), !isMailed);
        setText(done.querySelector('[data-checkin-email]'), email);

        setText(
            done.querySelector('[data-checkin-newsletter]'),
            isSubscribed ? 'You are on the seasonal newsletter too.' : 'You are not on the newsletter.',
        );

        setText(done.querySelector('[data-checkin-prods]'), prods === null ? '' : formatProds(prods));
        done.removeAttribute('hidden');
        form.setAttribute('hidden', '');
        done.querySelector<HTMLElement>('[data-checkin-heading]')?.focus();
    }

    function renderMail(done: HTMLElement, email: string) {
        const action = done.querySelector<HTMLAnchorElement>('[data-mail-action]');
        const body = done.querySelector<HTMLElement>('[data-mail-body]');
        const message = composeOnboardingEmail({ email });
        const template = done.querySelector<HTMLTemplateElement>('[data-mail-template]');

        setText(done.querySelector('[data-mail-from]'), message.from);
        setText(done.querySelector('[data-mail-preheader]'), message.preheader);
        setText(done.querySelector('[data-mail-reply]'), message.replyTo);
        setText(done.querySelector('[data-mail-subject]'), message.subject);
        setText(done.querySelector('[data-mail-to]'), message.to);

        if (body && template) renderBody(body, template, message.body);

        if (action) {
            action.href = message.actionHref;
            action.textContent = message.actionLabel;
        }
    }

    function showEvent(id: string) {
        const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-event-group="door"]'));

        if (!rows.some(row => row.dataset.eventId === id)) return;

        rows.forEach(row => setHidden(row, row.dataset.eventId !== id));
    }

    function syncDisplay(signal: AbortSignal) {
        const isAdmin = getSession()?.admin === true;

        if (isAdmin === isDisplaying) return;

        isDisplaying = isAdmin;

        if (isAdmin) {
            void syncEvents();
            void refreshDisplay(signal);

            return;
        }

        clearTimeout(doorTimer);
        drawQr(staticQr.path, staticQr.viewBox);
    }

    registerPageScript(initCheckInForm);
</script>
