---
const bars = Array.from({ length: 32 }, () => 20 + Math.random() * 80);
---

<section
    class="relative pt-32 pb-28 overflow-hidden border-b-2 border-ink bg-sand"
    aria-label="Homepage hero"
>
    <div class="absolute inset-0 halftone pointer-events-none"></div>
    <div class="max-w-[1400px] mx-auto px-6 relative">
        <div class="flex items-center gap-3 mb-14 label text-ink-soft reveal">
            <span class="inline-block w-2.5 h-2.5 bg-coral animate-pulse"></span>
            <span>AUSTIN TX / 30.27N 97.74W</span>
            <span class="ml-auto hidden md:inline">EST 2019 / 142 PRODUCERS / 38 EVENTS YR</span>
        </div>

        <h1 class="font-sans font-extrabold tracking-[-0.04em] text-[clamp(52px,10vw,140px)] leading-[0.88]">
            <span class="block reveal">Austin's</span>
            <span class="block text-coral reveal" style="transition-delay: 0.08s;">producer</span>
            <span class="block reveal" style="transition-delay: 0.16s;">community.</span>
        </h1>

        <div class="mt-16 relative reveal" style="transition-delay: 0.3s;">
            <div class="relative border-2 border-ink bg-surface overflow-hidden crop-marks">
                <div class="absolute inset-0 halftone--coral"></div>

                <div id="waveform" class="flex items-end gap-[2px] h-20 px-3 py-2" aria-hidden="true">
                    {bars.map((h, i) => (
                        <div
                            class="flex-1 bg-coral/70 origin-bottom"
                            style={`height: ${h}%; animation: waveform ${0.8 + (i % 5) * 0.15}s ease-in-out ${i * 0.04}s infinite alternate;`}
                        >
                        </div>
                    ))}
                </div>

                <div id="playhead" class="absolute top-0 bottom-0 w-0.5 bg-coral" style="left: 20%;">
                    <div class="absolute -top-1.5 -left-[5px] w-3 h-3 bg-coral rotate-45"></div>
                </div>
            </div>
            <div class="flex justify-between mt-2 font-mono text-[11px] text-ink-soft uppercase">
                <span>00:00</span>
                <span>Bar 01 / 4-4 / 92 BPM</span>
                <span>04:00</span>
            </div>

            <div class="mt-12 grid md:grid-cols-2 gap-10 max-w-3xl">
                <p class="text-[18px] leading-relaxed">
                    A working community for music producers in Austin, Texas. Cookups, showcases,
                    and the annual <a class="underline decoration-coral decoration-2 underline-offset-4 hover:text-coral transition-colors" href="/bash">Producer Bash</a> —
                    where local artists and labels build the city's sound from the inside out.
                </p>
                <div class="flex flex-wrap gap-3 items-start">
                    <a
                        class="inline-flex items-center gap-2 px-6 h-12 btn-text border-2 border-ink bg-ink text-sand hover:bg-coral hover:border-coral transition-colors"
                        href="/events"
                    >
                        Upcoming events
                    </a>
                    <a
                        class="inline-flex items-center gap-2 px-6 h-12 btn-text border-2 border-ink hover:bg-ink hover:text-sand transition-colors"
                        href="/about"
                    >
                        Our story
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const PLAYHEAD_END = 85;
    const PLAYHEAD_INTERVAL = 80;
    const PLAYHEAD_START = 20;
    const PLAYHEAD_STEP = 0.35;

    const playhead = document.getElementById('playhead');

    if (playhead && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let progress = PLAYHEAD_START;

        setInterval(() => {
            progress = ((progress - PLAYHEAD_START + PLAYHEAD_STEP) % (PLAYHEAD_END - PLAYHEAD_START)) + PLAYHEAD_START;
            playhead.style.left = `${progress}%`;
        }, PLAYHEAD_INTERVAL);
    }
</script>
