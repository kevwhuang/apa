---
import SectionHead from '@components/SectionHead.astro';
---

<section
    class="ink-block overflow-hidden relative py-24 border-b-2 border-ink"
    aria-labelledby="bash-title"
>
    <div class="halftone--coral absolute inset-0 pointer-events-none" aria-hidden="true" />
    <div class="shell grid items-end relative gap-16 md:grid-cols-[1.4fr_1fr]">
        <div>
            <SectionHead
                class="font-extrabold font-sans leading-[0.9] text-[clamp(44px,8.44vw,108px)] tracking-[-0.04em]"
                eyebrow="The Bash / annual"
                eyebrowClass="mb-5"
                headingId="bash-title"
                tone="dark"
            >
                The Producer<br />Bash 2026.
            </SectionHead>
            <p class="bash__intro reveal max-w-xl mt-8 leading-relaxed text-[18px] text-taupe-3">
                Two days, four stages, one warehouse. Every member of the alliance ships a track to
                the compilation, and the room mixes it live.
            </p>
            <div class="bash__actions reveal flex flex-wrap gap-3 mt-10">
                <a
                    class="btn btn--coral h-12"
                    href="/bash"
                >
                    Bash details
                </a>
                <a
                    class="bash__cta btn h-12"
                    href="/sponsor"
                >
                    Sponsor it
                </a>
            </div>
        </div>
        <dl class="reveal--stagger grid grid-cols-2 gap-px border-2 border-ink-2 bg-ink-2">
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-taupe-3">Edition</dt>
                <dd class="font-extrabold font-sans text-3xl">VII</dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-taupe-3">Dates</dt>
                <dd class="font-extrabold font-sans text-3xl">
                    <time datetime="2026-03-27">03.27</time><span class="text-taupe-2">&ndash;</span><time datetime="2026-03-28">28</time>
                </dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-taupe-3">Stages</dt>
                <dd class="font-extrabold font-sans text-3xl">4</dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-taupe-3">Producers</dt>
                <dd class="font-extrabold font-sans text-3xl">96</dd>
            </div>
        </dl>
    </div>
</section>

<style>
    .bash__actions {
        transition-delay: 0.24s;
    }

    .bash__intro {
        transition-delay: 0.16s;
    }

    .btn.bash__cta {
        border-color: var(--color-taupe-3);
        color: var(--color-taupe-3);
    }

    .btn.bash__cta:hover {
        background: transparent;
        border-color: var(--color-coral);
        color: var(--color-coral);
    }
</style>
