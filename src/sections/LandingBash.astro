---

---

<section
    class="py-24 border-b-2 border-ink relative overflow-hidden ink-block"
    aria-label="The Producer Bash"
>
    <div class="absolute inset-0 halftone--coral pointer-events-none"></div>
    <div class="max-w-[1400px] mx-auto px-6 relative grid md:grid-cols-[1.4fr_1fr] gap-16 items-end">
        <div>
            <p class="label mb-5 text-coral reveal">THE BASH / ANNUAL</p>
            <h2 class="font-sans font-extrabold tracking-[-0.04em] text-[clamp(44px,8vw,108px)] leading-[0.9] reveal" style="transition-delay: 0.08s;">
                The Producer<br />Bash 2026.
            </h2>
            <p class="mt-8 text-[18px] leading-relaxed max-w-xl text-inv-body reveal" style="transition-delay: 0.16s;">
                Two days, four stages, one warehouse. Every member of the alliance ships a track to
                the compilation, and the room mixes it live.
            </p>
            <div class="mt-10 flex flex-wrap gap-3 reveal" style="transition-delay: 0.24s;">
                <a class="inline-flex items-center gap-2 px-6 h-12 btn-text bg-coral text-coral-ink border-2 border-coral hover:bg-coral-dark transition-colors" href="/bash">
                    Bash details
                </a>
                <a class="inline-flex items-center gap-2 px-6 h-12 btn-text border-2 border-inv-rule text-inv-body hover:border-coral hover:text-coral transition-colors" href="/sponsor">
                    Sponsor it
                </a>
            </div>
        </div>

        <dl class="grid grid-cols-2 gap-px bg-inv-rule border-2 border-inv-rule reveal--stagger">
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-inv-muted">Edition</dt>
                <dd class="font-sans text-3xl font-extrabold">VII</dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-inv-muted">Dates</dt>
                <dd class="font-sans text-3xl font-extrabold">03.27<span class="text-inv-muted">&mdash;</span>28</dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-inv-muted">Stages</dt>
                <dd class="font-sans text-3xl font-extrabold">4</dd>
            </div>
            <div class="p-5 bg-ink">
                <dt class="label mb-2 text-inv-muted">Producers</dt>
                <dd class="font-sans text-3xl font-extrabold">96</dd>
            </div>
        </dl>
    </div>
</section>
