---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

import '@/global.css';
import '@/styles.css';
import Ai from '@sections/shared/Ai.astro';
import Chat from '@sections/shared/Chat.astro';
import Footer from '@sections/shared/Footer.astro';
import Navbar from '@sections/shared/Navbar.astro';
import Player from '@sections/shared/Player.astro';
import Toaster from '@sections/shared/Toaster.astro';
import Tour from '@sections/shared/Tour.astro';
import bootstrap from '@lib/raw/bootstrap.ts?raw';
import { BRAND, BRAND_ICONS, BRAND_OG } from '@lib/shared/brand';
import { LINKS, ROUTES, STORAGE } from '@lib/shared/constants';

interface Props {
    description: string;
    hasHero?: boolean;
    noindex?: boolean;
    title: string;
}

const bootstrapScript = bootstrap.replace('__THEME_KEY__', STORAGE.theme.key).replace('__SESSION_KEY__', STORAGE.session.key);
const canonicalUrl = new URL(Astro.routePattern.replace(/\[(\w+)\]/g, (_match, key) => Astro.params[key] ?? ''), Astro.site);
const currentRoute = ROUTES.find(route => route.href === Astro.routePattern);
const { description, hasHero, noindex, title } = Astro.props;
const logoUrl = new URL(BRAND_ICONS.logo, Astro.site).href;
const ogImageUrl = new URL(BRAND_ICONS.og, Astro.site).href;

const breadcrumbRoutes = currentRoute && currentRoute !== ROUTES[0] ? [ROUTES[0], currentRoute] : [];

const breadcrumbList = {
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbRoutes.map((route, index) => ({
        '@type': 'ListItem',
        'item': new URL(route.href, Astro.site).href,
        'name': route.label,
        'position': index + 1,
    })),
};

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        ...(breadcrumbRoutes.length > 0 ? [breadcrumbList] : []),
        {
            '@type': 'ItemList',
            'itemListElement': ROUTES.map((route, index) => ({
                '@type': 'SiteNavigationElement',
                'name': route.label,
                'position': index + 1,
                'url': new URL(route.href, Astro.site).href,
            })),
        },
        {
            '@type': 'Organization',
            'inLanguage': 'en',
            'logo': logoUrl,
            'name': BRAND.name,
            'sameAs': [LINKS.instagram, LINKS.discord, LINKS.meetup],
            'url': Astro.site,
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta content={BRAND.author} name="author" />
        <meta content={description} name="description" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <meta content={BRAND.themeColor} name="theme-color" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <link href={BRAND_ICONS.appleTouch} rel="apple-touch-icon" />
        <link href={canonicalUrl} rel="canonical" />
        <link href={BRAND_ICONS.png} rel="icon" type="image/png" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={BRAND.name} property="og:image:alt" />
        <meta content={String(BRAND_OG.height)} property="og:image:height" />
        <meta content={String(BRAND_OG.width)} property="og:image:width" />
        <meta content="en_US" property="og:locale" />
        <meta content={BRAND.name} property="og:site_name" />
        <meta content={title} property="og:title" />
        <meta content="website" property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <meta content={title} name="twitter:title" />
        <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
        <script is:inline set:html={bootstrapScript} />
        <Font cssVariable="--font-bricolage-grotesque" preload />
        <Font cssVariable="--font-space-mono" preload />
        <ClientRouter />
    </head>
    <body class="antialiased bg-surface text-ink">
        <div class="grain" aria-hidden="true" />
        <div class="flex flex-col overflow-x-clip min-h-svh">
            <Navbar hasHero={hasHero} />
            <main class="flex flex-1 flex-col">
                <slot />
            </main>
            <Footer />
        </div>
        <Ai />
        <Chat />
        <Player />
        <Toaster />
        <Tour />
    </body>
</html>

<script>
    import { initMotion } from '@lib/motion/motion';
    import { syncSessionAttribute } from '@lib/account/session';
    import { syncThemeAttribute } from '@lib/ui/theme';

    document.addEventListener('astro:after-swap', syncSessionAttribute);
    document.addEventListener('astro:after-swap', syncThemeAttribute);
    initMotion();
    syncThemeAttribute();
</script>
