---
import DirectoryGrid from '@sections/directory/Grid.astro';
import Layout from '@/Layout.astro';
import { BROWSER_CACHE_CONTROL, SHARED_CACHE_CONTROL } from '@lib/shared/constants';
import { brandTitle } from '@lib/shared/brand';

Astro.response.headers.set('Cache-Control', BROWSER_CACHE_CONTROL);
Astro.response.headers.set('Netlify-CDN-Cache-Control', SHARED_CACHE_CONTROL);

export const prerender = false;
---

<Layout
    description="The Austin Producer Alliance directory lists every member with their role, genres, city, links, and spotlight track. Filter by role or genre and press play."
    title={brandTitle('Directory')}
>
    <DirectoryGrid />
</Layout>
