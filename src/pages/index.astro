---
import HeroTimeline from '@sections/home/HeroTimeline.astro';
import LandingAssembly from '@sections/home/Assembly.astro';
import LandingBash from '@sections/home/Bash.astro';
import LandingHangout from '@sections/home/Hangout.astro';
import LandingNewsletter from '@sections/home/Newsletter.astro';
import LandingPartners from '@sections/home/Partners.astro';
import LandingProducers from '@sections/home/Producers.astro';
import Layout from '@/Layout.astro';
---

