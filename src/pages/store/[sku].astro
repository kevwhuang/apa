---
import { getCollection } from 'astro:content';

import Layout from '@/Layout.astro';
import ProductDetail from '@sections/store/ProductDetail.astro';
import { brandTitle } from '@lib/shared/brand';

const DESCRIPTION_MAX = 160;
const DESCRIPTION_SUFFIX = ' From the official Austin Producer Alliance store.';

const { product, slug } = Astro.props;

export async function getStaticPaths() {
    const products = await getCollection('products');

    return products.map(product => ({
        params: { sku: String(product.data.sku) },
        props: { product: product.data, slug: product.id },
    }));
}

function toDescription(text: string) {
    const limit = DESCRIPTION_MAX - DESCRIPTION_SUFFIX.length;

    if (text.length <= limit) return `${text}${DESCRIPTION_SUFFIX}`;

    let kept = '';

    for (const sentence of text.match(/[^.!?]+[.!?]+/g) ?? []) {
        const next = `${kept}${sentence}`.trim();

        if (next.length > limit) break;

        kept = next;
    }

    return `${kept.length > 0 ? kept : text.slice(0, limit).trimEnd()}${DESCRIPTION_SUFFIX}`;
}
---

<Layout
    description={toDescription(product.description)}
    title={brandTitle(product.title)}
>
    <ProductDetail
        product={product}
        slug={slug}
    />
</Layout>
