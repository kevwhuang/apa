---
interface Props {
    class?: string;
    size?: number;
}

const { class: logoClass = 'text-ink', size = 28 } = Astro.props;
const height = size;
const width = size * 4.8;
---

<svg
    class:list={[logoClass, 'select-none']}
    aria-label="Austin Producer Alliance"
    fill="none"
    height={height}
    role="img"
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    xmlns="http://www.w3.org/2000/svg"
>
    <rect fill="var(--color-coral)" height={height} width={height * 1.8} x="0" y="0" />
    <g
        fill="currentColor"
        font-family="'Bricolage Grotesque Variable', Georgia, serif"
        font-size={height * 0.65}
        font-weight="800"
    >
        <text
            letter-spacing="-1"
            text-anchor="middle"
            x={height * 0.9}
            y={height * 0.72}
        >
            APA
        </text>
    </g>
    <g
        fill="currentColor"
        font-family="'Space Mono', monospace"
        font-size={height * 0.30}
    >
        <text
            x={height * 2.0}
            y={height * 0.48}
        >
            AUSTIN PRODUCER
        </text>
        <text
            x={height * 2.0}
            y={height * 0.88}
        >
            ALLIANCE
        </text>
    </g>
</svg>
