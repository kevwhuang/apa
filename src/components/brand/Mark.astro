---
import { BRAND_LOGOS, BRAND_SIZES } from '@lib/shared/brand';

interface Props {
    class?: string;
    height?: number;
    label?: string;
    mono?: boolean;
}

const { class: markClass, height = BRAND_SIZES.markNav, label, mono } = Astro.props;

const SymbolDark = BRAND_LOGOS.symbolDark;
const SymbolLight = BRAND_LOGOS.symbolLight;
const SymbolMono = BRAND_LOGOS.symbol;

const ariaHidden = label ? undefined : 'true';
const role = label ? 'img' : undefined;
---

{mono
    ? (
            <SymbolMono
                class={markClass}
                aria-hidden={ariaHidden}
                aria-label={label}
                height={height}
                role={role}
            />
        )
    : (
            <Fragment>
                <SymbolLight
                    class:list={['symbol', 'symbol--light', markClass]}
                    aria-hidden={ariaHidden}
                    aria-label={label}
                    height={height}
                    role={role}
                />
                <SymbolDark
                    class:list={['symbol', 'symbol--dark', markClass]}
                    aria-hidden={ariaHidden}
                    aria-label={label}
                    height={height}
                    role={role}
                />
            </Fragment>
        )}

<style>
    .symbol--dark {
        display: var(--dark-only, block);
    }

    .symbol--light {
        display: var(--light-only, block);
    }
</style>
