---
import { BRAND_LOGOS, BRAND_SIZES } from '@lib/shared/brand';

interface Props {
    class?: string;
    height?: number;
    label?: string;
}

const { class: lockupClass, height = BRAND_SIZES.lockupPreview, label } = Astro.props;

const LockupDark = BRAND_LOGOS.lockupDark;
const LockupLight = BRAND_LOGOS.lockupLight;
---

<LockupLight
    class:list={['lockup', 'lockup--light', lockupClass]}
    aria-hidden={label ? undefined : 'true'}
    aria-label={label}
    height={height}
    role={label ? 'img' : undefined}
/>
<LockupDark
    class:list={['lockup', 'lockup--dark', lockupClass]}
    aria-hidden={label ? undefined : 'true'}
    aria-label={label}
    height={height}
    role={label ? 'img' : undefined}
/>

<style>
    .lockup--dark {
        display: var(--dark-only, block);
    }

    .lockup--light {
        display: var(--light-only, block);
    }
</style>
