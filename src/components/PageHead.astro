---
interface Props {
    class?: string;
    eyebrow: string;
    eyebrowClass?: string;
    headingId: string;
    tone?: 'dark' | 'light';
}

const { class: headingClass, eyebrow, eyebrowClass = 'mb-4', headingId, tone = 'light' } = Astro.props;
---

<div class="page-head">
    <p class:list={['label reveal', eyebrowClass, tone === 'dark' ? 'text-coral' : 'text-coral-dark']}>
        {eyebrow}
    </p>
    <h1
        id={headingId}
        class:list={['reveal', headingClass]}
    >
        <slot />
    </h1>
</div>

<style>
    .page-head h1 {
        transition-delay: 0.08s;
    }
</style>
