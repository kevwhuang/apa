---
interface Props {
    class?: string;
    headingId: string;
}

const { class: headingClass, headingId } = Astro.props;
---

<div
    class:list={[
        'mb-12',
        Astro.slots.has('cta') && 'flex items-end justify-between gap-6',
    ]}
    data-motion="rise"
>
    <div>
        <h2
            id={headingId}
            class:list={['font-display', headingClass]}
        >
            <slot />
        </h2>
    </div>
    <slot name="cta" />
</div>
