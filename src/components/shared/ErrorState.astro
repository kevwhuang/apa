---
import BrandMark from '@components/brand/Mark.astro';
import PageHead from '@components/shared/PageHead.astro';

interface Props {
    code: string;
    headingId: string;
    lede: string;
}

const ROUTES = [
    { href: '/', label: 'Home', primary: true },
    { href: '/directory', label: 'Directory', primary: false },
    { href: '/resources', label: 'Resources', primary: false },
];

const { code, headingId, lede } = Astro.props;
---

<section
    class="stage stage--tight"
    aria-labelledby={headingId}
>
    <div class="rank rank--2 items-center">
        <div class="flex flex-col gap-6">
            <PageHead
                class="text-9xl max-lg:text-8xl max-md:text-5xl"
                headingId={headingId}
            >
                {code}
            </PageHead>
            <hr
                class="border-0 border-border-strong border-t-2"
                data-motion="rule"
            />
            <p
                class="max-w-md text-lg text-text-secondary"
                data-motion="blur"
            >
                {lede}
            </p>
            <nav aria-label="Suggested pages">
                <ul
                    class="flex flex-wrap gap-3 list-none"
                    data-motion-stagger="rise"
                >
                    {ROUTES.map(route => (
                        <li>
                            <a
                                class:list={['btn', route.primary && 'btn--primary']}
                                href={route.href}
                            >
                                {route.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
        <div class="error__frame">
            <div class="error__plate slab slab--bare slab--lift flex items-center justify-center">
                <BrandMark
                    class="h-auto w-7/10 max-md:w-11/20"
                    mono
                />
            </div>
        </div>
    </div>
</section>

<style>
    .error__frame {
        --plate-drop: var(--lift);
        padding-block-end: var(--plate-drop);
        padding-inline-end: var(--plate-drop);
    }

    .error__plate {
        --slab-fill: var(--color-signal);
        aspect-ratio: 1;
    }

    @media (max-width: 768px) {
        .error__plate {
            aspect-ratio: 2;
        }
    }
</style>
