---
import IconChevron from '@components/icons/Chevron.astro';
import IconMoon from '@components/icons/Moon.astro';
import IconPower from '@components/icons/Power.astro';
import IconSun from '@components/icons/Sun.astro';
import IconUser from '@components/icons/User.astro';
---

<div class="account">
    <a
        class="account__out"
        href="/signin"
    >
        Sign in
    </a>
    <div class="account__in">
        <button
            id="account-trigger"
            class="account__toggle"
            aria-controls="account-menu"
            aria-expanded="false"
            data-nav-trigger
            type="button"
        >
            <IconUser />
            <span
                class="sr-only"
                data-account-name
            >
                Account
            </span>
            <IconChevron />
        </button>
        <ul
            id="account-menu"
            class="account__menu list-none"
            aria-labelledby="account-trigger"
            data-nav-menu
            hidden
        >
            <li>
                <a
                    class="account__item"
                    href="/store/orders"
                >
                    Orders
                </a>
            </li>
            <li>
                <a
                    class="account__item"
                    href="/settings"
                >
                    Settings
                </a>
            </li>
            <li>
                <button
                    class="account__item"
                    aria-pressed="false"
                    data-account-theme
                    type="button"
                >
                    Theme
                    <span class="account__moon">
                        <IconMoon />
                    </span>
                    <span class="account__sun">
                        <IconSun />
                    </span>
                </button>
            </li>
            <li>
                <button
                    class="account__item"
                    data-account-signout
                    type="button"
                >
                    Sign out
                    <IconPower />
                </button>
            </li>
        </ul>
    </div>
</div>

<style>
    .account {
        position: relative;
    }

    .account__in {
        display: none;
    }

    .account__item {
        align-items: center;
        border-radius: 4px;
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        gap: var(--space-sm);
        justify-content: space-between;
        letter-spacing: 0.04em;
        min-height: 50px;
        padding-inline: var(--space-sm);
        text-transform: uppercase;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        white-space: nowrap;
        width: 100%;
    }

    .account__item :global(svg) {
        flex: none;
        height: 18px;
        width: 18px;
    }

    .account__item:active {
        transform: translateY(1px);
    }

    .account__item:focus-visible,
    .account__item:hover {
        background: var(--color-surface-sunken);
        color: var(--color-accent-deep);
    }

    .account__menu {
        background: var(--color-surface-raised);
        border: 1px solid var(--color-ink-10);
        border-radius: 6px;
        box-shadow: 0 12px 32px 0 var(--color-ink-20);
        display: flex;
        flex-direction: column;
        gap: 2px;
        inset: calc(100% + 6px) 0 auto auto;
        min-width: 220px;
        opacity: 1;
        padding: var(--space-2xs);
        position: absolute;
        transition:
            opacity var(--duration-fast) var(--motion-ease-ui),
            translate var(--duration-fast) var(--motion-ease-ui);
        translate: 0 0;
        z-index: var(--z-header);
    }

    .account__menu::before {
        background: var(--color-accent);
        content: '';
        height: 2px;
        margin-bottom: var(--space-3xs);
    }

    @starting-style {
        .account__menu {
            opacity: 0;
            translate: 0 -4px;
        }
    }

    .account__moon {
        display: flex;
    }

    .account__out {
        align-items: center;
        background: var(--color-accent);
        border: 2px solid var(--color-accent);
        color: var(--color-ink);
        display: inline-flex;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.04em;
        min-height: 50px;
        padding-inline: var(--space-sm);
        text-transform: uppercase;
        transition:
            background var(--duration-fast) var(--motion-ease-ui),
            border-color var(--duration-fast) var(--motion-ease-ui),
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        white-space: nowrap;
    }

    .account__out:active {
        transform: translateY(1px);
    }

    .account__out:hover {
        background: var(--color-accent-deep);
        border-color: var(--color-accent-deep);
        color: var(--color-ink-inverse);
    }

    .account__sun {
        display: none;
    }

    .account__toggle {
        align-items: center;
        display: flex;
        gap: 2px;
        height: 50px;
        justify-content: center;
        transition:
            color var(--duration-fast) var(--motion-ease-ui),
            transform var(--duration-fast) var(--motion-ease-ui);
        width: 50px;
    }

    .account__toggle :global(svg:last-of-type) {
        transition: rotate var(--duration-fast) var(--motion-ease-ui);
    }

    .account__toggle:active {
        transform: translateY(1px);
    }

    .account__toggle:hover {
        color: var(--color-accent-deep);
    }

    .account__toggle[aria-expanded='true'] {
        color: var(--color-accent-deep);
    }

    .account__toggle[aria-expanded='true'] :global(svg:last-of-type) {
        rotate: 180deg;
    }

    :global([data-session='in']) .account__in {
        display: block;
    }

    :global([data-session='in']) .account__out {
        display: none;
    }

    :global(html[data-theme='dark']) .account__moon {
        display: none;
    }

    :global(html[data-theme='dark']) .account__sun {
        display: flex;
    }

    @media (max-width: 768px) {
        .account {
            position: static;
        }

        .account__menu {
            inset: calc(100% + 6px) var(--shell-pad) auto auto;
            min-width: 0;
        }

        .account__out {
            padding-inline: var(--space-3xs);
        }
    }
</style>

<script>
    import { navigate } from 'astro:transitions/client';

    import { STORAGE } from '@lib/shared/constants';
    import { endSession, getSession, onSessionChange } from '@lib/account/session';
    import { getTheme, toggleTheme } from '@lib/ui/theme';
    import { registerPageScript, setPending } from '@lib/shared/utils';
    import { toast } from '@lib/ui/toasts';

    let unsubscribe: (() => void) | undefined;

    async function handleSignOut(button: HTMLButtonElement) {
        setPending(button, true);

        await endSession();

        toast('Signed out.', 'info');

        await navigate('/');
    }

    function initAccount(signal: AbortSignal) {
        render();
        unsubscribe?.();
        unsubscribe = onSessionChange(render);
        signal.addEventListener('abort', () => unsubscribe?.(), { once: true });

        const signOut = document.querySelector<HTMLButtonElement>('[data-account-signout]');
        const theme = document.querySelector<HTMLButtonElement>('[data-account-theme]');

        signOut?.addEventListener('click', () => void handleSignOut(signOut), { signal });

        if (!theme) return;

        renderTheme(theme);
        theme.addEventListener('click', () => toggleTheme(), { signal });
        window.addEventListener(STORAGE.theme.topic, () => renderTheme(theme), { signal });
    }

    function render() {
        const name = document.querySelector<HTMLElement>('[data-account-name]');
        const session = getSession();

        document.documentElement.dataset.session = session ? 'in' : 'out';

        if (!name) return;

        name.textContent = session ? `Account, signed in as ${session.artistName || session.email}` : 'Account';
    }

    function renderTheme(button: HTMLButtonElement) {
        button.setAttribute('aria-pressed', String(getTheme() === 'dark'));
    }

    registerPageScript(initAccount);
</script>
