---
interface Props {
    'class'?: string;
    'color': string;
    'data-motion'?: string;
    'label'?: string;
    'labelClass'?: string;
    'labelColor'?: string;
    'numeric'?: boolean;
}

const { class: tileClass, color, 'data-motion': motion, label, labelClass, labelColor, numeric } = Astro.props;

const style = labelColor ? `background: ${color}; color: ${labelColor};` : `background: ${color};`;
---

<div
    class:list={['flex items-center justify-center overflow-hidden relative', tileClass]}
    data-motion={motion}
    style={style}
>
    <div
        class="halftone absolute inset-0"
        aria-hidden="true"
    />
    {label && (
        <span
            class:list={['relative font-bold select-none', numeric ? 'font-display tracking-[-0.02em]' : 'tracking-tight', labelClass]}
            aria-hidden="true"
        >
            {label}
        </span>
    )}
    <slot />
</div>
