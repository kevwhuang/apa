---
interface Props {
    class?: string;
    eyebrow?: string;
    eyebrowClass?: string;
    headingId: string;
    tone?: 'dark' | 'light';
}

const { class: headingClass, eyebrow, eyebrowClass = 'mb-4', headingId, tone = 'light' } = Astro.props;
---

<div class="page-head">
    {eyebrow && (
        <p
            class:list={['label', eyebrowClass, tone === 'dark' ? 'text-link-on-inverse' : 'text-link']}
            data-motion="stamp"
        >
            {eyebrow}
        </p>
    )}
    <h1
        id={headingId}
        class:list={[headingClass]}
        data-motion="strike"
    >
        <slot />
    </h1>
</div>
