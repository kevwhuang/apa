---
import IconArrow from '@components/icons/Arrow.astro';

interface Props {
    href: string;
    label: string;
}

const { href, label } = Astro.props;
---

<nav
    class="back-link stage border-b-2 border-border-strong"
    aria-label="Breadcrumb"
>
    <div data-motion="stamp">
        <a
            class="group active:translate-y-px focus-visible:text-link hover:text-link inline-flex items-center min-h-(--control-size) gap-3 font-bold text-xl tracking-tight transition-[color,translate]"
            href={href}
        >
            <span class="group-focus-visible:-translate-x-1 group-hover:-translate-x-1 inline-flex transition-[translate]">
                <IconArrow left />
            </span>
            {label}
        </a>
    </div>
</nav>

<style>
    .back-link {
        --stage-pad: var(--space-lg);
    }
</style>
