---
import IconArrow from '@components/icons/Arrow.astro';

interface Props {
    href: string;
    label: string;
}

const CLASS_LINK = 'group active:translate-y-px focus-visible:text-link hover:text-link inline-flex items-center min-h-(--control-size) gap-3 font-bold text-xl tracking-tight transition-[color,translate]';

const { href, label } = Astro.props;
---

<section
    class="back-link stage border-b-2 border-border-strong"
    aria-label="Breadcrumb"
>
    <nav
        aria-label="Breadcrumb"
        data-motion="stamp"
    >
        <a
            class={CLASS_LINK}
            href={href}
        >
            <span class="group-focus-visible:-translate-x-1 group-hover:-translate-x-1 inline-flex transition-[translate]">
                <IconArrow left />
            </span>
            {label}
        </a>
    </nav>
</section>

<style>
    .back-link {
        --stage-pad: var(--space-lg);
    }
</style>
