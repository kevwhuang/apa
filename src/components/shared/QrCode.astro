---
import { buildQrPath } from '@lib/ui/qr';

interface Props {
    caption?: string;
    class?: string;
    data: string;
    label: string;
}

const { caption, class: qrClass, data, label } = Astro.props;

const shape = buildQrPath(data);
---

<figure class:list={['qr flex flex-col items-center gap-4', qrClass]}>
    <svg
        class="qr__code aspect-square max-w-full text-qr-code"
        aria-label={label}
        data-qr
        role="img"
        shape-rendering="crispEdges"
        viewBox={`0 0 ${shape.size} ${shape.size}`}
    >
        <rect
            class="fill-qr-bg"
            height="100%"
            width="100%"
            x="0"
            y="0"
        />
        <path d={shape.path} data-qr-path fill="currentColor" />
    </svg>
    {caption && (
        <figcaption class="label text-balance text-center">{caption}</figcaption>
    )}
</figure>

<style>
    .qr__code {
        width: clamp(240px, calc(213.333px + 8.3333vw), 320px);
    }
</style>
