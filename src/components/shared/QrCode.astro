---
interface ModuleRun {
    length: number;
    x: number;
    y: number;
}

interface Props {
    caption?: string;
    class?: string;
    data: string;
    label: string;
}

const ALIGNMENT_CENTER = 22;
const ALIGNMENT_RADIUS = 2;
const DARK_MODULE_OFFSET = 8;
const DARK_PROBABILITY = 0.5;
const FINDER_CENTER = 3;
const FINDER_EDGE = 6;
const FINDER_LIGHT_RING = 2;
const FINDER_SIZE = 7;
const HASH_OFFSET = 2_166_136_261;
const HASH_PRIME = 16_777_619;
const MODULE_COUNT = 29;
const QUIET_ZONE = 4;
const RANDOM_INCREMENT = 0x6d2b_79f5;
const RANDOM_MIX = 61;
const RANDOM_RANGE = 4_294_967_296;
const RANDOM_SHIFT_FIRST = 15;
const RANDOM_SHIFT_SECOND = 7;
const RANDOM_SHIFT_THIRD = 14;
const TIMING_INDEX = 6;

const { caption, class: qrClass, data, label } = Astro.props;
const viewSize = MODULE_COUNT + QUIET_ZONE * 2;

const runs = toRuns(buildModules(data));

function buildModules(seed: string) {
    const grid: boolean[][] = [];
    const random = createRandom(hashSeed(seed));

    for (let y = 0; y < MODULE_COUNT; y += 1) {
        const row: boolean[] = [];

        for (let x = 0; x < MODULE_COUNT; x += 1) {
            const fixed = getFixedModule(x, y);

            row.push(fixed === null ? random() < DARK_PROBABILITY : fixed);
        }

        grid.push(row);
    }

    return grid;
}

function createRandom(seed: number) {
    let state = seed >>> 0;

    return () => {
        state = (state + RANDOM_INCREMENT) >>> 0;

        let value = Math.imul(state ^ (state >>> RANDOM_SHIFT_FIRST), state | 1);

        value ^= value + Math.imul(value ^ (value >>> RANDOM_SHIFT_SECOND), value | RANDOM_MIX);

        return ((value ^ (value >>> RANDOM_SHIFT_THIRD)) >>> 0) / RANDOM_RANGE;
    };
}

function getFixedModule(x: number, y: number) {
    const finderOrigins = [[0, 0], [MODULE_COUNT - FINDER_SIZE, 0], [0, MODULE_COUNT - FINDER_SIZE]];

    for (const [originX, originY] of finderOrigins) {
        const finderX = x - originX;
        const finderY = y - originY;

        if (finderX < -1 || finderX > FINDER_SIZE || finderY < -1 || finderY > FINDER_SIZE) continue;

        if (finderX < 0 || finderX > FINDER_EDGE || finderY < 0 || finderY > FINDER_EDGE) return false;

        return Math.max(Math.abs(finderX - FINDER_CENTER), Math.abs(finderY - FINDER_CENTER)) !== FINDER_LIGHT_RING;
    }

    if (x === TIMING_INDEX || y === TIMING_INDEX) return (x + y) % 2 === 0;

    const alignmentX = x - ALIGNMENT_CENTER;
    const alignmentY = y - ALIGNMENT_CENTER;

    if (Math.abs(alignmentX) <= ALIGNMENT_RADIUS && Math.abs(alignmentY) <= ALIGNMENT_RADIUS) {
        return Math.max(Math.abs(alignmentX), Math.abs(alignmentY)) !== 1;
    }

    if (x === DARK_MODULE_OFFSET && y === MODULE_COUNT - DARK_MODULE_OFFSET) return true;

    return null;
}

function hashSeed(value: string) {
    let hash = HASH_OFFSET;

    for (let index = 0; index < value.length; index += 1) {
        hash = Math.imul(hash ^ value.charCodeAt(index), HASH_PRIME);
    }

    return hash >>> 0;
}

function toRuns(grid: boolean[][]) {
    const runs: ModuleRun[] = [];

    grid.forEach((row, y) => {
        let start = -1;

        row.forEach((dark, x) => {
            if (dark && start < 0) start = x;

            if (!dark && start >= 0) {
                runs.push({ length: x - start, x: start, y });
                start = -1;
            }
        });

        if (start >= 0) runs.push({ length: row.length - start, x: start, y });
    });

    return runs;
}
---

<figure class:list={['qr flex flex-col items-center gap-4', qrClass]}>
    <svg
        class="qr__code aspect-square max-w-full text-qr-code"
        aria-label={label}
        role="img"
        shape-rendering="crispEdges"
        viewBox={`0 0 ${viewSize} ${viewSize}`}
    >
        <rect
            class="fill-qr-bg"
            height={viewSize}
            width={viewSize}
            x="0"
            y="0"
        />
        {runs.map(run => (
            <rect
                fill="currentColor"
                height="1"
                width={run.length}
                x={run.x + QUIET_ZONE}
                y={run.y + QUIET_ZONE}
            />
        ))}
    </svg>
    {caption && (
        <figcaption class="label text-balance text-center">{caption}</figcaption>
    )}
</figure>

<style>
    .qr__code {
        width: clamp(240px, calc(213.333px + 8.3333vw), 320px);
    }
</style>
