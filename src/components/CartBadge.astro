---
const path = Astro.url.pathname;
const showBadge = path.startsWith('/merch');
---
{showBadge && (
    <a
        href="/merch/cart"
        id="cart-badge"
        class="relative p-2 transition-colors hover:text-coral"
        aria-label="Cart"
    >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 3 H4.5 L6 12 H15 L16.5 5 H5" stroke-linejoin="round" />
            <circle cx="7" cy="15" r="1.2" />
            <circle cx="13" cy="15" r="1.2" />
        </svg>
        <span
            id="cart-count"
            class="absolute -top-0.5 -right-0.5 min-w-[16px] h-[16px] px-1 text-[10px] font-mono leading-[16px] text-center hidden bg-coral text-coral-ink"
        >0
        </span>
    </a>
)}

{showBadge && (
    <script>
        import { read, count, onChange } from '@/lib/cart';
        const update = () => {
            const el = document.getElementById('cart-count');
            if (!el) return;
            const c = count(read());
            el.textContent = String(c);
            el.classList.toggle('hidden', c === 0);
        };
        update();
        onChange(update);
    </script>
)}
