---
interface Props {
    size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
    class="text-coral-ink"
    aria-label="APA monogram"
    fill="none"
    height={size}
    role="img"
    viewBox="0 0 32 32"
    width={size}
    xmlns="http://www.w3.org/2000/svg"
>
    <rect fill="var(--color-coral)" height="32" width="32" />
    <g
        fill="currentColor"
        font-family="'Bricolage Grotesque Variable', Georgia, serif"
        font-size="16"
        font-weight="800"
        letter-spacing="-1"
    >
        <text text-anchor="middle" x="16" y="21">APA</text>
    </g>
</svg>
