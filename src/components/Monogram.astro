---
interface Props {
    decorative?: boolean;
    size?: number;
}

const { decorative = false, size = 32 } = Astro.props;
---

<svg
    class="text-snow select-none"
    aria-hidden={decorative ? 'true' : undefined}
    aria-label={decorative ? undefined : 'Austin Producer Alliance'}
    fill="none"
    height={size}
    role={decorative ? undefined : 'img'}
    viewBox="0 0 32 32"
    width={size}
    xmlns="http://www.w3.org/2000/svg"
>
    <rect fill="var(--color-coral)" height="32" width="32" />
    <g
        fill="currentColor"
        font-family="'Bricolage Grotesque Variable', Georgia, serif"
        font-size="16"
        font-weight="800"
        letter-spacing="-1"
    >
        <text
            text-anchor="middle"
            x="16"
            y="21"
        >
            APA
        </text>
    </g>
</svg>
