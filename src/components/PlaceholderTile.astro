---
interface Props {
    class?: string;
    color: string;
    label: string;
    labelClass?: string;
}

const { class: tileClass, color, label, labelClass } = Astro.props;
---

<div
    class:list={['flex items-center justify-center overflow-hidden relative', tileClass]}
    style={`background: ${color};`}
>
    <div
        class="halftone absolute inset-0"
        aria-hidden="true"
    />
    <span
        class:list={['font-extrabold font-sans mix-blend-overlay select-none', labelClass]}
        aria-hidden="true"
    >
        {label}
    </span>
    <slot />
</div>
