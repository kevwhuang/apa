---
import Monogram from '@components/Monogram.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import CartBadge from '@components/CartBadge.astro';

const links = [
    { href: '/events', label: 'Events' },
    { href: '/producers', label: 'Producers' },
    { href: '/bash', label: 'The Bash' },
    { href: '/about', label: 'About' },
    { href: '/merch', label: 'Merch' },
    { href: '/sponsor', label: 'Sponsor' },
    { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header
    id="nav"
    class="fixed top-0 inset-x-0 z-40 transition-transform duration-300 border-b-2 border-ink"
    style="background: var(--color-bg);"
>
    <div class="max-w-[1400px] mx-auto px-6 h-[4.5rem] flex items-center gap-8">
        <a href="/" class="flex items-center gap-3 shrink-0" aria-label="APA home">
            <Monogram size={30} />
            <span class="hidden sm:inline font-display font-extrabold tracking-tight text-[15px] uppercase">
                Austin Producer Alliance
            </span>
        </a>

        <nav class="hidden md:flex items-center gap-6 font-mono text-[12px] uppercase tracking-wide" aria-label="Primary">
            {links.map(l => (
                <a
                    href={l.href}
                    class:list={[
                        'transition-colors hover:text-coral',
                        path.startsWith(l.href) ? 'text-coral font-bold' : '',
                    ]}
                >
                    {l.label}
                </a>
            ))}
        </nav>

        <div class="ml-auto flex items-center gap-1">
            <CartBadge />
            <ThemeToggle />
            <button
                id="nav-menu-btn"
                class="md:hidden p-2 -mr-2"
                aria-label="Open menu"
                aria-expanded="false"
            >
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="19" y2="6" />
                    <line x1="3" y1="11" x2="19" y2="11" />
                    <line x1="3" y1="16" x2="19" y2="16" />
                </svg>
            </button>
        </div>
    </div>

    <div
        id="nav-mobile"
        class="md:hidden hidden border-t-2 border-ink bg-bg"
        role="region"
        aria-label="Mobile navigation"
    >
        <nav class="px-6 py-5 flex flex-col gap-4 font-mono text-[14px] uppercase tracking-wide">
            {links.map(l => (
                <a href={l.href} class="py-1 hover:text-coral">{l.label}</a>
            ))}
        </nav>
    </div>
</header>

<script>
    const nav = document.getElementById('nav');
    let last = window.scrollY;
    let ticking = false;
    window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            const y = window.scrollY;
            if (y < 80) {
                nav?.style.setProperty('transform', 'translateY(0)');
            } else if (y > last + 6) {
                nav?.style.setProperty('transform', 'translateY(-100%)');
            } else if (y < last - 6) {
                nav?.style.setProperty('transform', 'translateY(0)');
            }
            last = y;
            ticking = false;
        });
    }, { passive: true });

    const btn = document.getElementById('nav-menu-btn');
    const drawer = document.getElementById('nav-mobile');

    function setMenu(open: boolean) {
        drawer?.classList.toggle('hidden', !open);
        btn?.setAttribute('aria-expanded', String(open));
    }

    btn?.addEventListener('click', () => {
        setMenu(drawer?.classList.contains('hidden') ?? false);
    });

    drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer?.classList.contains('hidden')) {
            setMenu(false);
            btn?.focus();
        }
    });
</script>
