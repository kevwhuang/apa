---
interface Props {
    size?: number;
}

const { size = 18 } = Astro.props;
---

<svg
    aria-hidden="true"
    fill="none"
    height={size}
    stroke="currentColor"
    stroke-width="1.5"
    viewBox="0 0 18 18"
    width={size}
>
    <path d="M6.5 4 V2.5 H11.5 V4" />
    <line
        stroke-linecap="square"
        x1="2.5"
        x2="15.5"
        y1="4"
        y2="4"
    />
    <path d="M4.5 4 V15 H13.5 V4" />
    <line
        stroke-linecap="square"
        x1="7.25"
        x2="7.25"
        y1="7"
        y2="12.25"
    />
    <line
        stroke-linecap="square"
        x1="10.75"
        x2="10.75"
        y1="7"
        y2="12.25"
    />
</svg>
