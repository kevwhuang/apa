---
interface Props {
    muted?: boolean;
}

const { muted = false } = Astro.props;
---

<svg
    aria-hidden="true"
    fill="none"
    height="18"
    stroke="currentColor"
    stroke-width="1.8"
    viewBox="0 0 18 18"
    width="18"
>
    <polygon
        fill="currentColor"
        points="2,6.5 5,6.5 8.5,3 8.5,15 5,11.5 2,11.5"
        stroke-linejoin="round"
    />
    {muted && (
        <g stroke-linecap="round">
            <line
                x1="11.5"
                x2="16"
                y1="6.5"
                y2="11.5"
            />
            <line
                x1="16"
                x2="11.5"
                y1="6.5"
                y2="11.5"
            />
        </g>
    )}
    {!muted && (
        <path
            d="M11.5 6.2a4 4 0 0 1 0 5.6"
            stroke-linecap="round"
        />
    )}
</svg>
