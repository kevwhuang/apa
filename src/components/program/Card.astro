---
import IconChevron from '@components/icons/Chevron.astro';
import { formatDateStamp, formatVenue } from '@lib/shared/utils';

interface Props {
    credit?: string;
    date: Date;
    group: string;
    heading: string;
    isStill: boolean;
    location: string;
    notes: { label: string; paragraphs: string[] }[];
    program: keyof typeof BANDS;
    text: string;
}

const BANDS = {
    assembly: 'bg-event-assembly',
    bash: 'bg-event-bash',
    hangout: 'bg-event-hangout',
};

const { credit, date, group, heading, isStill, location, notes, program, text } = Astro.props;
---

<article class:list={['slab slab--bare slab--card', isStill && 'slab--still', 'content-start grid grid-cols-1 grid-rows-subgrid row-span-3']}>
    <div class="flex flex-col">
        <div
            class:list={['h-3 border-b-2 border-border-strong', BANDS[program]]}
            aria-hidden="true"
        />
        <div class="flex flex-1 flex-col px-(--space-md)">
            <div class="content-center flex flex-1 flex-wrap items-baseline justify-between min-h-(--control-size) gap-x-4 gap-y-1 py-2 border-b border-border-subtle font-mono text-base max-lg:flex-col max-lg:flex-nowrap max-lg:items-start max-lg:justify-center">
                <time datetime={date.toISOString()}>{formatDateStamp(date)}</time>
                <address class="not-italic wrap-anywhere text-text-secondary">{formatVenue(location)}</address>
            </div>
        </div>
    </div>
    <div class="p-(--space-md)">
        <hgroup class="flex flex-col gap-2 mb-3">
            {credit && (
                <p class="font-bold leading-(--text-xl) text-lg tracking-tight">
                    {credit}
                </p>
            )}
            <h3 class="font-display text-balance text-xl max-lg:text-lg">
                {heading}
            </h3>
        </hgroup>
        <p class="text-base text-text-secondary">
            {text}
        </p>
    </div>
    {notes.length > 0 && (
        <div class="px-(--space-md)">
            {notes.map(note => (
                <details
                    class="group border-border-subtle border-t"
                    name={group}
                >
                    <summary class="action-text [&::-webkit-details-marker]:hidden group-open:text-link flex items-center justify-between min-h-(--control-size) gap-2">
                        {note.label}
                        <span class="group-open:rotate-180 flex transition-[rotate]">
                            <IconChevron />
                        </span>
                    </summary>
                    <div class="flex flex-col gap-4 pb-(--space-md)">
                        {note.paragraphs.map(paragraph => (
                            <p class="text-base text-text-secondary">
                                {paragraph}
                            </p>
                        ))}
                    </div>
                </details>
            ))}
        </div>
    )}
</article>
