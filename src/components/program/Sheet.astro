---
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { formatDate, formatTime, formatTimeRange, getProgram, mergeCalendar } from '@lib/utils';

type ProgramEvent = ReturnType<typeof mergeCalendar>['upcoming'][number] & { end?: Date };

interface Props {
    class?: string;
    ctaHref?: string;
    ctaLabel?: string;
    detailed?: boolean;
    events: ProgramEvent[];
    headingId: string;
}

const { class: stageClass, ctaHref, ctaLabel, detailed = false, events, headingId } = Astro.props;

const program = getProgram('assembly');
---

<section
    class:list={['stage stage--assembly', stageClass]}
    aria-labelledby={headingId}
>
    <div class="mark">
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId={headingId}
        >
            {program.name}
            {ctaHref && ctaLabel && (
                <a
                    class="action-text hover:text-accent-deep hidden items-center min-h-[50px] transition-colors md:inline-flex"
                    href={ctaHref}
                    slot="cta"
                >
                    {ctaLabel} &rarr;
                </a>
            )}
        </SectionHead>
        <p class="max-w-2xl mb-8 leading-relaxed text-base text-ink-muted">
            {program.summary}
        </p>
        {detailed && (
            <p class="mb-8">
                <a
                    class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] underline underline-offset-4 transition-colors"
                    href={LINKS.meetup}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    RSVP for {program.shortName} on Meetup &rarr;
                </a>
            </p>
        )}
        <hr
            class="border-0 border-t-2 border-ink"
            data-motion="rule"
        />
        <ul
            class="list-none"
            data-motion-stagger="rise"
        >
            {events.map(event => (
                <li
                    id={event.id}
                    class="rank items-baseline py-4 border-b-2 border-ink"
                >
                    <p
                        class="font-bold font-sans text-lg"
                        data-placeholder
                    >
                        <time datetime={event.date.toISOString()}>{formatDate(event.date)}</time>
                    </p>
                    <p
                        class="font-mono text-xs uppercase text-ink-muted md:text-right"
                        data-placeholder
                    >
                        {event.end
                            ? formatTimeRange(event.date, event.end)
                            : <time datetime={event.date.toISOString()}>{formatTime(event.date)}</time>}
                    </p>
                    <h3 class="font-extrabold font-sans text-lg tracking-tight">
                        {detailed
                            ? event.title
                            : (
                                    <a
                                        class="hover:text-accent-deep inline-flex items-center min-h-[50px] transition-colors"
                                        href={`/events#${event.id}`}
                                    >
                                        {event.title}
                                    </a>
                                )}
                    </h3>
                    <address class="font-mono not-italic text-xs uppercase text-ink-muted md:text-right">
                        {event.location}
                    </address>
                </li>
            ))}
        </ul>
        {ctaHref && ctaLabel && (
            <p class="mt-6 md:hidden">
                <a
                    class="action-text hover:text-accent-deep inline-flex items-center min-h-[50px] underline underline-offset-4 transition-colors"
                    href={ctaHref}
                >
                    {ctaLabel} &rarr;
                </a>
            </p>
        )}
    </div>
</section>

<style>
    @media (max-width: 768px) {
        .rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>
