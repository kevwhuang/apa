---
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { formatDate, formatTime, formatTimeRange, getProgram } from '@lib/utils';

import type { ProgramEvent } from '@lib/utils';

interface Props {
    class?: string;
    ctaHref?: string;
    ctaLabel?: string;
    detailed?: boolean;
    events: ProgramEvent[];
    headingId: string;
    straight?: boolean;
    tight?: boolean;
}

const { class: stageClass, ctaHref, ctaLabel, detailed = false, events, headingId, straight = false, tight = false } = Astro.props;

const ctaBreak = Boolean(ctaHref && ctaLabel) && 'mb-10 md:mb-0';

const program = getProgram('hangout');
---

<section
    class:list={['stage stage--hangout', tight && 'stage--tight', stageClass]}
    aria-labelledby={headingId}
>
    <div>
        <SectionHead
            class="font-extrabold font-sans text-5xl tracking-tight"
            eyebrow={`${program.shortName} / ${program.cadence}`}
            headingId={headingId}
        >
            {program.name}.
            {ctaHref && ctaLabel && (
                <a
                    class="action-text hover:text-accent-deep hidden items-center min-h-(--control-size) transition-colors md:inline-flex"
                    href={ctaHref}
                    slot="cta"
                >
                    {ctaLabel} &rarr;
                </a>
            )}
        </SectionHead>
        <p class:list={['max-w-2xl leading-relaxed text-base text-ink-muted', !detailed && ctaBreak]}>
            {program.summary}
        </p>
        {detailed && (
            <p class:list={[ctaBreak]}>
                <a
                    class="action-text hover:text-accent-deep inline-flex items-center min-h-(--control-size) underline underline-offset-4 transition-colors"
                    href={LINKS.meetup}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    RSVP for the {program.shortName} on Meetup &rarr;
                </a>
            </p>
        )}
        {ctaHref && ctaLabel && (
            <div class="md:hidden">
                <a
                    class="btn"
                    href={ctaHref}
                >
                    {ctaLabel}
                </a>
            </div>
        )}
    </div>
    <ul
        class="program-flyer__list rake list-none"
        data-motion-stagger="rise"
    >
        {events.map(event => (
            <li class:list={['rake__item', !straight && 'tilt']}>
                <article
                    id={event.id}
                    class="program-flyer__card rank slab slab--card items-start"
                >
                    <div>
                        <p class="label mb-3 text-accent-deep">{program.shortName}</p>
                        <h3 class:list={['font-extrabold font-sans text-3xl tracking-tight', detailed && 'mb-3']}>
                            {detailed
                                ? event.title
                                : (
                                        <a
                                            class="active:translate-y-px hover:text-accent-deep inline-flex items-center min-h-(--control-size) transition-colors"
                                            href={`/events#${event.id}`}
                                        >
                                            {event.title}
                                        </a>
                                    )}
                        </h3>
                        {detailed && (
                            <p class="leading-relaxed text-smd text-ink-muted">{event.excerpt}</p>
                        )}
                    </div>
                    <div>
                        <p class="label mb-3 text-ink-muted">When</p>
                        <p
                            class="mb-1 font-extrabold font-sans text-xl"
                            data-placeholder
                        >
                            <time datetime={event.date.toISOString()}>{formatDate(event.date)}</time>
                        </p>
                        <p
                            class="font-mono text-xs uppercase text-ink-muted"
                            data-placeholder
                        >
                            {event.end
                                ? formatTimeRange(event.date, event.end)
                                : <time datetime={event.date.toISOString()}>{formatTime(event.date)}</time>}
                        </p>
                    </div>
                    <div>
                        <p class="label mb-3 text-ink-muted">Where</p>
                        <address class="font-mono not-italic text-xs uppercase">{event.location}</address>
                    </div>
                </article>
            </li>
        ))}
    </ul>
</section>

<style>
    .program-flyer__card.rank {
        --rank-cols: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.9fr);
    }

    .program-flyer__card.slab {
        padding: var(--space-lg);
    }

    .program-flyer__card > div:not(:first-child) {
        align-self: end;
    }

    .program-flyer__list.rake {
        --rake-amp: 0.55;
        gap: var(--space-2xl);
    }

    @media (max-width: 1024px) {
        .program-flyer__card.rank {
            --rank-cols: repeat(2, minmax(0, 1fr));
        }

        .program-flyer__card.rank > :first-child {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        .program-flyer__card.rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>
