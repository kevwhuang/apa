---
import IconArrow from '@components/icons/Arrow.astro';
import SectionHead from '@components/shared/SectionHead.astro';
import { LINKS } from '@lib/shared/constants';
import { formatDate, formatTimeRange, getProgram } from '@lib/shared/utils';

import type { ProgramEvent } from '@lib/shared/utils';

interface Props {
    class?: string;
    detailed?: boolean;
    events: ProgramEvent[];
    headingId: string;
    tight?: boolean;
}

const { class: stageClass, detailed = false, events, headingId, tight = false } = Astro.props;

const program = getProgram('hangout');
---

<section
    class:list={['stage stage--hangout', tight && 'stage--tight', stageClass]}
    aria-labelledby={headingId}
>
    <div>
        <SectionHead
            class="text-4xl md:text-5xl"
            eyebrow={`${program.shortName}, coming soon`}
            headingId={headingId}
        >
            {program.name}.
        </SectionHead>
        <p
            class="max-w-2xl leading-relaxed text-base text-text-secondary"
            data-motion="blur"
        >
            {program.summary}
        </p>
        {detailed && (
            <p data-motion="rise">
                <a
                    class="action-text hover:text-link inline-flex items-center gap-2 min-h-(--control-size) underline underline-offset-4 transition-colors"
                    href={LINKS.meetup}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    Watch for the first {program.shortName} on Meetup <IconArrow />
                </a>
            </p>
        )}
    </div>
    <ul
        class="program-flyer__list rake list-none"
        data-motion-stagger="rise"
    >
        {events.map(event => (
            <li
                class="rake__item tilt"
                data-event-end={event.end.toISOString()}
                data-event-group={headingId}
                data-event-role="upcoming"
            >
                <article
                    id={event.id}
                    class="program-flyer__card rank slab slab--card items-start"
                    data-event-id={event.id}
                >
                    <div>
                        <p class="label mb-3 text-link">{program.shortName}</p>
                        <h3 class:list={[detailed && 'mb-3', 'font-display text-2xl']}>
                            {detailed
                                ? event.title
                                : (
                                        <a
                                            class="active:translate-y-px hover:text-link inline-flex items-center min-h-(--control-size) transition-[color,translate]"
                                            href={`/events#${event.id}`}
                                        >
                                            {event.title}
                                        </a>
                                    )}
                        </h3>
                        {detailed && (
                            <p class="leading-relaxed text-text-secondary">{event.excerpt}</p>
                        )}
                    </div>
                    <dl class="contents">
                        <div class="self-end">
                            <dt class="label mb-3 text-text-secondary">When</dt>
                            <dd
                                class="mb-1 font-bold font-sans text-xl"
                                data-placeholder
                            >
                                <time datetime={event.date.toISOString()}>{formatDate(event.date)}</time>
                            </dd>
                            <dd
                                class="font-mono text-xs text-text-secondary"
                                data-placeholder
                            >
                                {formatTimeRange(event.date, event.end)}
                            </dd>
                        </div>
                        <div class="self-end">
                            <dt class="label mb-3 text-text-secondary">Where</dt>
                            <dd>
                                <address class="font-mono not-italic text-xs">{event.location}</address>
                            </dd>
                        </div>
                    </dl>
                </article>
            </li>
        ))}
    </ul>
</section>

<style>
    .program-flyer__card.rank {
        --rank-cols: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.9fr);
    }

    .program-flyer__card.slab {
        padding: var(--space-lg);
    }

    .program-flyer__list.rake {
        --rake-amp: 0.55;
        gap: var(--space-2xl);
    }

    @media (max-width: 1024px) {
        .program-flyer__card.rank {
            --rank-cols: repeat(2, minmax(0, 1fr));
        }

        .program-flyer__card.rank > :first-child {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        .program-flyer__card.rank {
            --rank-cols: minmax(0, 1fr);
        }
    }
</style>
