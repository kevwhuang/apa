---
import PlaceholderTile from '@components/shared/PlaceholderTile.astro';
import { AVATAR } from '@lib/shared/constants';
import { getInitials } from '@lib/shared/utils';

interface Props {
    class?: string;
    color: string;
    labelClass: string;
    labelColor: string;
    name: string;
    portrait: string;
}

const { class: tileClass, color, labelClass, labelColor, name, portrait } = Astro.props;
---

{portrait
    ? (
            <div class:list={['overflow-hidden relative', tileClass]}>
                <img
                    class="block object-cover h-full w-full"
                    alt={`Portrait of ${name}`}
                    decoding="async"
                    height={AVATAR.renderPixels}
                    loading="lazy"
                    src={portrait}
                    width={AVATAR.renderPixels}
                />
                <slot />
            </div>
        )
    : (
            <PlaceholderTile
                class={tileClass}
                color={color}
                label={getInitials(name)}
                labelClass={labelClass}
                labelColor={labelColor}
            >
                <slot />
            </PlaceholderTile>
        )}
