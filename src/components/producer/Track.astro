---
import { getCollection } from 'astro:content';

import IconPause from '@components/icons/Pause.astro';
import IconPlay from '@components/icons/Play.astro';
import { formatDuration, toRoster } from '@lib/shared/utils';

import type { CollectionEntry } from 'astro:content';

interface Props {
    class?: string;
    hasWave?: boolean;
    producerId: string;
    track: CollectionEntry<'producers'>['data']['tracks'][number];
}

const WAVE_BAR_COUNT = 14;
const WAVE_HASH_MODULUS = 997;
const WAVE_HASH_MULTIPLIER = 31;
const WAVE_MAX_SPAN = 72;
const WAVE_MIN_HEIGHT = 24;
const WAVE_PHASE_STEP = 1.7;

const { class: rowClass, hasWave = true, producerId, track } = Astro.props;

const producers = toRoster(await getCollection('producers'));

const producer = producers.find(entry => entry.data.producerId === producerId);

const artist = producer?.data.name ?? '';
const seedKey = producer?.id ?? '';

const seed = [...`${seedKey}:${track.title}`].reduce(
    (total, character) => (total * WAVE_HASH_MULTIPLIER + character.charCodeAt(0)) % WAVE_HASH_MODULUS,
    0,
);

const waveHeights = Array.from(
    { length: WAVE_BAR_COUNT },
    (_, index) => Math.round(WAVE_MIN_HEIGHT + Math.abs(Math.sin(seed + index * WAVE_PHASE_STEP)) * WAVE_MAX_SPAN),
);
---

<button
    class:list={[
        'producer-track active:translate-y-px aria-pressed:bg-btn-primary-bg aria-pressed:text-btn-primary-text group hover:bg-bg-raised-hover flex items-center min-h-(--control-size) w-full gap-3 p-3 border-2 border-border-strong text-left transition-[translate]',
        rowClass,
    ]}
    aria-pressed="false"
    data-track-artist={artist}
    data-track-duration={track.durationSeconds}
    data-track-file={track.file}
    data-track-id={producerId}
    data-track-seed={seedKey}
    data-track-title={track.title}
    type="button"
>
    <span class="group-aria-pressed:hidden inline-flex shrink-0 text-link">
        <IconPlay />
    </span>
    <span class="group-aria-pressed:inline-flex hidden shrink-0">
        <IconPause />
    </span>
    <span
        class="sr-only"
        data-track-label
    >
        Play
    </span>
    <span
        class="flex-1 min-w-0 font-mono text-balance text-base wrap-anywhere"
        data-placeholder
    >
        {track.title}
    </span>
    {hasWave && (
        <span
            class="flex flex-none items-center h-5 gap-0.5 max-md:hidden"
            aria-hidden="true"
        >
            {waveHeights.map(height => (
                <span
                    class="group-aria-pressed:bg-current min-h-0.5 w-(--producer-track-bar-width,2px) bg-text-secondary"
                    style={`height: ${height}%;`}
                />
            ))}
        </span>
    )}
    <span
        class="group-aria-pressed:text-btn-primary-text group-hover:text-text shrink-0 font-mono tabular-nums text-sm text-text-secondary"
        data-placeholder
    >
        {formatDuration(track.durationSeconds)}
    </span>
</button>

<style>
    .producer-track:focus-visible {
        outline-offset: -2px;
    }
</style>
