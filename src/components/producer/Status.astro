---
import { PRODUCER_AVAILABILITY_LABELS } from '@lib/constants';

type Availability = keyof typeof PRODUCER_AVAILABILITY_LABELS;

interface Props {
    availability: Availability;
    class?: string;
}

const AVAILABILITY_STYLES: Record<Availability, string> = {
    booked: 'border-dotted border-ink-muted text-ink-muted',
    open: 'border-solid border-pulse-deep text-pulse-deep',
    selective: 'border-dashed border-accent-deep text-accent-deep',
};

const { availability, class: statusClass } = Astro.props;
---

<p
    class:list={[
        'label inline-flex items-center h-7 px-2 border-2',
        AVAILABILITY_STYLES[availability],
        statusClass,
    ]}
>
    {PRODUCER_AVAILABILITY_LABELS[availability]}
</p>
